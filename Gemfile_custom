# * Spanish: https://github.com/consul/consul/blob/master/CUSTOMIZE_ES.md#gemfile

group :development do
  gem 'rack-mini-profiler'
  gem 'solargraph'
  # gem 'prosopite'
  # gem 'pg_query'

  gem 'foreman', '~> 0.90.0'
end

gem 'httparty'

gem 'ruby-saml', '~> 1.18', '>= 1.18.1'

# OpenID Connect Strategy for OmniAuth.
gem 'omniauth_openid_connect', '0.8.0'

gem 'geocoder', '~> 1.8', '>= 1.8.3'
gem 'rgeo', '~> 3.0', '>= 3.0.1'
gem 'rgeo-geojson', '~> 2.2'

# 5.17+ parses Ruby 3.4 backtraces; older versions send errors without frames.
gem "sentry-ruby", "~> 5.28.1"
gem "sentry-rails", "~> 5.28.1"

gem "acts_as_list"
gem "jwt"
gem 'rack-cors'

gem "prawn", "2.5.0"
gem 'prawn-svg', '~> 0.40.4'
gem "rqrcode", "~> 2.0"

# Adm
gem 'jsbundling-rails', '~> 1.3', '>= 1.3.1'
gem 'cssbundling-rails', '~> 1.4', '>= 1.4.3'

gem 'turbo-rails'

gem 'pundit', '~> 2.5', '>= 2.5.1'
gem 'pagy', '~> 9.4'
# /Adm

# delayed_job 4.2 needs ActiveJob::QueueAdapters::AbstractAdapter, which only
# exists from Rails 7.2; hold it below 4.2 until the Rails upgrade.
gem 'delayed_job', '~> 4.1.11'

gem 'liquid'

# No openai gem here: the WhatsApp assistant's Responses transport
# (OpenaiApi::Transport) talks to the two endpoints it needs through OpenaiApi
# (lib/openai_api), built on the Faraday and faraday-multipart this pinned
# ruby_llm already carries. The official SDK is not an option to begin with —
# every released version requires Ruby >= 3.2.0 and this app runs 3.1.4 — and
# declaring it would fail `bundle install` for everyone rather than only the
# code that uses it.
gem 'ruby_llm', '2.0.0'

gem 'pdf-reader', '2.15.1'

# 0.10.1 turns off the Zip64 format rubyzip 3 writes by default, which some
# readers reject.
gem 'docx', '0.10.1'

# rubyzip is a ruby module for reading and writing zip files
# Already resolved transitively through docx; declared explicitly because
# DocumentImageExtractor uses Zip::File directly.
gem 'rubyzip', '3.7.0'

group :test do
  gem 'shoulda-matchers', '~> 6.0'

  # Distributed object system for Ruby.
  # Ruby 3.4 no longer ships it as a default gem, and Rails 6.1's test helpers
  # require it without declaring it.
  gem 'drb', '2.2.3'
end

group :development, :test do
  gem 'pry', '~> 0.14'
  gem 'pry-byebug', '~> 3.9'
  gem 'pry-rails'

  gem 'rswag-specs'
end

gem 'proj4rb'

# A Ruby gem to transform HTML into PDF, PNG or JPEG by wrapping the NodeJS Google Puppeteer driver for Chromium
gem 'grover', '1.2.10'

# Ruby 3.4 no longer ships these as default gems. Rails 6.1 requires base64,
# bigdecimal, mutex_m and racc, factory_bot 6.2 requires observer, and the app
# requires csv, all without declaring them.
gem 'base64', '0.3.0'
gem 'bigdecimal', '3.1.8'
gem 'csv', '3.3.0'
gem 'mutex_m', '0.2.0'
gem 'observer', '0.1.2'
gem 'racc', '1.7.3'
