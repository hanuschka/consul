<section class="mb-2" aria-labelledby="adm-ai-resolved-profile-title">
  <h2 class="kern-title kern-title--small mb-3" id="adm-ai-resolved-profile-title">
    <%= t("adm.ai_settings.resolved_profile.title") %>
  </h2>

  <div class="kern-row mb-3">
    <div class="kern-col-12 kern-col-md-5">
      <p class="kern-body mb-3 mb-md-0">
        <%= t("adm.ai_settings.resolved_profile.intro") %>
      </p>
    </div>
    <div class="kern-col-12 kern-col-md-5">
      <dl class="kern-description-list">
        <div class="kern-description-list-item">
          <dt class="kern-description-list-item__key">
            <%= t("adm.ai_settings.resolved_profile.provider") %>
          </dt>
          <dd class="kern-description-list-item__value"><%= provider %></dd>
        </div>
        <div class="kern-description-list-item">
          <dt class="kern-description-list-item__key">
            <%= t("adm.ai_settings.resolved_profile.endpoint") %>
          </dt>
          <dd class="kern-description-list-item__value"><%= endpoint_label %></dd>
        </div>
        <div class="kern-description-list-item">
          <dt class="kern-description-list-item__key">
            <%= t("adm.ai_settings.resolved_profile.transport") %>
          </dt>
          <dd class="kern-description-list-item__value"><%= transport_label %></dd>
        </div>
        <div class="kern-description-list-item">
          <dt class="kern-description-list-item__key">
            <%= t("adm.ai_settings.resolved_profile.reasoning") %>
          </dt>
          <dd class="kern-description-list-item__value"><%= reasoning_label %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="kern-row">
    <div class="kern-col-12 kern-col-md-10">
      <div class="kern-table-responsive" tabindex="0">
        <table
          class="kern-table kern-table--small"
          role="region"
          aria-labelledby="adm-ai-resolved-profile-tiers"
          tabindex="0"
        >
          <caption class="kern-sr-only" id="adm-ai-resolved-profile-tiers">
            <%= t("adm.ai_settings.resolved_profile.table_caption") %>
          </caption>
          <thead class="kern-table__head">
            <tr class="kern-table__row">
              <th scope="col" class="kern-table__header">
                <%= t("adm.ai_settings.resolved_profile.columns.tier") %>
              </th>
              <th scope="col" class="kern-table__header">
                <%= t("adm.ai_settings.resolved_profile.columns.used_for") %>
              </th>
              <th scope="col" class="kern-table__header">
                <%= t("adm.ai_settings.resolved_profile.columns.model") %>
              </th>
              <th scope="col" class="kern-table__header">
                <%= t("adm.ai_settings.resolved_profile.columns.tools") %>
              </th>
            </tr>
          </thead>
          <tbody class="kern-table__body">
            <% tiers.each do |tier| %>
              <tr class="kern-table__row">
                <th scope="row" class="kern-table__header">
                  <%= t("adm.ai_settings.resolved_profile.tiers.#{tier.key}.name") %>
                </th>
                <td class="kern-table__cell">
                  <%= t("adm.ai_settings.resolved_profile.tiers.#{tier.key}.used_for") %>
                </td>
                <td class="kern-table__cell"><%= model_label(tier.profile) %></td>
                <td class="kern-table__cell">
                  <% if tier.profile.tools_supported? %>
                    <span class="kern-badge kern-badge--success">
                      <span class="kern-icon kern-icon--success" aria-hidden="true"></span>
                      <span class="kern-label">
                        <%= t("adm.ai_settings.resolved_profile.tools_supported") %>
                      </span>
                    </span>
                  <% else %>
                    <span class="kern-badge kern-badge--warning">
                      <span class="kern-icon kern-icon--warning" aria-hidden="true"></span>
                      <span class="kern-label">
                        <%= t("adm.ai_settings.resolved_profile.tools_unsupported") %>
                      </span>
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if one_model_for_every_tier? %>
        <p class="kern-ai-setting--inline-info">
          <span class="kern-icon kern-icon--info" aria-hidden="true"></span>
          <%= t("adm.ai_settings.resolved_profile.one_model_note") %>
        </p>
      <% end %>
    </div>
  </div>
</section>

<div class="kern-row">
  <div class="kern-col-12 kern-col-md-10">
    <hr class="kern-divider mb-3" aria-hidden="true">
  </div>
</div>
