<%= turbo_frame_tag dom_id(@record, @attribute) do %>
  <div class="attribute-editor-component mb-5" data-controller="components-adm-attribute-editor" data-components-adm-attribute-editor-updated-value="<%= updated? %>">
    <h2 class="kern-title kern-title--small mb-3"><%= label %></h2>

    <div class="kern-row">
      <div class="kern-col-12 kern-col-md-4">
        <p class="kern-body mb-3 mb-md-0"><%= sanitize(description) %></p>
      </div>
      <div class="kern-col-12 kern-col-md-6">
        <div class="attribute-form <%= @kind %>">
          <%= render component_for_type.new(@record, @attribute, **@options) %>

          <% if updated? %>
            <div class="success-message mt-2" data-components-adm-attribute-editor-target="successMessage">
              <%= t("adm.components.attribute_editor.saved") %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="kern-row">
    <div class="kern-col-12 kern-col-md-10">
      <hr class="kern-divider mb-5" aria-hidden="true" />
    </div>
  </div>
<% end %>
