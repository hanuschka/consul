<%= turbo_frame_tag dom_id(@record, @attribute) do %>
  <div class="attribute-editor-component mb-2"
       data-controller="components-adm-attribute-editor"
       role="group"
       aria-labelledby="<%= aria_options[:labelledby] %>"
       aria-describedby="<%= aria_options[:describedby] %>"
       aria-disabled="<%= input_disabled? %>">
    <% if inline? %>
      <div class="kern-row">
        <div class="kern-col-12 kern-col-md-3">
          <div
            id="<%= "#{dom_id(@record)}_#{@attribute}_label" %>"
            class="kern-title kern-title--small mb-3 mb-md-0">
            <%= label %>
          </div>
        </div>
        <div class="kern-col-12 kern-col-md-5">
          <div class="attribute-form <%= @kind %>">
            <%= render component_for_type.new(@record, @attribute, **@options.merge(aria_options).merge(disabled: input_disabled?)) %>
          </div>
        </div>
      </div>
    <% else %>
      <% unless hide_label? %>
        <div
          id="<%= "#{dom_id(@record)}_#{@attribute}_label" %>"
          class="kern-title kern-title--small mb-3">
          <%= label %>
        </div>
      <% end %>

      <% if wide? || stacked? %>
        <% if description.present? %>
          <div class="kern-row">
            <div class="kern-col-12 kern-col-md-9">
              <p id="<%= "#{dom_id(@record)}_#{@attribute}_description" %>" class="kern-body mb-4"><%= sanitize(description) %></p>
            </div>
          </div>
        <% end %>
        <div class="kern-row">
          <div class="kern-col-12 kern-col-md-10">
            <div class="attribute-form <%= @kind %>">
              <%= render component_for_type.new(@record, @attribute, **@options.merge(aria_options).merge(disabled: input_disabled?)) %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="kern-row">
          <div class="kern-col-12 kern-col-md-5">
            <p id="<%= "#{dom_id(@record)}_#{@attribute}_description" %>" class="kern-body mb-3 mb-md-0"><%= sanitize(description) %></p>
          </div>
          <div class="kern-col-12 kern-col-md-5">
            <div class="attribute-form <%= @kind %>">
              <%= render component_for_type.new(@record, @attribute, **@options.merge(aria_options).merge(disabled: input_disabled?)) %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if note.present? %>
      <div class="kern-row">
        <div class="kern-col-12 kern-col-md-10">
          <p class="attribute-editor-component--note kern-body mt-2"><%= sanitize(note) %></p>
        </div>
      </div>
    <% end %>
  </div>

  <% if divider? %>
    <div class="kern-row">
      <div class="kern-col-12 kern-col-md-10">
        <hr class="kern-divider mb-4" aria-hidden="true" />
      </div>
    </div>
  <% end %>
<% end %>
