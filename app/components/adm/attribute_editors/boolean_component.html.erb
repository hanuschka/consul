<%= form_with model: @record, url: @path, class: "d-flex gap-3 align-items-center" do |form| %>
  <%= hidden_field_tag :kind, "boolean" %>
  <%= form.hidden_field :value, id: dom_id(@record, :value), value: (@record.value == "active" ? "" : "active") %>
  <%= form.button "", class: 'toggle-button small',
                  aria: { pressed: @record.value == "active" },
                  autofocus: @updated %>
  <span><%= @label %></span>
<% end %>
