<%= form_with model: @record, url: path, class: "d-flex gap-3 align-items-center" do |form| %>
  <%= hidden_field_tag :kind, "boolean" %>
  <%= hidden_field_tag :attribute, @attribute %>

  <%= form.hidden_field @attribute, value: alternate_value %>
  <%= form.button "", class: 'toggle-button small',
                  aria: { pressed: toggled_on? },
                  autofocus: updated? %>
  <span><%= @label %></span>
<% end %>
