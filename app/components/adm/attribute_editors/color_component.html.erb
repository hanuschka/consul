<%= form_with model: @record, url: path, data: { controller: "adm-color-picker" } do |form| %>
  <%= hidden_field_tag :kind, "color" %>
  <%= hidden_field_tag :attribute, @attribute %>

  <div class="color-picker" data-adm-color-picker-target= "picker"></div>

  <%= form.hidden_field @attribute,
        label: false,
        data: { "adm-color-picker-target": "colorInput" } %>

  <%= helpers.kern_submit_button(icon: "save", autofocus: request.format.turbo_stream?) %>
<% end %>
