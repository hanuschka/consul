<%= turbo_frame_tag frame_id do %>
  <div class="adm-documents-editor"
       data-controller="attribute-editors--documents"
       data-attribute-editors--documents-add-url-value="<%= add_path %>">

    <p class="kern-body kern-body--small mb-3">
      <%= t(".hint",
            max_documents: max_documents_allowed,
            accepted_types: accepted_content_types,
            max_size: max_file_size) %>
    </p>

    <% if documents.any? %>
      <ul class="mb-3" style="list-style: none; padding: 0;">
        <% documents.each do |document| %>
          <li class="d-flex align-items-center justify-content-between mb-2 p-2" style="background: var(--kern-grey-100); border-radius: var(--kern-4);">
            <div>
              <span class="material-symbols-outlined" aria-hidden="true">description</span>
              <%= document.title %>
              <span class="kern-body kern-body--small">(<%= document.humanized_content_type %>, <%= number_to_human_size(document.attachment_file_size) %>)</span>
            </div>
            <%= button_to remove_path_for(document),
                  method: :delete,
                  class: "kern-btn kern-btn--secondary kern-btn--small" do %>
              <span class="material-symbols-outlined" aria-hidden="true">delete</span>
              <span class="kern-label"><%= t(".remove") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if can_add_more? %>
      <button type="button"
              class="kern-btn kern-btn--secondary"
              data-attribute-editors--documents-target="addButton"
              data-action="click->attribute-editors--documents#showForm">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
        <span class="kern-label"><%= t(".add") %></span>
      </button>

      <form data-attribute-editors--documents-target="form"
            data-action="submit->attribute-editors--documents#submit"
            class="d-none mt-3"
            enctype="multipart/form-data">
        <input type="hidden" name="user_id" value="<%= current_user.id %>">

        <div class="kern-form-input mb-3">
          <label class="kern-label" for="document_title"><%= t(".title_label") %></label>
          <input type="text" name="title" class="kern-form-input__input" id="document_title" required>
        </div>

        <div class="kern-form-input mb-3">
          <label class="kern-label" for="document_attachment"><%= t(".file_label") %></label>
          <input type="file" name="attachment" class="kern-form-input__input" id="document_attachment" accept=".pdf" required>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="kern-btn kern-btn--primary">
            <span class="material-symbols-outlined" aria-hidden="true">upload</span>
            <span class="kern-label"><%= t(".upload") %></span>
          </button>
          <button type="button" class="kern-btn kern-btn--secondary" data-action="click->attribute-editors--documents#hideForm">
            <span class="kern-label"><%= t(".cancel") %></span>
          </button>
        </div>

        <div data-attribute-editors--documents-target="error" class="form-error mt-2 d-none"></div>
      </form>
    <% else %>
      <p class="kern-body kern-body--small">
        <%= t(".max_reached") %>
      </p>
    <% end %>
  </div>
<% end %>
