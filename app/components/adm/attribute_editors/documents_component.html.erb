<%= turbo_frame_tag "edit__documents" do %>
  <%= form_with model: documentable, url: update_path, method: :patch, multipart: true do |form| %>
    <%= render Kern::Form::DocumentsComponent.new(form: form) %>

    <%= kern_button(text: t(".save"), icon: "save", type: "submit", class: "mt-3") %>
  <% end %>

  <% if helpers.flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove"><%= helpers.flash[:success] %></div>
  <% end %>
<% end %>
