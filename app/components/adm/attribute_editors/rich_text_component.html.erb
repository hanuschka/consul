<%= form_with model: @record, url: path do |form| %>
  <%= hidden_field_tag :kind, "rich_text" %>
  <%= hidden_field_tag :attribute, @attribute %>
  <%= hidden_field_tag :wide, @options[:wide] if @options[:wide] %>
  <%= hidden_field_tag :hide_label, @options[:hide_label] if @options[:hide_label] %>

  <div class="mb-3 <%= 'disabled' if disabled? %>">
    <%= form.text_area @attribute,
      value: sanitized_value,
      label: false,
      disabled: disabled?,
      aria: aria_attributes,
      data: { controller: "ckeditor", ckeditor_toolbar_value: @options[:toolbar] || ck_editor_class(current_user) } %>
  </div>

  <%= form_submit_button(autofocus: request.format.turbo_stream?, disabled: disabled?) %>
<% end %>

<% if flash[:success].present? %>
  <div class="input-success-message mt-2" data-controller="auto-remove">
    <%= flash[:success] %>
  </div>
<% end %>
