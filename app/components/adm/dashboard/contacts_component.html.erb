<div class="adm-dashboard__section adm-dashboard__people-col">
  <div class="adm-dashboard__section-header">
    <span class="material-symbols-outlined" aria-hidden="true">contact_phone</span>
    <h3><%= t(".title") %></h3>
  </div>

  <div class="adm-dashboard__contact-persons">
    <% contacts.each do |person| %>
      <div class="adm-dashboard__contact-card">
        <% if person.user.image.present? %>
          <%= image_tag(person.user.image.variant(:thumb2), class: "adm-dashboard__contact-avatar", alt: person.user.name) %>
        <% else %>
          <div class="adm-dashboard__contact-avatar adm-dashboard__contact-avatar--placeholder">
            <%= person.user.first_letter_of_name %>
          </div>
        <% end %>
        <div class="adm-dashboard__contact-info">
          <div class="adm-dashboard__contact-name"><%= person.name %></div>
          <% if person.role.present? %>
            <div class="adm-dashboard__contact-role"><%= person.role %></div>
          <% end %>
          <div class="adm-dashboard__contact-details">
            <% if person.email.present? %>
              <a href="mailto:<%= person.email %>">
                <span class="material-symbols-outlined" style="font-size: 14px;" aria-hidden="true">mail</span>
                <%= person.email %>
              </a>
            <% end %>
            <% if person.phone.present? %>
              <a href="tel:<%= person.phone %>">
                <span class="material-symbols-outlined" style="font-size: 14px;" aria-hidden="true">phone</span>
                <%= person.phone %>
              </a>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
