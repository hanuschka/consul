<div class="adm-dashboard__notice"
     data-controller="adm-dashboard-notice"
     data-adm-dashboard-notice-storage-key-value="<%= storage_key %>">
  <span class="material-symbols-outlined adm-dashboard__notice-icon" aria-hidden="true">info</span>
  <div class="adm-dashboard__notice-text"><%= message %></div>
  <button type="button"
          class="adm-dashboard__notice-close"
          aria-label="<%= t(".dismiss") %>"
          data-action="adm-dashboard-notice#dismiss">
    <span class="material-symbols-outlined" aria-hidden="true">close</span>
  </button>
</div>
