<div
  class="<%= wrapper_classes %>"
  data-controller="adm--delete-collection"
>
  <div
    class="adm-delete-collection"
    data-adm--delete-collection-target="progress"
    hidden
    role="status"
    aria-live="polite"
  >
    <span class="adm-delete-collection--spinner material-symbols-outlined" aria-hidden="true">
      progress_activity
    </span>
    <div class="adm-delete-collection--text">
      <span class="adm-delete-collection--headline"><%= headline %></span>
      <span class="adm-delete-collection--hint"><%= hint %></span>
    </div>
  </div>

  <%= helpers.kern_link_button url,
        text: text,
        icon: icon,
        style: style,
        data: {
          turbo_method: :delete,
          turbo_confirm: confirm,
          "adm--delete-collection-target": "trigger"
        } %>
</div>
