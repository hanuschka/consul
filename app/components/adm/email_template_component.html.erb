<%= turbo_frame_tag dom_id(@email_template) do %>
  <details class="adm-admin-phase" data-mailer-class="<%= @email_template.mailer_class %>" data-mailer-action="<%= @email_template.mailer_action %>" <%= "open" if @open %>>
    <summary class="adm-admin-phase__header">
      <div class="adm-admin-phase__title">
        <span class="adm-admin-phase__icon material-symbols-outlined" aria-hidden="true">mail</span>
        <%= label %>
      </div>
      <div class="adm-admin-phase__chips">
        <% if recipient_type_label.present? %>
          <span class="adm-admin-chip adm-admin-chip--info">
            <span class="material-symbols-outlined" aria-hidden="true"><%= recipient_type_icon %></span>
            <%= recipient_type_label %>
          </span>
        <% end %>
        <% if @email_template.customized? %>
          <span class="adm-admin-chip adm-admin-chip--success">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <%= t(".customized") %>
          </span>
        <% end %>
      </div>
    </summary>

    <div class="adm-admin-phase__body pt-3">
      <div class="mb-4">
        <div class="kern-title kern-title--small mb-2"><%= t(".trigger") %></div>
        <div class="kern-row">
          <div class="kern-col-12 kern-col-md-3">
            <p class="kern-body kern-body--small mb-0"><%= t(".trigger_description") %></p>
          </div>
          <div class="kern-col-12 kern-col-md-7">
            <div class="adm-email-template-preview"><%= description %></div>
          </div>
        </div>
      </div>

      <% if recipient.present? %>
        <div class="mb-4">
          <div class="kern-title kern-title--small mb-2"><%= t(".recipient") %></div>
          <div class="kern-row">
            <div class="kern-col-12 kern-col-md-3">
              <p class="kern-body kern-body--small mb-0"><%= t(".recipient_description") %></p>
            </div>
            <div class="kern-col-12 kern-col-md-7">
              <div class="adm-email-template-preview"><%= recipient %></div>
            </div>
          </div>
        </div>
      <% end %>

      <% if default_template_preview.present? %>
        <div class="mb-4">
          <div class="kern-title kern-title--small mb-2"><%= t(".default_template") %></div>
          <div class="kern-row">
            <div class="kern-col-12 kern-col-md-3">
              <p class="kern-body kern-body--small mb-0"><%= t(".default_template_description") %></p>
            </div>
            <div class="kern-col-12 kern-col-md-7">
              <div class="adm-email-template-preview"><%= default_template_preview.html_safe %></div>
            </div>
          </div>
        </div>
      <% end %>

      <%= form_with model: @email_template, url: path, method: :patch do |form| %>
        <div class="mb-4">
          <div class="kern-title kern-title--small mb-2"><%= t(".subject") %></div>
          <div class="kern-row">
            <div class="kern-col-12 kern-col-md-3">
              <p class="kern-body kern-body--small mb-0"><%= t(".subject_description") %></p>
            </div>
            <div class="kern-col-12 kern-col-md-7">
              <%= form.text_field :subject, label: false, class: "kern-form-input__input", placeholder: t(".subject_placeholder") %>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <div class="kern-title kern-title--small mb-2"><%= t(".body") %></div>
          <div class="kern-row">
            <div class="kern-col-12 kern-col-md-3">
              <p class="kern-body kern-body--small mb-0"><%= t(".body_description") %></p>
              <% if variables.any? %>
                <p class="kern-body kern-body--small mt-2 mb-0">
                  <%= t(".available_variables") %>:<br>
                  <%= variables_hint.html_safe %>
                </p>
              <% end %>
            </div>
            <div class="kern-col-12 kern-col-md-7">
              <%= form.text_area :body,
                value: sanitized_body,
                label: false,
                data: { controller: "ckeditor", ckeditor_toolbar_value: "email" } %>
            </div>
          </div>
        </div>

        <div class="d-flex align-items-center gap-3 mb-4">
          <%= kern_button(text: I18n.t("shared.submit"), icon: "save", type: "submit") %>

          <% if @email_template.customized? %>
            <%= kern_button(text: t(".send_test"), icon: "send", style: :secondary, type: :submit, form: "send_test_#{dom_id(@email_template)}") %>
          <% end %>
        </div>
      <% end %>

      <% if @email_template.customized? %>
        <%= form_with url: send_test_path, method: :post, html: { id: "send_test_#{dom_id(@email_template)}" } do %>
        <% end %>
      <% end %>

      <% if flash[:success].present? %>
        <div class="input-success-message mt-2" data-controller="auto-remove">
          <%= flash[:success] %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
