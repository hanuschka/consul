<form
  method="get"
  action="<%= endpoint %>"
  class="adm-filter-bar js-adm-filter-bar"
  data-turbo-frame="files-index-results"
  data-files--filter-bar-target="form"
  data-action="formdata->files--filter-bar#stripBlankEntries"
>
  <div class="adm-filter-bar--field adm-filter-bar--field-search">
    <i class="fa fa-search adm-filter-bar--search-icon" aria-hidden="true"></i>
    <input
      type="search"
      name="search"
      value="<%= params[:search] %>"
      class="adm-filter-bar--input adm-filter-bar--input-search js-fm-filter-search"
      placeholder="<%= t("files.filter_bar.search_placeholder") %>"
      aria-label="<%= t("files.filter_bar.aria.search") %>"
      data-action="input->files--filter-bar#inputChanged"
    >
  </div>

  <div class="adm-filter-bar--field">
    <select
      name="extension"
      class="adm-filter-bar--input js-fm-filter-extension"
      aria-label="<%= t("files.filter_bar.aria.filter_extension") %>"
      data-action="change->files--filter-bar#filterChanged"
    >
      <option value=""><%= t("files.filter_bar.extension_any") %></option>
      <% extension_options.each do |ext| %>
        <option value="<%= ext %>" <%= "selected" if ext == params[:extension] %>>.<%= ext %></option>
      <% end %>
    </select>
  </div>

  <% if imageable_type_frame_src.present? %>
    <%= turbo_frame_tag "files-imageable-type-filter",
        src: imageable_type_frame_src,
        loading: "lazy",
        class: "adm-filter-bar--frame" do %>
      <div class="adm-filter-bar--field">
        <select class="adm-filter-bar--input"
                aria-label="<%= t("files.filter_bar.aria.filter_imageable_type") %>"
                disabled>
          <option value=""></option>
        </select>
      </div>
    <% end %>
  <% end %>

  <% if documentable_type_frame_src.present? %>
    <%= turbo_frame_tag "files-documentable-type-filter",
        src: documentable_type_frame_src,
        loading: "lazy",
        class: "adm-filter-bar--frame" do %>
      <div class="adm-filter-bar--field">
        <select class="adm-filter-bar--input"
                aria-label="<%= t("files.filter_bar.aria.filter_documentable_type") %>"
                disabled>
          <option value=""></option>
        </select>
      </div>
    <% end %>
  <% end %>

  <div class="adm-filter-bar--field adm-filter-bar--field-sort">
    <i class="fa fa-sort adm-filter-bar--sort-icon" aria-hidden="true"></i>
    <select
      name="sort"
      class="adm-filter-bar--input adm-filter-bar--input-sort js-fm-filter-sort"
      aria-label="<%= t("files.filter_bar.aria.sort") %>"
      data-action="change->files--filter-bar#filterChanged"
    >
      <% Adm::FilterBarComponent::SORT_OPTIONS.each do |key| %>
        <option value="<%= key %>" <%= "selected" if key == params[:sort] %>><%= t("files.filter_bar.sort.#{key}") %></option>
      <% end %>
    </select>
  </div>

  <button
    type="button"
    class="adm-filter-bar--reset-button js-fm-filter-reset"
    data-action="click->files--filter-bar#resetClicked"
  >
    <%= t("files.filter_bar.reset") %>
  </button>

  <% if show_view_modes? %>
    <div class="files-index--view-controls">
      <button
        type="button"
        class="files-index--view-button -cards"
        data-action="click->files--filter-bar#viewModeCardsClicked"
        data-files--filter-bar-target="viewModeCardsButton"
        title="<%= t("files.view_mode.cards") %>"
        aria-label="<%= t("files.view_mode.cards") %>"
      >
        <i class="fa fa-th"></i>
      </button>
      <button
        type="button"
        class="files-index--view-button -list"
        data-action="click->files--filter-bar#viewModeListClicked"
        data-files--filter-bar-target="viewModeListButton"
        title="<%= t("files.view_mode.list") %>"
        aria-label="<%= t("files.view_mode.list") %>"
      >
        <i class="fa fa-list"></i>
      </button>
    </div>
  <% end %>
</form>
