<div class="main-container-wrapper">
  <div class="kern-container main-container">
    <div class="adm-page-header__nav">
      <% if @breadcrumbs.present? %>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb-list my-3">
            <% if @back_button_url %>
              <li class="breadcrumb-item breadcrumb-item--back">
                <%= link_to @back_button_url, class: "breadcrumb-back-button", data: { turbo_action: "advance" } do %>
                  <span class="material-symbols-outlined" aria-hidden="true">arrow_back_ios</span>
                  <span><%= t("shared.back") %></span>
                <% end %>
              </li>
            <% end %>
            <% @breadcrumbs.each_with_index do |breadcrumb, index| %>
              <% is_last = index == @breadcrumbs.size - 1 %>
              <%= breadcrumb_item(breadcrumb, is_last) %>
            <% end %>
          </ol>
        </nav>

        <% if @frontend_url.present? %>
          <%= link_to @frontend_url, class: "adm-frontend-link text-decoration-none d-none d-md-flex align-items-md-center gap-1 py-2 px-3 fs-2 fw-medium ml-auto", target: "_blank", rel: "noopener" do %>
            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
            <span><%= t("components.adm.header_component.frontend_link") %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<hr class="kern-divider" aria-hidden="true" />

<div class="kern-container <%= 'kern-container--form' if @narrow %>">
  <div class="adm-page-title-row <%= '-compact' if @compact %>">
    <h1 class="adm-page-title" id="adm-page-title"><%= @title %></h1>
    <%= hint if hint? %>
    <%= actions if actions? %>
  </div>
</div>
