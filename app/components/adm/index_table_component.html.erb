<%# Always emits data-adm-column-selector-target="table". %>
<%# Without the wrapping controller this attribute is inert, which keeps the template branch-free. %>
<%= turbo_frame_tag turbo_frame_id do %>
  <% if column_selector? %>
    <div data-controller="adm-column-selector"
         data-adm-column-selector-storage-key-value="<%= column_selector[:storage_key] %>"
         data-adm-column-selector-defaults-value="<%= column_selector[:defaults] %>"
         data-action="click@window->adm-column-selector#close">
  <% end %>

  <% if show_toolbar? %>
    <div class="d-flex align-items-center gap-3 mb-3">
      <% if column_selector? %>
        <div class="adm-column-selector">
          <button type="button" class="adm-column-selector__toggle" data-action="adm-column-selector#toggle">
            <span class="material-symbols-outlined" aria-hidden="true">view_column</span>
            <%= t(".columns") %>
          </button>
          <div class="adm-column-selector__menu" data-adm-column-selector-target="menu">
            <div data-adm-column-selector-target="list"></div>
          </div>
        </div>
      <% end %>

      <%= render pills_component %>

      <% if toolbar_meta? %>
        <%= toolbar_meta %>
      <% end %>

      <div class="flex-grow-1"></div>

      <% toolbar_actions.each do |action| %>
        <%= action %>
      <% end %>
    </div>
  <% end %>

  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table" data-adm-column-selector-target="table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <%= header_row %>
        </tr>
      </thead>

      <%= tag.tbody(class: "kern-table__body", **body_html_options.symbolize_keys) do %>
        <% if records.any? %>
          <%= body %>
        <% else %>
          <% es = empty_state_for_current_view %>
          <tr class="kern-table__row">
            <td class="kern-table__cell kern-table__cell--empty" colspan="<%= column_count %>">
              <%= helpers.empty_state(title: es[:title], description: es[:description], icon: es[:icon]) %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </table>
  </div>

  <% if show_pagination? %>
    <div class="my-5">
      <%== pagy_nav(pagy) %>
    </div>
  <% end %>

  <% if column_selector? %>
    </div>
  <% end %>
<% end %>
