<% i18n_scope = "components.adm.map_layers_component" %>
<div class="mb-5">
  <div class="kern-title kern-title--small mb-3">
    <%= t("#{i18n_scope}.title") %>
  </div>

  <p class="kern-body mb-3"><%= t("#{i18n_scope}.description") %></p>

  <%= helpers.new_resource_link(new_path, t("#{i18n_scope}.add_layer")) %>

  <% if map_layers.any? %>
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t("#{i18n_scope}.table.name") %></th>
          <th scope="col" class="kern-table__header"><%= t("#{i18n_scope}.table.type") %></th>
          <th scope="col" class="kern-table__header"><%= t("#{i18n_scope}.table.layer_names") %></th>
          <th scope="col" class="kern-table__header"></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% map_layers.each do |layer| %>
          <tr class="kern-table__row" id="<%= dom_id(layer) %>">
            <th scope="row" class="kern-table__header"><%= layer.name %></th>
            <td class="kern-table__cell"><%= layer.base? ? t("#{i18n_scope}.table.base") : t("#{i18n_scope}.table.layer") %></td>
            <td class="kern-table__cell"><%= layer.layer_names %></td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(
                  label: t("#{i18n_scope}.actions.edit"),
                  url: edit_path(layer),
                  icon: "edit",
                  style: :edit
                ) %>
                <% actions.with_action(
                  label: t("#{i18n_scope}.actions.delete"),
                  url: destroy_path(layer),
                  icon: "delete",
                  style: :delete,
                  method: :delete,
                  data: { turbo_confirm: t("#{i18n_scope}.actions.delete_confirm") }
                ) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= helpers.empty_state(
          title: t("#{i18n_scope}.no_layers"),
          icon: "layers",
          link_url: new_path,
          link_text: t("#{i18n_scope}.add_layer")
        ) %>
  <% end %>
</div>
