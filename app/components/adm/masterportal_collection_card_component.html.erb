<article
  id="<%= dom_id(collection) %>"
  class="adm-masterportal-collection-card"
  data-controller="adm--masterportal-collection"
  data-adm--masterportal-collections-resync-target="card"
  data-adm--masterportal-collection-update-url-value="<%= update_url %>"
  data-adm--masterportal-collection-delete-url-value="<%= delete_url %>"
  data-adm--masterportal-collection-status-url-value="<%= status_url %>"
  data-adm--masterportal-collection-diff-url-value="<%= diff_url %>"
  data-adm--masterportal-collection-clean-url-value="<%= clean_url %>"
  data-adm--masterportal-collection-card-url-value="<%= card_url %>"
  data-adm--masterportal-collection-confirm-value="<%= t(".delete_confirm", name: collection.display_name) %>"
  data-adm--masterportal-collection-clean-confirm-value="<%= t(".clean_confirm", name: collection.display_name) %>"
  data-adm--masterportal-collection-checking-label-value="<%= t(".diff.checking_label") %>"
  data-adm--masterportal-collection-initial-import-status-value="<%= collection.import_status %>"
  data-adm--masterportal-collection-initial-destroy-status-value="<%= collection.destroy_status %>"
>
  <% if icon_src.present? %>
    <img
      class="adm-masterportal-collection-card--icon"
      src="<%= icon_src %>"
      alt=""
      loading="lazy"
      referrerpolicy="no-referrer"
    >
  <% else %>
    <span
      class="adm-masterportal-collection-card--icon -placeholder"
      title="<%= t(".icon_missing") %>"
      aria-hidden="true"
    >
      <span class="material-symbols-outlined">image_not_supported</span>
    </span>
  <% end %>

  <div class="adm-masterportal-collection-card--info">
    <h4 class="adm-masterportal-collection-card--name"><%= collection.display_name %> (<%= collection.pins_count %>)</h4>

    <% if collection.source_url.present? %>
      <a
        class="adm-masterportal-collection-card--source"
        href="<%= collection.source_url %>"
        title="<%= collection.source_url %>"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="material-symbols-outlined" aria-hidden="true">link</span>
      </a>
    <% elsif collection.file_source? %>
      <rich-tooltip delay="400" trigger-only shadow="heavy">
        <span class="adm-masterportal-collection-card--source-chip" tabindex="0">
          <span class="material-symbols-outlined" aria-hidden="true">description</span>
          <%= t(".source_file_label") %>
        </span>

        <template>
          <span class="rich-tooltip-content">
            <span class="rich-tooltip-content--title"><%= t(".source_file_tooltip_title") %></span>
            <span class="rich-tooltip-content--text"><%= t(".source_file_tooltip_text") %></span>
          </span>
        </template>
      </rich-tooltip>
    <% end %>

    <dl class="adm-masterportal-collection-card--meta">
      <div class="adm-masterportal-collection-card--meta-item">
        <dt><%= t(".created_at") %></dt>
        <dd><%= l(collection.created_at, format: :short) %></dd>
      </div>
      <div class="adm-masterportal-collection-card--meta-item">
        <dt><%= t(".last_imported_at") %></dt>
        <dd>
          <% if collection.last_imported_at.present? %>
            <%= l(collection.last_imported_at, format: :short) %>
          <% else %>
            <%= t(".never") %>
          <% end %>
        </dd>
      </div>
      <div class="adm-masterportal-collection-card--meta-item">
        <dt><%= t(".pins_count") %></dt>
        <dd><%= collection.pins_count %></dd>
      </div>
      <div class="adm-masterportal-collection-card--meta-item">
        <dt><%= t(".resources_count") %></dt>
        <dd><%= collection.resources_count %></dd>
      </div>
    </dl>

    <div
      class="adm-masterportal-collection-card--diff"
      data-adm--masterportal-collection-target="diff"
      data-state="<%= diff_badge_state %>"
      role="status"
      aria-live="polite"
      <%= "hidden" if diff_badge_hidden? %>
    >
      <span
        class="material-symbols-outlined"
        aria-hidden="true"
        data-adm--masterportal-collection-target="diffIcon"
      ><%= diff_badge_icon %></span>
      <span data-adm--masterportal-collection-target="diffText"><%= diff_badge_text %></span>
    </div>
  </div>

  <div
    class="adm-masterportal-collection-card--progress"
    data-adm--masterportal-collection-target="progress"
    hidden
    role="status"
    aria-live="polite"
  >
    <span class="material-symbols-outlined" aria-hidden="true">progress_activity</span>
    <span><%= t(".working") %></span>
  </div>

  <div
    class="adm-masterportal-collection-card--error"
    data-adm--masterportal-collection-target="error"
    hidden
    role="alert"
  >
    <span class="material-symbols-outlined" aria-hidden="true">error</span>
    <span data-adm--masterportal-collection-target="errorText"></span>
  </div>

  <div
    class="adm-masterportal-collection-card--actions"
    data-adm--masterportal-collection-target="actions"
  >
    <button
      type="button"
      class="adm-masterportal-collection-card--button -resync"
      title="<%= t(".clean_tooltip") %>"
      data-action="adm--masterportal-collection#importAndClean"
    >
      <span class="material-symbols-outlined" aria-hidden="true">autorenew</span>
      <%= t(".clean") %>
    </button>
    <button
      type="button"
      class="adm-masterportal-collection-card--button -delete"
      title="<%= t(".delete_tooltip") %>"
      data-action="adm--masterportal-collection#remove"
    >
      <span class="material-symbols-outlined" aria-hidden="true">delete</span>
      <%= t(".delete") %>
    </button>
  </div>
</article>
