<section
  class="adm-masterportal-collections"
  data-controller="adm--masterportal-collections-resync"
  data-adm--masterportal-collections-resync-update-confirm-value="<%= t(".update_all_confirm") %>"
  data-adm--masterportal-collections-resync-clean-confirm-value="<%= t(".clean_all_confirm") %>"
>
  <div class="adm-masterportal-collections--header">
    <h3 class="adm-masterportal-collections--title"><%= t(".title") %></h3>

    <div class="adm-masterportal-collections--actions">
      <rich-tooltip delay="500" trigger-only shadow="heavy">
        <button
          type="button"
          class="adm-masterportal-collections--action-button -resync"
          data-adm--masterportal-collections-resync-target="button"
          data-action="adm--masterportal-collections-resync#resync"
        >
          <span class="material-symbols-outlined" aria-hidden="true">published_with_changes</span>
          <%= t(".resync") %>
        </button>
        <template>
          <span class="rich-tooltip-content">
            <span class="rich-tooltip-content--title"><%= t(".resync_tooltip_title") %></span>
            <span class="rich-tooltip-content--text"><%= t(".resync_tooltip_text") %></span>
          </span>
        </template>
      </rich-tooltip>

      <rich-tooltip delay="500" trigger-only shadow="heavy">
        <button
          type="button"
          class="adm-masterportal-collections--action-button -update"
          data-adm--masterportal-collections-resync-target="button"
          data-action="adm--masterportal-collections-resync#updateAll"
        >
          <span class="material-symbols-outlined" aria-hidden="true">sync</span>
          <%= t(".update_all") %>
        </button>
        <template>
          <span class="rich-tooltip-content">
            <span class="rich-tooltip-content--title"><%= t(".update_all_tooltip_title") %></span>
            <span class="rich-tooltip-content--text"><%= t(".update_all_tooltip_text") %></span>
          </span>
        </template>
      </rich-tooltip>

      <rich-tooltip delay="500" trigger-only shadow="heavy">
        <button
          type="button"
          class="adm-masterportal-collections--action-button -clean"
          data-adm--masterportal-collections-resync-target="button"
          data-action="adm--masterportal-collections-resync#cleanAll"
        >
          <span class="material-symbols-outlined" aria-hidden="true">cleaning_services</span>
          <%= t(".clean_all") %>
        </button>
        <template>
          <span class="rich-tooltip-content">
            <span class="rich-tooltip-content--title"><%= t(".clean_all_tooltip_title") %></span>
            <span class="rich-tooltip-content--text"><%= t(".clean_all_tooltip_text") %></span>
          </span>
        </template>
      </rich-tooltip>
    </div>
  </div>

  <p class="adm-masterportal-collections--description"><%= t(".description") %></p>

  <div class="adm-masterportal-collections--cards">
    <%= render Adm::MasterportalCollectionCardComponent.with_collection(
      collections, projekt_phase: projekt_phase
    ) %>
  </div>
</section>
