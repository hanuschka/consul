<div
  class="js-newsletter-content-block-editor newsletter-content-block-editor"
  data-email-origin="<%= email_origin %>"
>
  <div
    class="js-content-blocks-list content-blocks-container"
    data-create-url="<%= create_url %>"
    data-generate-url="<%= generate_url %>"
    data-template-section="newsletter_email"
    data-default-margin-bottom="<%= default_margin_bottom %>"
    data-ai-available="<%= Ai::Settings.ai_available? %>"
  >
    <div
      class="add-new-content-block-section js-show-content-block-templates-section js-add-content-block-at-top -at-top"
      <% if content_blocks.empty? %>style="display: none;"<% end %>
    >
      <div class="add-new-content-block-section--controls">
        <%= render Shared::AiFeatureTooltipComponent.new(
          feature_text: t('custom.newsletters.content_block_editor.add_with_ai_title')
        ) do %>
          <button
            type="button"
            class="add-new-content-block-floating-control content-block-templates-selector--ai-create js-open-create-content-block-with-ai"
          >
            <i class="fas fa-magic"></i>
          </button>
        <% end %>
        <button
          type="button"
          class="js-show-content-block-templates add-new-content-block-button"
          title="<%= t('custom.newsletters.content_block_editor.add_at_top_title') %>"
        >
          <i class="fas fa-plus"></i>
        </button>
      </div>
    </div>

    <% content_blocks.each do |content_block| %>
      <div
        class="js-newsletter-content-block"
        data-content-block-id="<%= content_block.id %>"
        data-update-url="<%= update_url(content_block) %>"
        data-destroy-url="<%= update_url(content_block) %>"
        data-update-position-url="<%= update_position_url(content_block) %>"
        data-ai-url="<%= ai_url(content_block) %>"
        <% if effective_margin(content_block) > 0 %>
          style="margin-bottom: <%= effective_margin(content_block) %>px;"
        <% end %>
      >
        <%= block_body_html(content_block) %>
      </div>
    <% end %>
  </div>

  <div
    class="js-content-start-section newsletter-content-start-section"
    <% if content_blocks.any? %>style="display: none;"<% end %>
  >
    <h3 class="newsletter-content-start-section--title">
      <%= t('custom.newsletters.content_block_editor.start_section_title') %>
    </h3>
    <div class="newsletter-content-start-section--buttons">
      <button
        type="button"
        class="studio-edit-button -green -with-background js-show-content-block-templates"
      >
        <i class="fas fa-plus"></i>
        <%= t('custom.newsletters.content_block_editor.start_section_add_template') %>
      </button>
      <%= render Shared::AiFeatureTooltipComponent.new(
        feature_title: t('custom.newsletters.content_block_editor.start_section_add_with_ai'),
        feature_text: t('custom.newsletters.content_block_editor.add_with_ai_title')
      ) do %>
        <button
          type="button"
          class="studio-edit-button -green -with-background js-open-create-content-block-with-ai"
        >
          <i class="fas fa-magic"></i>
          <%= t('custom.newsletters.content_block_editor.start_section_add_with_ai') %>
        </button>
      <% end %>
    </div>
  </div>
</div>
