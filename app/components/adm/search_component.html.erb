<div class="kern-row">
  <div class="kern-col-6">
    <%= form_tag(url, options) do |f| %>
      <div class="d-flex gap-2">
        <div class="kern-form-input">
          <%= text_field_tag :search, search_terms.to_s, class: "kern-form-input__input", placeholder: label, "aria-label": label %>
        </div>

        <%= kern_submit_button(icon: nil, text: t(".shared.search"), autofocus: false) %>
      </div>
    <% end %>
  </div>
</div>

<div class="kern-row mb-5">
  <div class="kern-col">
    <%= turbo_frame_tag "search_results" %>
  </div>
</div>
