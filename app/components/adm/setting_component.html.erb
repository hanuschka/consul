<%= turbo_frame_tag @setting do %>
  <div class="setting-component mb-5" data-controller="adm-setting" data-adm-setting-updated-value="<%= @updated %>">
    <h2 class="kern-title kern-title--small mb-3"><%= t("#{@setting.class.name.underscore}.#{@setting.key}") %></h2>
    <div class="kern-row">
      <div class="kern-col-12 kern-col-md-4">
        <p id="<%= dom_id(@setting, :description) %>" class="kern-body mb-3 mb-md-0">
          <%= t("#{@setting.class.name.underscore}.#{@setting.key}_description", default: t("admin.settings.no_description")) %>
        </p>
      </div>
      <div class="kern-col-12 kern-col-md-6">
        <div class="setting-input <%= @kind %>">
          <%= render component_for_type.new(setting: @setting, path: set_path(@path), updated: @updated) %>

          <% if @updated %>
            <div class="success-message mt-2" data-adm-setting-target="successMessage">
              <%= t("adm.components.setting_component.saved") %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="kern-row">
    <div class="kern-col-12 kern-col-md-10">
      <hr class="kern-divider mb-5" aria-hidden="true" />
    </div>
  </div>
<% end %>
