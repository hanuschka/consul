<%= form_with model: @setting, url: @path do |form| %>
  <%= hidden_field_tag :kind, "boolean" %>
  <%= form.hidden_field :value, id: dom_id(@setting, :value), value: (@setting.value == "active" ? "" : "active") %>
  <%= form.button "", class: 'toggle-button small',
                  aria: { pressed: @setting.value == "active" },
                  autofocus: @updated %>
<% end %>
