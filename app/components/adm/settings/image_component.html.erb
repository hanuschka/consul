<div data-controller="components-adm-settings-image">
  <%= form_with model: @setting, url: @path, data: { 'components-adm-settings-image-target': 'form' } do |form| %>
    <%= hidden_field_tag :kind, "image" %>

      <div class="kern-form-input <%= 'd-none' if show_preview? %>" data-components-adm-settings-image-target="dropzone">
        <%= form.file_field :image,
                            label: false,
                            accept: SiteCustomization::Image::VALID_FORMATS.join(','),
                            class: 'kern-form-input__input',
                            data: {
                              "components-adm-settings-image-target": "fileInput",
                              "action": "change->components-adm-settings-image#submitForm"
                            } %>
      </div>

      <div class='<%= 'd-none' unless show_preview? %>' data-components-adm-settings-image-target="preview">
        <%= image_tag(@setting.image, style: "width:100%;") if @setting.image.attached? %>
      </div>

      <div class='error-message mt-3 <%= 'd-none' if @setting.errors.blank? %>'>
        <%= helpers.content_tag(:span, class: '') { sanitize @setting.errors[:image].join('; ') } %>
      </div>

      <div class="d-flex justify-content-end mt-3 <%= 'd-none' unless show_preview? %>" data-components-adm-settings-image-target="resetButton">
        <button type='button'
                class="kern-btn kern-btn--secondary"
                data-action='click->components-adm-settings-image#resetForm'>
          <span class="kern-label">
            <%= t('adm.components.settings.image_component.reset_button') %>
          </span>
        </button>
      </div>
  <% end %>
</div>
