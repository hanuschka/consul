<%= form_with model: @setting, url: @path do |form| %>
  <%= hidden_field_tag :kind, "string" %>

  <div class="setting-controls">
    <div class="kern-form-input">
      <%= form.text_field :value,
        id: dom_id(@setting, :value),
        label: false,
        placeholder: t("setting.#{@setting.key}"),
        class: "kern-form-input__input",
        "data-adm-setting-target": "input",
        aria: { describedby: dom_id(@setting, :description) } %>
    </div>

    <%= helpers.kern_submit_button(icon: "save", autofocus: @updated) %>
  </div>
<% end %>
