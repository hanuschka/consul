<tr class="kern-table__row" id="<%= dom_id @content_card %>" data-sortable-id="<%= @content_card.id %>">
  <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
    <span class="material-symbols-outlined" aria-hidden="true">drag_indicator</span>
  </td>
  <th scope="row" class="kern-table__header"><%= @content_card.title %></th>
  <td class="kern-table__cell"><%= count %></td>
  <td class="kern-table__cell">
    <%= render Adm::AttributeEditors::BooleanComponent.new(
      @content_card,
      :active,
      path: toggle_active_adm_site_customization_content_card_path(@content_card)
    ) %>
  </td>
  <td class="kern-table__cell">
    <%= link_to edit_adm_site_customization_content_card_path(@content_card) do %>
      <%= tag.span(class: "material-symbols-outlined") { "edit" } %>
    <% end %>
  </td>
</tr>
