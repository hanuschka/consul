<article class="kern-card adm-whatsapp-qr">
  <div class="kern-card__container <%= "adm-whatsapp-qr--split" if deep_link.present? %>">
    <div class="adm-whatsapp-qr--main">
      <div class="kern-card__header adm-whatsapp-qr--heading">
        <h2 class="kern-title"><%= title %></h2>
        <p class="kern-subline"><%= subline %></p>
      </div>

      <section class="kern-card__body">
        <% if deep_link.blank? %>
          <%= kern_alert(title: t("adm.whatsapp.missing_number"), style: :warning) %>
        <% else %>
          <dl class="adm-whatsapp-qr--details">
            <% if token.present? %>
              <%= render "adm/whatsapp/copy_field",
                    label: t("adm.whatsapp.token"),
                    copy_label: t("adm.whatsapp.copy_token"),
                    text: token %>
            <% end %>

            <%= render "adm/whatsapp/copy_field",
                  label: t("adm.whatsapp.number"),
                  copy_label: t("adm.whatsapp.copy_number"),
                  text: "+#{business_number}",
                  text_modifier: "numeric" %>

            <%= render "adm/whatsapp/copy_field",
                  label: t("adm.whatsapp.link"),
                  copy_label: t("adm.whatsapp.copy_link"),
                  text: deep_link,
                  href: deep_link,
                  hint: t("adm.whatsapp.link_hint") %>
          </dl>
        <% end %>
      </section>
    </div>

    <% if deep_link.present? %>
      <div
        class="adm-whatsapp-qr--code"
        data-controller="adm--whatsapp-qr-download"
        data-adm--whatsapp-qr-download-basename-value="<%= download_basename %>"
      >
        <div
          class="adm-whatsapp-qr--code-frame"
          data-adm--whatsapp-qr-download-target="code"
        ><%= raw qr_svg %></div>

        <div class="adm-whatsapp-qr--actions">
          <%# PDF poster download disabled for now — restore together with the
              qr_poster route and controller action. %>
          <%#= helpers.kern_link_button(
            poster_path,
            text: t("adm.whatsapp.download_pdf"),
            icon: "picture_as_pdf",
            style: :secondary,
            class: "adm-whatsapp-qr--action",
            data: { turbo: false }
          ) %>

          <%= kern_button(
            text: t("adm.whatsapp.download_jpeg"),
            icon: "image",
            style: :secondary,
            type: "button",
            class: "adm-whatsapp-qr--action",
            data: { action: "adm--whatsapp-qr-download#downloadJpeg" }
          ) %>
        </div>

        <p class="adm-whatsapp-qr--code-hint"><%= t("adm.whatsapp.qr_hint") %></p>
      </div>
    <% end %>
  </div>
</article>
