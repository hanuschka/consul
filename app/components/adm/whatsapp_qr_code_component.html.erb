<article class="kern-card adm-whatsapp-qr">
  <div class="kern-card__container <%= "adm-whatsapp-qr--split" if deep_link.present? %>">
    <div class="adm-whatsapp-qr--main">
      <div class="kern-card__header adm-whatsapp-qr--heading">
        <h2 class="kern-title"><%= title %></h2>
        <p class="kern-subline"><%= subline %></p>
      </div>

      <section class="kern-card__body">
        <% if deep_link.blank? %>
          <%= kern_alert(title: t("adm.whatsapp.missing_number"), style: :warning) %>
        <% else %>
          <dl class="adm-whatsapp-qr--details">
            <% if token.present? %>
              <div class="adm-whatsapp-qr--detail">
                <dt class="adm-whatsapp-qr--detail-key"><%= t("adm.whatsapp.token") %></dt>
                <dd class="adm-whatsapp-qr--detail-value">
                  <div class="adm-whatsapp-qr--field" data-controller="clipboard">
                    <span
                      class="adm-whatsapp-qr--field-text"
                      data-clipboard-target="source"
                    ><%= token %></span>

                    <button
                      type="button"
                      class="kern-btn kern-btn--tertiary adm-whatsapp-qr--copy"
                      data-action="clipboard#copy"
                    >
                      <span class="kern-label material-symbols-outlined" aria-hidden="true">content_copy</span>
                      <span class="kern-label kern-sr-only"><%= t("adm.whatsapp.copy_token") %></span>
                    </button>
                  </div>
                </dd>
              </div>
            <% end %>

            <div class="adm-whatsapp-qr--detail">
              <dt class="adm-whatsapp-qr--detail-key"><%= t("adm.whatsapp.number") %></dt>
              <dd class="adm-whatsapp-qr--detail-value">
                <div class="adm-whatsapp-qr--field" data-controller="clipboard">
                  <span
                    class="adm-whatsapp-qr--field-text adm-whatsapp-qr--field-text--numeric"
                    data-clipboard-target="source"
                  >+<%= business_number %></span>

                  <button
                    type="button"
                    class="kern-btn kern-btn--tertiary adm-whatsapp-qr--copy"
                    data-action="clipboard#copy"
                  >
                    <span class="kern-label material-symbols-outlined" aria-hidden="true">content_copy</span>
                    <span class="kern-label kern-sr-only"><%= t("adm.whatsapp.copy_number") %></span>
                  </button>
                </div>
              </dd>
            </div>

            <div class="adm-whatsapp-qr--detail">
              <dt class="adm-whatsapp-qr--detail-key"><%= t("adm.whatsapp.link") %></dt>
              <dd class="adm-whatsapp-qr--detail-value">
                <div class="adm-whatsapp-qr--field" data-controller="clipboard">
                  <a
                    class="kern-link adm-whatsapp-qr--field-text adm-whatsapp-qr--link"
                    href="<%= deep_link %>"
                    target="_blank"
                    rel="noopener"
                    data-clipboard-target="source"
                  ><%= deep_link %></a>

                  <button
                    type="button"
                    class="kern-btn kern-btn--tertiary adm-whatsapp-qr--copy"
                    data-action="clipboard#copy"
                  >
                    <span class="kern-label material-symbols-outlined" aria-hidden="true">content_copy</span>
                    <span class="kern-label kern-sr-only"><%= t("adm.whatsapp.copy_link") %></span>
                  </button>
                </div>

                <p class="adm-whatsapp-qr--detail-hint"><%= t("adm.whatsapp.link_hint") %></p>
              </dd>
            </div>
          </dl>
        <% end %>
      </section>
    </div>

    <% if deep_link.present? %>
      <div
        class="adm-whatsapp-qr--code"
        data-controller="adm--whatsapp-qr-download"
        data-adm--whatsapp-qr-download-basename-value="<%= download_basename %>"
      >
        <div
          class="adm-whatsapp-qr--code-frame"
          data-adm--whatsapp-qr-download-target="code"
        ><%= raw qr_svg %></div>

        <div class="adm-whatsapp-qr--actions">
          <%# PDF poster download disabled for now — restore together with the
              qr_poster route and controller action. %>
          <%#= helpers.kern_link_button(
            poster_path,
            text: t("adm.whatsapp.download_pdf"),
            icon: "picture_as_pdf",
            style: :secondary,
            class: "adm-whatsapp-qr--action",
            data: { turbo: false }
          ) %>

          <%= kern_button(
            text: t("adm.whatsapp.download_jpeg"),
            icon: "image",
            style: :secondary,
            type: "button",
            class: "adm-whatsapp-qr--action",
            data: { action: "adm--whatsapp-qr-download#downloadJpeg" }
          ) %>
        </div>

        <p class="adm-whatsapp-qr--code-hint"><%= t("adm.whatsapp.qr_hint") %></p>
      </div>
    <% end %>
  </div>
</article>
