<div
  data-field-name="<%= @field_name %>"
  data-allow-br-tags="<%= @allow_br_tags %>"
  class="js-projekt-banner--edit-field-container js-projekt-banner-edit-field-container projekt-banner-edit-field-container"
  >
  <div class="projekt-banner-edit-field--overlay">
  </div>

  <div class="js-projekt-banner--edit-field-content js-projekt-banner-edit-field-content projekt-banner-edit-field-content">
    <%= content %>
  </div>

  <div class="projekt-banner-edit-field--controlls">
    <button class="projekt-banner-edit-field-button button -transparent-round-icon-button-black js-projekt-banner-text-edit-button js-projekt-banner-edit-field-text-edit-button"> <i class="fas fa-pencil-alt"></i>
    </button>
    <div class="projekt-banner-edit-field--text-edit-controlls">
      <button class="projekt-banner-edit-field-controlls-button button -transparent-round-icon-button-black js-projekt-banner--text-edit-cancel js-projekt-banner-edit-field--text-edit-cancel">
        <i class="fas fa-xmark"></i>
      </button>
      <button class="projekt-banner-edit-field-controlls-button button -transparent-round-icon-button-black js-projekt-banner--text-edit-save js-projekt-banner-edit-field-text-edit-save">
        <i class="fas fa-check"></i>
      </button>
    </div>
  </div>
</div>
