<div class="ai-proposal-flow--criteria-grid">
  <% criteria.each do |criterion| %>
    <div class="ai-proposal-flow--criteria-card">
      <i class="fas fa-check ai-proposal-flow--criteria-card--icon"></i>
      <div class="ai-proposal-flow--criteria-card--body">
        <span class="ai-proposal-flow--criteria-card--title"><%= criterion.name %></span>
        <% if criterion.description.present? %>
          <span class="ai-proposal-flow--criteria-card--description"><%= criterion.description %></span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
