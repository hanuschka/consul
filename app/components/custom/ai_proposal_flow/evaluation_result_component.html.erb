<div class="ai-proposal-flow--evaluation">
  <% if hard_failed? %>
    <div class="ai-proposal-flow--hard-fail">
      <div class="ai-proposal-flow--hard-fail--badge">
        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
      </div>

      <div class="ai-proposal-flow--hard-fail--content">
        <span class="ai-proposal-flow--hard-fail--eyebrow">
          <%= t("ai_proposal_flow.evaluation.hard_failed_eyebrow") %>
        </span>
        <p class="ai-proposal-flow--hard-fail--lead">
          <%= t("ai_proposal_flow.evaluation.hard_failed_title") %>
        </p>

        <% if failed_criterion["name"].present? %>
          <div class="ai-proposal-flow--hard-fail--criterion">
            <span class="ai-proposal-flow--hard-fail--criterion-label">
              <i class="fas fa-shield-alt" aria-hidden="true"></i>
              <%= t("ai_proposal_flow.criteria.hard_badge") %>
            </span>
            <h3 class="ai-proposal-flow--hard-fail--criterion-name">
              <%= failed_criterion["name"] %>
            </h3>
            <% if failed_criterion["description"].present? %>
              <p class="ai-proposal-flow--hard-fail--criterion-description">
                <%= failed_criterion["description"] %>
              </p>
            <% end %>
          </div>
        <% end %>

        <div class="ai-proposal-flow--hard-fail--feedback">
          <span class="ai-proposal-flow--hard-fail--feedback-label">
            <i class="fas fa-lightbulb" aria-hidden="true"></i>
            <%= t("ai_proposal_flow.evaluation.feedback_label") %>
          </span>
          <p><%= failed_criterion["feedback"] %></p>
        </div>
      </div>
    </div>
  <% elsif error? %>
    <div class="ai-proposal-flow--evaluation-error">
      <div class="ai-proposal-flow--evaluation-error--badge">
        <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
      </div>
      <div class="ai-proposal-flow--evaluation-error--content">
        <strong><%= t("ai_proposal_flow.evaluation.error_title") %></strong>
        <p><%= t("ai_proposal_flow.evaluation.error_description") %></p>
      </div>
    </div>
  <% else %>
    <div class="ai-proposal-flow--evaluation-total">
      <span class="ai-proposal-flow--evaluation-total--label"><%= t("ai_proposal_flow.evaluation.total_score") %></span>
      <span class="ai-proposal-flow--evaluation-total--score"><%= total_score %></span>
    </div>

    <% soft_criteria.each do |criterion| %>
      <div class="ai-proposal-flow--evaluation-criterion">
        <div class="ai-proposal-flow--evaluation-criterion--header">
          <span class="ai-proposal-flow--evaluation-criterion--text">
            <i class="fas fa-star ai-proposal-flow--evaluation-criterion--icon" aria-hidden="true"></i>
            <%= criterion["name"].presence || criterion["text"] %>
          </span>
          <span class="ai-proposal-flow--evaluation-criterion--score">
            <%= criterion["score"] %> / <%= MAX_SCORE_PER_CRITERION %>
          </span>
        </div>
        <div class="ai-proposal-flow--evaluation-bar-track">
          <div
            class="ai-proposal-flow--evaluation-bar <%= bar_modifier(criterion["score"].to_i) %>"
            style="width: <%= (criterion["score"].to_f / MAX_SCORE_PER_CRITERION * 100).round %>%"
          ></div>
        </div>
        <p class="ai-proposal-flow--evaluation-criterion--feedback"><em><%= criterion["feedback"] %></em></p>
      </div>
    <% end %>

    <% if overall_feedback.present? %>
      <div class="ai-proposal-flow--overall-box -passed">
        <strong><i class="fas fa-check-circle" aria-hidden="true"></i> <%= t("ai_proposal_flow.evaluation.passed") %></strong>
        <p><%= overall_feedback %></p>
      </div>
    <% end %>
  <% end %>
</div>
