<a
  href="<%= projekt_page_url %>"
  class="ai-proposal-flow--project-banner"
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="ai-proposal-flow--project-banner--image">
    <% if projekt_image&.attached? %>
      <%= image_tag projekt_image.variant(:card_thumb), alt: projekt.page.title %>
    <% else %>
      <span
        class="ai-proposal-flow--project-banner--placeholder"
        role="img"
        aria-label="<%= t('custom.accessibility.shared.missing-image.aria-label') %>"
      >
        <i class="fa fa-comments" aria-hidden="true"></i>
      </span>
    <% end %>
  </div>
  <div class="ai-proposal-flow--project-banner--content">
    <strong class="ai-proposal-flow--project-banner--name"><%= projekt.page.title %></strong>
    <p class="ai-proposal-flow--project-banner--description"><%= description_snippet %></p>
  </div>
  <i class="fas fa-chevron-right ai-proposal-flow--project-banner--arrow"></i>
</a>
