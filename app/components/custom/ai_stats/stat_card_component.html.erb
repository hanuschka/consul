<div class="ai-stats-card">
  <div class="ai-stats-card--title u-flex u-justify-between u-align-center">
    <h4><%= title %></h4>

    <% if tooltip.present? %>
      <rich-tooltip delay="100" trigger-only shadow="heavy">
        <i class="fas fa-info-circle" tabindex="0"></i>
        <template><%= tooltip %></template>
      </rich-tooltip>
    <% end %>
  </div>
  <%= content %>
</div>
