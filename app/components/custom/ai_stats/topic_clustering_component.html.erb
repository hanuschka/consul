<div class="ai-stats-section ai-topic-clustering">
  <h3 class="ai-stats-section--title">
    <%= t("custom.ai_stats.topic_clustering.title") %>
  </h3>

  <p class="ai-topic-clustering--description">
    <%= total_proposals_count %> <%= t("custom.ai_stats.topic_clustering.proposals") %>
    <%= t("custom.ai_stats.topic_clustering.in") %>
    <%= total_topics_count %> <%= t("custom.ai_stats.topic_clustering.topic_groups") %>
  </p>

  <div class="ai-topic-clustering--list">
    <% topics.each_with_index do |topic, topic_index| %>
      <div class="ai-topic-clustering--topic-card" style="--topic-color: <%= topic_color(topic_index) %>">
        <div class="ai-topic-clustering--topic-header">
          <h4 class="ai-stats-section--subtitle"><%= topic["name"] %></h4>
          <p class="ai-topic-clustering--topic-stats">
            <%= subtopic_count(topic) %> <%= t("custom.ai_stats.topic_clustering.subtopics") %>,
            <%= proposal_count(topic) %> <%= t("custom.ai_stats.topic_clustering.proposals") %>
          </p>
        </div>

        <div class="ai-topic-clustering--subtopics-list">
          <% topic["subtopics"]&.each do |subtopic| %>
            <div class="ai-topic-clustering--subtopic-item js-collapse">
              <div class="ai-topic-clustering--subtopic-header js-collapse-head">
                <span class="ai-topic-clustering--subtopic-name"><%= subtopic["name"] %></span>
                <span class="ai-topic-clustering--subtopic-count"><%= subtopic_proposal_count(subtopic) %></span>
              </div>

              <div class="ai-topic-clustering--subtopic-body js-collapse-body">
                <ul class="ai-topic-clustering--proposals-list">
                  <% proposals_for_subtopic(subtopic).each do |proposal| %>
                    <li>
                      <%= link_to proposal_path(proposal), target: "_blank", class: "ai-topic-clustering--proposal-link" do %>
                        <% if proposal_has_image?(proposal) %>
                          <%= image_tag proposal_image_url(proposal), class: "ai-topic-clustering--proposal-image" %>
                        <% else %>
                          <div class="ai-topic-clustering--proposal-image-placeholder">
                            <i class="fa fa-lightbulb" aria-hidden="true"></i>
                          </div>
                        <% end %>
                        <span class="ai-topic-clustering--proposal-title"><%= proposal.title %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
