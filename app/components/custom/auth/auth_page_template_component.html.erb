<main class="padding-on-mobile">
  <div class="auth-page-template flex-layout">
    <% legend_is_default = SiteCustomization::ContentBlock.find_by(name: "custom", key: "auth_page_legend.#{controller_name}", locale: I18n.locale)&.body.blank? %>
    <div class="auth-page-template--legend">
      <% if legend_is_default %>
        <div class="auth-page-template--legend-head">
          <div class="auth-page-template--legend-title">
            <%= Setting["org_name"] %>
          </div>
        </div>
      <% end %>

      <div class="auth-page-template--legend-text<%= " auth-page-template--legend-text--default" if legend_is_default %>">
        <%= helpers.render_custom_block("auth_page_legend.#{controller_name}", default_content: t("custom.users.shared.auth_page.legend")) %>
      </div>
    </div>
    <div class="auth-page-template--form-section">
      <div class="auth-page-template--form-card new-card">
        <div class="auth-page-template--form-wrapper">

          <div class="auth-page-template--body">
            <%= form %>
          </div>
        </div>
      </div>
      <div class="auth-page-template--after-card-container">
        <%= after_card_container %>
      </div>
    </div>
  </div>
</main>
