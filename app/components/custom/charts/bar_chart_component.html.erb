<div class="ai-stats-card">
  <h3 class="ai-stats-card--title"><%= @title %></h3>
  <div class="bar-chart-container"
       data-bar-chart
       data-chart-labels="<%= labels_json %>"
       data-chart-values="<%= values_json %>"
       data-chart-orientation="<%= @orientation %>"
       <% if colors_json %>data-chart-colors="<%= colors_json %>"<% end %>
       <% if use_percentage? %>data-chart-use-percentage="true"<% end %>
       <% if show_labels_in_bars? %>data-chart-show-labels-in-bars="true"<% end %>
       <% if show_legend? %>data-chart-show-legend="true"<% end %>>
    <div class="chart-loading-placeholder">
      <%= render Shared::SkeletonPlaceholderComponent.new %>
    </div>
    <canvas></canvas>
  </div>
</div>
