<%= render Resources::List::BaseComponent.new(
  title: @content_card.title || t("custom.content_cards.current_polls.title"),
  empty_text: t("custom.polls.index.empty_list_text")
) do |c| %>
  <% c.with_toolbar %>

  <% if current_polls.present? %>
    <% c.with_items do %>
      <% current_polls.each do |poll| %>
        <%= render Polls::ListItemComponent.new(poll: poll) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
