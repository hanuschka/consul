<%= render Resources::List::BaseComponent.new(
  title: @content_card.title || t("custom.content_cards.latest_resources.title"),
  empty_text: t("empty_list_text")
) do |c| %>
  <% c.with_toolbar %>

  <% if latest_resources.present? %>
    <% c.with_items do %>
      <% latest_resources.each do |resource| %>
        <%= render helpers.resources_list_item_component(resource) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
