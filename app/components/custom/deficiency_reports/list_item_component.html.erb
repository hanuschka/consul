<%= render(Resources::ListItemComponent.new(**component_attributes)) do |c| %>
  <% c.with_header do %>
    <div>
    </div>

    <div>
      <%= l(deficiency_report.created_at, format: :new_date_with_year) %>
    </div>
  <% end %>

  <% c.with_footer_section do %>
    <% status = deficiency_report.status %>
    <% if status&.description.present? %>
      <rich-tooltip placement="top" shadow="heavy" class="deficiency-report-footer-status-tooltip">
        <div class="deficiency-report-footer-status" style="color:<%= status.color %>;">
          <i class="fas fa-<%= status.icon %>"></i>
          <%= status.title %>
        </div>
        <template>
          <span class="rich-tooltip-content">
            <span class="rich-tooltip-content--title"><%= status.title %></span>
            <span class="rich-tooltip-content--text"><%= status.description %></span>
          </span>
        </template>
      </rich-tooltip>
    <% else %>
      <div class="deficiency-report-footer-status" style="color:<%= status&.color %>;">
        <i class="fas fa-<%= status&.icon %>"></i>
        <%= status&.title %>
      </div>
    <% end %>
  <% end %>

  <% if helpers.deficiency_reports_feature?("allow_voting") %>
    <% c.with_footer_section do %>
      <div id="<%= dom_id(deficiency_report) %>_votes">
        <%= render "deficiency_reports/votes", deficiency_report: deficiency_report %>
      </div>
    <% end %>
  <% end %>
<% end %>
