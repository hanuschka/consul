<%= render(Resources::ListItemComponent.new(**component_attributes)) do |c| %>
  <% c.with_author(resource: deficiency_report) %>

  <% c.with_subheading do %>
    <%= subline %>
  <% end %>

  <% c.with_image(image: deficiency_report.image, image_placeholder_icon_class: "fa-lightbulb", resource: deficiency_report) %>

  <% c.with_header do %>
    <div>
    </div>

    <div>
      <%= l(deficiency_report.created_at, format: :new_date_with_year) %>
    </div>
  <% end %>

  <% c.with_footer_section do %>
    <div class="deficiency-report-footer-status" style="color:<%= deficiency_report.status&.color %>;">
      <i class="fas fa-<%= deficiency_report.status&.icon %>"></i>
      <%= deficiency_report.status&.title %>
    </div>
  <% end %>

  <% if helpers.deficiency_reports_feature?("allow_voting") %>
    <% c.with_footer_section do %>
      <div id="<%= dom_id(deficiency_report) %>_votes">
        <%= render "deficiency_reports/votes", deficiency_report: deficiency_report %>
      </div>
    <% end %>
  <% end %>
<% end %>
