<% if Setting.new_design_enabled? %>

  <main class="user-resources-form <%= " -no-image" unless Setting["deficiency_reports.image_upload"].present? %>">
    <% if Setting["deficiency_reports.voice_assistant"].present? && Ai::Settings.ai_available? %>
      <%= render Dt::VoiceAssistantComponent.new(
        assistant_codename: "deficiency_report_voice_assistant",
        custom_data: {
          categories: categories_serialized
        }
      ) %>
    <% end %>

    <%= translatable_form_for(deficiency_report, html: { class: "deficiency-report-form" }) do |f| %>
      <%= back_link_to(deficiency_reports_path) %>

      <div class="flex-layout">
        <div class="main-column">
          <h1 class="user-resources-form--title">
            <%= Setting["deficiency_reports.new_form_title"].presence || t("custom.deficiency_reports.new.start_new") %>
          </h1>

          <div class="hide-on-mobile">
            <div class="user-resources-form--description">
              <%= render_custom_block "user_resource_form_deficiency_report", default_content: t("custom.deficiency_reports.form.page_description") %>
            </div>
          </div>

          <%= render "shared/errors", resource: deficiency_report %>
        </div>
      </div>

      <div class="flex-layout">
        <div class="main-column">
          <%= f.translatable_fields do |translations_form| %>
            <div class="user-resources-form--banner-editor -deficiency-report">
              <div class="user-resources-form--title-wrapper">
                <%= translations_form.text_area :title,
                  label: false,
                  class: "user-resources-form--banner-editor-title js-user-resource-form-title",
                  placeholder: Setting["deficiency_reports.new_form_title_placeholder"].presence || t("custom.deficiency_reports.form.title_placeholder"),
                  autocomplete: "off" %>
              </div>

              <% if Setting["deficiency_reports.image_upload"].present? %>
                <div class="banner-editor-image-attachment">
                  <% if f.object.image.blank? %>
                    <% f.object.build_image %>
                  <% end %>
                  <%= f.fields_for :image do |image_builder| %>
                    <%= render UserResources::ImageUploadComponent.new(image_builder, imageable: f.object) %>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%= translations_form.text_area :description,
              label: false,
              value: AdminWYSIWYGSanitizer.new.sanitize(deficiency_report.description),
              placeholder: t("custom.deficiency_reports.form.description_placeholder"),
              class: "html-area #{ck_editor_class(current_user)} js-user-resource-form-description" %>
          <% end %>

          <div class="new-card" id='map-container'>
            <div class="margin-bottom">
              <%= render partial: "custom/shared/user_resources_form/deficiency_report_category", locals: { f: f } %>
            </div>

            <% if Setting["deficiency_reports.show_map"].present? %>
              <div class="" style="display:flex;align-items:baseline;">
                <h2 class="rich-form-label" style="flex-grow:1;">
                  <i class="fas fa-map"></i>
                  <%= t("custom.user_resources.form.map_location_label") %>
                  <span class="small" style="margin-left:0.25rem;margin-right:0.25rem">|</span>
                  <span class="small"><%= t("custom.user_resources.form.map_location_instructions_mandatory") %></span>
                </h2>

                <% if districts.any? %>
                  <%= select_tag :deficiency_report_district, options_for_select(districts.all.map { |district|
                    [
                      district.name, district.id,
                      {
                        data: {
                          latitude: district.map_location.latitude,
                          longitude: district.map_location.longitude
                        }
                      }
                    ]
                  }),
                  { prompt: t("custom.deficiency_reports.form.district.placeholder"), label: false,
                    class: "js-update-map-center hide-on-big-tablet",
                    style: "width:unset;",
                    data: {
                      default_latitude: MapLocation.default.latitude,
                      default_longitude: MapLocation.default.longitude
                    }
                  } %>
                <% end %>
              </div>

              <%= render "map_locations/form_fields",
                form:            f,
                mappable:        deficiency_report,
                nesting_prefix: "deficiency_report" %>
            <% end %>
          </div>
        </div>

        <aside class="sidebar">
          <% if Setting["deficiency_reports.document_upload"].present? %>
            <%= render Shared::SidebarCardComponent.new(
                          title: t("custom.deficiency_reports.form.documents.title"),
                          icon_name: "file"
                       ) do |c| %>
               <%= render "documents/nested_documents", documentable: deficiency_report, f: f %>
            <% end %>
          <% end %>

          <% if Setting["deficiency_reports.external_video"].present? %>
            <%= render Shared::SidebarCardComponent.new(
                          title: t("custom.deficiency_reports.form.video.title"),
                          description: t("custom.deficiency_reports.form.video.description"),
                          icon_name: "video"
                       ) do |c| %>
                <%= f.text_field :video_url, label: false, placeholder: t("custom.deficiency_reports.form.video.placeholder"), class: "light-input" %>
            <% end %>
          <% end %>

          <% if translations_interface_enabled? %>
            <%= render Shared::SidebarCardComponent.new(
                          title: t("custom.deficiency_reports.form.languages.title"),
                          description: t("custom.deficiency_reports.form.languages.description"),
                          icon_name: "language"
                       ) do |c| %>
                <%= render "shared/globalize_locales", resource: deficiency_report %>
            <% end %>
          <% end %>

          <% if helpers.allowed_to_post_on_behalf_of?(current_user, deficiency_report) %>
            <%= render Shared::SidebarCardComponent.new(
                          title: t("custom.deficiency_reports.form.on_behalf_of.title"),
                          description: t("custom.deficiency_reports.form.on_behalf_of.description"),
                          icon_name: "user"
                       ) do |c| %>
                <%= f.text_field :on_behalf_of, label: false, placeholder: t("custom.deficiency_reports.form.on_behalf_of.placeholder"), class: "light-input" %>
                <%= f.text_field :on_behalf_of_company_name,
                      label: t("custom.on_behalf_of_account.company_name.label"),
                      placeholder: t("custom.on_behalf_of_account.company_name.placeholder"),
                      class: "light-input" %>
                <%= f.email_field :on_behalf_of_email,
                      label: t("custom.on_behalf_of_account.email.label"),
                      placeholder: t("custom.on_behalf_of_account.email.placeholder"),
                      class: "light-input" %>
                <p><%= t("custom.on_behalf_of_account.email.description") %></p>

                <% if intake_channel_field? %>
                  <%= f.select :deficiency_report_intake_channel_id,
                        intake_channels.map { |channel| [channel.name, channel.id] },
                        { label: t("custom.deficiency_reports.form.intake_channel.label"),
                          include_blank: t("custom.deficiency_reports.form.intake_channel.placeholder") },
                        class: "light-input" %>
                  <p><%= t("custom.deficiency_reports.form.intake_channel.description") %></p>
                <% end %>
            <% end %>
          <% end %>

          <%= f.invisible_captcha :subtitle %>
        </aside>
      </div>

    <div class="user-resources-form--submit-section">
      <% if deficiency_report.new_record? %>
        <h3 class="user-resources-form--submit-section--privacy-policy">
          Datenschutzbestimmungen & Allgemeine Nutzerbedingungen
        </h3>

        <div>
          <%= f.check_box :resource_terms,
            title: t("custom.terms.resource_terms.title"),
            label: t("custom.terms.resource_terms.label",
                     privacy_link: link_to(
                       t("custom.terms.privacy_link.text"), "/privacy",
                       title: t("shared.target_blank"),
                       target: "_blank"
                     ),
                     terms_link: link_to(
                       t("custom.terms.terms_link.text"),
                       "/conditions",
                       title: t("shared.target_blank"),
                       target: "_blank"
                     )
                    ) %>
        </div>
        <% end %>

        <%= f.submit(class: "button", value: t("custom.deficiency_reports.form.submit_button_new_design")) %>
      </div>
    <% end %>

    <% DeficiencyReport::Category.where.not(warning_text: "").each do |category| %>
      <div class="reveal" id="<%= dom_id(category, :warning_popup) %>" data-reveal>
        <p><%= auto_link_already_sanitized_html(wysiwyg(category.warning_text)) %></p>
        <button class="close-button" data-close aria-label="Close modal" type="button">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    <% end %>
  </main>

<% else %>
  <main class="deficiency-report-new">
    <%= back_link_to deficiency_reports_path %>
    <%= header do %>
      <% if feature?('help_page') %>
        <%= link_to help_path(anchor: "deficiency_reports"), title: t("shared.target_blank"), target: "_blank" do %>
          <%= t("custom.deficiency_reports.new.more_info") %>
        <% end %>
      <% end %>
    <% end %>

    <aside class="margin-bottom">
      <%= helpers.render_custom_block "deficiency_reports_creation_recommendations" %>
    </aside>

    <%= render DeficiencyReports::FormComponent.new(deficiency_report) %>
  </main>
<% end %>
