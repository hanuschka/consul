<div class="<%= root_class %> js-va-demo" data-state="idle">
  <rich-tooltip delay="800" body-class="-dark" class="voice-assistant-design-dock-tip">
    <button
      type="button"
      class="<%= root_class %>--dock js-va-demo-toggle"
      aria-label="<%= open_label %>"
    >
      <i class="fas fa-microphone <%= root_class %>--dock-icon"></i>
      <span class="<%= root_class %>--dock-name"><%= style_name %></span>
    </button>
    <template><%= open_label %></template>
  </rich-tooltip>

  <div class="<%= root_class %>--panel">
    <div class="<%= root_class %>--head">
      <span class="<%= root_class %>--title"><%= title %></span>
      <span class="<%= root_class %>--desc"><%= style_desc %></span>
      <rich-tooltip delay="800" body-class="-dark">
        <button
          type="button"
          class="<%= root_class %>--close js-va-demo-close"
          aria-label="<%= close_label %>"
        >
          <i class="fas fa-xmark"></i>
        </button>
        <template><%= close_label %></template>
      </rich-tooltip>
    </div>

    <div class="<%= root_class %>--stage">
      <rich-tooltip delay="300" body-class="-dark">
        <button
          type="button"
          class="<%= root_class %>--mic voice-assistant-design-mic js-va-demo-mic"
          aria-label="<%= mic_start_label %>"
        >
          <i class="fas fa-microphone"></i>
        </button>
        <template><%= mic_start_label %></template>
      </rich-tooltip>
      <div class="<%= root_class %>--viz" aria-hidden="true">
        <% 9.times do %><span class="<%= root_class %>--bar"></span><% end %>
      </div>
    </div>

    <div class="voice-assistant-design-wave">
      <span class="voice-assistant-design-wave-canvas js-va-demo-viz" aria-hidden="true"></span>
      <span class="voice-assistant-design-muted-overlay"><%= muted_label %></span>
    </div>

    <div class="<%= root_class %>--status">
      <span class="<%= root_class %>--status-live"><%= listening_label %></span>
    </div>
  </div>
</div>
