<div class="<%= root_class %> js-va-demo" data-state="idle">
  <button type="button" class="<%= root_class %>--dock js-va-demo-toggle" aria-label="<%= open_label %>">
    <span class="<%= root_class %>--dock-dot" aria-hidden="true"></span>
    <span class="<%= root_class %>--dock-name"><%= style_name %></span>
    <i class="fas fa-microphone <%= root_class %>--dock-icon"></i>
  </button>

  <div class="<%= root_class %>--panel">
    <div class="<%= root_class %>--head">
      <span class="<%= root_class %>--title"><%= title %></span>
      <button type="button" class="<%= root_class %>--close js-va-demo-close" aria-label="<%= close_label %>">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="<%= root_class %>--stage">
      <button type="button" class="<%= root_class %>--mic js-va-demo-mic" aria-label="<%= mic_start_label %>">
        <i class="fas fa-microphone"></i>
      </button>
      <div class="<%= root_class %>--viz" aria-hidden="true">
        <span class="<%= root_class %>--line"></span>
      </div>
    </div>

    <div class="voice-assistant-design-wave js-va-demo-viz" aria-hidden="true"></div>

    <div class="<%= root_class %>--status">
      <span class="<%= root_class %>--status-ready"><%= ready_label %></span>
      <span class="<%= root_class %>--status-live"><%= listening_label %></span>
    </div>
  </div>
</div>
