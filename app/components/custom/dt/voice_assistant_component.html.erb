<div class="voice-assistant-iframe-wrapper">
  <iframe
    src="<%= assistant_iframe_path %>"
    frameborder="0"
    allow="microphone"
    class="voice-assistant-iframe js-voice-assistant-iframe js-iframe-dont-render-overlay-note <%= request.cookies['voice_assistant_collapsed'] == 'true' ? '-collapsed' : '' %>"
    data-initial-data="<%= assistant_initial_data %>"
  >
  </iframe>
</div>
