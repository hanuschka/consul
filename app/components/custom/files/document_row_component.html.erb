<tr
  class="kern-table__row files-asset-row"
  data-id="<%= document.id %>"
  data-type="document"
  data-only-title="true"
  data-update-url="<%= update_url %>"
  data-title="<%= document.title %>"
  data-filename="<%= filename %>"
>
  <th scope="row" class="kern-table__header files-asset-row--icon-cell">
    <i class="fa <%= icon_class %> files-asset-card--thumb-icon files-asset-row--icon"></i>
  </th>

  <td class="kern-table__cell files-asset-row--title-cell">
    <span title="<%= display_title %>"><%= display_title %></span>
  </td>

  <td class="kern-table__cell"><%= documentable_type_label %></td>

  <td class="kern-table__cell"><%= humanized_size %></td>

  <td class="kern-table__cell"><%= updated_at_formatted %></td>

  <td class="kern-table__cell files-asset-row--actions-cell">
    <% if document.attachment.attached? %>
      <a
        href="<%= attachment_url %>"
        target="_blank"
        rel="noopener"
        class="files-asset-row--action-button"
        title="<%= t("files.card.open_in_new_tab") %>"
        aria-label="<%= t("files.card.open_in_new_tab") %>"
      >
        <i class="fa fa-external-link-alt"></i>
      </a>

      <a
        href="<%= attachment_url %>"
        download="<%= filename %>"
        class="files-asset-row--action-button"
        title="<%= t("files.card.download") %>"
        aria-label="<%= t("files.card.download") %>"
      >
        <i class="fa fa-download"></i>
      </a>
    <% end %>

    <button
      type="button"
      class="files-asset-row--action-button js-files-edit-asset"
      data-action="click->files--filter-bar#editClicked"
      title="<%= t("files.card.edit") %>"
      aria-label="<%= t("files.card.edit") %>"
    >
      <i class="fa fa-pen"></i>
    </button>

    <button
      type="button"
      class="files-asset-row--action-button -danger js-files-delete-asset"
      data-action="click->files--filter-bar#deleteClicked"
      data-confirm-message="<%= t("files.card.delete_confirm") %>"
      data-delete-url="<%= update_url %>"
      title="<%= t("files.card.delete") %>"
      aria-label="<%= t("files.card.delete") %>"
    >
      <i class="fa fa-trash"></i>
    </button>
  </td>
</tr>
