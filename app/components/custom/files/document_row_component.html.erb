<li
  class="files-asset-row"
  data-id="<%= document.id %>"
  data-type="document"
  data-only-title="true"
  data-update-url="<%= update_url %>"
  data-title="<%= document.title %>"
  data-filename="<%= filename %>"
>
  <span class="files-asset-row--icon-wrapper">
    <i class="fa <%= icon_class %> files-asset-card--thumb-icon files-asset-row--icon"></i>
    <% if admin_upload? %>
      <span
        class="files-asset-row--admin-badge"
        title="<%= t("files.card.admin_badge") %>"
        aria-label="<%= t("files.card.admin_badge") %>"
      >
        <i class="fa fa-shield-alt"></i>
      </span>
    <% end %>
  </span>

  <div class="files-asset-row--name">
    <% if detail_url.present? %>
      <a
        href="<%= detail_url %>"
        class="files-asset-row--name-link"
        data-turbo-frame="files-asset-detail"
        data-action="click->files--asset-modal#open"
        title="<%= display_title %>"
      ><%= title_truncated? ? truncated_title : display_title %></a>
    <% elsif title_truncated? %>
      <button
        type="button"
        class="files-asset-row--title-trigger"
        popovertarget="<%= title_popover_id %>"
        title="<%= display_title %>"
      ><%= truncated_title %></button>

      <div
        id="<%= title_popover_id %>"
        class="files-asset-row--title-popover"
        popover
      ><%= display_title %></div>
    <% else %>
      <span title="<%= display_title %>"><%= display_title %></span>
    <% end %>
  </div>

  <div class="files-asset-row--meta">
    <div class="files-asset-row--field -type">
      <span class="files-asset-row--field-label"><%= t("files.list.resource_type") %></span>
      <span class="files-asset-row--field-value">
        <%= documentable_type_label.presence || "—" %>
      </span>
    </div>

    <div class="files-asset-row--field -assigned">
      <span class="files-asset-row--field-label"><%= owning_resource_label.presence || t("files.list.assigned_to") %></span>
      <span class="files-asset-row--field-value">
        <% if owning_resource_name.present? && owning_resource_url.present? %>
          <%= link_to owning_resource_name,
                owning_resource_url,
                target: "_blank",
                rel: "noopener",
                title: owning_resource_name,
                class: "files-asset-card--resource-link" %>
        <% elsif owning_resource_name.present? %>
          <%= owning_resource_name %>
        <% else %>
          —
        <% end %>
      </span>
    </div>

    <div class="files-asset-row--field -projekt">
      <span class="files-asset-row--field-label"><%= t("files.card.projekt") %></span>
      <span class="files-asset-row--field-value">
        <% if projekt_name.present? && projekt_url.present? %>
          <%= link_to projekt_name,
                projekt_url,
                target: "_blank",
                rel: "noopener",
                title: projekt_name,
                class: "files-asset-card--resource-link" %>
        <% elsif projekt_name.present? %>
          <%= projekt_name %>
        <% else %>
          —
        <% end %>
      </span>
    </div>

    <div class="files-asset-row--field -size">
      <span class="files-asset-row--field-label"><%= t("files.list.size") %></span>
      <span class="files-asset-row--field-value"><%= humanized_size.presence || "—" %></span>
    </div>

    <div class="files-asset-row--field -modified">
      <span class="files-asset-row--field-label"><%= t("files.list.modified") %></span>
      <span class="files-asset-row--field-value"><%= updated_at_formatted %></span>
    </div>

    <div class="files-asset-row--field -uploader">
      <span class="files-asset-row--field-label"><%= t("files.list.uploaded_by") %></span>
      <span class="files-asset-row--field-value">
        <%= render Files::UploaderLinkComponent.new(user: uploaded_by) %>
      </span>
    </div>
  </div>

  <div class="files-asset-row--actions">
    <% if document.attachment.attached? %>
      <a
        href="<%= attachment_url %>"
        target="_blank"
        rel="noopener"
        class="files-asset-row--action-button"
        title="<%= t("files.card.open_in_new_tab") %>"
        aria-label="<%= t("files.card.open_in_new_tab") %>"
      >
        <i class="fa fa-external-link-alt"></i>
      </a>

      <a
        href="<%= attachment_url %>"
        download="<%= filename %>"
        class="files-asset-row--action-button"
        title="<%= t("files.card.download") %>"
        aria-label="<%= t("files.card.download") %>"
      >
        <i class="fa fa-download"></i>
      </a>
    <% end %>

    <button
      type="button"
      class="files-asset-row--action-button js-files-edit-asset"
      data-action="click->files--filter-bar#editClicked"
      title="<%= t("files.card.edit") %>"
      aria-label="<%= t("files.card.edit") %>"
    >
      <i class="fa fa-pen"></i>
    </button>

    <button
      type="button"
      class="files-asset-row--action-button -danger js-files-delete-asset"
      data-action="click->files--filter-bar#deleteClicked"
      data-confirm-message="<%= t("files.card.delete_confirm") %>"
      data-delete-url="<%= update_url %>"
      title="<%= t("files.card.delete") %>"
      aria-label="<%= t("files.card.delete") %>"
    >
      <i class="fa fa-trash"></i>
    </button>
  </div>
</li>
