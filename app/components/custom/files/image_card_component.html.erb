<article
  class="files-asset-card"
  data-id="<%= image.id %>"
  data-type="image"
  data-only-title="true"
  data-update-url="<%= update_url %>"
  data-title="<%= image.title %>"
  data-filename="<%= filename %>"
>
  <div class="files-asset-card--thumb">
    <% if detail_url.present? %>
      <a
        href="<%= detail_url %>"
        class="files-asset-card--thumb-link"
        data-turbo-frame="files-asset-detail"
        data-action="click->files--asset-modal#open"
        aria-label="<%= t("files.show.view_details") %>"
      ></a>
    <% end %>

    <% if image.attachment.attached? %>
      <%= render Shared::ImageWithLightboxComponent.new(
        image_url: thumb_url,
        original_url: original_url,
        alt: display_title,
        gallery: "files-images"
      ) %>
    <% else %>
      <i class="fa fa-image files-asset-card--thumb-icon"></i>
    <% end %>

    <% if admin_upload? %>
      <div class="files-asset-card--badges">
        <rich-tooltip>
          <span
            class="files-asset-card--admin-badge"
            aria-label="<%= t("files.card.admin_badge") %>"
          >
            <i class="fa fa-shield-alt"></i>
          </span>
          <template><%= t("files.card.admin_badge") %></template>
        </rich-tooltip>
      </div>
    <% end %>

    <div class="files-asset-card--actions">
      <button
        type="button"
        class="files-asset-card--icon-button js-files-edit-asset"
        data-action="click->files--filter-bar#editClicked"
        title="<%= t("files.card.edit") %>"
        aria-label="<%= t("files.card.edit") %>"
      >
        <i class="fa fa-pen"></i>
      </button>

      <button
        type="button"
        class="files-asset-card--icon-button -danger js-files-delete-asset"
        data-action="click->files--filter-bar#deleteClicked"
        data-confirm-message="<%= t("files.card.delete_confirm") %>"
        data-delete-url="<%= update_url %>"
        title="<%= t("files.card.delete") %>"
        aria-label="<%= t("files.card.delete") %>"
      >
        <i class="fa fa-trash"></i>
      </button>
    </div>

    <% if attached? %>
      <a
        href="<%= original_url %>"
        download="<%= filename %>"
        class="files-asset-card--icon-button -bottom-right"
        title="<%= t("files.card.download") %>"
        aria-label="<%= t("files.card.download") %>"
      >
        <i class="fa fa-download"></i>
      </a>
    <% end %>
  </div>

  <div class="files-asset-card--meta">
    <p
      class="files-asset-card--filename"
      title="<%= display_title %>"
    >
      <%= display_title %>
    </p>

    <dl class="files-asset-card--details">
      <% if imageable_type_label.present? %>
        <div class="files-asset-card--detail-row">
          <dt><%= t("files.card.resource_type") %></dt>
          <dd><%= imageable_type_label %></dd>
        </div>
      <% end %>

      <% if owning_resource_name.present? %>
        <div class="files-asset-card--detail-row">
          <dt><%= owning_resource_label %></dt>
          <dd>
            <% if owning_resource_url.present? %>
              <%= link_to owning_resource_name, owning_resource_url, target: "_blank", rel: "noopener", class: "files-asset-card--resource-link" %>
            <% else %>
              <%= owning_resource_name %>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if projekt_name.present? %>
        <div class="files-asset-card--detail-row">
          <dt><%= t("files.card.projekt") %></dt>
          <dd>
            <% if projekt_url.present? %>
              <%= link_to projekt_name, projekt_url, target: "_blank", rel: "noopener", class: "files-asset-card--resource-link" %>
            <% else %>
              <%= projekt_name %>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if humanized_size.present? %>
        <div class="files-asset-card--detail-row">
          <dt><%= t("files.card.file_size") %></dt>
          <dd><%= humanized_size %></dd>
        </div>
      <% end %>

      <% if dimensions.present? %>
        <div class="files-asset-card--detail-row">
          <dt><%= t("files.card.dimensions") %></dt>
          <dd><%= dimensions %></dd>
        </div>
      <% end %>

      <div class="files-asset-card--detail-row">
        <dt><%= t("files.card.uploaded") %></dt>
        <dd><%= created_at_formatted %></dd>
      </div>

      <div class="files-asset-card--detail-row">
        <dt><%= t("files.card.last_edited") %></dt>
        <dd><%= updated_at_formatted %></dd>
      </div>

      <% if uploaded_by.present? %>
        <div class="files-asset-card--detail-row">
          <dt><%= t("files.card.uploaded_by") %></dt>
          <dd><%= render Files::UploaderLinkComponent.new(user: uploaded_by) %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</article>
