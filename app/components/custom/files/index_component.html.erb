<div
  class="files-index"
  data-controller="files--filter-bar"
  data-files--filter-bar-type-value="<%= type %>"
  data-files--filter-bar-endpoint-value="<%= endpoint %>"
>
  <div class="files-index--filter-bar" data-files--filter-bar-target="form">
    <%= render Files::FilterBarComponent.new(
      type: type,
      imageable_type_frame_src: imageable_type_frame_src,
      documentable_type_frame_src: documentable_type_frame_src
    ) %>
  </div>

  <% if supports_view_modes? %>
    <div class="files-index--view-controls">
      <button
        type="button"
        class="files-index--view-button -cards"
        data-action="click->files--filter-bar#viewModeCardsClicked"
        data-files--filter-bar-target="viewModeCardsButton"
        title="<%= t("files.view_mode.cards") %>"
        aria-label="<%= t("files.view_mode.cards") %>"
      >
        <i class="fa fa-th"></i>
      </button>
      <button
        type="button"
        class="files-index--view-button -list"
        data-action="click->files--filter-bar#viewModeListClicked"
        data-files--filter-bar-target="viewModeListButton"
        title="<%= t("files.view_mode.list") %>"
        aria-label="<%= t("files.view_mode.list") %>"
      >
        <i class="fa fa-list"></i>
      </button>
    </div>
  <% end %>

  <div class="files-index--grid" data-files--filter-bar-target="grid">
    <%= render(card_component.with_collection(assets, type: type)) %>
  </div>

  <% if supports_view_modes? %>
    <div class="kern-table-responsive files-index--list" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"></th>
            <th scope="col" class="kern-table__header"><%= t("files.list.title") %></th>
            <th scope="col" class="kern-table__header"><%= t("files.list.assigned_to") %></th>
            <th scope="col" class="kern-table__header"><%= t("files.list.size") %></th>
            <th scope="col" class="kern-table__header"><%= t("files.list.modified") %></th>
            <th scope="col" class="kern-table__header"></th>
          </tr>
        </thead>
        <tbody class="kern-table__body" data-files--filter-bar-target="list">
          <%= render(row_component.with_collection(assets)) %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div
    class="files-index--pagination"
    data-files--filter-bar-target="pagination"
  >
    <%= render partial: "ckeditor/assets/pagination", locals: { assets: assets } %>
  </div>

  <%= render Files::EditModalComponent.new %>
</div>
