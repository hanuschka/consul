<ul class="municipal-plan-badges no-bullet">
  <% badges.each do |badge| %>
    <li class="municipal-plan-badge <%= modifier_class(badge) %>">
      <i class="fas fa-<%= icon_class(badge) %>" aria-hidden="true"></i>
      <span class="municipal-plan-badge--label"><%= t("custom.municipal_plans.badges.#{badge}") %></span>
    </li>
  <% end %>
</ul>
