<rich-tooltip class="municipal-plan-participation-info" delay="100">
  <span class="municipal-plan-participation-info--trigger" role="img" aria-label="<%= label %>" tabindex="0">
    <i class="fas fa-info-circle" aria-hidden="true"></i>
  </span>
  <template>
    <span class="rich-tooltip-content">
      <span class="rich-tooltip-content--text"><%= text %></span>
    </span>
  </template>
</rich-tooltip>
