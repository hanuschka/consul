<%= render Shared::ModalComponent.new(
  id: "contentBlockTemplatesModal",
  modal_class: "modern-modal custom-content-block-templates-selector-wrapper js-content-block-templates-selector",
  closeable: false,
  content_wrapper: false,
  blur_backdrop: false,
  data: { saved_content_block_context: "newsletter" }
) do %>
  <div class="custom-content-block-templates-selector">
    <div class="content-block-templates-selector--header">
      <div class="modern-modal--header -compact-title">
        <h3><%= t('custom.newsletters.content_block_templates_selector.title') %></h3>
        <%= render Shared::AiFeatureTooltipComponent.new(
          feature_title: t('custom.projekt.content_block_templates_selector.ai_create_button.label'),
          feature_text: t('custom.projekt.content_block_templates_selector.ai_create_button.tooltip_description')
        ) do %>
          <button
            type="button"
            class="studio-edit-button -green content-block-templates-selector--ai-create js-open-create-content-block-with-ai"
          >
            <i class="fas fa-magic"></i>
            <%= t('custom.projekt.content_block_templates_selector.ai_create_button.label') %>
          </button>
        <% end %>
        <button
          class="close-button round-icon-button content-block-templates-selector--close js-shared-modal-close"
          aria-label="<%= t('application.close') %>"
          type="button"
        >
          <i class="fa fa-xmark"></i>
        </button>
      </div>
    </div>
    <div
      class="modern-modal--note content-block-templates-selector--fallback-note js-content-block-templates-fallback-note"
      style="display: none;"
    >
      <i class="fas fa-circle-exclamation"></i> <%= t('custom.projekt.content_block_templates_selector.fallback_note') %>
    </div>
    <div class="js-content-block-templates-spinner content-block-templates-selector--spinner">
      <%= render Shared::LoadingSpinnerComponent.new(
        message: t('custom.projekt.content_block_templates_selector.loading'),
        size: "large"
      ) %>
    </div>
    <div
      class="js-content-block-templates-selector--inner custom-content-block-templates-selector--inner"
      style="display: none;"
    >
    </div>
  </div>
<% end %>

<template class="js-content-block-templates-fallback">
  <ul id="contentBlockSelectorTabs" class="shared-tabs custom-content-block-templates-selector--tabs js-tabs">
    <li class="custom-content-block-templates-selector--tab shared-tabs--item is-active">
      <a class="shared-tabs--link js-tab" href="#contentBlockSelectorTab--emailDefaults" aria-selected="true">
        <%= t('custom.newsletters.content_block_templates_selector.tabs.email_defaults') %>
      </a>
    </li>
    <li class="shared-tabs--item custom-content-block-templates-selector--tab">
      <a class="shared-tabs--link js-tab" href="#contentBlockSelectorTab--globalContentBlocks">
        <%= t('custom.projekt.content_block_templates_selector.tabs.internal_content_blocks') %>
      </a>
    </li>
    <li class="shared-tabs--item custom-content-block-templates-selector--tab">
      <a class="shared-tabs--link js-tab" href="#contentBlockSelectorTab--userContentBlocks">
        <%= t('custom.projekt.content_block_templates_selector.tabs.own_content_blocks') %>
      </a>
    </li>
  </ul>
  <div class="shared-tabs-panels">
    <div id="contentBlockSelectorTab--emailDefaults" class="shared-tabs-panel is-active">
      <% email_template_names.each do |template_name| %>
        <%= render Projekts::ContentBlockTemplateItemComponent.new(
          template_name: template_name,
          template_dir: template_dir
        ) %>
      <% end %>
    </div>
    <div id="contentBlockSelectorTab--globalContentBlocks" class="shared-tabs-panel">
      <p class="saved-content-blocks-explanation"><%= t('custom.newsletters.content_block_templates_selector.saved_content_blocks.global_explanation') %></p>
      <div
        class="add-new-saved-content-block-section js-show-content-block-templates-section"
        data-editor-name="new-global-content-block-form"
        data-saved-content-block-type="global"
      >
        <div class="add-new-content-block-section--plus-button-wrapper">
          <button
            title="<%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.global_create_title') %>"
            type="button"
            class="js-toggle-saved-content-block-form add-new-content-block-template-button"
          >
            <i class="fas fa-plus"></i>
            <%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.global_add_button') %>
          </button>
        </div>
        <div class="js-saved-content-block-form saved-content-block-form">
          <h3><%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.global_form_heading') %></h3>
          <p><i><%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.html_code_hint') %></i></p>
          <textarea
            id="global-content-block-form--textarea"
            name="content"
            class="saved-content-block-form--textarea"
          ></textarea>
        </div>
        <div class="saved-content-block-form--controlls d-flex u-gap-10">
          <button type="button" class="studio-edit-button -green js-create-saved-content-block">
            <i class="fas fa-save"></i>
            <%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.save') %>
          </button>
          <button type="button" class="studio-edit-button js-cancel-create-saved-content-block">
            <i class="fas fa-xmark"></i>
            <%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.cancel') %>
          </button>
        </div>
      </div>

      <div class="saved-content-blocks-list js-saved-content-blocks-list">
        <% global_content_blocks.each do |saved_content_block| %>
          <%= render SavedContentBlocks::ItemComponent.new(saved_content_block: saved_content_block) %>
        <% end %>
      </div>
    </div>

    <div id="contentBlockSelectorTab--userContentBlocks" class="shared-tabs-panel">
      <p class="saved-content-blocks-explanation"><%= t('custom.newsletters.content_block_templates_selector.saved_content_blocks.user_explanation') %></p>
      <div
        class="add-new-saved-content-block-section js-show-content-block-templates-section"
        data-editor-name="new-user-content-block-form"
        data-saved-content-block-type="user"
      >
        <div class="add-new-content-block-section--plus-button-wrapper">
          <button
            title="<%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.user_create_title') %>"
            type="button"
            class="js-toggle-saved-content-block-form add-new-content-block-template-button"
          >
            <i class="fas fa-plus"></i>
            <%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.user_add_button') %>
          </button>
        </div>
        <div class="js-saved-content-block-form saved-content-block-form">
          <h3><%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.user_form_heading') %></h3>
          <p><i><%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.html_code_hint') %></i></p>
          <textarea
            id="user-content-block-form--textarea"
            name="content"
            class="saved-content-block-form--textarea"
          ></textarea>
        </div>
        <div class="saved-content-block-form--controlls d-flex u-gap-10">
          <button type="button" class="studio-edit-button -green js-create-saved-content-block">
            <i class="fas fa-save"></i>
            <%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.save') %>
          </button>
          <button type="button" class="studio-edit-button js-cancel-create-saved-content-block">
            <i class="fas fa-xmark"></i>
            <%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.cancel') %>
          </button>
        </div>
      </div>

      <div class="saved-content-blocks-list js-saved-content-blocks-list">
        <% user_content_blocks.each do |saved_content_block| %>
          <%= render SavedContentBlocks::ItemComponent.new(saved_content_block: saved_content_block) %>
        <% end %>
      </div>
    </div>
  </div>
</template>
