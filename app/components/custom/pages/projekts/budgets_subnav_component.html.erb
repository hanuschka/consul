<div class='budget-subnav'>
  <div class='budget-subnav--items'>
    <% budget_subnav_items_for(budget).each do |item| %>
      <% if item[:disabled] %>
        <span
          class="budget-subnav-item ai-feature-disabled <%= 'js-studio-hide-on-preview' if item[:hide_on_preview] %>"
          data-tooltip
          tabindex="-1"
          title="<%= t('ai.disabled_tooltip') %>"
        >
          <%= item[:text] %>
        </span>
      <% else %>
        <%= link_to item[:text], item[:url], class: "js-projekt-footer-subnav-item budget-subnav-item #{'is-active' if item[:active]} #{'js-studio-hide-on-preview' if item[:hide_on_preview]}", remote: true, onclick: '$(".spinner-placeholder").addClass("show-loader")', data: { section: item[:section] } %>
      <% end %>
    <% end %>
  </div>
</div>
