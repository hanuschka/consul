<div class='budget-subnav'>
  <div class='budget-subnav--items'>
    <% budget_subnav_items_for(budget).each do |item| %>
      <% if item[:disabled] %>
        <span
          class="budget-subnav-item ai-feature-disabled"
          data-tooltip
          tabindex="0"
          title="<%= t('ai.disabled_tooltip') %>"
        >
          <%= item[:text] %>
        </span>
      <% else %>
        <%= link_to item[:text], item[:url], class: "js-projekt-footer-subnav-item budget-subnav-item #{'is-active' if item[:active] }", remote: true, onclick: '$(".spinner-placeholder").addClass("show-loader")', data: { section: item[:section] } %>
      <% end %>
    <% end %>
  </div>
</div>
