<custom-tabs
  class="budget-subnav js-projekt-footer-tabs"
  default="<%= params[:section].presence || "overview" %>"
>
  <div class="budget-subnav--items">
    <% budget_subnav_items_for(budget).each do |item| %>
      <% if item[:disabled] %>
        <%= render Shared::AiFeatureTooltipComponent.new(feature_text: item[:text]) do %>
          <span
            class="budget-subnav-item -disabled <%= "js-studio-hide-on-preview" if item[:hide_on_preview] %>"
            tabindex="-1"
          >
            <%= item[:text] %>
          </span>
        <% end %>
      <% else %>
        <custom-tab
          for="<%= item[:section] %>"
          class="budget-subnav-item <%= "-active" if item[:active] %> <%= "js-studio-hide-on-preview" if item[:hide_on_preview] %>"
          data-url="<%= item[:url] %>"
        >
          <%= item[:text] %>
        </custom-tab>
      <% end %>
    <% end %>
  </div>
</custom-tabs>
