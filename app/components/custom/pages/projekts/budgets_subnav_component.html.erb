<custom-tabs
  class="projekt-phase-subnav js-projekt-footer-tabs"
  default="<%= params[:section].presence || "overview" %>"
>
  <div class="projekt-phase-subnav--items">
    <% budget_subnav_items_for(budget).each do |item| %>
      <% if item[:disabled] %>
        <%= render Shared::AiFeatureTooltipComponent.new(feature_text: item[:text]) do %>
          <span
            class="projekt-phase-subnav-item -disabled <%= "js-studio-hide-on-preview" if item[:hidden_from_public] %>"
            tabindex="-1"
          >
            <i class="fas <%= item[:icon] %>" aria-hidden="true"></i>
            <%= item[:text] %>
          </span>
        <% end %>
      <% else %>
        <custom-tab
          for="<%= item[:section] %>"
          class="projekt-phase-subnav-item <%= "-active" if item[:active] %> <%= "-hidden-from-public js-studio-hide-on-preview" if item[:hidden_from_public] %>"
          data-url="<%= item[:url] %>"
        >
          <i class="fas <%= item[:icon] %>" aria-hidden="true"></i>
          <%= item[:text] %>
        </custom-tab>
      <% end %>
    <% end %>
  </div>
</custom-tabs>
