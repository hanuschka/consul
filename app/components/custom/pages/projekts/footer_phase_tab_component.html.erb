<li
  id="filter-subnav-<%= phase.id %>"
  class="page-subnav-tab js-projekt-phase-tab projekt-footer-phase-tab  <%= additional_classes %>"
  data-projekt-phase-id="<%= phase.id %>"
  role="presentation"
>
  <%= link_to tab_url,
    role: "tab",
    aria: { selected: phase.id == params[:projekt_phase_id] },
    onclick: "$('#footer-content').addClass('show-loader');",
    class: "projekt-footer-phase-link js-remote-link-push-state",
    data: {
      remote: true,
      "footer-tab-back-url": page_path(@projekt.page.slug, projekt_phase_id: phase.id, anchor: "projekt-footer"),
    } do %>
    <h2 class='js-projekt-phase-title'>
      <%= tab_title %>
      <%= "(#{phase.resource_count})" if phase.resource_count.present? %>
    </h2>

    <div class='tab-info-summary'>
      <% if phase.is_a?(ProjektPhase::MilestonePhase) && phase.milestones.any?  %>
        <span><i class="far fa-calendar" style="margin-right: 7px;"></i><%= format_date(phase.milestones.last.publication_date.to_date) %></span>
      <% elsif phase.is_a?(ProjektPhase::ProjektNotificationPhase) && phase.projekt_notifications.any? %>
        <span><i class="far fa-calendar" style="margin-right: 7px;"></i><%= format_date(phase.projekt_notifications.last.updated_at.to_date) %></span>
      <% elsif phase.is_a?(ProjektPhase::EventPhase) && phase.projekt_events.sort_by_incoming.any? %>
        <span><i class="far fa-calendar" style="margin-right: 7px;"></i><%= format_date(phase.projekt_events.sort_by_incoming.first.datetime.to_date) %></span>
      <% elsif phase.is_a?(ProjektPhase::LivestreamPhase) && phase.projekt_livestreams.any? %>
        <span><i class="far fa-calendar" style="margin-right: 7px;"></i><%= format_date(phase.projekt_livestreams.order(starts_at: :desc).first.starts_at&.to_date) %></span>
      <% elsif phase.is_a?(ProjektPhase::BudgetPhase) && phase.budget.present? %>
        <span class="time-icon"><%= format_budget_phase_duration(phase.budget.current_phase) %></span>
      <% elsif phase.start_date.present? && phase.regular? %>
        <span class="time-icon"><%= format_date_range(phase.start_date, phase.end_date) %></span>
      <% else phase.regular? %>
        <span class="time-icon"><%= t("custom.shared.dates.no_dates") %></span>
      <% end %>

      <%= phase_user_status_restriction_name(phase) if phase.regular? %>

      <% if phase.regular? && phase.user_status != "guest" %>
        <%= phase_geo_restriction_name(phase) %>
        <%= phase_extended_geozone_restriction_name(phase) %>
        <%= phase_age_restriction_name(phase) %>
        <%= phase_individual_group_value_restriction_name(phase) %>
      <% end %>
    </div>
  <% end %>

  <% if phase.subscribable? && projekt_feature?(phase.projekt, "sidebar.show_notification_subscription_toggler") %>
    <div class="phase-subscription">
      <%= render "custom/projekts/partials/phase_subscription", phase: phase %>
    </div>
  <% end %>
  <% if helpers.show_admin_controls_for_projekt?(phase.projekt) %>
    <div class="projekt-phase--actions">
      <div class="projekt-phase--actions-first-block d-flex">
        <%
          hide_phase_title = "Versteckphase"
          show_phase_title = "Showphase"
        %>
        <%= studio_rich_tooltip(
          title: phase.active? ? hide_phase_title : show_phase_title,
          text: "Blendet diese Phase im öffentlichen Footer ein oder aus. Versteckte Phasen sind nur für Administratoren sichtbar.",
          delay: 1200
        ) do %>
          <button
            type="button"
            tabindex="-1"
            class="js-toggle-projekt-phase-visibility-button studio-icon-button"
            data-hide-title="<%= hide_phase_title %>"
            data-show-title="<%= show_phase_title %>"
          >
            <i class="fas <%= phase.active? ? 'fa-eye-slash' : 'fa-eye' %>"></i>
          </button>
        <% end %>
        <%
          make_default = "Standardphase festlegen"
          unset_default_title = "Standardphase aufheben"
        %>
        <%= studio_rich_tooltip(
          title: phase == @default_projekt_phase ? unset_default_title : make_default,
          text: "Legt fest, welche Phase beim Öffnen des Projekts standardmäßig angezeigt wird. Es kann nur eine Standardphase geben.",
          delay: 1200
        ) do %>
          <button
            type="button"
            tabindex="-1"
            class="js-toggle-projekt-phase-default studio-icon-button"
            data-unset-default-title="<%= unset_default_title %>"
            data-make-default-title="<%= make_default %>"
          >
            <i class="fas <%= phase == @default_projekt_phase ? 'fa-gem' : 'fa-thumbtack' %>"></i>
          </button>
        <% end %>
        <% if show_send_notification_button? %>
          <%= studio_rich_tooltip(
            title: "Benachrichtigung senden",
            text: "Versendet eine Benachrichtigung an die Abonnenten dieser Phase.",
            delay: 1200
          ) do %>
            <button
              type="button"
              tabindex="-1"
              class="js-send-notifications-for-projekt-phase studio-icon-button"
              data-resource-type="<%= resource_type %>"
              data-resource-id="<%= resource_id %>"
            >
              <i class="fas fa-envelope"></i>
            </button>
          <% end %>
        <% end %>
        <%= studio_rich_tooltip(
          title: "Phase bearbeiten",
          text: "Öffnet die Einstellungen dieser Phase in einem neuen Tab.",
          delay: 1200
        ) do %>
          <%= link_to adm_phase_action_path(phase), class: "studio-icon-button", target: "_blank", tabindex: "-1" do %>
            <i class="fas fa-edit"></i>
          <% end %>
        <% end %>

        <%= studio_rich_tooltip(
          title: "Phase löschen",
          text: !phase.safe_to_destroy? ? t('custom.admin.projekt_phases.notice.not_destroyed') : "Entfernt diese Phase dauerhaft. Diese Aktion kann nicht rückgängig gemacht werden.",
          delay: 1200
        ) do %>
          <button
            type="button"
            tabindex="-1"
            class="js-delete-projekt-phase studio-icon-button"
            <%= !phase.safe_to_destroy? ? "disabled" : "" %>
          >
            <i class="fas fa-trash-alt"></i>
          </button>
        <% end %>
      </div>
      <div class="projekt-phase-move js-projekt-phase-move js-sortable-handle studio-icon-button">
        <i class="fas fa-up-down-left-right">
        </i>
      </div>
    </div>
  <% end %>
</li>
