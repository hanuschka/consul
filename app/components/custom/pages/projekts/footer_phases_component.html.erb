<nav class="margin-bottom projekt-footer-navigation" aria-label="<%= t('custom.accessibility.navigation.projekt_phases') %>">
  <div class="row">
    <div class="small-12 column">
      <div style='display:flex;justify-content:end;align-items:end;'>
        <% if show_arrows? %>
          <div class='arrow-controls'>
            <button type="button" tabindex="-1" id='left-arrow-control' class='js-left-arrow-control disabled' aria-label="<%= t('custom.accessibility.phases.scroll_left') %>">
              <i class="fas fa-chevron-circle-left" aria-hidden="true"></i>
            </button>
            <button type="button" tabindex="-1" id='right-arrow-control' class='js-right-arrow-control' aria-label="<%= t('custom.accessibility.phases.scroll_right') %>">
              <i class="fas fa-chevron-circle-right" aria-hidden="true"></i>
            </button>
          </div>
        <% end %>
      </div>

      <div class='footer-phases-filter-subnav'>
        <% if helpers.show_admin_controls_for_projekt?(@projekt) %>
          <%= studio_rich_tooltip(
            title: "Phase hinzufügen",
            text: "Öffnet die Phasenverwaltung in einem neuen Tab, um diesem Projekt eine weitere Phase hinzuzufügen.",
            delay: 1200
          ) do %>
            <%= link_to(phases_adm_projekts_projekt_path(@projekt), class: "page-subnav-tab projekt-footer-phase-tab projekt-footer-phase-tab--add-new js-projekt-footer-phase-tab--add-new", target: "_blank", tabindex: "-1") do %>
              <i class="fas fa-plus"></i>
            <% end %>
          <% end %>
        <% end %>
        <ul id='filter-subnav' class='key-dates js-phases-list' role='tablist'>
          <% projekt_phases.each do |projekt_phase| %>
            <%= render Pages::Projekts::FooterPhaseTabComponent.new(projekt_phase, @default_projekt_phase, namespace: @namespace) %>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</nav>
