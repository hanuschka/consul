<%= render Shared::SidebarCardComponent.new(title: I18n.t("custom.projekt_phases.cta.title"), icon_name: "pen-fancy", opened_on_mobile: true) do |c| %>
  <% case @projekt_phase.sidebar_cta_kind %>
  <% when :poll %>
    <%= link_to @projekt_phase.sidebar_cta_label, poll_path(@projekt_phase.poll), class: "button -orange" %>
  <% when :new_button %>
    <%= render Shared::NewButtonComponent.new(projekt_phase: @projekt_phase) %>
  <% when :link, :budget_vote, :budget_ballot %>
    <a class="button -orange" href="#<%= @projekt_phase.sidebar_cta_anchor %>"><%= @projekt_phase.sidebar_cta_label %></a>
  <% end %>
<% end %>
