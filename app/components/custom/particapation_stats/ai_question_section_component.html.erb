<% if can_ask_questions? %>
  <div
    class="participation-stats-ai-question"
    data-processing-message="<%= t('custom.participation_stats.ai_question.processing_message') %>"
    data-in-progress-title="<%= t('custom.participation_stats.ai_question.in_progress') %>"
  >
    <%= render Shared::AccordionComponent.new(opened_by_default: false, root_class: "ai-stats-card") do |c| %>
      <% c.with_head do %>
        <span class="ai-stats-card--heading">
          <span class="ai-stats-card--title">
            <i class="fa fa-magic ai-stats-card--title-icon" aria-hidden="true"></i>
            <%= t("custom.participation_stats.ai_question.title") %>
          </span>
          <span class="ai-question-section--subtitle">
            <%= t("custom.participation_stats.ai_question.subtitle") %>
          </span>
        </span>
      <% end %>

      <% c.with_body do %>
        <div class="ai-question-section--form">
          <%= form_tag create_stat_question_projekt_phase_path(@projekt_phase),
                       method: :post,
                       class: "ai-question-form js-ai-question-form" do %>
            <%= text_area_tag :question,
                              nil,
                              placeholder: t("custom.participation_stats.ai_question.placeholder"),
                              class: "ai-question-form--input js-ai-question-input",
                              required: true,
                              disabled: ai_disabled? %>
            <div class="ai-question-form--actions">
              <%= render Shared::AiFeatureTooltipComponent.new(
                feature_title: t("custom.participation_stats.ai_question.title"),
                feature_text: t("custom.participation_stats.ai_question.subtitle")
              ) do %>
                <%= button_tag type: "submit",
                               class: "ai-question-form--submit js-ai-question-submit",
                               disabled: ai_disabled? do %>
                  <i class="fa fa-paper-plane" aria-hidden="true"></i>
                  <%= t("custom.participation_stats.ai_question.submit") %>
                <% end %>
              <% end %>
              <div class="ai-question-form--loading hidden js-ai-question-loading">
                <%= render Shared::SpinnerComponent.new(size: :small) %>
                <span><%= t("custom.participation_stats.ai_question.submitting") %></span>
              </div>
            </div>
          <% end %>
        </div>

        <div class="ai-question-section--pending<%= ' hidden' unless has_pending? %> js-ai-questions-pending">
          <h4><%= t("custom.participation_stats.ai_question.in_progress") %></h4>
          <div class="js-ai-questions-pending-list">
            <%= render partial: "custom/particapation_stats/pending_question_item",
                       collection: pending_questions,
                       locals: { projekt_phase: @projekt_phase } %>
          </div>
        </div>

        <div class="ai-question-section--history js-ai-questions-history<%= ' hidden' if completed_questions.empty? %>">
          <%= render partial: "custom/particapation_stats/completed_question_item",
                     collection: completed_questions,
                     as: :question,
                     locals: { projekt_phase: @projekt_phase } %>

          <% if completed_questions.any? %>
            <div class="ai-question-section--download-all">
              <a href="<%= download_all_stat_answers_projekt_phase_path(@projekt_phase, format: 'pdf') %>" class="ai-question-download-btn">
                <i class="fa fa-file-pdf" aria-hidden="true"></i>
                <%= t("custom.participation_stats.ai_question.download_all_pdf") %>
              </a>
              <a href="<%= download_all_stat_answers_projekt_phase_path(@projekt_phase, format: 'docx') %>" class="ai-question-download-btn">
                <i class="fa fa-file-word" aria-hidden="true"></i>
                <%= t("custom.participation_stats.ai_question.download_all_docx") %>
              </a>
              <a href="<%= download_all_stat_answers_projekt_phase_path(@projekt_phase, format: 'odt') %>" class="ai-question-download-btn">
                <i class="fa fa-file" aria-hidden="true"></i>
                <%= t("custom.participation_stats.ai_question.download_all_odt") %>
              </a>
              <a href="<%= download_all_stat_answers_projekt_phase_path(@projekt_phase, format: 'txt') %>" class="ai-question-download-btn">
                <i class="fa fa-file-alt" aria-hidden="true"></i>
                <%= t("custom.participation_stats.ai_question.download_all_txt") %>
              </a>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
