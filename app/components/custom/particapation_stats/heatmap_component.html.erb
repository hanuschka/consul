<div class="heatmap-stats">
  <div class="heatmap-stats--container">
    <h3 class="heatmap-stats--title"><%= t("custom.participation_stats.heatmap.title") %></h3>

    <div class="heatmap-card">
      <div class="heatmap-container"
           data-heatmap
           data-heatmap-coordinates="<%= coordinates_json %>"
           data-heatmap-center="<%= map_center.to_json %>"
           data-heatmap-zoom="<%= map_zoom %>">
      </div>
    </div>
  </div>
</div>

