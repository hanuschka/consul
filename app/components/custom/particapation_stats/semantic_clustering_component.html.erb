<%= render AiStats::CategoriesClusteringComponent.new(
  clustering_data: clustering_data,
  title_key: "custom.ai_stats.semantic_clustering",
  resource_class: resource_class
) do |c| %>
  <% if show_export_buttons? %>
    <% c.with_bottom_content do %>
      <div class="clustering-export-buttons u-flex u-gap-10 margin-top-20">
        <%= link_to download_semantic_clustering_projekt_phase_path(@projekt_phase, format: "csv"),
          class: "button hollow -compact -no-margin" do %>
          <i class="fa fa-file-csv"></i> <%= t("custom.ai_stats.clustering_export.download_csv") %>
        <% end %>
        <%= link_to download_semantic_clustering_projekt_phase_path(@projekt_phase, format: "pdf"),
          class: "button hollow -compact -no-margin" do %>
          <i class="fa fa-file-pdf"></i> <%= t("custom.ai_stats.clustering_export.download_pdf") %>
        <% end %>
        <%= link_to download_semantic_clustering_projekt_phase_path(@projekt_phase, format: "odt"),
          class: "button hollow -compact -no-margin" do %>
          <i class="fa fa-file-word"></i> <%= t("custom.ai_stats.clustering_export.download_odt") %>
        <% end %>
        <%= link_to download_semantic_clustering_projekt_phase_path(@projekt_phase, format: "docx"),
          class: "button hollow -compact -no-margin" do %>
          <i class="fa fa-file-word"></i> <%= t("custom.ai_stats.clustering_export.download_docx") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
