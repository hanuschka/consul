<div class="participation-stats-summary">
  <section class="ai-stats-card participation-stats-summary--main">
    <h3 class="ai-stats-card--title"><%= t("custom.participation_stats.ai_summary_title") %></h3>
    <div class="participation-stats-summary--content">
      <% if ai_summary.present? %>
        <%= ai_summary %>
      <% else %>
        <%= t("custom.participation_stats.no_resources_to_analyze") %>
      <% end %>
    </div>
  </section>

  <section class="ai-stats-card participation-stats-summary--tone">
    <h3 class="ai-stats-card--title participation-stats-summary--tone-title"><%= t("custom.participation_stats.tone_of_participation") %></h3>
    <div class="participation-stats-summary--tone-value">
      <% if tone_of_participation.present? %>
        <%= tone_of_participation %>
      <% else %>
        <%= t("custom.participation_stats.no_resources_to_analyze") %>
      <% end %>
    </div>
  </section>

  <% if tone_of_comments.present? %>
    <section class="ai-stats-card participation-stats-summary--tone">
      <h3 class="ai-stats-card--title participation-stats-summary--tone-title"><%= t("custom.participation_stats.tone_of_comments") %></h3>
      <div class="participation-stats-summary--tone-value">
        <%= tone_of_comments %>
      </div>
    </section>
  <% end %>
</div>
