  <% if geozone? %>
    <% geozone_data = geozone_chart_data %>
    <% if geozone_data[:labels].any? %>
      <%= render Charts::BarChartComponent.new(
        title: t("custom.shared.user_segments.area"),
        labels: geozone_data[:labels],
        values: geozone_data[:values],
        orientation: "horizontal",
        use_percentage: true
      ) %>
    <% end %>
  <% end %>

  <% if individual_group? %>
    <% individual_groups_data.each do |group_data| %>
      <% if group_data[:labels].any? %>
        <%= render Charts::BarChartComponent.new(
          title: group_data[:name],
          labels: group_data[:labels],
          values: group_data[:values],
          orientation: "horizontal",
          use_percentage: true
        ) %>
      <% end %>
    <% end %>
  <% end %>
