<% open_asnwer_form = capture do %>
  <%= form_for open_answer,
        url: update_open_answer_path(question),
        method: :post,
        remote: true,
        html: {
          class: "poll-open-answer-form js-poll-open-answer-autosave #{additional_form_class}",
          data: {
            next_question_id: question.open_question_answer.next_question_id,
            saving_text: t("custom.polls.questions.answers.open_answer_saving"),
            saved_text: t("custom.polls.questions.answers.open_answer_saved"),
            error_text: t("custom.polls.questions.answers.open_answer_save_failed")
          }
        } do |f| %>
    <%= f.text_area :open_answer_text, disabled: !can_answer?, label: open_answer.answer, placeholder: open_answer.answer %>
    <%= f.hidden_field :answer %>
    <div class="poll-open-answer-status js-poll-open-answer-status" aria-live="polite"></div>
  <% end %>
<% end %>

<% if Setting.new_design_enabled? %>
  <%= open_asnwer_form %>
<% else %>
  <div class="column small-12 margin-top">
    <%= open_asnwer_form %>
  </div>
<% end %>
