<div class="sub-nav-items">
  <%= link_to t("custom.polls.show.info_menu"), poll_path(id: poll.id),
                class: ("is-active" if info_menu?) %>

  <% if can?(:stats, poll) %>
    <%= link_to t("custom.polls.show.stats_menu"), stats_poll_path(id: poll.id),
                class: "#{'is-active' if stats_menu?} #{'js-studio-hide-on-preview' if !poll.projekt_phase.feature?('resource.stats_enabled')}" %>
  <% end %>

  <% if can?(:results, poll) %>
    <%= link_to t("custom.polls.show.results_menu"), results_poll_path(id: poll.id),
                class: "#{'is-active' if results_menu?} #{'js-studio-hide-on-preview' if !poll.projekt_phase.feature?('resource.results_enabled')}",
                data: { turbolinks: false } %>
  <% end %>

  <% if poll.report_visible_for_citizens? || can?(:edit, poll.projekt) || current_user&.administrator? %>
    <% if Ai::Settings.ai_available? %>
      <%= link_to t("custom.polls.show.report_menu"), report_poll_path(id: poll.id),
                  class: "#{'is-active' if report_menu?} #{'js-studio-hide-on-preview' if !poll.report_visible_for_citizens?}" %>
    <% else %>
      <%= render Shared::AiFeatureTooltipComponent.new(feature_text: t("custom.polls.show.report_menu")) do %>
        <span
          class="<%= 'js-studio-hide-on-preview' if !poll.report_visible_for_citizens? %>"
          tabindex="0"
        >
          <%= t("custom.polls.show.report_menu") %>
        </span>
      <% end %>
    <% end %>
  <% end %>

  <% if can?(:edit, poll.projekt) || current_user&.administrator? %>
    <% if Ai::Settings.ai_available? %>
      <%= link_to t("custom.polls.show.evaluation_menu"), evaluation_poll_path(id: poll.id),
                  class: "#{'is-active' if evaluation_menu?} js-studio-hide-on-preview" %>
    <% else %>
      <%= render Shared::AiFeatureTooltipComponent.new(feature_text: t("custom.polls.show.evaluation_menu")) do %>
        <span class="js-studio-hide-on-preview" tabindex="0">
          <%= t("custom.polls.show.evaluation_menu") %>
        </span>
      <% end %>
    <% end %>
  <% end %>
</div>
