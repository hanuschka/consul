<nav class="chip-nav sub-nav-items js-poll-subnav">
  <%= link_to t("custom.polls.show.info_menu"), poll_path(id: poll.id),
                class: "chip-nav--chip #{'is-active' if info_menu?}" %>

  <% if can?(:stats, poll) %>
    <% stats_chip = link_to t("custom.polls.show.stats_menu"), stats_poll_path(id: poll.id),
                class: "chip-nav--chip #{'is-active' if stats_menu?} #{'-hidden-from-public js-studio-hide-on-preview' if stats_hidden_from_public?}",
                data: { visibility_group: "poll_stats" } %>
    <%= hidden_from_public_tooltip(chip_tooltip_hidden_state(stats_hidden_from_public?), stats_chip) %>
  <% end %>

  <% if can?(:results, poll) %>
    <% results_chip = link_to t("custom.polls.show.results_menu"), results_poll_path(id: poll.id),
                class: "chip-nav--chip #{'is-active' if results_menu?} #{'-hidden-from-public js-studio-hide-on-preview' if results_hidden_from_public?}",
                data: { turbolinks: false, visibility_group: "stats" } %>
    <%= hidden_from_public_tooltip(chip_tooltip_hidden_state(results_hidden_from_public?), results_chip) %>
  <% end %>

  <% if poll_ai_analysis_visible?(poll) %>
    <% if Ai::Settings.ai_available? %>
      <%= link_to t("custom.polls.show.ai_analysis_menu"), ai_analysis_poll_path(id: poll.id),
                  class: "chip-nav--chip #{'is-active' if ai_analysis_menu?} #{'js-studio-hide-on-preview' if !poll.projekt_phase.feature?('general.public_ai_stats')}" %>
    <% else %>
      <%= render Shared::AiFeatureTooltipComponent.new(feature_text: t("custom.polls.show.ai_analysis_menu")) do %>
        <span
          class="chip-nav--chip -disabled <%= 'js-studio-hide-on-preview' if !poll.projekt_phase.feature?('general.public_ai_stats') %>"
          tabindex="0"
        >
          <%= t("custom.polls.show.ai_analysis_menu") %>
        </span>
      <% end %>
    <% end %>
  <% end %>

</nav>
