<div class="projekt-phase-stats-header">
  <div class="projekt-phase-stats-header--content">
    <div class="projekt-phase-stats-header--text-section">
      <h1 class="projekt-phase-stats-header--phase-title">
        <%= phase_title %>
      </h1>

      <div class="projekt-phase-stats-header--projekt-info">
        <%= link_to projekt_url, class: "projekt-phase-stats-header--projekt-title" do %>
          <h3 class="projekt-phase-stats-header--projekt-title">
            <%= projekt_title %>
          </h3>
        <% end %>

        <% if phase_date_range.present? %>
          <div class="projekt-phase-stats-header--phase-dates">
            <i class="fa fa-calendar"></i>
            <%= phase_date_range %>
          </div>
        <% end %>
      </div>

      <% if projekt_subtitle.present? %>
        <div class="projekt-phase-stats-header--projekt-subtitle">
          <%= sanitize(projekt_subtitle, tags: ["br"]) %>
        </div>
      <% end %>
    </div>

    <% if has_image? %>
      <div class="projekt-phase-stats-header--image">
        <%= link_to projekt_url do %>
          <%= render(
            Shared::ResourceImageComponent.new(
              image_url: image_url,
              image_placeholder_icon_class: "fa-comments",
              resource: @custom_page
            )
          ) %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
