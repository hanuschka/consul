<div class='projekt-phase-subnav'>
  <div class='projekt-phase-subnav--items'>
    <% projekt_phase_subnav_items.each do |item| %>
      <% if item[:disabled] %>
        <span
          class="projekt-phase-subnav-item ai-feature-disabled"
          data-tooltip
          tabindex="0"
          title="<%= t('ai.disabled_tooltip') %>"
        >
          <%= item[:text] %>
        </span>
      <% else %>
        <%= link_to item[:text], item[:url], class: "js-projekt-footer-subnav-item projekt-phase-subnav-item #{"is-active" if item[:active]}", remote: true, onclick: '$(".spinner-placeholder").addClass("show-loader")' %>
      <% end %>
    <% end %>
  </div>
</div>
