<div class='projekt-phase-subnav'>
  <div class='projekt-phase-subnav--items'>
    <% projekt_phase_subnav_items.each do |item| %>
      <%= link_to item[:text], item[:url], class: "projekt-phase-subnav-item #{"is-active" if item[:active]}", remote: true, onclick: '$(".spinner-placeholder").addClass("show-loader")' %>
    <% end %>
  </div>

  <div class='projekt-phase-subnav--actions'>
    <%= link_to stats_projekt_phase_path(@projekt_phase), data: { turbolinks: false }, class: "button with-icon" do %>
      <i class="fas fa-chart-bar"></i>
      <%= t("custom.projekt_phases.subnav.full_stats") %>
    <% end %>
  </div>
</div>
