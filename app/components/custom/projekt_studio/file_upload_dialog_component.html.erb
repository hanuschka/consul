<input type="file" class="js-content-block-image-change-input content-block-image-change-input" accept="image/*">

<!-- File Management Dialog -->
<dialog
  class="file-upload-manager-dialog js-file-upload-manager-dialog"
  data-type="<%= type %>"
>
  <div class="file-upload-manager-dialog--overlay js-file-upload-manager-dialog-close"></div>
  <div class="file-upload-manager-dialog--content">
    <div class="file-upload-manager-dialog--header">
      <h3 class="file-upload-manager-dialog--title">
        <%= mode_config[:title_text] %>
      </h3>
      <button class="close-button round-icon-button js-file-upload-manager-dialog-close" data-close="" aria-label="Close Accessible Modal" type="button">
        <i class="fa fa-xmark">
        </i>
      </button>
    </div>

    <!-- Controls Bar -->
    <div class="file-upload-manager-dialog--toolbar">
      <div class="file-upload-manager-dialog--toolbar-left">
        <div class="file-upload-manager-dialog--search-wrapper js-fm-filter-bar">
          <%= render Shared::TextSearchFormComponent.new(
            i18n_namespace: "files.search_form",
            standalone: true,
            disable_reset_button_submit: true,
            input_extra_class: "js-fm-filter-search",
            input_id: "file_manager_search_text_#{type}"
          ) %>
        </div>
      </div>

      <div class="file-upload-manager-dialog--toolbar-right">
        <% if type == "picture" %>
          <button type="button" class="studio-edit-button js-file-upload-manager-fullsize" style="display: none;">
            <i class="fa fa-expand"></i>
            <%= t("files.fullsize_preview.button") %>
          </button>
        <% end %>
        <button type="button" class="studio-edit-button js-file-upload-manager-info" style="display: none;">
          <i class="fa fa-info-circle"></i>
          <%= t("files.info_modal.button") %>
        </button>
        <button type="button" class="studio-edit-button js-file-upload-manager-edit" style="display: none;">
          <i class="fa fa-pen"></i>
          Datei editieren
        </button>
        <button type="button" class="studio-edit-button js-file-upload-manager-upload">
          <i class="fa fa-upload"></i>
          <%= mode_config[:upload_text] %>
        </button>
      </div>
    </div>

    <!-- Main content area -->
    <div class="file-upload-manager-dialog--body js-file-upload-manager-dialog--body">
      <div class="file-upload-manager-dialog--grid-wrapper">
        <div class="file-upload-manager-dialog--grid js-file-upload-manager-grid">
        </div>
        <div class="file-upload-manager-dialog--loading-overlay js-file-upload-manager-loading-overlay" style="display: none;">
          <div class="loading-spinner-inline"></div>
          <%# <span>Wird geladen...</span> %>
        </div>
      </div>
      <div class="file-upload-manager-dialog--pagination js-file-upload-manager-pagination"></div>
    </div>

    <!-- Template for temporary uploading images -->
    <template class="js-file-upload-manager-uploading-template">
      <div class="file-upload-manager-dialog--item -uploading" data-id="">
        <div class="file-upload-manager-dialog--item-thumb">
          <div class="file-upload-manager-dialog--item-uploading">
            <div class="file-upload-manager-dialog--item-thumb-overlay-backdrop"></div>
            <div class="file-upload-manager-dialog--item-preview" style="background-image: url('');"></div>
            <div class="loading-spinner-inline"></div>
          </div>
         <img class="js-file-upload-manager-dialog_item-image" src="" alt="">
         <i class="fa fa-file file-upload-manager-dialog--item-icon js-file-upload-manager-dialog_item-icon" style="display: none;"></i>
         <span class="file-upload-manager-dialog--item-badge -dimensions js-file-manager-badge-dimensions" style="display: none;"></span>
         <span class="file-upload-manager-dialog--item-badge -size js-file-manager-badge-size" style="display: none;"></span>
        </div>
        <div class="file-upload-manager-dialog--item-meta">
          <p
            class="file-upload-manager-dialog--item-title"
            title=""
          ></p>
          <div class="file-upload-manager-dialog--item-alt">Wird hochgeladen...</div>
        </div>
      </div>
    </template>

    <div class="file-upload-manager-dialog--footer">
      <button type="button" class="studio-edit-button -green image-upload-gallery--select-image-btn js-file-upload-manager-select">
        <i class="fa fa-check"></i>
        Wählen
      </button>
    </div>

    <!-- Hidden file input for uploads -->
    <input type="file" class="js-file-upload-manager-file-input" style="display: none;">
  </div>

  <!-- Edit Modal -->
  <div class="file-upload-manager-edit-modal js-file-upload-manager-edit-modal">
    <div class="file-upload-manager-edit-modal__overlay js-file-upload-manager-edit-close"></div>
    <div class="file-upload-manager-edit-modal__content file-manager-modal-panel">
      <div class="file-upload-manager-edit-modal__header">
        <span>Einstellungen zum Bild</span>
        <button class="close-button round-icon-button js-file-upload-manager-edit-close" data-close="" aria-label="Close Accessible Modal" type="button">
          <i class="fa fa-xmark">
          </i>
        </button>
      </div>
      <div class="file-upload-manager-edit-modal__body">
        <div class="file-upload-manager-edit-modal__field">
          <label>Titel</label>
          <input type="text" class="js-file-upload-manager-edit-title" placeholder="Titel">
        </div>
      </div>
      <div class="file-upload-manager-edit-modal__footer">
        <button type="button" class="studio-edit-button -red js-file-upload-manager-delete">
          <i class="fa fa-trash"></i>
          Löschen
        </button>
        <button type="button" class="studio-edit-button -green js-file-upload-manager-update">
          <i class="fa fa-save"></i>
          Aktualisieren
        </button>
      </div>
    </div>
  </div>

  <!-- Info Modal -->
  <div class="file-upload-manager-info-modal js-file-upload-manager-info-modal">
    <div class="file-upload-manager-info-modal--overlay js-file-upload-manager-info-close"></div>
    <div class="file-manager-modal-panel -wide js-file-upload-manager-info-panel">
      <div class="file-upload-manager-edit-modal__header">
        <span class="js-file-manager-info-modal-title"></span>
        <button
          class="close-button round-icon-button js-file-upload-manager-info-close"
          data-close=""
          aria-label="<%= t("files.info_modal.close") %>"
          type="button"
        >
          <i class="fa fa-xmark"></i>
        </button>
      </div>
      <div class="file-upload-manager-info-modal--body">
        <div
          class="file-upload-manager-info-modal--preview js-file-manager-info-preview"
          style="display: none;"
        >
          <img class="js-file-manager-info-preview-image" src="" alt="">
        </div>
        <dl class="file-upload-manager-info-modal--details">
          <div class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-filename">
            <dt><%= t("files.info_modal.filename") %></dt>
            <dd class="js-file-manager-info-filename"></dd>
          </div>
          <div class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-type">
            <dt><%= t("files.info_modal.type") %></dt>
            <dd class="js-file-manager-info-content-type"></dd>
          </div>
          <div class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-size">
            <dt><%= t("files.info_modal.size") %></dt>
            <dd class="js-file-manager-info-size"></dd>
          </div>
          <div
            class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-dimensions"
            style="display: none;"
          >
            <dt><%= t("files.info_modal.dimensions") %></dt>
            <dd class="js-file-manager-info-dimensions"></dd>
          </div>
          <div class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-uploaded">
            <dt><%= t("files.info_modal.uploaded") %></dt>
            <dd class="js-file-manager-info-created-at"></dd>
          </div>
          <div class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-modified">
            <dt><%= t("files.info_modal.last_edited") %></dt>
            <dd class="js-file-manager-info-updated-at"></dd>
          </div>
          <div
            class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-user"
            style="display: none;"
          >
            <dt><%= t("files.info_modal.uploaded_by") %></dt>
            <dd class="js-file-manager-info-user"></dd>
          </div>
          <div
            class="file-upload-manager-info-modal--detail-row js-file-manager-info-row-projekt"
            style="display: none;"
          >
            <dt><%= t("files.info_modal.projekt") %></dt>
            <dd class="js-file-manager-info-projekt"></dd>
          </div>
        </dl>
      </div>
      <div class="file-upload-manager-info-modal--footer">
        <a
          class="studio-edit-button js-file-manager-info-download-link"
          href=""
          download
        >
          <i class="fa fa-download"></i>
          <%= t("files.info_modal.download_file") %>
        </a>
        <a
          class="studio-edit-button -green js-file-manager-info-open-link"
          href=""
          target="_blank"
          rel="noopener"
        >
          <i class="fa fa-external-link-alt"></i>
          <%= t("files.info_modal.open_file") %>
        </a>
      </div>
    </div>
  </div>

  <!-- Fullsize Image Preview -->
  <div class="file-upload-manager-fullsize-preview js-file-upload-manager-fullsize-preview">
    <div class="file-upload-manager-fullsize-preview--overlay js-file-upload-manager-fullsize-close"></div>
    <img
      class="file-upload-manager-fullsize-preview--image js-file-upload-manager-fullsize-image"
      src=""
      alt=""
    >
    <button
      class="close-button round-icon-button file-upload-manager-fullsize-preview--close js-file-upload-manager-fullsize-close"
      aria-label="<%= t("files.fullsize_preview.close") %>"
      type="button"
    >
      <i class="fa fa-xmark"></i>
    </button>
  </div>
</dialog>
