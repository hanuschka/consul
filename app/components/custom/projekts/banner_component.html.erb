<div class="<%= banner_wrapper_class %>">
  <div class="custom-page--banner">
    <div class="custom-page--banner-text-section-wrapper">
      <div class="custom-page--banner-text-section">
        <div class="custom-page--banner-title-wrapper">
          <% if show_embedded_controlls? %>
            <%= render Admin::FieldEditComponent.new(field_name: 'site_customization_page[title]') do %>
              <h1 class="custom-page--banner-title"><%= @custom_page.title %></h1>
            <% end %>
          <% else %>
            <h1 class="custom-page--banner-title">
              <% if @compact %>
                <%= link_to @custom_page.title, page_path(@custom_page.slug) %>
              <% else %>
                <%= @custom_page.title %>
              <% end %>
            </h1>
          <% end %>
        </div>

        <% if (@custom_page.subtitle.present? || show_embedded_controlls?) %>
          <% if show_embedded_controlls? %>
            <%= render Admin::FieldEditComponent.new(field_name: 'site_customization_page[subtitle]', allow_br_tags: true) do %>
              <div class="custom-page--banner-description"><%= sanitize((@custom_page.subtitle.presence || " "), tags: ["br"]) %> </div>
            <% end %>
          <% else %>
            <div class="custom-page--banner-description">
              <p style="font-size:inherit;"><%= sanitize(@custom_page.subtitle, tags: ["br"]) %> </p>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if @custom_page.projekt.present? %>
        <div class="custom-page--banner-breadcrumbs">
          <%= helpers.breadcrumbs_links(@custom_page.projekt) %>
        </div>
      <% end %>
    </div>

    <% if (@custom_page.image.present? || show_embedded_controlls?) %>
      <%#= image_tag(url_for(@custom_page.image.attachment), class: "custom-page--banner-image" )  %>

      <% if @custom_page.image.present? %>
        <% big_projekt_image_url =
          polymorphic_path(@custom_page.image.attachment.variant(
            resize_to_limit: [1750, 900],
            saver: { quality: 80 },
            strip: true,
            format: "jpeg"
          ))
        %>
      <% end %>

      <% banner_image = capture do %>
        <%= link_to big_projekt_image_url, target: "_blank", class: "glightbox", role: "button", aria_label: t("custom.accessibility.banner-image.glightbox-aria-label") do %>
          <span class="image-maximize-button">
            <i class="fas fa-magnifying-glass-plus"></i>
          </span>
          <%= render(
            Shared::ResourceImageComponent.new(
              image_url: @custom_page.image&.attachment&.variant(coalesce: true, gravity: "center", resize_to_fill: [930, 585]),
              image_placeholder_icon_class: "fa-comments",
              resource: @custom_page
            )
          ) %>
        <% end %>
      <% end %>

      <div class="custom-page--banner-image">
        <% if show_embedded_controlls? %>
          <div data-field-name="site_customization_page[image]" class="projekt-image-upload-wrapper js-projekt-image-uploader">
            <%= banner_image %>
            <img class="projekt-image-upload-preview js-projekt-image-upload-preview" src="" alt="">
            <label for="projektImageUploadInput" class="image-change-button projekt-image-upload-button">
              <i class="fas fa-pencil-alt"></i>
            </label>
            <input
              id="projektImageUploadInput"
              type="file"
              class="d-none js-projekt-banner--image-upload-input"
            >
            </input>
          </div>
        <% else %>
          <%= banner_image %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
