<div class="<%= banner_wrapper_class %>">
  <div class="custom-page--banner">
    <div class="custom-page--banner-text-section-wrapper">
      <div class="custom-page--banner-text-section">
        <div class="custom-page--banner-title-wrapper">
          <% if show_admin_controls? %>
            <%= render Admin::FieldEditComponent.new(record: @custom_page, attribute: :title, kind: :string) do %>
              <h1 class="custom-page--banner-title"><%= @custom_page.title %></h1>
            <% end %>
          <% else %>
            <h1 class="custom-page--banner-title">
              <% if @compact %>
                <%= link_to @custom_page.title, page_path(@custom_page.slug) %>
              <% else %>
                <%= @custom_page.title %>
              <% end %>
            </h1>
          <% end %>
        </div>

        <% if (@custom_page.subtitle.present? || show_admin_controls?) %>
          <% if show_admin_controls? %>
            <%= render Admin::FieldEditComponent.new(record: @custom_page, attribute: :subtitle, kind: :string, allow_br_tags: true) do %>
              <div class="custom-page--banner-description"><%= sanitize((@custom_page.subtitle.presence || " "), tags: ["br"]) %> </div>
            <% end %>
          <% else %>
            <div class="custom-page--banner-description">
              <p style="font-size:inherit;"><%= sanitize(@custom_page.subtitle, tags: ["br"]) %> </p>
            </div>
          <% end %>
        <% end %>

        <% if show_meta_chips? %>
          <div class="custom-page--banner-chips">
            <% if start_date_chip_text.present? %>
              <span class="custom-page--banner-chip">
                <i class="far fa-clock" aria-hidden="true"></i>
                <%= start_date_chip_text %>
              </span>
            <% end %>
            <% if end_date_chip_text.present? %>
              <span class="custom-page--banner-chip">
                <i class="far fa-clock" aria-hidden="true"></i>
                <%= end_date_chip_text %>
              </span>
            <% end %>
            <% phase_status_chips.each do |chip| %>
              <% if chip[:phase].present? %>
                <%= link_to projekt_phase_footer_tab_page_path(@projekt.page, chip[:phase]),
                  class: "custom-page--banner-chip #{chip[:modifier]} js-remote-link-push-state js-sidebar-phase-link",
                  onclick: "$('#footer-content').addClass('show-loader');",
                  title: t("custom.projekts.page.sidebar.banner.go_to_phase", title: chip[:text]),
                  aria: { label: t("custom.projekts.page.sidebar.banner.go_to_phase", title: chip[:text]) },
                  data: {
                    index: chip[:index],
                    remote: true,
                    "footer-tab-back-url": page_path(@projekt.page.slug, projekt_phase_id: chip[:phase].id, anchor: "projekt-footer")
                  } do %>
                  <i class="<%= chip[:icon_style] %> fa-<%= chip[:icon] %>" aria-hidden="true"></i>
                  <%= chip[:text] %>
                <% end %>
              <% else %>
                <span class="custom-page--banner-chip <%= chip[:modifier] %>">
                  <i class="<%= chip[:icon_style] %> fa-<%= chip[:icon] %>" aria-hidden="true"></i>
                  <%= chip[:text] %>
                </span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

    </div>

    <% if (@custom_page.image.present? || show_admin_controls?) %>
      <%#= image_tag(url_for(@custom_page.image.attachment), class: "custom-page--banner-image" )  %>

      <% if @custom_page.image.present? %>
        <% big_projekt_image_url =
          polymorphic_path(@custom_page.image.attachment.variant(
            resize_to_limit: [1750, 900],
            saver: { quality: 90 },
            strip: true,
            format: "jpeg"
          ))
        %>
      <% end %>

      <% banner_image = capture do %>
        <%= link_to big_projekt_image_url,
          target: "_blank",
          class: "glightbox",
          data: {
            gallery: "banner-#{@custom_page.id}",
            type: "image",
            alt: t("custom.accessibility.banner-image.glightbox-image-alt", resource_type: @custom_page.class.model_name.human, title: @custom_page.title)
          },
          role: "button",
          aria: { label: t("custom.accessibility.banner-image.glightbox-aria-label") } do %>
          <span class="image-maximize-button">
            <i class="fas fa-magnifying-glass-plus"></i>
          </span>
          <%= render(
            Shared::ResourceImageComponent.new(
              image_url: @custom_page.image&.attachment&.variant(
                resize_to_fill: [590, 355],
                saver: { quality: 95 },
                strip: true,
                format: "jpeg"
              ),
              image_placeholder_icon_class: "fa-comments",
              resource: @custom_page,
              placeholder_hint: show_admin_controls? ? t("custom.projekts.banner_upload.min_image_size_hint", width: 590, height: 355) : nil
            )
          ) %>
        <% end %>
      <% end %>

      <div class="custom-page--banner-image">
        <% if show_admin_controls? %>
          <div
            data-update-url="<%= update_image_adm_projekts_projekt_path(@projekt) %>"
            data-delete-url="<%= delete_image_adm_projekts_projekt_path(@projekt) %>"
            data-placeholder-icon-class="fa-comments"
            data-placeholder-aria-label="<%= t('custom.accessibility.shared.missing-image.aria-label') %>"
            data-delete-confirm="<%= t('custom.accessibility.banner-image.delete-confirm') %>"
            class="projekt-image-upload-wrapper js-projekt-image-uploader">
            <%= banner_image %>
            <img class="projekt-image-upload-preview js-projekt-image-upload-preview" src="" alt="" aria-hidden="true">
            <div
              class="projekt-banner-upload-progress js-projekt-banner-upload-progress"
              role="status"
              aria-live="polite"
              aria-label="<%= t('custom.accessibility.banner-image.upload-progress-label') %>"
              hidden
            >
              <div class="projekt-banner-upload-progress--backdrop"></div>
              <div class="loading-spinner-inline projekt-banner-upload-progress--spinner"></div>
              <div
                class="projekt-banner-upload-progress--message js-projekt-banner-upload-progress-message"
                data-uploading-text="<%= t('custom.projekts.banner_upload.uploading') %>"
                data-processing-text="<%= t('custom.projekts.banner_upload.processing') %>"
              >
                <%= t('custom.projekts.banner_upload.uploading') %>
              </div>
            </div>
            <label for="projektImageUploadInput" class="image-change-button projekt-image-upload-button js-studio-hide-on-preview">
              <i class="fas fa-pencil-alt"></i>
            </label>
            <input
              id="projektImageUploadInput"
              type="file"
              accept="image/*"
              class="d-none js-projekt-banner--image-upload-input"
            >
            </input>
            <button type="button"
                    class="image-change-button projekt-image-upload-button projekt-image-delete-button js-projekt-banner--image-delete-button js-studio-hide-on-preview <%= 'd-none' unless @custom_page.image.present? %>"
                    aria-label="<%= t('custom.accessibility.banner-image.delete-aria-label') %>">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        <% else %>
          <%= banner_image %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
