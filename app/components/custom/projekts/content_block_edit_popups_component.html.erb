<%= render Projekts::StudioEditPopupComponent.new(
  popup_classes: "js-content-block-link-popup content-block-link-popup",
  accept_button_class: "js-content-block-accept-link-edit",
  cancel_button_class: "js-content-block-cancel-link-edit"
) do |popup| %>
  <% popup.with_extra_actions do %>
    <button
      class="studio-edit-button -red -with-background js-content-block-delete-link"
      style="display: none;"
    >
      <i class="fas fa-trash"></i>
      <%= t('custom.projekts.page.content_block_link_popup.remove_link') %>
    </button>
  <% end %>

  <div>
    <label class="studio-edit-popup--label" style="display: none">
      <%= t('custom.projekts.page.content_block_link_popup.link_text') %>:
      <textarea type="text" class="js-content-block-text-input"></textarea>
    </label>
  </div>
  <div>
    <label class="studio-edit-popup--label">
      <%= t('custom.projekts.page.content_block_link_popup.link_url') %>:
      <textarea type="text" class="js-content-block-url-input"></textarea>
    </label>
  </div>
  <div class="content-block-link-popup-checkbox-row">
    <label class="content-block-link-popup-checkbox-label">
      <input type="checkbox" checked class="js-content-block-url-black-checkbox">
      <%= t('custom.projekts.page.content_block_link_popup.open_in_new_tab') %>
    </label>
    <button
      type="button"
      class="studio-edit-button -with-background content-block-link-popup-pick-file js-content-block-link-popup-pick-file"
    >
      <i class="fas fa-paperclip"></i>
      <%= t('custom.projekts.page.content_block_link_popup.attach_file') %>
    </button>
  </div>
<% end %>

<%= render Projekts::StudioEditPopupComponent.new(
  popup_classes: "js-content-block-image-alt-popup content-block-image-alt-popup -above-anchor",
  accept_button_class: "js-content-block-accept-image-alt-edit",
  cancel_button_class: "js-content-block-cancel-image-alt-edit"
) do %>
  <div class="content-block-image-alt-popup--intro">
    <i class="fas fa-universal-access content-block-image-alt-popup--intro-icon"></i>
    <p class="content-block-image-alt-popup--intro-text">
      <%= t('custom.projekts.page.content_block_image_alt_popup.description') %>
    </p>
  </div>

  <div>
    <label class="studio-edit-popup--label">
      <%= t('custom.projekts.page.content_block_image_alt_popup.alt_text') %>:
      <textarea
        class="js-content-block-image-alt-input"
        rows="2"
        placeholder="<%= t('custom.projekts.page.content_block_image_alt_popup.placeholder') %>"
      ></textarea>
    </label>
  </div>
<% end %>

<%= render Shared::ModalComponent.new(id: "siteCodeEditorModal", blur_backdrop: false) do %>
  <div class="site-code-editor-modal--content">
    <div class="site-code-editor-modal--header">
      <h3 class="site-code-editor-modal--title js-site-code-editor-modal-title"><%= t("custom.content_blocks.code_editor_modal.title") %></h3>
    </div>
    <div class="site-code-editor-modal--inner">
      <div class="js-site-code-editor-container site-code-editor-modal--editor-container"></div>
      <div class="site-code-editor-modal--actions d-flex u-gap-10">
        <button
          type="button"
          class="studio-edit-button -green js-site-code-editor-save"
        >
          <i class="fas fa-save"></i>
          <%= t("custom.content_blocks.code_editor_modal.save") %>
        </button>
        <button
          type="button"
          class="studio-edit-button js-site-code-editor-cancel"
        >
          <i class="fas fa-xmark"></i>
          <%= t("custom.content_blocks.code_editor_modal.cancel") %>
        </button>
      </div>
    </div>
  </div>
<% end %>

<template class="js-ai-edit-popup-template">
  <div class="content-block-ai-edit-popup js-content-block-ai-edit-popup">
    <div class="content-block-ai-edit-popup-content">
      <form class="u-width-100" action="">
        <div class="u-flex u-gap-10 content-block-ai-edit-popup-form-row">
          <div class="u-width-100 ai-edit-form">
            <textarea
              name="instructions"
              rows="3"
              required
              placeholder="<%= t('ai.instructions_placeholder') %>"
              class="ai-instructions-textarea js-ai-instructions-textarea"
            ></textarea>
          </div>

          <div class="content-block-ai-edit-popup-checkboxes">
            <div class="u-margin-bottom-5">
              <%= studio_rich_tooltip(
                title: t('ai.allow_text_modification'),
                text: t('ai.allow_text_modification_hint'),
                delay: 1200,
                placement: "right"
              ) do %>
                <label
                  class="content-block-ai-edit-popup-checkbox-label"
                  tabindex="0"
                >
                  <input type="checkbox" class="js-ai-allow-text-modification">
                  <span><%= t('ai.allow_text_modification') %></span>
                </label>
              <% end %>
              <div class="ai-context-checkbox-hint u-margin-bottom">
                <%= t('ai.allow_text_modification_hint_short') %>
              </div>
            </div>

            <% if show_projekt_context_toggle? %>
              <div class="">
                <%= studio_rich_tooltip(
                  title: t('ai.use_full_projekt_context'),
                  text: t('ai.use_full_projekt_context_hint'),
                  delay: 1200,
                  placement: "right"
                ) do %>
                  <label
                    class="content-block-ai-edit-popup-checkbox-label"
                    tabindex="0"
                  >
                    <input type="checkbox" class="js-ai-use-full-projekt-context">
                    <span><%= t('ai.use_full_projekt_context') %></span>
                  </label>
                <% end %>
                <div class="ai-context-checkbox-hint">
                  <%= t('ai.use_full_projekt_context_hint_short') %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="ai-edit-actions d-flex u-flex-align-center justify-between">
          <div class="d-flex u-gap-20 u-flex-align-center">
            <button
              type="button"
              class="studio-edit-button custom-content-block-edit--ai-submit -green -with-background js-content-block-ai-edit--submit-prompt"
            >
              <span class="js-submit-state">
                <i class="fas fa-magic"></i>
                <%= t('ai.submit') %>
              </span>
              <span class="js-cancel-state">
                <i class="fas fa-times"></i>
                <%= t('ai.cancel') %>
              </span>
            </button>
            <div class="ai-edit-mode--loader bars-scale-loader" style="display: none;"></div>
            <div
              class="ai-edit-success-indicator js-ai-edit-success-indicator"
              style="display: none;"
            >
              <i class="fas fa-check"></i>
            </div>
          </div>
          <div class="ai-instructions-hint js-ai-instructions-hint">
            <%= t('ai.instructions_hint') %>
          </div>
        </div>
      </form>
    </div>
  </div>
</template>
