<div class="custom-content-template--item" data-content-block-name="<%= template_name %>">
  <div class="js-add-new-content-block custom-content-template--item-inner">
    <div class="custom-content-template--item-overlay">
    </div>
    <div class="content-block-template">
      <div class="js-content-block-template-content">
        <%= render template_path %>
      </div>
    </div>
  </div>
  <div class="custom-content-template--item-actions">
    <button class="content-block-template-copy-button js-copy-content-block-template" type="button" title="Template in Zwischenablage kopieren">
      <i class="fa fas fa-copy"></i>
    </button>
  </div>
</div>
