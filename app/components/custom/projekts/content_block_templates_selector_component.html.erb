<div data-reveal id="contentBlockTemplatesModal" class="reveal projekt-content-block-templates-selector-wrapper js-projekt-content-block-templates-selector">
  <div class="projekt-content-block-templates-selector">
    <div class="d-flex">
      <h3>Wählen Sie eine Inhaltsblockvorlage aus</h3>
      <button class="close-button button -round-icon-button" data-close aria-label="Close Accessible Modal" type="button">
        <i class="fa fa-xmark">
        </i>
      </button>
    </div>
    <div class="projekt-content-block-templates-selector--inner">
      <ul id="contentBlockSelectorTabs" class="tabs projekt-content-block-templates-selector--tabs" data-tabs>
        <li class="tabs projekt-content-block-templates-selector--tab tabs-title is-active">
          <a href="#contentBlockSelectorTab--basicContent" aria-selected="true">Basisinhalte</a>
        </li>
        <li class="tabs projekt-content-block-templates-selector--tab tabs-title">
          <a href="#contentBlockSelectorTab--satatusAndNotes" >Status & Hinweise</a>
        </li>
        <li class="tabs projekt-content-block-templates-selector--tab tabs-title">
          <a href="#contentBlockSelectorTab--mediaAndResources" >Medien & Ressourcen</a>
        </li>
        <li class="tabs projekt-content-block-templates-selector--tab tabs-title">
          <a href="#contentBlockSelectorTab--teasersAndPromotions" >Teaser und Werbeaktionen</a>
        </li>
        <li class="tabs-title projekt-content-block-templates-selector--tab">
          <a  href="#contentBlockSelectorTab--savedContentBlocks">Eigene Inhaltsblöcke</a>
        </li>
      </ul>
      <div class="tabs-content" data-tabs-content="contentBlockSelectorTabs">
        <div id="contentBlockSelectorTab--basicContent" class="tabs-panel is-active">
          <% basic_content_templates.each do |template_name| %>
            <%= render Custom::Projekts::ContentBlockTemplateItemComponent.new(
              template_name: template_name,
              template_dir: "projekts/content_block_templates/basic_content"
            ) %>
          <% end %>
        </div>
        <div id="contentBlockSelectorTab--satatusAndNotes" class="tabs-panel">
          <% status_and_notes_templates.each do |template_name| %>
            <%= render Custom::Projekts::ContentBlockTemplateItemComponent.new(
              template_name: template_name,
              template_dir: "projekts/content_block_templates/status_and_notes"
            ) %>
          <% end %>
        </div>
        <div id="contentBlockSelectorTab--teasersAndPromotions" class="tabs-panel">
          <% teasers_and_promotions.each do |template_name| %>
            <%= render Custom::Projekts::ContentBlockTemplateItemComponent.new(
              template_name: template_name,
              template_dir: "projekts/content_block_templates/teasers_and_promotions"
            ) %>
          <% end %>
        </div>
        <div id="contentBlockSelectorTab--mediaAndResources" class="tabs-panel">
          <% media_and_resources_templates.each do |template_name| %>
            <%= render Custom::Projekts::ContentBlockTemplateItemComponent.new(
              template_name: template_name,
              template_dir: "custom/projekts/content_block_templates/media_and_resources"
            ) %>
          <% end %>
        </div>
        <div id="contentBlockSelectorTab--savedContentBlocks" class="tabs-panel">
          <div
              class="add-new-saved-content-block-section js-show-content-block-templates-section"
              data-editor-name="new-saved-content-block-form"
              >
              <div class="add-new-content-block-section--plus-button-wrapper">
                <button
                    title="Neue Inhaltsblockvorlage erstellen"
                    type="button"
                    class="js-toggle-saved-content-block-form add-new-content-block-button"
                    >
                    <i class="fas fa-plus"></i>
                    Neuen eigenen Inhaltsblock hinzufügen
                </button>
              </div>
              <div class="js-saved-content-block-form saved-content-block-form">
                <h3>Neue Inhaltsblockvorlage erstellen</h3>
                <p><i>HTML Code hier hinzufügen</i></p>
                <textarea
                    id="saved-content-block-form--textarea"
                    name="content"
                    class="saved-content-block-form--textarea"
                    ></textarea>
              </div>
              <div class="saved-content-block-form--controlls d-flex u-gap-10">
                <button type="button" class="projekt-content-block-edit--button -green js-create-saved-content-block">
                  <i class="fas fa-save"></i>
                  Speichern
                </button>
                <button type="button" class="projekt-content-block-edit--button js-cancel-create-saved-content-block">
                  <i class="fas fa-xmark"></i>
                  Abbrechen
                </button>
              </div>
          </div>

          <div class="saved-content-blocks-list js-saved-content-blocks-list">
            <% saved_content_blocks.each do |saved_content_block| %>
              <%= render SavedContentBlocks::ItemComponent.new(saved_content_block: saved_content_block) %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
