<ul id="contentBlockSelectorTabs" class="tabs projekt-content-block-templates-selector--tabs" data-tabs>
  <% dt_templates_by_category.each_with_index do |category_data, index| %>
    <% category = category_data["category"] %>
    <% is_first = index == 0 %>
    <li class="tabs projekt-content-block-templates-selector--tab tabs-title <%= 'is-active' if is_first %>">
      <a
        href="#contentBlockSelectorTab--<%= category_id(category) %>"
        aria-selected="<%= is_first %>"
      >
        <%= category['name_de'] %>
      </a>
    </li>
  <% end %>
  <li class="tabs-title projekt-content-block-templates-selector--tab">
    <a href="#contentBlockSelectorTab--globalContentBlocks">Interne Inhaltsblöcke</a>
  </li>
  <li class="tabs-title projekt-content-block-templates-selector--tab">
    <a href="#contentBlockSelectorTab--userContentBlocks">Eigene Inhaltsblöcke</a>
  </li>
</ul>
<div class="tabs-content" data-tabs-content="contentBlockSelectorTabs">
  <% dt_templates_by_category.each_with_index do |category_data, index| %>
    <% category = category_data["category"] %>
    <% templates = category_data["templates"] || [] %>
    <% is_first = index == 0 %>
    <div
      id="contentBlockSelectorTab--<%= category_id(category) %>"
      class="tabs-panel <%= 'is-active' if is_first %>"
    >
      <% templates.each do |template| %>
        <%= render Projekts::DtContentBlockTemplateItemComponent.new(template: template) %>
      <% end %>
    </div>
  <% end %>
  <div id="contentBlockSelectorTab--globalContentBlocks" class="tabs-panel">
    <p class="saved-content-blocks-explanation"><%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.global_explanation') %></p>
    <div
        class="add-new-saved-content-block-section js-show-content-block-templates-section"
        data-editor-name="new-global-content-block-form"
        data-saved-content-block-type="global"
        >
        <div class="add-new-content-block-section--plus-button-wrapper">
          <button
              title="Neue interne Inhaltsblockvorlage erstellen"
              type="button"
              class="js-toggle-saved-content-block-form add-new-content-block-button"
              >
              <i class="fas fa-plus"></i>
              Neuen internen Inhaltsblock hinzufügen
          </button>
        </div>
        <div class="js-saved-content-block-form saved-content-block-form">
          <h3>Neue interne Inhaltsblockvorlage erstellen</h3>
          <p><i>HTML Code hier hinzufügen</i></p>
          <textarea
              id="global-content-block-form--textarea"
              name="content"
              class="saved-content-block-form--textarea"
              ></textarea>
        </div>
        <div class="saved-content-block-form--controlls d-flex u-gap-10">
          <button type="button" class="projekt-content-block-edit--button -green js-create-saved-content-block">
            <i class="fas fa-save"></i>
            Speichern
          </button>
          <button type="button" class="projekt-content-block-edit--button js-cancel-create-saved-content-block">
            <i class="fas fa-xmark"></i>
            Abbrechen
          </button>
        </div>
    </div>

    <div class="saved-content-blocks-list js-saved-content-blocks-list">
      <% global_content_blocks.each do |saved_content_block| %>
        <%= render SavedContentBlocks::ItemComponent.new(saved_content_block: saved_content_block) %>
      <% end %>
    </div>
  </div>

  <div id="contentBlockSelectorTab--userContentBlocks" class="tabs-panel">
    <p class="saved-content-blocks-explanation"><%= t('custom.projekt.content_block_templates_selector.saved_content_blocks.user_explanation') %></p>
    <div
        class="add-new-saved-content-block-section js-show-content-block-templates-section"
        data-editor-name="new-user-content-block-form"
        data-saved-content-block-type="user"
        >
        <div class="add-new-content-block-section--plus-button-wrapper">
          <button
              title="Neue eigene Inhaltsblockvorlage erstellen"
              type="button"
              class="js-toggle-saved-content-block-form add-new-content-block-button"
              >
              <i class="fas fa-plus"></i>
              Neuen eigenen Inhaltsblock hinzufügen
          </button>
        </div>
        <div class="js-saved-content-block-form saved-content-block-form">
          <h3>Neue eigene Inhaltsblockvorlage erstellen</h3>
          <p><i>HTML Code hier hinzufügen</i></p>
          <textarea
              id="user-content-block-form--textarea"
              name="content"
              class="saved-content-block-form--textarea"
              ></textarea>
        </div>
        <div class="saved-content-block-form--controlls d-flex u-gap-10">
          <button type="button" class="projekt-content-block-edit--button -green js-create-saved-content-block">
            <i class="fas fa-save"></i>
            Speichern
          </button>
          <button type="button" class="projekt-content-block-edit--button js-cancel-create-saved-content-block">
            <i class="fas fa-xmark"></i>
            Abbrechen
          </button>
        </div>
    </div>

    <div class="saved-content-blocks-list js-saved-content-blocks-list">
      <% user_content_blocks.each do |saved_content_block| %>
        <%= render SavedContentBlocks::ItemComponent.new(saved_content_block: saved_content_block) %>
      <% end %>
    </div>
  </div>
</div>
