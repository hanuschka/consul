<div class="projekt-content-start-section js-projekt-content-start-section">
  <h3 class="margin-bottom"><%= t('custom.projekts.content_start_section.title') %></h3>
  <div class="projekt-content-start-buttons js-projekt-content-start-buttons">
    <button
      type="button"
      class="projekt-content-start-button js-projekt-file-import-trigger"
      title="<%= t('custom.projekts.content_start_section.file_import_button.title') %>"
    >
      <i class="fas fa-file-upload"></i>
      <div class="projekt-content-start-button--content">
        <div class="projekt-content-start-button--title"><%= t('custom.projekts.content_start_section.file_import_button.button_title') %></div>
        <div class="projekt-content-start-button--description"><%= t('custom.projekts.content_start_section.file_import_button.description') %></div>
        <div class="projekt-content-start-button--action"><%= t('custom.projekts.content_start_section.file_import_button.action') %></div>
      </div>
    </button>

    <button
      type="button"
      class="projekt-content-start-button js-projekt-prompt-trigger"
      title="<%= t('custom.projekts.content_start_section.prompt_button.title') %>"
    >
      <i class="fas fa-pen"></i>
      <div class="projekt-content-start-button--content">
        <div class="projekt-content-start-button--title"><%= t('custom.projekts.content_start_section.prompt_button.button_title') %></div>
        <div class="projekt-content-start-button--description"><%= t('custom.projekts.content_start_section.prompt_button.description') %></div>
        <div class="projekt-content-start-button--action"><%= t('custom.projekts.content_start_section.prompt_button.action') %></div>
      </div>
    </button>

    <button
      type="button"
      class="projekt-content-start-button js-projekt-template-trigger"
      title="<%= t('custom.projekts.content_start_section.template_button.title') %>"
    >
      <i class="fas fa-th-large"></i>
      <div class="projekt-content-start-button--content">
        <div class="projekt-content-start-button--title"><%= t('custom.projekts.content_start_section.template_button.button_title') %></div>
        <div class="projekt-content-start-button--description"><%= t('custom.projekts.content_start_section.template_button.description') %></div>
        <div class="projekt-content-start-button--action"><%= t('custom.projekts.content_start_section.template_button.action') %></div>
      </div>
    </button>

    <button
      type="button"
      class="projekt-content-start-button js-projekt-empty-block-trigger"
      title="<%= t('custom.projekts.content_start_section.empty_block_button.title') %>"
    >
      <i class="fas fa-plus"></i>
      <div class="projekt-content-start-button--content">
        <div class="projekt-content-start-button--title"><%= t('custom.projekts.content_start_section.empty_block_button.button_title') %></div>
        <div class="projekt-content-start-button--description"><%= t('custom.projekts.content_start_section.empty_block_button.description') %></div>
        <div class="projekt-content-start-button--action"><%= t('custom.projekts.content_start_section.empty_block_button.action') %></div>
      </div>
    </button>
  </div>

  <input
    type="file"
    class="js-projekt-file-import-input"
    accept=".pdf,.docx,.odt"
    style="display: none;"
  >

  <div
    class="projekt-file-import-preview js-projekt-file-import-preview"
    style="display: none;"
  >
    <div class="projekt-file-import-preview-header">
      <div class="projekt-file-import-preview-actions">
        <button
          type="button"
          class="button secondary hollow small js-projekt-file-import-select-other"
        >
          <i class="fas fa-folder-open"></i>
          <%= t('custom.projekts.content_start_section.file_import_preview.select_other_file') %>
        </button>
        <button
          type="button"
          class="button secondary small hollow js-projekt-file-import-cancel"
        >
          <i class="fas fa-times"></i>
          <%= t('custom.projekts.content_start_section.file_import_preview.cancel') %>
        </button>
      </div>

      <div class="projekt-file-import-preview-info">
        <i class="fas fa-file js-projekt-file-import-icon"></i>
        <span class="js-projekt-file-import-filename"></span>
      </div>
    </div>
    <div class="projekt-file-import-preview-prompt">
      <label for="projekt-file-import-user-prompt">
        <%= t('custom.projekts.content_start_section.file_import_preview.additional_instructions') %>
      </label>
      <textarea
        id="projekt-file-import-user-prompt"
        class="js-projekt-file-import-user-prompt"
        rows="4"
        placeholder="<%= t('custom.projekt_content_blocks.import.user_prompt_placeholder') %>"
      ></textarea>
    </div>
    <button
      type="button"
      class="button projekt-file-import-button js-projekt-file-import-submit"
    >
      <i class="fas fa-upload"></i>
      <%= t('custom.projekts.content_start_section.file_import_preview.submit') %>
    </button>
  </div>

  <div
    class="projekt-prompt-form js-projekt-prompt-form"
    style="display: none;"
  >
    <div class="projekt-prompt-form-header">
      <h3><%= t('custom.projekts.content_start_section.prompt_form.header') %></h3>
      <button
        type="button"
        class="button secondary small hollow js-projekt-prompt-cancel"
      >
        <i class="fas fa-times"></i>
        <%= t('custom.projekts.content_start_section.prompt_form.cancel') %>
      </button>
    </div>
    <div class="projekt-prompt-form-content">
      <label for="projekt-prompt-input">
        <%= t('custom.projekts.content_start_section.prompt_form.label') %>
      </label>
      <textarea
        id="projekt-prompt-input"
        class="js-projekt-prompt-input"
        rows="6"
        placeholder="<%= t('custom.projekts.content_start_section.prompt_form.placeholder') %>"
      ></textarea>
    </div>
    <button
      type="button"
      class="button projekt-file-import-button js-projekt-prompt-submit"
    >
      <i class="fas fa-magic"></i>
      <%= t('custom.projekts.content_start_section.prompt_form.submit') %>
    </button>
  </div>

  <div
    class="projekt-file-import-loader js-projekt-file-import-loader"
    style="display: none;"
  >
    <div class="bars-scale-loader"></div>
    <span class="js-projekt-loader-message"><%= t('custom.projekts.content_start_section.loader.message') %></span>
  </div>
</div>
