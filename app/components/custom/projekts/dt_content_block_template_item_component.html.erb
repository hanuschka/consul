<div
  class="custom-content-template--item"
  data-content-block-name="<%= template_name %>"
  data-dt-template-id="<%= template_id %>"
>
  <div class="js-add-new-content-block custom-content-template--item-inner">
    <div class="custom-content-template--item-overlay"></div>
    <% if show_visibility_badge? %>
      <div class="custom-content-template--visibility-badges">
        <% if hidden? %>
          <span class="custom-content-template--badge -hidden">
            <i class="fas fa-eye-slash"></i>
            <%= t('custom.projekt.content_block_templates_selector.visibility.hidden') %>
          </span>
        <% end %>
        <% if hidden_by_date? %>
          <span class="custom-content-template--badge -hidden-until">
            <i class="fas fa-clock"></i>
            <%= t('custom.projekt.content_block_templates_selector.visibility.hidden_until',
                  date: l(hidden_until_date, format: :long)) %>
          </span>
        <% end %>
      </div>
    <% end %>
    <div class="content-block-template">
      <div class="js-content-block-template-content">
        <%= template_content.html_safe %>
      </div>
    </div>
  </div>
  <div class="custom-content-template--item-actions">
    <button
      class="content-block-template-copy-button js-copy-content-block-template"
      type="button"
      title="Template in Zwischenablage kopieren"
    >
      <i class="fa fas fa-copy"></i>
    </button>
  </div>
</div>
