<%= render(Resources::ListItemComponent.new(**component_attributes)) do |c| %>
  <% c.with_image(image: projekt.image, resource: projekt) %>

  <% c.with_subheading do %>
    <div class="resource-item--tags">
      <% projekt.tags.first(2).each do |tag| %>
        <%= link_to(path_for_resource_with_params(projekt, tags: tag.name), class: 'resource-item--tag') do %>
          <%= tag.name %>
        <% end %>
      <% end %>

      <% if projekt.tags[2].present? %>
        <%= link_to(path_for_resource_with_params(projekt, tags: projekt.tags.map(&:name).join(",")), class: 'resource-item--tag') do %>
          <% remaining_tags_count = projekt.tags.count - 2 %>
          <%= t("custom.tags.remaining_count", count: remaining_tags_count) %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% c.with_header do %>
    <%= date_formated %>
  <% end %>

  <% if @projekt.related_sdgs.present? %>
    <% c.with_image_overlay_item do %>
      <%= render SDG::FilterLinksComponent.new(@projekt.related_sdgs, Projekt) %>
    <% end %>
  <% end %>

  <% if active_and_visible_projekt_phases.any? && projekt_option(projekt, "general.external_participation_link").blank? %>
    <% c.with_additional_body_section do %>
      <div class="projekt-list-item--phases">
        <% active_and_visible_projekt_phases.each do |phase| %>
          <a
           href="<%= projekt_phase_url_for(phase) %>"
           class="projekt-phase-link <%= phase_icon_class(phase) %>"
          >
            <%= phase.title %>
          </a>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% c.with_footer_section do %>
    <%= link_to("Zum Projekt", projekt_url, class: "button -grey", target: url_target, tabindex: "-1", data: { turbolinks: false }, aria: { hidden: true }) %>
  <% end %>
<% end %>
