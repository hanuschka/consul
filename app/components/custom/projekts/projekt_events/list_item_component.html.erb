<%= render(Resources::ListItemComponent.new(**component_attributes)) do |c| %>
  <% c.with_image(image: projekt_event.image, image_placeholder_icon_class: "fa-comments", resource: projekt_event) %>

  <% c.with_header do %>
    <div>
      <%= ProjektEvent.model_name.human %>
    </div>
  <% end %>

  <% c.with_image_overlay_item do %>
    <div class="projekt-event-item-new-calendar">
      <div class="projekt-event-item-new-calendar-dayname">
        <%= l(projekt_event.datetime, format: "%b").upcase %>
      </div>
      <div class="projekt-event-item-new-calendar-daynumber">
        <%= projekt_event.datetime.strftime("%d") %>
      </div>
      <% if projekt_event.end_datetime.present? && projekt_event.datetime.to_date != projekt_event.end_datetime.to_date %>
        <div class="projekt-event-item-new-calendar--enddatetime">
          <div class="projekt-event-item-new-calendar--separator">
            -
          </div>
          <div class="projekt-event-item-new-calendar-dayname">
            <%= l(projekt_event.end_datetime, format: "%b").upcase %>
          </div>
          <div class="projekt-event-item-new-calendar-daynumber">
            <%= projekt_event.end_datetime.strftime("%d") %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% c.with_footer_section do %>
    <div style="align-self:baseline;">
      <i class="fas fa-map"></i><span style="margin-left:5px;"><%= projekt_event&.location %></span>
    </div>
  <% end %>

  <% if projekt_event.language.present? %>
    <% c.with_footer_section do %>
      <div style="align-self:baseline;">
        <i class="fa fa-language"></i><span style="margin-left:5px;"><%= projekt_event.language %></span>
      </div>
    <% end %>
  <% end %>

  <% accessibility_features = [] %>
  <% accessibility_features << { icon: 'fa-wheelchair', label: ProjektEvent.human_attribute_name(:wheelchair_accessible) } if projekt_event.wheelchair_accessible? %>
  <% accessibility_features << { icon: 'fa-toilet', label: ProjektEvent.human_attribute_name(:accessible_toilet) } if projekt_event.accessible_toilet? %>
  <% accessibility_features << { icon: 'fa-parking', label: ProjektEvent.human_attribute_name(:disabled_parking_nearby) } if projekt_event.disabled_parking_nearby? %>
  <% accessibility_features << { icon: 'fa-walking', label: ProjektEvent.human_attribute_name(:tactile_guidance_systems) } if projekt_event.tactile_guidance_systems? %>
  <% accessibility_features << { icon: 'fa-volume-up', label: ProjektEvent.human_attribute_name(:induction_loop_available) } if projekt_event.induction_loop_available? %>
  <% accessibility_features << { icon: 'fa-dog', label: ProjektEvent.human_attribute_name(:assistance_dogs_welcome) } if projekt_event.assistance_dogs_welcome? %>
  <% accessibility_features << { icon: 'fa-sign-language', label: ProjektEvent.human_attribute_name(:sign_language_interpreter) } if projekt_event.sign_language_interpreter? %>
  <% if accessibility_features.any? %>
    <% c.with_footer_section do %>
      <div style="align-self:baseline;">
        <i class="fa fa-universal-access"></i>
        <span style="margin-left:5px;">
          <% accessibility_features.each_with_index do |feature, index| %>
            <i class="fa <%= feature[:icon] %>" title="<%= feature[:label] %>"></i><%= feature[:label] %><%= ', ' unless index == accessibility_features.size - 1 %>
          <% end %>
        </span>
      </div>
    <% end %>
  <% end %>

  <% c.with_footer_section do %>
    <%= content_tag(:button, t("custom.projekt_events.list_item_component.cta_button"),
          onclick: "$('##{dom_id(projekt_event, :modal)}').foundation('open');",
          class: "button -grey") %>

    <div class="reveal" id="<%= dom_id(projekt_event, :modal) %>" data-reveal>
      <button class="close-button" data-close aria-label="Close modal" type="button">
        <span aria-hidden="true">&times;</span>
      </button>

      <%= render Projekts::ProjektEvents::ListItemNewComponent.new(projekt_event: projekt_event) %>

    </div>
  <% end %>
<% end %>
