<% if @enable %>
  <div
    class="js-projekt-section-data-wrapper js-toggle-section-with-setting <%= disabled_class %> toggle-section-with-setting"
    data-projekt-setting-key="<%= @setting_key %>"
    data-projekt-setting-id="<%= get_setting_id %>"
    data-projekt-setting-active="<%= @setting_active %>"
  >
    <%= content %>
    <%= studio_rich_tooltip(
      title: default_title,
      text: "Blendet diesen Bereich in der öffentlichen Seitenleiste ein oder aus. Ausgeblendete Bereiche sind nur für Administratoren sichtbar.",
      delay: 1200
    ) do %>
      <button
        type="button"
        class="js-sidebar-section-toggle-visibility sidebar--section-toggle-visibility js-studio-hide-on-preview"
        data-on-title="<%= on_title %>"
        data-off-title="<%= off_title %>"
        tabindex="-1"
      >
        <i class="fas <%= icon_class %>"></i>
      </button>
    <% end %>
  </div>
<% else %>
  <%= content %>
<% end %>
