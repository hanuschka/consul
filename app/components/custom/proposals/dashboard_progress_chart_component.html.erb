<div class="new-card proposals-dashboard-progress-chart">
  <% content_for :action_title, t("dashboard.progress.title") %>

  <div class="d-flex proposals-dashboard-progress-chart--links">
    <%= link_to t("dashboard.progress.group_by_date"),
      progress_proposal_dashboard_path(proposal),
      class: "button medium #{daily_selected_class}" %>
    <%= link_to t("dashboard.progress.group_by_week"),
      progress_proposal_dashboard_path(proposal, group_by: "week"),
      class: "button medium #{weekly_selected_class}" %>
    <%= link_to t("dashboard.progress.group_by_month"),
      progress_proposal_dashboard_path(proposal, group_by: "month"),
      class: "button medium #{monthly_selected_class}" %>
  </div>

  <div id="proposal-graph"
    data-proposal-graph-url="<%= proposal_dashboard_supports_path(proposal, format: :json, group_by: group_by) %>"
    data-successful-proposal-graph-url="<%= proposal_dashboard_successful_supports_path(proposal, format: :json, group_by: group_by) %>"
    data-proposal-achievements-url="<%= proposal_dashboard_achievements_path(proposal, format: :json, group_by: group_by) %>"
    data-proposal-graph-group-by="<%= group_by %>"
    data-proposal-graph-progress-label="<%= t("dashboard.progress.progress") %>"
    data-proposal-graph-supports-label="<%= t("dashboard.progress.supports") %>"
    data-proposal-graph-success-label="<%= t("dashboard.progress.success") %>"
    data-proposal-success="<%= custom_votes_for_proposal_success(@proposal) || Setting["votes_for_proposal_success"] %>"
    data-proposal-resources-url="<%= proposal_dashboard_resources_path(proposal, format: :json) %>"
    class="proposal-graph js-proposal-progress-chart">
    <div class="chart-loading-placeholder">
      <%= render Shared::SkeletonPlaceholderComponent.new %>
    </div>
    <p
      class="proposals-dashboard-progress-chart--error"
      role="alert"
    >
      <%= t("dashboard.progress.load_error") %>
    </p>
    <canvas></canvas>
  </div>
</div>
