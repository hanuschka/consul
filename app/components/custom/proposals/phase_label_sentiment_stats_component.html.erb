<div class="proposal-phase-stats-charts">
  <% if labels_data[:labels].any? %>
    <%= render Shared::BarChartComponent.new(
      title: labels_title,
      labels: labels_data[:labels],
      values: labels_data[:values],
      orientation: "horizontal"
    ) %>
  <% end %>

  <% if sentiments_data[:labels].any? %>
    <%= render Shared::BarChartComponent.new(
      title: sentiments_title,
      labels: sentiments_data[:labels],
      values: sentiments_data[:values],
      orientation: "vertical",
      colors: sentiments_data[:colors]
    ) %>
  <% end %>
</div>

