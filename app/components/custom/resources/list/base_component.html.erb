<div class="resources-list js-resources-list <%= class_names %>">
  <% if @title.present? %>
    <h3 class="resources-list--title title-accent">
      <%= @title %>
    </h3>
  <% end %>

  <%= toolbar %>

  <%= content %>

  <% if items? %>
    <div class="no-ul-style resources-list--body js-resources-list--body">
      <ul class="no-ul-style resources-list--inner">
        <%= items %>
      </ul>
    </div>
  <% elsif @empty_text.present? %>
    <div class="no-ul-style resources-list--body js-resources-list--body">
      <%= render Resources::List::EmptyComponent.new(text: @empty_text) %>
    </div>
  <% end %>

  <%= footer %>
</div>
