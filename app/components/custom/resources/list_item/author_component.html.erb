<% author_details = capture do %>
  <div class="resource-item--author-photo">
    <% if show_avatar? %>
      <%= image_tag(author.image&.variant(:popup)) %>
    <% else %>
      <div class="resource-item--author-photo--placeholder">
        <%= resource.author_initial %>
      </div>
    <% end %>
  </div>
  <div class="resource-item--author-name">
    <div class="resource-item--author-full-name">
      <%= resource.author_name %>
    </div>
    <% if !on_behalf_of? %>
      <%= render Shared::OfficialPositionBadgeComponent.new(user: author) %>
    <% end %>
  </div>
<% end %>

<% if linkable? %>
  <%= link_to user_path(author), class: "resource-item--author" do %>
    <%= author_details %>
  <% end %>
<% else %>
  <div class="resource-item--author">
    <%= author_details %>
  </div>
<% end %>
