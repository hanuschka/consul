<div class="custom-collapse <%= "-opened" if @opened_by_default %> <%= "-with-head-background" if @head_background %>">
  <button class="custom-collapse--head js-collapse-head <%= "-with-hover-background" if @head_hover_background %>" aria-expanded="<%= @opened_by_default ? "true" : "false" %>">
    <%= head %>
    <div class="icon-chevron-down">
    </div>
  </button>
  <div class="custom-collapse--body js-collapse-body">
    <%= body %>
  </div>
</div>
