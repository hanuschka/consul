<div class="resources-list--filter">
  <div class="resources-list--filter-title">
    <%= @title %>:
  </div>
  <ul class="no-bullet filter-dropdown-component--item">
    <dropdown-select-menu title="<%= @title %>" selected="<%= selected_option %>">
      <% @options.each do |option| %>
        <%= link_to link_path(option),
          class: link_class,
          data: link_data_attributes(option) do
        %>
          <%= translate_option(option) %>
        <% end %>
      <% end %>
    </dropdown-select-menu>
  </ul>
</div>
