<% map_body = capture do %>
  <% if lazy_load_map_data? %>
    <div class="map-data-wrapper js-map-data-wrapper">
      <%= map_div %>
      <%= render "shared/map_component/data_overlay" %>
    </div>
  <% else %>
    <%= map_div %>
  <% end %>
<% end %>

<% if hide_from_screen_readers? %>
  <p class="show-for-sr"><%= map_accessibility_note %></p>
  <div class="map-accessibility-hidden" aria-hidden="true">
    <%= map_body %>
  </div>
<% else %>
  <%= map_body %>
<% end %>
