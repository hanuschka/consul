<% map_body = capture do %>
  <% if lazy_load_map_data? %>
    <div class="map-data-wrapper js-map-data-wrapper">
      <%= map_div %>
      <%= render "shared/map_component/data_overlay" %>
    </div>
  <% else %>
    <%= map_div %>
  <% end %>
<% end %>

<% if collapsible? %>
  <div class="map-collapsible-wrapper">
    <p class="map-collapsible-wrapper--note">
      <i class="fas fa-info-circle" aria-hidden="true"></i>
      <%= map_accessibility_note %>
    </p>
    <details class="map-collapsible-wrapper--details js-map-collapsible">
      <summary class="map-collapsible-wrapper--toggle">
        <i class="fas fa-map-marked-alt" aria-hidden="true"></i>
        <%= t("custom.accessibility.map.toggle_label") %>
      </summary>
      <%= map_body %>
    </details>
  </div>
<% else %>
  <%= map_body %>
<% end %>
