<%= map_div %>

<% if use_mapbox?  %>
  <% content_for :additional_plugin_styles do %>
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.12.0/mapbox-gl.css" rel="stylesheet">
    <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.5.0/mapbox-gl-draw.css" type="text/css">
  <% end %>
  <% content_for :additional_plugin_scripts do %>
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.12.0/mapbox-gl.js" data-turbolinks-track="reload" ></script>
    <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.5.0/mapbox-gl-draw.js" data-turbolinks-track="reload"></script>
  <% end %>
<% end %>
