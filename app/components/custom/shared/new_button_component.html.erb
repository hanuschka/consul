<%= new_button_html %>

<% if show_ai_flow_link? %>
  <% if ai_flow_disabled? %>
    <%= render Shared::AiFeatureTooltipComponent.new(
      feature_title: t("ai_proposal_flow.entry_button"),
      feature_text: t("ai_proposal_flow.entry_button_admin_hint"),
      layout_class: "-block"
    ) do %>
      <button
        class="button expanded new-resource-button ai-flow-button"
        disabled
      >
        <%= t("ai_proposal_flow.entry_button") %>
      </button>
    <% end %>
  <% else %>
    <%= link_to t("ai_proposal_flow.entry_button"), ai_flow_link_path,
          class: "button expanded new-resource-button ai-flow-button",
          data: { turbolinks: false } %>
  <% end %>
<% end %>

<% if permission_problem_key.present? %>
  <div class="callout alert new-resource-not-allowed-message" style='display:none'>
    <%= permission_problem_message(permission_problem_key) %>
  </div>
<% end %>
