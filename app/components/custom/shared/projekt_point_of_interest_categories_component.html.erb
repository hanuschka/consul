<div class="projekt-point-of-interest-categories">
  <% @categories.each do |category| %>
    <% if filter_link? %>
      <%= link_to link_path(category),
        remote: true,
        class: "js-remote-link-push-state projekt-point-of-interest-category-link",
        "data-footer-tab-back-url": footer_tab_back_button_url(category),
        onclick: "$('#footer-content').addClass('show-loader')" do %>
        <span class="projekt-point-of-interest-category <%= "selected" if category_selected?(category) %>" style="background-color: <%=  category.color %>;">
          <i class="fas fa-<%= category.icon %>"></i>
          <%= category.name %>
        </span>
      <% end %>
    <% else %>
      <span class="projekt-point-of-interest-category selected" style="background-color: <%= category.color %>">
        <i class="fas fa-<%= category.icon %>"></i>
        <%= category.name %>
      </span>
    <% end %>
  <% end %>
</div>
