<section class="sidebar-card js-sidebar-card <%= class_name %>" >
  <% if @title.present? %>
    <%= content_tag heading_tag, class: "sidebar-card--title-heading" do %>
      <span class="sidebar-card--title js-sidebar-card--title" aria-controls="<%= content_id %>">
        <span class="sidebar-card--title-inner">
          <i class="fas sidebar--icon fa-<%= @icon_name %>"></i>
          <span class="sidebar-card--title-text"><%= @title %></span>
        </span>
        <span class="icon-chevron-down sidebar-collapse-icon"></span>
      </span>
    <% end %>
  <% end %>

  <div class="sidebar-card--content" id="<%= content_id %>">
    <% if @description.present? %>
      <div class="sidebar-card--description">
        <%= @description %>
      </div>
    <% end %>

    <div class="sidebar-card--section">
      <% if edit_link? %>
        <%= studio_rich_tooltip(
          title: "Bereich bearbeiten",
          text: "Öffnet die Einstellungen dieses Seitenleisten-Bereichs zur Bearbeitung.",
          delay: 1200
        ) do %>
          <div class="js-sidebar-card-edit-link margin-bottom-10">
            <%= edit_link %>
          </div>
        <% end %>
      <% end %>

      <%= content %>
    </div>
    <% if additional_sections.present? %>
      <% additional_sections.each do |additional_section| %>
        <div class="sidebar-card--separator"> </div>
        <div class="sidebar-card--section">
          <%= additional_section %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
