<section class="sidebar-card js-sidebar-card <%= class_name %>" >
  <% if @title.present? %>
    <button class="sidebar-card--title js-sidebar-card--title" aria-expanded="false">
      <div class="d-flex sidebar-card--title-inner">
        <i class="fas sidebar--icon fa-<%= @icon_name %>"></i>
        <%= content_tag heading_tag, @title, class: "sidebar-card--title-text" %>
      </div>
      <div class="icon-chevron-down sidebar-collapse-icon"></div>
    </button>
  <% end %>

  <div class="sidebar-card--content">
    <% if @description.present? %>
      <div class="sidebar-card--description">
        <%= @description %>
      </div>
    <% end %>

    <div class="sidebar-card--section">
      <% if edit_link? %>
        <div class="js-sidebar-card-edit-link margin-bottom-10">
          <%= edit_link %>
        </div>
      <% end %>

      <%= content %>
    </div>
    <% if additional_sections.present? %>
      <% additional_sections.each do |additional_section| %>
        <div class="sidebar-card--separator"> </div>
        <div class="sidebar-card--section">
          <%= additional_section %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
