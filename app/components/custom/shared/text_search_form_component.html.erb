<%= form_tag form_url, method: :get, remote: remote_attribute, enforce_utf8: false, class: "text-search-form js-text-search-form", data: { disable_reset_button_submit: @disable_reset_button_submit} do %>
  <% other_query_params_from_current_path.each do |param_name, param_value| %>
    <%= hidden_field_tag param_name, param_value %>
  <% end %>

  <label for="search_text">
    <input
      type="text"
      name="search"
      autocomplete="off"
      placeholder="<%= t("placeholder", scope: i18n_namespace) %>"
      class="input-group-field js-text-search-form-search-input"
      aria-label="<%= t("custom.accessibility.search.search_input.aria-label") %>"
      value="<%= params[:search] %>"
    >
  </label>
  <%# <div class="input-group-button"> %>
    <%#   <button type="submit" class="button" title="<%= t("#{i18n_namespace}.button_title", default: "Search") %1>"> %>
      <%#     <span class="icon-search"></span> %>
      <%#   </button> %>
    <%# </div> %>
  <div class="text-search-form--search-button js-search-button" role="button" aria-label="<%= t("#{i18n_namespace}.button_title", default: t("custom.accessibility.search.search_button.aria-label")) %>" title="<%= t("#{i18n_namespace}.button_title", default: t("custom.accessibility.search.search_button.aria-label")) %>">
    <span class="icon-search" aria-hidden="true"></span>
  </div>
  <div class="text-search-form--reset-button js-text-search-form-reset-button" disabled>
    <i class="icon-cross"></i>
  </div>
<% end %>
