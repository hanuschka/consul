<% inner_content = capture do %>
  <input
    id="<%= input_id %>"
    type="text"
    name="search"
    autocomplete="off"
    aria-label="<%= t("custom.accessibility.search.search_input.aria-label") %>"
    placeholder="<%= t("placeholder", scope: i18n_namespace) %>"
    class="<%= input_classes %>"
    value="<%= params[:search] %>"
  >
  <button
    class="text-search-form--search-button js-search-button"
    type="submit"
    aria-label="<%= t("#{i18n_namespace}.button_title", default: t("custom.accessibility.search.search_button.aria-label")) %>"
    title="<%= t("#{i18n_namespace}.button_title", default: t("custom.accessibility.search.search_button.aria-label")) %>"
  >
    <span class="icon-search" aria-hidden="true"></span>
  </button>
  <button
    class="text-search-form--reset-button js-text-search-form-reset-button"
    type="button"
    disabled
    aria-label="<%= t("custom.accessibility.search.reset_button.aria-label") %>"
  >
    <i class="icon-cross" aria-hidden="true"></i>
  </button>
<% end %>

<% if standalone? %>
  <div
    class="text-search-form js-text-search-form"
    data-disable-reset-button-submit="<%= disable_reset_button_submit? %>"
  >
    <%= inner_content %>
  </div>
<% else %>
  <%= form_tag form_url, method: :get, remote: remote_attribute, enforce_utf8: false, class: "text-search-form js-text-search-form", data: { disable_reset_button_submit: disable_reset_button_submit? } do %>
    <% other_query_params_from_current_path.each do |param_name, param_value| %>
      <%= hidden_field_tag param_name, param_value %>
    <% end %>
    <%= inner_content %>
  <% end %>
<% end %>
