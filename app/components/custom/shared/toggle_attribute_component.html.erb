<%= form_with(model: @resource, url: @path, local: false, html: { class: "toggle-attribute-component" }) do |f| %>
  <%= f.hidden_field @attribute, value: !@resource.send(@attribute) %>
  <%= f.button button_text.capitalize, { id: @options[:input_id], role: "switch", aria: { checked: @resource.send(@attribute) }} %>
<% end %>
