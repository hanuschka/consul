<div class="sidebar-users-list">
  <div class="sidebar-users-list--images" role="list">
    <% visible_users.each do |user| %>
      <%= link_to user, class: "sidebar-users-list--image", role: "listitem", title: t("custom.accessibility.sidebar.user_avatar_title", name: user.name) do %>
        <% if user.image.present? %>
          <%= image_tag(user.image&.variant(:thumb)) %>
        <% else %>
          <%= user&.first_letter_of_name %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
