<main class="user-resources-form js-user-resources-form <%= base_class_name %><%= ' -embbeded-in-ai-flow' if @embbeded_in_ai_flow %>">
  <% if !@embbeded_in_ai_flow && projekt_phase_feature?(projekt_phase, "form.voice_assistant") && Ai::Settings.voice_assistant_allowed? %>
    <%= render Dt::VoiceAssistantComponent.new(
      assistant_codename: "proposal_voice_assistant",
      projekt_phase: projekt_phase
    ) %>
  <% end %>

  <%= translatable_form_for(resource, url: @url, html: { class: "js-rich-text-form user-resource-form", id: dom_id(resource, :form) }) do |f| %>
    <% if show_back_button? %>
      <%= back_link %>
    <% end %>

    <% sidebar_html = capture do %>
      <% if show_sidebar? %>
        <aside class="sidebar">
        <fieldset class="required-fields">
          <%= hidden_field_tag :order, params[:order] %>

          <% if show_documents_input? %>
            <%= render(Shared::SidebarCardComponent.new(
              title: "Dokumente hinzufügen",
              icon_name: "file")) do %>
              <div class="documents" id="attach-documents">
                <%= render "documents/nested_documents", f: f %>
              </div>
            <% end %>
          <% end %>

          <% if translations_interface_enabled? %>
            <%= render(Shared::SidebarCardComponent.new(
              title: "Sprachen",
              opened_on_mobile: true,
              icon_name: "language")) do %>
              <p>
              Wählen Sie aus, in welcher Sprache/welchen Sprachen Ihre Diskussion stattfinden soll:
              </p>
              <%= render "shared/globalize_locales", resource: resource %>
            <% end %>
          <% end %>

          <% if show_external_video_input? %>
            <%= render(Shared::SidebarCardComponent.new(
              title: "Video hinzufügen",
              opened_on_mobile: true,
              icon_name: "video")) do %>
              <p>
              Gibt es Videos, die Ihre Argumentation und Sichtweise stützen?
              Dann fügen Sie diese über einen Link hinzu.
              </p>
              <%= f.text_field :video_url, label: false, placeholder: "YouTube oder Vimeo-Link eingeben", class: "light-input" %>
            <% end %>
          <% end %>

          <%= f.invisible_captcha :subtitle %>

          <% if helpers.allowed_to_post_on_behalf_of?(current_user, resource) %>
            <%= render(Shared::SidebarCardComponent.new(
              title: "Veröffentlichen für",
              opened_on_mobile: true,
              icon_name: "user")) do %>
              <p>
              dieses Feld sehen nur Admin. Sie können hier eine Diskussion im Namen von jemandem erstellen.
              </p>
              <%= f.text_field :on_behalf_of, label: false, placeholder: "Namen eingeben...", class: "light-input" %>

              <%= f.text_field :on_behalf_of_company_name,
                    label: t("custom.on_behalf_of_account.company_name.label"),
                    placeholder: t("custom.on_behalf_of_account.company_name.placeholder"),
                    class: "light-input" %>
              <%= f.email_field :on_behalf_of_email,
                    label: t("custom.on_behalf_of_account.email.label"),
                    placeholder: t("custom.on_behalf_of_account.email.placeholder"),
                    class: "light-input" %>
              <p><%= t("custom.on_behalf_of_account.email.description") %></p>
            <% end %>
          <% end %>
        </fieldset>
        </aside>
      <% end %>
    <% end %>

    <div class="flex-layout">
      <div class="main-column">
        <% unless @embbeded_in_ai_flow %>
          <h1 class="user-resources-form--title">
            <%= form_title %>
          </h1>

          <div class="user-resources-form--description js-user-resource-form-description">
            <%= projekt_phase&.resource_form_intro&.html_safe.presence ||
              helpers.render_custom_block("user_resource_form_#{resource.class.name.downcase}", default_content: t("custom.user_resources.form.page_description")) %>
          </div>
        <% end %>

        <div class="js-user-resource-form-errors">
          <%= render "shared/errors", resource: resource %>
        </div>

        <% if params[:origin].present? %>
          <%= hidden_field_tag :origin, params[:origin] %>
        <% end %>
      </div>
    </div>

    <div class="flex-layout">
      <div class="main-column">
        <% if projekt_phase.present? %>
          <%= f.hidden_field :projekt_phase_id, value: projekt_phase.id %>
        <% end %>

        <%# Frontend resources are authored in the default locale only. Forcing
            I18n.locale here makes visible_locales resolve to [default], so the
            single field-set is shown, saved, and the image renders once —
            without touching the general translatable_fields/visible_locales. %>
        <% I18n.with_locale(I18n.default_locale) do %>
        <%= f.translatable_fields do |translations_form| %>
          <div class="js-suggest" data-locale="<%= translations_form.locale %>"></div>

          <div class="user-resources-form--banner-editor <%= banner_class_name %>">
              <div class="user-resources-form--title-wrapper">
                <%= translations_form.text_area :title,
                  maxlength: title_max_length,
                  data: suggest_data(resource),
                  label: false,
                  class: "user-resources-form--banner-editor-title js-user-resource-form-title",
                  placeholder: title_placeholder,
                  autocomplete: "off" %>
              </div>

              <% if show_image_input? %>
                <div class="banner-editor-image-attachment">
                  <% f.object.build_image if f.object.image.nil? %>
                  <%= f.fields_for :image do |image_builder| %>
                    <%= render UserResources::ImageUploadComponent.new(image_builder, imageable: f.object) %>
                  <div class="image-upload-meta-row">
                    <%= render Images::AiGeneratedFieldComponent.new(image_builder) %>
                    <%= image_builder.text_field :credits, label: false, placeholder: t("custom.user_resources.image_upload.credits_field_placeholder"), class: "light-input image-upload-credits-input" %>
                  </div>
                  <% end %>
                </div>
              <% end %>
          </div>
          <%= translations_form.text_area :description,
            value: AdminWYSIWYGSanitizer.new.sanitize(resource.description),
            label: false,
            placeholder: description_placeholder,
            class: "html-area #{helpers.ck_editor_class(current_user)} js-user-resource-form-description" %>
        <% end %>
        <% end %>

        <% if show_labels_selector? || show_sentiments_selector? || show_idea_category_selector? || show_map_input? %>
          <div class="new-card" id='map-container'>
            <% if show_labels_selector? %>
              <div class="margin-bottom">
                <%= render partial: "shared/user_resources_form/projekt_labels", locals: { f: f, projekt_phase: projekt_phase, model: resource } %>
              </div>
            <% end %>

            <% if show_sentiments_selector? %>
              <div class="margin-bottom">
                <%= render partial: "shared/user_resources_form/sentiments", locals: { f: f, projekt_phase: projekt_phase, model: resource } %>
              </div>
            <% end %>

            <% if show_idea_category_selector? %>
              <div class="margin-bottom">
                <%= render partial: "custom/shared/user_resources_form/idea_category", locals: { f: f } %>
              </div>
            <% end %>

            <% if show_map_input? %>
              <h2 class="rich-form-label">
                <i class="fas fa-map"></i>
                <%= t("custom.user_resources.form.map_location_label") %>
                <span class="small" style="margin-left:0.25rem;margin-right:0.25rem">|</span>
                <span class="small"><%= t("custom.user_resources.form.map_location_instructions_optional") %></span>
              </h2>

              <%= render "map_locations/form_fields",
                form:            f,
                mappable:        resource,
                nesting_prefix: "proposals" %>
            <% end %>
          </div>
        <% end %>

        <div class="js-remove-on-desktop-section hide-on-desktop">
          <%= sidebar_html %>
        </div>

        <% unless @embbeded_in_ai_flow %>
        <div class="user-resources-form--submit-section">
          <% if resource.new_record? %>
            <h3 class="user-resources-form--submit-section--privacy-policy">
              <%= t("custom.user_resources.form.privacy_policy_heading") %>
            </h3>

            <div>
              <%= f.check_box :resource_terms,
                title: t("custom.terms.resource_terms.title"),
                label: t("custom.terms.resource_terms.label",
                         privacy_link: link_to(
                           t("custom.terms.privacy_link.text"), "/privacy",
                           title: t("shared.target_blank"),
                           target: "_blank"
                         ),
                         terms_link: link_to(
                           t("custom.terms.terms_link.text"),
                           "/conditions",
                           title: t("shared.target_blank"),
                           target: "_blank"
                         )
                        ) %>
            </div>

          <% end %>
          <% if !similar_contributions_check_running? %>
            <%= f.submit(t("custom.user_resources.form.submit_button"),
                         class: "button js-user-resource-submit") %>
          <% end %>

          <%= render ::SimilarContributions::ProgressComponent.new(resource) %>
          <%= render ::SimilarContributions::DecisionComponent.new(resource) %>
        </div>
        <% end %>
      </div>

      <div class="js-remove-on-mobile-section hide-on-mobile">
        <%= sidebar_html %>
      </div>
    </div>

  <% end %>
</main>
