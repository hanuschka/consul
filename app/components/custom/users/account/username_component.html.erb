<div id="username">
  <% if @show_form %>
    <%= form_for @user, url: update_username_account_path, remote: true, authenticity_token: true do |f| %>
      <div>
        <%= f.text_field :username,
                         label: t("custom.account.show.username_label"),
                         label_options: { class: "show-for-sr" },
                         style: "display:inline-block;",
                         "aria-required": true %>
      </div>
      <%= f.hidden_field :cancel_changes, value: false %>
      <%= f.submit "Save", class: "d-none" %>

      <button
        type="button"
        class="account-username-form-control"
        aria-label="<%= t("custom.accessibility.account.edit_username.cancel_button") %>"
        onclick="$('#user_cancel_changes').val('true');$(this.closest('form')).trigger('submit.rails')"
      >
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>

      <button
        type="button"
        class="account-username-form-control"
        aria-label="<%= t("custom.accessibility.account.edit_username.save_button") %>"
        onclick="$(this.closest('form')).trigger('submit.rails')"
      >
        <i class="fas fa-check" aria-hidden="true"></i>
      </button>

    <% end %>
  <% else %>
    <%= @user.name %>
    <% if @edit_mode && @user == current_user %>
      <div style="display:inline-block;">
        <div class="users-profile-banner--edit-button">
          <%= link_to edit_username_account_path, remote: true, role: "button", "aria-label": t("custom.accessibility.account.edit_username.edit_button") do %>
            <i class="fa fa-pencil-alt" aria-hidden="true"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
