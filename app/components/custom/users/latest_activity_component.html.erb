<div id="latest-activity">
  <%= render Resources::List::BaseComponent.new(
    title: title,
    empty_text: (comments? ? nil : t("empty_list_text"))
  ) do |c| %>
    <% c.with_toolbar(
      i18n_namespace: "custom.welcome.latest_activity",
      filters: valid_filters,
      current_filter: current_filter,
      param: "filter",
      remote_url: "latest_activity",
      hide_view_mode_button: comments?
    ) %>

    <% if comments? %>
      <div class="no-ul-style resources-list--body js-resources-list--body">
        <%= render Comments::UserCommentsComponent.new(comments: resources) %>
      </div>
    <% elsif resources.present? %>
      <% c.with_items do %>
        <% resources.each do |resource| %>
          <%= render helpers.resources_list_item_component(resource) %>
        <% end %>
      <% end %>
    <% end %>

    <% c.with_footer do %>
      <div class="resources-list--bottom-content">
        <%= link_to t("custom.welcome.latest_activity.all_activity_link"), account_path, class: "resources-list--more-link" %>
      </div>
    <% end %>
  <% end %>
</div>
