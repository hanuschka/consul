<div class="new-public-activity">
  <% if valid_access? %>
    <% if valid_filters.any? %>
      <%= render Resources::List::BaseComponent.new(
        title: title,
        empty_text: (comments? ? nil : t("empty_list_text"))
      ) do |c| %>
        <% c.with_toolbar(
          i18n_namespace: "custom.user_page",
          filters: valid_filters,
          current_filter: current_filter,
          param: "filter",
          remote_url: remote_url,
          hide_view_mode_button: comments?
        ) %>

        <% if comments? %>
          <div class="no-ul-style resources-list--body js-resources-list--body">
            <%= render Comments::UserCommentsComponent.new(comments: resources) %>
          </div>
        <% elsif resources.present? %>
          <% c.with_items do %>
            <% resources.each do |resource| %>
              <%= render helpers.resources_list_item_component(resource) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <% unless current_filter == "follows" %>
        <%= paginate resources, remote: true, params: { action: "refresh_activities", filter: current_filter } %>
      <% end %>
    <% else %>
      <div class="callout primary">
        <%= t("users.show.no_activity") %>
      </div>
    <% end %>
  <% else %>
    <div class="callout warning margin">
      <%= t("users.show.private_activity") %>
    </div>
  <% end %>
</div>
