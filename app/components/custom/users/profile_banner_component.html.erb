<div class="new-card -no-padding users-profile-banner">
  <div class="users-profile-banner--background-image">
    <% if @edit_mode && @user == current_user %>
      <%= form_for @user, as: :account, remote: true, authenticity_token: true, url: account_path do |f| %>
        <%= render Images::DropzoneComponent.new(f, attachment_name: "background_image", submit_form: true) do |c|%>
          <% c.with_custom_edit_button do %>
            <button type="button" class="users-profile-banner--edit-button users-profile-banner--background-edit-button" aria-label="<%= t("custom.accessibility.account.edit_banner.aria-label") %>">
              <i class="fa fa-pencil-alt" aria-hidden="true"></i>
            </button>
          <% end %>
          <% c.with_placeholder do %>
            <% if @user.background_image.attached? %>
              <%= image_tag(@user.background_image.variant(resize_to_fit: [2000, 500])) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% elsif @user.background_image.attached? %>
      <div class="users-profile-banner--background-image-wrapper">
        <%= image_tag(@user.background_image) %>
      </div>
    <% end %>
  </div>
  <div class="users-profile-banner--avatar-wrapper">
    <% if @edit_mode && @user == current_user %>
      <%= form_for @user, as: :account, remote: true, url: account_path do |f| %>
          <% if f.object.image.blank? %>
            <% f.object.build_image %>
          <% end %>
          <%= f.fields_for :image do |image_builder| %>
            <%= render Images::DirectUploadComponent.new(image_builder, imageable: @user, submit_form: true, variant: :medium, image_alt: t("custom.accessibility.account.edit_avatar.your_avatar")) do |c| %>
              <% c.with_placeholder do %>
                <div
                  class="users-profile-banner--avatar-placeholder"
                  aria-hidden="<%= @user.image.attached? %>"
                  aria-label="<%= t("custom.accessibility.account.edit_avatar.avatar_placeholder") %>"
                >
                  <%= @user.first_letter_of_name %>
                </div>
              <% end %>

              <% c.with_custom_edit_button do %>
                <button type="button" class="users-profile-banner--edit-button users-profile-banner--avatar-edit-button" aria-label="<%= t("custom.accessibility.account.edit_avatar.aria-label") %>">
                  <i class="fa fa-pencil-alt" aria-hidden="true"></i>
                </button>
              <% end %>
            <% end %>
        <% end %>
      <% end %>
    <% elsif @user.image.present? %>
      <div class="users-profile-banner--avatar">
        <%= image_tag(@user.image&.variant(:medium), alt: @user.name) %>
      </div>
    <% else %>
      <div class="users-profile-banner--avatar users-profile-banner--avatar-placeholder" aria-label="<%= t("custom.accessibility.account.edit_avatar.avatar_placeholder") %>">
        <%= @user.first_letter_of_name %>
      </div>
    <% end %>
  </div>
  <div class="users-profile-banner--info">
    <div class="users-profile-banner--name">
      <%= render Users::Account::UsernameComponent.new(user: @user, edit_mode: @edit_mode) %>
    </div>
    <p class="users-profile-banner--info-line">
      <%= t("custom.users.banner.registered_at", date: l(@user.created_at, format: :date_only)) %>
    </p>

    <% if Setting["extra_fields.verification.show_data_completeness_status"].present? %>
      <p class="users-profile-banner--info-line">
        <% if @user.data_complete? %>
          <span class="icon-check"></span>
          <%= t("custom.account.show.data_complete") %>
        <% else %>
          <span class="icon-x"></span>
          <%= t("custom.account.show.data_missing") %>
        <% end %>
      </p>
    <% end %>

    <% if Setting["extra_fields.verification.show_verification_status"].present? %>
      <p class="users-profile-banner--info-line">
        <% if @user.level_three_verified? %>
          <span class="icon-check"></span>
          <%= t("account.show.verified_account") %>
        <% else %>
          <span class="icon-x"></span>
          <%= t("custom.account.show.not_verified_account") %>
        <% end %>
      </p>
    <% end %>

    <%= render Shared::OfficialPositionBadgeComponent.new(user: @user) %>
  </div>
</div>
