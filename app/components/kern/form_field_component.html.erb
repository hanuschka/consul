<div class="kern-form-field mb-5">
  <% if inline %>
    <div class="kern-row">
      <div class="kern-col-12 kern-col-md-5">
        <% if label %>
          <div class="kern-title kern-title--small mb-3 mb-md-0"><%= label %></div>
        <% end %>
        <% if hint %>
          <p class="kern-body kern-body--small mt-2 mb-0"><%= hint %></p>
        <% end %>
      </div>
      <div class="kern-col-12 kern-col-md-5">
        <%= content %>
      </div>
    </div>
  <% elsif stacked %>
    <% if label %>
      <div class="kern-title kern-title--small mb-3"><%= label %></div>
    <% end %>
    <div class="kern-row">
      <div class="kern-col-12 kern-col-md-10">
        <p class="kern-body mb-4"><%= hint %></p>
      </div>
    </div>
    <div class="kern-row">
      <div class="kern-col-12 kern-col-md-10">
        <%= content %>
      </div>
    </div>
  <% else %>
    <% if label %>
      <div class="kern-title kern-title--small mb-3"><%= label %></div>
    <% end %>
    <div class="kern-row">
      <div class="kern-col-12 kern-col-md-5">
        <p class="kern-body mb-3 mb-md-0"><%= hint %></p>
      </div>
      <div class="kern-col-12 kern-col-md-5">
        <%= content %>
      </div>
    </div>
  <% end %>
</div>

<% if divider %>
  <div class="kern-row">
    <div class="kern-col-12 kern-col-md-10">
      <hr class="kern-divider mb-5" aria-hidden="true" />
    </div>
  </div>
<% end %>
