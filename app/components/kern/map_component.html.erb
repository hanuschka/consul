<%= tag.div data: controller_data_attributes do %>

  <% if show_labels? %>
    <div data-feature-style-mode="icon">
      <div class="kern-title kern-title--small mb-2"><%= projekt_phase.projekt_labels_label_text %></div>
      <div class="map-feature-pills">
        <%= mappable_form.collection_check_boxes :projekt_label_ids, projekt_phase.projekt_labels, :id, :name do |cb|
          cb.check_box(style: "display:none") +
          cb.label(
            id: dom_id(cb.object),
            class: "map-feature-pill map-feature-pill--label",
            data: {
              "icon-name" => cb.object.icon,
              "icon-unicode" => AwesomeIcon.find_by(name: cb.object.icon)&.unicode
            }
          ) {
            tag.i(class: "fas fa-#{cb.object.icon}") + " #{cb.text}"
          }
        end %>
      </div>
    </div>
  <% end %>

  <% if show_sentiments? %>
    <div data-feature-style-mode="color">
      <div class="kern-title kern-title--small mb-2"><%= projekt_phase.sentiment_label_text %></div>
      <div class="map-feature-pills">
        <%= mappable_form.collection_radio_buttons :sentiment_id, projekt_phase.sentiments, :id, :name, include_hidden: false do |rb|
          rb.radio_button(style: "display:none") +
          rb.label(
            id: dom_id(rb.object),
            class: "map-feature-pill map-feature-pill--sentiment",
            data: { color: rb.object.color },
            style: "--pill-color:#{rb.object.color};--pill-text-color:#{pick_text_color(rb.object.color)}"
          ) { rb.text }
        end %>
      </div>
    </div>
  <% end %>

  <% if editable && !admin_editor %>
    <div class="kern-title kern-title--small mb-2">
      <%= t("components.adm.map_setting_component.map_label") %>
    </div>
  <% end %>

  <div id="<%= container_id %>"
       class="map_location map <%= map_location.rendering_library %> mb-4"
       style="<%= container_style %>"
       data-map-target="container"
       data-map-location-id="<%= map_location.id %>">
  </div>

  <% if form && editable %>
    <%= form.hidden_field :latitude, data: { map_target: "latitude" } %>
    <%= form.hidden_field :longitude, data: { map_target: "longitude" } %>
    <%= form.hidden_field :altitude, data: { map_target: "altitude" } %>
    <%= form.hidden_field :zoom, data: { map_target: "zoom" } %>
    <%= form.hidden_field :features, value: features_json, data: { map_target: "features" } %>
  <% end %>

  <% if form && admin_editor %>
    <% if map_location.mappable_type == 'Projekt' %>
      <div class="mb-4">
        <%= form.check_box :show_admin_shape, hint: t('.show_admin_shape_hint') %>
      </div>
    <% end %>

    <%= render Kern::FormFieldComponent.new(
      label: t('components.kern.map_component.rendering_library_label'),
      hint: t('components.kern.map_component.rendering_library_description')
    ) do %>
      <%= form.collection_radio_buttons :rendering_library, rendering_library_options, :first, :last,
          {}, { data: { action: "change->map#switchRenderingLibrary" } } %>
    <% end %>
  <% end %>

  <%= content %>
<% end %>
