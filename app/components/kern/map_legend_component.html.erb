<div class="map-legend" aria-label="<%= t(".aria_label") %>">
  <ul class="map-legend--list">
    <li class="map-legend--item">
      <span class="map-legend--marker map-legend--marker--user" aria-hidden="true"></span>
      <span class="map-legend--label"><%= t(".user_pin") %></span>
    </li>
    <li class="map-legend--item">
      <span class="map-legend--marker map-legend--marker--imported" aria-hidden="true"></span>
      <span class="map-legend--label"><%= t(".imported_pin") %></span>
    </li>
  </ul>
</div>
