<div class="position-relative" data-controller="shared--dropdown-menu">
  <%= link_to '#', class: 'round-icon-button kern-table__actions-toggle text-decoration-none px-2', role: "button", data: { action: 'shared--dropdown-menu#toggleMenu', "shared--dropdown-menu-target": 'button', "aria-haspopup": 'true', "aria-expanded": 'false' } do %>
    <span class="material-symbols-outlined" aria-hidden="true">more_vert</span>
  <% end %>
  <div class="kern-table__actions-menu d-flex flex-column d-none" data-shared--dropdown-menu-target="menu">
    <% actions.each do |action| %>
      <%= action %>
    <% end %>
  </div>
</div>
