<%= content_tag :th, scope: "col",
                     class: "kern-table__header",
                     data: { controller: 'table-header', 'table-header-column-value': @column, 'table-header-keep-empty-value': @default.present? || nil, field: @data_field }.compact,
                     aria: { sort: aria_sort } do %>
  <div class="d-flex">
    <span class="mr-3" id="<%= @column %>-label"><%= @label %></span>

    <% if show_sort? %>
      <%= link_to target_url,
                  role: "button",
                  class: "kern-table__header-control",
                  aria: { labelledby: "#{@column}-label" },
                  data: { column: @column } do %>
        <span class="material-symbols-outlined" aria-hidden="true"><%= icon %></span>
      <% end %>
    <% end %>

    <% if show_filter? %>
      <%= link_to "#",
                  role: "button",
                  class: "kern-table__header-control",
                  style: ("color:blue" if filtered?),
                  aria: { labelledby: "#{@column}-label" },
                  data: { action: "table-header#toggleFilterMenu" } do %>
        <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
      <% end %>

      <fieldset class="kern-fieldset kern-table__header-filter-menu d-none" data-table-header-target="filterMenu">
        <legend class="kern-fieldset__legend kern-table__header-filter-legend">
          <%= @label %>
          <button type="button" class="kern-btn kern-btn--tertiary kern-table__header-filter-close" data-action="table-header#toggleFilterMenu">
            <span class="material-symbols-outlined">close</span>
            <span class="sr-only"><%= t("shared.table.filter.close") %></span>
          </button>
        </legend>

        <div class="kern-fieldset__body">
          <% if @search.present? %>
            <div class="kern-form-input">
              <%= text_field_tag "#{@column}__search", params["#{@column}__search"],
                    class: "kern-form-input__input",
                    placeholder: t("shared.table.filter.search_placeholder", column_label: @label),
                    data: { "table-header-target": "searchInput", action: "keydown.enter->table-header#applyFilter" } %>
            </div>
          <% end %>

          <% @filter_options.each do |option| %>
            <div class="kern-form-check">
              <%= check_box_tag @column, option[0], option[0].to_s.in?(filter_param_values), id: "#{@column}_#{option[0]}", class: "kern-form-check__checkbox", data: { action: "change->table-header#selectFilterOption" } %>
              <%= label_tag "#{@column}_#{option[0]}", option[1], class: "kern-label" %>
            </div>
          <% end %>

          <% if @date_range %>
            <div class="kern-form-input">
              <%= label_tag "#{@column}__from", t("shared.table.filter.date_range.from_label"), class: "kern-label" %>
              <%= date_field_tag "#{@column}__from", params["#{@column}__from"],
                    class: "kern-form-input__input",
                    data: { "table-header-target": "dateFromInput", action: "keydown.enter->table-header#applyFilter" } %>
            </div>
            <div class="kern-form-input mt-2">
              <%= label_tag "#{@column}__to", t("shared.table.filter.date_range.to_label"), class: "kern-label" %>
              <%= date_field_tag "#{@column}__to", params["#{@column}__to"],
                    class: "kern-form-input__input",
                    data: { "table-header-target": "dateToInput", action: "keydown.enter->table-header#applyFilter" } %>
            </div>
          <% end %>
        </div>

        <button type="button" class="kern-btn kern-btn--primary kern-btn--small mt-3" data-action="table-header#applyFilter">
          <span class="kern-label"><%= t("shared.table.filter.apply") %></span>
        </button>
      </fieldset>
    <% end %>

  </div>
<% end %>
