<dialog id="<%= id %>" class="<%= css_classes %>">
  <div class="shared-modal--content">
    <% if closeable %>
      <button class="shared-modal--close js-shared-modal-close" type="button" aria-label="Close">
        <i class="fas fa-times"></i>
      </button>
    <% end %>
    <%= content %>
  </div>
</dialog>
