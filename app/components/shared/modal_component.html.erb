<dialog
  id="<%= id %>"
  class="<%= css_classes %>"
  <% if !close_on_backdrop %>data-no-backdrop-close<% end %>
>
  <div class="shared-modal--content">
    <% if closeable %>
      <button class="close-button round-icon-button js-shared-modal-close" type="button" aria-label="Close">
        <i class="fas fa-times"></i>
      </button>
    <% end %>
    <%= content %>
  </div>
</dialog>
