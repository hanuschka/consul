<%= tag.dialog id: id, class: css_classes, data: dialog_data do %>
  <% if content_wrapper %>
    <div class="shared-modal--content">
      <% if closeable %>
        <button class="close-button round-icon-button js-shared-modal-close" type="button" aria-label="Close">
          <i class="fas fa-times"></i>
        </button>
      <% end %>
      <% if title.present? %>
        <div class="modern-modal--header">
          <h3><%= title %></h3>
        </div>
      <% end %>
      <%= content %>
    </div>
  <% else %>
    <%= content %>
  <% end %>
<% end %>
