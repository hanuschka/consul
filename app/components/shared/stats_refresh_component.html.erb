<div class="u-flex u-flex-column u-align-center stats-button-wrapper">
  <div class="js-stats-button-container u-flex u-align-center stats-button-container">
    <button
        class="button js-stats-refresh-button <%= 'u-hidden' if processing? %>"
        data-url="<%= refresh_path %>"
        data-status-check-url="<%= status_path %>"
        data-section="<%= section %>"
        >
        <%= t(button_text) %>
    </button>

    <div
        class="js-stats-status stats-button-status <%= 'u-hidden' unless processing? %>"
        data-status-check-url="<%= status_path %>"
        data-section="<%= section %>"
        >
        <%= render Shared::LoadingSpinnerComponent.new(
          message: t(processing_text),
          size: "small"
        ) %>
    </div>
  </div>

  <div class="stats-last-updated-container">
    <p class="stats-last-updated-item <%= 'u-hidden' if last_updated_at.blank? %>">
    <%= t(last_updated_text) %>
    <span class="js-stat-last-updated-time">
      <% if last_updated_at.present? %>
        <%= l(last_updated_at, format: :short) %>
      <% end %>
    </span>
    </p>
  </div>
</div>

