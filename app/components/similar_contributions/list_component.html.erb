<section class="similar-contributions-list">
  <h2 class="similar-contributions-list--title"><%= t(".title") %></h2>

  <% if matches.empty? %>
    <p class="similar-contributions-list--empty"><%= t(".empty") %></p>
  <% else %>
    <ul class="similar-contributions-list--items">
      <% matches.each do |match| %>
        <li class="similar-contributions-list--item">
          <h3 class="similar-contributions-list--item-title">
            <%= link_to match.resource.title, path_for(match.resource), target: "_blank",
                  data: { turbo: false }, title: t("shared.target_blank") %>
          </h3>

          <p class="similar-contributions-list--item-meta">
            <%= phase_title_for(match.resource) %>
            &middot;
            <%= processing_status_for(match.resource) %>
          </p>

          <% answer_excerpt = answer_excerpt_for(match.resource) %>
          <% if answer_excerpt.present? %>
            <blockquote class="similar-contributions-list--item-answer"><%= answer_excerpt %></blockquote>
          <% else %>
            <p class="similar-contributions-list--item-no-answer"><%= t(".no_answer") %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
