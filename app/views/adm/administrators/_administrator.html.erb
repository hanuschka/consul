<tr class="kern-table__row" id="<%= dom_id(administrator) %>">
  <th scope="row" class="kern-table__header"><%= administrator.id %></th>
  <td class="kern-table__cell"><%= administrator.name %></td>
  <td class="kern-table__cell"><%= administrator.email %></td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t("shared.delete"), url: adm_administrator_path(administrator), icon: "delete", style: :delete, show: current_user.id != administrator.user_id, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
    <% end %>
  </td>
</tr>
