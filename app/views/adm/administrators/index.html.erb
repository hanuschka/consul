<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= render Adm::SearchComponent.new(url: search_adm_administrators_path, label: t(".search")) %>

  <% if @administrators.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table" data-controller="table"
                                data-table-sort-by-value="<%= params[:sort_by] %>"
                                data-table-sort-direction-value="<%= params[:sort_direction] %>"
                                >
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t('shared.table.id') %></th>
            <th scope="col" class="kern-table__header" data-column='name'><%= Administrator.human_attribute_name(:name) %></th>
            <th scope="col" class="kern-table__header" data-column='email'><%= Administrator.human_attribute_name(:email) %></th>
            <th scope="col" class="kern-table__header"><%= t('shared.table.actions') %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body" id="administrators">
          <%= render @administrators %>
        </tbody>
      </table>

      <div class="my-5">
        <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
      </div>
    </div>
  <% else %>
    <div class="callout primary margin">
      <%= t("admin.administrators.index.no_administrators") %>
    </div>
  <% end %>
</div>
