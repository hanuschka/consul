<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <div class="mb-4">
    <%= kern_link_button adm_age_ranges_path(filter: "for_restrictions"), text: t(".filters.for_restrictions"), style: @current_filter == "for_restrictions" ? :primary : :secondary %>
    <%= kern_link_button adm_age_ranges_path(filter: "for_stats"), text: t(".filters.for_stats"), style: @current_filter == "for_stats" ? :primary : :secondary %>
  </div>

  <%= new_resource_link(new_adm_age_range_path, t('.new_age_range')) %>

  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t('.table.name') %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.range') %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
          <th scope="col" class="kern-table__header"></th>
        </tr>
      </thead>

      <tbody class="kern-table__body" data-controller="sortable" data-sortable-url-value="<%= reorder_adm_age_ranges_path %>">
        <% @age_ranges.each do |age_range| %>
          <tr id="<%= dom_id(age_range) %>" class="kern-table__row" data-sortable-id="<%= age_range.id %>">
            <td scope="row" class="kern-table__header"><%= age_range.name %></td>
            <td class="kern-table__cell"><%= "#{age_range.min_age} - #{age_range.max_age}" %></td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(label: t('.table.edit'), url: edit_adm_age_range_path(age_range)) %>
                <% actions.with_action(
                  label: t('.table.delete'),
                  url: adm_age_range_path(age_range),
                  data: { turbo_method: :delete, turbo_confirm: t('.table.delete_confirm') }
                ) %>
              <% end %>
            </td>
            <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
              <span class="material-symbols-outlined">drag_indicator</span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="my-5">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
