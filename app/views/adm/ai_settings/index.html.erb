<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, compact: true) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro") %></p>
  <% end %>
<% end %>

<div class="kern-container">
  <% if !ai_feature_enabled? %>
    <%= empty_state(
          title: t("adm.ai_settings.warnings.feature_disabled.title"),
          description: t("adm.ai_settings.warnings.feature_disabled.body"),
          icon: "power_settings_new"
        ) %>
  <% else %>
    <% if default_llm_model_in_use? %>
      <div class="mb-3">
        <%= kern_alert(title: t("adm.ai_settings.index.default_model_info.title"), style: :info) do %>
          <p class="kern-body"><%= t("adm.ai_settings.index.default_model_info.body_html", model: content_tag(:strong, effective_llm_model)) %></p>
        <% end %>
      </div>
    <% end %>

    <% if endpoint_without_custom_model? %>
      <div class="mb-3">
        <%= kern_alert(title: t("adm.ai_settings.warnings.custom_model_required.title"), style: :warning) do %>
          <p class="kern-body"><%= t("adm.ai_settings.warnings.custom_model_required.body") %></p>
        <% end %>
      </div>
    <% end %>

    <% if highlight_api_key? %>
      <div class="mb-3">
        <%= kern_alert(title: t("adm.ai_settings.warnings.api_key_required.title"), style: :warning) do %>
          <p class="kern-body"><%= t("adm.ai_settings.warnings.api_key_required.body") %></p>
        <% end %>
      </div>
    <% end %>

    <%= render Adm::AiSettings::ResolvedProfileComponent.new %>

    <% if @evaluation_context_setting.present? %>
      <%= render Kern::FormFieldComponent.new(
            label: t("custom.settings.#{@evaluation_context_setting.key}"),
            hint: t("custom.settings.#{@evaluation_context_setting.key}_description"),
            stacked: true
          ) do %>
        <%= render Adm::AiSettings::FormComponent.new(@evaluation_context_setting) %>
      <% end %>
    <% end %>

    <% if @ai_settings.any? %>
      <% @ai_settings.each do |setting| %>
        <% next if setting.key == ::Ai::EvaluationContext::SETTING_KEY %>
        <% next if setting.key == "ai.llm_api_endpoint" && !show_api_endpoint? %>
        <% next if setting.key == "ai.llm_model" && !show_model_field? %>
        <% next if setting.key == "ai.llm_custom_model" && !show_custom_model_field? %>

        <% highlight_custom_model = setting.key == "ai.llm_custom_model" && endpoint_without_custom_model? %>
        <% highlight_model = setting.key == "ai.llm_model" && highlight_llm_model? %>

        <div class="mb-2 <%= "kern-ai-setting--highlight" if highlight_custom_model || highlight_model %>">
          <div class="kern-title kern-title--small mb-3">
            <%= t("custom.settings.#{setting.key}") %>
          </div>
          <div class="kern-row mb-2">
            <div class="kern-col-12 kern-col-md-5">
              <p class="kern-body mb-2 mb-md-0">
                <%= t("custom.settings.#{setting.key}_description", default: t("admin.settings.no_description")) %>
              </p>
            </div>
            <div class="kern-col-12 kern-col-md-5">
              <%= render Adm::AiSettings::FormComponent.new(setting) %>

              <% if highlight_custom_model %>
                <p class="kern-ai-setting--inline-warning" role="alert">
                  <span class="kern-icon kern-icon--warning" aria-hidden="true"></span>
                  <%= t("adm.ai_settings.warnings.custom_model_required.inline") %>
                </p>
              <% elsif highlight_model %>
                <p class="kern-ai-setting--inline-warning" role="alert">
                  <span class="kern-icon kern-icon--warning" aria-hidden="true"></span>
                  <%= t("adm.ai_settings.warnings.model_required.inline") %>
                </p>
              <% end %>
            </div>
          </div>
        </div>

        <div class="kern-row">
          <div class="kern-col-12 kern-col-md-10">
            <hr class="kern-divider mb-3" aria-hidden="true">
          </div>
        </div>
      <% end %>

      <div class="mb-2 <%= "kern-ai-setting--highlight" if highlight_api_key? %>">
        <div class="kern-title kern-title--small mb-3">
          <%= t("custom.settings.ai.llm_api_key") %>
        </div>
        <div class="kern-row">
          <div class="kern-col-12 kern-col-md-5">
            <p class="kern-body mb-3 mb-md-0">
              <%= t("custom.settings.ai.llm_api_key_description") %>
            </p>
          </div>
          <div class="kern-col-12 kern-col-md-5">
            <%= render Adm::AiSettings::ApiKeyComponent.new("api_key", Ai::Settings.current_llm_provider) %>

            <% if highlight_api_key? %>
              <p class="kern-ai-setting--inline-warning" role="alert">
                <span class="kern-icon kern-icon--warning" aria-hidden="true"></span>
                <%= t("adm.ai_settings.warnings.api_key_required.inline") %>
              </p>
            <% elsif default_api_key_in_use? %>
              <p class="kern-ai-setting--inline-info">
                <span class="kern-icon kern-icon--info" aria-hidden="true"></span>
                <%= t("adm.ai_settings.index.default_api_key_info") %>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <%= empty_state(title: t(".no_settings"), icon: "smart_toy") %>
    <% end %>
  <% end %>
</div>
