<% service_user = @api_client.user || User.new %>
<% service_user_error_messages = service_user.errors.full_messages %>

<%= form_with model: [:adm, @api_client], multipart: true, data: { controller: "shared--visibility-toggle" } do |f| %>
  <% if @api_client.errors.any? || service_user_error_messages.any? %>
    <div class="kern-alert kern-alert--danger mb-4" role="alert">
      <div class="kern-alert__body">
        <ul class="mb-0">
          <% (@api_client.errors.full_messages + service_user_error_messages).each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: ApiClient.human_attribute_name(:name), hint: t("adm.api_clients.form.name_description")) do %>
    <%= f.text_field :name, label: false, placeholder: ApiClient.human_attribute_name(:name) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(
    label: ApiClient.human_attribute_name(:access_level),
    hint: t("adm.api_clients.form.access_level_description")
  ) do %>
    <%= f.select :access_level,
      options_for_select(
        ApiClient.access_levels.keys.map { |level| [t("adm.api_clients.access_level.#{level}"), level] },
        @api_client.access_level
      ),
      {},
      { label: false } %>
  <% end %>

  <div class="mb-4">
    <%= render Kern::SwitchComponent.new(
      name: "api_client[use_system_user]",
      id: "api_client_use_system_user",
      checked: @api_client.use_system_user,
      label: t("adm.api_clients.form.use_system_user_label"),
      description: t("adm.api_clients.form.use_system_user_description"),
      input_data: {
        "shared--visibility-toggle-target" => "source",
        action: "change->shared--visibility-toggle#toggle"
      }
    ) %>
  </div>

  <div class="mb-4" data-shared--visibility-toggle-target="shown">
    <%= render Adm::SystemUserInfoComponent.new(user: User.system) %>

    <div class="kern-hint mt-2">
      <p class="mb-0 fs-2"><%= t("adm.api_clients.form.system_user_note") %></p>
    </div>
  </div>

  <div data-shared--visibility-toggle-target="hidden">
    <%= render Kern::FormFieldComponent.new(
      label: ApiClient.human_attribute_name(:service_user_email),
      hint: t("adm.api_clients.form.service_user_email_description")
    ) do %>
      <%= f.email_field :service_user_email, label: false, placeholder: ApiClient.human_attribute_name(:service_user_email) %>
    <% end %>

    <h4 class="mb-2"><%= t("adm.api_clients.form.service_user_section_title") %></h4>

    <div class="kern-hint mb-3">
      <p class="mb-0 fs-2"><%= t("adm.api_clients.form.service_user_section_description") %></p>
    </div>

    <%= f.fields_for :user, service_user do |user_fields| %>
      <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:username)) do %>
        <%= user_fields.text_field :username, label: false, placeholder: User.human_attribute_name(:username) %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:first_name)) do %>
        <%= user_fields.text_field :first_name, label: false, placeholder: User.human_attribute_name(:first_name) %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:last_name)) do %>
        <%= user_fields.text_field :last_name, label: false, placeholder: User.human_attribute_name(:last_name) %>
      <% end %>

      <h4 class="mb-3"><%= t("adm.api_clients.form.service_user_avatar_title") %></h4>

      <div class="mb-4">
        <%= render Kern::Form::ImageableImageComponent.new(form: user_fields, show_actions: false) %>
      </div>

      <h4 class="mb-3"><%= t("adm.api_clients.form.service_user_background_image_title") %></h4>

      <div class="mb-4">
        <%= render Kern::Form::ImageComponent.new(form: user_fields, attribute: :background_image, show_actions: false) %>
      </div>
    <% end %>
  </div>

  <%= form_submit_button(text: f.object.new_record? ? t("shared.create") : t("shared.submit")) %>
<% end %>
