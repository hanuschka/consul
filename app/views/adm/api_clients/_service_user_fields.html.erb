<%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:username)) do %>
  <%= form.text_field :username, label: false, placeholder: User.human_attribute_name(:username) %>
<% end %>

<%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:first_name)) do %>
  <%= form.text_field :first_name, label: false, placeholder: User.human_attribute_name(:first_name) %>
<% end %>

<%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:last_name)) do %>
  <%= form.text_field :last_name, label: false, placeholder: User.human_attribute_name(:last_name) %>
<% end %>

<h4 class="mb-3"><%= t("adm.api_clients.form.service_user_avatar_title") %></h4>

<div class="mb-4">
  <%= render Kern::Form::ImageableImageComponent.new(form: form, show_actions: false) %>
</div>

<h4 class="mb-3"><%= t("adm.api_clients.form.service_user_background_image_title") %></h4>

<div class="mb-4">
  <%= render Kern::Form::ImageComponent.new(form: form, attribute: :background_image, show_actions: false) %>
</div>
