<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(
  title: t(".title"),
  breadcrumbs: @breadcrumbs,
  back_button_url: adm_api_clients_path,
  narrow: true
) %>

<div class="kern-container my-5">
  <%= render "form" %>

  <% if @api_client.user.present? %>
    <hr class="kern-divider my-5" aria-hidden="true">

    <h3 class="mb-3"><%= t("adm.api_clients.form.service_user_form_title") %></h3>

    <div class="kern-alert kern-alert--info mb-4" role="alert">
      <div class="kern-alert__body">
        <p><%= t("adm.api_clients.form.service_user_explanation") %></p>
      </div>
    </div>

    <%= form_with model: @api_client.user, url: update_service_user_adm_api_client_path(@api_client), method: :patch, multipart: true do |f| %>
      <% if @api_client.user.errors.any? %>
        <div class="kern-alert kern-alert--danger mb-4" role="alert">
          <div class="kern-alert__body">
            <p><%= t("adm.api_clients.form.service_user_errors_message", count: @api_client.user.errors.count) %> <%= t("adm.api_clients.form.service_user_errors_title") %></p>
            <ul>
              <% @api_client.user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <h4 class="mb-3"><%= t("adm.api_clients.form.service_user_avatar_title") %></h4>

      <div class="mb-4">
        <%= render Kern::Form::ImageableImageComponent.new(form: f, show_actions: false) %>
      </div>

      <h4 class="mb-3"><%= t("adm.api_clients.form.service_user_background_image_title") %></h4>

      <div class="mb-4">
        <%= render Kern::Form::ImageComponent.new(form: f, attribute: :background_image, show_actions: false) %>
      </div>

      <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:username)) do %>
        <%= f.text_field :username, label: false, placeholder: User.human_attribute_name(:username) %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:first_name)) do %>
        <%= f.text_field :first_name, label: false, placeholder: User.human_attribute_name(:first_name) %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:last_name)) do %>
        <%= f.text_field :last_name, label: false, placeholder: User.human_attribute_name(:last_name) %>
      <% end %>

      <%= form_submit_button(text: t("adm.api_clients.form.update_service_user")) %>
    <% end %>
  <% else %>
    <hr class="kern-divider my-5" aria-hidden="true">

    <h3 class="mb-3"><%= t("adm.api_clients.form.service_user_form_title") %></h3>

    <div class="kern-alert kern-alert--warning mb-4" role="alert">
      <div class="kern-alert__body">
        <p><%= t("adm.api_clients.form.service_user_missing") %></p>
      </div>
    </div>

    <%= button_to create_service_user_adm_api_client_path(@api_client),
      method: :post,
      class: "kern-btn kern-btn--primary" do %>
      <span class="kern-label material-symbols-outlined" aria-hidden="true">person_add</span>
      <span class="kern-label"><%= t("adm.api_clients.form.create_service_user") %></span>
    <% end %>
  <% end %>
</div>
