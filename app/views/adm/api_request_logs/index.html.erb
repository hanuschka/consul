<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, compact: true) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro") %></p>
  <% end %>

  <% if @logs_present %>
    <% header.with_actions do %>
      <%= button_to destroy_all_adm_api_request_logs_path,
        method: :delete,
        class: "kern-btn kern-btn--danger",
        form_class: "ml-auto",
        data: { turbo_confirm: t(".destroy_all_confirm") } do %>
        <span class="kern-label material-symbols-outlined" aria-hidden="true">delete</span>
        <span class="kern-label"><%= t(".destroy_all") %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<div class="kern-container my-2">
  <% if @logs_present %>
    <%= render "filter_bar", live: true %>

    <% if @api_request_logs.any? %>
      <%= render "adm/api_request_logs/table", api_request_logs: @api_request_logs, pagy: @pagy %>
    <% else %>
      <%= empty_state(title: t(".no_results"), icon: "filter_alt_off") %>
    <% end %>
  <% else %>
    <%= empty_state(title: t(".no_logs"), icon: "terminal") %>
  <% end %>
</div>
