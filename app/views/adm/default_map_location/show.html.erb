<%= content_for :title, t(".title") %>

<% if @default_map_location.rendering_library == "virtualcity" %>
  <% provide :vc_maps do %>
    <script id="vcmap-core" type="module" src="/vcmap/vcmap-core.js"></script>
  <% end %>
<% end %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro_text_p1") %></p>
    <p class="adm-hint__text adm-hint__text--spaced"><%= t(".intro_text_p2") %></p>
  <% end %>
<% end %>

<div class="kern-container">

  <%= render Adm::MapSettingComponent.new(
    map_location: @default_map_location,
    path: adm_default_map_location_path
  ) %>

  <%= render "adm/map_layers/map_layers", map_layers: @default_map_location.map_layers %>
</div>
