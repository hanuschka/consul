<tr class="kern-table__row" id="<%= dom_id(deficiency_report_manager) %>">
  <th scope="row" class="kern-table__header"><%= deficiency_report_manager.id %></th>
  <td class="kern-table__cell"><%= deficiency_report_manager.name %></td>
  <td class="kern-table__cell"><%= deficiency_report_manager.email %></td>
  <td class="kern-table__cell">
    <%= link_to t('shared.delete'),
                adm_deficiency_report_manager_path(deficiency_report_manager),
                data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') },
                class: "kern-link" %>
  </td>
</tr>
