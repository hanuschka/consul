<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= new_resource_link(new_adm_deficiency_report_manager_path, t('.new_link')) %>

  <% if @deficiency_report_managers.any? %>
    <%= render 'adm/role_assignments/roles', roles: @deficiency_report_managers, pagy: @pagy %>
  <% else %>
    <div class="callout primary margin">
      <%= t(".no_deficiency_report_managers") %>
    </div>
  <% end %>
</div>
