<% url = @category.persisted? ? adm_deficiency_reports_category_path(@category) : adm_deficiency_reports_categories_path %>
<%= form_with model: @category, url: url do |f| %>

  <%= render Kern::FormFieldComponent.new(label: t(".name_label"), hint: t(".name_hint")) do %>
    <%= f.text_field :name, label: false, placeholder: t(".name_label") %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".ai_hint_label"), hint: t(".ai_hint_hint")) do %>
    <%= f.text_area :ai_hint, label: false, rows: 3, placeholder: t(".ai_hint_placeholder") %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".color_label"), hint: t(".color_hint")) do %>
    <div data-controller="adm-color-picker">
      <div class="color-picker" data-adm-color-picker-target="picker"></div>
      <%= f.hidden_field :color, value: @category.color.presence || "#3366CC", data: { "adm-color-picker-target": "colorInput" } %>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".icon_label"), hint: t(".icon_hint")) do %>
    <div class="icon-selector">
      <% Iconable::AVAILABLE_ICONS.each do |icon_array| %>
        <% icon = icon_array.first %>
        <label class="icon-option">
          <%= f.radio_button :icon, icon, checked: @category.icon == icon %>
          <i class="fas fa-<%= icon %>"></i>
        </label>
      <% end %>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".default_responsible_label"), hint: t(".default_responsible_hint")) do %>
    <% assignable_officers = deficiency_report_assignable_officers(@category.default_responsible) %>
    <% grouped_options = {
      t(".officer_groups") => DeficiencyReport::OfficerGroup.all.order(:name).map { |g| [g.name, "OfficerGroup:#{g.id}"] }
    } %>
    <% if assignable_officers.any? %>
      <% grouped_options[t(".officers")] = assignable_officers.map { |o| [o.name, "Officer:#{o.id}"] } %>
    <% end %>
    <% selected = if @category.default_responsible.is_a?(DeficiencyReport::OfficerGroup)
                    "OfficerGroup:#{@category.default_responsible.id}"
                  elsif @category.default_responsible.is_a?(DeficiencyReport::Officer)
                    "Officer:#{@category.default_responsible.id}"
                  end %>
    <div class="kern-form-input">
      <%= select_tag :default_responsible,
        grouped_options_for_select(grouped_options, selected),
        include_blank: t(".no_responsible"),
        class: "kern-form-input__input" %>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".ai_fallback_label"), hint: t(".ai_fallback_hint")) do %>
    <%= f.check_box :ai_fallback, label: false %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".warning_text_label"), hint: t(".warning_text_hint"), stacked: true) do %>
    <%= f.rich_text_area :warning_text, label: false %>
  <% end %>

  <%= form_submit_button(text: f.object.new_record? ? t("shared.create") : t(".submit")) %>
<% end %>
