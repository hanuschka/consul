<% url = @category.persisted? ? adm_deficiency_reports_category_path(@category) : adm_deficiency_reports_categories_path %>
<%= form_with model: @category, url: url do |f| %>

  <%= render Kern::FormFieldComponent.new(label: t(".name_label"), hint: t(".name_hint")) do %>
    <%= f.text_field :name, label: false, placeholder: t(".name_label") %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".color_label"), hint: t(".color_hint")) do %>
    <div data-controller="adm-color-picker">
      <div class="color-picker" data-adm-color-picker-target="picker"></div>
      <%= f.hidden_field :color, data: { "adm-color-picker-target": "colorInput" } %>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".icon_label"), hint: t(".icon_hint")) do %>
    <div class="icon-selector">
      <% Iconable::AVAILABLE_ICONS.each do |icon_array| %>
        <% icon = icon_array.first %>
        <label class="icon-option">
          <%= f.radio_button :icon, icon, checked: @category.icon == icon %>
          <i class="fas fa-<%= icon %>"></i>
        </label>
      <% end %>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".default_responsible_label"), hint: t(".default_responsible_hint")) do %>
    <div class="mb-2">
      <strong class="kern-body kern-body--small"><%= t(".officer_groups") %></strong>
      <% DeficiencyReport::OfficerGroup.all.order(:name).each do |group| %>
        <div>
          <%= f.radio_button :default_officer_group_id, group.id,
            checked: @category.default_officer_group_id == group.id,
            onclick: "document.querySelectorAll('input[name=\"deficiency_report_category[default_officer_id]\"]').forEach(r => r.checked = false)" %>
          <%= f.label "default_officer_group_id_#{group.id}", group.name %>
        </div>
      <% end %>
    </div>

    <div class="mb-2">
      <strong class="kern-body kern-body--small"><%= t(".officers") %></strong>
      <% DeficiencyReport::Officer.all.each do |officer| %>
        <div>
          <%= f.radio_button :default_officer_id, officer.id,
            checked: @category.default_officer_id == officer.id,
            onclick: "document.querySelectorAll('input[name=\"deficiency_report_category[default_officer_group_id]\"]').forEach(r => r.checked = false)" %>
          <%= f.label "default_officer_id_#{officer.id}", officer.name %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form_submit_button(text: t(".submit")) %>
<% end %>
