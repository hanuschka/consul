<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_deficiency_reports_category_path, t(".new_category")) %>

  <% if @categories.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"></th>
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.color") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.icon") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.default_responsible") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.subcategories") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.warning_text") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body" data-controller="sortable" data-sortable-url-value="<%= order_categories_adm_deficiency_reports_categories_path %>">
          <% @categories.each do |category| %>
            <tr id="<%= dom_id(category) %>" class="kern-table__row" data-sortable-id="<%= category.id %>">
              <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
                <span class="material-symbols-outlined" aria-hidden="true">drag_indicator</span>
              </td>
              <th scope="row" class="kern-table__header"><%= category.name %></th>
              <td class="kern-table__cell">
                <% if category.color.present? %>
                  <span class="color-preview" style="background-color: <%= category.color %>; display: inline-block; width: 20px; height: 20px; border-radius: 4px;"></span>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <% if category.icon.present? %>
                  <i class="fas fa-<%= category.icon %>"></i>
                <% end %>
              </td>
              <td class="kern-table__cell"><%= category.default_responsible&.name %></td>
              <td class="kern-table__cell">
                <%= link_to t(".subcategories_link", count: category.subcategories.size),
                      adm_deficiency_reports_category_subcategories_path(category), class: "kern-link" %>
              </td>
              <td class="kern-table__cell"><%= truncate(strip_tags(category.warning_text), length: 50) %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_deficiency_reports_category_path(category)) %>
                  <% actions.with_action(label: t(".manage_subcategories"), url: adm_deficiency_reports_category_subcategories_path(category)) %>
                  <% actions.with_action(
                    label: t("shared.delete"),
                    url: adm_deficiency_reports_category_path(category),
                    data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_items_title"), description: t(".no_items_description"), icon: "category") %>
  <% end %>
</div>
