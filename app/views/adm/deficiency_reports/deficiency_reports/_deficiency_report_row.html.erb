<% public_linkable = !deficiency_report.hidden? %>
<tr id="<%= dom_id(deficiency_report) %>" class="kern-table__row">
  <td class="kern-table__cell" data-field="watch">
    <%= render "adm/deficiency_reports/deficiency_reports/watch_toggle", deficiency_report: deficiency_report %>
  </td>
  <td class="kern-table__cell" data-field="id"><%= link_to_if public_linkable, deficiency_report.id, deficiency_report_path(deficiency_report), class: "kern-link", target: "_blank", data: { turbo: false } %></td>
  <td class="kern-table__cell adm-table-thumb-cell" data-field="image">
    <% if public_linkable %>
      <%= link_to deficiency_report_path(deficiency_report),
            class: "adm-table-thumb-link",
            target: "_blank",
            data: { turbo: false },
            title: deficiency_report.title do %>
        <%= render Adm::TableThumbComponent.new(
              image: deficiency_report.image,
              title: deficiency_report.title,
              fallback_icon: deficiency_report.category&.icon,
              fallback_color: deficiency_report.category&.color
            ) %>
      <% end %>
    <% else %>
      <%= render Adm::TableThumbComponent.new(
            image: deficiency_report.image,
            title: deficiency_report.title,
            fallback_icon: deficiency_report.category&.icon,
            fallback_color: deficiency_report.category&.color
          ) %>
    <% end %>
  </td>
  <th scope="row" class="kern-table__header" data-field="title" style="min-width: 250px; width: 250px; max-width: 250px;">
    <%= link_to truncate(deficiency_report.title, length: 25), adm_deficiency_reports_deficiency_report_path(deficiency_report), class: "kern-link", title: deficiency_report.title, data: { turbo_frame: "_top" } %>
  </th>
  <% if Setting["deficiency_reports.admin_acceptance_required"].present? %>
    <td class="kern-table__cell" data-field="admin_accepted">
      <%= render Adm::AttributeEditors::BooleanComponent.new(
        deficiency_report,
        :admin_accepted,
        path: accept_adm_deficiency_reports_deficiency_report_path(deficiency_report),
        disabled: !Adm::DeficiencyReports::DeficiencyReportPolicy.new(current_user, deficiency_report).update?
      ) %>
    </td>
  <% end %>
  <td class="kern-table__cell" data-field="created_at"><%= l(deficiency_report.created_at, format: "%d.%m.%Y") %></td>
  <td class="kern-table__cell" data-field="updated_at"><%= l(deficiency_report.updated_at, format: "%d.%m.%Y") %></td>
  <td class="kern-table__cell" data-field="status_changed_at"><%= l(deficiency_report.status_changed_at, format: "%d.%m.%Y") if deficiency_report.status_changed_at %></td>
  <td class="kern-table__cell" data-field="author"><%= link_to deficiency_report.author.username, user_path(deficiency_report.author), target: "_blank", class: "kern-link" %></td>
  <td class="kern-table__cell" data-field="intake_channel"><%= deficiency_report.intake_channel&.name %></td>
  <td class="kern-table__cell" data-field="status"><%= deficiency_report.status&.title %></td>
  <td class="kern-table__cell" data-field="address"><%= deficiency_report.approximated_address %></td>
  <td class="kern-table__cell" data-field="district"><%= deficiency_report.district&.name %></td>
  <td class="kern-table__cell" data-field="category"><%= deficiency_report.category&.name %></td>
  <td class="kern-table__cell" data-field="subcategory"><%= deficiency_report.subcategory&.name %></td>
  <td class="kern-table__cell" data-field="responsible"><%= deficiency_report.responsible&.name %></td>
  <td class="kern-table__cell" data-field="archived_state">
    <%= t("adm.deficiency_reports.deficiency_reports.index.archived_state.#{deficiency_report.archived_at.present? ? 'archived' : 'active'}") %>
  </td>
  <td class="kern-table__cell" data-field="hidden_state">
    <%= t("adm.deficiency_reports.deficiency_reports.index.hidden_state.#{deficiency_report.hidden_at.present? ? 'hidden' : 'visible'}") %>
  </td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t("adm.deficiency_reports.deficiency_reports.show.view_on_site"), url: deficiency_report_path(deficiency_report), icon: "open_in_new", data: { turbo_frame: "_top" }) %>
      <% actions.with_action(label: t("adm.deficiency_reports.deficiency_reports.tabs.show"), url: adm_deficiency_reports_deficiency_report_path(deficiency_report), icon: "visibility", data: { turbo_frame: "_top" }) %>
      <% actions.with_action(label: t("adm.deficiency_reports.deficiency_reports.tabs.audits"), url: audits_adm_deficiency_reports_deficiency_report_path(deficiency_report), icon: "history", data: { turbo_frame: "_top" }) %>
      <% if deficiency_report.feedback_form.present? %>
        <% actions.with_action(label: t("adm.deficiency_reports.deficiency_reports.tabs.feedback_form"), url: feedback_form_adm_deficiency_reports_deficiency_report_path(deficiency_report), icon: "feedback", data: { turbo_frame: "_top" }) %>
      <% end %>
      <% actions.with_action(
        label: t("shared.delete"),
        url: adm_deficiency_reports_deficiency_report_path(deficiency_report),
        icon: "delete", style: :delete, divider: true,
        data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
      ) %>
    <% end %>
  </td>
</tr>
