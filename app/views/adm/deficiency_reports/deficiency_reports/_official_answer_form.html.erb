<%= turbo_frame_tag dom_id(deficiency_report, :official_answer) do %>
  <%= form_with model: deficiency_report,
        url: update_official_answer_adm_deficiency_reports_deficiency_report_path(deficiency_report),
        multipart: true do |f| %>

    <% templates = DeficiencyReport::OfficialAnswerTemplate.all.to_a %>

    <% if DeficiencyReport.separate_reporter_answer? %>
      <% same_public_answer = deficiency_report.public_answer_same_as_reporter? %>
      <div data-controller="adm-deficiency-reports--same-answer"
           data-adm-deficiency-reports--same-answer-reporter-editor-id-value="official_answer_editor_reporter_answer"
           data-adm-deficiency-reports--same-answer-public-editor-id-value="official_answer_editor_official_answer">
        <%= f.check_box :same_public_answer,
              label: t("adm.deficiency_reports.deficiency_reports.show.same_public_answer"),
              checked: same_public_answer,
              data: { adm_deficiency_reports__same_answer_target: "checkbox", action: "change->adm-deficiency-reports--same-answer#toggle" } %>
        <%= render "adm/deficiency_reports/deficiency_reports/official_answer_field",
                   f: f, deficiency_report: deficiency_report, templates: templates, attribute: :reporter_answer,
                   label: t("adm.deficiency_reports.deficiency_reports.show.reporter_answer"),
                   hint: safe_join([
                     tag.span(t("adm.deficiency_reports.deficiency_reports.show.reporter_answer_hint"),
                              hidden: same_public_answer,
                              data: { adm_deficiency_reports__same_answer_target: "privateHint" }),
                     tag.span(t("adm.deficiency_reports.deficiency_reports.show.reporter_answer_public_hint"),
                              hidden: !same_public_answer,
                              data: { adm_deficiency_reports__same_answer_target: "publicHint" })
                   ]) %>
        <%= tag.div hidden: same_public_answer, data: { adm_deficiency_reports__same_answer_target: "publicField" } do %>
          <%= render "adm/deficiency_reports/deficiency_reports/official_answer_field",
                     f: f, deficiency_report: deficiency_report, templates: templates, attribute: :official_answer,
                     label: t("adm.deficiency_reports.deficiency_reports.show.public_answer"),
                     hint: sanitize(t("adm.deficiency_reports.deficiency_reports.show.official_answer_hint")) %>
        <% end %>
      </div>
    <% else %>
      <%= render "adm/deficiency_reports/deficiency_reports/official_answer_field",
                 f: f, deficiency_report: deficiency_report, templates: templates, attribute: :official_answer,
                 label: nil, hint: sanitize(t("adm.deficiency_reports.deficiency_reports.show.official_answer_hint")) %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(
          hint: sanitize(t("adm.deficiency_reports.deficiency_reports.show.official_answer_documents_hint",
                           types: Document.humanized_accepted_content_types,
                           size: Document.max_file_size,
                           count: DeficiencyReport.max_documents_allowed)),
          stacked: true, divider: false) do %>
      <div role="group"
           aria-label="<%= t("adm.deficiency_reports.deficiency_reports.show.official_answer_documents") %>">
        <%= render Kern::Form::AttachmentsComponent.new(
              form: f,
              attribute: :official_answer_documents,
              max: DeficiencyReport.max_documents_allowed,
              accept: Document.accepted_content_types,
              attached: deficiency_report.official_answer_documents,
              remove_path: ->(attachment) {
                remove_official_answer_document_adm_deficiency_reports_deficiency_report_path(
                  deficiency_report, attachment_id: attachment.id
                )
              }) %>
      </div>
    <% end %>

    <%= form_submit_button(autofocus: request.format.turbo_stream?) %>
  <% end %>

  <% if flash[:attachment_alert].present? %>
    <div class="kern-alert kern-alert--danger mt-2" role="alert">
      <div class="kern-alert__header">
        <span class="kern-icon kern-icon--danger" aria-hidden="true"></span>
        <span class="kern-title"><%= flash[:attachment_alert] %></span>
      </div>
    </div>
  <% end %>

  <% if flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove">
      <%= flash[:success] %>
    </div>
  <% end %>
<% end %>
