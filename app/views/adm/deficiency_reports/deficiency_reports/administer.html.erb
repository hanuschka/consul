<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @deficiency_report.title, breadcrumbs: @breadcrumbs, back_button_url: adm_deficiency_reports_root_path) %>

<%= render Adm::TabsComponent.new(tabs: deficiency_report_tabs(@deficiency_report)) %>

<div class="kern-container mb-5">
  <%= render Kern::FormFieldComponent.new(label: t(".status"), hint: t(".status_hint")) do %>
    <%= render "adm/deficiency_reports/deficiency_reports/administer/status", deficiency_report: @deficiency_report %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".responsible"), hint: t(".responsible_hint")) do %>
    <%= render "adm/deficiency_reports/deficiency_reports/administer/responsible", deficiency_report: @deficiency_report %>
  <% end %>
</div>
