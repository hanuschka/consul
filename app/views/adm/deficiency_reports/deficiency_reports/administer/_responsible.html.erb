<%= turbo_frame_tag "administer__responsible" do %>
  <% assignable_officers = deficiency_report_assignable_officers(deficiency_report.responsible) %>
  <% has_officers = assignable_officers.any? || DeficiencyReport::OfficerGroup.any? %>
  <% if has_officers %>
    <%= form_with model: deficiency_report, url: update_administer_adm_deficiency_reports_deficiency_report_path(deficiency_report), method: :patch do |form| %>
      <% grouped_options = {
        t("adm.deficiency_reports.deficiency_reports.administer.officer_groups") => DeficiencyReport::OfficerGroup.all.order(:name).map { |g| [g.name, "OfficerGroup:#{g.id}"] }
      } %>
      <% if assignable_officers.any? %>
        <% grouped_options[t("adm.deficiency_reports.deficiency_reports.administer.officers")] =
             assignable_officers.map { |o| [o.name, "Officer:#{o.id}"] } %>
      <% end %>
      <% selected = if deficiency_report.responsible.is_a?(DeficiencyReport::OfficerGroup)
                      "OfficerGroup:#{deficiency_report.responsible.id}"
                    elsif deficiency_report.responsible.is_a?(DeficiencyReport::Officer)
                      "Officer:#{deficiency_report.responsible.id}"
                    end %>
      <div class="kern-form-input mb-4">
        <%= form.select :responsible,
          grouped_options_for_select(grouped_options, selected),
          { include_blank: t("adm.deficiency_reports.deficiency_reports.administer.no_responsible") },
          { class: "kern-form-input__input", label: false } %>
      </div>
      <%= form_submit_button %>
    <% end %>

    <% if flash[:success].present? %>
      <div class="input-success-message mt-2" data-controller="auto-remove"><%= flash[:success] %></div>
    <% end %>
  <% else %>
    <%= empty_state(title: t("adm.deficiency_reports.deficiency_reports.administer.no_officers_title"), description: t("adm.deficiency_reports.deficiency_reports.administer.no_officers_description"), icon: "person_off") %>
  <% end %>
<% end %>
