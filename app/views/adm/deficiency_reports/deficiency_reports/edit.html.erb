<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @deficiency_report.title, breadcrumbs: @breadcrumbs, back_button_url: adm_deficiency_reports_root_path) %>

<%= render Adm::TabsComponent.new(tabs: deficiency_report_tabs(@deficiency_report)) %>

<article class="kern-container mb-5">
  <%= turbo_frame_tag "deficiency_report_content" do %>
    <%= form_with model: @deficiency_report, url: adm_deficiency_reports_deficiency_report_path(@deficiency_report),
          method: :patch, multipart: true do |form| %>

      <%= render "form_fields", form: form %>

      <div class="d-flex gap-2 mb-4">
        <%= kern_button(text: t("shared.submit"), icon: "save", type: "submit") %>
        <%= kern_link_button(adm_deficiency_reports_deficiency_report_path(@deficiency_report),
              text: t("shared.cancel"), style: :secondary) %>
      </div>
    <% end %>
  <% end %>
</article>
