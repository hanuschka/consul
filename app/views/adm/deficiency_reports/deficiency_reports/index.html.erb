<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <% if @deficiency_reports.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <%= render Kern::Table::HeaderComponent.new(:title, t(".table.title"), **@title_header_options) %>
            <% if Setting["deficiency_reports.admin_acceptance_required"].present? %>
              <th scope="col" class="kern-table__header"><%= t(".table.admin_accepted") %></th>
            <% end %>
            <%= render Kern::Table::HeaderComponent.new(:created_at, t(".table.created_at"), **@created_at_header_options) %>
            <th scope="col" class="kern-table__header"><%= t(".table.author") %></th>
            <%= render Kern::Table::HeaderComponent.new(:deficiency_report_status_id, t(".table.status"), **@status_header_options) %>
            <th scope="col" class="kern-table__header"><%= t(".table.location") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.district") %></th>
            <%= render Kern::Table::HeaderComponent.new(:deficiency_report_category_id, t(".table.category"), **@category_header_options) %>
            <th scope="col" class="kern-table__header"><%= t(".table.responsible") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @deficiency_reports.each do |deficiency_report| %>
            <%= render "deficiency_report_row", deficiency_report: deficiency_report %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="callout primary margin">
      <%= t(".no_deficiency_reports") %>
    </div>
  <% end %>
</div>
