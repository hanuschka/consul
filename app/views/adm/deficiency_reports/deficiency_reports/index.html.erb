<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
  <% if Adm::DeficiencyReports::DeficiencyReportPolicy.new(current_user, nil).new? %>
    <% header.with_actions do %>
      <%= kern_link_button(new_adm_deficiency_reports_deficiency_report_path, text: t(".new_button"), style: :primary, data: { turbo_frame: "_top" }) %>
    <% end %>
  <% end %>
<% end %>

<%
  headers = {
    id:             Kern::Table::HeaderComponent.new(:id, t(".table.id"), **@id_header_options.merge(data_field: "id")),
    title:          Kern::Table::HeaderComponent.new(:title, t(".table.title"), **@title_header_options.merge(data_field: "title")),
    author:         Kern::Table::HeaderComponent.new(:author, t(".table.author"), **@author_header_options.merge(data_field: "author")),
    intake_channel: Kern::Table::HeaderComponent.new(:deficiency_report_intake_channel_id, t(".table.intake_channel"), **@intake_channel_header_options.merge(data_field: "intake_channel")),
    created_at:     Kern::Table::HeaderComponent.new(:created_at, t(".table.created_at"), **@created_at_header_options.merge(data_field: "created_at")),
    updated_at:     Kern::Table::HeaderComponent.new(:updated_at, t(".table.updated_at"), **@updated_at_header_options.merge(data_field: "updated_at")),
    status_changed_at: Kern::Table::HeaderComponent.new(:status_changed_at, t(".table.status_changed_at"), **@status_changed_at_header_options.merge(data_field: "status_changed_at")),
    status:         Kern::Table::HeaderComponent.new(:deficiency_report_status_id, t(".table.status"), **@status_header_options.merge(data_field: "status")),
    address:        Kern::Table::HeaderComponent.new(:approximated_address, t(".table.address"), **@address_header_options.merge(data_field: "address")),
    district:       Kern::Table::HeaderComponent.new(:district, t(".table.district"), **@district_header_options.merge(data_field: "district")),
    category:       Kern::Table::HeaderComponent.new(:deficiency_report_category_id, t(".table.category"), **@category_header_options.merge(data_field: "category")),
    subcategory:    Kern::Table::HeaderComponent.new(:deficiency_report_subcategory_id, t(".table.subcategory"), **@subcategory_header_options.merge(data_field: "subcategory")),
    responsible:    Kern::Table::HeaderComponent.new(:responsible, t(".table.responsible"), **@responsible_header_options.merge(data_field: "responsible")),
    archived_state: Kern::Table::HeaderComponent.new(:archived_state, t(".table.archived_state"), **@archived_state_header_options.merge(data_field: "archived_state")),
    hidden_state:   Kern::Table::HeaderComponent.new(:hidden_state, t(".table.hidden_state"), **@hidden_state_header_options.merge(data_field: "hidden_state"))
  }

  # The bell column doubles as the home of the three-value filter, so the filter sits on the column
  # it actually narrows. Without the visibility setting the column is still there — the bell works
  # regardless — it just carries no filter.
  if assignment_scope_filter?
    headers[:watch] = Kern::Table::HeaderComponent.new(
      :assignment_scope, t(".table.watch"),
      **@assignment_scope_header_options.merge(data_field: "watch")
    )
  end
%>

<div class="kern-container my-5">
  <%= render Adm::IndexTableComponent.new(
        turbo_frame_id: "deficiency_reports_table",
        records: @deficiency_reports,
        pagy: @pagy,
        headers: headers,
        column_count: 18 + (Setting["deficiency_reports.admin_acceptance_required"].present? ? 1 : 0),
        column_selector: {
          storage_key: "adm-deficiency-reports-columns-v2",
          defaults: "watch,id,image,title,created_at,intake_channel,status,responsible,archived_state,hidden_state"
        },
        empty_state: {
          title: t(".no_items_title"),
          description: t(".no_items_description"),
          icon: "report_problem"
        },
        empty_state_filtered: {
          title: t(".no_results_filtered_title"),
          description: t(".no_results_filtered_description"),
          icon: "filter_alt_off"
        }
      ) do |c| %>
    <% c.with_toolbar_action do %>
      <a href="<%= url_for(request.query_parameters.merge(format: :csv)) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        <%= t(".download_csv") %>
      </a>
    <% end %>
    <% c.with_toolbar_action do %>
      <a href="<%= url_for(request.query_parameters.merge(format: :geojson)) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">map</span>
        <%= t(".download_geojson") %>
      </a>
    <% end %>

    <% c.with_header_row do %>
      <% if headers[:watch] %>
        <%= render headers[:watch] %>
      <% else %>
        <th scope="col" class="kern-table__header" data-field="watch"><%= t(".table.watch") %></th>
      <% end %>
      <%= render headers[:id] %>
      <th scope="col" class="kern-table__header" data-field="image"><%= t(".table.image") %></th>
      <%= render headers[:title] %>
      <% if Setting["deficiency_reports.admin_acceptance_required"].present? %>
        <th scope="col" class="kern-table__header" data-field="admin_accepted"><%= t(".table.admin_accepted") %></th>
      <% end %>
      <%= render headers[:created_at] %>
      <%= render headers[:updated_at] %>
      <%= render headers[:status_changed_at] %>
      <%= render headers[:author] %>
      <%= render headers[:intake_channel] %>
      <%= render headers[:status] %>
      <%= render headers[:address] %>
      <%= render headers[:district] %>
      <%= render headers[:category] %>
      <%= render headers[:subcategory] %>
      <%= render headers[:responsible] %>
      <%= render headers[:archived_state] %>
      <%= render headers[:hidden_state] %>
      <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
    <% end %>

    <% c.with_body do %>
      <% @deficiency_reports.each do |deficiency_report| %>
        <%= render "deficiency_report_row", deficiency_report: deficiency_report %>
      <% end %>
    <% end %>
  <% end %>
</div>
