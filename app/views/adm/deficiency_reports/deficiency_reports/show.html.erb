<%= content_for :title, @deficiency_report.title %>

<%= render Adm::HeaderComponent.new(title: @deficiency_report.title, breadcrumbs: @breadcrumbs, back_button_url: adm_deficiency_reports_root_path) %>

<%= render Adm::TabsComponent.new(tabs: deficiency_report_tabs(@deficiency_report)) %>

<div class="kern-container mb-5">

  <%# === Section 1: Meldung === %>
  <section class="adm-detail-section">
    <%= turbo_frame_tag "deficiency_report_content" do %>
      <div class="d-flex align-items-center justify-content-between flex-wrap mb-3">
        <h2 class="adm-detail-section-title m-0"><%= t(".section_content") %></h2>

        <div class="d-flex align-items-center justify-content-end gap-3 mt-1 mb-4">
          <span class="adm-detail-meta__item">
            <%= link_to deficiency_report_path(@deficiency_report), target: "_blank", rel: "noopener" do %>
              <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: text-bottom;" aria-hidden="true">open_in_new</span>
              <%= t(".view_on_site") %>
            <% end %>
          </span>
          <%= kern_link_button(edit_adm_deficiency_reports_deficiency_report_path(@deficiency_report),
                               text: t(".edit"), icon: "edit", style: :secondary, data: { turbo_frame: "deficiency_report_content" })
          %>
          <%= render Adm::DownloadPdfButtonComponent.new(
            url: adm_deficiency_reports_deficiency_report_path(@deficiency_report, format: :pdf),
            map_location: @deficiency_report.map_location,
            map_container_id: dom_id(@deficiency_report, "map")
          ) %>
        </div>
      </div>

      <%# === Title + Description in card === %>
      <div class="adm-content-card mb-4">
        <div class="adm-content-card__body">
          <h3 class="adm-detail-content-title mb-2"><%= @deficiency_report.title %></h3>
          <div class="adm-detail-description">
            <%= auto_link_already_sanitized_html wysiwyg(@deficiency_report.description) %>
          </div>
        </div>
      </div>

      <%# === Image + Map === %>
      <% has_image = @image_url.present? %>
      <% has_map = @deficiency_report.map_location.present? %>

      <% if has_image || has_map %>
        <% original_image_url = has_image ? url_for(@deficiency_report.image.attachment) : nil %>
        <div class="adm-detail-media-grid <%= 'adm-detail-media-grid--two adm-detail-media-grid--no-stretch' if has_image && has_map %> mb-4">
          <% if has_image %>
            <div class="adm-detail-media-card adm-detail-media-card--bounded-image">
              <div class="adm-detail-media-card__label">
                <span class="material-symbols-outlined" aria-hidden="true">image</span>
                <%= t(".image_label") %>
              </div>
              <%= render Shared::ImageWithLightboxComponent.new(
                image_url: url_for(@image_url),
                original_url: original_image_url,
                alt: @deficiency_report.title,
                gallery: "deficiency-report-#{@deficiency_report.id}"
              ) %>
            </div>
          <% end %>

          <% if has_map %>
            <div class="adm-detail-media-card">
              <div class="adm-detail-media-card__label">
                <span class="material-symbols-outlined" aria-hidden="true">map</span>
                <%= t(".map_label") %>
              </div>
              <% pin = @deficiency_report.map_location.pin_coordinates %>
              <%= render Kern::MapComponent.new(
                map_location: @deficiency_report.map_location,
                gesture_handling: false,
                height: 400,
                latitude: pin&.dig(:latitude),
                longitude: pin&.dig(:longitude),
                zoom: pin ? 18 : nil
              ) %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# === Additional Fields Table === %>
      <%
        additional_rows = []

        additional_rows << { label: t(".author"), value: @deficiency_report.author.username }
        additional_rows << { label: t(".created_at"), value: l(@deficiency_report.created_at, format: :long) }

        if @deficiency_report.approximated_address.present?
          additional_rows << { label: t(".address"), value: @deficiency_report.approximated_address }
        end

        if @deficiency_report.on_behalf_of.present?
          additional_rows << { label: t(".on_behalf_of_label"), value: @deficiency_report.on_behalf_of }
        end

        if @deficiency_report.intake_channel.present?
          additional_rows << { label: t(".intake_channel_label"), value: @deficiency_report.intake_channel.name }
        end

        if @deficiency_report.category.present?
          category_html = capture do %>
            <span class="adm-detail-pill" style="background: color-mix(in srgb, <%= @deficiency_report.category.color %> 15%, transparent); color: <%= @deficiency_report.category.color %>;">
              <% if @deficiency_report.category.icon.present? %>
                <i class="fas fa-<%= @deficiency_report.category.icon %>"></i>
              <% end %>
              <%= @deficiency_report.category.name %>
            </span>
          <% end
          additional_rows << { label: t(".category"), value: category_html }
        end

        if @deficiency_report.subcategory.present?
          additional_rows << { label: t(".subcategory"), value: @deficiency_report.subcategory.name }
        end

        if @deficiency_report.documents.any?
          docs_html = capture do %>
            <ul class="mb-0">
              <% @deficiency_report.documents.each do |document| %>
                <li>
                  <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px; vertical-align: text-bottom;">attach_file</span>
                  <%= link_to document.title, document.attachment, target: :blank %>
                </li>
              <% end %>
            </ul>
          <% end
          additional_rows << { label: t(".documents_label"), value: docs_html }
        end

        if @deficiency_report.video_url.present?
          additional_rows << { label: t(".video_url"), value: link_to(@deficiency_report.video_url, @deficiency_report.video_url, target: "_blank", rel: "noopener") }
        end

        if Setting["deficiency_reports.allow_voting"].present?
          additional_rows << { label: t(".votes"), value: @deficiency_report.cached_votes_up }
        end

        if Setting["deficiency_reports.enable_comments"].present?
          additional_rows << { label: t(".comments"), value: @deficiency_report.comments_count }
        end
      %>

      <% if additional_rows.any? %>
        <div class="adm-detail-table">
          <% additional_rows.each do |row| %>
            <div class="adm-detail-table__row">
              <div class="adm-detail-table__label"><%= row[:label] %></div>
              <div class="adm-detail-table__value"><%= row[:value] %></div>
            </div>
          <% end %>
        </div>
      <% end %>

    <% end %>
  </section>

  <%# === Section 2: Verwaltung === %>
  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".section_admin") %></h2>

    <%= render Kern::FormFieldComponent.new(label: t("adm.deficiency_reports.deficiency_reports.administer.status"), hint: t("adm.deficiency_reports.deficiency_reports.administer.status_hint")) do %>
      <%= render "adm/deficiency_reports/deficiency_reports/administer/status", deficiency_report: @deficiency_report %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t("adm.deficiency_reports.deficiency_reports.administer.responsible"), hint: t("adm.deficiency_reports.deficiency_reports.administer.responsible_hint")) do %>
      <%= render "adm/deficiency_reports/deficiency_reports/administer/responsible", deficiency_report: @deficiency_report %>
    <% end %>

    <% if Setting["deficiency_reports.admin_acceptance_required"].present? %>
      <%= render Kern::FormFieldComponent.new(label: t(".admin_accepted_status"), hint: t(".admin_accepted_status_hint")) do %>
        <%= render "admin_accepted_toggle", deficiency_report: @deficiency_report %>
      <% end %>
    <% end %>
  </section>

  <%# === Section 3: Offizielle Antwort === %>
  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".official_answer") %></h2>

    <% if DeficiencyReport::OfficialAnswerTemplate.any? %>
      <%= render Kern::FormFieldComponent.new(label: t(".answer_template_label"), hint: t(".answer_template_hint"), divider: false) do %>
        <div class="kern-form-input">
          <select class="kern-form-input__input"
            onchange="if(this.value) { document.querySelectorAll('.ck-editor__editable').forEach(function(editor) { if(editor.ckeditorInstance) editor.ckeditorInstance.setData(this.value) }.bind(this)) }">
            <option value=""><%= t(".answer_template_prompt") %></option>
            <% DeficiencyReport::OfficialAnswerTemplate.all.each do |template| %>
              <%= content_tag(:option, template.title, value: template.text) %>
            <% end %>
          </select>
        </div>
      <% end %>
    <% end %>

    <%= render Adm::AttributeEditorComponent.new(
      @deficiency_report,
      :official_answer,
      :rich_text,
      path: update_official_answer_adm_deficiency_reports_deficiency_report_path(@deficiency_report),
      label: t(".official_answer"),
      description: t(".official_answer_hint"),
      hide_label: true,
      divider: false
    ) %>
  </section>

  <%# === Section 4: Interne Notizen === %>
  <section class="adm-detail-section">
    <%= render "adm/memos/memos", memoable: @deficiency_report %>
  </section>

</div>
