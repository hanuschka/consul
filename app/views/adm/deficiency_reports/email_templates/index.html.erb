<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <% @email_templates.each do |template| %>
    <%= render Adm::EmailTemplateComponent.new(template) %>
  <% end %>

  <div class="my-5">
    <%= render Adm::AttributeEditorComponent.new(
      SiteCustomization::ContentBlock.custom_block_for(MailerFooterHelper::DEFICIENCY_REPORT_EMAIL_FOOTER_BLOCK, I18n.default_locale),
      :body, :rich_text, wide: true, toolbar: "email"
    ) %>
  </div>
</div>
