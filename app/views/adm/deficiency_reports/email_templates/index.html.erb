<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<%= render "adm/deficiency_reports/email_templates/tabs", current: :templates %>

<div class="kern-container my-5">
  <% @email_template_groups.each do |group, templates| %>
    <div class="mb-5">
      <h2 class="kern-title kern-title--large mb-3"><%= t(".groups.#{group}") %></h2>

      <% templates.each do |template| %>
        <%= render Adm::EmailTemplateComponent.new(template) %>
      <% end %>
    </div>
  <% end %>
</div>
