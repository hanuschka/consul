<%= content_for :title, t("adm.deficiency_reports.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.deficiency_reports.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new do |d| %>
  <% d.with_notice(message: @notice) if @notice.present? %>
  <% d.with_header_row(intro: @intro_text, stats: @stats) %>
  <% d.with_team(members: @team_members, add_url: adm_deficiency_reports_officers_path) %>
  <% d.with_contacts(contacts: @contact_persons) if @contact_persons.any? %>
<% end %>

<div class="kern-container">
  <div class="adm-dashboard__section adm-dashboard__section--pull-up">
    <div class="adm-dashboard__section-header">
      <span class="material-symbols-outlined" aria-hidden="true">report_problem</span>
      <h3><%= t("adm.deficiency_reports.menu.items.deficiency_reports") %></h3>
    </div>

    <%= turbo_frame_tag "deficiency_reports_table", src: adm_deficiency_reports_deficiency_reports_list_path, loading: :eager %>
  </div>

  <%= render Adm::ActivityFeedComponent.new(activities: @activities, pagy: @pagy_activities) %>
</div>
