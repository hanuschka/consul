<%= content_for :title, t("adm.deficiency_reports.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.deficiency_reports.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new(
  team_members: @team_members,
  team_url: adm_deficiency_reports_officers_path,
  recent_items: @recent_items,
  recent_items_url: adm_deficiency_reports_deficiency_reports_list_path,
  recent_item_partial: "adm/deficiency_reports/deficiency_reports/deficiency_report_row",
  recent_item_as: :deficiency_report,
  recent_item_headers: [
    t("adm.deficiency_reports.deficiency_reports.index.table.title"),
    *([ t("adm.deficiency_reports.deficiency_reports.index.table.admin_accepted") ] if Setting["deficiency_reports.admin_acceptance_required"].present?),
    t("adm.deficiency_reports.deficiency_reports.index.table.created_at"),
    t("adm.deficiency_reports.deficiency_reports.index.table.author"),
    t("adm.deficiency_reports.deficiency_reports.index.table.status"),
    t("adm.deficiency_reports.deficiency_reports.index.table.district"),
    t("adm.deficiency_reports.deficiency_reports.index.table.category"),
    t("adm.deficiency_reports.deficiency_reports.index.table.responsible"),
    t("shared.table.actions")
  ],
  intro_text: @section_setting&.intro_text_with_fallback,
  quick_links: @quick_links,
  stats: @stats,
  contact_persons: @contact_persons,
  notice: @section_setting,
  activities: @activities,
  section_settings_path: policy([:adm, :modules]).show? ? adm_modules_path(tab: "deficiency_reports") : nil
) %>
