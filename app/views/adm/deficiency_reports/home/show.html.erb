<%= content_for :title, t("adm.deficiency_reports.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.deficiency_reports.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new(
  team_members: @team_members,
  team_url: adm_deficiency_reports_officers_path,
  recent_items: nil,
  recent_items_url: nil,
  intro_text: @section_setting&.intro_text_with_fallback,
  quick_links: @quick_links,
  stats: @stats,
  contact_persons: @contact_persons,
  notice: @section_setting,
  activities: [],
  section_settings_path: policy([:adm, :modules]).show? ? adm_modules_path(tab: "deficiency_reports") : nil
) %>

<div class="kern-container">
  <div class="adm-dashboard__section">
    <div class="adm-dashboard__section-header">
      <span class="material-symbols-outlined" aria-hidden="true">report_problem</span>
      <h3><%= t("adm.deficiency_reports.menu.items.deficiency_reports") %></h3>
    </div>

    <%= turbo_frame_tag "deficiency_reports_table", src: adm_deficiency_reports_deficiency_reports_list_path, loading: :eager %>
  </div>

  <%= render Adm::ActivityFeedComponent.new(activities: @activities) %>
</div>
