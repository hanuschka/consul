<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_deficiency_reports_intake_channel_path, t(".new_intake_channel")) %>

  <% if @intake_channels.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"></th>
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.default") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body" data-controller="sortable" data-sortable-url-value="<%= order_intake_channels_adm_deficiency_reports_intake_channels_path %>">
          <% @intake_channels.each do |intake_channel| %>
            <tr id="<%= dom_id(intake_channel) %>" class="kern-table__row" data-sortable-id="<%= intake_channel.id %>">
              <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
                <span class="material-symbols-outlined" aria-hidden="true">drag_indicator</span>
              </td>
              <th scope="row" class="kern-table__header"><%= intake_channel.name %></th>
              <td class="kern-table__cell"><%= t("shared.#{intake_channel.default? ? 'yes' : 'no'}") %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_deficiency_reports_intake_channel_path(intake_channel), icon: "edit", style: :edit) %>
                  <% actions.with_action(
                    label: t("shared.delete"),
                    url: adm_deficiency_reports_intake_channel_path(intake_channel),
                    icon: "delete", style: :delete,
                    data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_items_title"), description: t(".no_items_description"), icon: "call_received") %>
  <% end %>
</div>
