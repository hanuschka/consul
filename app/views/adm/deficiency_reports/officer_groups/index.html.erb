<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_deficiency_reports_officer_group_path, t(".new_officer_group")) %>

  <% if @officer_groups.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.officers") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.default_email") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @officer_groups.each do |officer_group| %>
            <tr id="<%= dom_id(officer_group) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= officer_group.name %></th>
              <td class="kern-table__cell"><%= officer_group.officers.map(&:name).join(", ") %></td>
              <td class="kern-table__cell"><%= officer_group.default_email %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_deficiency_reports_officer_group_path(officer_group), icon: "edit", style: :edit) %>
                  <% actions.with_action(
                    label: t("shared.delete"),
                    url: adm_deficiency_reports_officer_group_path(officer_group),
                    icon: "delete", style: :delete,
                    data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_items_title"), description: t(".no_items_description"), icon: "groups") %>
  <% end %>
</div>
