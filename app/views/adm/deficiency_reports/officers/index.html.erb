<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= render Adm::UserSearchComponent.new(
    url: search_adm_deficiency_reports_officers_path,
    label: t(".search_label"),
    description: t(".search_description")
  ) %>

  <div id="search-result" class="my-4"></div>

  <% if @officers.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.email") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @officers.each do |officer| %>
            <%= render "officer", officer: officer %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="callout primary margin">
      <%= t(".no_officers") %>
    </div>
  <% end %>
</div>
