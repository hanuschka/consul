<% url = @official_answer_template.persisted? ? adm_deficiency_reports_official_answer_template_path(@official_answer_template) : adm_deficiency_reports_official_answer_templates_path %>
<%= form_with model: @official_answer_template, url: url do |f| %>

  <%= render Kern::FormFieldComponent.new(label: t(".title_label")) do %>
    <%= f.text_field :title, label: false %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".text_label")) do %>
    <%= f.rich_text_area :text, label: false %>
  <% end %>

  <%= form_submit_button(text: f.object.new_record? ? t("shared.create") : t(".submit")) %>
<% end %>
