<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_deficiency_reports_official_answer_template_path, t(".new_template")) %>

  <% if @official_answer_templates.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.text") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @official_answer_templates.each do |template| %>
            <tr id="<%= dom_id(template) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= template.title %></th>
              <td class="kern-table__cell"><%= truncate(strip_tags(template.text), length: 200) %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_deficiency_reports_official_answer_template_path(template)) %>
                  <% actions.with_action(
                    label: t("shared.delete"),
                    url: adm_deficiency_reports_official_answer_template_path(template),
                    data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t(".no_templates") %></p>
  <% end %>
</div>
