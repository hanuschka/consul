<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<%
  headers = {
    name:       Kern::Table::HeaderComponent.new(:name, t(".table.name"), data_field: "name"),
    schedule:   Kern::Table::HeaderComponent.new(:schedule, t(".table.schedule"), data_field: "schedule"),
    recipients: Kern::Table::HeaderComponent.new(:recipients, t(".table.recipients"), data_field: "recipients"),
    status:     Kern::Table::HeaderComponent.new(:status, t(".table.status"), data_field: "status")
  }
  day_names = t("date.day_names")
%>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_deficiency_reports_report_profile_path, t(".new_report_profile")) %>

  <%= render Adm::IndexTableComponent.new(
        turbo_frame_id: "deficiency_report_report_profiles_table",
        records: @report_profiles,
        headers: headers,
        column_count: 5,
        empty_state: {
          title: t(".no_items_title"),
          description: t(".no_items_description"),
          icon: "summarize"
        }
      ) do |c| %>
    <% c.with_header_row do %>
      <%= render headers[:name] %>
      <%= render headers[:schedule] %>
      <%= render headers[:recipients] %>
      <%= render headers[:status] %>
      <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
    <% end %>

    <% c.with_body do %>
      <% @report_profiles.each do |report_profile| %>
        <% time = format("%02d:00", report_profile.hour) %>
        <tr id="<%= dom_id(report_profile) %>" class="kern-table__row">
          <th scope="row" class="kern-table__header" data-field="name">
            <%= link_to report_profile.name, adm_deficiency_reports_report_profile_path(report_profile),
                        class: "kern-link", data: { turbo_frame: "_top" } %>
          </th>
          <td class="kern-table__cell" data-field="schedule">
            <% if report_profile.weekly? %>
              <%= t(".schedule_weekly", weekday: day_names[report_profile.weekday.to_i], time: time) %>
            <% else %>
              <%= t(".schedule_monthly", day: report_profile.day_of_month, time: time) %>
            <% end %>
          </td>
          <td class="kern-table__cell" data-field="recipients">
            <%= t(".recipients", count: report_profile.recipient_user_ids.size + report_profile.recipient_emails.size) %>
          </td>
          <td class="kern-table__cell" data-field="status">
            <% if report_profile.paused? %>
              <span class="kern-badge kern-badge--warning kern-badge--small"><%= t(".paused") %></span>
            <% else %>
              <span class="kern-badge kern-badge--success kern-badge--small"><%= t(".active") %></span>
            <% end %>
          </td>
          <td class="kern-table__cell">
            <%= render Kern::Table::InlineActionsComponent.new do |actions| %>
              <% actions.with_action(
                label: t(".edit"),
                url: edit_adm_deficiency_reports_report_profile_path(report_profile),
                style: :edit,
                data: { turbo_frame: "_top" }
              ) %>
              <% if report_profile.paused? %>
                <% actions.with_action(
                  label: t(".resume"),
                  url: resume_adm_deficiency_reports_report_profile_path(report_profile),
                  icon: "play_arrow",
                  data: { turbo_method: :patch, turbo_frame: "_top" }
                ) %>
              <% else %>
                <% actions.with_action(
                  label: t(".pause"),
                  url: pause_adm_deficiency_reports_report_profile_path(report_profile),
                  icon: "pause",
                  data: { turbo_method: :patch, turbo_frame: "_top" }
                ) %>
              <% end %>
              <% actions.with_action(
                label: t(".delete"),
                url: adm_deficiency_reports_report_profile_path(report_profile),
                style: :delete,
                data: {
                  turbo_method: :delete,
                  turbo_confirm: t(".delete_confirm", name: report_profile.name),
                  turbo_frame: "_top"
                }
              ) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
</div>
