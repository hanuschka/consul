<%= content_for :title, t("adm.deficiency_reports.settings.title") %>

<%= render Adm::HeaderComponent.new(
  title: t("adm.deficiency_reports.settings.title"),
  breadcrumbs: @breadcrumbs
) %>

<%= render Adm::TabsComponent.new(tabs: [
  {
    label: t("adm.deficiency_reports.settings.tabs.features"),
    url: adm_deficiency_reports_settings_path,
    current: true
  },
  {
    label: t("adm.deficiency_reports.settings.tabs.dashboard"),
    url: dashboard_adm_deficiency_reports_settings_path
  }
]) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.show_in_main_menu"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.admins_must_assign_officer"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.officers_can_edit_assigned_reports"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.allow_voting"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.enable_comments"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.intro_text"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.enable_geoman_controls_in_maps"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.admin_acceptance_required"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.document_upload"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.external_video"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.officers_can_administer_assigned_reports"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.voice_assistant"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.send_feedback_form_link"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "deficiency_reports.show_create_report_button"), :value, :boolean) %>
</div>
