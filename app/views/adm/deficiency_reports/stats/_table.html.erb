<div class="kern-table-responsive mb-5" tabindex="0">
  <table class="kern-table">
    <thead class="kern-table__head">
      <tr class="kern-table__row">
        <th scope="col" class="kern-table__header" style="width:20%"><%= t("adm.deficiency_reports.stats.show.type.#{type}") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.total") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.this_week") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.last_week") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.this_month") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.last_month") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.this_year") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.last_year") %></th>
        <% if type.in? [:category, :responsible] %>
          <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.satisfaction") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.response_time") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.deficiency_reports.stats.show.communication") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody class="kern-table__body">
      <% groups.each do |group| %>
        <tr class="kern-table__row">
          <td class="kern-table__cell"><%= group[0]&.name || t("adm.deficiency_reports.stats.show.without.#{type}") %></td>
          <td class="kern-table__cell"><%= group[1].count %></td>
          <td class="kern-table__cell"><%= group[1].where(created_at: Time.zone.now.beginning_of_week..Time.zone.now.end_of_week).count %></td>
          <td class="kern-table__cell"><%= group[1].where(created_at: Time.zone.now.prev_week.beginning_of_week..Time.zone.now.prev_week.end_of_week).count %></td>
          <td class="kern-table__cell"><%= group[1].where(created_at: Time.zone.now.beginning_of_month..Time.zone.now.end_of_month).count %></td>
          <td class="kern-table__cell"><%= group[1].where(created_at: Time.zone.now.prev_month.beginning_of_month..Time.zone.now.prev_month.end_of_month).count %></td>
          <td class="kern-table__cell"><%= group[1].where(created_at: Time.zone.now.beginning_of_year..Time.zone.now.end_of_year).count %></td>
          <td class="kern-table__cell"><%= group[1].where(created_at: Time.zone.now.prev_year.beginning_of_year..Time.zone.now.prev_year.end_of_year).count %></td>
          <% if type.in? [:category, :responsible] %>
            <td class="kern-table__cell"><%= sanitize "#{group[1].joins(:feedback_form).count} (#{group[1].joins(:feedback_form).average('deficiency_report_feedback_forms.overall_satisfaction').to_s} &#8709;)" %></td>
            <td class="kern-table__cell"><%= sanitize "#{group[1].joins(:feedback_form).count} (#{group[1].joins(:feedback_form).average('deficiency_report_feedback_forms.response_time_satisfaction').to_s} &#8709;)" %></td>
            <td class="kern-table__cell"><%= sanitize "#{group[1].joins(:feedback_form).count} (#{group[1].joins(:feedback_form).average('deficiency_report_feedback_forms.communication_satisfaction').to_s} &#8709;)" %></td>
          <% end %>
        </tr>
      <% end %>
      <tr class="kern-table__row">
        <td class="kern-table__cell"><strong><%= t("adm.deficiency_reports.stats.show.total_row") %></strong></td>
        <td class="kern-table__cell"><%= all_reports.count %></td>
        <td class="kern-table__cell"><%= all_reports.where(created_at: Time.zone.now.beginning_of_week..Time.zone.now.end_of_week).count %></td>
        <td class="kern-table__cell"><%= all_reports.where(created_at: Time.zone.now.prev_week.beginning_of_week..Time.zone.now.prev_week.end_of_week).count %></td>
        <td class="kern-table__cell"><%= all_reports.where(created_at: Time.zone.now.beginning_of_month..Time.zone.now.end_of_month).count %></td>
        <td class="kern-table__cell"><%= all_reports.where(created_at: Time.zone.now.prev_month.beginning_of_month..Time.zone.now.prev_month.end_of_month).count %></td>
        <td class="kern-table__cell"><%= all_reports.where(created_at: Time.zone.now.beginning_of_year..Time.zone.now.end_of_year).count %></td>
        <td class="kern-table__cell"><%= all_reports.where(created_at: Time.zone.now.prev_year.beginning_of_year..Time.zone.now.prev_year.end_of_year).count %></td>
        <% if type.in? [:category, :responsible] %>
          <td class="kern-table__cell"><%= sanitize "#{all_reports.joins(:feedback_form).count} (#{all_reports.joins(:feedback_form).average('deficiency_report_feedback_forms.overall_satisfaction').to_s} &#8709;)" %></td>
          <td class="kern-table__cell"><%= sanitize "#{all_reports.joins(:feedback_form).count} (#{all_reports.joins(:feedback_form).average('deficiency_report_feedback_forms.response_time_satisfaction').to_s} &#8709;)" %></td>
          <td class="kern-table__cell"><%= sanitize "#{all_reports.joins(:feedback_form).count} (#{all_reports.joins(:feedback_form).average('deficiency_report_feedback_forms.communication_satisfaction').to_s} &#8709;)" %></td>
        <% end %>
      </tr>
    </tbody>
  </table>
</div>
