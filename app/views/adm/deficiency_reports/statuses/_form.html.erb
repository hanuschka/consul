<% url = @status.persisted? ? adm_deficiency_reports_status_path(@status) : adm_deficiency_reports_statuses_path %>
<%= form_with model: @status, url: url do |f| %>

  <%= render Kern::FormFieldComponent.new(label: t(".title_label"), hint: t(".title_hint")) do %>
    <%= f.text_field :title, label: false, placeholder: t(".title_label") %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".color_label"), hint: t(".color_hint")) do %>
    <div data-controller="adm-color-picker">
      <div class="color-picker" data-adm-color-picker-target="picker"></div>
      <%= f.hidden_field :color, value: @status.color.presence || "#3366CC", data: { "adm-color-picker-target": "colorInput" } %>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".icon_label"), hint: t(".icon_hint")) do %>
    <div class="icon-selector">
      <% Iconable::AVAILABLE_ICONS.each do |icon_array| %>
        <% icon = icon_array.first %>
        <label class="icon-option">
          <%= f.radio_button :icon, icon, checked: @status.icon == icon %>
          <i class="fas fa-<%= icon %>"></i>
        </label>
      <% end %>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".reminder_delay_label"), hint: t(".reminder_delay_hint")) do %>
    <%= f.number_field :reminder_delay, label: false, placeholder: "0" %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".archive_reports_label"), hint: t(".archive_reports_hint")) do %>
    <%= f.check_box :archive_reports, label: false %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".notice_text_label"), hint: t(".notice_text_hint"), stacked: true) do %>
    <%= f.rich_text_area :notice_text, label: false, toolbar: "regular" %>
  <% end %>

  <%= form_submit_button(text: f.object.new_record? ? t("shared.create") : t(".submit")) %>
<% end %>
