<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_deficiency_reports_status_path, t(".new_status")) %>

  <% if @statuses.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.color") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.icon") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.reminder_delay") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.archive_reports") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body" data-controller="sortable" data-sortable-url-value="<%= order_statuses_adm_deficiency_reports_statuses_path %>">
          <% @statuses.each do |status| %>
            <tr id="<%= dom_id(status) %>" class="kern-table__row" data-sortable-id="<%= status.id %>">
              <th scope="row" class="kern-table__header"><%= status.title %></th>
              <td class="kern-table__cell">
                <% if status.color.present? %>
                  <span class="color-preview" style="background-color: <%= status.color %>; display: inline-block; width: 20px; height: 20px; border-radius: 4px;"></span>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <% if status.icon.present? %>
                  <i class="fas fa-<%= status.icon %>"></i>
                <% end %>
              </td>
              <td class="kern-table__cell"><%= status.reminder_delay %></td>
              <td class="kern-table__cell"><%= t("shared.#{status.archive_reports ? 'yes' : 'no'}") %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_deficiency_reports_status_path(status)) %>
                  <% actions.with_action(
                    label: t("shared.delete"),
                    url: adm_deficiency_reports_status_path(status),
                    data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t(".no_statuses") %></p>
  <% end %>
</div>
