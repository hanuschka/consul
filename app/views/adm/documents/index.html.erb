<%= content_for :title, t("adm.documents.index.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.documents.index.title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro_text_p1") %></p>
    <p class="adm-hint__text adm-hint__text--spaced"><%= t(".intro_text_p2") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">

  <%= new_resource_link(new_adm_document_path, t('.new_document')) %>

  <% if @documents.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t('.table.title') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.format') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.size') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.url') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @documents.each do |document| %>
            <tr id="<%= dom_id(document) %>" class="kern-table__row">
              <td scope="row" class="kern-table__header"><%= document.title %></td>
              <td class="kern-table__cell"><%= document.attachment.content_type.split("/").last.upcase %></td>
              <td class="kern-table__cell"><%= number_to_human_size(document.attachment.byte_size) %></td>
              <td class="kern-table__cell">
                <%= link_to document.title, document.attachment, target: :blank, class: "kern-link p-0" %>
                <br>
                <%= link_to "#", class: "kern-link kern-link--small p-0", onclick: "event.preventDefault();navigator.clipboard.writeText('#{rails_blob_url(document.attachment)}');" do %>
                  <%= t('.table.copy_link') %>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <%= kern_link_button adm_document_path(document),
                      icon: "delete", text: t('.table.delete'),
                      style: :secondary,
                      class: "kern-btn--danger kern-btn--compact",
                      data: { turbo_method: :delete, turbo_confirm: t('.table.delete_confirm') } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(
      title: t(".empty_title"),
      description: t(".empty_description"),
      icon: "description"
    ) %>
  <% end %>
</div>
