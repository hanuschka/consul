<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, back_button_url: adm_documents_path) %>

<div class="kern-container my-5">
  <%= form_with model: [:adm, @document] do |form| %>
    <div class="kern-form-input mb-3">
      <%= form.file_field :attachment,
                          accept: 'application/pdf',
                          class: 'kern-form-input__input' %>
    </div>

    <%= kern_button(icon: "save", text: t(".form.submit"), type: "submit") %>
  <% end %>
</div>
