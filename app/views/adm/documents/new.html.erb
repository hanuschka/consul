<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, back_button_url: adm_documents_path, narrow: true) %>

<div class="kern-container kern-container--form my-5">
  <%= form_with model: [:adm, @document] do |form| %>
    <div class="kern-form-field mb-5">
      <p class="kern-body mb-4"><%= t(".form.hints.attachment") %></p>
      <div class="kern-form-input">
        <%= form.file_field :attachment,
                            label: false,
                            accept: 'application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png',
                            class: 'kern-form-input__input' %>
      </div>
    </div>

    <%= form_submit_button(text: t(".form.submit")) %>
  <% end %>
</div>
