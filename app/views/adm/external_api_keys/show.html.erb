<%= content_for :title, @external_api_key.service.titleize %>

<%= render Adm::HeaderComponent.new(
  title: "#{t("admin.external_api_keys.services.#{@external_api_key.service}", default: @external_api_key.service)} API Key",
  breadcrumbs: @breadcrumbs,
  back_button_url: adm_external_api_keys_path
) %>

<div class="kern-container kern-container--form my-5">
  <div class="d-flex justify-content-end mb-4">
    <%= kern_link_button edit_adm_external_api_key_path(@external_api_key), text: t("adm.shared.edit"), icon: "edit" %>
  </div>

  <div class="kern-card p-4">
    <p class="text-muted mb-3">
      <%= t("admin.external_api_keys.services_description.#{@external_api_key.service}", default: "") %>
    </p>

    <% if @external_api_key.service_link %>
      <p class="mb-3">
        <%= link_to @external_api_key.service_link, @external_api_key.service_link, target: "_blank", rel: "noopener noreferrer" %>
      </p>
    <% end %>

    <p class="mb-3">
      <strong><%= t("adm.external_api_keys.show.key") %></strong><br>
      <code><%= @external_api_key.name %></code>
    </p>

    <% if @external_api_key.value.present? %>
      <p>
        <strong><%= t("adm.external_api_keys.show.api_value") %></strong><br>
        <%= render Admin::HiddenTokenWidgetComponent.new(token: @external_api_key.value) %>
      </p>
    <% else %>
      <%= kern_alert(title: t("adm.external_api_keys.show.default_key_note_title"), style: :info) do %>
        <p><%= t("adm.external_api_keys.show.default_key_note_description") %></p>
      <% end %>
    <% end %>
  </div>
</div>
