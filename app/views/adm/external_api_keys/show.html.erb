<%= content_for :title, @external_api_key.service.titleize %>

<% service_name = t("admin.external_api_keys.services.#{@external_api_key.service}", default: @external_api_key.service) %>

<%= render Adm::HeaderComponent.new(
  title: "#{service_name} API Key",
  breadcrumbs: @breadcrumbs,
  back_button_url: adm_external_api_keys_path,
  compact: true
) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text">
      <%= t("admin.external_api_keys.services_description.#{@external_api_key.service}", default: "") %>
    </p>
    <% if @external_api_key.service_link %>
      <p class="adm-hint__text adm-hint__text--spaced">
        <%= link_to @external_api_key.service_link, @external_api_key.service_link, target: "_blank", rel: "noopener noreferrer" %>
      </p>
    <% end %>
  <% end %>

  <% if @external_api_key.value.present? %>
    <% header.with_actions do %>
      <div class="ml-auto">
        <%= kern_link_button edit_adm_external_api_key_path(@external_api_key), text: t("adm.shared.edit"), icon: "edit" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <% if @external_api_key.value.present? %>
    <div class="kern-card p-4 d-inline-block">
      <strong><%= t("adm.external_api_keys.show.api_value") %></strong>
      <div class="mt-2">
        <%= render Adm::HiddenTokenWidgetComponent.new(token: @external_api_key.value) %>
      </div>
    </div>
  <% else %>
    <%= empty_state(
      title: t("adm.external_api_keys.show.default_key_note_title"),
      description: t("adm.external_api_keys.show.default_key_note_description"),
      icon: "key_off"
    ) %>

    <div class="d-flex justify-content-center mt-4">
      <%= kern_link_button edit_adm_external_api_key_path(@external_api_key), text: t("adm.external_api_keys.show.add_key"), icon: "add" %>
    </div>
  <% end %>
</div>
