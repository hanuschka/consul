<% badge_style = kobil_credential_badge_style(
     configured: kobil_credential_status[:configured],
     required: kobil_credential_status[:required]
   ) %>

<div class="kern-description-list-item">
  <dt class="kern-description-list-item__key">
    <%= t("adm.features.show.kobil_credentials.#{kobil_credential_status[:key]}") %>
  </dt>
  <dd class="kern-description-list-item__value">
    <span class="kern-badge kern-badge--<%= badge_style %>">
      <span class="kern-icon kern-icon--<%= badge_style %>" aria-hidden="true"></span>
      <span class="kern-label">
        <% if kobil_credential_status[:configured] %>
          <%= t("adm.features.show.kobil_credential_configured") %>
        <% elsif kobil_credential_status[:required] %>
          <%= t("adm.features.show.kobil_credential_missing") %>
        <% else %>
          <%= t("adm.features.show.kobil_credential_missing_optional") %>
        <% end %>
      </span>
    </span>
  </dd>
</div>
