<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro_text") %></p>
  <% end %>
<% end %>

<div class="kern-container">
  <section class="mb-5">
    <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_feature.general.enable_google_translate"),  :value, :boolean) %>
    <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_feature.general.show_guest_login_links"),   :value, :boolean) %>
  </section>

  <section class="mb-5">
    <h2 class="kern-title kern-title--small mb-2"><%= t("adm.features.show.kobil_title") %></h2>
    <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "feature.kobil_login"),                :value, :boolean) %>
    <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "feature.kobil_single_logout"),        :value, :boolean) %>
    <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "feature.kobil_address_verification"), :value, :boolean) %>
  </section>
</div>
