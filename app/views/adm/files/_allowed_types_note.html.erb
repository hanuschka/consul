<div class="adm-files-allowed-types text-muted d-flex align-items-center gap-1">
  <span class="icon material-symbols-outlined" aria-hidden="true">info</span>
  <span class="adm-files-allowed-types--lines">
    <%
      settings_edit_path = local_assigns[:settings_edit_path].presence ||
        file_settings_adm_settings_path
      settings_link =
        if local_assigns.fetch(:show_settings_link, false) && current_user&.administrator?
          link_to(t("files.allowed_types_settings_link"),
                  settings_edit_path,
                  class: "adm-files-allowed-types--settings-link",
                  target: "_blank", rel: "noopener")
        end

      max_file_size = local_assigns[:max_file_size]
      max_size_edit_path = local_assigns[:max_size_edit_path]
      max_size_edit_link =
        if max_file_size.present? && max_size_edit_path.present? && current_user&.administrator?
          link_to(t("files.max_file_size_edit_link"),
                  max_size_edit_path,
                  class: "adm-files-allowed-types--settings-link",
                  target: "_blank", rel: "noopener")
        end
    %>

    <% if admin_types == user_types %>
      <span>
        <%= t(local_assigns.fetch(:note_key, "files.allowed_types_note_html"),
              types: tag.span(admin_types, class: "adm-files-allowed-types--type")) %>
        <% if settings_link %>(<%= settings_link %>)<% end %>
      </span>
    <% else %>
      <span><%= t("files.allowed_types_admins_html", types: tag.span(admin_types, class: "adm-files-allowed-types--type")) %></span>
      <span>
        <%= t("files.allowed_types_users_html", types: tag.span(user_types, class: "adm-files-allowed-types--type")) %>
        <% if settings_link %>(<%= settings_link %>)<% end %>
      </span>
    <% end %>

    <% if max_file_size.present? %>
      <span>
        <%= t("files.max_file_size_note_html", size: max_file_size) %>
        <% if max_size_edit_link %>(<%= max_size_edit_link %>)<% end %>
      </span>
    <% end %>
  </span>
</div>
