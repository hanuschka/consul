<%= javascript_include_tag "lib/files/filter_serializer" %>

<span hidden data-files-delete-failed-message="<%= t("files.delete_failed") %>"></span>
<span hidden data-files-delete-success-template="<%= t("files.delete_success_with_name", filename: "__FILENAME__") %>"></span>
<span hidden data-files-delete-failed-template="<%= t("files.delete_failed_with_name", filename: "__FILENAME__") %>"></span>
<span hidden data-files-upload-success-template="<%= t("files.upload_success_with_name", filename: "__FILENAME__") %>"></span>
<span hidden data-files-upload-failed-template="<%= t("files.upload_failed_with_name", filename: "__FILENAME__") %>"></span>

<%= content_for :title, t("files.documents.index.title") %>

<%= render Adm::HeaderComponent.new(
  title: t("files.documents.index.title"),
  breadcrumbs: @breadcrumbs
) do |header| %>
  <% header.with_after_title do %>
    <p class="adm-files-allowed-types text-muted d-flex align-items-center gap-1">
      <span class="material-symbols-outlined" aria-hidden="true">info</span>
      <%= t("files.allowed_types_note", types: Document.humanized_admin_accepted_content_types) %>
    </p>
  <% end %>

  <% header.with_actions do %>
    <div class="ml-auto">
      <%= render Adm::ButtonWithProgressComponent.new(
        label: t("files.card.upload"),
        loading_label: t("files.upload_loading"),
        success_label: t("files.upload_success"),
        icon: "upload",
        button_data: { action: "click->files--upload#triggerPicker" },
        extra_controllers: ["files--upload"],
        extra_root_data: { "files--upload-endpoint-value": "/file_manager/documents" }
      ) do %>
        <input
          type="file"
          class="js-files-upload-input"
          data-files--upload-target="input"
          data-action="change->files--upload#fileChanged"
          hidden
        >
        <span hidden data-files-upload-failed-message="<%= t("files.upload_failed") %>"></span>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="kern-container my-3">
  <%= render Files::IndexComponent.new(
    type: "document",
    assets: @assets,
    endpoint: adm_files_documents_path,
    card_component: Files::DocumentCardComponent,
    row_component: Files::DocumentRowComponent,
    documentable_type_frame_src: documentable_type_filter_adm_files_documents_path(documentable_type: params[:documentable_type])
  ) %>
</div>
