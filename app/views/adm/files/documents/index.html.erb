<%= content_for :title, t("files.documents.index.title") %>

<%= render Adm::FileManager::PageComponent.new(
  type: "document",
  title: t("files.documents.index.title"),
  breadcrumbs: @breadcrumbs,
  assets: @assets,
  endpoint: adm_files_documents_path,
  card_component: Files::DocumentCardComponent,
  row_component: Files::DocumentRowComponent,
  documentable_type_frame_src: documentable_type_filter_adm_files_documents_path(documentable_type: params[:documentable_type]),
  upload_endpoint: file_manager_documents_path,
  detail_path: ->(document) { adm_files_document_path(document) }
) do |page| %>
  <% page.with_description do %>
    <%= t("files.documents.index.description") %>
  <% end %>

  <% page.with_types_note(
       types: Document.humanized_admin_accepted_content_types,
       note_key: "files.allowed_types_note_admin_html"
     ) %>
<% end %>
