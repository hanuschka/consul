<%= content_for :title, t("files.images.index.title") %>

<%= render Adm::FileManager::PageComponent.new(
  type: "picture",
  title: t("files.images.index.title"),
  breadcrumbs: @breadcrumbs,
  assets: @assets,
  endpoint: adm_files_images_path,
  card_component: Files::AssetCardComponent,
  upload_endpoint: ckeditor_pictures_path,
  upload_accept: "image/*",
  detail_path: ->(admin_image) { adm_files_image_path(admin_image) }
) do |page| %>
  <% page.with_description do %>
    <%= t("files.images.index.description") %>
  <% end %>

  <% page.with_types_note(types: AdminImage.humanized_allowed_content_types) %>
<% end %>
