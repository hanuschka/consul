<%= content_for :title, t("adm.homepage.show.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.homepage.show.title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(SiteCustomization::Image.find_or_create_by!(name: "header_image"), :image, :image) %>
  <%= render Adm::AttributeEditorComponent.new(SiteCustomization::Image.find_or_create_by!(name: "mobile_header_image"), :image, :image) %>

  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_option.general.title"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_option.general.subtitle"), :value, :string) %>

  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.usage_stats"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.newsletter_subscription"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.platform_activity"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.projekt_search"), :value, :boolean) %>


  <h2 class="kern-title kern-title--small mb-3"><%= t("adm.homepage.show.content_cards_title") %></h2>
  <p class="kern-body mb-4 mb-md-0">
    <%= t("adm.homepage.show.content_cards_description") %>
  </p>

  <%= render Adm::SiteCustomization::ContentCardsComponent.new %>
</div>
