<tr class="kern-table__row" id="<%= dom_id(idea_manager) %>">
  <th scope="row" class="kern-table__header"><%= idea_manager.id %></th>
  <td class="kern-table__cell"><%= idea_manager.name %></td>
  <td class="kern-table__cell"><%= idea_manager.email %></td>
  <td class="kern-table__cell">
    <%= link_to t('shared.delete'),
                adm_idea_manager_path(idea_manager),
                data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') },
                class: "kern-link" %>
  </td>
</tr>
