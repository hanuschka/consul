<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= new_resource_link(new_adm_idea_manager_path, t('.new_link')) %>

  <% if @idea_managers.any? %>
    <%= render 'adm/role_assignments/roles', roles: @idea_managers, pagy: @pagy %>
  <% else %>
    <%= empty_state(title: t(".empty_title"), description: t(".empty_description"), icon: "lightbulb") %>
  <% end %>

  <%= render partial: "adm/role_assignments/pending_role_assignments", locals: { pending_role_assignments: @pending_role_assignments } %>
</div>
