<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_ideas_category_path, t(".new_category")) %>

  <% if @categories.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.icon") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.color") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.officer") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
            <th scope="col" class="kern-table__header"></th>
          </tr>
        </thead>

        <tbody class="kern-table__body" data-controller="sortable" data-sortable-url-value="<%= order_categories_adm_ideas_categories_path %>">
          <% @categories.each do |category| %>
            <tr id="<%= dom_id(category) %>" class="kern-table__row" data-sortable-id="<%= category.id %>">
              <td class="kern-table__cell">
                <% if category.icon.present? %>
                  <i class="fas fa-<%= category.icon %>" style="color: <%= category.color %>"></i>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <% if category.color.present? %>
                  <span class="inline-block w-6 h-6 rounded" style="background-color: <%= category.color %>"></span>
                  <%= category.color %>
                <% end %>
              </td>
              <td class="kern-table__cell"><%= category.name %></td>
              <td class="kern-table__cell"><%= category.default_idea_officer&.name %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_ideas_category_path(category)) %>
                  <% actions.with_action(
                    label: t("shared.delete"),
                    url: adm_ideas_category_path(category),
                    data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
                  ) %>
                <% end %>
              </td>
              <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
                <span class="material-symbols-outlined">drag_indicator</span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="callout primary margin">
      <%= t(".no_categories") %>
    </div>
  <% end %>
</div>
