<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= link_to t(".back"), adm_ideas_districts_path, class: "kern-link mb-4 inline-block" %>

  <h3 class="text-xl font-bold mb-4"><%= @district.name %></h3>

  <%= form_with model: @district, url: adm_ideas_district_path(@district), method: :put do |f| %>
    <div class="mb-4">
      <%= render Kern::FormFieldComponent.new(label: RegisteredAddress::District.human_attribute_name(:default_idea_officer)) do %>
        <%= f.collection_select :idea_officer_id, Idea::Officer.all, :id, :name,
          { include_blank: t(".no_officer") },
          { class: "kern-select" } %>
      <% end %>
    </div>

    <%= form_submit_button(text: t(".submit")) %>
  <% end %>
</div>
