<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <% if @districts.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= ::RegisteredAddress::District.human_attribute_name(:name) %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.default_officer") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @districts.each do |district| %>
            <tr class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= district.name %></th>
              <td class="kern-table__cell"><%= district.default_idea_officer&.name %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_ideas_district_path(district)) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="callout primary margin">
      <%= t(".no_districts") %>
    </div>
  <% end %>
</div>
