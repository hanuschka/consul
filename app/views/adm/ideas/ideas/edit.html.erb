<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @idea.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: idea_tabs(@idea)) %>

<div class="kern-container mb-5">
  <%= render Adm::AttributeEditorComponent.new(
    @idea,
    :title,
    :string,
    label: t(".labels.title")
  ) %>

  <%= render Adm::AttributeEditorComponent.new(
    @idea,
    :description,
    :rich_text,
    label: t(".labels.description")
  ) %>

  <% if feature?(:allow_images) && @idea.image %>
    <%= render Adm::AttributeEditorComponent.new(
      @idea.image,
      :attachment,
      :image,
      path: update_image_adm_ideas_idea_path(@idea),
      label: t(".labels.image")
    ) %>
  <% end %>

  <% if feature?(:allow_attached_documents) %>
    <%= render Kern::FormFieldComponent.new(label: t(".labels.documents")) do %>
      <%= render "adm/ideas/ideas/edit/documents", idea: @idea %>
    <% end %>
  <% end %>

  <%= render Adm::AttributeEditorComponent.new(
    @idea,
    :video_url,
    :string,
    label: t(".labels.video_url")
  ) %>

  <%= render Kern::FormFieldComponent.new(label: t(".labels.category")) do %>
    <%= render "adm/ideas/ideas/edit/category", idea: @idea %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".labels.map_location")) do %>
    <%= render "adm/ideas/ideas/edit/map_location", idea: @idea, districts: @districts %>
  <% end %>

  <%= render Adm::AttributeEditorComponent.new(
    @idea,
    :on_behalf_of,
    :string,
    label: t(".labels.on_behalf_of")
  ) %>
</div>
