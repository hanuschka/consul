<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @idea.title, breadcrumbs: @breadcrumbs, back_button_url: adm_ideas_root_path) %>

<%= render Adm::TabsComponent.new(tabs: idea_tabs(@idea)) %>

<article class="kern-container mb-5">
  <%= turbo_frame_tag "idea_content" do %>
    <%= form_with model: @idea, url: adm_ideas_idea_path(@idea),
          method: :patch, multipart: true do |form| %>

      <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
        label: t(".labels.title"), hint: t(".labels.title_hint")) do %>
        <%= form.text_field :title, label: false %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
        label: t(".labels.description"), hint: t(".labels.description_hint")) do %>
        <%= form.rich_text_area :description, label: false %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
        label: t(".labels.image"), hint: t(".labels.image_hint")) do %>
        <%= render Kern::Form::ImageableImageComponent.new(form: form) %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
        label: t(".labels.documents"), hint: t(".labels.documents_hint")) do %>
        <%= render Kern::Form::DocumentsComponent.new(form: form) %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
        label: t(".labels.video_url"), hint: t(".labels.video_url_hint")) do %>
        <%= form.text_field :video_url, label: false %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
        label: t(".labels.on_behalf_of"), hint: t(".labels.on_behalf_of_hint")) do %>
        <%= form.text_field :on_behalf_of, label: false %>
      <% end %>

      <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
        label: t(".labels.category"), hint: t(".labels.category_hint")) do %>
        <div data-feature-style-mode="color">
          <div data-feature-style-mode="icon">
            <div class="map-feature-pills">
              <% no_category_id = "idea_idea_category_id_none" %>
              <input type="radio" name="idea[idea_category_id]" value="" id="<%= no_category_id %>"
                style="display:none" <%= "checked" unless @idea.idea_category_id.present? %>>
              <label for="<%= no_category_id %>" class="map-feature-pill map-feature-pill--sentiment">
                <%= t(".no_category") %>
              </label>

              <% Idea::Category.all.each do |category| %>
                <% input_id = "idea_idea_category_id_#{category.id}" %>
                <input type="radio" name="idea[idea_category_id]" value="<%= category.id %>" id="<%= input_id %>"
                  style="display:none" <%= "checked" if @idea.idea_category_id == category.id %>>
                <label for="<%= input_id %>"
                  class="map-feature-pill map-feature-pill--sentiment"
                  data-color="<%= category.color %>"
                  data-icon-name="<%= category.icon %>"
                  data-icon-unicode="<%= AwesomeIcon.find_by(name: category.icon)&.unicode %>"
                  style="--pill-color:<%= category.color %>;--pill-text-color:<%= pick_text_color(category.color) %>">
                  <% if category.icon.present? %>
                    <i class="fas fa-<%= category.icon %>"></i>
                  <% end %>
                  <%= category.name %>
                </label>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="kern-row">
        <div class="kern-col-10">
          <%= form.fields_for :map_location do |ml_form| %>
            <%= render Kern::MapComponent.new(
              map_location: @idea.map_location,
              form: ml_form,
              editable: true,
              admin_editor: false,
              height: 500
            ) %>
          <% end %>
        </div>
      </div>

      <div class="d-flex gap-2 mb-4">
        <%= kern_button(text: t("shared.submit"), icon: "save", type: "submit") %>
        <%= kern_link_button(adm_ideas_idea_path(@idea),
              text: t("shared.cancel"), style: :secondary) %>
      </div>
    <% end %>
  <% end %>
</article>
