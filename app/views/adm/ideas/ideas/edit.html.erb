<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @idea.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: idea_tabs(@idea)) %>

<div class="kern-container my-5">

  <div class="max-w-4xl">
    <%= translatable_form_for @idea, url: adm_ideas_idea_path(@idea) do |f| %>
      <%= render "shared/errors", resource: @idea %>
      <%= render "shared/globalize_locales", resource: @idea %>

      <%= f.translatable_fields do |translations_form| %>
        <div class="mb-4">
          <%= render Kern::FormFieldComponent.new(label: t(".labels.title")) do %>
            <%= translations_form.text_field :title, class: "kern-input", autocomplete: "off" %>
          <% end %>
        </div>

        <div class="mb-4">
          <%= render Kern::FormFieldComponent.new(label: t(".labels.description")) do %>
            <%= translations_form.text_area :description,
              value: AdminWYSIWYGSanitizer.new.sanitize(@idea.description),
              class: "html-area #{ck_editor_class(current_user)} kern-textarea",
              rows: 10 %>
          <% end %>
        </div>
      <% end %>

      <% if feature?(:allow_images) %>
        <div class="mb-4">
          <%= render "images/nested_image", imageable: @idea, f: f %>

          <% if @idea.image.present? %>
            <%= link_to toggle_image_adm_ideas_idea_path(@idea),
              data: { turbo_method: :patch },
              class: "kern-btn kern-btn--secondary mt-2" do %>
              <%= @idea.image.concealed ? t(".show_image") : t(".hide_image") %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if feature?(:allow_attached_documents) %>
        <div class="mb-4">
          <%= render "documents/nested_documents", documentable: @idea, f: f %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= render Kern::FormFieldComponent.new(label: t(".labels.video_url")) do %>
          <%= f.text_field :video_url, class: "kern-input" %>
        <% end %>
      </div>

      <div class="mb-4">
        <%= render Kern::FormFieldComponent.new(label: t(".labels.category")) do %>
          <%= f.collection_select :idea_category_id, Idea::Category.all, :id, :name,
            { include_blank: t(".no_category") },
            { class: "kern-select" } %>
        <% end %>
      </div>

      <div class="mb-4">
        <%= render Kern::FormFieldComponent.new(label: t(".labels.map_location")) do %>
          <div class="mb-2">
            <%= select_tag :idea_district, options_for_select(@districts.map { |district|
              [
                district.name, district.id,
                {
                  data: {
                    latitude: district.map_location.latitude,
                    longitude: district.map_location.longitude
                  }
                }
              ]
            }),
            {
              prompt: t(".district_placeholder"),
              class: "kern-select js-update-map-center",
              data: {
                default_latitude: MapLocation.default.latitude,
                default_longitude: MapLocation.default.longitude
              }
            } %>
          </div>

          <%= render "map_locations/form_fields",
            form: f,
            mappable: @idea,
            nesting_prefix: "idea" %>
        <% end %>
      </div>

      <div class="mb-4">
        <%= render Kern::FormFieldComponent.new(label: t(".labels.on_behalf_of")) do %>
          <%= f.text_field :on_behalf_of, class: "kern-input" %>
        <% end %>
      </div>

      <%= form_submit_button(text: t(".submit")) %>
    <% end %>
  </div>
</div>
