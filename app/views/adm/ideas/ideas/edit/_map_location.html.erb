<%= turbo_frame_tag "edit__map_location" do %>
  <%= form_with model: idea, url: adm_ideas_idea_path(idea), method: :patch do |f| %>
    <div class="kern-fieldset__body mb-4">
      <div class="mb-2">
        <%= select_tag :idea_district, options_for_select(districts.map { |district|
          [
            district.name, district.id,
            {
              data: {
                latitude: district.map_location.latitude,
                longitude: district.map_location.longitude
              }
            }
          ]
        }),
        {
          prompt: t("adm.ideas.ideas.edit.district_placeholder"),
          class: "kern-select js-update-map-center",
          data: {
            default_latitude: MapLocation.default.latitude,
            default_longitude: MapLocation.default.longitude
          }
        } %>
      </div>

      <%= render "map_locations/form_fields",
        form: f,
        mappable: idea,
        nesting_prefix: "idea" %>
    </div>
    <%= form_submit_button %>
  <% end %>

  <% if flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove"><%= flash[:success] %></div>
  <% end %>
<% end %>
