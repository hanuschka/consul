<%= content_for :title, @idea.title %>

<%= render Adm::HeaderComponent.new(title: @idea.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: idea_tabs(@idea)) %>

<article class="kern-container mb-5">
  <div class="mb-3">
    <strong><%= t(".admin_accepted_status") %>:</strong>
    <%= @idea.accepted? ? t(".accepted") : t(".not_accepted") %>
  </div>

  <h1 class="kern-title kern-title--large mb-2"><%= @idea.title %></h1>
  <p class="kern-body kern-body--small">
    <%= @idea.author.username %>
    <% if @idea.on_behalf_of.present? %>
      (<%= t(".on_behalf_of") %>: <%= @idea.on_behalf_of %>)
    <% end %>
    | <%= l(@idea.created_at, format: :long) %>
    | <%= link_to t(".view_on_site"), idea_path(@idea), target: "_blank", data: { turbo: false } %>
    | <%= link_to t(".download_pdf"), adm_ideas_idea_path(@idea, format: :pdf),
          data: @idea.map_location.present? ? {
            controller: "map-screenshot",
            map_screenshot_container_value: dom_id(@idea, "map"),
            action: "click->map-screenshot#capture"
          } : {} %>
  </p>
  <p class="kern-body kern-body--small">
    <span class="material-symbols-outlined" aria-hidden="true">thumb_up</span> <%= @idea.cached_votes_up %>
    · <span class="material-symbols-outlined" aria-hidden="true">comment</span> <%= @idea.comments_count %>
  </p>

  <% if @idea.category.present? %>
    <p class="kern-body kern-body--small mb-3">
      <strong><%= t(".category") %>:</strong> <%= @idea.category.name %>
    </p>
  <% end %>

  <% if @idea.officer.present? %>
    <p class="kern-body kern-body--small mb-3">
      <strong><%= t(".officer") %>:</strong> <%= @idea.officer.name %>
    </p>
  <% end %>

  <div class="kern-row mb-3">
    <% if @image_url.present? %>
      <div class="kern-col-sm-12 kern-col-md-5">
        <%= image_tag(@image_url, class: "w-100") %>
      </div>
    <% end %>

    <div class="kern-col-sm-12 kern-col-md-<%= @image_url.present? ? 5 : 10 %>">
      <div class="kern-body mb-4">
        <%= auto_link_already_sanitized_html wysiwyg(@idea.description) %>
      </div>
    </div>
  </div>

  <% if @idea.approximated_address.present? %>
    <p class="kern-body mb-3">
      <strong><%= t(".address") %>:</strong>
      <%= @idea.approximated_address %>
    </p>
  <% end %>

  <% if @idea.map_location.present? %>
    <div class="kern-row mb-4">
      <div class="kern-col-sm-12 kern-col-md-10">
        <%= render Kern::MapComponent.new(map_location: @idea.map_location) %>
      </div>
    </div>
  <% end %>

  <% if @idea.video_url.present? %>
    <p class="kern-body mb-4">
      <strong><%= t(".video_url") %>:</strong>
      <%= link_to @idea.video_url, @idea.video_url, target: "_blank" %>
    </p>
  <% end %>

  <hr class="kern-divider my-5">

  <%= render Adm::AttributeEditorComponent.new(
    @idea,
    :official_answer,
    :rich_text,
    path: update_official_answer_adm_ideas_idea_path(@idea),
    label: t(".official_answer"),
    description: t(".official_answer_hint")
  ) %>
</article>
