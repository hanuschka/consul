<tr class="kern-table__row" id="<%= dom_id(officer) %>">
  <th scope="row" class="kern-table__header"><%= officer.name %></th>
  <td class="kern-table__cell"><%= officer.email %></td>
  <td class="kern-table__cell">
    <% if officer.persisted? %>
      <%= render Kern::Table::ActionsComponent.new do |actions| %>
        <% actions.with_action(
          label: t("shared.delete"),
          url: adm_ideas_officer_path(officer),
          icon: "delete",
          style: :delete,
          data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }
        ) %>
      <% end %>
    <% else %>
      <%= button_to adm_ideas_officers_path(user_id: officer.user_id),
        class: "kern-btn kern-btn--primary" do %>
        <span class="kern-label"><%= t(".add") %></span>
      <% end %>
    <% end %>
  </td>
</tr>
