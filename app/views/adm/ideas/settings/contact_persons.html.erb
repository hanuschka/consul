<%= content_for :title, t("adm.ideas.settings.title") %>

<%= render Adm::HeaderComponent.new(
  title: t("adm.ideas.settings.title"),
  breadcrumbs: @breadcrumbs
) %>

<%= render Adm::TabsComponent.new(tabs: [
  {
    label: t("adm.ideas.settings.tabs.features"),
    url: adm_ideas_settings_path
  },
  {
    label: t("adm.ideas.settings.tabs.dashboard"),
    url: dashboard_adm_ideas_settings_path
  },
  {
    label: t("adm.ideas.settings.tabs.contact_persons"),
    url: contact_persons_adm_ideas_settings_path,
    current: true
  }
]) %>

<div class="kern-container my-5">
  <%= render "adm/section_contact_people/section_block", section: "ideas" %>
</div>
