<%= turbo_stream.update "search_results" do %>
  <% if @users.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t("adm.individual_group_values.show.table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.individual_group_values.show.table.email") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.individual_group_values.show.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @users.each do |user| %>
            <tr class="kern-table__row">
              <td scope="row" class="kern-table__header"><%= user.name %></td>
              <td class="kern-table__cell"><%= user.email %></td>
              <td class="kern-table__cell">
                <% if @individual_group_value.users.include?(user) %>
                  <span class="kern-badge"><%= t("adm.individual_group_values.search_user.already_assigned") %></span>
                <% else %>
                  <%= link_to t("adm.individual_group_values.search_user.add_user"),
                    add_user_adm_individual_group_value_path(@individual_group, @individual_group_value, user_id: user.id),
                    data: { turbo_method: :post, turbo_frame: "_top" },
                    class: "kern-link" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t("adm.individual_group_values.search_user.not_found") %></p>

    <% if params[:search].to_s.match?(URI::MailTo::EMAIL_REGEXP) %>
      <% if @individual_group_value.stored_email?(params[:search]) %>
        <p class="kern-body"><%= t("adm.individual_group_values.search_user.already_stored") %></p>
      <% else %>
        <%= link_to t("adm.individual_group_values.search_user.add_email", email: params[:search]),
              add_email_adm_individual_group_value_path(@individual_group, @individual_group_value,
                                                        email: params[:search]),
              data: { turbo_method: :post, turbo_frame: "_top" },
              class: "kern-link" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
