<%= content_for :title, @individual_group_value.name %>

<%= render Adm::HeaderComponent.new(title: @individual_group_value.name, breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">

  <div class="kern-callout kern-callout--info mb-5">
    <p class="kern-body"><%= t(".csv_hint_html", sample_url: "/samples/igv_sample.csv") %></p>
    <%= form_tag add_from_csv_adm_individual_group_value_path(@individual_group, @individual_group_value), multipart: true do %>
      <div class="kern-form-input mt-3">
        <%= file_field_tag :file, accept: ".csv", class: "kern-form-input__input", onchange: "this.form.submit()" %>
      </div>
    <% end %>
  </div>

  <% if @related_users.any? %>
    <h2 class="kern-title kern-title--small mb-3">
      <%= t(".related_users_heading", count: @individual_group_value.users.count) %>
    </h2>

    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.email") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @related_users.each do |user| %>
            <tr class="kern-table__row">
              <td scope="row" class="kern-table__header"><%= user.name %></td>
              <td class="kern-table__cell"><%= user.email %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(
                    label: t(".table.remove_user"),
                    url: remove_user_adm_individual_group_value_path(@individual_group, @individual_group_value, user_id: user.id),
                    icon: "delete", style: :delete,
                    data: { turbo_method: :delete, turbo_confirm: t(".table.remove_user_confirm") }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% end %>

  <% if @individual_group_value.auto_join_emails.any? %>
    <h2 class="kern-title kern-title--small mb-3">
      <%= t(".auto_join_emails_heading", count: @individual_group_value.auto_join_emails.size) %>
    </h2>

    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.email") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @individual_group_value.auto_join_emails.each do |email| %>
            <tr class="kern-table__row">
              <td scope="row" class="kern-table__header"><%= email %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(
                    label: t(".table.remove_email"),
                    url: remove_email_from_auto_join_emails_adm_individual_group_value_path(@individual_group, @individual_group_value, email: email),
                    icon: "delete", style: :delete,
                    data: { turbo_method: :delete, turbo_confirm: t(".table.remove_email_confirm") }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
