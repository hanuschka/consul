<%= form_with model: [:adm, @individual_group] do |f| %>
  <%= render Kern::FormFieldComponent.new(label: IndividualGroup.human_attribute_name(:name), hint: t(".hints.name")) do %>
    <%= f.text_field :name, label: false, placeholder: IndividualGroup.human_attribute_name(:name) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: IndividualGroup.human_attribute_name(:kind), hint: t(".hints.kind")) do %>
    <%= f.select :kind, IndividualGroup.kinds.keys.map { |k| [t(".kinds.#{k}"), k] }, {}, class: "kern-form-select__select" %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: IndividualGroup.human_attribute_name(:visible), hint: t(".hints.visible")) do %>
    <%= f.check_box :visible %>
  <% end %>

  <%= form_submit_button(text: t(".submit")) %>
<% end %>
