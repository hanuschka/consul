<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <h2 class="kern-title kern-title--small mb-3"><%= t(".intro_title") %></h2>
  <p class="kern-body mb-3 mb-md-0"><%= t(".intro_text_p1") %></p>
  <p class="kern-body mb-5 mb-md-0"><%= t(".intro_text_p2") %></p>


  <%= new_resource_link(new_adm_individual_group_path, t('.new_individual_group')) %>

  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t('.table.name') %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.kind') %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.visible') %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
        </tr>
      </thead>

      <tbody class="kern-table__body">
        <% @individual_groups.each do |individual_group| %>
          <tr id="<%= dom_id(individual_group) %>" class="kern-table__row">
            <td scope="row" class="kern-table__header"><%= individual_group.name %></td>
            <td class="kern-table__cell"><%= t(".table.kinds.#{individual_group.kind}") %></td>
            <td class="kern-table__cell"><%= individual_group.visible ? t('.table.yes') : t('.table.no') %></td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(label: t('.table.edit'), url: edit_adm_individual_group_path(individual_group)) %>
                <% actions.with_action(
                  label: t('.table.delete'),
                  url: adm_individual_group_path(individual_group),
                  data: { turbo_method: :delete, turbo_confirm: t('.table.delete_confirm') }
                ) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="my-5">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
