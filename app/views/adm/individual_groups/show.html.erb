<%= content_for :title, @individual_group.name %>

<%= render Adm::HeaderComponent.new(title: @individual_group.name, breadcrumbs: @breadcrumbs, back_button_url: adm_individual_groups_path) %>

<div class="kern-container my-5">

  <%= new_resource_link(new_adm_individual_group_value_path(@individual_group), t('.new_value')) %>

  <% if @individual_group.individual_group_values.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t('.table.name') %></th>
            <th scope="col" class="kern-table__header"><%= IndividualGroupValue.human_attribute_name(:email_pattern) %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @individual_group.individual_group_values.order(:id).each do |value| %>
            <tr id="<%= dom_id(value) %>" class="kern-table__row">
              <td scope="row" class="kern-table__header">
                <%= link_to value.name, adm_individual_group_value_path(@individual_group, value) %>
              </td>
              <td class="kern-table__cell"><%= value.email_pattern %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t('.table.edit'), url: edit_adm_individual_group_value_path(@individual_group, value)) %>
                  <% actions.with_action(
                    label: t('.table.delete'),
                    url: adm_individual_group_value_path(@individual_group, value),
                    data: { turbo_method: :delete, turbo_confirm: t('.table.delete_confirm') }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
