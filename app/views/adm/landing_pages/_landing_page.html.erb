<tr class="kern-table__row" id="<%= dom_id(landing_page) %>" data-id="<%= landing_page.id %>">
  <th scope="row" class="kern-table__header"><%= landing_page.title %></th>
  <td class="kern-table__cell"><%= link_to landing_page.slug, page_path(landing_page.slug), target: "_blank" %></td>
  <td class="kern-table__cell">
    <%= render Adm::AttributeEditors::BooleanComponent.new(
      landing_page,
      :status,
      path: toggle_active_adm_landing_page_path(landing_page),
      updated: local_assigns[:updated]
    ) %>
  </td>
  <td class="kern-table__cell">
    <%= link_to edit_adm_landing_page_path(landing_page) do %>
      <%= tag.span(class: "material-symbols-outlined") { "edit" } %>
    <% end %>
  </td>
</tr>
