<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(
    @landing_page, :slug, kind: :string,
    path: adm_landing_page_path(@landing_page),
    label: t(".slug_label"), hint: t(".slug_hint")
  ) %>



  <%#= render Adm::AttributeEditorComponent.new(SiteCustomization::Image.find_or_create_by!(name: "header_image"), :image, kind: :image) %>
  <%#= render Adm::AttributeEditorComponent.new(SiteCustomization::Image.find_or_create_by!(name: "mobile_header_image"), :image, kind: :image) %>

  <%#= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_option.general.title"), :value, kind: :string) %>
  <%#= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_option.general.subtitle"), :value, kind: :string) %>

  <%#= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.usage_stats"), :value, kind: :boolean) %>
  <%#= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.newsletter_subscription"), :value, kind: :boolean) %>
  <%#= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.platform_activity"), :value, kind: :boolean) %>
  <%#= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "welcomepage.projekt_search"), :value, kind: :boolean) %>


  <h2 class="kern-title kern-title--small mb-3"><%= t("adm.homepage.show.content_cards_title") %></h2>
  <p class="kern-body mb-4 mb-md-0">
    <%= t("adm.homepage.show.content_cards_description") %>
  </p>

  <%#= render Adm::SiteCustomization::ContentCardsComponent.new %>
</div>
