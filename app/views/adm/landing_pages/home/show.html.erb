<%= content_for :title, t("adm.landing_pages.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.landing_pages.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new(
  team_members: @team_members,
  team_url: new_adm_landing_pages_manager_path,
  recent_items: @recent_items,
  recent_items_url: adm_landing_pages_landing_pages_list_path,
  recent_item_partial: "adm/landing_pages/landing_pages/landing_page",
  recent_item_headers: [
    t("adm.landing_pages.landing_pages.index.table.header.name"),
    t("adm.landing_pages.landing_pages.index.table.header.url"),
    t("adm.landing_pages.landing_pages.index.table.header.status"),
    ""
  ],
  intro_text: @section_setting&.intro_text,
  quick_links: @quick_links,
  stats: @stats,
  contact_persons: @contact_persons,
  notice: @section_setting,
  activities: @activities,
  section_settings_path: policy([:adm, :modules]).show? ? adm_modules_path(tab: "landing_pages") : nil
) %>
