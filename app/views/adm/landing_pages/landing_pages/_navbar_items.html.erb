<div id="navbar" class="mb-5">
  <h2 class="kern-title kern-title--small mb-3"><%= t(".title") %></h2>
  <p class="kern-body mb-4" style="max-width: 75%"><%= t(".description") %></p>

  <%= new_resource_link(
    new_adm_landing_pages_landing_page_navbar_item_path(landing_page),
    t(".new_item")
  ) %>

  <div
    class="navbar-items"
    data-controller="sortable"
    data-sortable-url-value="<%= reorder_adm_landing_pages_landing_page_navbar_items_path(landing_page) %>"
  >
    <%= render partial: "adm/navbar_items/navbar_item", collection: landing_page.navbar_items.top_level %>
  </div>
</div>

<div class="kern-row">
  <div class="kern-col-12 kern-col-md-10">
    <hr class="kern-divider mb-5" aria-hidden="true" />
  </div>
</div>
