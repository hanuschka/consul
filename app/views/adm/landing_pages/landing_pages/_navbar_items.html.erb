<div id="navbar" class="mt-5">
  <h2 class="kern-title kern-title--small mb-3"><%= t(".title") %></h2>
  <p class="kern-body mb-4"><%= t(".description") %></p>

  <%= new_resource_link(
    new_adm_navbar_item_path(landing_page_id: landing_page.id),
    t(".new_item")
  ) %>

  <div
    class="navbar-items"
    data-controller="sortable"
    data-sortable-url-value="<%= reorder_adm_navbar_items_path %>"
  >
    <%= render landing_page.navbar_items.top_level %>
  </div>
</div>
