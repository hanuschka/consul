<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, frontend_url: "/#{@landing_page.slug}") do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <%= render "navbar_items", landing_page: @landing_page %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :slug, :string, path: adm_landing_pages_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_site_logo_for_transparent_background, :image, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_site_logo_for_white_background, :image, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_desktop_header_image, :image, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_desktop_header_video, :video, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_mobile_header_image, :image, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_mobile_header_video, :video, path: adm_landing_pages_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :title, :string, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :header_title, :string, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :subtitle, :string, path: adm_landing_pages_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_hide_title_and_subtitle, :boolean, path: adm_landing_pages_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_site_logo_follow_to_landing_page, :boolean, path: adm_landing_pages_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_navigation_link_color, :color, path: adm_landing_pages_landing_page_path(@landing_page)) %>

  <% if current_user.administrator? || current_user.landing_page_manager&.manage_all_landing_pages? %>
    <%= render Kern::FormFieldComponent.new(label: t(".managers_title"), hint: t(".managers_description")) do %>
      <%= render "manager_assignments", landing_page: @landing_page %>
    <% end %>
  <% end %>

  <h2 class="kern-title kern-title--small mb-3"><%= t("adm.homepage.show.content_cards_title") %></h2>
  <p class="kern-body mb-4 mb-md-0">
    <%= t("adm.homepage.show.content_cards_description") %>
  </p>

  <%= render Adm::SiteCustomization::ContentCardsComponent.new(landing_page_id: @landing_page.id) %>
</div>
