<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <h2 class="kern-title kern-title--small mb-3"><%= t(".hint_title") %></h2>
  <p class="kern-body mb-3 mb-md-0"><%= t(".hint_text") %></p>

  <hr class="kern-divider mb-5" aria-hidden="true">

  <% if policy([:adm, :landing_pages, :landing_page]).create? %>
    <%= new_resource_link(new_adm_landing_pages_landing_page_path, t(".new_landing_page")) %>
  <% end %>

  <% if @landing_pages.any? %>
    <table class="kern-table content-cards-table" id="content-cards-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t(".table.header.name") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.header.url") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.header.status") %></th>
          <th scope="col" class="kern-table__header"></th>
        </tr>
      </thead>
      <tbody class="kern-table__body" data-controller="sortable" data-sortable-url-value="<%= reorder_adm_landing_pages_landing_pages_path %>">
        <%= render partial: "landing_page", collection: @landing_pages %>
      </tbody>
    </table>
  <% else %>
    <%= t(".table.no_landing_pages") %>
  <% end %>
</div>
