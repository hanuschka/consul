<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, narrow: true) %>

<div class="kern-container my-5">
  <%= form_with model: @landing_page,
                url: adm_landing_pages_landing_pages_path,
                method: :post do |f| %>
    <%= render Kern::FormFieldComponent.new(
      label: SiteCustomization::Page.human_attribute_name(:title),
      divider: false
    ) do %>
      <%= f.text_field :title, label: false %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(
      label: SiteCustomization::Page.human_attribute_name(:slug),
      hint: t(".hints.slug"),
      divider: false
    ) do %>
      <%= f.text_field :slug, label: false %>
    <% end %>

    <%= form_submit_button(text: t(".submit")) %>
  <% end %>
</div>
