<tr class="kern-table__row" id="<%= dom_id(landing_page_manager) %>">
  <th scope="row" class="kern-table__header"><%= landing_page_manager.id %></th>
  <td class="kern-table__cell"><%= landing_page_manager.name %></td>
  <td class="kern-table__cell"><%= landing_page_manager.email %></td>
  <td class="kern-table__cell">
    <%= render Adm::AttributeEditors::BooleanComponent.new(
      landing_page_manager,
      :manage_all_landing_pages?,
      path: toggle_manage_all_landing_pages_adm_landing_pages_manager_path(landing_page_manager)
    ) %>
  </td>
  <td class="kern-table__cell">
    <%= link_to t('shared.delete'),
                adm_landing_pages_manager_path(landing_page_manager),
                data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_delete') },
                class: "kern-link" %>
  </td>
</tr>
