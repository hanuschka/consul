<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<div class="kern-container">
  <%= new_resource_link(new_adm_landing_pages_manager_path, t('.new_link')) %>

  <% if @landing_page_managers.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t("shared.table.id") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.username") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.email") %></th>
            <th scope="col" class="kern-table__header"><%= t(".manage_all_landing_pages") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @landing_page_managers.each do |landing_page_manager| %>
            <%= render "landing_page_manager", landing_page_manager: landing_page_manager %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_items_title"), description: t(".no_items_description"), icon: "supervisor_account") %>
  <% end %>

  <%= render partial: "adm/role_assignments/pending_role_assignments", locals: { pending_role_assignments: @pending_role_assignments } %>
</div>
