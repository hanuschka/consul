<%= content_for :title, t("adm.landing_pages.menu.items.settings") %>

<%= render Adm::HeaderComponent.new(title: t("adm.landing_pages.menu.items.settings"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: [
  {
    label: t("adm.landing_pages.settings.tabs.dashboard"),
    url: adm_landing_pages_settings_path,
    current: true
  },
  {
    label: t("adm.landing_pages.settings.tabs.contact_persons"),
    url: contact_persons_adm_landing_pages_settings_path
  }
]) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.landing_pages.intro_text"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.landing_pages.notice_message"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.landing_pages.notice_active"), :value, :boolean) %>
</div>
