<div class="mb-5">
  <div class="kern-title kern-title--small mb-3">
    <%= t('.title') %>
  </div>

  <p class="kern-body mb-3"><%= t('.description') %></p>

  <%= new_resource_link(new_adm_map_layer_path, t('.add_layer')) %>

  <% if map_layers.any? %>
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t('.table.name') %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.type') %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.layer_names') %></th>
          <th scope="col" class="kern-table__header"></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% map_layers.each do |layer| %>
          <tr class="kern-table__row" id="<%= dom_id(layer) %>">
            <th scope="row" class="kern-table__header"><%= layer.name %></th>
            <td class="kern-table__cell"><%= layer.base? ? t('.table.base') : t('.table.layer') %></td>
            <td class="kern-table__cell"><%= layer.layer_names %></td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(
                  label: t('.actions.edit'),
                  url: edit_adm_map_layer_path(layer),
                  icon: "edit",
                  style: :edit
                ) %>
                <% actions.with_action(
                  label: t('.actions.delete'),
                  url: adm_map_layer_path(layer),
                  icon: "delete",
                  style: :delete,
                  method: :delete,
                  data: { turbo_confirm: t('.actions.delete_confirm') }
                ) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state(title: t('.no_layers'), icon: "layers", link_url: new_adm_map_layer_path, link_text: t('.add_layer')) %>
  <% end %>
</div>
