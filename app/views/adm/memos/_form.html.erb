<% is_reply = memoable.is_a?(Memo) %>
<% placeholder = is_reply ? t("adm.memos.form.placeholder_reply") : t("adm.memos.form.placeholder") %>
<% submit_label = is_reply ? t("adm.memos.form.submit_reply") : t("adm.memos.form.submit") %>

<div id="memo-form-<%= dom_id(memoable) %>" class="adm-memo-form">
  <%= form_with(model: Memo.new, url: adm_memos_create_path(memoable), method: :post,
                data: { controller: "adm--memo-form" }) do |f| %>
    <%= f.hidden_field :memoable_id, value: memoable.id %>
    <%= f.hidden_field :memoable_type, value: memoable.class.name %>
    <%= f.hidden_field :parent_id, value: is_reply ? memoable.id : nil %>

    <div class="adm-memo-composer">
      <%= render "adm/memos/avatar", name: current_user.name %>

      <div class="adm-memo-composer__field">
        <textarea name="memo[text]"
                  rows="1"
                  placeholder="<%= placeholder %>"
                  class="adm-memo-composer__textarea"
                  data-controller="adm-autogrow"
                  data-adm--memo-form-target="textarea"
                  data-action="input->adm-autogrow#resize input->adm--memo-form#update keydown->adm--memo-form#submitOnModifierEnter"></textarea>

        <div class="adm-memo-composer__footer">
          <p class="adm-memo-composer__hint"><%= t("adm.memos.form.keyboard_hint") %></p>
          <%= kern_button(type: :submit, text: submit_label, icon: "send", disabled: true,
                          style: is_reply ? :secondary : :primary,
                          data: { "adm--memo-form-target": "submit" }) %>
        </div>
      </div>
    </div>
  <% end %>
</div>
