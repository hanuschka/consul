<% author_removed = memo.user.hidden? || memo.user.erased? %>
<% may_reply = policy([:adm, Memo.new(memoable: memo.root_memoable)]).create? %>

<div
  class="adm-memo"
  id="<%= dom_id(memo) %>"
  data-controller="adm--memo"
>
  <%= render "adm/memos/avatar", name: author_removed ? nil : memo.user.name %>

  <div class="adm-memo__content">
    <div class="adm-memo__header">
      <% if author_removed %>
        <span class="adm-memo__author"><%= t("adm.memos.memo.user_deleted") %></span>
      <% else %>
        <%= link_to memo.user.name, user_path(memo.user), class: "adm-memo__author" %>

        <% if memo.user.display_official_position_badge? %>
          <%= render Shared::OfficialPositionBadgeComponent.new(user: memo.user) %>
        <% end %>
      <% end %>

      <span class="adm-memo__timestamp" title="<%= l memo.created_at.to_datetime, format: :datetime %>"><%= relative_time(memo.created_at) %></span>
    </div>

    <div class="adm-memo__text">
      <%= simple_format sanitize_and_auto_link(memo.text), {}, sanitize: false %>
    </div>

    <div class="adm-memo__actions">
      <% if may_reply %>
        <button type="button" class="adm-memo__action" data-action="click->adm--memo#toggleReplyForm">
          <span class="material-symbols-outlined" aria-hidden="true">reply</span>
          <%= t("adm.memos.memo.reply") %>
        </button>
      <% end %>

      <% if policy([:adm, memo]).send_notification? %>
        <% if memo.last_notification_sent_at.present? %>
          <span class="adm-memo__action -sent" title="<%= t("adm.memos.memo.last_notification", datetime: l(memo.last_notification_sent_at.to_datetime, format: :datetime)) %>">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <%= t("adm.memos.memo.notification_sent") %>
          </span>
        <% else %>
          <%= link_to adm_memo_send_notification_path(memo), class: "adm-memo__action", data: { turbo_method: :post } do %>
            <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
            <%= t("adm.memos.memo.send_notification") %>
          <% end %>
        <% end %>
      <% end %>

      <% if policy([:adm, memo]).destroy? %>
        <%= link_to adm_memo_path(memo), class: "adm-memo__action -danger", data: { turbo_method: :delete, turbo_confirm: t("adm.memos.memo.delete_confirm") } do %>
          <span class="material-symbols-outlined" aria-hidden="true">delete</span>
          <%= t("adm.memos.memo.delete") %>
        <% end %>
      <% end %>
    </div>

    <% if may_reply %>
      <div
        class="adm-memo__reply-form"
        data-adm--memo-target="replyForm"
        hidden
      >
        <%= render "adm/memos/form", memoable: memo %>
      </div>
    <% end %>

    <%= render "adm/memos/memos_tree", memos: memo.children.order(created_at: :desc), memoable: memo %>
  </div>
</div>
