<tr id="<%= dom_id(modal_notification) %>" class="kern-table__row">
  <td scope="row" class="kern-table__header"><%= modal_notification.title %></td>
  <td class="kern-table__cell"><%= l(modal_notification.active_from, format: :long) if modal_notification.active_from %></td>
  <td class="kern-table__cell"><%= l(modal_notification.active_to, format: :long) if modal_notification.active_to %></td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t('adm.modal_notifications.index.table.edit'), url: edit_adm_modal_notification_path(modal_notification)) %>
      <% actions.with_action(
        label: t('adm.modal_notifications.index.table.delete'),
        url: adm_modal_notification_path(modal_notification),
        data: { turbo_method: :delete, turbo_confirm: t('adm.modal_notifications.index.table.delete_confirm') }
      ) %>
    <% end %>
  </td>
</tr>
