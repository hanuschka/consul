<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">

  <%= new_resource_link(new_adm_modal_notification_path, t('.new_modal_notification')) %>

  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= ModalNotification.human_attribute_name(:title) %></th>
          <th scope="col" class="kern-table__header"><%= ModalNotification.human_attribute_name(:active_from) %></th>
          <th scope="col" class="kern-table__header"><%= ModalNotification.human_attribute_name(:active_to) %></th>
          <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
        </tr>
      </thead>

      <tbody class="kern-table__body">
        <%= render partial: "modal_notification", collection: @modal_notifications %>
      </tbody>
    </table>
  </div>

  <div class="my-5">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
