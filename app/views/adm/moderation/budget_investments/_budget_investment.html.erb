<tr id="<%= dom_id(budget_investment, :moderation) %>" class="kern-table__row">
  <th scope="row" class="kern-table__header"><%= budget_investment.title %></th>
  <td class="kern-table__cell"><%= budget_investment.budget&.projekt&.name %></td>
  <td class="kern-table__cell"><%= budget_investment.author.username %></td>
  <td class="kern-table__cell"><%= budget_investment.flags_count %></td>
  <td class="kern-table__cell">
    <% if budget_investment.hidden? %>
      <%= render Kern::Table::ActionsComponent.new do |c| %>
        <%= c.with_action label: t("adm.moderation.budget_investments.index.actions.unhide"),
                          url: unhide_adm_moderation_budget_investment_path(budget_investment),
                          data: { turbo_method: :put } %>
      <% end %>
    <% elsif budget_investment.ignored_flag? %>
      <%= render Kern::Table::ActionsComponent.new do |c| %>
        <%= c.with_action label: t("adm.moderation.budget_investments.index.actions.hide"),
                          url: hide_adm_moderation_budget_investment_path(budget_investment),
                          data: { turbo_method: :put, turbo_confirm: t("adm.moderation.budget_investments.index.confirm_hide", name: budget_investment.title) } %>
      <% end %>
    <% else %>
      <%= render Kern::Table::ActionsComponent.new do |c| %>
        <%= c.with_action label: t("adm.moderation.budget_investments.index.actions.ignore_flag"),
                          url: ignore_flag_adm_moderation_budget_investment_path(budget_investment),
                          data: { turbo_method: :put } %>
        <%= c.with_action label: t("adm.moderation.budget_investments.index.actions.hide"),
                          url: hide_adm_moderation_budget_investment_path(budget_investment),
                          data: { turbo_method: :put, turbo_confirm: t("adm.moderation.budget_investments.index.confirm_hide", name: budget_investment.title) } %>
      <% end %>
    <% end %>
  </td>
</tr>
