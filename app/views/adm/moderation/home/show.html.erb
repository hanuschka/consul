<%= content_for :title, t("adm.moderation.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.moderation.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new do |d| %>
  <% d.with_notice(message: @notice) if @notice.present? %>
  <% d.with_header_row(intro: @intro_text, stats: @stats) %>
  <% d.with_tiles(title: @tiles_title, hint: @tiles_hint, tiles: @tiles) if @tiles.present? && @tiles.any? %>
  <% d.with_team(members: @team_members, add_url: new_adm_moderator_path) %>
  <% d.with_contacts(contacts: @contact_persons) if @contact_persons.any? %>
  <% d.with_activity_feed(activities: @activities, pagy: @pagy_activities) %>
<% end %>
