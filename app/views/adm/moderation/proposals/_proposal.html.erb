<tr id="<%= dom_id(proposal, :moderation) %>" class="kern-table__row">
  <th scope="row" class="kern-table__header" data-field="title"><%= proposal.title %></th>
  <td class="kern-table__cell" data-field="projekt"><%= proposal.projekt&.name %></td>
  <td class="kern-table__cell" data-field="author"><%= proposal.author&.username %></td>
  <td class="kern-table__cell" data-field="flags_count"><%= proposal.flags_count %></td>
  <td class="kern-table__cell" data-field="status">
    <% status_key, badge_variant = moderation_status_badge(proposal) %>
    <span class="kern-badge <%= badge_variant %> kern-badge--small"><%= t("adm.moderation.proposals.index.statuses.#{status_key}") %></span>
  </td>
  <td class="kern-table__cell" data-field="actions">
    <% if proposal.hidden? %>
    <% elsif proposal.ignored_flag? %>
      <%= render Kern::Table::ActionsComponent.new do |c| %>
        <% if moderation_resource_reachable?(proposal) %>
          <%= c.with_action label: t("adm.moderation.proposals.index.actions.view"),
                            url: polymorphic_path(proposal),
                            icon: "open_in_new",
                            target: "_blank",
                            rel: "noopener" %>
        <% end %>
        <%= c.with_action label: t("adm.moderation.proposals.index.actions.hide"),
                          url: hide_adm_moderation_proposal_path(proposal),
                          data: { turbo_method: :put, turbo_confirm: t("adm.moderation.proposals.index.confirm_hide", name: proposal.title) } %>
      <% end %>
    <% else %>
      <%= render Kern::Table::ActionsComponent.new do |c| %>
        <% if moderation_resource_reachable?(proposal) %>
          <%= c.with_action label: t("adm.moderation.proposals.index.actions.view"),
                            url: polymorphic_path(proposal),
                            icon: "open_in_new",
                            target: "_blank",
                            rel: "noopener" %>
        <% end %>
        <%= c.with_action label: t("adm.moderation.proposals.index.actions.ignore_flag"),
                          url: ignore_flag_adm_moderation_proposal_path(proposal),
                          data: { turbo_method: :put } %>
        <%= c.with_action label: t("adm.moderation.proposals.index.actions.hide"),
                          url: hide_adm_moderation_proposal_path(proposal),
                          data: { turbo_method: :put, turbo_confirm: t("adm.moderation.proposals.index.confirm_hide", name: proposal.title) } %>
      <% end %>
    <% end %>
  </td>
</tr>
