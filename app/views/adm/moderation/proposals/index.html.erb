<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<%= render Adm::TabsComponent.new(tabs: [
  { label: t(".tabs.pending_flag_review"), url: adm_moderation_proposals_path(filter: "pending_flag_review"), current: @current_filter == "pending_flag_review" },
  { label: t(".tabs.with_ignored_flag"), url: adm_moderation_proposals_path(filter: "with_ignored_flag"), current: @current_filter == "with_ignored_flag" },
  { label: t(".tabs.hidden"), url: adm_moderation_proposals_path(filter: "hidden"), current: @current_filter == "hidden" },
  { label: t(".tabs.all"), url: adm_moderation_proposals_path(filter: "all"), current: @current_filter == "all" }
]) %>

<div class="kern-container">
  <%
    headers = {
      title:       Kern::Table::HeaderComponent.new(:title, Proposal.human_attribute_name(:title), **@title_header_options.merge(data_field: "title")),
      flags_count: Kern::Table::HeaderComponent.new(:flags_count, t(".flags_count"), **@flags_count_header_options.merge(data_field: "flags_count"))
    }
  %>

  <%= render Adm::IndexTableComponent.new(
        turbo_frame_id: "proposals_table",
        records: @proposals,
        pagy: @pagy,
        headers: headers,
        column_count: 5,
        empty_state: {
          title: t(".no_items_title"),
          description: t(".no_items_description"),
          icon: "description"
        },
        empty_state_filtered: {
          title: t(".no_results_filtered_title"),
          description: t(".no_results_filtered_description"),
          icon: "filter_alt_off"
        }
      ) do |c| %>
    <% c.with_header_row do %>
      <%= render headers[:title] %>
      <th scope="col" class="kern-table__header" data-field="projekt"><%= t(".projekt") %></th>
      <th scope="col" class="kern-table__header" data-field="author"><%= t(".author") %></th>
      <%= render headers[:flags_count] %>
      <th scope="col" class="kern-table__header" data-field="actions" style="width: 200px"><%= t("shared.table.actions") %></th>
    <% end %>

    <% c.with_body do %>
      <% @proposals.each do |proposal| %>
        <%= render "proposal", proposal: proposal %>
      <% end %>
    <% end %>
  <% end %>
</div>
