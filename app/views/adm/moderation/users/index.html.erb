<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= form_tag adm_moderation_users_path, method: :get, class: "d-flex gap-3 mb-4" do %>
    <div class="kern-form-input">
      <%= text_field_tag :search, params[:search], class: "kern-form-input__input", placeholder: t(".search_placeholder") %>
    </div>
    <%= kern_button icon: "search", text: t(".search_button"), type: :submit %>
  <% end %>

  <% if @users.present? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= User.human_attribute_name(:username) %></th>
            <th scope="col" class="kern-table__header" style="width: 200px"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @users.each do |user| %>
            <%= render "user", user: user %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% end %>
</div>
