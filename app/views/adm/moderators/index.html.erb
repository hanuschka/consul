<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= new_resource_link(new_adm_moderator_path, t('.new_link')) %>

  <% if @moderators.any? %>
    <%= render 'adm/role_assignments/roles', roles: @moderators, pagy: @pagy %>
  <% else %>
    <div class="callout primary margin">
      <%= t(".no_moderators") %>
    </div>
  <% end %>
</div>
