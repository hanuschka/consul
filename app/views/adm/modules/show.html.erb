<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".hint") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <% @module_settings.each do |setting| %>
    <%= render Adm::AttributeEditorComponent.new(setting, :value, :boolean) %>
  <% end %>
</div>
