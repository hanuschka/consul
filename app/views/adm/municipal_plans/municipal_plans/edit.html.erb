<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @municipal_plan.title, breadcrumbs: @breadcrumbs,
                                    back_button_url: adm_municipal_plans_municipal_plan_path(@municipal_plan)) %>

<article class="kern-container mb-5">
  <%= form_with model: @municipal_plan,
        url: adm_municipal_plans_municipal_plan_path(@municipal_plan), method: :patch do |form| %>

    <%= render "form_fields", form: form %>

    <div class="d-flex gap-2 mb-4 mt-5">
      <%= kern_button(text: t("shared.submit"), icon: "save", type: "submit") %>
      <%= kern_link_button(adm_municipal_plans_municipal_plan_path(@municipal_plan),
            text: t("shared.cancel"), style: :secondary) %>
    </div>
  <% end %>
</article>
