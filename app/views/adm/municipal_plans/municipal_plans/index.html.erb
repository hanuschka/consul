<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
  <% if Adm::MunicipalPlans::MunicipalPlanPolicy.new(current_user, nil).new? %>
    <% header.with_actions do %>
      <%= kern_link_button(new_adm_municipal_plans_municipal_plan_path, text: t(".new_button"),
                           style: :primary, data: { turbo_frame: "_top" }) %>
    <% end %>
  <% end %>
<% end %>

<%
  headers = {
    title:              Kern::Table::HeaderComponent.new(:title, t(".table.title"),
                                                         data_field: "title"),
    status:             Kern::Table::HeaderComponent.new(:status, t(".table.status"),
                                                         data_field: "status"),
    districts:          Kern::Table::HeaderComponent.new(:districts, t(".table.districts"),
                                                         data_field: "districts"),
    responsible:        Kern::Table::HeaderComponent.new(:responsible, t(".table.responsible"),
                                                         data_field: "responsible"),
    content_updated_at: Kern::Table::HeaderComponent.new(:content_updated_at,
                                                         t(".table.content_updated_at"),
                                                         data_field: "content_updated_at"),
    version:            Kern::Table::HeaderComponent.new(:version, t(".table.version"),
                                                         data_field: "version")
  }
%>

<div class="kern-container my-5">
  <%= render Adm::IndexTableComponent.new(
        turbo_frame_id: "municipal_plans_table",
        records: @municipal_plans,
        pagy: @pagy,
        headers: headers,
        column_count: 7,
        column_selector: {
          storage_key: "adm-municipal-plans-columns-v2",
          defaults: "title,status,districts,responsible,content_updated_at,version"
        },
        empty_state: {
          title: t(".no_items_title"),
          description: t(".no_items_description"),
          icon: "assignment"
        }
      ) do |c| %>
    <% c.with_header_row do %>
      <%= render headers[:title] %>
      <%= render headers[:status] %>
      <%= render headers[:districts] %>
      <%= render headers[:responsible] %>
      <%= render headers[:content_updated_at] %>
      <%= render headers[:version] %>
      <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
    <% end %>

    <% c.with_body do %>
      <% @municipal_plans.each do |municipal_plan| %>
        <%= render "municipal_plan_row", municipal_plan: municipal_plan %>
      <% end %>
    <% end %>
  <% end %>
</div>
