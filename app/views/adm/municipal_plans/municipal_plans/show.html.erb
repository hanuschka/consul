<% responsible_name = @municipal_plan.responsible&.name %>
<% policy = Adm::MunicipalPlans::MunicipalPlanPolicy.new(current_user, @municipal_plan) %>
<% may_update = policy.update? %>
<% may_edit_archive_date = may_update && !@municipal_plan.working_copy? %>

<%= content_for :title, @municipal_plan.title %>

<%= render Adm::HeaderComponent.new(title: @municipal_plan.title, breadcrumbs: @breadcrumbs,
                                    back_button_url: adm_municipal_plans_root_path) do |header| %>
  <% if may_update %>
    <% header.with_actions do %>
      <div class="ml-auto d-flex flex-wrap align-items-center gap-2">
        <%= kern_link_button(edit_adm_municipal_plans_municipal_plan_path(@municipal_plan),
              text: t("shared.edit"), icon: "edit", style: :primary) %>

        <% if @municipal_plan.draft? && !@municipal_plan.submitted_for_release? && policy.submit? %>
          <%= form_with url: submit_adm_municipal_plans_municipal_plan_path(@municipal_plan),
                method: :patch do %>
            <%= kern_button(type: :submit, text: t(".actions.submit"), icon: "outbox",
                            style: :secondary) %>
          <% end %>
        <% end %>

        <% if @municipal_plan.draft? && policy.release? %>
          <%= form_with url: release_adm_municipal_plans_municipal_plan_path(@municipal_plan),
                method: :patch do %>
            <%= kern_button(type: :submit, text: t(".actions.release"), icon: "task_alt",
                            style: :primary) %>
          <% end %>
        <% end %>

        <% if @municipal_plan.published? && policy.archive? %>
          <%= form_with url: archive_adm_municipal_plans_municipal_plan_path(@municipal_plan),
                method: :patch do %>
            <%= kern_button(type: :submit, text: t(".actions.archive"), icon: "archive",
                            style: :secondary) %>
          <% end %>
        <% end %>

        <% if @municipal_plan.archived? && policy.unarchive? %>
          <%= form_with url: unarchive_adm_municipal_plans_municipal_plan_path(@municipal_plan),
                method: :patch do %>
            <%= kern_button(type: :submit, text: t(".actions.unarchive"), icon: "unarchive",
                            style: :secondary) %>
          <% end %>
        <% end %>

        <% if policy.convert? %>
          <%= kern_link_button(new_adm_municipal_plans_municipal_plan_projekt_conversion_path(@municipal_plan),
                text: t(".actions.convert"), icon: "rocket_launch", style: :secondary) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<div class="kern-container mb-5">

  <% if @municipal_plan.working_copy.present? %>
    <div class="mb-5">
      <%= kern_alert(title: t(".release_pending.title")) do %>
        <p class="kern-body mb-3"><%= t(".release_pending.body") %></p>
        <%= kern_link_button(adm_municipal_plans_municipal_plan_path(@municipal_plan.working_copy),
              text: t(".release_pending.link"), icon: "arrow_forward") %>
      <% end %>
    </div>
  <% elsif @municipal_plan.working_copy? %>
    <div class="mb-5">
      <%= kern_alert(title: t(".working_copy.title")) do %>
        <p class="kern-body mb-3"><%= t(".working_copy.body") %></p>
        <%= kern_link_button(adm_municipal_plans_municipal_plan_path(@municipal_plan.released_plan),
              text: t(".working_copy.link"), icon: "arrow_back") %>
      <% end %>
    </div>
  <% end %>

  <% if @municipal_plan.draft? && @municipal_plan.submitted_for_release? %>
    <p class="kern-body mb-5"><%= t(".submitted_hint") %></p>
  <% end %>

  <% if @municipal_plan.working_copy? %>
    <% plan_changes = ::MunicipalPlans::ChangeSummaryService.call(@municipal_plan) %>

    <section class="adm-detail-section">
      <h2 class="adm-detail-section-title mb-3"><%= t(".changes.title") %></h2>

      <% if plan_changes.any? %>
        <div class="adm-detail-table">
          <div class="adm-detail-table__row">
            <div class="adm-detail-table__label"><%= t(".changes.field") %></div>
            <div class="adm-detail-table__value strong"><%= t(".changes.released") %></div>
            <div class="adm-detail-table__value strong"><%= t(".changes.new") %></div>
          </div>

          <% plan_changes.each do |plan_change| %>
            <div class="adm-detail-table__row">
              <div class="adm-detail-table__label"><%= plan_change.label %></div>
              <% if plan_change.kind == :map %>
                <div class="adm-detail-table__value"><%= t(".changes.map_changed") %></div>
              <% else %>
                <div class="adm-detail-table__value">
                  <%= render "change_value", kind: plan_change.kind, value: plan_change.before %>
                </div>
                <div class="adm-detail-table__value">
                  <%= render "change_value", kind: plan_change.kind, value: plan_change.after %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="kern-body m-0"><%= t(".changes.no_changes") %></p>
      <% end %>
    </section>
  <% end %>

  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".sections.content") %></h2>

    <div class="adm-content-card mb-4">
      <div class="adm-content-card__body">
        <h3 class="adm-detail-content-title mb-2"><%= @municipal_plan.title %></h3>
        <div class="adm-detail-description">
          <%= auto_link_already_sanitized_html wysiwyg(@municipal_plan.short_description) %>
        </div>
      </div>
    </div>

    <%
      content_rows = []

      if @municipal_plan.further_information.present?
        content_rows << { label: t(".further_information"),
                          value: auto_link_already_sanitized_html(wysiwyg(@municipal_plan.further_information)) }
      end

      if @municipal_plan.last_resolution.present?
        content_rows << { label: t(".last_resolution"),
                          value: auto_link_already_sanitized_html(wysiwyg(@municipal_plan.last_resolution)) }
      end

      content_rows << { label: t(".processing_status"),
                        value: auto_link_already_sanitized_html(wysiwyg(@municipal_plan.processing_status)) }

      content_rows << { label: t(".next_steps"),
                        value: auto_link_already_sanitized_html(wysiwyg(@municipal_plan.next_steps)) }

      if @municipal_plan.costs.present?
        content_rows << { label: t(".costs"), value: @municipal_plan.costs }
      end
    %>

    <div class="adm-detail-table">
      <% content_rows.each do |row| %>
        <div class="adm-detail-table__row">
          <div class="adm-detail-table__label"><%= row[:label] %></div>
          <div class="adm-detail-table__value"><%= row[:value] %></div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".sections.assignment") %></h2>

    <div class="adm-detail-table">
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".districts") %></div>
        <div class="adm-detail-table__value">
          <%= @municipal_plan.districts.map(&:name_for_display).join(", ").presence || t(".none") %>
        </div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".topics") %></div>
        <div class="adm-detail-table__value">
          <%= @municipal_plan.topics.map(&:name).join(", ").presence || t(".none") %>
        </div>
      </div>
    </div>
  </section>

  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".sections.participation") %></h2>

    <div class="adm-detail-table">
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".formal_participation") %></div>
        <div class="adm-detail-table__value">
          <%= t("shared.#{@municipal_plan.formal_participation}") %>
          <% if @municipal_plan.formal_participation_reason.present? %>
            <p class="mb-0 mt-2"><%= @municipal_plan.formal_participation_reason %></p>
          <% end %>
        </div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".informal_participation") %></div>
        <div class="adm-detail-table__value">
          <%= t("shared.#{@municipal_plan.informal_participation}") %>
          <% if @municipal_plan.informal_participation_reason.present? %>
            <p class="mb-0 mt-2"><%= @municipal_plan.informal_participation_reason %></p>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <% linked_projekts = @municipal_plan.projekts.includes(page: :translations).to_a %>
  <% if linked_projekts.any? %>
    <section class="adm-detail-section">
      <h2 class="adm-detail-section-title mb-3"><%= t(".projekts.title") %></h2>

      <ul class="mb-0">
        <% linked_projekts.each do |linked_projekt| %>
          <li>
            <%= link_to linked_projekt.title, details_adm_projekts_projekt_path(linked_projekt),
                  class: "kern-link" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".sections.revision") %></h2>

    <div class="adm-detail-table">
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".content_updated_at") %></div>
        <div class="adm-detail-table__value">
          <% if @municipal_plan.content_updated_at.present? %>
            <%= l(@municipal_plan.content_updated_at, format: "%d.%m.%Y") %>
          <% else %>
            <%= t(".none") %>
          <% end %>
        </div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".version") %></div>
        <div class="adm-detail-table__value"><%= @municipal_plan.version %></div>
      </div>
    </div>
  </section>

  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".sections.links") %></h2>

    <% if @municipal_plan.links.any? %>
      <ul class="mb-0">
        <% @municipal_plan.links.each do |link| %>
          <li>
            <%= link_to link.title, link.url, class: "kern-link", target: "_blank", rel: "noopener" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="kern-body m-0"><%= t(".no_links") %></p>
    <% end %>
  </section>

  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".sections.contact") %></h2>

    <div class="adm-detail-table">
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".contact_name") %></div>
        <div class="adm-detail-table__value"><%= @municipal_plan.contact_name.presence || t(".none") %></div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".contact_role") %></div>
        <div class="adm-detail-table__value"><%= @municipal_plan.contact_role.presence || t(".none") %></div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".contact_phone") %></div>
        <div class="adm-detail-table__value"><%= @municipal_plan.contact_phone.presence || t(".none") %></div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".contact_email") %></div>
        <div class="adm-detail-table__value"><%= @municipal_plan.contact_email.presence || t(".none") %></div>
      </div>
    </div>
  </section>

  <% if @municipal_plan.map_location.present? %>
    <section class="adm-detail-section">
      <h2 class="adm-detail-section-title mb-3"><%= t(".sections.map") %></h2>

      <div class="adm-detail-media-card">
        <% pin = @municipal_plan.map_location.pin_coordinates %>
        <%= render Kern::MapComponent.new(
          map_location: @municipal_plan.map_location,
          gesture_handling: false,
          height: 400,
          latitude: pin&.dig(:latitude),
          longitude: pin&.dig(:longitude),
          zoom: pin ? 18 : nil
        ) %>
      </div>
    </section>
  <% end %>

  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t(".sections.administration") %></h2>

    <div class="adm-detail-table">
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".responsible") %></div>
        <div class="adm-detail-table__value"><%= responsible_name.presence || t(".none") %></div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".system_mailbox_email") %></div>
        <div class="adm-detail-table__value">
          <%= @municipal_plan.system_mailbox_email.presence || t(".none") %>
        </div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".internal_notes") %></div>
        <div class="adm-detail-table__value">
          <% if @municipal_plan.internal_notes.present? %>
            <%= simple_format(@municipal_plan.internal_notes) %>
          <% else %>
            <%= t(".none") %>
          <% end %>
        </div>
      </div>
      <div class="adm-detail-table__row">
        <div class="adm-detail-table__label"><%= t(".status") %></div>
        <div class="adm-detail-table__value">
          <%= t("adm.municipal_plans.statuses.#{@municipal_plan.status}") %>
        </div>
      </div>

      <% if may_edit_archive_date %>
        <div class="adm-detail-table__row">
          <div class="adm-detail-table__label"><%= t(".archive_date.label") %></div>
          <div class="adm-detail-table__value">
            <% if @municipal_plan.archive_on.present? %>
              <%= l(@municipal_plan.archive_on, format: "%d.%m.%Y") %>
            <% else %>
              <%= t(".none") %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if may_edit_archive_date %>
      <div class="mt-4">
        <%= form_with url: archive_date_adm_municipal_plans_municipal_plan_path(@municipal_plan),
              scope: :municipal_plan, method: :patch do |f| %>
          <div class="d-flex flex-wrap align-items-end gap-3">
            <%= f.date_field :archive_on, value: @municipal_plan.archive_on,
                  label: t(".archive_date.label") %>
            <%= kern_button(type: :submit, text: t(".archive_date.submit"), icon: "event_available",
                            style: :secondary) %>
          </div>
        <% end %>

        <p class="kern-body kern-body--small mt-2 mb-0"><%= t(".archive_date.hint") %></p>
      </div>
    <% end %>
  </section>

  <% if may_update && !@municipal_plan.working_copy? %>
    <section class="adm-detail-section">
      <h2 class="adm-detail-section-title mb-3"><%= t(".notices.title") %></h2>

      <% if @municipal_plan.notices.any? %>
        <% @municipal_plan.notices.each do |plan_notice| %>
          <% notice_date = l(plan_notice.created_at, format: "%d.%m.%Y") %>
          <div class="adm-content-card mb-3">
            <div class="adm-content-card__header d-flex flex-wrap align-items-center gap-3">
              <div>
                <p class="strong m-0"><%= plan_notice.name.presence || t(".notices.no_name") %></p>
                <p class="m-0">
                  <%= notice_date %> &middot; <%= mail_to plan_notice.email, class: "kern-link" %>
                </p>
              </div>

              <%= form_with url: adm_municipal_plans_municipal_plan_notice_path(@municipal_plan, plan_notice),
                    method: :delete,
                    data: { turbo_confirm: t(".notices.delete_confirm", date: notice_date) } do %>
                <%= kern_button(type: :submit, text: t(".notices.delete"), icon: "delete",
                                style: :danger,
                                "aria-label": t(".notices.delete_aria", date: notice_date)) %>
              <% end %>
            </div>

            <div class="adm-content-card__body">
              <%= simple_format(plan_notice.body) %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="kern-body m-0"><%= t(".notices.empty") %></p>
      <% end %>
    </section>
  <% end %>

  <section class="adm-detail-section">
    <%= render "adm/shared/audits",
          auditable: @municipal_plan,
          audit_show_path: ->(audit) { adm_municipal_plans_municipal_plan_audit_path(@municipal_plan, audit) } %>
  </section>

</div>
