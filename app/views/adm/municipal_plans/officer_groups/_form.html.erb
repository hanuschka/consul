<% url = if @officer_group.persisted?
           adm_municipal_plans_officer_group_path(@officer_group)
         else
           adm_municipal_plans_officer_groups_path
         end %>
<% officers = MunicipalPlan::Officer.joins(:user).includes(:user).order("users.username ASC") %>

<%= form_with model: @officer_group, url: url do |f| %>

  <%= render Kern::FormFieldComponent.new(label: t(".name_label"), hint: t(".name_hint"), required: true) do %>
    <%= f.text_field :name, label: false, placeholder: t(".name_placeholder") %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".default_email_label"), hint: t(".default_email_hint")) do %>
    <%= f.email_field :default_email, label: false, placeholder: t(".default_email_placeholder") %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".officers_label"), hint: t(".officers_hint")) do %>
    <% if officers.any? %>
      <%= f.collection_check_boxes :officer_ids, officers, :id, :name %>
    <% else %>
      <%= empty_state(title: t(".no_officers_title"), description: t(".no_officers_description"),
                      icon: "person_off") %>
    <% end %>
  <% end %>

  <%= form_submit_button(text: f.object.new_record? ? t("shared.create") : t(".submit")) %>
<% end %>
