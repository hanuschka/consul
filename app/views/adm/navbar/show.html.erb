<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <div class="d-flex justify-content-end mb-4">
    <%= link_to t('.new_item'), new_adm_navbar_item_path, class: "kern-link" %>
  </div>

  <div data-controller="sortable" data-sortable-url-value="<%= reorder_adm_navbar_items_path %>">
    <%= render @navbar_items %>
  </div>
</div>
