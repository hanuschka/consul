<tr id="<%= dom_id(newsletter) %>" class="kern-table__row">
  <td scope="row" class="kern-table__header"><%= newsletter.subject %></td>
  <td class="kern-table__cell"><%= newsletter.recipient_group&.name %></td>
  <td class="kern-table__cell">
    <% if newsletter.draft? %>
      <%= t('adm.newsletters.index.table.draft') %>
    <% else %>
      <%= l newsletter.sent_at.to_date %>
    <% end %>
  </td>
  <td class="kern-table__cell">
    <div class="d-flex align-items-center gap-1">
      <%= kern_link_button(
        adm_newsletter_path(newsletter),
        icon: "visibility",
        style: :tertiary,
        class: "kern-btn--xs",
        title: t('adm.newsletters.index.table.show'),
        "aria-label": t('adm.newsletters.index.table.show')
      ) %>
      <%= kern_link_button(
        edit_adm_newsletter_path(newsletter),
        icon: "edit",
        style: :tertiary,
        class: "kern-btn--xs",
        title: t('adm.newsletters.index.table.edit'),
        "aria-label": t('adm.newsletters.index.table.edit')
      ) %>
      <%= kern_link_button(
        adm_newsletter_path(newsletter),
        icon: "delete",
        style: :tertiary,
        class: "kern-btn--xs kern-btn--danger",
        title: t('adm.newsletters.index.table.delete'),
        "aria-label": t('adm.newsletters.index.table.delete'),
        data: { turbo_method: :delete, turbo_confirm: t('adm.newsletters.index.table.delete_confirm') }
      ) %>
    </div>
  </td>
</tr>
