<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro_text_p1") %></p>
    <p class="adm-hint__text adm-hint__text--spaced"><%= t(".intro_text_p2") %></p>
  <% end %>
<% end %>

<div class="mb-3"></div>

<%= render Adm::TabsComponent.new(tabs: [
  { label: t(".tabs.list"), url: adm_newsletters_path, current: true },
  { label: t(".tabs.recipient_groups"), url: adm_recipient_groups_path },
  { label: t(".tabs.unregistered_subscribers"), url: adm_unregistered_newsletter_subscribers_path },
  { label: t(".tabs.settings"), url: settings_adm_newsletters_path }
]) %>

<div class="kern-container my-5">

  <%= new_resource_link(new_adm_newsletter_path, t('.new_newsletter')) %>

  <% if @newsletters.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t('.table.subject') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.recipient_group') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.sent') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <%= render partial: "newsletter", collection: @newsletters %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".empty_title"), description: t(".empty_description"), icon: "mail") %>
  <% end %>
</div>
