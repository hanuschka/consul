<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, back_button_url: adm_newsletters_path, narrow: true) %>

<% recipient_groups_exist = RecipientGroup.any? %>

<div class="kern-container my-5">
  <%= form_with model: [:adm, @newsletter] do |f| %>
    <%= render Kern::FormFieldComponent.new(
      label: Newsletter.human_attribute_name(:subject),
      hint: t(".hints.subject"),
      divider: false
    ) do %>
      <%= f.text_field :subject, label: false, placeholder: t(".placeholders.subject") %>
    <% end %>

    <% if recipient_groups_exist %>
      <%= render Kern::FormFieldComponent.new(
        label: Newsletter.human_attribute_name(:recipient_group),
        hint: t(".hints.recipient_group"),
        divider: false
      ) do %>
        <%= f.select :recipient_group_id,
          options_for_select(RecipientGroup.all.map { |rg| [rg.name, rg.id] }, f.object.recipient_group_id),
          { prompt: t("custom.shared.select") },
          label: false %>
        <div class="mt-2">
          <%= link_to t(".create_recipient_group_link"),
            new_adm_recipient_group_path,
            class: "kern-link kern-body kern-body--small",
            target: "_blank",
            rel: "noopener" %>
        </div>
      <% end %>
    <% else %>
      <%= empty_state(
        title: t(".empty_recipient_groups.title"),
        description: t(".empty_recipient_groups.description"),
        icon: "group_add",
        link_url: new_adm_recipient_group_path,
        link_text: t(".empty_recipient_groups.cta"),
        link_class: "adm-empty-state__link kern-btn kern-btn--primary mt-3",
        link_target: "_blank",
        link_rel: "noopener"
      ) %>
    <% end %>

    <%= f.hidden_field :from, value: (f.object.from || Setting['mailer_from_address']) %>

    <% if recipient_groups_exist %>
      <%= form_submit_button(text: t("shared.create")) %>
    <% end %>
  <% end %>
</div>
