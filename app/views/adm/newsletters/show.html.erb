<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, back_button_url: adm_newsletters_path) %>

<div class="kern-container my-5">

  <div class="kern-card adm-newsletter-summary mb-5">
    <div class="adm-newsletter-summary--main">
      <div class="adm-newsletter-summary--heading">
        <p class="adm-newsletter-summary--eyebrow"><%= t("adm.newsletters.show.subject") %></p>
        <h2 class="adm-newsletter-summary--title"><%= @newsletter.subject %></h2>
      </div>

      <dl class="adm-newsletter-summary--meta">
        <div class="adm-newsletter-summary--item">
          <span class="adm-newsletter-summary--icon">
            <span class="kern-icon kern-icon--small kern-icon--mail" aria-hidden="true"></span>
          </span>
          <div class="adm-newsletter-summary--pair">
            <dt class="adm-newsletter-summary--label"><%= t("adm.newsletters.show.from") %></dt>
            <dd class="adm-newsletter-summary--value"><%= @newsletter.from %></dd>
          </div>
        </div>

        <div class="adm-newsletter-summary--item">
          <span class="adm-newsletter-summary--icon">
            <span class="kern-icon kern-icon--small kern-icon--checklist" aria-hidden="true"></span>
          </span>
          <div class="adm-newsletter-summary--pair">
            <dt class="adm-newsletter-summary--label"><%= t("adm.newsletters.show.recipient_group") %></dt>
            <dd class="adm-newsletter-summary--value">
              <%= @newsletter.recipient_group.present? ? @newsletter.recipient_group.name : "—" %>
            </dd>
          </div>
        </div>

        <div class="adm-newsletter-summary--item">
          <span class="adm-newsletter-summary--icon">
            <span class="kern-icon kern-icon--small kern-icon--calendar-today" aria-hidden="true"></span>
          </span>
          <div class="adm-newsletter-summary--pair">
            <dt class="adm-newsletter-summary--label"><%= t("adm.newsletters.show.sent_at") %></dt>
            <dd class="adm-newsletter-summary--value">
              <%= @newsletter.draft? ? "—" : l(@newsletter.sent_at.to_date) %>
            </dd>
          </div>
        </div>
      </dl>
    </div>

    <aside class="adm-newsletter-summary--side">
      <% if @newsletter.draft? %>
        <span class="kern-badge kern-badge--info adm-newsletter-summary--status">
          <span class="kern-icon kern-icon--draft" aria-hidden="true"></span>
          <span class="kern-label"><%= t("adm.newsletters.index.table.draft") %></span>
        </span>
      <% else %>
        <span class="kern-badge kern-badge--success adm-newsletter-summary--status">
          <span class="kern-icon kern-icon--check" aria-hidden="true"></span>
          <span class="kern-label"><%= t("adm.newsletters.index.table.sent") %></span>
        </span>
      <% end %>

      <div class="adm-newsletter-summary--stats">
        <div class="adm-newsletter-summary--stat">
          <span class="adm-newsletter-summary--stat-value"><%= @recipients_count %></span>
          <span class="adm-newsletter-summary--stat-label"><%= t("adm.newsletters.show.recipients") %></span>
        </div>

        <div class="adm-newsletter-summary--stat">
          <span class="adm-newsletter-summary--stat-value"><%= @newsletter.activities.count %></span>
          <span class="adm-newsletter-summary--stat-label"><%= t("adm.newsletters.show.sent_emails") %></span>
        </div>
      </div>
    </aside>
  </div>

  <h3 class="kern-heading-small mb-1"><%= t("adm.newsletters.show.body") %></h3>
  <p class="kern-body kern-body--muted mb-3"><%= t("adm.newsletters.show.body_help_text") %></p>

  <div class="kern-card p-4 mb-4">
    <% if Setting["advanced_newsletter"].present? %>
      <%= render template: "mailer/newsletter" %>
    <% else %>
      <%= render "mailer/newsletter_simple_header" %>
      <table cellpadding="0" cellspacing="0" border="0" style="background: #fff; margin: 0 auto; max-width: 700px; width:100%;">
        <tbody><tr><td style="padding: 20px 0;">
          <%= auto_link_already_sanitized_html wysiwyg(@newsletter.email_safe_body(container_width: 660)) %>
        </td></tr></tbody>
      </table>
      <%= render "mailer/newsletter_simple_footer" %>
    <% end %>
  </div>

  <div class="d-flex gap-3 mb-5">
    <% if @newsletter.valid_segment_recipient? || @newsletter.recipient_group.present? %>
      <%= kern_link_button(
        deliver_adm_newsletter_path(@newsletter),
        text: t('.send'),
        style: :primary,
        data: {
          turbo_method: :post,
          turbo_confirm: t('.send_alert', n: @recipients_count)
        }
      ) %>
    <% end %>

    <%= kern_link_button(
      send_test_adm_newsletter_path(@newsletter),
      text: t('.send_test'),
      style: :secondary,
      data: { turbo_method: :post }
    ) %>
  </div>

  <h3 class="kern-heading-small mb-3"><%= t("adm.newsletters.show.recipient_emails") %></h3>
  <div class="kern-card adm-newsletter-recipients p-4 mb-4">
    <p class="kern-body kern-body--muted mb-0"><%= @newsletter.list_of_recipient_emails&.join(", ") %></p>
  </div>
</div>
