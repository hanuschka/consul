<tr class="kern-table__row" id="<%= dom_id(offer_manager) %>">
  <th scope="row" class="kern-table__header"><%= offer_manager.id %></th>
  <td class="kern-table__cell"><%= offer_manager.name %></td>
  <td class="kern-table__cell"><%= offer_manager.email %></td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t("shared.delete"), url: adm_offers_manager_path(offer_manager), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
    <% end %>
  </td>
</tr>
