<% if form.object.errors[:base].any? %>
  <div class="mb-5">
    <%= kern_alert(title: t(".errors_title"), style: :danger) do %>
      <ul class="mb-0">
        <% form.object.errors[:base].each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<% open_all = form.object.errors.any? %>

<%= tag.details class: "kern-accordion", name: ("offer-form" unless open_all), open: true do %>
  <summary class="kern-accordion__header"><span class="kern-title"><%= t(".sections.basics") %></span></summary>
  <section class="kern-accordion__body">
    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:provider),
                                            hint: t(".hints.provider"),
                                            form: form, attribute: :provider_id) do %>
      <%= form.select :provider_id, @providers.map { |provider| [provider.name, provider.id] },
                      { include_blank: t(".provider_blank") }, { label: false } %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:title),
                                            hint: t(".hints.title"), required: true,
                                            form: form, attribute: :title) do %>
      <%= form.text_field :title, label: false, placeholder: t(".placeholders.title") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:short_description),
                                            hint: t(".hints.short_description"),
                                            required: true, stacked: true,
                                            form: form, attribute: :short_description) do %>
      <%= form.rich_text_area :short_description, label: false, rows: 4, class: "mb-2",
            placeholder: t(".placeholders.short_description") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: t(".image_label"), hint: t(".hints.image"),
                                            stacked: true) do %>
      <%= render Kern::Form::ImageableImageComponent.new(form: form) %>
    <% end %>
  </section>
<% end %>

<%= tag.details class: "kern-accordion", name: ("offer-form" unless open_all), open: open_all do %>
  <summary class="kern-accordion__header"><span class="kern-title"><%= t(".sections.categories") %></span></summary>
  <section class="kern-accordion__body">
    <%= hidden_field_tag "offer[category_ids][]", "", id: nil %>

    <% Offer::Category::KINDS.each do |kind| %>
      <%= render Kern::FormFieldComponent.new(divider: false,
                                              label: t("activerecord.attributes.offer/category.kinds.#{kind}"),
                                              hint: t(".hints.category_kinds.#{kind}"),
                                              required: Offer::REQUIRED_CATEGORY_KINDS.include?(kind),
                                              stacked: true) do %>
        <% categories = @categories_by_kind.fetch(kind, []) %>
        <% if categories.any? %>
          <div class="mb-2">
            <%= form.collection_check_boxes :category_ids, categories, :id, :name, { include_hidden: false } %>
          </div>
        <% else %>
          <%= empty_state(title: t(".no_categories_title"), description: t(".no_categories_description"),
                          icon: "category") %>
        <% end %>
      <% end %>
    <% end %>
  </section>
<% end %>

<%= tag.details class: "kern-accordion", name: ("offer-form" unless open_all), open: open_all do %>
  <summary class="kern-accordion__header"><span class="kern-title"><%= t(".sections.location") %></span></summary>
  <section class="kern-accordion__body">
    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:address),
                                            hint: t(".hints.address"), form: form, attribute: :address) do %>
      <%= form.text_field :address, label: false, placeholder: t(".placeholders.address") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:map_location),
                                            hint: t(".hints.map_location"), stacked: true) do %>
      <%= form.fields_for :map_location do |map_form| %>
        <%= render Kern::MapComponent.new(
          map_location: form.object.map_location,
          form: map_form,
          editable: true,
          admin_editor: false,
          height: 500,
          error: form.object.errors[:map_location].to_sentence.presence
        ) %>
      <% end %>
    <% end %>
  </section>
<% end %>

<%= tag.details class: "kern-accordion", name: ("offer-form" unless open_all), open: open_all do %>
  <summary class="kern-accordion__header"><span class="kern-title"><%= t(".sections.details") %></span></summary>
  <section class="kern-accordion__body">
    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:times),
                                            hint: t(".hints.times"), stacked: true,
                                            form: form, attribute: :times) do %>
      <%= form.text_area :times, label: false, rows: 4, class: "mb-2", placeholder: t(".placeholders.times") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:costs),
                                            hint: t(".hints.costs"), stacked: true,
                                            form: form, attribute: :costs) do %>
      <%= form.text_area :costs, label: false, rows: 4, class: "mb-2", placeholder: t(".placeholders.costs") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:registration),
                                            hint: t(".hints.registration"), stacked: true,
                                            form: form, attribute: :registration) do %>
      <%= form.text_area :registration, label: false, rows: 4, class: "mb-2",
            placeholder: t(".placeholders.registration") %>
    <% end %>
  </section>
<% end %>

<%= tag.details class: "kern-accordion", name: ("offer-form" unless open_all), open: open_all do %>
  <summary class="kern-accordion__header"><span class="kern-title"><%= t(".sections.contact") %></span></summary>
  <section class="kern-accordion__body">
    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:contact_name),
                                            form: form, attribute: :contact_name) do %>
      <%= form.text_field :contact_name, label: false, placeholder: t(".placeholders.contact_name") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:contact_phone),
                                            form: form, attribute: :contact_phone) do %>
      <%= form.telephone_field :contact_phone, label: false, placeholder: t(".placeholders.contact_phone") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:contact_email),
                                            form: form, attribute: :contact_email) do %>
      <%= form.email_field :contact_email, label: false, placeholder: t(".placeholders.contact_email") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, label: Offer.human_attribute_name(:contact_website),
                                            hint: t(".hints.contact_website"),
                                            form: form, attribute: :contact_website) do %>
      <%= form.url_field :contact_website, label: false, placeholder: t(".placeholders.contact_website") %>
    <% end %>
  </section>
<% end %>

<div class="d-flex gap-2 mb-4 mt-5">
  <%= kern_button(text: t("shared.submit"), icon: "save", type: "submit") %>
  <%= kern_link_button(adm_offers_root_path, text: t("shared.cancel"), style: :secondary) %>
</div>
