<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs,
                                    back_button_url: adm_offers_root_path) %>

<article class="kern-container mb-5">
  <%= form_with model: @offer, url: adm_offers_offer_path(@offer), method: :patch, multipart: true do |form| %>
    <%= render "form", form: form %>
  <% end %>
</article>
