<% registered = provider.users.size %>
<% pending = provider.auto_join_emails.size %>
<tr id="<%= dom_id(provider) %>" class="kern-table__row">
  <th scope="row" class="kern-table__header" data-field="name">
    <%= link_to provider.name, edit_adm_offers_provider_path(provider), class: "kern-link",
                data: { turbo_frame: "_top" } %>
  </th>
  <td class="kern-table__cell" data-field="addresses">
    <% if registered + pending > 0 %>
      <%= t(".addresses_summary", registered: registered, pending: pending) %>
    <% else %>
      <%= t(".no_addresses") %>
    <% end %>
  </td>
  <td class="kern-table__cell" data-field="offers"><%= provider.offers.size %></td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(
        label: t("shared.edit"),
        url: edit_adm_offers_provider_path(provider),
        icon: "edit",
        style: :edit,
        data: { turbo_frame: "_top" }
      ) %>
      <% actions.with_action(
        label: t("shared.delete"),
        url: adm_offers_provider_path(provider),
        icon: "delete",
        style: :delete,
        data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete"), turbo_frame: "_top" },
        show: provider.offers.empty?
      ) %>
    <% end %>
  </td>
</tr>
