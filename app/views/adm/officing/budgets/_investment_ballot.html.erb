<% line = lines_by_investment_id[investment.id] %>
<% label = "#{investment.title} ##{investment.id}" %>
<% label += " — #{investment.formatted_price}" if investment.formatted_price.present? %>

<%= render Kern::FormFieldComponent.new(
  inline: true,
  label: label,
  divider: true) do %>

  <% if line %>
    <% if budget.distributed_voting? %>
      <p class="mb-2"><%= t(".weight", count: line.line_weight) %></p>
    <% end %>

    <%= form_with(url: adm_officing_budget_ballot_line_path(budget, line, offline_user_id: offline_user.id), method: :delete) do %>
      <%= form_submit_button(text: t(".revoke"), style: :secondary) %>
    <% end %>
  <% else %>
    <%= form_with(url: adm_officing_budget_ballot_lines_path(budget, investment_id: investment.id, offline_user_id: offline_user.id), method: :post, class: "d-flex align-items-center gap-2") do |f| %>
      <% if budget.distributed_voting? %>
        <% remaining = ballot.amount_available(investment.heading) %>
        <% if remaining > 0 %>
          <%= select_tag :line_weight, options_for_select((1..remaining).map { |i| [i, i] }), class: "kern-form-input__input" %>
        <% end %>
      <% end %>
      <%= kern_button(icon: "how_to_vote", text: t(".vote"), type: :submit) %>
    <% end %>
  <% end %>
<% end %>
