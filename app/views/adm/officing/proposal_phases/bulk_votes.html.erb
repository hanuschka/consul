<%= render Adm::HeaderComponent.new(
  title: @proposal_phase.projekt.name,
  back_button_url: adm_officing_root_path,
  breadcrumbs: [
    { name: t("adm.officing.dashboard.title"), url: adm_officing_root_path },
    { name: @proposal_phase.projekt.name },
    { name: t("adm.officing.proposal_phases.bulk_votes.title") }
  ]
) %>

<div class="kern-container my-5">
  <div class="kern-table-responsive my-5" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header">ID</th>
          <th scope="col" class="kern-table__header"><%= t("adm.officing.proposal_phases.bulk_votes.proposal") %></th>
          <th scope="col" class="kern-table__header"></th>
          <th scope="col" class="kern-table__header" style="width: 22rem;"><%= t("adm.officing.proposal_phases.bulk_votes.vote_count") %></th>
        </tr>
      </thead>

      <tbody class="kern-table__body">
        <% @proposals.each do |proposal| %>
          <%= render "adm/officing/proposal_phases/bulk_vote_row", proposal: proposal, proposal_phase: @proposal_phase %>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy&.pages.to_i > 1 %>
</div>
