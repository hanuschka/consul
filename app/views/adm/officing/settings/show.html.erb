<%= content_for :title, t("adm.officing.menu.items.settings") %>

<%= render Adm::HeaderComponent.new(title: t("adm.officing.menu.items.settings"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: [
  {
    label: t("adm.officing.settings.tabs.dashboard"),
    url: adm_officing_settings_path,
    current: true
  },
  {
    label: t("adm.officing.settings.tabs.contact_persons"),
    url: contact_persons_adm_officing_settings_path
  }
]) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.officing.intro_text"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.officing.notice_message"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.officing.notice_active"), :value, :boolean) %>
</div>
