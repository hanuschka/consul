<tr class="kern-table__row" id="<%= dom_id(projekt_phase) %>">
  <th scope="row" class="kern-table__header">
    <%= projekt_phase.title %>
  </th>
  <td class="kern-table__cell"><%= projekt_phase.start_date %></td>
  <td class="kern-table__cell"><%= projekt_phase.end_date %></td>
  <td class="kern-table__cell"><%= restriction_label_for(projekt_phase) %></td>
  <td class="kern-table__cell">
    <div id="<%= dom_id(projekt_phase, :default_phase) %>">
      <%= render Adm::AttributeEditors::BooleanComponent.new(
        projekt_phase,
        :default_phase,
        path: update_default_phase_adm_projekt_path(projekt_phase.projekt, projekt_phase_id: projekt_phase.id)
      ) %>
    </div>
  </td>
  <td class="kern-table__cell">
    <div id="<%= dom_id(projekt_phase, :active) %>">
      <%= render Adm::AttributeEditors::BooleanComponent.new(
        projekt_phase,
        :active,
        path: toggle_active_adm_projekt_phase_path(projekt_phase)
      ) %>
    </div>
  </td>
  <td class="kern-table__cell">
    <div id="<%= dom_id(projekt_phase, :frontend_visibility) %>">
      <%= render Adm::AttributeEditors::BooleanComponent.new(
        projekt_phase,
        :frontend_visibility,
        path: toggle_frontend_visibility_adm_projekt_phase_path(projekt_phase)
      ) %>
    </div>
  </td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% projekt_phase_table_actions(projekt_phase).each do |action| %>
        <% actions.with_action(label: action[:label], url: action[:url]) %>
      <% end %>
    <% end %>
  </td>
</tr>
