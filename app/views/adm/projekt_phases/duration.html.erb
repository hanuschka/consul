<%= content_for :title, [@projekt_phase.title, t("adm.projekt_phases.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <%= render Kern::FormFieldComponent.new(label: t('.dates_label'), hint: t('.dates_description')) do %>
    <%= render 'adm/projekt_phases/duration/dates', projekt_phase: @projekt_phase %>
  <% end %>
</div>
