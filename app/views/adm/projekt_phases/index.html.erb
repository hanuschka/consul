<%= content_for :title, [@projekt.name, t("adm.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt.name, breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <%= intro_section(title: t(".intro_title"), text: t(".intro_text")) %>

  <%= new_resource_link(new_adm_projekt_projekt_phase_path(@projekt), t(".new_phase")) %>

  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <%= render Kern::Table::HeaderComponent.new(:phase_tab_name, t(".table.phase_tab_name"), **@name_header_options) %>
          <th scope="col" class="kern-table__header"><%= t(".table.start_date") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.end_date") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.restriction") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.default") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.active") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.visible") %></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% @projekt_phases.each do |projekt_phase| %>
          <%= render "projekt_phase", projekt_phase: projekt_phase %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
