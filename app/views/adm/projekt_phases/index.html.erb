<%= content_for :title, [@projekt.name, t("adm.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt.name, breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <h3 class="kern-title kern-title--small mb-3"><%= t(".intro_title") %></h3>
    <p class="kern-body"><%= t(".intro_text_p1") %></p>
    <dl class="kern-description-list kern-description-list--col">
      <div class="kern-description-list-item">
        <dt class="kern-description-list-item__key"><%= t(".intro_text_standard_title") %></dt>
        <dd class="kern-description-list-item__value"><%= t(".intro_text_standard_description") %></dd>
      </div>
      <div class="kern-description-list-item">
        <dt class="kern-description-list-item__key"><%= t(".intro_text_active_title") %></dt>
        <dd class="kern-description-list-item__value"><%= t(".intro_text_active_description") %></dd>
      </div>
      <div class="kern-description-list-item">
        <dt class="kern-description-list-item__key"><%= t(".intro_text_visible_title") %></dt>
        <dd class="kern-description-list-item__value"><%= t(".intro_text_visible_description") %></dd>
      </div>
    </dl>
    <p class="kern-body"><%= t(".intro_text_p2") %></p>
  <% end %>
<% end %>

<div class="kern-container mb-5">

  <%= new_resource_link(new_adm_projekt_projekt_phase_path(@projekt), t(".new_phase")) %>

  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <%= render Kern::Table::HeaderComponent.new(:phase_tab_name, t(".table.phase_tab_name"), **@name_header_options) %>
          <th scope="col" class="kern-table__header"><%= t(".table.start_date") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.end_date") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.restriction") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.default") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.active") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.visible") %></th>
          <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% @projekt_phases.each do |projekt_phase| %>
          <%= render "projekt_phase", projekt_phase: projekt_phase %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
