<%= content_for :title, [@projekt_phase.title, t("adm.projekt_phases.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <%= render Kern::FormFieldComponent.new(label: t('.phase_tab_name_label'), hint: t('.phase_tab_name_description')) do %>
    <%= render 'adm/projekt_phases/naming/phase_tab_name', projekt_phase: @projekt_phase %>
  <% end %>
</div>

<% if @projekt_phase.name.in?(%w[debate_phase proposal_phase budget_phase voting_phase question_phase formular_phase legislation_phase comment_phase livestream_phase point_of_interest_phase]) %>
  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.cta_button_name_label'), hint: t('.cta_button_name_description')) do %>
      <%= render 'adm/projekt_phases/naming/cta_button_name', projekt_phase: @projekt_phase %>
    <% end %>
  </div>
<% end %>

<% if @projekt_phase.name.in?(%w[proposal_phase budget_phase]) %>
  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.resource_form_intro_label'), hint: t('.resource_form_intro_description')) do %>
      <%= render 'adm/projekt_phases/naming/resource_form_intro', projekt_phase: @projekt_phase %>
    <% end %>
  </div>

  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.resource_form_title_label'), hint: t('.resource_form_title_description')) do %>
      <%= render 'adm/projekt_phases/naming/resource_form_title', projekt_phase: @projekt_phase %>
    <% end %>
  </div>

  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.resource_form_title_placeholder_label'), hint: t('.resource_form_title_placeholder_description')) do %>
      <%= render 'adm/projekt_phases/naming/resource_form_title_placeholder', projekt_phase: @projekt_phase %>
    <% end %>
  </div>

  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.resource_form_description_placeholder_label'), hint: t('.resource_form_description_placeholder_description')) do %>
      <%= render 'adm/projekt_phases/naming/resource_form_description_placeholder', projekt_phase: @projekt_phase %>
    <% end %>
  </div>

  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.welcome_text_in_show_label'), hint: t('.welcome_text_in_show_description')) do %>
      <%= render 'adm/projekt_phases/naming/welcome_text_in_show', projekt_phase: @projekt_phase %>
    <% end %>
  </div>

  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.labels_name_label'), hint: t('.labels_name_description')) do %>
      <%= render 'adm/projekt_phases/naming/labels_name', projekt_phase: @projekt_phase %>
    <% end %>
  </div>

  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.sentiments_name_label'), hint: t('.sentiments_name_description')) do %>
      <%= render 'adm/projekt_phases/naming/sentiments_name', projekt_phase: @projekt_phase %>
    <% end %>
  </div>
<% end %>

<% if @projekt_phase.name == "voting_phase" %>
  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.description_label'), hint: t('.description_description')) do %>
      <%= render 'adm/projekt_phases/naming/description', projekt_phase: @projekt_phase %>
    <% end %>
  </div>
<% end %>

<% if @projekt_phase.name == "comment_phase" %>
  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.comment_form_title_label'), hint: t('.comment_form_title_description')) do %>
      <%= render 'adm/projekt_phases/naming/comment_form_title', projekt_phase: @projekt_phase %>
    <% end %>
  </div>

  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.comment_form_button_label'), hint: t('.comment_form_button_description')) do %>
      <%= render 'adm/projekt_phases/naming/comment_form_button', projekt_phase: @projekt_phase %>
    <% end %>
  </div>
<% end %>

<% if @projekt_phase.name == "proposal_phase" %>
  <div class="kern-container mb-5">
    <%= render Kern::FormFieldComponent.new(label: t('.support_button_text_label'), hint: t('.support_button_text_description')) do %>
      <%= render 'adm/projekt_phases/naming/support_button_text', projekt_phase: @projekt_phase %>
    <% end %>
  </div>
<% end %>
