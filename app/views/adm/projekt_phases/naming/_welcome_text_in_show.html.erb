<%= turbo_frame_tag "naming__welcome_text_in_show" do %>
  <%= form_with model: projekt_phase, url: adm_projekt_phase_path(projekt_phase), scope: projekt_phase.model_name.param_key do |f| %>
    <div class="mb-4">
      <%= f.text_area :welcome_text_in_show,
        value: AdminWYSIWYGSanitizer.new.sanitize(projekt_phase.welcome_text_in_show),
        data: { controller: "ckeditor", ckeditor_toolbar_value: ck_editor_class(current_user) } %>
    </div>
    <%= form_submit_button %>
  <% end %>

  <% if flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove"><%= flash[:success] %></div>
  <% end %>
<% end %>
