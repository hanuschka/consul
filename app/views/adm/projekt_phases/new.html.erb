<%= content_for :title, [@projekt.name, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <%= intro_section(title: t(".intro_title"), text: t(".intro_text")) %>

  <%= render Kern::FormFieldComponent.new(label: t(".phase_type_label"), hint: t(".phase_type_hint")) do %>
    <%= form_with(
      model: ProjektPhase.new,
      url: adm_projekt_projekt_phases_path(@projekt),
      method: :post
    ) do |f| %>
      <%= f.hidden_field :projekt_id, value: @projekt.id %>

      <%= f.select :type,
        @phase_types.map { |type| [type.constantize.model_name.human, type] },
        { prompt: t(".select_phase_type") },
        class: "kern-form-select__select mb-3", label: false %>

      <%= form_submit_button(text: t(".create_phase")) %>
    <% end %>
  <% end %>
</div>
