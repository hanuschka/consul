<%= turbo_frame_tag "restrictions__user_status" do %>
  <%= form_with model: projekt_phase, url: adm_projekt_phase_path(projekt_phase), method: :patch do |f| %>
    <% user_status_options = ProjektPhase.user_statuses.keys.map { |status| [status, t("adm.projekt_phases.restrictions.user_status.#{status}")] } %>
    <div class="kern-fieldset__body mb-4">
      <%= f.collection_radio_buttons(:user_status, user_status_options, :first, :last) do |b| %>
        <div class="kern-form-check">
          <%= b.radio_button(class: "kern-form-check__radio") %>
          <%= b.label(class: "kern-label") %>
        </div>
      <% end %>
    </div>
    <%= form_submit_button %>
  <% end %>

  <% if flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove"><%= flash[:success] %></div>
  <% end %>
<% end %>
