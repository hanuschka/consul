<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container my-5">
  <%= new_resource_link(new_adm_projekt_phase_sentiment_path(@projekt_phase), t(".create_button")) %>

  <% if @sentiments.empty? %>
    <p><%= t(".no_sentiments") %></p>
  <% else %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.color") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @sentiments.each do |sentiment| %>
            <tr id="<%= dom_id(sentiment) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= sentiment.name %></th>
              <td class="kern-table__cell">
                <% if sentiment.color.present? %>
                  <span class="color-preview" style="background-color: <%= sentiment.color %>; display: inline-block; width: 20px; height: 20px; border-radius: 4px;"></span>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekt_phase_sentiment_path(@projekt_phase, sentiment)) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekt_phase_sentiment_path(@projekt_phase, sentiment), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
