<div class="kern-col-xl-4 kern-col-sm-12">
  <article class="kern-card kern-card--interactive">
    <div class="kern-card__media">
      <img src="https://placehold.co/600x400" alt="ALT Text">
    </div>
    <div class="kern-card__container">
      <header class="kern-card__header">
        <hgroup>
          <p class="kern-preline">Vorzeile</p>
          <h2 class="kern-title">
            <%= link_to projekt.page.title, adm_projekt_path(projekt), class: "kern-link--stretched" %>
          </h2>
          <p class="kern-subline">Unterzeile</p>
        </hgroup>
      </header>
      <section class="kern-card__body">
        <p class="kern-body">Hier werden soviele Informationen zur Verfügung gestellt, wie benötigt und nicht mehr. Ein Maximum von 150 characters empfohlen.</p>
      </section>
    </div>
  </article>
</div>
