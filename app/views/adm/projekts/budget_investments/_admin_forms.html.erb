<% budget = investment.budget %>
<% current_phase_index = budget.current_phase_index %>

<section class="adm-admin-section">
  <div class="d-flex align-items-center flex-wrap gap-3 mb-4">
    <h2 class="adm-detail-section-title m-0"><%= t("adm.projekts.budget_investments.show.admin_section_title") %></h2>
    <%= render Adm::HintComponent.new do %>
      <p class="adm-hint__text"><%= t("adm.projekts.budget_investments.show.admin_info_banner") %></p>
      <% if !budget.valuating_or_later? && investment.feasibility == "feasible" %>
        <p class="adm-hint__text adm-hint__text--spaced"><%= t("adm.projekts.budget_investments.show.early_pricing_hint") %></p>
      <% end %>
    <% end %>
  </div>

  <div class="adm-detail-meta-bar mb-4">
    <div class="adm-detail-meta-bar__item">
      <span class="adm-detail-meta-bar__label"><%= t("adm.projekts.budget_investments.show.author") %></span>
      <span class="adm-detail-meta-bar__value"><%= investment.author.username %></span>
    </div>
    <span class="adm-detail-meta__separator"></span>
    <div class="adm-detail-meta-bar__item">
      <span class="adm-detail-meta-bar__label"><%= t("adm.projekts.budget_investments.show.created_at") %></span>
      <span class="adm-detail-meta-bar__value"><%= I18n.l(investment.created_at.to_date) %></span>
    </div>
    <span class="adm-detail-meta__separator"></span>
    <div class="adm-detail-meta-bar__item">
      <span class="adm-detail-meta-bar__label"><%= t("adm.projekts.budget_investments.show.total_votes") %></span>
      <span class="adm-detail-meta-bar__value"><%= investment.total_votes %></span>
    </div>
    <% if investment.preselected? || investment.budget.max_preselected.to_i > 0 %>
      <span class="adm-detail-meta__separator"></span>
      <div class="adm-detail-meta-bar__item">
        <span class="adm-detail-meta-bar__label"><%= t("adm.projekts.budget_investments.show.preselected") %><% if investment.budget.max_preselected.to_i > 0 %> (Top <%= investment.budget.max_preselected %>)<% end %></span>
        <span class="adm-detail-meta-bar__value <%= investment.preselected? ? 'adm-detail-meta-bar__value--positive' : '' %>"><%= human_boolean(investment.preselected?) %></span>
      </div>
    <% end %>
    <span class="adm-detail-meta__separator"></span>
    <span class="adm-admin-phase-badge">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">flag</span>
      <%= t("adm.projekts.budget_investments.show.current_phase", phase: current_phase_index) %>
    </span>
  </div>

  <%# === Phase 2 & 3: Criteria Check === %>
  <% phase_enabled = budget.accepting_or_later? %>
  <% phase_completed = investment.valuation_finished? %>
  <% phase_state = phase_enabled ? (phase_completed ? "completed" : "active") : "disabled" %>

  <details class="adm-admin-phase adm-admin-phase--<%= phase_state %>">
    <summary class="adm-admin-phase__header">
      <div class="adm-admin-phase__title">
        <span class="adm-admin-phase__icon material-symbols-outlined" aria-hidden="true">
          <%= phase_completed ? "check_circle" : (phase_enabled ? "edit" : "lock") %>
        </span>
        <%= t("adm.projekts.budget_investments.administer.phase_2_3_title") %>
      </div>
      <% if phase_enabled %>
        <div class="adm-admin-phase__chips">
          <% if investment.feasibility == "feasible" %>
            <span class="adm-admin-chip adm-admin-chip--success">
              <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
              <%= Budget::Investment.human_attribute_name("feasibility_#{investment.feasibility}") %>
            </span>
          <% elsif investment.feasibility == "unfeasible" %>
            <span class="adm-admin-chip adm-admin-chip--danger">
              <span class="material-symbols-outlined" aria-hidden="true">cancel</span>
              <%= Budget::Investment.human_attribute_name("feasibility_#{investment.feasibility}") %>
            </span>
          <% else %>
            <span class="adm-admin-chip">
              <span class="material-symbols-outlined" aria-hidden="true">pending</span>
              <%= Budget::Investment.human_attribute_name("feasibility_#{investment.feasibility}") %>
            </span>
          <% end %>
          <% if investment.valuation_finished? %>
            <span class="adm-admin-chip adm-admin-chip--success">
              <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
              <%= t("adm.projekts.budget_investments.show.valuation_finished") %>
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="adm-admin-phase__summary"><%= t("adm.projekts.budget_investments.show.phase_not_available") %></span>
      <% end %>
    </summary>

    <div class="adm-admin-phase__body">
      <details class="adm-admin-hint mb-3">
        <summary class="adm-admin-hint__toggle">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">help</span>
          <%= t("adm.projekts.budget_investments.show.show_details") %>
        </summary>
        <p class="adm-admin-hint__text"><%= t("adm.projekts.budget_investments.administer.phase_2_3_hint") %></p>
      </details>

      <%= form_with model: investment,
            url: adm_projekts_phase_budget_investment_path(projekt_phase, investment),
            method: :patch,
            data: { controller: "adm-feasibility-toggle" } do |f| %>
        <div class="mb-3" data-action="change->adm-feasibility-toggle#toggle">
          <%= f.collection_radio_buttons :feasibility,
            Budget::Investment::FEASIBILITIES.map { |v| [v, t("adm.attribute_editor.budget/investment.feasibility_label_options.#{v}")] },
            :first, :last, disabled: !phase_enabled %>
        </div>

        <div class="mb-3" data-adm-feasibility-toggle-target="fields">
          <%= f.rich_text_area :valuator_explanation, disabled: !phase_enabled %>
        </div>

        <div class="mb-3" data-adm-feasibility-toggle-target="fields">
          <%= f.check_box :valuation_finished, disabled: !phase_enabled %>
        </div>

        <%= form_submit_button(disabled: !phase_enabled) %>
      <% end %>
    </div>
  </details>

  <%# === Phase 5: Pricing === %>
  <% if budget.show_money? %>
    <% phase_early_access = !budget.valuating_or_later? && investment.feasibility == "feasible" %>
    <% phase_enabled = budget.valuating_or_later? || phase_early_access %>
    <% phase_completed = investment.price.present? && investment.price > 0 %>
    <% phase_state = phase_enabled ? (phase_completed ? "completed" : "active") : "disabled" %>

    <details class="adm-admin-phase adm-admin-phase--<%= phase_state %>">
      <summary class="adm-admin-phase__header">
        <div class="adm-admin-phase__title">
          <span class="adm-admin-phase__icon material-symbols-outlined" aria-hidden="true">
            <%= phase_completed ? "check_circle" : (phase_enabled ? "edit" : "lock") %>
          </span>
          <%= t("adm.projekts.budget_investments.administer.phase_5_title") %>
          <% if phase_early_access %>
            <span class="adm-admin-phase__early-badge">
              <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 14px;">bolt</span>
              <%= t("adm.projekts.budget_investments.administer.phase_5_early_access") %>
            </span>
          <% end %>
        </div>
        <% if phase_enabled && phase_completed %>
          <div class="adm-admin-phase__chips">
            <span class="adm-admin-chip adm-admin-chip--success">
              <span class="material-symbols-outlined" aria-hidden="true">payments</span>
              <%= investment.formatted_price %>
            </span>
          </div>
        <% elsif !phase_enabled && !phase_early_access %>
          <span class="adm-admin-phase__summary"><%= t("adm.projekts.budget_investments.show.phase_not_available") %></span>
        <% end %>
      </summary>

      <div class="adm-admin-phase__body">
        <details class="adm-admin-hint mb-3">
          <summary class="adm-admin-hint__toggle">
            <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">help</span>
            <%= t("adm.projekts.budget_investments.show.show_details") %>
          </summary>
          <p class="adm-admin-hint__text"><%= t("adm.projekts.budget_investments.administer.phase_5_hint") %></p>
        </details>

        <%= form_with model: investment,
              url: adm_projekts_phase_budget_investment_path(projekt_phase, investment),
              method: :patch do |f| %>
          <div class="mb-3">
            <%= f.number_field :price, class: "kern-input", max: 1000000000000000, disabled: !phase_enabled %>
          </div>

          <div class="mb-3">
            <%= f.number_field :price_first_year, class: "kern-input", max: 1000000000000000, disabled: !phase_enabled %>
          </div>

          <div class="mb-3">
            <%= f.text_field :duration, class: "kern-input", disabled: !phase_enabled %>
          </div>

          <%= form_submit_button(disabled: !phase_enabled) %>
        <% end %>
      </div>
    </details>
  <% end %>

  <%# === Phase 6: Selection for Voting === %>
  <% phase_enabled = budget.publishing_prices_or_later? %>
  <% phase_completed = investment.selected? %>
  <% phase_state = phase_enabled ? (phase_completed ? "completed" : "active") : "disabled" %>

  <details class="adm-admin-phase adm-admin-phase--<%= phase_state %>">
    <summary class="adm-admin-phase__header">
      <div class="adm-admin-phase__title">
        <span class="adm-admin-phase__icon material-symbols-outlined" aria-hidden="true">
          <%= phase_completed ? "check_circle" : (phase_enabled ? "edit" : "lock") %>
        </span>
        <%= t("adm.projekts.budget_investments.administer.phase_6_title") %>
      </div>
      <% if phase_enabled %>
        <div class="adm-admin-phase__chips">
          <% if investment.selected? %>
            <span class="adm-admin-chip adm-admin-chip--success">
              <span class="material-symbols-outlined" aria-hidden="true">how_to_vote</span>
              <%= t("adm.projekts.budget_investments.show.selected_yes") %>
            </span>
          <% else %>
            <span class="adm-admin-chip">
              <span class="material-symbols-outlined" aria-hidden="true">block</span>
              <%= t("adm.projekts.budget_investments.show.selected_no") %>
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="adm-admin-phase__summary"><%= t("adm.projekts.budget_investments.show.phase_not_available") %></span>
      <% end %>
    </summary>

    <div class="adm-admin-phase__body">
      <details class="adm-admin-hint mb-3">
        <summary class="adm-admin-hint__toggle">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">help</span>
          <%= t("adm.projekts.budget_investments.show.show_details") %>
        </summary>
        <p class="adm-admin-hint__text"><%= t("adm.projekts.budget_investments.administer.phase_6_hint") %></p>
      </details>

      <%= form_with model: investment,
            url: adm_projekts_phase_budget_investment_path(projekt_phase, investment),
            method: :patch do |f| %>
        <div class="mb-3">
          <%= f.collection_radio_buttons :selected,
            [[true, t("adm.projekts.budget_investments.administer.selected_true")], [false, t("adm.projekts.budget_investments.administer.selected_false")]],
            :first, :last, disabled: !phase_enabled %>
        </div>

        <%= form_submit_button(disabled: !phase_enabled) %>
      <% end %>
    </div>
  </details>

  <%# === Phase 8: Winner List === %>
  <% phase_enabled = budget.balloting_finished? %>
  <% phase_completed = investment.incompatible? %>
  <% phase_state = phase_enabled ? "active" : "disabled" %>

  <details class="adm-admin-phase adm-admin-phase--<%= phase_state %>">
    <summary class="adm-admin-phase__header">
      <div class="adm-admin-phase__title">
        <span class="adm-admin-phase__icon material-symbols-outlined" aria-hidden="true">
          <%= phase_enabled ? "edit" : "lock" %>
        </span>
        <%= t("adm.projekts.budget_investments.administer.phase_8_title") %>
      </div>
      <% if phase_enabled %>
        <div class="adm-admin-phase__chips">
          <% if investment.winner? %>
            <span class="adm-admin-chip adm-admin-chip--success">
              <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
              <%= t("adm.projekts.budget_investments.show.winner_yes") %>
            </span>
          <% end %>
          <% if investment.incompatible? %>
            <span class="adm-admin-chip adm-admin-chip--danger">
              <span class="material-symbols-outlined" aria-hidden="true">warning</span>
              <%= t("adm.projekts.budget_investments.show.incompatible_yes") %>
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="adm-admin-phase__summary"><%= t("adm.projekts.budget_investments.show.phase_not_available") %></span>
      <% end %>
    </summary>

    <div class="adm-admin-phase__body">
      <details class="adm-admin-hint mb-3">
        <summary class="adm-admin-hint__toggle">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">help</span>
          <%= t("adm.projekts.budget_investments.show.show_details") %>
        </summary>
        <p class="adm-admin-hint__text"><%= t("adm.projekts.budget_investments.administer.phase_8_hint") %></p>
      </details>

      <%= form_with model: investment,
            url: adm_projekts_phase_budget_investment_path(projekt_phase, investment),
            method: :patch do |f| %>
        <div class="mb-3">
          <%= f.check_box :incompatible, disabled: !phase_enabled %>
        </div>

        <%= form_submit_button(disabled: !phase_enabled) %>
      <% end %>
    </div>
  </details>
</section>
