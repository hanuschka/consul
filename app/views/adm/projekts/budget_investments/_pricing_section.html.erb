<% phase_early_access = !budget.valuating_or_later? && investment.feasibility == "feasible" %>
<% phase_enabled = budget.valuating_or_later? || phase_early_access %>
<% phase_completed = investment.price.present? && investment.price > 0 %>
<% phase_state = phase_enabled ? (phase_completed ? "completed" : "active") : "disabled" %>

<details class="adm-admin-phase adm-admin-phase--<%= phase_state %>" <%= "open" if saved_editor == "pricing" %>>
  <summary class="adm-admin-phase__header">
    <div class="adm-admin-phase__title">
      <span class="adm-admin-phase__icon material-symbols-outlined" aria-hidden="true">
        <%= phase_completed ? "check_circle" : (phase_enabled ? "edit" : "lock") %>
      </span>
      <%= t("adm.projekts.budget_investments.administer.phase_5_title") %>
      <% if phase_early_access %>
        <span class="adm-admin-phase__early-badge">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 14px;">bolt</span>
          <%= t("adm.projekts.budget_investments.administer.phase_5_early_access") %>
        </span>
      <% end %>
    </div>
    <% if phase_enabled && phase_completed %>
      <div class="adm-admin-phase__chips">
        <span class="adm-admin-chip adm-admin-chip--success">
          <span class="material-symbols-outlined" aria-hidden="true">payments</span>
          <%= investment.formatted_price %>
        </span>
      </div>
    <% elsif !phase_enabled && !phase_early_access %>
      <span class="adm-admin-phase__summary"><%= t("adm.projekts.budget_investments.show.phase_not_available") %></span>
    <% end %>
  </summary>

  <div class="adm-admin-phase__body">
    <details class="adm-admin-hint mb-3">
      <summary class="adm-admin-hint__toggle">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">help</span>
        <%= t("adm.projekts.budget_investments.show.show_details") %>
      </summary>
      <p class="adm-admin-hint__text"><%= t("adm.projekts.budget_investments.administer.phase_5_hint") %></p>
    </details>

    <%= render "adm/projekts/budget_investments/pricing_form",
          investment: investment,
          projekt_phase: projekt_phase,
          budget: budget,
          show_success: saved_editor == "pricing" %>
  </div>
</details>
