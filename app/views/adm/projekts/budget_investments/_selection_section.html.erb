<% phase_enabled = budget.publishing_prices_or_later? %>
<% phase_completed = investment.selected? %>
<% phase_state = phase_enabled ? (phase_completed ? "completed" : "active") : "disabled" %>

<details class="adm-admin-phase adm-admin-phase--<%= phase_state %>" <%= "open" if saved_editor == "selection" %>>
  <summary class="adm-admin-phase__header">
    <div class="adm-admin-phase__title">
      <span class="adm-admin-phase__icon material-symbols-outlined" aria-hidden="true">
        <%= phase_completed ? "check_circle" : (phase_enabled ? "edit" : "lock") %>
      </span>
      <%= t("adm.projekts.budget_investments.administer.phase_6_title") %>
    </div>
    <% if phase_enabled %>
      <div class="adm-admin-phase__chips">
        <% if investment.selected? %>
          <span class="adm-admin-chip adm-admin-chip--success">
            <span class="material-symbols-outlined" aria-hidden="true">how_to_vote</span>
            <%= t("adm.projekts.budget_investments.show.selected_yes") %>
          </span>
        <% else %>
          <span class="adm-admin-chip">
            <span class="material-symbols-outlined" aria-hidden="true">block</span>
            <%= t("adm.projekts.budget_investments.show.selected_no") %>
          </span>
        <% end %>
      </div>
    <% else %>
      <span class="adm-admin-phase__summary"><%= t("adm.projekts.budget_investments.show.phase_not_available") %></span>
    <% end %>
  </summary>

  <div class="adm-admin-phase__body">
    <details class="adm-admin-hint mb-3">
      <summary class="adm-admin-hint__toggle">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">help</span>
        <%= t("adm.projekts.budget_investments.show.show_details") %>
      </summary>
      <p class="adm-admin-hint__text"><%= t("adm.projekts.budget_investments.administer.phase_6_hint") %></p>
    </details>

    <%= render "adm/projekts/budget_investments/selection_form",
          investment: investment,
          projekt_phase: projekt_phase,
          budget: budget,
          show_success: saved_editor == "selection" %>
  </div>
</details>
