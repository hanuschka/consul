<div class="d-flex align-items-center justify-content-between flex-wrap mb-3">
  <div class="d-flex align-items-center flex-wrap gap-3">
    <h2 class="adm-detail-section-title m-0"><%= t("adm.projekts.budget_investments.show.content_title") %></h2>
    <%= render Adm::HintComponent.new do %>
      <p class="adm-hint__text"><%= t("adm.projekts.budget_investments.show.content_info") %></p>
    <% end %>
  </div>
  <%= kern_link_button(edit_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
          text: t("adm.projekts.budget_investments.show.edit"), icon: "edit", style: :secondary, data: { turbo_frame: "investment_content" }) %>
</div>

<div class="adm-content-card mb-4">
  <div class="adm-content-card__body">
    <h3 class="adm-detail-content-title mb-2"><%= investment.title %></h3>
    <div class="adm-detail-description">
      <%= auto_link_already_sanitized_html wysiwyg(investment.description) %>
    </div>
  </div>
</div>

<% has_image = investment.image&.attachment&.attached? %>
<% has_map = projekt_phase.feature?("form.show_map") && investment.map_location.present? %>

<% if has_image || has_map %>
  <div class="adm-detail-media-grid <%= (has_image && has_map) ? 'adm-detail-media-grid--two' : '' %> mb-4">
    <% if has_image %>
      <div class="adm-detail-media-card">
        <div class="adm-detail-media-card__label">
          <span class="material-symbols-outlined" aria-hidden="true">image</span>
          <%= t("adm.projekts.budget_investments.show.image") %>
          <%= link_to toggle_image_concealed_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
                class: "ml-auto",
                data: { turbo_method: :patch } do %>
            <%= investment.image.concealed? ? t("adm.projekts.budget_investments.show.show_image") : t("adm.projekts.budget_investments.show.hide_image") %>
          <% end %>
        </div>
        <div class="<%= 'adm-detail-media-card__image--concealed' if investment.image.concealed? %>">
          <%= image_tag(investment.image.attachment) %>
        </div>
      </div>
    <% end %>

    <% if has_map %>
      <div class="adm-detail-media-card">
        <div class="adm-detail-media-card__label">
          <span class="material-symbols-outlined" aria-hidden="true">map</span>
          <%= t("adm.projekts.budget_investments.show.map") %>
        </div>
        <%= render Kern::MapComponent.new(map_location: investment.map_location) %>
      </div>
    <% end %>
  </div>
<% end %>

<%
  additional_rows = []

  if investment.on_behalf_of.present?
    additional_rows << { label: t("adm.projekts.budget_investments.show.on_behalf_of"), value: investment.on_behalf_of }
  end

  if projekt_phase.feature?("form.enable_external_video") && investment.video_url.present?
    additional_rows << { label: t("adm.projekts.budget_investments.show.video_url"), value: link_to(investment.video_url, investment.video_url, target: "_blank", rel: "noopener") }
  end

  if projekt_phase.feature?("form.show_implementation_option_fields")
    if investment.implementation_performer.present?
      additional_rows << {
        label: t("adm.projekts.budget_investments.show.implementation_performer"),
        value: t("adm.attribute_editor.budget/investment.implementation_performer_label_options.#{investment.implementation_performer}")
      }
    end

    if investment.implementation_contribution.present?
      additional_rows << { label: t("adm.projekts.budget_investments.show.implementation_contribution"), value: investment.implementation_contribution }
    end
  end

  if projekt_phase.feature?("form.show_user_cost_estimate") && investment.user_cost_estimate.present?
    additional_rows << { label: t("adm.projekts.budget_investments.show.user_cost_estimate"), value: investment.user_cost_estimate }
  end
%>

<% if projekt_phase.feature?("form.labels") && projekt_phase.projekt_labels.any? && investment.projekt_labels.any? %>
  <% label_html = capture do %>
    <div class="d-flex flex-wrap gap-2">
      <% investment.projekt_labels.each do |label| %>
        <span class="adm-detail-pill">
          <span class="material-symbols-outlined" aria-hidden="true">label</span>
          <%= label.name %>
        </span>
      <% end %>
    </div>
  <% end %>
  <% additional_rows << { label: projekt_phase.projekt_labels_label_text, value: label_html } %>
<% end %>

<% if projekt_phase.feature?("form.sentiments") && projekt_phase.sentiments.any? && investment.sentiment.present? %>
  <% sentiment_html = capture do %>
    <span class="adm-detail-pill" style="background: color-mix(in srgb, <%= investment.sentiment.color %> 15%, transparent); color: <%= investment.sentiment.color %>;">
      <%= investment.sentiment.name %>
    </span>
  <% end %>
  <% additional_rows << { label: projekt_phase.sentiment_label_text, value: sentiment_html } %>
<% end %>

<% if projekt_phase.feature?("form.allow_attached_documents") && investment.documents.any? %>
  <% docs_html = capture do %>
    <ul>
      <% investment.documents.each do |document| %>
        <li>
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px; vertical-align: text-bottom;">attach_file</span>
          <%= link_to document.title, document.attachment, target: :blank %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% additional_rows << { label: t("adm.projekts.budget_investments.show.documents"), value: docs_html } %>
<% end %>

<% if additional_rows.any? %>
  <div class="mb-4">
    <div class="adm-detail-table">
      <% additional_rows.each do |row| %>
        <div class="adm-detail-table__row">
          <div class="adm-detail-table__label"><%= row[:label] %></div>
          <div class="adm-detail-table__value"><%= row[:value] %></div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
