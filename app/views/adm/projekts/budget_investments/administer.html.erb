<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @investment.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: @tabs) %>

<% budget = @investment.budget %>

<div class="kern-container mb-5">

  <% disabled = !budget.accepting_or_later? %>
  <%= render Kern::FormFieldComponent.new(
    label: t(".phase_2_3_title"),
    hint: t(".phase_2_3_hint")) do %>
    <%= form_with model: @investment,
          url: adm_projekts_phase_budget_investment_path(@projekt_phase, @investment),
          method: :patch do |f| %>
      <div class="mb-3">
        <%= f.collection_radio_buttons :feasibility,
          Budget::Investment::FEASIBILITIES.map { |v| [v, t("adm.attribute_editor.budget/investment.feasibility_label_options.#{v}")] },
          :first, :last, disabled: disabled %>
      </div>

      <div class="mb-3">
        <%= f.rich_text_area :valuator_explanation, disabled: disabled %>
      </div>

      <div class="mb-3">
        <%= f.check_box :valuation_finished, disabled: disabled %>
      </div>

      <%= form_submit_button(disabled: disabled) %>
    <% end %>
  <% end %>

  <% if budget.show_money? %>
    <% disabled = !budget.valuating_or_later? %>
    <%= render Kern::FormFieldComponent.new(
      label: t(".phase_5_title"),
      hint: t(".phase_5_hint")) do %>
      <%= form_with model: @investment,
            url: adm_projekts_phase_budget_investment_path(@projekt_phase, @investment),
            method: :patch do |f| %>
        <div class="mb-3">
          <%= f.number_field :price, class: "kern-input", max: 1000000000000000, disabled: disabled %>
        </div>

        <div class="mb-3">
          <%= f.number_field :price_first_year, class: "kern-input", max: 1000000000000000, disabled: disabled %>
        </div>

        <div class="mb-3">
          <%= f.text_field :duration, class: "kern-input", disabled: disabled %>
        </div>

        <%= form_submit_button(disabled: disabled) %>
      <% end %>
    <% end %>
  <% end %>

  <% disabled = !budget.publishing_prices_or_later? %>
  <%= render Kern::FormFieldComponent.new(
    label: t(".phase_6_title"),
    hint: t(".phase_6_hint")) do %>
    <%= form_with model: @investment,
          url: adm_projekts_phase_budget_investment_path(@projekt_phase, @investment),
          method: :patch do |f| %>
      <div class="mb-3">
        <%= f.collection_radio_buttons :selected,
          [[true, t(".selected_true")], [false, t(".selected_false")]],
          :first, :last, disabled: disabled %>
      </div>

      <%= form_submit_button(disabled: disabled) %>
    <% end %>
  <% end %>

  <% disabled = !budget.balloting_finished? %>
  <%= render Kern::FormFieldComponent.new(
    label: t(".phase_8_title"),
    hint: t(".phase_8_hint")) do %>
    <%= form_with model: @investment,
          url: adm_projekts_phase_budget_investment_path(@projekt_phase, @investment),
          method: :patch do |f| %>
      <div class="mb-3">
        <%= f.check_box :incompatible, disabled: disabled %>
      </div>

      <%= form_submit_button(disabled: disabled) %>
    <% end %>
  <% end %>

</div>
