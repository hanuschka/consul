<%= content_for :title, @investment.title %>

<%= render Adm::HeaderComponent.new(title: @investment.title, breadcrumbs: @breadcrumbs, back_button_url: budget_investments_adm_projekts_phase_path(@projekt_phase)) %>

<%= render Adm::TabsComponent.new(tabs: @tabs) %>

<article class="kern-container mb-5">
  <p class="kern-body kern-body--small mb-1">
    <strong><%= t(".feasibility") %>:</strong>
    <%= Budget::Investment.human_attribute_name("feasibility_#{@investment.feasibility}") %>
    · <strong><%= t(".valuation_finished") %>:</strong> <%= human_boolean(@investment.valuation_finished?) %>
  </p>
  <p class="kern-body kern-body--small mb-1">
    <strong><%= t(".preselected") %>:</strong> <%= human_boolean(@investment.preselected?) %>
    · <strong><%= t(".selected") %>:</strong> <%= human_boolean(@investment.selected?) %>
    · <strong><%= t(".winner") %>:</strong> <%= human_boolean(@investment.winner?) %>
  </p>
  <p class="kern-body kern-body--small mb-3">
    <strong><%= t(".price") %>:</strong> <%= @investment.formatted_price %>
  </p>

  <h1 class="kern-title kern-title--large mb-2"><%= @investment.title %></h1>

  <p class="kern-body kern-body--small mb-3">
    <strong><%= t(".author") %>:</strong> <%= @investment.author&.name %>
  </p>

  <p class="kern-body kern-body--small mb-3">
    <strong><%= t(".heading") %>:</strong> <%= @investment.heading&.name %>
  </p>

  <% if @investment.district.present? %>
    <p class="kern-body kern-body--small mb-3">
      <strong><%= t(".district") %>:</strong> <%= @investment.district.name %>
    </p>
  <% end %>

  <% if @investment.administrator.present? %>
    <p class="kern-body kern-body--small mb-3">
      <strong><%= t(".admin") %>:</strong> <%= @investment.administrator.description_or_name %>
    </p>
  <% end %>

  <% valuators = [@investment.assigned_valuation_groups, @investment.assigned_valuators].compact.presence %>
  <% if valuators %>
    <p class="kern-body kern-body--small mb-3">
      <strong><%= t(".valuator") %>:</strong> <%= valuators.join(", ") %>
    </p>
  <% end %>

  <p class="kern-body kern-body--small mb-3">
    <strong><%= t(".created_at") %>:</strong> <%= l(@investment.created_at, format: :long) %>
  </p>

  <p class="kern-body kern-body--small">
    <%= link_to t(".download_pdf"), adm_projekts_phase_budget_investment_path(@projekt_phase, @investment, format: :pdf) %>
  </p>
  <p class="kern-body kern-body--small">
    <span class="material-symbols-outlined" aria-hidden="true">thumb_up</span> <%= @investment.total_votes %>
    · <span class="material-symbols-outlined" aria-hidden="true">how_to_vote</span> <%= @investment.ballot_lines_count %>
    · <span class="material-symbols-outlined" aria-hidden="true">ballot</span> <%= @investment.total_ballot_votes %>
  </p>

  <div class="kern-row mb-3">
    <% if @image_url.present? %>
      <div class="kern-col-sm-12 kern-col-md-5">
        <%= image_tag(@image_url, class: "w-100") %>
      </div>
    <% end %>

    <div class="kern-col-sm-12 kern-col-md-<%= @image_url.present? ? 5 : 10 %>">
      <div class="kern-body mb-4">
        <%= auto_link_already_sanitized_html wysiwyg(@investment.description) %>
      </div>
    </div>
  </div>

  <% if @investment.map_location.present? %>
    <div class="kern-row mb-4">
      <div class="kern-col-sm-12 kern-col-md-10">
        <%= render Kern::MapComponent.new(map_location: @investment.map_location) %>
      </div>
    </div>
  <% end %>
</article>
