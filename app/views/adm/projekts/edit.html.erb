<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= form_with model: [:adm, @projekt] do |f| %>
    <%= render Kern::FormFieldComponent.new(label: Projekt.human_attribute_name(:name)) do %>
      <%= f.text_field :name, label: false, placeholder: Projekt.human_attribute_name(:name) %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: Projekt.human_attribute_name(:total_duration_start)) do %>
      <%= f.date_field :total_duration_start, label: false %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: Projekt.human_attribute_name(:total_duration_end)) do %>
      <%= f.date_field :total_duration_end, label: false %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: Projekt.human_attribute_name(:show_start_date_in_frontend)) do %>
      <%= f.check_box :show_start_date_in_frontend %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: Projekt.human_attribute_name(:show_end_date_in_frontend)) do %>
      <%= f.check_box :show_end_date_in_frontend %>
    <% end %>

    <%= form_submit_button(text: t(".submit")) %>
  <% end %>
</div>
