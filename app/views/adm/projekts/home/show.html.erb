<%= content_for :title, t("adm.projekts.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.projekts.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new(
  team_members: @team_members,
  team_url: (Adm::Projekts::ProjektManagerPolicy.new(current_user, nil).create? ? new_adm_projekts_manager_path : nil),
  intro_text: @intro_text,
  quick_links: @quick_links,
  stats: @stats,
  contact_persons: @contact_persons,
  section: "projekts",
  notice_active: @notice_active,
  notice_message: @notice_message,
  activities: [],
  section_settings_path: policy([:adm, Setting]).update? ? adm_projekts_settings_path : nil
) %>

<div class="kern-container">
  <div class="adm-dashboard__section adm-dashboard__section--pull-up">
    <div class="adm-dashboard__section-header">
      <span class="material-symbols-outlined" aria-hidden="true">folder</span>
      <h3><%= t("adm.projekts.title") %></h3>
    </div>

    <%= turbo_frame_tag "projekts_table", src: adm_projekts_projekts_list_path, loading: :eager %>
  </div>

  <%= render Adm::ActivityFeedComponent.new(activities: @activities, pagy: @pagy_activities) %>
</div>
