<%= content_for :title, t("adm.projekts.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.projekts.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new(
  team_members: @team_members,
  team_url: new_adm_projekts_manager_path,
  recent_items: @recent_items,
  recent_items_url: adm_projekts_projekts_list_path,
  recent_item_columns: [
    { label: Projekt.model_name.human, value: ->(item) { item.title }, url: ->(item) { details_adm_projekts_projekt_path(item) } },
    { label: Projekt.human_attribute_name("total_duration_start"), value: ->(item) { item.total_duration_start } },
    { label: Projekt.human_attribute_name("total_duration_end"), value: ->(item) { item.total_duration_end } }
  ],
  intro_text: @section_setting&.intro_text,
  quick_links: @quick_links,
  stats: @stats,
  contact_persons: @contact_persons,
  notice: @section_setting,
  activities: @activities,
  section_settings_path: policy([:adm, SectionSetting]).edit? ? edit_adm_section_setting_path("projekts") : nil
) %>
