<%= content_for :title, t("adm.projekts.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.projekts.home.title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= render Adm::Dashboard::NoticeComponent.new(message: @notice) if @notice.present? %>

  <div class="adm-dashboard__intro-row">
    <div class="adm-dashboard__intro-col">
      <% if @intro_text.present? %>
        <p class="adm-dashboard__intro"><%= @intro_text %></p>
      <% end %>

      <% if @quick_links.any? %>
        <div class="adm-dashboard__section-actions">
          <% @quick_links.each do |link| %>
            <% if link[:ai_gated] %>
              <%= render Shared::AiFeatureTooltipComponent.new(feature_title: link[:label], feature_text: link[:description]) do %>
                <%= kern_link_button link[:path],
                      text: link[:label],
                      style: link[:primary] ? :primary : :secondary %>
              <% end %>
            <% else %>
              <%= kern_link_button link[:path],
                    text: link[:label],
                    style: link[:primary] ? :primary : :secondary %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @contact_persons.any? %>
      <div class="adm-dashboard__intro-aside">
        <%= render Adm::Dashboard::ContactsComponent.new(contacts: @contact_persons) %>
      </div>
    <% end %>
  </div>

  <div class="adm-dashboard__section">
    <div class="adm-dashboard__section-header adm-dashboard__section-header--with-stats">
      <div class="adm-dashboard__section-header-title">
        <span class="material-symbols-outlined" aria-hidden="true">folder</span>
        <h3><%= t("adm.projekts.title") %></h3>
      </div>

      <%= render Adm::Dashboard::StatPillsComponent.new(stats: @stats) %>
    </div>

    <%= turbo_frame_tag "projekts_table", src: adm_projekts_projekts_list_path, loading: :eager %>
  </div>

  <div class="adm-dashboard__feed-row">
    <%= render Adm::ActivityFeedComponent.new(activities: @activities, pagy: @pagy_activities) %>

    <%= render Adm::Dashboard::TeamComponent.new(
          members: @team_members,
          add_url: (Adm::Projekts::ProjektManagerPolicy.new(current_user, nil).create? ? new_adm_projekts_manager_path : nil)
        ) %>
  </div>
</div>
