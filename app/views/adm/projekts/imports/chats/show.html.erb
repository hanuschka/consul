<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, back_button_url: adm_projekts_imports_path, ultracompact: true) do |header| %>
  <% if @created_projekts.any? %>
    <% header.with_actions do %>
      <%= link_to projekt_path(@created_projekts.last),
            class: "projekt-import-chat--created-link",
            title: @created_projekts.last.name,
            data: { turbo: false } do %>
        <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
        <span class="projekt-import-chat--created-link-label"><%= t("adm.projekts.imports.list.projekt_created", title: @created_projekts.last.name) %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>

  <div class="projekt-import-chat"
       data-controller="projekt-imports--chat"
       data-projekt-imports--chat-messages-url-value="<%= messages_adm_projekts_import_chat_path(@projekt_import) %>"
       data-projekt-imports--chat-send-url-value="<%= message_adm_projekts_import_chat_path(@projekt_import) %>"
       data-projekt-imports--chat-command-url-value="<%= command_adm_projekts_import_chat_path(@projekt_import) %>"
       data-projekt-imports--chat-extract-url-value="<%= extract_adm_projekts_import_chat_path(@projekt_import) %>"
       data-projekt-imports--chat-title-image-url-value="<%= title_image_adm_projekts_import_chat_path(@projekt_import) %>"
       data-projekt-imports--chat-summary-url-value="<%= summary_adm_projekts_import_chat_path(@projekt_import) %>"
       data-projekt-imports--chat-error-summary-failed-value="<%= t('.errors.summary_failed') %>"
       data-projekt-imports--chat-status-url-value="<%= status_adm_projekts_import_path(@projekt_import) %>"
       data-projekt-imports--chat-import-id-value="<%= @projekt_import.id %>"
       data-projekt-imports--chat-csrf-value="<%= form_authenticity_token %>"
       data-projekt-imports--chat-poll-interval-value="3500"
       data-projekt-imports--chat-confirm-start-over-value="<%= t('.confirm_start_over') %>"
       data-projekt-imports--chat-progress-resolving-value="<%= t('.progress.resolving_content_blocks') %>"
       data-projekt-imports--chat-progress-creating-value="<%= t('.progress.creating_projekt') %>"
       data-projekt-imports--chat-progress-generating-image-value="<%= t('.progress.generating_image') %>"
       data-projekt-imports--chat-error-extract-failed-value="<%= t('.errors.extract_failed') %>"
       data-projekt-imports--chat-user-initials-value="<%= @chat_user_initials %>"
       data-projekt-imports--chat-user-image-url-value="<%= @chat_user_image_url %>"
       data-projekt-imports--chat-import-status-value="<%= @projekt_import.status %>">

    <%# Import error banner (shown once on failure, dismissible) %>
    <div class="projekt-import-chat--banner -error -hidden"
         role="alert"
         data-projekt-imports--chat-target="importError"
         data-fallback="<%= t('.errors.import_failed') %>">
      <span class="material-symbols-outlined" aria-hidden="true">error</span>
      <span class="projekt-import-chat--banner-body"
            data-projekt-imports--chat-target="importErrorMessage"></span>
      <button type="button"
              class="projekt-import-chat--banner-dismiss"
              aria-label="<%= t('.errors.dismiss') %>"
              data-action="click->projekt-imports--chat#dismissBanner">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>

    <%# Import warnings banner (non-fatal problems, dismissible) %>
    <div class="projekt-import-chat--banner -warning -hidden"
         role="status"
         data-projekt-imports--chat-target="importWarning">
      <span class="material-symbols-outlined" aria-hidden="true">warning</span>
      <ul class="projekt-import-chat--banner-body"
          data-projekt-imports--chat-target="importWarningList"></ul>
      <button type="button"
              class="projekt-import-chat--banner-dismiss"
              aria-label="<%= t('.errors.dismiss') %>"
              data-action="click->projekt-imports--chat#dismissBanner">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>

    <%# Messages %>
    <div class="projekt-import-chat--messages"
         role="log"
         aria-live="polite"
         data-projekt-imports--chat-target="messages">
      <% @messages.each do |message| %>
        <%= render "adm/projekts/imports/chats/message",
              message: message, user: @chat_user, projekt_import: @projekt_import %>
      <% end %>

      <% if @created_projekts.any? %>
        <div class="projekt-import-chat--created-banner">
          <span class="material-symbols-outlined projekt-import-chat--created-banner-icon" aria-hidden="true">celebration</span>
          <div class="projekt-import-chat--created-banner-body">
            <p class="projekt-import-chat--created-banner-title">
              <%= t("adm.projekts.imports.chats.show.created_banner_title") %>
            </p>
            <% @created_projekts.each do |projekt| %>
              <%= link_to projekt_path(projekt),
                    class: "projekt-import-chat--created-banner-link",
                    data: { turbo: false } do %>
                <span class="projekt-import-chat--created-banner-link-thumb"><%= projekt_thumbnail(projekt) %></span>
                <span class="projekt-import-chat--created-banner-link-name"><%= projekt.name %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="projekt-import-chat-bubble -ai projekt-import-chat--typing-indicator -hidden"
           data-projekt-imports--chat-target="typingIndicator">
        <div class="projekt-import-chat-bubble--avatar"><span>AI</span></div>
        <div class="projekt-import-chat-bubble--wrapper">
          <div class="projekt-import-chat-bubble--content">
            <div class="projekt-import-chat--typing-dots">
              <span></span><span></span><span></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Topbar %>
    <div class="projekt-import-chat--topbar"
         role="toolbar"
         aria-label="<%= t('.commands_label', default: 'Actions') %>">
      <div class="projekt-import-chat--topbar-group">
        <rich-tooltip delay="700">
          <button type="button"
                  class="projekt-import-chat--topbar-button"
                  data-action="click->projekt-imports--chat#startOver">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
            <%= t(".commands.start_over") %>
          </button>
          <%= render "adm/projekts/imports/chats/action_tooltip", key: "start_over" %>
        </rich-tooltip>
        <rich-tooltip delay="700">
          <button
             type="button"
             class="projekt-import-chat--topbar-button"
             data-action="click->projekt-imports--chat#regenerate"
          >
            <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
            <%= t(".commands.regenerate") %>
          </button>
          <%= render "adm/projekts/imports/chats/action_tooltip", key: "regenerate" %>
        </rich-tooltip>
        <rich-tooltip delay="700">
          <button type="button"
                  class="projekt-import-chat--topbar-button"
                  data-action="click->projekt-imports--chat#summarize">
            <span class="material-symbols-outlined" aria-hidden="true">format_list_bulleted</span>
            <%= t(".commands.summarize") %>
          </button>
          <%= render "adm/projekts/imports/chats/action_tooltip", key: "summarize" %>
        </rich-tooltip>
      </div>
    </div>

    <%# Input area %>
    <form class="projekt-import-chat--input-area"
          data-projekt-imports--chat-target="form"
          data-action="submit->projekt-imports--chat#submit">
      <rich-tooltip delay="700">
        <label class="projekt-import-chat--attach-button"
               for="projekt-import-chat-attach"
               aria-label="<%= t('.attach') %>">
          <span class="material-symbols-outlined" aria-hidden="true">attach_file</span>
          <input id="projekt-import-chat-attach"
                 type="file"
                 multiple
                 accept=".pdf,.docx,.odt,.txt,.md"
                 hidden
                 data-action="change->projekt-imports--chat#filesPicked">
        </label>
        <%= render "adm/projekts/imports/chats/action_tooltip", key: "attach" %>
      </rich-tooltip>

      <div class="projekt-import-chat--input-wrapper">
        <ul class="projekt-import-chat--file-previews"
            data-projekt-imports--chat-target="attachments"
            aria-live="polite"></ul>

        <textarea class="projekt-import-chat--textarea"
                  rows="1"
                  data-projekt-imports--chat-target="textarea"
                  placeholder="<%= t('.input_placeholder') %>"
                  data-action="keydown->projekt-imports--chat#textareaKeydown input->projekt-imports--chat#textareaInput"></textarea>
      </div>

      <button type="submit"
              class="projekt-import-chat--send-button"
              data-projekt-imports--chat-target="sendButton"
              aria-label="<%= t('.send') %>">
        <span class="material-symbols-outlined" aria-hidden="true">send</span>
      </button>
    </form>

    <%# Import action %>
    <div class="projekt-import-chat--import-action">
      <%# Status, not a second control: the choice itself is made in the picker
          message, and this button scrolls back to it. %>
      <rich-tooltip delay="700">
        <button type="button"
                class="projekt-import-chat--title-image-summary"
                data-action="click->projekt-imports--chat#revealTitleImagePicker">
          <span class="projekt-import-chat--title-image-summary-thumb"
                data-projekt-imports--chat-target="titleImageSummaryThumb">
            <% summary_url = import_title_image_summary_url(@projekt_import) %>
            <% if summary_url.present? %>
              <%= image_tag summary_url, alt: "" %>
            <% else %>
              <span class="material-symbols-outlined" aria-hidden="true">image</span>
            <% end %>
          </span>
          <span class="projekt-import-chat--title-image-summary-label"
                data-projekt-imports--chat-target="titleImageSummary">
            <%= import_title_image_summary(@projekt_import) %>
          </span>
        </button>
        <%= render "adm/projekts/imports/chats/action_tooltip", key: "title_image" %>
      </rich-tooltip>

      <div class="projekt-import-chat--import-confirm"
           data-controller="shared--confirm-dialog"
           data-action="shared--confirm-dialog:confirmed->projekt-imports--chat#startImport">
        <rich-tooltip delay="700">
          <button type="button"
                  class="projekt-import-chat--topbar-button -primary"
                  data-projekt-imports--chat-target="importButton"
                  data-action="click->projekt-imports--chat#guardImport click->shared--confirm-dialog#open click->projekt-imports--chat#loadImportSummary">
            <span class="material-symbols-outlined" aria-hidden="true">upload</span>
            <%= @created_projekts.any? ? t(".commands.import_again") : t(".commands.import") %>
          </button>
          <template>
            <span class="projekt-import-chat--tooltip">
              <span class="projekt-import-chat--tooltip-title"><%= t(".tooltips.import.title") %></span>
              <span class="projekt-import-chat--tooltip-text projekt-import-chat--tooltip-text-default"><%= t(".tooltips.import.text") %></span>
              <span class="projekt-import-chat--tooltip-text projekt-import-chat--tooltip-text-busy"><%= t(".tooltips.import.busy_text") %></span>
            </span>
          </template>
        </rich-tooltip>

        <%= render Shared::ModalComponent.new(
              id: "projekt-import-confirm-modal",
              closeable: false,
              data: {
                "shared--confirm-dialog-target": "dialog",
                action: "click->shared--confirm-dialog#backdrop"
              }) do %>
          <div class="projekt-import-confirm -wide">
            <button type="button"
                    class="close-button round-icon-button"
                    data-action="click->shared--confirm-dialog#close"
                    aria-label="<%= t(".import_dialog.cancel") %>">
              <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>

            <div class="projekt-import-confirm--header">
              <h2 class="kern-title kern-title--large projekt-import-confirm--title"><%= t(".import_dialog.title") %></h2>
              <p class="kern-body projekt-import-confirm--message"><%= t(".confirm_import") %></p>
            </div>

            <div class="projekt-import-confirm--body"
                 data-projekt-imports--chat-target="importSummary">
              <div class="projekt-import-confirm--loading" role="status">
                <span class="kern-loader kern-loader--visible" aria-hidden="true"></span>
                <span class="kern-sr-only"><%= t(".import_dialog.summary_loading") %></span>
              </div>
            </div>

            <div class="projekt-import-confirm--actions">
              <button type="button" class="projekt-import-confirm--button -cancel" data-action="click->shared--confirm-dialog#close">
                <span class="kern-label"><%= t(".import_dialog.cancel") %></span>
              </button>
              <button type="button" class="projekt-import-confirm--button -confirm" data-action="click->shared--confirm-dialog#confirm">
                <span class="kern-label"><%= t(".import_dialog.confirm") %></span>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Overlay during final import %>
    <div class="projekt-import-chat--overlay -hidden"
         data-projekt-imports--chat-target="overlay">
      <div class="projekt-import-chat--overlay-content">
        <h3 class="projekt-import-chat--overlay-title">
          <%= t("adm.projekts.imports.chats.show.import_overlay_title") %>
        </h3>

        <div class="projekt-import-chat--overlay-progress">
          <div class="projekt-import-chat--overlay-progress-bar" role="progressbar" aria-label="<%= t('adm.projekts.imports.chats.show.import_overlay_title') %>">
            <div class="projekt-import-chat--overlay-progress-fill"
                 data-projekt-imports--chat-target="overlayFill"></div>
          </div>
          <span class="projekt-import-chat--overlay-label"
                data-projekt-imports--chat-target="overlayLabel"></span>
        </div>

        <p class="projekt-import-chat--overlay-message">
          <%= t("adm.projekts.imports.chats.show.import_overlay_message") %>
        </p>
      </div>
    </div>
  </div>
