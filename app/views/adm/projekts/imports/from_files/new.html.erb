<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, back_button_url: adm_projekts_imports_path) %>

<div class="kern-container my-5">
  <% if @missing_tools.any? %>
    <div class="projekt-import-from-file--tool-warning">
      <%= kern_alert(title: t("adm.projekts.imports.missing_tools.title"), style: :warning) do %>
        <ul>
          <% @missing_tools.each do |tool| %>
            <li>
              <%= t("adm.projekts.imports.missing_tools.features.#{tool[:key]}") %>
              <%= t("adm.projekts.imports.missing_tools.package", package: tool[:package]) %>
            </li>
          <% end %>
        </ul>

        <p><%= t("adm.projekts.imports.missing_tools.contact") %></p>
      <% end %>
    </div>
  <% end %>

  <div class="projekt-import-from-file"
       data-controller="projekt-imports--from-file"
       data-projekt-imports--from-file-create-url-value="<%= adm_projekts_imports_path %>"
       data-projekt-imports--from-file-max-bytes-value="<%= Adm::Projekts::Imports::FromFilesController::MAX_AGGREGATE_BYTES %>"
       data-projekt-imports--from-file-allowed-value="<%= Adm::Projekts::Imports::FromFilesController::ALLOWED_EXTENSIONS.join(',') %>"
       data-projekt-imports--from-file-csrf-value="<%= form_authenticity_token %>"
       data-projekt-imports--from-file-progress-extracting-value="<%= t('.progress.extracting') %>"
       data-projekt-imports--from-file-error-too-large-value="<%= t('.errors.too_large') %>"
       data-projekt-imports--from-file-error-unsupported-value="<%= t('.errors.unsupported_type') %>"
       data-projekt-imports--from-file-error-no-files-value="<%= t('.errors.no_files') %>"
       data-projekt-imports--from-file-error-session-expired-value="<%= t('.errors.session_expired') %>"
       data-projekt-imports--from-file-error-request-failed-value="<%= t('.errors.request_failed') %>">

    <form data-projekt-imports--from-file-target="form"
          class="projekt-import-from-file--form"
          enctype="multipart/form-data">

      <%# Upload area %>
      <div class="projekt-import-from-file--upload-area"
           data-projekt-imports--from-file-target="dropzone">
        <div class="projekt-import-from-file--upload-icon" aria-hidden="true">
          <span class="material-symbols-outlined">upload_file</span>
        </div>

        <h2 class="projekt-import-from-file--title"><%= t(".title") %></h2>

        <p class="projekt-import-from-file--hint">
          <%= t(".dropzone_label") %>
          <%= t(".dropzone_hint",
                types: Adm::Projekts::Imports::FromFilesController::ALLOWED_EXTENSIONS.map(&:upcase).join(", "),
                size: "500MB") %>
        </p>

        <label for="projekt-import-file-input"
               class="projekt-import-from-file--select-button">
          <%= t(".select_file") %>
        </label>

        <input id="projekt-import-file-input"
               type="file"
               multiple
               accept=".pdf,.docx,.odt,.txt,.md"
               data-projekt-imports--from-file-target="fileInput"
               data-action="change->projekt-imports--from-file#filesPicked">

        <p class="projekt-import-from-file--drop-hint"><%= t(".drop_hint") %></p>
      </div>

      <%# File preview %>
      <div class="projekt-import-from-file--file-preview -hidden"
           data-projekt-imports--from-file-target="secondary">

        <div class="projekt-import-from-file--file-list"
             data-projekt-imports--from-file-target="fileList"
             aria-live="polite"></div>

        <div class="projekt-import-from-file--user-prompt">
          <label for="projekt-import-instructions">
            <%= t(".instructions_label") %>
          </label>
          <textarea id="projekt-import-instructions"
                    data-projekt-imports--from-file-target="instructions"
                    rows="4"
                    placeholder="<%= t('.instructions_placeholder') %>"></textarea>
        </div>

        <div class="projekt-import-from-file--inline-error"
             data-projekt-imports--from-file-target="error"
             hidden></div>

        <div class="projekt-import-from-file--actions">
          <button type="submit"
                  class="projekt-import-from-file--submit-button"
                  data-action="click->projekt-imports--from-file#submit"
                  data-projekt-imports--from-file-target="submitButton">
            <%= t(".submit_label") %>
          </button>

          <button type="button"
                  class="projekt-import-from-file--ghost-button"
                  data-action="click->projekt-imports--from-file#resetFiles">
            <%= t(".choose_other_file") %>
          </button>
        </div>

        <p class="projekt-import-from-file--drop-hint"><%= t(".drop_hint") %></p>
      </div>
    </form>

    <%# Loader %>
    <div class="projekt-import-from-file--loader -hidden"
         data-projekt-imports--from-file-target="progress">
      <h3 class="projekt-import-from-file--loader-title">
        <%= t(".processing_title", default: "Analyse läuft…") %>
      </h3>

      <div class="projekt-import-from-file--progress-wrapper">
        <div class="projekt-import-from-file--progress-bar">
          <div class="projekt-import-from-file--progress-bar-fill"
               data-projekt-imports--from-file-target="progressFill"></div>
        </div>
        <span class="projekt-import-from-file--progress-label"
              data-projekt-imports--from-file-target="progressLabel">
          <%= t(".progress.extracting") %>
        </span>
      </div>

      <p class="projekt-import-from-file--loader-message"><%= t(".processing_message") %></p>

      <div class="projekt-import-from-file--loader-files"
           data-projekt-imports--from-file-target="loaderFiles"></div>
    </div>
  </div>
</div>
