<%= content_for :title, t("adm.projekts.index.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.projekts.index.title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= Projekt.model_name.human %></th>
          <th scope="col" class="kern-table__header"><%= Projekt.human_attribute_name("total_duration_start") %></th>
          <th scope="col" class="kern-table__header"><%= Projekt.human_attribute_name("total_duration_end") %></th>
          <th scope="col" class="kern-table__header">Status</th>
          <th scope="col" class="kern-table__header">Action</th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% @projekts.each do |projekt| %>
          <tr class="kern-table__row">
            <th scope="row" class="kern-table__header"><%= link_to projekt.title, adm_projekt_path(projekt), class: "link strong" %></th>
            <td class="kern-table__cell"><%= projekt.total_duration_start %></td>
            <td class="kern-table__cell"><%= projekt.total_duration_end %></td>
            <td class="kern-table__cell"><%= projekt.activated? %></td>
            <td class="kern-table__cell"></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="my-5">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
