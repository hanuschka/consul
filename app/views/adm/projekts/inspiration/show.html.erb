<%= content_for :title, t(".title") %>

<div class="adm-projekts-inspiration">
  <%= render Adm::HeaderComponent.new(breadcrumbs: @breadcrumbs, compact: true) %>

  <div class="kern-container-fluid">
    <% if @embed_url.present? %>
      <div class="adm-projekts-inspiration-import">
        <%= render Kern::FormFieldComponent.new(
              label: t("adm.projekts.projekts.instance_import.url_label"),
              hint: t("adm.projekts.projekts.instance_import.url_hint")
            ) do %>
          <%= form_with(
            url: adm_projekts_instance_imports_path,
            method: :post,
            class: "adm-projekts-inspiration-import__form"
          ) do |f| %>
            <%= f.url_field :source_url,
              class: "kern-form-input",
              label: false,
              placeholder: t("adm.projekts.projekts.instance_import.url_placeholder") %>

            <%= form_submit_button(
              text: t("adm.projekts.projekts.instance_import.action")
            ) %>
          <% end %>
        <% end %>
      </div>

      <%= render Shared::AdminIframeComponent.new(
            src: @embed_url,
            css_class: "adm-projekts-inspiration-frame",
            title: t("adm.projekts.inspiration.show.title"),
            referrerpolicy: "origin"
          ) %>
    <% else %>
      <%= kern_alert(title: t(".not_configured"), style: :warning) do %>
        <%= t(".not_configured_hint") %>
      <% end %>
    <% end %>
  </div>
</div>
