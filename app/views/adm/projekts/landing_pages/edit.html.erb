<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :slug, :string, path: adm_projekts_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_site_logo_for_transparent_background, :image, path: adm_projekts_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_site_logo_for_white_background, :image, path: adm_projekts_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_desktop_header_image, :image, path: adm_projekts_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_mobile_header_image, :image, path: adm_projekts_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :title, :string, path: adm_projekts_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :subtitle, :string, path: adm_projekts_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_hide_title_and_subtitle, :boolean, path: adm_projekts_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_hide_all_top_nav_links, :boolean, path: adm_projekts_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_show_projekts_overview, :boolean, path: adm_projekts_landing_page_path(@landing_page)) %>
  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_site_logo_follow_to_landing_page, :boolean, path: adm_projekts_landing_page_path(@landing_page)) %>

  <%= render Adm::AttributeEditorComponent.new(@landing_page, :landing_navigation_link_color, :color, path: adm_projekts_landing_page_path(@landing_page)) %>

  <h2 class="kern-title kern-title--small mb-3"><%= t("adm.homepage.show.content_cards_title") %></h2>
  <p class="kern-body mb-4 mb-md-0">
    <%= t("adm.homepage.show.content_cards_description") %>
  </p>

  <%= render Adm::SiteCustomization::ContentCardsComponent.new(landing_page_id: @landing_page.id) %>
</div>
