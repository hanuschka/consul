<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: @draft_version.title, breadcrumbs: @breadcrumbs, narrow: true) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".hint.intro") %></p>
    <table class="kern-table kern-table--compact">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th class="kern-table__header"><%= t(".hint.markdown") %></th>
          <th class="kern-table__header"><%= t(".hint.result") %></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% t(".hint.examples").each do |example| %>
          <tr class="kern-table__row">
            <td class="kern-table__cell"><code><%= example[:markdown] %></code></td>
            <td class="kern-table__cell"><%= example[:result] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
<%= render Adm::TabsComponent.new(tabs: legislation_draft_version_tabs(@draft_version)) %>

<div class="kern-container my-5">
  <div class="adm-markdown-editor" data-controller="adm-markdown-editor">
    <%= form_with model: @draft_version,
                  url: adm_projekts_phase_legislation_draft_version_path(@projekt_phase, @draft_version),
                  method: :patch do |f| %>

      <div class="adm-markdown-editor__toolbar d-flex align-items-center gap-2 mb-3">
        <h3 class="m-0 fs-4 fw-medium flex-grow-1"><%= t(".title") %></h3>
        <button type="button" class="kern-btn kern-btn--ghost kern-btn--small"
                data-action="adm-markdown-editor#toggleFullscreen">
          <span class="material-symbols-outlined" aria-hidden="true">fullscreen</span>
          <%= t(".fullscreen") %>
        </button>
        <%= kern_button(icon: "save", text: t(".save"), type: "submit") %>
      </div>

      <div class="adm-markdown-editor__panes d-flex flex-column flex-md-row gap-3">
        <div class="adm-markdown-editor__editor">
          <%= f.text_area :body,
                          label: false,
                          rows: 30,
                          class: "adm-markdown-editor__textarea",
                          data: {
                            adm_markdown_editor_target: "textarea",
                            action: "input->adm-markdown-editor#render scroll->adm-markdown-editor#syncScroll"
                          } %>
        </div>
        <div class="adm-markdown-editor__preview"
             data-adm-markdown-editor-target="preview"
             data-empty-text="<%= t('.preview_placeholder') %>">
        </div>
      </div>
    <% end %>
  </div>
</div>
