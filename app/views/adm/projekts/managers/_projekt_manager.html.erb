<tr class="kern-table__row" id="<%= dom_id(projekt_manager) %>">
  <th scope="row" class="kern-table__header"><%= projekt_manager.id %></th>
  <td class="kern-table__cell"><%= projekt_manager.name %></td>
  <td class="kern-table__cell"><%= projekt_manager.email %></td>
  <td class="kern-table__cell">
    <%= render Adm::AttributeEditors::BooleanComponent.new(
      projekt_manager,
      :manage_all_projekts?,
      path: toggle_manage_all_projekts_adm_projekts_manager_path(projekt_manager)
    ) %>
  </td>
  <td class="kern-table__cell">
    <%= kern_link_button(adm_projekts_manager_path(projekt_manager),
                text: t('shared.remove'), icon: "person_remove", style: :secondary,
                data: { turbo_method: :delete, turbo_confirm: t('shared.confirm_remove') }) %>
  </td>
</tr>
