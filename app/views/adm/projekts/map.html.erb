<%= content_for :title, [@projekt.name, t("adm.projekts.index.title")].join(" | ") %>

<% if @projekt.map_location.rendering_library == "virtualcity" %>
  <% provide :vc_maps do %>
    <script id="vcmap-core" type="module" src="/vcmap/vcmap-core.js"></script>
  <% end %>
<% end %>

<%= render Adm::HeaderComponent.new(title: @projekt.name, breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <%= render Adm::MapSettingComponent.new(
    map_location: @projekt.map_location,
    path: adm_projekt_map_location_path(@projekt)
  ) %>

  <%= render "adm/map_layers/map_layers", map_layers: @projekt.map_layers %>
</div>
