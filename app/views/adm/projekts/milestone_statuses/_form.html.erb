<%= form_with model: @status, url: url do |f| %>

  <%= render Kern::FormFieldComponent.new(label: t(".name_label"), hint: t(".name_hint"), stacked: true) do %>
    <%= f.text_field :name, label: false, required: true, placeholder: t(".name_placeholder") %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".description_label"), hint: t(".description_hint"), stacked: true) do %>
    <%= f.text_area :description, label: false, rows: 4, placeholder: t(".description_placeholder") %>
  <% end %>

  <%= form_submit_button(text: f.object.new_record? ? t("shared.create") : t(".submit")) %>
<% end %>
