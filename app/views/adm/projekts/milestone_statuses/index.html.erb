<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_milestone_status_path, text: t(".create_button") %>
  </div>

  <% if @statuses.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.description") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @statuses.each do |status| %>
            <tr id="<%= dom_id(status) %>" class="kern-table__row">
              <td class="kern-table__cell"><%= status.name %></td>
              <td class="kern-table__cell"><%= status.description %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_milestone_status_path(status)) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_milestone_status_path(status), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t(".no_statuses") %></p>
  <% end %>
</div>
