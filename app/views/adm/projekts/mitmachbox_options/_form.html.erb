<% sibling_options = Array(@question["options"]).sort_by { |option| option["position"].to_i } %>
<% option_index = sibling_options.index { |option| @option["id"].present? && option["id"] == @option["id"] } ||
                  sibling_options.size %>

<%= form_with scope: :option,
      url: url,
      method: local_assigns.fetch(:method, :post),
      data: { controller: "adm--mitmachbox-check",
              "adm--mitmachbox-check-fonts-url-value" => asset_path("mitmachbox/u8g2_fonts.json"),
              "adm--mitmachbox-check-prompt-value" => @question["prompt"].to_s,
              "adm--mitmachbox-check-multiple-value" => @question["question_type"] == "multiple_choice",
              "adm--mitmachbox-check-index-value" => option_index,
              "adm--mitmachbox-check-messages-value" => t("adm.projekts.mitmachbox.display_check").to_json } do |f| %>
  <%= render Kern::FormFieldComponent.new(label: t("adm.projekts.mitmachbox.options.label_label"),
                                          hint: t("adm.projekts.mitmachbox.options.label_hint")) do %>
    <%= f.text_field :label,
          label: false,
          value: @option["label"],
          data: { "adm--mitmachbox-check-target": "label", action: "input->adm--mitmachbox-check#check" } %>
  <% end %>

  <%= render "adm/projekts/mitmachbox_questions/display_check" %>

  <% if @question["question_type"] == "rating" %>
    <%= render Kern::FormFieldComponent.new(label: t("adm.projekts.mitmachbox.options.value_label"),
                                            hint: t("adm.projekts.mitmachbox.options.value_hint")) do %>
      <%= f.number_field :value, label: false, value: @option["value"] %>
    <% end %>
  <% end %>

  <% if branchable_question? %>
    <% choices = follow_up_choices %>

    <% if choices.any? %>
      <%= render Kern::FormFieldComponent.new(label: t("adm.projekts.mitmachbox.options.follow_up_label"),
                                              hint: t("adm.projekts.mitmachbox.options.follow_up_hint")) do %>
        <%= f.select :follow_up,
              options_for_select(
                [[t("adm.projekts.mitmachbox.options.follow_up_next"), ""]] +
                  choices +
                  [[t("adm.projekts.mitmachbox.options.follow_up_end"),
                    Adm::Projekts::MitmachboxOptionsController::END_OF_SURVEY]],
                current_follow_up
              ),
              {},
              { label: false } %>
      <% end %>
    <% else %>
      <p class="kern-body kern-body--small mb-4">
        <%= t("adm.projekts.mitmachbox.options.follow_up_last_question") %>
      </p>
    <% end %>
  <% end %>

  <%= form_submit_button(text: t("adm.projekts.mitmachbox.options.save_button")) %>
<% end %>
