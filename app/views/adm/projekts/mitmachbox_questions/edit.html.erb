<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, narrow: true, back_button_url: mitmachbox_survey_adm_projekts_phase_path(@projekt_phase)) %>

<div class="kern-container my-5">
  <%= render "form",
        url: adm_projekts_phase_mitmachbox_question_path(@projekt_phase, @question["id"]),
        method: :patch %>

  <hr class="kern-divider my-5" aria-hidden="true">

  <h3 class="kern-title kern-title--small mb-2"><%= t("adm.projekts.mitmachbox.questions.options_title") %></h3>
  <p class="kern-body kern-body--small mb-4"><%= t("adm.projekts.mitmachbox.questions.options_hint") %></p>

  <% question_options = (@question["options"] || []).sort_by { |option| option["position"].to_i } %>

  <% if question_options.size < Adm::Projekts::MitmachboxOptionsController::MAX_OPTIONS_PER_QUESTION %>
    <%= new_resource_link(new_adm_projekts_phase_mitmachbox_question_mitmachbox_option_path(@projekt_phase, @question["id"]),
          t("adm.projekts.mitmachbox.questions.add_option_button")) %>
  <% end %>

  <% if question_options.any? %>
    <div class="kern-table-responsive mb-5" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t("adm.projekts.mitmachbox.options.table.label") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.projekts.mitmachbox.options.table.value") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.projekts.mitmachbox.options.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% question_options.each do |option| %>
            <tr class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= option["label"] %></th>
              <td class="kern-table__cell"><%= option["value"] %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"),
                       url: edit_adm_projekts_phase_mitmachbox_question_mitmachbox_option_path(@projekt_phase, @question["id"], option["id"]),
                       icon: "edit",
                       style: :edit) %>
                  <% actions.with_action(label: t("shared.delete"),
                       url: adm_projekts_phase_mitmachbox_question_mitmachbox_option_path(@projekt_phase, @question["id"], option["id"]),
                       icon: "delete",
                       style: :delete,
                       data: { turbo_method: :delete, turbo_confirm: t("adm.projekts.mitmachbox.options.delete_confirm") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t("adm.projekts.mitmachbox.questions.no_options"), icon: "list") %>
  <% end %>
</div>
