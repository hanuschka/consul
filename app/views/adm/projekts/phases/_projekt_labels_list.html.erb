<%= new_resource_link(new_adm_projekts_phase_label_path(@projekt_phase), t("adm.projekts.phases.projekt_labels.create_button")) %>

<% if @projekt_labels.any? %>
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.projekt_labels.table.name") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.projekt_labels.table.icon") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.projekt_labels.table.actions") %></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% @projekt_labels.each do |label| %>
          <tr id="<%= dom_id(label) %>" class="kern-table__row">
            <th scope="row" class="kern-table__header"><%= label.name %></th>
            <td class="kern-table__cell">
              <% if label.icon.present? %>
                <i class="fas fa-<%= label.icon %>"></i>
              <% end %>
            </td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_label_path(@projekt_phase, label), icon: "edit", style: :edit) %>
                <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_label_path(@projekt_phase, label), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= empty_state(title: t("adm.projekts.phases.projekt_labels.no_labels_title"), description: t("adm.projekts.phases.projekt_labels.no_labels_description"), icon: "label") %>
<% end %>
