<%= new_resource_link(new_adm_projekts_phase_projekt_point_of_interest_category_path(@projekt_phase), t("adm.projekts.phases.projekt_point_of_interest_categories.create_button")) %>

<% if @categories.any? %>
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.projekt_point_of_interest_categories.table.name") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.projekt_point_of_interest_categories.table.icon") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.projekt_point_of_interest_categories.table.color") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.projekt_point_of_interest_categories.table.actions") %></th>
        </tr>
      </thead>

      <tbody class="kern-table__body">
        <% @categories.each do |category| %>
          <tr id="<%= dom_id(category) %>" class="kern-table__row">
            <th scope="row" class="kern-table__header"><%= category.name %></th>
            <td class="kern-table__cell">
              <% if category.icon.present? %>
                <i class="fas fa-<%= category.icon %>"></i>
              <% end %>
            </td>
            <td class="kern-table__cell">
              <% if category.color.present? %>
                <span class="color-preview" style="background-color: <%= category.color %>; display: inline-block; width: 20px; height: 20px; border-radius: 4px;"></span>
              <% end %>
            </td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_projekt_point_of_interest_category_path(@projekt_phase, category), icon: "edit", style: :edit) %>
                <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_projekt_point_of_interest_category_path(@projekt_phase, category), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= empty_state(title: t("adm.projekts.phases.projekt_point_of_interest_categories.no_categories_title"), description: t("adm.projekts.phases.projekt_point_of_interest_categories.no_categories_description"), icon: "category") %>
<% end %>
