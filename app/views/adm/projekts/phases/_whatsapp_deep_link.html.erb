<%
  phase_token = Whatsapp::PhaseTokenService.call(projekt_phase: projekt_phase)
  deep_link = Whatsapp.deep_link_url(
    t("adm.projekts.phases.whatsapp_deep_link.prefilled_text", token: phase_token)
  )
  deep_link_qr =
    if deep_link.present?
      RQRCode::QRCode.new(deep_link).as_svg(
        module_size: 4,
        standalone: true,
        use_path: true,
        viewbox: true
      )
    end
%>

<article class="kern-card mt-5">
  <div class="kern-card__container">
    <div class="kern-card__header">
      <hgroup>
        <h2 class="kern-title"><%= t("adm.projekts.phases.whatsapp_deep_link.title") %></h2>
        <p class="kern-subline"><%= t("adm.projekts.phases.whatsapp_deep_link.subline") %></p>
      </hgroup>
    </div>

    <section class="kern-card__body">
      <dl class="kern-description-list kern-description-list--col">
        <div class="kern-description-list-item">
          <dt class="kern-description-list-item__key">
            <%= t("adm.projekts.phases.whatsapp_deep_link.token") %>
          </dt>
          <dd class="kern-description-list-item__value"><%= phase_token %></dd>
        </div>

        <div class="kern-description-list-item">
          <dt class="kern-description-list-item__key">
            <%= t("adm.projekts.phases.whatsapp_deep_link.link") %>
          </dt>
          <dd class="kern-description-list-item__value">
            <% if deep_link.present? %>
              <a
                class="kern-link"
                href="<%= deep_link %>"
                target="_blank"
                rel="noopener"
              ><%= deep_link %></a>
            <% else %>
              <%= t("adm.projekts.phases.whatsapp_deep_link.missing_number") %>
            <% end %>
          </dd>
        </div>

        <% if deep_link_qr.present? %>
          <div class="kern-description-list-item">
            <dt class="kern-description-list-item__key">
              <%= t("adm.projekts.phases.whatsapp_deep_link.qr_code") %>
            </dt>
            <dd class="kern-description-list-item__value">
              <div class="whatsapp-deep-link__qr"><%= raw deep_link_qr %></div>
            </dd>
          </div>
        <% end %>
      </dl>
    </section>
  </div>
</article>
