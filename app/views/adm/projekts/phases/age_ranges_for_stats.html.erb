<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container my-5">
  <%= form_with model: @projekt_phase, url: update_age_ranges_for_stats_adm_projekts_phase_path(@projekt_phase), method: :patch, scope: @projekt_phase.model_name.param_key do |f| %>

    <%= render Kern::FormFieldComponent.new(label: t(".title")) do %>
      <% @age_ranges.each do |age_range| %>
        <div class="kern-checkbox">
          <%= check_box_tag "#{@projekt_phase.model_name.param_key}[age_ranges_for_stat_ids][]", age_range.id, @projekt_phase.age_ranges_for_stat_ids.include?(age_range.id), id: "age_range_#{age_range.id}" %>
          <%= label_tag "age_range_#{age_range.id}", age_range.name %>
        </div>
      <% end %>
    <% end %>

    <%= form_submit_button(text: t("shared.submit")) %>
  <% end %>
</div>
