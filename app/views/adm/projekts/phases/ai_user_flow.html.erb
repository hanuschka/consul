<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container my-5">
  <% ai_flow_feature_key = @projekt_phase.ai_flow_feature_key %>
  <% if ai_flow_feature_key.present? %>
    <% setting = @projekt_phase.settings.find_by(key: "feature.#{ai_flow_feature_key}") %>
    <% if setting %>
      <%= render Adm::AttributeEditorComponent.new(setting, :value, :boolean) %>
    <% end %>
  <% end %>

  <%= render(
    "criteria_list",
    projekt_phase: @projekt_phase,
    kind: "hard",
    criteria: @hard_criteria
  ) %>

  <%= render(
    "criteria_list",
    projekt_phase: @projekt_phase,
    kind: "soft",
    criteria: @soft_criteria
  ) %>

</div>
