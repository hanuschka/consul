<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(@budget, :voting_style, :select, select_options: Budget::VOTING_STYLES) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :currency_symbol, :select, select_options: Budget::CURRENCY_SYMBOLS) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :max_preselected, :string) %>

  <%= render Adm::AttributeEditorComponent.new(@heading, :price, :string) %>
  <%= render Adm::AttributeEditorComponent.new(@heading, :population, :string) %>
  <%= render Adm::AttributeEditorComponent.new(@heading, :max_ballot_lines, :string) %>

  <%= render Adm::AttributeEditorComponent.new(@budget, :hide_money, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :max_number_of_winners, :string) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :results_enabled, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :show_results_after_first_vote, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :show_percentage_values_only, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :stats_enabled, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(@budget, :advanced_stats_enabled, :boolean) %>

  <%= render Kern::FormFieldComponent.new(label: t(".administrators"), hint: t(".administrators_hint")) do %>
    <%= render "adm/projekts/phases/budget_edit/administrators",
               budget: @budget, projekt_phase: @projekt_phase %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".valuators"), hint: t(".valuators_hint")) do %>
    <%= render "adm/projekts/phases/budget_edit/valuators",
               budget: @budget, projekt_phase: @projekt_phase %>
  <% end %>
</div>
