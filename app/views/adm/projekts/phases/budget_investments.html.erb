<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<%
  headers = {
    title:              Kern::Table::HeaderComponent.new(:title, t(".table.title"), **@title_header_options.merge(data_field: "title")),
    moderation_status:  Kern::Table::HeaderComponent.new(:moderation_status, t(".table.moderation"), **@moderation_header_options.merge(data_field: "moderation_status")),
    feasibility:        Kern::Table::HeaderComponent.new(:feasibility, t(".table.feasibility"), **@feasibility_header_options.merge(data_field: "feasibility")),
    valuation_finished: Kern::Table::HeaderComponent.new(:valuation_finished, t(".table.valuation_finished"), **@valuation_finished_header_options.merge(data_field: "valuation_finished")),
    total_votes:        Kern::Table::HeaderComponent.new(:total_votes, t(".table.total_votes"), **@total_votes_header_options.merge(data_field: "total_votes")),
    preselected:        Kern::Table::HeaderComponent.new(:preselected, t(".table.preselected"), **@preselected_header_options.merge(data_field: "preselected")),
    selected:           Kern::Table::HeaderComponent.new(:selected, t(".table.selected"), **@selected_header_options.merge(data_field: "selected")),
    district:           Kern::Table::HeaderComponent.new(:district, t(".table.district"), **@district_header_options.merge(data_field: "district")),
    winner:             Kern::Table::HeaderComponent.new(:winner, t(".table.winner"), **@winner_header_options.merge(data_field: "winner"))
  }
%>

<div class="kern-container mb-5">
  <%= render Adm::IndexTableComponent.new(
        turbo_frame_id: "budget_investments_table",
        records: @investments,
        pagy: @pagy,
        headers: headers,
        column_count: 18 + (@budget.show_money? ? 1 : 0),
        column_selector: {
          storage_key: "adm-budget-investments-columns",
          defaults: "id,image,created_at,title,feasibility,valuation_finished,total_votes,selected,winner"
        },
        empty_state: {
          title: t(".no_investments_title"),
          description: t(".no_investments_description"),
          icon: "savings"
        },
        empty_state_filtered: {
          title: t(".no_results_filtered_title"),
          description: t(".no_results_filtered_description"),
          icon: "filter_alt_off"
        }
      ) do |c| %>
    <% c.with_toolbar_meta do %>
      <span class="adm-table-count" title="<%= t(".total_hint") %>">
        <span class="adm-table-count__value"><%= number_with_delimiter(@pagy.count) %></span>
        <span class="adm-table-count__label"><%= t(".total_label", count: @pagy.count) %></span>
      </span>
    <% end %>

    <% budget_policy = policy([:adm, :projekts, @budget]) %>
    <% if budget_policy.calculate_winners? %>
      <% c.with_toolbar_action do %>
        <%= kern_link_button calculate_winners_adm_projekts_phase_budget_path(@projekt_phase, @budget),
              text: t(".calculate_winners"), icon: "calculate", style: :secondary,
              data: { turbo_method: :put, turbo_confirm: t(".calculate_winners_confirm") } %>
      <% end %>
    <% end %>
    <% if budget_policy.recalculate_winners? %>
      <% c.with_toolbar_action do %>
        <%= kern_link_button recalculate_winners_adm_projekts_phase_budget_path(@projekt_phase, @budget),
              text: t(".recalculate_winners"), icon: "sync", style: :secondary,
              data: { turbo_method: :put, turbo_confirm: t(".recalculate_winners_confirm") } %>
      <% end %>
    <% end %>

    <% c.with_toolbar_action do %>
      <a href="<%= budget_investments_adm_projekts_phase_path(@projekt_phase, format: :csv, **request.query_parameters) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        <%= t(".download_csv") %>
      </a>
    <% end %>

    <% c.with_toolbar_action do %>
      <a href="<%= budget_investments_adm_projekts_phase_path(@projekt_phase, format: :geojson, **request.query_parameters) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">map</span>
        <%= t(".download_geojson") %>
      </a>
    <% end %>

    <% c.with_header_row do %>
      <th scope="col" class="kern-table__header" data-field="id"><%= t(".table.id") %></th>
      <th scope="col" class="kern-table__header" data-field="image"><%= t(".table.image") %></th>
      <th scope="col" class="kern-table__header" data-field="created_at"><%= t(".table.created_at") %></th>
      <%= render headers[:title] %>
      <%= render headers[:moderation_status] %>
      <%= render headers[:feasibility] %>
      <%= render headers[:valuation_finished] %>
      <%= render headers[:total_votes] %>
      <%= render headers[:preselected] %>
      <%= render headers[:selected] %>
      <% if @budget.show_money? %>
        <th scope="col" class="kern-table__header" data-field="price"><%= t(".table.price") %></th>
      <% end %>
      <th scope="col" class="kern-table__header" data-field="balloters"><%= t(".table.balloters") %></th>
      <th scope="col" class="kern-table__header" data-field="total_ballot_votes"><%= t(".table.total_ballot_votes") %></th>
      <%= render headers[:district] %>
      <%= render headers[:winner] %>
      <th scope="col" class="kern-table__header" data-field="admin"><%= t(".table.admin") %></th>
      <th scope="col" class="kern-table__header" data-field="author"><%= t(".table.author") %></th>
      <th scope="col" class="kern-table__header" data-field="valuator"><%= t(".table.valuator") %></th>
      <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
    <% end %>

    <% c.with_body do %>
      <% @investments.each do |investment| %>
        <%= render "adm/projekts/phases/budget_investments/budget_investment", investment: investment, projekt_phase: @projekt_phase, budget: @budget,
              similar_contributions_counts: @similar_contributions_counts %>
      <% end %>
    <% end %>
  <% end %>
</div>
