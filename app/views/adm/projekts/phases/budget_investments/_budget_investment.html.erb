<tr id="<%= dom_id(investment) %>" class="kern-table__row">
  <td class="kern-table__cell" data-field="id"><%= investment.id %></td>
  <td class="kern-table__cell" data-field="created_at"><%= l(investment.created_at, format: "%d.%m.%Y") %></td>
  <th scope="row" class="kern-table__header" data-field="title" <%= 'style="color: var(--kern-color-feedback-danger);"'.html_safe if investment.hidden? %>>
    <%= investment.title %><% if investment.hidden? %> (<%= t("shared.moderation_statuses.hidden") %>)<% end %>
  </th>
  <td class="kern-table__cell" data-field="moderation_status"><%= moderation_status(investment) %></td>
  <td class="kern-table__cell" data-field="feasibility"><%= Budget::Investment.human_attribute_name("feasibility_#{investment.feasibility}") %></td>
  <td class="kern-table__cell" data-field="valuation_finished"><%= human_boolean(investment.valuation_finished?) %></td>
  <td class="kern-table__cell" data-field="total_votes"><%= investment.total_votes %></td>
  <td class="kern-table__cell" data-field="preselected"><%= human_boolean(investment.preselected?) %></td>
  <td class="kern-table__cell" data-field="selected"><%= human_boolean(investment.selected?) %></td>
  <% if budget.show_money? %>
    <td class="kern-table__cell" data-field="price"><%= investment.formatted_price %></td>
  <% end %>
  <td class="kern-table__cell" data-field="balloters"><%= investment.ballot_lines_count %></td>
  <td class="kern-table__cell" data-field="total_ballot_votes"><%= investment.total_ballot_votes %></td>
  <td class="kern-table__cell" data-field="district"><%= investment.district&.name %></td>
  <td class="kern-table__cell" data-field="winner"><%= human_boolean(investment.winner?) %></td>
  <td class="kern-table__cell" data-field="admin"><%= investment.administrator&.description_or_name %></td>
  <td class="kern-table__cell" data-field="author"><%= investment.author&.name %></td>
  <td class="kern-table__cell" data-field="valuator">
    <% valuators = [investment.assigned_valuation_groups, investment.assigned_valuators].compact.presence %>
    <%= valuators ? valuators.join(", ") : "" %>
  </td>
  <td class="kern-table__cell">
    <% investment_policy = Adm::Projekts::BudgetPolicy.new(current_user, investment) %>
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% if investment_policy.show? %>
        <% unless investment.hidden? %>
          <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.manage"), url: adm_projekts_phase_budget_investment_path(projekt_phase, investment), icon: "settings") %>
          <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.people"), url: people_adm_projekts_phase_budget_investment_path(projekt_phase, investment), icon: "group") %>
          <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.milestones"), url: milestones_adm_projekts_phase_budget_investment_path(projekt_phase, investment), icon: "flag") %>
          <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.progress_bars"), url: progress_bars_adm_projekts_phase_budget_investment_path(projekt_phase, investment), icon: "trending_up") %>
        <% end %>
        <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.audits"), url: audits_adm_projekts_phase_budget_investment_path(projekt_phase, investment), icon: "history") %>
      <% end %>
      <% if investment_policy.unhide? %>
        <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.unhide"),
                               url: unhide_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
                               icon: "visibility", style: :edit, divider: true,
                               data: { turbo_method: :put }) %>
      <% elsif investment_policy.hide? %>
        <% if investment.flags_count > 0 && !investment.ignored_flag? %>
          <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.ignore_flag"),
                                 url: ignore_flag_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
                                 icon: "flag", style: :delete, divider: true,
                                 data: { turbo_method: :put }) %>
        <% end %>
        <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.hide"),
                               url: hide_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
                               icon: "visibility_off", style: :delete,
                               data: { turbo_method: :put, turbo_confirm: t("adm.projekts.phases.budget_investments.table.confirm_hide", name: investment.title) }) %>
      <% end %>
    <% end %>
  </td>
</tr>
