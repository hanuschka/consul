<tr id="<%= dom_id(investment) %>" class="kern-table__row">
  <td class="kern-table__cell"><%= investment.id %></td>
  <td class="kern-table__cell"><%= l(investment.created_at, format: "%d.%m.%Y") %></td>
  <th scope="row" class="kern-table__header"><%= investment.title %></th>
  <td class="kern-table__cell"><%= moderation_status(investment) %></td>
  <td class="kern-table__cell"><%= Budget::Investment.human_attribute_name("feasibility_#{investment.feasibility}") %></td>
  <td class="kern-table__cell"><%= human_boolean(investment.valuation_finished?) %></td>
  <td class="kern-table__cell"><%= investment.total_votes %></td>
  <td class="kern-table__cell"><%= human_boolean(investment.preselected?) %></td>
  <td class="kern-table__cell"><%= human_boolean(investment.selected?) %></td>
  <% if budget.show_money? %>
    <td class="kern-table__cell"><%= investment.formatted_price %></td>
  <% end %>
  <td class="kern-table__cell"><%= investment.ballot_lines_count %></td>
  <td class="kern-table__cell"><%= investment.total_ballot_votes %></td>
  <td class="kern-table__cell"><%= investment.district&.name %></td>
  <td class="kern-table__cell"><%= human_boolean(investment.winner?) %></td>
  <td class="kern-table__cell"><%= investment.administrator&.description_or_name %></td>
  <td class="kern-table__cell"><%= investment.author&.name %></td>
  <td class="kern-table__cell">
    <% valuators = [investment.assigned_valuation_groups, investment.assigned_valuators].compact.presence %>
    <%= valuators ? valuators.join(", ") : "" %>
  </td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.view"), url: adm_projekts_phase_budget_investment_path(projekt_phase, investment)) %>
      <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.pdf_link"), url: adm_projekts_phase_budget_investment_path(projekt_phase, investment, format: :pdf)) %>
      <% investment_policy = Adm::Projekts::BudgetPolicy.new(current_user, investment) %>
      <% if investment_policy.unhide? %>
        <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.unhide"),
                               url: unhide_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
                               data: { turbo_method: :put }) %>
      <% elsif investment_policy.hide? %>
        <% if investment.flags_count > 0 && !investment.ignored_flag? %>
          <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.ignore_flag"),
                                 url: ignore_flag_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
                                 data: { turbo_method: :put }) %>
        <% end %>
        <% actions.with_action(label: t("adm.projekts.phases.budget_investments.table.hide"),
                               url: hide_adm_projekts_phase_budget_investment_path(projekt_phase, investment),
                               data: { turbo_method: :put, turbo_confirm: t("adm.projekts.phases.budget_investments.table.confirm_hide", name: investment.title) }) %>
      <% end %>
      <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_budget_investment_path(projekt_phase, investment), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
    <% end %>
  </td>
</tr>
