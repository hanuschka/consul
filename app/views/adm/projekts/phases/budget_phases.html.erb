<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <% if @budget_phases.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.name") %></th>
            <th scope="col" class="kern-table__header" style="width: 120px"><%= t(".table.starts_at") %></th>
            <th scope="col" class="kern-table__header" style="width: 120px"><%= t(".table.ends_at") %></th>
            <th scope="col" class="kern-table__header" style="width: 120px"><%= t(".table.enabled") %></th>
            <th scope="col" class="kern-table__header" style="width: 120px"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody id="budget_phases_table_body" class="kern-table__body">
          <%= render "adm/projekts/phases/budget_phases/table_body", budget_phases: @budget_phases, projekt_phase: @projekt_phase %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t(".no_phases") %></p>
  <% end %>
</div>
