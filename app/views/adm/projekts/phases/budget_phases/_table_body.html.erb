<% budget_phases.each do |budget_phase| %>
  <tr id="<%= dom_id(budget_phase) %>" class="kern-table__row">
    <th scope="row" class="kern-table__header">
      <%= budget_phase.name %>
      <% if budget_phase.current? %>
        <span class="kern-status-dot kern-status-dot--active" title="<%= t("adm.projekts.phases.budget_phases.table.current") %>"></span>
      <% end %>
    </th>
    <td class="kern-table__cell"><%= budget_phase.starts_at&.strftime("%d.%m.%Y %H:%M") %></td>
    <td class="kern-table__cell"><%= (budget_phase.ends_at - 1.minute)&.strftime("%d.%m.%Y %H:%M") if budget_phase.ends_at %></td>
    <td class="kern-table__cell">
      <div id="<%= dom_id(budget_phase, :enabled) %>">
        <%= render Adm::AttributeEditors::BooleanComponent.new(
          budget_phase,
          :enabled,
          path: toggle_enabled_adm_projekts_phase_budget_phase_path(projekt_phase, budget_phase)
        ) %>
      </div>
    </td>
    <td class="kern-table__cell">
      <%= render Kern::Table::ActionsComponent.new do |actions| %>
        <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_budget_phase_path(projekt_phase, budget_phase), icon: "edit", style: :edit) %>
      <% end %>
    </td>
  </tr>
<% end %>
