<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <% if @comments.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.body") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.author") %></th>
            <%= render Kern::Table::HeaderComponent.new(:moderation_status, t(".table.moderation"), **@moderation_header_options) %>
            <th scope="col" class="kern-table__header" style="width: 200px"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @comments.each do |comment| %>
            <%= render "adm/projekts/phases/comments/comment", comment: comment, projekt_phase: @projekt_phase %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy && @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="kern-alert kern-alert--info" role="alert">
      <%= t(".no_comments") %>
    </div>
  <% end %>
</div>
