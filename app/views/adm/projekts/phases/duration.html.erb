<%= content_for :title, [@projekt_phase.title, t("adm.projekts.phases.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <%= render Kern::FormFieldComponent.new(label: t('.dates_label'), hint: t('.dates_description')) do %>
    <%= render 'adm/projekts/phases/duration/dates', projekt_phase: @projekt_phase %>
  <% end %>

  <% @projekt_phase.settings_in_duration_tab.each do |setting_key, _field_type| %>
    <% setting = @projekt_phase.settings.find_by(key: setting_key) %>
    <% if setting %>
      <%= render Adm::AttributeEditorComponent.new(setting, :value, :date) %>
    <% end %>
  <% end %>
</div>
