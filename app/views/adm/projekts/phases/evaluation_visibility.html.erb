<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <h2 class="h3 mb-4"><%= t(".heading") %></h2>
  <p class="text-muted mb-4"><%= t(".description") %></p>

  <%= form_with(
    model: @visibility,
    url: update_evaluation_visibility_adm_projekts_phase_path(@projekt_phase),
    method: :patch,
    local: true,
    class: "evaluation-visibility-form"
  ) do |form| %>
    <%
      phase_type = @projekt_phase.type
      available_sections = PdfServices::EvaluationPdfSelection.available_sections(phase_type)
    %>

    <div class="evaluation-visibility-form__phase">
      <div class="evaluation-visibility-form__phase-header">
        <strong><%= @projekt_phase.title %></strong>
        <span class="evaluation-visibility-form__phase-type">
          <%= t("adm.projekts.projekts.evaluation.#{phase_type.to_s.split("::").last.underscore}",
            default: phase_type.to_s.split("::").last) %>
        </span>
      </div>

      <div class="evaluation-visibility-form__sections">
        <% available_sections.each do |section_key| %>
          <%
            field_name = "projekt_phase_evaluation_visibility[show_#{section_key}]"
            field_id = "projekt_phase_evaluation_visibility_show_#{section_key}"
            checked = @visibility["show_#{section_key}"]
          %>
          <label class="kern-switch -row" for="<%= field_id %>">
            <%= hidden_field_tag field_name, "0", id: nil %>
            <%= check_box_tag field_name, "1", checked,
              id: field_id,
              class: "kern-switch__input" %>
            <span class="kern-switch__track" aria-hidden="true">
              <span class="kern-switch__thumb"></span>
            </span>
            <span class="kern-switch__label">
              <%= t("adm.projekts.projekts.evaluation.pdf_options.sections.#{section_key}") %>
            </span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="d-flex gap-2 mt-4">
      <%= kern_link_button(
        evaluation_adm_projekts_projekt_path(@projekt_phase.projekt),
        text: t(".cancel"),
        icon: "arrow_back",
        style: :secondary
      ) %>
      <%= form_submit_button(text: t(".save"), icon: "save", style: :primary) %>
    </div>
  <% end %>
</div>
