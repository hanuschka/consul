<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".hint_text_p1") %></p>
    <dl class="kern-description-list kern-description-list--col mt-3">
      <div class="kern-description-list-item">
        <dt class="kern-description-list-item__key"><%= t(".hint_types.primary.title") %></dt>
        <dd class="kern-description-list-item__value"><%= t(".hint_types.primary.description") %></dd>
      </div>
      <div class="kern-description-list-item">
        <dt class="kern-description-list-item__key"><%= t(".hint_types.follow_up.title") %></dt>
        <dd class="kern-description-list-item__value"><%= t(".hint_types.follow_up.description") %></dd>
      </div>
    </dl>
    <p class="adm-hint__text adm-hint__text--spaced"><%= t(".hint_text_p2") %></p>
  <% end %>
<% end %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <%= new_resource_link(new_adm_projekts_phase_formular_field_path(@projekt_phase), t(".create_button")) %>

  <h3 class="kern-title kern-title--small mb-3"><%= t(".primary_fields_title") %></h3>

  <% if @formular_fields_primary.any? %>
    <%= render "adm/projekts/phases/formular/fields_table", formular_fields: @formular_fields_primary %>
  <% else %>
    <%= empty_state(title: t(".no_fields_title"), description: t(".no_fields_description"), icon: "assignment") %>
  <% end %>

  <h3 class="kern-title kern-title--small mb-3 mt-5"><%= t(".follow_up_fields_title") %></h3>

  <% if @formular_fields_follow_up.any? %>
    <%= render "adm/projekts/phases/formular/fields_table", formular_fields: @formular_fields_follow_up %>
  <% else %>
    <%= empty_state(title: t(".no_follow_up_fields_title"), description: t(".no_follow_up_fields_description"), icon: "post_add") %>
  <% end %>
</div>
