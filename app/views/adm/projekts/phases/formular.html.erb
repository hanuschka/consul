<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-5">
    <%= kern_link_button new_adm_projekts_phase_formular_field_path(@projekt_phase), text: t(".create_button") %>
  </div>

  <h3 class="kern-title kern-title--small mb-3"><%= t(".primary_fields_title") %></h3>

  <% if @formular_fields_primary.any? %>
    <%= render "adm/projekts/phases/formular/fields_table", formular_fields: @formular_fields_primary %>
  <% else %>
    <p class="kern-body mb-5"><%= t(".no_fields") %></p>
  <% end %>

  <h3 class="kern-title kern-title--small mb-3"><%= t(".follow_up_fields_title") %></h3>

  <% if @formular_fields_follow_up.any? %>
    <%= render "adm/projekts/phases/formular/fields_table", formular_fields: @formular_fields_follow_up %>
  <% else %>
    <p class="kern-body mb-4"><%= t(".no_follow_up_fields") %></p>
  <% end %>
</div>
