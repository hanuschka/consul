<div class="kern-table-responsive mb-5" tabindex="0">
  <table class="kern-table">
    <thead class="kern-table__head">
      <tr class="kern-table__row">
        <th scope="col" class="kern-table__header"></th>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.formular.table.name") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.formular.table.kind") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.formular.table.required") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.formular.table.actions") %></th>
      </tr>
    </thead>

    <tbody class="kern-table__body"
           data-controller="sortable"
           data-sortable-url-value="<%= reorder_adm_projekts_phase_formular_fields_path(@projekt_phase) %>">
      <% formular_fields.each do |field| %>
        <tr id="<%= dom_id(field) %>" class="kern-table__row" data-sortable-id="<%= field.id %>">
          <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
            <span class="material-symbols-outlined">drag_indicator</span>
          </td>
          <th scope="row" class="kern-table__header"><%= field.name %></th>
          <td class="kern-table__cell"><%= t("adm.projekts.phases.formular.kinds.#{field.kind}") %></td>
          <td class="kern-table__cell"><%= field.required ? t("shared.yes") : t("shared.no") %></td>
          <td class="kern-table__cell">
            <%= render Kern::Table::ActionsComponent.new do |actions| %>
              <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_formular_field_path(@projekt_phase, field), icon: "edit", style: :edit) %>
              <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_formular_field_path(@projekt_phase, field), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
