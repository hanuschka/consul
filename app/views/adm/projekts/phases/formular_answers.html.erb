<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <% if @formular_answers.any? %>
    <div class="d-flex align-items-center justify-content-end gap-3 mb-3">
      <a href="<%= formular_answers_adm_projekts_phase_path(@projekt_phase, format: :csv) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        <%= t(".download_csv") %>
      </a>
    </div>

    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <% @formular_fields.each do |field| %>
              <th scope="col" class="kern-table__header"><%= field.name %></th>
            <% end %>
            <th scope="col" class="kern-table__header"><%= t(".table.submitter") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.email") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.submitted_at") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @formular_answers.each do |answer| %>
            <tr id="<%= dom_id(answer) %>" class="kern-table__row">
              <% @formular_fields.each do |field| %>
                <td class="kern-table__cell">
                  <% case field.kind %>
                  <% when "image" %>
                    <% answer.formular_answer_images.select { |img| img.formular_field_key == field.key }.each do |image| %>
                      <% if image.attachment.attached? %>
                        <%= link_to image.title.presence || field.name,
                              rails_blob_path(image.attachment, disposition: "inline"),
                              target: "_blank", rel: "noopener" %><br>
                      <% end %>
                    <% end %>
                  <% when "document" %>
                    <% answer.formular_answer_documents.select { |doc| doc.formular_field_key == field.key }.each do |document| %>
                      <% if document.attachment.attached? %>
                        <%= link_to document.title.presence || field.name,
                              rails_blob_path(document.attachment, disposition: "attachment"),
                              target: "_blank", rel: "noopener" %><br>
                      <% end %>
                    <% end %>
                  <% else %>
                    <%= answer.answers[field.key] %>
                  <% end %>
                </td>
              <% end %>
              <td class="kern-table__cell"><%= answer.submitter_id %></td>
              <td class="kern-table__cell"><%= answer.original_submitter_email %></td>
              <td class="kern-table__cell"><%= l(answer.created_at.to_date, format: :long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_answers_title"), description: t(".no_answers_description"), icon: "description") %>
  <% end %>
</div>
