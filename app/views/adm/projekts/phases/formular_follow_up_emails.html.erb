<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start mb-5">
    <%= button_to adm_projekts_phase_formular_follow_up_letters_path(@projekt_phase),
      method: :post,
      class: "kern-btn kern-btn--primary" do %>
      <span class="kern-label material-symbols-outlined" aria-hidden="true">add</span>
      <span class="kern-label"><%= t(".create_new") %></span>
    <% end %>
  </div>

  <% if @formular_follow_up_letters.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".letters_table.subject") %></th>
            <th scope="col" class="kern-table__header"><%= t(".letters_table.recipients") %></th>
            <th scope="col" class="kern-table__header"><%= t(".letters_table.status") %></th>
            <th scope="col" class="kern-table__header"><%= t(".letters_table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @formular_follow_up_letters.each do |letter| %>
            <tr id="<%= dom_id(letter) %>" class="kern-table__row">
              <td class="kern-table__cell"><%= letter.subject || t(".letters_table.no_subject") %></td>
              <td class="kern-table__cell"><%= letter.recipients.count %></td>
              <td class="kern-table__cell">
                <% if letter.sent_at.present? %>
                  <span class="kern-badge kern-badge--success"><%= t(".letters_table.sent_at", date: l(letter.sent_at, format: :long)) %></span>
                <% else %>
                  <span class="kern-badge kern-badge--info"><%= t(".letters_table.draft") %></span>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <% if letter.draft? %>
                  <%= render Kern::Table::ActionsComponent.new do |actions| %>
                    <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_formular_follow_up_letter_path(@projekt_phase, letter), style: :edit) %>
                    <% actions.with_action(label: t(".letters_table.send_emails"), url: send_emails_adm_projekts_phase_formular_follow_up_letter_path(@projekt_phase, letter), icon: "send", data: { turbo_method: :post, turbo_confirm: t(".letters_table.send_confirm") }) %>
                    <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_formular_follow_up_letter_path(@projekt_phase, letter), style: :delete, divider: true, data: { turbo_method: :delete, turbo_confirm: t(".letters_table.delete_confirm") }) %>
                  <% end %>
                <% else %>
                  <%= link_to adm_projekts_phase_formular_follow_up_letter_path(@projekt_phase, letter), class: "text-decoration-none px-2", style: "color: var(--bs-danger)", data: { turbo_method: :delete, turbo_confirm: t(".letters_table.delete_confirm") } do %>
                    <span class="material-symbols-outlined">delete</span>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_emails_title"), description: t(".no_emails_description"), icon: "mail") %>
  <% end %>
</div>
