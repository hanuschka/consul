<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_legislation_draft_version_path(@projekt_phase), text: t(".create_button"), style: :primary %>
  </div>

  <% if @process.draft_versions.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.created_at") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.status") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.comments") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.final_version") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @process.draft_versions.each do |draft_version| %>
            <tr id="<%= dom_id(draft_version) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= draft_version.title %></th>
              <td class="kern-table__cell"><%= draft_version.created_at.to_date %></td>
              <td class="kern-table__cell">
                <% if draft_version.status == "draft" %>
                  <%= Legislation::DraftVersion.human_attribute_name(:status_draft) %>
                <% else %>
                  <%= Legislation::DraftVersion.human_attribute_name(:status_published) %>
                <% end %>
              </td>
              <td class="kern-table__cell"><%= draft_version.total_comments %></td>
              <td class="kern-table__cell">
                <% if draft_version.final_version %>
                  <span class="icon-check"></span>
                <% else %>
                  <span class="icon-x"></span>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_legislation_draft_version_path(@projekt_phase, draft_version)) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_legislation_draft_version_path(@projekt_phase, draft_version), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="kern-alert kern-alert--info" role="alert">
      <%= t(".no_draft_versions") %>
    </div>
  <% end %>
</div>
