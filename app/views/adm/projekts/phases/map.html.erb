<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<% if @projekt_phase.map_location&.rendering_library == "virtualcity" %>
  <% provide :vc_maps do %>
    <script id="vcmap-core" type="module" src="/vcmap/vcmap-core.js"></script>
  <% end %>
<% end %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <%= render Adm::MapSettingComponent.new(
    map_location: @projekt_phase.map_location,
    path: adm_projekts_phase_map_location_path(@projekt_phase)
  ) %>

  <%= render Adm::MapLayersComponent.new(map_layers: @projekt_phase.map_layers, mappable: @projekt_phase) %>

  <%= render Adm::MasterportalImportPanelComponent.new(projekt_phase: @projekt_phase) %>

  <% if @masterportal_pins_count.to_i.positive? %>
    <%= turbo_frame_tag(
      dom_id(@projekt_phase, :masterportal_pins_summary),
      src: masterportal_pins_summary_adm_projekts_phase_path(@projekt_phase)
    ) do %>
      <%= render Adm::TurboFramePlaceholderComponent.new(
        text: t("adm.projekts.phases.masterportal_pins_summary.loading"),
        min_height: 520
      ) %>
    <% end %>
  <% end %>
</div>
