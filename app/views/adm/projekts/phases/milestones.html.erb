<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_milestone_path(@projekt_phase), text: t(".create_button") %>
  </div>

  <% if @milestones.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.description") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.publication_date") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.status") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.image") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @milestones.each do |milestone| %>
            <tr id="<%= dom_id(milestone) %>" class="kern-table__row">
              <td class="kern-table__cell"><%= truncate(strip_tags(milestone.description), length: 80) %></td>
              <td class="kern-table__cell">
                <% if milestone.custom_date.present? %>
                  <%= milestone.custom_date %>
                <% elsif milestone.publication_date.present? %>
                  <%= l(milestone.publication_date) %>
                <% end %>
              </td>
              <td class="kern-table__cell"><%= milestone.status&.name %></td>
              <td class="kern-table__cell">
                <% if milestone.image&.attached? %>
                  <%= link_to t(".table.show_image"), milestone.image.variant(:large), target: :_blank %>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_milestone_path(@projekt_phase, milestone)) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_milestone_path(@projekt_phase, milestone), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t(".no_milestones") %></p>
  <% end %>
</div>
