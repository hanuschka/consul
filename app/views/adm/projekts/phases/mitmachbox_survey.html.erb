<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<% survey_ready = Mitmachbox.configured? && !@survey_lost && @mitmachbox_error.nil? && @survey.present? %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) do |header| %>
  <% if survey_ready %>
    <% header.with_hint do %>
      <p class="adm-hint__text"><%= t(".hint_text") %></p>
    <% end %>
  <% end %>
<% end %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <% if !Mitmachbox.configured? %>
    <%= render "adm/projekts/phases/mitmachbox_survey/unconfigured" %>
  <% elsif @survey_lost %>
    <%= render "adm/projekts/phases/mitmachbox_survey/missing_survey", lost: true %>
  <% elsif @mitmachbox_error.present? %>
    <%= kern_alert(title: mitmachbox_error_message(@mitmachbox_error), style: :danger) %>
  <% elsif @survey.nil? %>
    <%= render "adm/projekts/phases/mitmachbox_survey/missing_survey", lost: false %>
  <% else %>
    <%= render "adm/projekts/phases/mitmachbox_survey/lifecycle" %>
    <%= render "adm/projekts/phases/mitmachbox_survey/versions_panel" %>
  <% end %>
</div>
