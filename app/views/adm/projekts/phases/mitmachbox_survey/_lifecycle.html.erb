<% state = @survey["state"].to_s %>
<% open_disabled = @survey["current_version_id"].nil? %>
<% badge_variants = { "open" => "kern-badge--success", "closed" => "kern-badge--warning", "draft" => "kern-badge--info" } %>
<% badge_icons = { "open" => "radio_button_checked", "closed" => "pause_circle", "draft" => "radio_button_unchecked", "archived" => "inventory_2" } %>

<section>
  <%= render "adm/projekts/phases/mitmachbox_survey/section_header",
        title: t("adm.projekts.phases.mitmachbox_survey.survey_section_title"),
        pill_text: t("adm.projekts.phases.mitmachbox_survey.survey_scope_pill"),
        pill_icon: "sensors",
        pill_variant: "kern-badge--warning" %>

  <%= render layout: "adm/projekts/phases/mitmachbox_survey/setting_row",
        locals: { title: t("adm.projekts.phases.mitmachbox_survey.status_row_title"),
                  text: t("adm.projekts.phases.mitmachbox_survey.status_row_text") } do %>
    <div class="d-flex flex-column align-items-start gap-2">
      <span class="kern-badge <%= badge_variants[state] %>">
        <span class="material-symbols-outlined" aria-hidden="true"><%= badge_icons[state] %></span>
        <span class="kern-label"><%= t("adm.projekts.phases.mitmachbox_survey.status_badges.#{state}") %></span>
      </span>

      <p class="kern-body kern-body--small text-muted mb-0">
        <%= t("adm.projekts.phases.mitmachbox_survey.responses_total", count: @survey["responses_count"]) %>
      </p>

      <% if state == "open" %>
        <%= form_with url: mitmachbox_survey_state_adm_projekts_phase_path(@projekt_phase, state: "closed"),
              method: :patch,
              data: { turbo_confirm: t("adm.projekts.phases.mitmachbox_survey.close_confirm") } do %>
          <%= kern_button type: :submit,
                text: t("adm.projekts.phases.mitmachbox_survey.close_button"),
                icon: "stop_circle" %>
        <% end %>
      <% elsif state.in?(%w[draft closed]) %>
        <% reopen = state == "closed" %>
        <%= form_with url: mitmachbox_survey_state_adm_projekts_phase_path(@projekt_phase, state: "open"),
              method: :patch,
              data: { turbo_confirm: t("adm.projekts.phases.mitmachbox_survey.#{reopen ? "reopen_confirm" : "open_confirm"}") } do %>
          <%= kern_button type: :submit,
                text: t("adm.projekts.phases.mitmachbox_survey.#{reopen ? "reopen_button" : "open_button"}"),
                icon: "play_circle",
                disabled: open_disabled %>
        <% end %>

        <% if open_disabled %>
          <p class="kern-body kern-body--small mb-0">
            <%= t("adm.projekts.phases.mitmachbox_survey.open_requires_published_hint") %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
