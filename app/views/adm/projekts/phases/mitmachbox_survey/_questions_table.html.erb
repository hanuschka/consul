<% sorted_questions = questions.sort_by { |question| question["position"].to_i } %>
<% questions_by_id = questions.index_by { |question| question["id"] } %>

<div class="kern-table-responsive mb-5" tabindex="0">
  <table class="kern-table">
    <thead class="kern-table__head">
      <tr class="kern-table__row">
        <% if editable %>
          <th scope="col" class="kern-table__header">
            <span class="kern-sr-only"><%= t("adm.projekts.phases.mitmachbox_survey.table.order") %></span>
          </th>
        <% end %>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.mitmachbox_survey.table.prompt") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.mitmachbox_survey.table.question_type") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.mitmachbox_survey.table.required") %></th>
        <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.mitmachbox_survey.table.options") %></th>
        <% if editable %>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.mitmachbox_survey.table.actions") %></th>
        <% end %>
      </tr>
    </thead>

    <tbody class="kern-table__body"<% if editable %> data-controller="sortable" data-sortable-url-value="<%= reorder_adm_projekts_phase_mitmachbox_questions_path(@projekt_phase) %>"<% end %>>
      <% sorted_questions.each_with_index do |question, index| %>
        <tr class="kern-table__row"<% if editable %> data-sortable-id="<%= question["id"] %>"<% end %>>
          <% if editable %>
            <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
              <span class="material-symbols-outlined" aria-hidden="true">drag_indicator</span>
            </td>
          <% end %>
          <% condition_source = questions_by_id[question.dig("condition", "question_id")] %>
          <% condition_labels = (condition_source&.dig("options") || [])
                                  .select { |option| Array(question.dig("condition", "option_ids")).include?(option["id"]) }
                                  .map { |option| option["label"] } %>
          <th scope="row" class="kern-table__header">
            <%= question["prompt"] %>
            <% if condition_labels.any? %>
              <span class="d-block kern-body kern-body--small">
                <%= t("adm.projekts.phases.mitmachbox_survey.table.condition_summary",
                      question: condition_source["prompt"],
                      options: condition_labels.join(t("adm.projekts.phases.mitmachbox_survey.table.condition_options_connector"))) %>
              </span>
            <% end %>
          </th>
          <td class="kern-table__cell">
            <%= t("adm.projekts.mitmachbox.questions.question_types.#{question["question_type"]}") %>
          </td>
          <td class="kern-table__cell"><%= human_boolean(question["required"]) %></td>
          <td class="kern-table__cell"><%= (question["options"] || []).size %></td>
          <% if editable %>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% if index.positive? %>
                  <% actions.with_action(label: t("adm.projekts.phases.mitmachbox_survey.move_up"),
                       url: move_up_adm_projekts_phase_mitmachbox_question_path(@projekt_phase, question["id"]),
                       icon: "arrow_upward",
                       data: { turbo_method: :patch }) %>
                <% end %>
                <% if index < sorted_questions.size - 1 %>
                  <% actions.with_action(label: t("adm.projekts.phases.mitmachbox_survey.move_down"),
                       url: move_down_adm_projekts_phase_mitmachbox_question_path(@projekt_phase, question["id"]),
                       icon: "arrow_downward",
                       data: { turbo_method: :patch }) %>
                <% end %>
                <% actions.with_action(label: t("adm.projekts.phases.mitmachbox_survey.edit"),
                     url: edit_adm_projekts_phase_mitmachbox_question_path(@projekt_phase, question["id"]),
                     icon: "edit",
                     style: :edit) %>
                <% actions.with_action(label: t("adm.projekts.phases.mitmachbox_survey.delete"),
                     url: adm_projekts_phase_mitmachbox_question_path(@projekt_phase, question["id"]),
                     icon: "delete",
                     style: :delete,
                     data: { turbo_method: :delete, turbo_confirm: t("adm.projekts.phases.mitmachbox_survey.delete_confirm") }) %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
