<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>
<% turbo_refreshes_with(method: :replace, scroll: :preserve) %>

<% stepped = params[:answered].present? %>
<% started = params[:started].present? %>
<% welcome = !stepped && !started %>
<% key_count = 5 %>
<% fonts_url = asset_path("mitmachbox/u8g2_fonts.json") %>
<% next_label = t(".next") %>
<% start_label = t(".start") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase, current_action: "mitmachbox_survey")) %>

<div class="kern-container mb-5">
  <h3 class="kern-title kern-title--small mb-2">
    <%= t(".version_#{@test_run_version}", number: @test_run_version_ref["version_number"]) %>
  </h3>

  <p class="kern-body kern-body--small mb-4"><%= t(".hint") %></p>

  <% if @test_run.questions.empty? %>
    <%= empty_state(title: t(".no_questions"), icon: "quiz") %>
  <% elsif welcome %>
    <%= form_with url: mitmachbox_test_run_adm_projekts_phase_path(@projekt_phase),
          method: :get,
          data: { turbo_action: "replace",
                  controller: "adm--mitmachbox-box",
                  "adm--mitmachbox-box-fonts-url-value" => fonts_url,
                  "adm--mitmachbox-box-screen-value" => "welcome" } do %>
      <%= hidden_field_tag "version", @test_run_version, id: nil %>
      <%= hidden_field_tag "started", 1, id: nil %>
      <p class="kern-sr-only"><%= t(".welcome", start: start_label) %></p>

      <%= render layout: "adm/projekts/phases/mitmachbox_test_run/box" do %>
        <% key_count.times do |index| %>
          <span class="adm-mitmachbox-box__key adm-mitmachbox-box__key--<%= index + 1 %>" aria-hidden="true"></span>
        <% end %>

        <button type="submit"
                class="adm-mitmachbox-box__key adm-mitmachbox-box__key--6"
                title="<%= start_label %>">
          <span class="kern-sr-only"><%= start_label %></span>
        </button>
      <% end %>
    <% end %>
  <% elsif @test_run.finished? %>
    <%= tag.div class: "mb-4",
          data: { controller: "adm--mitmachbox-box",
                  "adm--mitmachbox-box-fonts-url-value" => fonts_url,
                  "adm--mitmachbox-box-screen-value" => "thanks" } do %>
      <h4 class="kern-sr-only" tabindex="-1"<% if stepped %> autofocus<% end %>><%= t(".finished") %></h4>

      <%= render layout: "adm/projekts/phases/mitmachbox_test_run/box" do %>
        <% (1..6).each do |number| %>
          <span class="adm-mitmachbox-box__key adm-mitmachbox-box__key--<%= number %>" aria-hidden="true"></span>
        <% end %>
      <% end %>
    <% end %>

    <%= kern_link_button mitmachbox_test_run_adm_projekts_phase_path(@projekt_phase, version: @test_run_version),
          text: t(".restart"),
          icon: "restart_alt",
          data: { turbo_action: "replace" } %>
  <% else %>
    <% question = @test_run.current_question %>
    <% options = (question["options"] || []).sort_by { |option| option["position"].to_i }.first(key_count) %>
    <% multiple = question["question_type"] == "multiple_choice" %>
    <% field_name = "answers[#{question["id"]}][]" %>
    <% chosen_option_ids = Array(@test_run.answers[question["id"]]) %>
    <% missing = @test_run.missing_required_answer? %>
    <% box_options = options.map { |option| { label: option["label"].to_s } } %>
    <% box_question = { prompt: question["prompt"].to_s, multiple: multiple, options: box_options } %>
    <% step_text = if @test_run.total
                     t(".step", current: @test_run.step, total: @test_run.total)
                   else
                     t(".step_open", current: @test_run.step)
                   end %>

    <%= form_with url: mitmachbox_test_run_adm_projekts_phase_path(@projekt_phase),
          method: :get,
          data: { turbo_action: "replace",
                  controller: "adm--mitmachbox-box",
                  action: "change->adm--mitmachbox-box#select " \
                          "focusin->adm--mitmachbox-box#focus focusout->adm--mitmachbox-box#focus",
                  "adm--mitmachbox-box-fonts-url-value" => fonts_url,
                  "adm--mitmachbox-box-screen-value" => "question",
                  "adm--mitmachbox-box-question-value" => box_question.to_json,
                  "adm--mitmachbox-box-step-value" => @test_run.step,
                  "adm--mitmachbox-box-total-value" => @test_run.total.to_i,
                  "adm--mitmachbox-box-missing-value" => missing } do %>
      <%= hidden_field_tag "version", @test_run_version, id: nil %>
      <%= hidden_field_tag "answered", question["id"], id: nil %>
      <% @test_run.previous_answers.each do |question_id, option_ids| %>
        <% option_ids.each do |option_id| %>
          <%= hidden_field_tag "answers[#{question_id}][]", option_id, id: nil %>
        <% end %>
      <% end %>

      <fieldset class="kern-sr-only" aria-describedby="mitmachbox-test-run-step">
        <legend><%= question["prompt"] %></legend>
        <% options.each_with_index do |option, index| %>
          <% input_options = { id: "mitmachbox-test-run-option-#{option["id"]}",
                               data: { "adm--mitmachbox-box-target" => "input" },
                               autofocus: (stepped || started) && index.zero? } %>
          <% if multiple %>
            <%= check_box_tag field_name, option["id"], chosen_option_ids.include?(option["id"]), input_options %>
          <% else %>
            <%= radio_button_tag field_name, option["id"], chosen_option_ids.include?(option["id"]), input_options %>
          <% end %>
          <label for="mitmachbox-test-run-option-<%= option["id"] %>"><%= index + 1 %>: <%= option["label"] %></label>
        <% end %>
        <p id="mitmachbox-test-run-step"><%= step_text %></p>
      </fieldset>

      <p class="kern-sr-only" role="alert"><%= t(".required") if missing %></p>

      <%= render layout: "adm/projekts/phases/mitmachbox_test_run/box" do %>
        <% key_count.times do |index| %>
          <% option = options[index] %>
          <% if option %>
            <label class="adm-mitmachbox-box__key adm-mitmachbox-box__key--<%= index + 1 %>"
                   for="mitmachbox-test-run-option-<%= option["id"] %>"
                   aria-hidden="true"
                   data-adm--mitmachbox-box-target="key"></label>
          <% else %>
            <span class="adm-mitmachbox-box__key adm-mitmachbox-box__key--<%= index + 1 %>" aria-hidden="true"></span>
          <% end %>
        <% end %>

        <button type="submit"
                class="adm-mitmachbox-box__key adm-mitmachbox-box__key--6"
                title="<%= next_label %>">
          <span class="kern-sr-only"><%= next_label %></span>
        </button>
      <% end %>
    <% end %>
  <% end %>
</div>
