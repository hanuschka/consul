<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <% if @audits.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.id") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.changes") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.created_at") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @audits.each do |audit| %>
            <tr class="kern-table__row">
              <td class="kern-table__cell"><%= audit.id %></td>
              <td class="kern-table__cell"><%= audit.audited_changes.compact %></td>
              <td class="kern-table__cell"><%= l audit.created_at, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_audits_title"), description: t(".no_audits_description"), icon: "history") %>
  <% end %>
</div>
