<% officing_managers = local_assigns[:officing_managers] || OfficingManager.all %>
<%= turbo_frame_tag "officing_managers__managers" do %>
  <%= form_with model: projekt_phase, url: adm_projekts_phase_path(projekt_phase), method: :patch do |f| %>
    <div class="kern-row mb-4">
      <%= f.collection_check_boxes :officing_manager_ids, officing_managers, :id, :name do |b| %>
        <div class="kern-col-12 kern-col-md-6 mb-2">
          <div class="kern-form-check">
            <%= b.check_box class: "kern-form-check__checkbox" %>
            <%= b.label class: "kern-label" %>
          </div>
        </div>
      <% end %>
    </div>
    <%= form_submit_button %>
  <% end %>

  <% if flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove"><%= flash[:success] %></div>
  <% end %>
<% end %>
