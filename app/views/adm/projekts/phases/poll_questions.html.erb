<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-end gap-2 mb-4">
    <%= kern_link_button new_admin_question_path(poll_id: @poll.id),
          text: t(".create_question"), icon: "add", style: :secondary %>
    <%= kern_link_button new_admin_question_path(poll_id: @poll.id, bundle_question: true),
          text: t(".create_bundle_question"), icon: "add", style: :secondary %>
  </div>

  <% if @questions.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.type") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @questions.each do |question| %>
            <tr id="<%= dom_id(question) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header">
                <%= question.title %>
                <% if question.contextualize_by_poll_question_id.present? %>
                  <br>
                  <small><%= t(".table.contextualized_by") %> <%= question.contextualize_by_question.title %></small>
                <% end %>
              </th>
              <td class="kern-table__cell">
                <% if question.bundle_question? %>
                  <%= t(".table.bundle_question") %>
                <% else %>
                  <%= I18n.t("activerecord.attributes.votation_type/vote_type.#{question.votation_type.vote_type}") %>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t(".table.edit_answers"), url: admin_question_path(question)) %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_admin_question_path(question)) %>
                  <% actions.with_action(label: t("shared.delete"), url: admin_question_path(question), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="kern-alert kern-alert--info" role="alert">
      <%= t(".no_questions") %>
    </div>
  <% end %>
</div>
