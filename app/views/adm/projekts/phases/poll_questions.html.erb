<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro_text_p1") %></p>
    <dl class="kern-description-list kern-description-list--col mt-3">
      <div class="kern-description-list-item">
        <dt class="kern-description-list-item__key"><%= t(".intro_question_types.normal.title") %></dt>
        <dd class="kern-description-list-item__value"><%= t(".intro_question_types.normal.description") %></dd>
      </div>
      <div class="kern-description-list-item">
        <dt class="kern-description-list-item__key"><%= t(".intro_question_types.bundle.title") %></dt>
        <dd class="kern-description-list-item__value"><%= t(".intro_question_types.bundle.description") %></dd>
      </div>
    </dl>
  <% end %>
<% end %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <%= render "adm/projekts/phases/test_mode_banner", poll: @poll %>

  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_poll_question_path(@projekt_phase),
          text: t(".create_question"), icon: "add", style: :secondary %>
    <%= kern_link_button new_adm_projekts_phase_poll_question_path(@projekt_phase, bundle_question: true),
          text: t(".create_bundle_question"), icon: "add", style: :secondary %>

    <% if @poll.present? && Ai::Settings.ai_available? %>
      <%= render Shared::AiFeatureTooltipComponent.new(
            feature_title: t("adm.projekts.poll_question_imports.index.title"),
            feature_text: t("adm.ai_action_button.feature_description"),
            requires_ai: false
          ) do %>
        <%= kern_link_button adm_projekts_phase_poll_question_imports_path(@projekt_phase),
              text: t("adm.projekts.poll_question_imports.trigger.button"),
              icon: "auto_awesome",
              style: :secondary %>
      <% end %>
    <% end %>

    <% if @poll.present? && !@poll.live? %>
      <%= form_with url: go_live_adm_projekts_phase_path(@projekt_phase), method: :patch,
            data: { turbo_confirm: t(".test_mode.go_live_confirm") } do %>
        <%= kern_button type: :submit, text: t(".test_mode.go_live"), icon: "rocket_launch", style: :primary %>
      <% end %>
    <% end %>
  </div>

  <% if @questions.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"></th>
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.type") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body"
               data-controller="sortable"
               data-sortable-url-value="<%= order_questions_adm_projekts_phase_poll_questions_path(@projekt_phase) %>">
          <% @questions.each do |question| %>
            <tr id="<%= dom_id(question) %>" class="kern-table__row" data-sortable-id="<%= question.id %>">
              <td class="kern-table__cell" data-sortable-handle style="cursor: grab;">
                <span class="material-symbols-outlined">drag_indicator</span>
              </td>
              <th scope="row" class="kern-table__header">
                <%= question.title %>
                <% if question.contextualize_by_question.present? %>
                  <br>
                  <small><%= t(".table.contextualized_by") %> <%= question.contextualize_by_question.title %></small>
                <% end %>
                <% if question.randomize_position? %>
                  <br>
                  <small><%= t(".table.randomized_position") %></small>
                <% end %>
              </th>
              <td class="kern-table__cell">
                <% if question.bundle_question? %>
                  <%= t(".table.bundle_question") %>
                <% else %>
                  <%= I18n.t("activerecord.attributes.votation_type/vote_type.#{question.votation_type.vote_type}") %>
                <% end %>
              </td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: question.bundle_question? ? t(".table.edit_questions") : t(".table.edit_answers"), url: adm_projekts_phase_poll_question_path(@projekt_phase, question), icon: "list") %>
                  <% actions.with_action(label: question.bundle_question? ? t(".table.edit_bundle_question") : t(".table.edit_question"), url: edit_adm_projekts_phase_poll_question_path(@projekt_phase, question), icon: "edit", style: :edit, divider: true) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_poll_question_path(@projekt_phase, question), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_questions_title"), description: t(".no_questions_description"), icon: "ballot") %>
  <% end %>
</div>
