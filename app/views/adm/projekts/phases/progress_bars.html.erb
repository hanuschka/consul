<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_progress_bar_path(@projekt_phase), text: t(".create_button") %>
  </div>

  <% if @progress_bars.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.kind") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.percentage") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @progress_bars.each do |progress_bar| %>
            <tr id="<%= dom_id(progress_bar) %>" class="kern-table__row">
              <td class="kern-table__cell"><%= progress_bar.title %></td>
              <td class="kern-table__cell"><%= t(".table.#{progress_bar.kind}") %></td>
              <td class="kern-table__cell"><%= progress_bar.percentage %>%</td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_progress_bar_path(@projekt_phase, progress_bar)) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_progress_bar_path(@projekt_phase, progress_bar), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t(".no_progress_bars") %></p>
  <% end %>
</div>
