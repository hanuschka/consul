<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <%= render "adm/shared/progress_bars_table",
        progress_bars: @progress_bars,
        new_url: new_adm_projekts_phase_progress_bar_path(@projekt_phase),
        edit_url: ->(pb) { edit_adm_projekts_phase_progress_bar_path(@projekt_phase, pb) },
        delete_url: ->(pb) { adm_projekts_phase_progress_bar_path(@projekt_phase, pb) } %>
</div>
