<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_projekt_event_path(@projekt_phase), text: t(".create_button"), style: :secondary %>
  </div>

  <% if @projekt_events.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.location") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.datetime") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @projekt_events.each do |event| %>
            <tr id="<%= dom_id(event) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= event.title %></th>
              <td class="kern-table__cell"><%= event.location %></td>
              <td class="kern-table__cell">
                <%= event.datetime.strftime("%d.%m.%Y %H:%M") %>
                <% if event.end_datetime.present? %>
                  — <%= event.end_datetime.strftime("%d.%m.%Y %H:%M") %>
                <% elsif event.open_ended? %>
                  (<%= t(".table.open_ended") %>)
                <% end %>
              </td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_projekt_event_path(@projekt_phase, event), icon: "edit", style: :edit) %>
                  <% actions.with_action(label: t(".table.send_notifications"), url: send_notifications_adm_projekts_phase_projekt_event_path(@projekt_phase, event), icon: "send", data: { turbo_method: :post, turbo_confirm: t(".table.send_notifications_confirm") }) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_projekt_event_path(@projekt_phase, event), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_events_title"), description: t(".no_events_description"), icon: "event") %>
  <% end %>
</div>
