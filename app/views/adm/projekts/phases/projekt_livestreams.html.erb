<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_projekt_livestream_path(@projekt_phase), text: t(".create_button") %>
  </div>

  <% if @projekt_livestreams.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.url") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.platform") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.starts_at") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @projekt_livestreams.each do |livestream| %>
            <tr id="<%= dom_id(livestream) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= link_to truncate(livestream.title, length: 50), adm_projekts_phase_projekt_livestream_path(@projekt_phase, livestream) %></th>
              <td class="kern-table__cell"><%= link_to truncate(livestream.url, length: 30), livestream.url, target: "_blank" %></td>
              <td class="kern-table__cell"><%= livestream.platform_formated %></td>
              <td class="kern-table__cell"><%= livestream.starts_at&.strftime("%d.%m.%Y %H:%M") %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t(".table.show"), url: adm_projekts_phase_projekt_livestream_path(@projekt_phase, livestream)) %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_projekt_livestream_path(@projekt_phase, livestream)) %>
                  <% actions.with_action(label: t(".table.send_notifications"), url: send_notifications_adm_projekts_phase_projekt_livestream_path(@projekt_phase, livestream), data: { turbo_method: :post, turbo_confirm: t(".table.send_notifications_confirm") }) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_projekt_livestream_path(@projekt_phase, livestream), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t(".no_livestreams") %></p>
  <% end %>
</div>
