<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_projekt_notification_path(@projekt_phase), text: t(".create_button"), style: :primary %>
  </div>

  <% if @projekt_notifications.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.body") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.created_at") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @projekt_notifications.each do |notification| %>
            <tr id="<%= dom_id(notification) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= notification.title %></th>
              <td class="kern-table__cell"><%= truncate(notification.body, length: 80) %></td>
              <td class="kern-table__cell"><%= l(notification.created_at.to_date) %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_projekt_notification_path(@projekt_phase, notification)) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_projekt_notification_path(@projekt_phase, notification), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t(".no_notifications") %></p>
  <% end %>
</div>
