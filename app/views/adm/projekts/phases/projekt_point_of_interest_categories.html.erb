<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container my-5">
  <% if @masterportal_collections.any? %>
    <custom-tabs param="taxonomy_tab" default="categories">
      <div class="custom-tabs--list" role="tablist">
        <custom-tab for="categories" class="-active"><%= t(".tabs.categories") %></custom-tab>
        <custom-tab for="collections"><%= t(".tabs.collections") %></custom-tab>
      </div>

      <custom-tab-panel for="categories" class="mt-4">
        <%= render "adm/projekts/phases/projekt_point_of_interest_categories_list" %>
      </custom-tab-panel>

      <custom-tab-panel for="collections" class="mt-4">
        <%= render Adm::MasterportalCollectionsTaxonomyComponent.new(
          projekt_phase: @projekt_phase,
          collections: @masterportal_collections
        ) %>
      </custom-tab-panel>
    </custom-tabs>
  <% else %>
    <%= render "adm/projekts/phases/projekt_point_of_interest_categories_list" %>
  <% end %>
</div>
