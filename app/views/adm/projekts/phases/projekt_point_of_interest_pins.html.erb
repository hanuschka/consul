<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <% if @pins.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.id") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.address") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.author") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.category") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.created_at") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @pins.each do |pin| %>
            <tr id="<%= dom_id(pin) %>" class="kern-table__row">
              <td class="kern-table__cell"><%= pin.id %></td>
              <td class="kern-table__cell"><%= pin.map_location&.approximated_address %></td>
              <td class="kern-table__cell"><%= pin.author.username %></td>
              <td class="kern-table__cell"><%= pin.projekt_point_of_interest_category&.name %></td>
              <td class="kern-table__cell"><%= l pin.created_at, format: :short %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy && @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_pins_title"), description: t(".no_pins_description"), icon: "location_on") %>
  <% end %>
</div>
