<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <%= new_resource_link(new_adm_projekts_phase_projekt_question_path(@projekt_phase), t(".create_button")) %>

  <% if @projekt_questions.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.question_options") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.comments_count") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @projekt_questions.each do |question| %>
            <tr id="<%= dom_id(question) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= question.title %></th>
              <td class="kern-table__cell">
                <ul>
                  <% question.question_options.each do |question_option| %>
                    <li><%= "#{question_option.value} (#{question_option.answers_count})" %></li>
                  <% end %>
                </ul>
              </td>
              <td class="kern-table__cell"><%= question.comments.count %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_projekt_question_path(@projekt_phase, question)) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_projekt_question_path(@projekt_phase, question), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy && @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="kern-alert kern-alert--info" role="alert">
      <%= t(".no_questions") %>
    </div>
  <% end %>
</div>
