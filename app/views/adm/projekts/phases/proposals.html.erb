<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<%
  headers = {
    title:             Kern::Table::HeaderComponent.new(:title, t(".table.title"), **@title_header_options.merge(data_field: "title")),
    moderation_status: Kern::Table::HeaderComponent.new(:moderation_status, t(".table.moderation"), **@moderation_header_options.merge(data_field: "moderation_status"))
  }
%>

<div class="kern-container mb-5">
  <%= render Adm::IndexTableComponent.new(
        turbo_frame_id: "proposals_table",
        records: @proposals,
        pagy: @pagy,
        headers: headers,
        column_count: 6 + (@projekt_phase.feature?("general.require_admin_acceptance") ? 1 : 0),
        column_selector: {
          storage_key: "adm-proposals-columns",
          defaults: "id,image,admin_accepted,title,moderation_status,author"
        },
        empty_state: {
          title: t(".no_proposals_title"),
          description: t(".no_proposals_description"),
          icon: "lightbulb"
        },
        empty_state_filtered: {
          title: t(".no_results_filtered_title"),
          description: t(".no_results_filtered_description"),
          icon: "filter_alt_off"
        }
      ) do |c| %>
    <% c.with_toolbar_meta do %>
      <span class="adm-table-count" title="<%= t(".total_hint") %>">
        <span class="adm-table-count__value"><%= number_with_delimiter(@pagy.count) %></span>
        <span class="adm-table-count__label"><%= t(".total_label", count: @pagy.count) %></span>
      </span>
    <% end %>

    <% c.with_toolbar_action do %>
      <a href="<%= proposals_adm_projekts_phase_path(@projekt_phase, format: :csv, **request.query_parameters) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        <%= t(".download_csv") %>
      </a>
    <% end %>

    <% c.with_toolbar_action do %>
      <a href="<%= proposals_adm_projekts_phase_path(@projekt_phase, format: :geojson, **request.query_parameters) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">map</span>
        <%= t(".download_geojson") %>
      </a>
    <% end %>

    <% c.with_header_row do %>
      <th scope="col" class="kern-table__header" data-field="id"><%= t(".table.id") %></th>
      <th scope="col" class="kern-table__header" data-field="image"><%= t(".table.image") %></th>
      <% if @projekt_phase.feature?("general.require_admin_acceptance") %>
        <th scope="col" class="kern-table__header" data-field="admin_accepted"><%= t(".table.admin_accepted") %></th>
      <% end %>
      <%= render headers[:title] %>
      <%= render headers[:moderation_status] %>
      <th scope="col" class="kern-table__header" data-field="author"><%= t(".table.author") %></th>
      <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
    <% end %>

    <% c.with_body do %>
      <% @proposals.each do |proposal| %>
        <%= render "adm/projekts/phases/proposals/proposal", proposal: proposal, projekt_phase: @projekt_phase,
              similar_contributions_counts: @similar_contributions_counts %>
      <% end %>
    <% end %>
  <% end %>
</div>
