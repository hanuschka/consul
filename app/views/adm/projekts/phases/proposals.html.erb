<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container mb-5">
  <% if @proposals.any? %>
    <div data-controller="adm-column-selector"
         data-adm-column-selector-storage-key-value="adm-proposals-columns"
         data-adm-column-selector-defaults-value="id,admin_accepted,title,moderation_status,author"
         data-action="click@window->adm-column-selector#close">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="adm-column-selector">
          <button type="button" class="adm-column-selector__toggle" data-action="adm-column-selector#toggle">
            <span class="material-symbols-outlined" aria-hidden="true">view_column</span>
            <%= t(".columns") %>
          </button>
          <div class="adm-column-selector__menu" data-adm-column-selector-target="menu">
            <div data-adm-column-selector-target="list"></div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-3">
          <a href="<%= proposals_adm_projekts_phase_path(@projekt_phase, format: :csv, **request.query_parameters) %>" class="adm-text-link" data-turbo="false">
            <span class="material-symbols-outlined" aria-hidden="true">download</span>
            <%= t(".download_csv") %>
          </a>
          <a href="<%= proposals_adm_projekts_phase_path(@projekt_phase, format: :geojson, **request.query_parameters) %>" class="adm-text-link" data-turbo="false">
            <span class="material-symbols-outlined" aria-hidden="true">map</span>
            <%= t(".download_geojson") %>
          </a>
        </div>
      </div>

      <div class="kern-table-responsive" tabindex="0">
        <table class="kern-table" data-adm-column-selector-target="table">
          <thead class="kern-table__head">
            <tr class="kern-table__row">
              <th scope="col" class="kern-table__header" data-field="id"><%= t(".table.id") %></th>
              <% if @projekt_phase.feature?("general.require_admin_acceptance") %>
                <th scope="col" class="kern-table__header" data-field="admin_accepted"><%= t(".table.admin_accepted") %></th>
              <% end %>
              <th scope="col" class="kern-table__header" data-field="title"><%= t(".table.title") %></th>
              <%= render Kern::Table::HeaderComponent.new(:moderation_status, t(".table.moderation"), **@moderation_header_options.merge(data_field: "moderation_status")) %>
              <th scope="col" class="kern-table__header" data-field="author"><%= t(".table.author") %></th>
              <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
            </tr>
          </thead>

          <tbody class="kern-table__body">
            <% @proposals.each do |proposal| %>
              <%= render "adm/projekts/phases/proposals/proposal", proposal: proposal, projekt_phase: @projekt_phase %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="my-5">
        <%== pagy_nav(@pagy) if @pagy && @pagy.pages > 1 %>
      </div>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_proposals_title"), description: t(".no_proposals_description"), icon: "lightbulb") %>
  <% end %>
</div>
