<tr id="<%= dom_id(proposal) %>" class="kern-table__row">
  <td class="kern-table__cell"><%= proposal.id %></td>
  <% if projekt_phase.feature?("general.require_admin_acceptance") %>
    <td class="kern-table__cell">
      <%= render Adm::AttributeEditors::BooleanComponent.new(
        proposal,
        :admin_accepted,
        path: toggle_admin_accepted_adm_projekts_phase_proposal_path(projekt_phase, proposal)
      ) %>
    </td>
  <% end %>
  <th scope="row" class="kern-table__header"><%= proposal.title %></th>
  <td class="kern-table__cell"><%= moderation_status(proposal) %></td>
  <td class="kern-table__cell"><%= proposal.author.username %></td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t("adm.projekts.phases.proposals.table.view"), url: adm_projekts_phase_proposal_path(projekt_phase, proposal)) %>
      <% if policy([:adm, proposal]).unhide? %>
        <% actions.with_action(label: t("adm.projekts.phases.proposals.table.unhide"),
                               url: unhide_adm_projekts_phase_proposal_path(projekt_phase, proposal),
                               data: { turbo_method: :put }) %>
      <% elsif policy([:adm, proposal]).hide? %>
        <% if proposal.flags_count > 0 && !proposal.ignored_flag? %>
          <% actions.with_action(label: t("adm.projekts.phases.proposals.table.ignore_flag"),
                                 url: ignore_flag_adm_projekts_phase_proposal_path(projekt_phase, proposal),
                                 data: { turbo_method: :put }) %>
        <% end %>
        <% actions.with_action(label: t("adm.projekts.phases.proposals.table.hide"),
                               url: hide_adm_projekts_phase_proposal_path(projekt_phase, proposal),
                               data: { turbo_method: :put, turbo_confirm: t("adm.projekts.phases.proposals.table.confirm_hide", name: proposal.title) }) %>
      <% end %>
    <% end %>
  </td>
</tr>
