<%= content_for :title,
  [@projekt_phase.title, t("adm.projekts.phases.whatsapp.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container my-5">
  <% if @whatsapp_submissions_setting %>
    <%= render Adm::AttributeEditorComponent.new(
      @whatsapp_submissions_setting,
      :value,
      :boolean
    ) %>
  <% end %>

  <%= render Adm::WhatsappQrCodeComponent.new(
    title: t("adm.projekts.phases.whatsapp.qr_title"),
    subline: t("adm.projekts.phases.whatsapp.qr_subline"),
    token: @phase_token
  ) %>

  <% if !@projekt_phase.whatsapp_submissions_enabled? %>
    <div class="mt-5">
      <%= kern_alert(
        title: t("adm.projekts.phases.whatsapp.submissions_disabled_title"),
        style: :warning
      ) do %>
        <p class="kern-body">
          <%= t("adm.projekts.phases.whatsapp.submissions_disabled_body") %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
