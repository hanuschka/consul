<%= content_for :title, [@projekt_phase.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_phase.title, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase)) %>

<div class="kern-container my-5">
  <%= render Adm::WhatsappQrCodeComponent.new(
    title: t(".qr_title"),
    subline: t(".qr_subline"),
    token: @phase_token
  ) %>

  <% if !@ai_flow_enabled %>
    <div class="mt-5">
      <%= kern_alert(title: t(".ai_flow_disabled_title"), style: :warning) do %>
        <p class="kern-body">
          <%= t(".ai_flow_disabled_body") %>
          <%= link_to t(".ai_flow_disabled_link"),
            ai_user_flow_adm_projekts_phase_path(@projekt_phase),
            class: "kern-link" %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
