<%= form_with model: answer, url: url do |f| %>
  <%= f.hidden_field :question_id, value: @question.id %>

  <% if @question.can_accept_open_answer? %>
    <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
      label: Poll::Question::Answer.human_attribute_name(:open_answer)) do %>
      <%= f.check_box :open_answer %>
    <% end %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
    label: Poll::Question::Answer.human_attribute_name(:title)) do %>
    <%= f.text_field :title, label: false %>
  <% end %>

  <% if @question.allows_additional_info? %>
    <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
      label: Poll::Question::Answer.human_attribute_name(:description)) do %>
      <%= f.rich_text_area :description, label: false %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
      label: Poll::Question::Answer.human_attribute_name(:more_info_link)) do %>
      <%= f.text_field :more_info_link, label: false %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
      label: Poll::Question::Answer.human_attribute_name(:more_info_iframe)) do %>
      <%= f.text_field :more_info_iframe, label: false %>
    <% end %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
    label: t(".image_label")) do %>
    <%= render Kern::Form::GalleryableImagesComponent.new(form: f) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
    label: t(".documents_label")) do %>
    <%= render Kern::Form::DocumentsComponent.new(form: f) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
    label: t(".video_label")) do %>
    <%= f.fields_for :videos do |video_form| %>
      <div class="mb-3">
        <%= render Kern::FormFieldComponent.new(divider: false,
          label: Poll::Question::Answer::Video.human_attribute_name(:title)) do %>
          <%= video_form.text_field :title, label: false %>
        <% end %>
        <%= render Kern::FormFieldComponent.new(divider: false,
          label: Poll::Question::Answer::Video.human_attribute_name(:url)) do %>
          <%= video_form.text_field :url, label: false %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @question.poll.in_wizard_mode? && @question.votation_type.vote_type == "unique" && @question.parent_question.blank? %>
    <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
      label: Poll::Question::Answer.human_attribute_name(:next_question_id)) do %>
      <%= f.select :next_question_id,
            @question.sibling_questions,
            { include_blank: true },
            { class: "kern-select" } %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(divider: false, inline: true,
      label: Poll::Question::Answer.human_attribute_name(:terminates_poll)) do %>
      <%= f.check_box :terminates_poll %>
    <% end %>
  <% end %>

  <div class="d-flex gap-2 mb-4">
    <%= kern_button(text: t("shared.submit"), icon: "save", type: "submit") %>
    <%= kern_link_button(adm_projekts_phase_poll_question_path(@projekt_phase, @question),
          text: t("shared.cancel"), style: :secondary) %>
  </div>
<% end %>
