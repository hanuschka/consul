<%= content_for :title, @title %>

<%= render Adm::HeaderComponent.new(title: @title, breadcrumbs: @breadcrumbs, back_button_url: poll_questions_adm_projekts_phase_path(@projekt_phase), narrow: true) do |header| %>
  <% header.with_hint do %>
    <% if params[:bundle_question] == "true" %>
      <p class="adm-hint__text"><%= t("adm.projekts.phases.poll_questions.bundle_intro_text_p1") %></p>
      <p class="adm-hint__text adm-hint__text--spaced"><%= t("adm.projekts.phases.poll_questions.bundle_intro_text_p2") %></p>
    <% else %>
      <p class="adm-hint__text"><%= t("adm.projekts.phases.poll_questions.intro_text_p1") %></p>

      <h3 class="kern-title kern-title--x-small mt-4 mb-2"><%= t("adm.projekts.phases.poll_questions.intro_vote_types_title") %></h3>
      <dl class="kern-description-list kern-description-list--col">
        <% %w[unique multiple multiple_with_weight rating_scale].each do |vt| %>
          <div class="kern-description-list-item">
            <dt class="kern-description-list-item__key"><%= t("adm.projekts.phases.poll_questions.intro_vote_types.#{vt}.title") %></dt>
            <dd class="kern-description-list-item__value"><%= t("adm.projekts.phases.poll_questions.intro_vote_types.#{vt}.description") %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  <% end %>
<% end %>

<div class="kern-container mb-5">
  <%= render "form", question: @question, url: adm_projekts_phase_poll_questions_path(@projekt_phase) %>
</div>
