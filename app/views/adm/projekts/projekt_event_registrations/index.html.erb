<%= content_for :title, [@projekt_event.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt_event.title, breadcrumbs: @breadcrumbs, back_button_url: projekt_events_adm_projekts_phase_path(@projekt_phase)) %>

<%= render Adm::TabsComponent.new(tabs: projekt_event_tabs(@projekt_phase, @projekt_event)) %>

<div class="kern-container mb-5">
  <%
    headers = {
      status: Kern::Table::HeaderComponent.new(:status, t(".columns.status"), **@status_header_options.merge(data_field: "status"))
    }
  %>

  <%= render Adm::IndexTableComponent.new(
        turbo_frame_id: "projekt_event_registrations_table",
        records: @registrations,
        pagy: @pagy,
        headers: headers,
        column_count: 6,
        empty_state: {
          title: t(".no_items_title"),
          description: t(".no_items_description"),
          icon: "how_to_reg"
        },
        empty_state_filtered: {
          title: t(".no_results_filtered_title"),
          description: t(".no_results_filtered_description"),
          icon: "filter_alt_off"
        }
      ) do |c| %>
    <% c.with_toolbar_meta do %>
      <span class="adm-table-count" title="<%= t(".total_hint") %>">
        <span class="adm-table-count__value"><%= number_with_delimiter(@pagy.count) %></span>
        <span class="adm-table-count__label"><%= t(".total_label", count: @pagy.count) %></span>
      </span>
    <% end %>

    <% c.with_toolbar_action do %>
      <a href="<%= url_for(request.query_parameters.merge(format: :csv)) %>" class="adm-text-link" data-turbo="false">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        <%= t(".download_csv") %>
      </a>
    <% end %>

    <% c.with_header_row do %>
      <th scope="col" class="kern-table__header" data-field="name"><%= t(".columns.name") %></th>
      <th scope="col" class="kern-table__header" data-field="email"><%= t(".columns.email") %></th>
      <%= render headers[:status] %>
      <th scope="col" class="kern-table__header" data-field="registered_at"><%= t(".columns.registered_at") %></th>
      <th scope="col" class="kern-table__header" data-field="confirmed_at"><%= t(".columns.confirmed_at") %></th>
      <th scope="col" class="kern-table__header" data-field="actions"><%= t(".columns.actions") %></th>
    <% end %>

    <% c.with_body do %>
      <% @registrations.each do |registration| %>
        <tr id="<%= dom_id(registration) %>" class="kern-table__row">
          <th scope="row" class="kern-table__header" data-field="name">
            <%= registration.display_name.strip.presence || registration.user&.username || "—" %>
          </th>
          <td class="kern-table__cell" data-field="email"><%= registration.email %></td>
          <td class="kern-table__cell" data-field="status">
            <%= t(".statuses.#{registration.status}", default: registration.status.to_s.humanize) %>
          </td>
          <td class="kern-table__cell" data-field="registered_at"><%= l(registration.created_at, format: :long) %></td>
          <td class="kern-table__cell" data-field="confirmed_at">
            <%= registration.confirmed_at.present? ? l(registration.confirmed_at, format: :long) : "—" %>
          </td>
          <td class="kern-table__cell" data-field="actions">
            <%= render Kern::Table::ActionsComponent.new do |actions| %>
              <% if registration.pending_confirmation? %>
                <% actions.with_action(
                     label: t(".actions.resend_confirmation"),
                     url: resend_confirmation_adm_projekts_phase_projekt_event_registration_path(
                       @projekt_phase, @projekt_event, registration, status: Array(params[:status]).presence),
                     icon: "send",
                     data: { turbo_method: :post, turbo_confirm: t(".resend_confirmation.confirm") }) %>
              <% end %>
              <% actions.with_action(
                   label: t(".actions.destroy"),
                   url: adm_projekts_phase_projekt_event_registration_path(
                     @projekt_phase, @projekt_event, registration, status: Array(params[:status]).presence),
                   icon: "delete",
                   style: :delete,
                   data: { turbo_method: :delete, turbo_confirm: t(".destroy.confirm") }) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
</div>
