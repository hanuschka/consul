<%= content_for :title, @projekt_livestream.title %>

<%= render Adm::HeaderComponent.new(title: @projekt_livestream.title, breadcrumbs: @breadcrumbs, back_button_url: projekt_livestreams_adm_projekts_phase_path(@projekt_phase)) %>

<div class="kern-container my-5">
  <% embed_src = VideoUtils.embed_url(@projekt_livestream.url) %>
  <% if embed_src.present? %>
    <div class="kern-row mb-4">
      <div class="kern-col-md-6">
        <div style="position: relative; padding-bottom: 56.25%; height: 0;">
          <iframe src="<%= embed_src %>" style="position: absolute; width: 100%; height: 100%; top: 0; left: 0;" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  <% end %>

  <div class="d-flex justify-content-start gap-2 mb-4">
    <%= kern_link_button new_adm_projekts_phase_projekt_question_path(@projekt_phase, projekt_livestream_id: @projekt_livestream.id), text: t(".add_question"), style: :primary %>
  </div>

  <% if @projekt_livestream.projekt_questions.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t(".table.question") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.options") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @projekt_livestream.projekt_questions.each do |question| %>
            <tr id="<%= dom_id(question) %>" class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= question.title %></th>
              <td class="kern-table__cell">
                <ul class="mb-0">
                  <% question.question_options.each do |option| %>
                    <li><%= option.value %> (<%= option.answers_count %>)</li>
                  <% end %>
                </ul>
              </td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t("shared.edit"), url: edit_adm_projekts_phase_projekt_question_path(@projekt_phase, question), icon: "edit", style: :edit) %>
                  <% actions.with_action(label: t("shared.delete"), url: adm_projekts_phase_projekt_question_path(@projekt_phase, question), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="kern-body"><%= t(".no_questions") %></p>
  <% end %>
</div>
