<%= content_for :title, [@projekt.name, t("adm.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt.name, breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <% if @projekt.projekt_manager_assignments.any? %>
    <% @projekt.projekt_manager_assignments.includes(projekt_manager: :user).each do |assignment| %>
      <%= render 'adm/projekts/projekt_managers/assignment', projekt: @projekt, assignment: assignment %>
    <% end %>
  <% else %>
    <p><%= t('.no_assignments') %></p>
  <% end %>
</div>
