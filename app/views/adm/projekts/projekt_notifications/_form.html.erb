<%= form_with model: @projekt_notification, url: url do |f| %>

  <%= render Kern::FormFieldComponent.new(label: t(".title_label")) do %>
    <%= f.text_field :title, label: false, required: true %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t(".body_label")) do %>
    <%= f.text_area :body, label: false, rows: 6 %>
  <% end %>

  <%= form_submit_button(text: t(".submit")) %>
<% end %>
