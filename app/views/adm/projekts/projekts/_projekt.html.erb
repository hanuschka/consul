<tr class="kern-table__row" id="<%= dom_id(projekt) %>">
  <th scope="row" class="kern-table__header">
    <div class="d-flex align-items-center gap-3">
      <%= projekt_thumbnail(projekt) %>
      <div>
        <%= link_to projekt.title, details_adm_projekts_projekt_path(projekt), class: "link strong" %>
        <br>
        <span class="small">
          <% if projekt.parent.present? %>
            >> <%= projekt.parent.title %>
          <% else %>
            <%= t(".top_level_projekt") %>
          <% end %>
        </span>
      </div>
    </div>
  </th>
  <td class="kern-table__cell"><%= projekt.total_duration_start %></td>
  <td class="kern-table__cell"><%= projekt.total_duration_end %></td>
  <td class="kern-table__cell">
    <%= render Adm::AttributeEditors::BooleanComponent.new(
      projekt,
      :activated?,
      path: toggle_activated_adm_projekts_projekt_path(projekt)
    ) %>
  </td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t(".details"), url: details_adm_projekts_projekt_path(projekt)) %>
      <% actions.with_action(label: t(".visibility"), url: visibility_adm_projekts_projekt_path(projekt)) %>
      <% actions.with_action(label: t(".projekt_managers"), url: projekt_managers_adm_projekts_projekt_path(projekt)) %>
      <% actions.with_action(label: t(".map"), url: map_adm_projekts_projekt_path(projekt)) %>
      <% actions.with_action(label: t(".projekt_phases"), url: phases_adm_projekts_projekt_path(projekt)) %>
      <% actions.with_action(
        label: t(".delete"),
        url: adm_projekts_projekt_path(projekt),
        data: { turbo_method: :delete, turbo_confirm: t(".delete_confirm") }
      ) %>
    <% end %>
  </td>
</tr>
