<%= content_for :title, [(@projekt.page&.title || @projekt.name), t("adm.projekts.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: (@projekt.page&.title || @projekt.name), breadcrumbs: @breadcrumbs, back_button_url: adm_projekts_root_path, frontend_url: projekt_path(@projekt), compact: true) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t("adm.projekts.projekts.details.hint_text") %></p>
  <% end %>

  <% if policy([:adm, :projekts, @projekt]).update? %>
    <% header.with_actions do %>
      <div class="ml-auto d-flex gap-2">
        <% if @projekt.copy_unfinished? %>
          <%# A stalled or failed copy renders as failed inside the partial. %>
          <%= render "adm/projekts/projekts/copy_status", projekt: @projekt %>
        <% else %>
          <rich-tooltip delay="550" body-class="-wide">
            <%= kern_link_button(
              copy_adm_projekts_projekt_path(@projekt),
              icon: "content_copy",
              text: t("adm.projekts.projekts.copy.action"),
              data: {
                turbo_method: :post,
                turbo_confirm: t("adm.projekts.projekts.copy.confirm"),
                turbo_frame: "_top",
                turbo_prefetch: false
              }
            ) %>
            <template>
              <span class="rich-tooltip-content">
                <span class="rich-tooltip-content--title"><%= t("adm.projekts.projekts.copy.tooltip.title") %></span>
                <span class="rich-tooltip-content--text"><%= t("adm.projekts.projekts.copy.tooltip.text") %></span>
                <span class="rich-tooltip-content--note">
                  <span class="rich-tooltip-content--note-label"><%= t("adm.projekts.projekts.copy.tooltip.note_label") %></span>
                  <%= t("adm.projekts.projekts.copy.tooltip.note") %>
                </span>
              </span>
            </template>
          </rich-tooltip>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container mb-5">
  <fieldset <%= "disabled" unless policy([:adm, :projekts, @projekt]).update? %> style="border:0; padding:0; margin:0;">
    <%= render Kern::FormFieldComponent.new(label: t('.activated_label'), hint: t('.activated_description')) do %>
      <div id="<%= dom_id(@projekt, :activated) %>">
        <%= render Adm::AttributeEditors::BooleanComponent.new(
          @projekt,
          :activated?,
          path: toggle_activated_adm_projekts_projekt_path(@projekt)
        ) %>
      </div>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t('.duration_label'), hint: t('.duration_description')) do %>
      <%= render 'adm/projekts/projekts/details/duration', projekt: @projekt %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t('.landing_pages_label'), hint: t('.landing_pages_description')) do %>
      <%= render 'adm/projekts/projekts/details/landing_pages', projekt: @projekt %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t('.parent_projekt_label'), hint: t('.parent_projekt_description')) do %>
      <%= render 'adm/projekts/projekts/details/parent_projekt', projekt: @projekt %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t('.geo_restriction_label'), hint: t('.geo_restriction_description')) do %>
      <%= render 'adm/projekts/projekts/details/geo_restriction', projekt: @projekt %>
    <% end %>

    <%= render Adm::AttributeEditorComponent.new(@projekt.projekt_settings.find_by!(key: "projekt_option.general.external_participation_link"), :value, :string) %>

    <% if @projekt.page.present? %>
      <%= render Adm::AttributeEditorComponent.new(@projekt.page, :slug, :string) %>
    <% end %>
  </fieldset>

  <% if ::Whatsapp.enabled? && policy([:adm, :projekts, @projekt]).update? %>
    <%= render Kern::FormFieldComponent.new(
      label: t("adm.projekts.projekts.whatsapp_broadcast.label"),
      hint: t("adm.projekts.projekts.whatsapp_broadcast.description")
    ) do %>
      <% if ::Whatsapp.broadcast_available? %>
        <%= kern_link_button(
          whatsapp_broadcast_adm_projekts_projekt_path(@projekt),
          text: t("adm.projekts.projekts.whatsapp_broadcast.send"),
          style: :secondary,
          data: {
            turbo_method: :post,
            turbo_confirm: t("adm.projekts.projekts.whatsapp_broadcast.confirm",
              count: @whatsapp_subscribed_count)
          }
        ) %>
      <% else %>
        <%= kern_alert(
          title: t("adm.projekts.projekts.whatsapp_broadcast.missing_template"),
          style: :warning
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
