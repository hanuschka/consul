<%= content_for :title, [(@projekt.page&.title || @projekt.name), t("adm.projekts.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: (@projekt.page&.title || @projekt.name), breadcrumbs: @breadcrumbs, back_button_url: adm_projekts_root_path, frontend_url: projekt_path(@projekt), compact: true) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t("adm.projekts.projekts.details.hint_text") %></p>
  <% end %>
<% end %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container mb-5">
  <fieldset <%= "disabled" unless policy([:adm, :projekts, @projekt]).update? %> style="border:0; padding:0; margin:0;">
    <%= render Kern::FormFieldComponent.new(label: t('.duration_label'), hint: t('.duration_description')) do %>
      <%= render 'adm/projekts/projekts/details/duration', projekt: @projekt %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t('.landing_pages_label'), hint: t('.landing_pages_description')) do %>
      <%= render 'adm/projekts/projekts/details/landing_pages', projekt: @projekt %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t('.geo_restriction_label'), hint: t('.geo_restriction_description')) do %>
      <%= render 'adm/projekts/projekts/details/geo_restriction', projekt: @projekt %>
    <% end %>

    <%= render Adm::AttributeEditorComponent.new(@projekt.projekt_settings.find_by!(key: "projekt_option.general.external_participation_link"), :value, :string) %>

    <% if @projekt.page.present? %>
      <%= render Adm::AttributeEditorComponent.new(@projekt.page, :slug, :string) %>
    <% end %>
  </fieldset>

  <% if Whatsapp.enabled? && policy([:adm, :projekts, @projekt]).update? %>
    <%= render Kern::FormFieldComponent.new(
      label: t("adm.projekts.projekts.whatsapp_broadcast.label"),
      hint: t("adm.projekts.projekts.whatsapp_broadcast.description")
    ) do %>
      <% subscribed_count = WhatsappAccount.subscribed.count %>

      <% if Whatsapp.broadcast_template_name.blank? %>
        <%= kern_alert(
          title: t("adm.projekts.projekts.whatsapp_broadcast.missing_template"),
          style: :warning
        ) %>
      <% else %>
        <%= kern_link_button(
          whatsapp_broadcast_adm_projekts_projekt_path(@projekt),
          text: t("adm.projekts.projekts.whatsapp_broadcast.send"),
          style: :secondary,
          data: {
            turbo_method: :post,
            turbo_confirm: t("adm.projekts.projekts.whatsapp_broadcast.confirm", count: subscribed_count)
          }
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
