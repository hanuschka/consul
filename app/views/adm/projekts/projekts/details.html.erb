<%= content_for :title, [@projekt.name, t("adm.projekts.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt.name, breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: projekt_tabs(@projekt)) %>

<div class="kern-container mb-5">
  <%= render Adm::AttributeEditorComponent.new(@projekt.page, :title, :string) %>

  <%= render Kern::FormFieldComponent.new(label: t('.duration_label'), hint: t('.duration_description')) do %>
    <%= render 'adm/projekts/projekts/details/duration', projekt: @projekt %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t('.landing_pages_label'), hint: t('.landing_pages_description')) do %>
    <%= render 'adm/projekts/projekts/details/landing_pages', projekt: @projekt %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: t('.geo_restriction_label'), hint: t('.geo_restriction_description')) do %>
    <%= render 'adm/projekts/projekts/details/geo_restriction', projekt: @projekt %>
  <% end %>

  <%= render Adm::AttributeEditorComponent.new(@projekt.page, :slug, :string) %>
</div>
