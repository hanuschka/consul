<%= turbo_frame_tag "details__geo_restriction" do %>
  <%= form_with model: projekt, url: adm_projekts_projekt_path(projekt) do |f| %>
    <div class="kern-fieldset__body mb-4" data-controller="related-content">
      <% geozone_options = [["no_affiliation", t(".geozone_affiliated_no_affiliation")],
                            ["entire_city", t(".geozone_affiliated_entire_city")],
                            ["only_geozones", t(".geozone_affiliated_only_geozones")]] %>
      <%= f.collection_radio_buttons(:geozone_affiliated, geozone_options, :first, :last) do |b| %>
        <div class="kern-form-check">
          <%= b.radio_button(class: "kern-form-check__radio", data: { action: "related-content#toggle", related_content_target: b.value == "only_geozones" ? "trigger" : nil }) %>
          <%= b.label(class: "kern-label") %>
        </div>
      <% end %>
      <div class="options-group mt-3 pl-3" data-related-content-target="content">
        <strong class="mb-2 d-block"><%= t(".geozones_label") %></strong>
        <% if Geozone.any? %>
          <%= f.collection_check_boxes(:geozone_affiliation_ids, Geozone.all, :id, :name) %>
        <% else %>
          <p class="text-muted"><%= t(".geozones_empty") %></p>
        <% end %>

        <strong class="mt-3 mb-2 d-block"><%= t(".districts_label") %></strong>
        <% if RegisteredAddress::District.any? %>
          <%= f.collection_check_boxes(:registered_address_district_affiliation_ids, RegisteredAddress::District.all, :id, :name) %>
        <% else %>
          <p class="text-muted"><%= t(".districts_empty") %></p>
        <% end %>
      </div>
    </div>
    <%= form_submit_button %>
  <% end %>

  <% if flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove"><%= flash[:success] %></div>
  <% end %>
<% end %>
