<%= turbo_frame_tag "details__landing_pages" do %>
  <%= form_with model: projekt, url: adm_projekts_projekt_path(projekt) do |f| %>
    <div class="mb-4">
      <%= f.select(
        :landing_page_id,
        SiteCustomization::Page.landing.map { |p| [p.title, p.id] },
        { include_blank: t("custom.admin.projekts.edit.no_landing_page"), label: false }
      ) %>
    </div>
    <%= form_submit_button %>
  <% end %>

  <% if flash[:success].present? %>
    <div class="input-success-message mt-2" data-controller="auto-remove"><%= flash[:success] %></div>
  <% end %>
<% end %>
