<%= javascript_include_tag "lib/files/filter_serializer" %>

<span hidden data-files-delete-failed-message="<%= t("files.delete_failed") %>"></span>

<%= content_for :title, [@projekt.page.title, t("adm.menu.items.files_subitems.documents")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: @projekt.page.title, breadcrumbs: @breadcrumbs, frontend_url: projekt_path(@projekt)) %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container my-5">
  <div
    class="files-page-actions mb-3"
    data-controller="files--upload"
    data-files--upload-endpoint-value="/file_manager/documents?projekt_id=<%= @projekt.id %>"
  >
    <button
      type="button"
      class="files-page-actions--upload-button"
      data-action="click->files--upload#triggerPicker"
    >
      <i class="fa fa-upload"></i>
      <%= t("files.card.upload") %>
    </button>
    <input
      type="file"
      class="js-files-upload-input"
      data-files--upload-target="input"
      data-action="change->files--upload#fileChanged"
      hidden
    >
    <span hidden data-files-upload-failed-message="<%= t("files.upload_failed") %>"></span>
  </div>

  <%= render Files::IndexComponent.new(
    type: "document",
    assets: @assets,
    endpoint: documents_adm_projekts_projekt_path(@projekt),
    card_component: Files::DocumentCardComponent,
    row_component: Files::DocumentRowComponent
  ) %>
</div>
