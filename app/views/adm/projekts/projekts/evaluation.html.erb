<%= content_for :title, [(@projekt.page&.title || @projekt.name), t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(
  title: t("adm.projekts.projekts.evaluation.overview.title"),
  breadcrumbs: @breadcrumbs,
  frontend_url: projekt_path(@projekt),
  compact: true
) %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container mb-5">
  <% if @evaluation.blank? || @evaluation.pending? %>
    <div class="adm-empty-state">
      <h3><%= t(".not_generated_title") %></h3>
      <p><%= t(".not_generated_description") %></p>

      <%= render Adm::AiActionButtonComponent.new(
        url: generate_evaluation_adm_projekts_projekt_path(@projekt),
        text: t(".generate_button"),
        icon: "auto_awesome",
        style: :primary,
        processing_text: t(".processing_title")
      ) %>
    </div>

  <% elsif @evaluation.processing? %>
    <div class="adm-empty-state">
      <%= render Adm::AiActionButtonComponent.new(
        url: generate_evaluation_adm_projekts_projekt_path(@projekt),
        text: t(".generate_button"),
        icon: "auto_awesome",
        style: :primary,
        processing_text: t(".processing_title"),
        status_url: evaluation_status_adm_projekts_projekt_path(@projekt),
        loading: true
      ) %>

      <p class="adm-evaluation-processing-note"><%= t(".processing_description") %></p>
    </div>

  <% elsif @evaluation.failed? %>
    <div class="adm-empty-state">
      <h3><%= t(".failed_title") %></h3>
      <p><%= t(".failed_description") %></p>

      <%= render Adm::AiActionButtonComponent.new(
        url: generate_evaluation_adm_projekts_projekt_path(@projekt),
        text: t(".regenerate_button"),
        icon: "auto_awesome",
        style: :primary,
        processing_text: t(".processing_title"),
        confirm: t(".regenerate_confirm")
      ) %>
    </div>

  <% elsif @evaluation.completed? %>
    <div class="adm-projekt-evaluation-report adm-evaluation-overview">
      <%= render "adm/projekts/projekts/evaluation/overview_header",
        evaluation: @evaluation,
        projekt: @projekt %>

      <%= render "adm/projekts/projekts/evaluation/phase_cards",
        evaluation: @evaluation,
        projekt: @projekt %>
    </div>
  <% end %>
</div>
