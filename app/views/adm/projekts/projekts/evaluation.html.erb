<%= content_for :title, [@projekt.page.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(
  title: @projekt.page.title,
  breadcrumbs: @breadcrumbs,
  frontend_url: projekt_path(@projekt)
) %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container mb-5">
  <% if @evaluation.blank? || @evaluation.pending? %>
    <div class="adm-empty-state">
      <h3><%= t(".not_generated_title") %></h3>
      <p><%= t(".not_generated_description") %></p>

      <%= render Adm::AiActionButtonComponent.new(
        url: generate_evaluation_adm_projekts_projekt_path(@projekt),
        text: t(".generate_button"),
        icon: "auto_awesome",
        style: :primary,
        processing_text: t(".processing_title")
      ) %>
    </div>

  <% elsif @evaluation.processing? %>
    <div
      class="adm-empty-state"
      data-controller="shared--polling"
      data-shared--polling-url-value="<%= evaluation_status_adm_projekts_projekt_path(@projekt) %>"
      data-shared--polling-interval-value="4000"
      data-shared--polling-terminal-states-value="completed failed"
    >
      <h3><%= t(".processing_title") %></h3>
      <p><%= t(".processing_description") %></p>
      <span
        class="material-symbols-outlined adm-spinner adm-spinner--lg"
        aria-hidden="true"
      >progress_activity</span>
    </div>

  <% elsif @evaluation.failed? %>
    <div class="adm-empty-state">
      <h3><%= t(".failed_title") %></h3>
      <p><%= t(".failed_description") %></p>

      <%= render Adm::AiActionButtonComponent.new(
        url: generate_evaluation_adm_projekts_projekt_path(@projekt),
        text: t(".regenerate_button"),
        icon: "auto_awesome",
        style: :primary,
        processing_text: t(".processing_title")
      ) %>
    </div>

  <% elsif @evaluation.completed? %>
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="small text-muted">
          <%= t(".generated_at", time: l(@evaluation.generated_at, format: :long)) %>
        </span>
      </div>
      <div class="d-flex gap-2">
        <%= render Adm::ButtonWithProgressComponent.new(
          label: t(".download_pdf"),
          loading_label: t("adm.projekts.projekts.evaluation.pdf_options.downloading"),
          success_label: t("adm.projekts.projekts.evaluation.pdf_options.ready"),
          icon: "picture_as_pdf",
          success_icon: "check_circle",
          style: :primary,
          url: evaluation_pdf_options_adm_projekts_projekt_path(@projekt)
        ) %>
        <%= render Adm::AiActionButtonComponent.new(
          url: generate_evaluation_adm_projekts_projekt_path(@projekt),
          text: t(".regenerate_button"),
          icon: "auto_awesome",
          style: :secondary,
          processing_text: t(".processing_title")
        ) %>
      </div>
    </div>

    <%= render "adm/projekts/projekts/evaluation/report",
      evaluation: @evaluation,
      projekt: @projekt %>
  <% end %>
</div>
