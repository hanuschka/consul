<%
  can_ask_questions = can?(:refresh_stats, projekt_phase)
  ai_disabled = !Ai::Settings.ai_available?
  stat_questions = projekt_phase.stat_questions.by_newest.limit(20)
  pending_questions = stat_questions.select { |q| q.pending? || q.processing? }
  answered_questions = stat_questions.select { |q| q.completed? || q.failed? }
  pending_list_dom_id = "adm-ai-questions-pending-list-#{projekt_phase.id}"
  pending_section_dom_id = "adm-ai-questions-pending-#{projekt_phase.id}"
  history_dom_id = "adm-ai-questions-history-#{projekt_phase.id}"
  history_list_dom_id = "adm-ai-questions-history-list-#{projekt_phase.id}"
%>

<% if can_ask_questions %>
  <div
    class="adm-ai-question-section participation-stats-ai-question <%= 'ai-feature-disabled' if ai_disabled %>"
    data-controller="adm--ai-question-form"
    data-adm--ai-question-form-pending-list-selector-value="#<%= pending_list_dom_id %>"
    data-adm--ai-question-form-history-list-selector-value="#<%= history_list_dom_id %>"
    <% if ai_disabled %>
    data-tooltip
    title="<%= t('ai.disabled_tooltip') %>"
    <% end %>
  >
    <div class="adm-ai-question-section--header">
      <h2 class="adm-ai-question-section--title">
        <%= t("custom.participation_stats.ai_question.title") %>
      </h2>
      <p class="adm-ai-question-section--subtitle">
        <%= t("custom.participation_stats.ai_question.subtitle") %>
      </p>
    </div>

    <div class="adm-ai-question-section--form-area">
      <%= form_with url: create_stat_question_projekt_phase_path(projekt_phase),
        method: :post,
        data: { turbo: "true", adm__ai_question_form_target: "form" },
        class: "adm-ai-question-section--form" do |f| %>
        <%= f.text_area :question,
          placeholder: t("custom.participation_stats.ai_question.placeholder"),
          class: "adm-ai-question-section--textarea",
          required: true,
          disabled: ai_disabled,
          data: { adm__ai_question_form_target: "input" } %>

        <div class="adm-ai-question-section--form-actions">
          <span
            class="adm-ai-question-section--form-loading hidden"
            data-adm--ai-question-form-target="loading"
          >
            <%= render Shared::SpinnerComponent.new(size: :small) %>
            <span><%= t("custom.participation_stats.ai_question.submitting") %></span>
          </span>

          <button
            type="submit"
            class="kern-btn kern-btn--primary kern-btn--compact adm-ai-question-section--submit"
            <%= "disabled" if ai_disabled %>
            data-adm--ai-question-form-target="submit"
          >
            <span class="kern-label material-symbols-outlined" aria-hidden="true">send</span>
            <span class="kern-label">
              <%= t("custom.participation_stats.ai_question.submit") %>
            </span>
          </button>
        </div>
      <% end %>
    </div>

    <div
      id="<%= pending_section_dom_id %>"
      class="adm-ai-question-section--pending<%= ' hidden' if pending_questions.empty? %>"
      data-adm--ai-question-form-target="pendingSection"
    >
      <h4 class="adm-ai-question-section--pending-title">
        <%= t("custom.participation_stats.ai_question.in_progress") %>
      </h4>
      <div id="<%= pending_list_dom_id %>">
        <% pending_questions.each do |stat_question| %>
          <%= render partial: "adm/projekts/projekts/evaluation/ai_question_pending_item",
            locals: { stat_question: stat_question, projekt_phase: projekt_phase } %>
        <% end %>
      </div>
    </div>

    <div
      id="<%= history_dom_id %>"
      class="adm-ai-question-section--history"
    >
      <div id="<%= history_list_dom_id %>" class="adm-ai-question-section--questions-list">
        <% answered_questions.each do |stat_question| %>
          <%= render partial: "adm/projekts/projekts/evaluation/ai_question_completed_item",
            locals: { stat_question: stat_question, projekt_phase: projekt_phase } %>
        <% end %>
      </div>

      <div
        class="adm-ai-question-section--download-all<%= ' hidden' if answered_questions.empty? %>"
        data-controller="adm--menu-popover"
        data-adm--ai-question-form-target="downloadAll"
      >
        <div class="adm-ai-question-section--split">
          <%= link_to download_all_stat_answers_projekt_phase_path(projekt_phase, format: "pdf"),
            class: "adm-ai-question-section--split-main" do %>
            <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
            <span><%= t("custom.participation_stats.ai_question.download_all_pdf") %></span>
          <% end %>
          <button
            type="button"
            class="adm-ai-question-section--split-toggle"
            title="<%= t('custom.participation_stats.ai_question.choose_format') %>"
            aria-label="<%= t('custom.participation_stats.ai_question.choose_format') %>"
            data-action="click->adm--menu-popover#toggle"
          >
            <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
          </button>
        </div>
        <div
          class="adm-ai-question-section--menu adm-ai-question-section--menu--split"
          data-adm--menu-popover-target="menu"
        >
          <%= link_to download_all_stat_answers_projekt_phase_path(projekt_phase, format: "docx"),
            class: "adm-ai-question-section--menu-item" do %>
            <span class="material-symbols-outlined" aria-hidden="true">description</span>
            <span><%= t("custom.participation_stats.ai_question.download_all_docx") %></span>
          <% end %>
          <%= link_to download_all_stat_answers_projekt_phase_path(projekt_phase, format: "odt"),
            class: "adm-ai-question-section--menu-item" do %>
            <span class="material-symbols-outlined" aria-hidden="true">article</span>
            <span><%= t("custom.participation_stats.ai_question.download_all_odt") %></span>
          <% end %>
          <%= link_to download_all_stat_answers_projekt_phase_path(projekt_phase, format: "txt"),
            class: "adm-ai-question-section--menu-item" do %>
            <span class="material-symbols-outlined" aria-hidden="true">subject</span>
            <span><%= t("custom.participation_stats.ai_question.download_all_txt") %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
