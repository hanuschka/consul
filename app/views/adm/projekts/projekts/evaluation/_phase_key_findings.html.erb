<%
  phase_findings = phase["key_findings"] || []
  pdf_mode = local_assigns.fetch(:pdf_mode, false)

  findings_icon_svg = %q(<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>)
%>

<% if phase_findings.any? %>
  <div class="phase-findings">
    <div class="er-section-header">
      <div class="er-section-icon" style="background:<%= accent_light %>;color:<%= accent %>">
        <%= raw findings_icon_svg %>
      </div>
      <span class="er-section-title">
        <%= t("adm.projekts.projekts.evaluation.key_findings") %>
      </span>
    </div>

    <div class="insight-grid">
      <% phase_findings.each do |finding| %>
        <%
          sentiment = finding["sentiment"].to_s
          sentiment = "primary" unless %w[negative positive warning primary].include?(sentiment)
          refs = finding["references"] || []
          body_clean = finding["body"].to_s.gsub(/\[\d+\]/, "")
        %>
        <div class="insight-card insight--<%= sentiment %>">
          <div class="insight-stripe" style="background:var(--ic)"></div>
          <div class="insight-label" style="color:var(--ic)"><%= finding["label"] %></div>
          <div class="insight-title"><%= finding["title"] %></div>
          <div class="insight-body">
            <%= sanitize(body_clean, tags: %w[strong em b i]) %>
          </div>

          <% if refs.any? %>
            <details class="insight-disclosure" <%= "open" if pdf_mode %>>
              <summary>
                <%= t("adm.projekts.projekts.evaluation.sources_label", count: refs.size) %>
              </summary>
              <ul class="insight-disclosure-list">
                <% refs.each do |ref| %>
                  <li>
                    <span class="insight-source-type">
                      <%= t("adm.projekts.projekts.evaluation.ref_type.#{ref["type"]}", default: ref["type"]) %>
                    </span>
                    <% if ref["url"].present? %>
                      <%= link_to ref["snippet"], ref["url"], target: "_blank", rel: "noopener", class: "insight-source-link" %>
                    <% else %>
                      <span class="insight-source-snippet"><%= ref["snippet"] %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
