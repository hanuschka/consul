<%
  processing = row.processing?
  failed = row.failed?
  regenerate_url = regenerate_phase_evaluation_adm_projekts_projekt_path(projekt, phase_id: phase["phase_id"])
%>

<div class="evaluation-phase-panel">
  <div
    class="evaluation-phase-panel__loading"
    data-adm--phase-regenerate-target="loading"
    <%= "hidden" unless processing %>
  >
    <div class="adm-empty-state">
      <h3><%= t("adm.projekts.projekts.evaluation.phase_processing_title") %></h3>
      <p><%= t("adm.projekts.projekts.evaluation.phase_processing_description") %></p>
      <span
        class="material-symbols-outlined adm-spinner adm-spinner--lg projekt-evaluation-icon-material"
        aria-hidden="true"
      >progress_activity</span>
      <i
        class="fas fa-circle-notch adm-spinner adm-spinner--lg projekt-evaluation-icon-fa"
        aria-hidden="true"
      ></i>
    </div>
  </div>

  <div
    class="evaluation-phase-panel__content"
    data-adm--phase-regenerate-target="content"
    <%= "hidden" if processing %>
  >
    <% if failed %>
      <div class="adm-empty-state">
        <h3><%= t("adm.projekts.projekts.evaluation.phase_failed_title") %></h3>
        <p><%= t("adm.projekts.projekts.evaluation.phase_failed_description") %></p>

        <a
          href="<%= regenerate_url %>"
          class="kern-btn kern-btn--primary"
          data-action="click->adm--phase-regenerate#start"
          data-turbo-prefetch="false"
        >
          <span class="kern-label material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">auto_awesome</span>
          <i class="kern-label fas fa-magic projekt-evaluation-icon-fa" aria-hidden="true"></i>
          <span class="kern-label"><%= t("adm.projekts.projekts.evaluation.phase_retry_button") %></span>
        </a>
      </div>
    <% else %>
      <%= render partial: "adm/projekts/projekts/evaluation/#{partial_name}",
        locals: {
          projekt: projekt,
          phase: phase,
          accent_color: accent_color,
          accent_light_color: accent_light_color,
          accent_shades: accent_shades,
          selection: local_assigns.fetch(:selection, nil),
          tabbed: local_assigns.fetch(:tabbed, false),
          exportable: true
        } %>
    <% end %>
  </div>
</div>
