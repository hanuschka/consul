<%
  phase_id = phase["phase_id"]
  processing = row.processing?
  failed = row.failed?
  status_url = phase_evaluation_status_adm_projekts_projekt_path(projekt, phase_id: phase_id)
  regenerate_url = regenerate_phase_evaluation_adm_projekts_projekt_path(projekt, phase_id: phase_id)
%>

<div
  role="tabpanel"
  class="evaluation-phase-panel"
  data-controller="adm--phase-regenerate"
  data-adm--phase-regenerate-status-url-value="<%= status_url %>"
>
  <div
    class="evaluation-phase-panel__loading"
    data-adm--phase-regenerate-target="loading"
    <%= "hidden" unless processing %>
  >
    <div class="adm-empty-state">
      <h3><%= t("adm.projekts.projekts.evaluation.phase_processing_title") %></h3>
      <p><%= t("adm.projekts.projekts.evaluation.phase_processing_description") %></p>
      <span
        class="material-symbols-outlined adm-spinner adm-spinner--lg"
        aria-hidden="true"
      >progress_activity</span>
    </div>
  </div>

  <div
    class="evaluation-phase-panel__content"
    data-adm--phase-regenerate-target="content"
    <%= "hidden" if processing %>
  >
    <% if failed %>
      <div class="adm-empty-state">
        <h3><%= t("adm.projekts.projekts.evaluation.phase_failed_title") %></h3>
        <p><%= t("adm.projekts.projekts.evaluation.phase_failed_description") %></p>

        <a
          href="<%= regenerate_url %>"
          class="kern-btn kern-btn--primary"
          data-action="click->adm--phase-regenerate#start"
        >
          <span class="kern-label material-symbols-outlined" aria-hidden="true">auto_awesome</span>
          <span class="kern-label"><%= t("adm.projekts.projekts.evaluation.phase_retry_button") %></span>
        </a>
      </div>
    <% else %>
      <div class="evaluation-phase-panel__toolbar">
        <div class="evaluation-phase-panel__toolbar-title">
          <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
          <span><%= phase["phase_title"] %></span>
        </div>
        <div class="evaluation-phase-panel__toolbar-actions">
          <%= kern_link_button(
            evaluation_visibility_adm_projekts_phase_path(phase_id),
            text: t("adm.projekts.projekts.evaluation.configure_visibility_button"),
            icon: "visibility",
            style: :secondary
          ) %>
          <a
            href="<%= regenerate_url %>"
            class="kern-btn kern-btn--secondary"
            data-action="click->adm--phase-regenerate#start"
          >
            <span class="kern-label material-symbols-outlined" aria-hidden="true">auto_awesome</span>
            <span class="kern-label"><%= t("adm.projekts.projekts.evaluation.regenerate_phase_button") %></span>
          </a>
        </div>
      </div>

      <%= render partial: "adm/projekts/projekts/evaluation/#{partial_name}",
        locals: {
          phase: phase,
          accent_color: accent_color,
          accent_light_color: accent_light_color,
          accent_shades: accent_shades
        } %>
    <% end %>
  </div>
</div>
