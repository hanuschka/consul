<%
  full = phase["full_stats"] || {}
  segments = full["user_segments"] || {}
  gender = segments["gender"] || { "labels" => [], "values" => [] }
  age = segments["age"] || { "labels" => [], "values" => [] }
  geozone = segments["geozone"] || { "labels" => [], "values" => [] }
  individual_groups = segments["individual_groups"] || []

  has_gender = (gender["values"] || []).any? { |v| v.to_i > 0 }
  has_age = (age["values"] || []).any? { |v| v.to_i > 0 }
  has_geozone = (geozone["values"] || []).any? { |v| v.to_i > 0 }
  has_individual = individual_groups.any? { |g| (g["values"] || []).any? { |v| v.to_i > 0 } }
%>

<% if has_gender || has_age || has_geozone || has_individual %>
  <div class="evaluation-stat-card">
    <div class="phase-segments-card__header">
      <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">groups_3</span>
      <i class="fas fa-user-friends projekt-evaluation-icon-fa" aria-hidden="true"></i>
      <span class="phase-segments-card__title">
        <%= t("adm.projekts.projekts.evaluation.user_segments_title") %>
      </span>
    </div>
    <%= render partial: "adm/projekts/projekts/evaluation/user_segments_charts",
      locals: { segments: segments, accent: accent } %>
  </div>
<% end %>
