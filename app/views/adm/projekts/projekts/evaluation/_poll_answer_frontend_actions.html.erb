<%
  answer_id = answer["id"]
  count = answer["count"].to_i
%>

<% if answer_id.present? && count > 0 %>
  <span class="poll-answer-actions">
    <% if can?(:stats, @frontend_answer_poll) %>
      <%= link_to stats_poll_question_answer_path(@frontend_answer_poll, answer_id),
            remote: true,
            rel: "nofollow",
            class: "poll-answer-actions--trigger",
            title: t("custom.polls.results.question_street_details_tooltip"),
            "aria-label": t("custom.polls.results.question_street_details_tooltip") do %>
        <i class="fas fa-chart-pie" aria-hidden="true"></i>
      <% end %>

      <div class="reveal" id="answer_stats_poll_question_answer_<%= answer_id %>" data-reveal></div>
    <% end %>

    <% if can?(:results, @frontend_answer_poll) %>
      <%= link_to results_poll_question_answer_path(@frontend_answer_poll, answer_id),
            remote: true,
            rel: "nofollow",
            class: "poll-answer-actions--trigger",
            title: t("custom.polls.results.question_answer_details_tooltip"),
            "aria-label": t("custom.polls.results.question_answer_details_tooltip") do %>
        <i class="fas fa-clipboard-list" aria-hidden="true"></i>
      <% end %>

      <div class="reveal" id="answer_results_poll_question_answer_<%= answer_id %>" data-reveal></div>
    <% end %>
  </span>
<% end %>
