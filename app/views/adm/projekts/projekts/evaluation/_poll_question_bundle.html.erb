<div class="poll-question-group">
  <div class="er-section-header">
    <div class="er-section-icon" style="background:<%= accent_light %>;color:<%= accent %>">
      <i class="fas fa-layer-group" aria-hidden="true"></i>
    </div>
    <span class="er-section-title"><%= question["title"] %></span>
  </div>

  <%= render partial: "adm/projekts/projekts/evaluation/poll_question_group",
    locals: {
      questions: question["nested_questions"] || [],
      accent: accent,
      accent_light: accent_light,
      exportable: exportable
    } %>
</div>
