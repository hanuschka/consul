<% if local_assigns.fetch(:interactive, false) %>
  <div class="question-disclosures">
    <details class="question-disclosure">
      <summary class="question-disclosure--summary">
        <i class="fas fa-chart-pie" aria-hidden="true"></i>
        <span><%= t("adm.projekts.projekts.evaluation.question_participation_title") %></span>
      </summary>
      <%= turbo_frame_tag "poll-question-participation-#{question["id"]}",
            src: poll_question_participation_adm_projekts_projekt_path(@projekt, question_id: question["id"]),
            loading: "lazy",
            class: "question-disclosure--body" do %>
        <div class="question-disclosure--loading">
          <%= render Shared::SpinnerComponent.new(size: :large) %>
        </div>
      <% end %>
    </details>

    <details class="question-disclosure">
      <summary class="question-disclosure--summary">
        <i class="fas fa-clipboard-list" aria-hidden="true"></i>
        <span><%= t("adm.projekts.projekts.evaluation.question_crossectional_title") %></span>
      </summary>
      <%= turbo_frame_tag "poll-question-crossectional-#{question["id"]}",
            src: poll_question_crossectional_adm_projekts_projekt_path(@projekt, question_id: question["id"]),
            loading: "lazy",
            class: "question-disclosure--body" do %>
        <div class="question-disclosure--loading">
          <%= render Shared::SpinnerComponent.new(size: :large) %>
        </div>
      <% end %>
    </details>
  </div>
<% end %>
