<% if local_assigns.fetch(:exportable, false) %>
  <%= render layout: "adm/projekts/projekts/evaluation/export_dropdown",
    locals: { wrapper_class: "poll-question-card--export" } do %>
    <%= link_to polls_question_csv_answers_streets_path(question["id"], format: :csv),
      data: { turbo: false } do %>
      <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">download</span>
      <i class="fas fa-download projekt-evaluation-icon-fa" aria-hidden="true"></i>
      <%= t("custom.polls.results.question_street_details_csv_link") %>
    <% end %>

    <%= link_to polls_question_csv_answers_votes_path(question["id"], format: :csv),
      data: { turbo: false } do %>
      <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">download</span>
      <i class="fas fa-download projekt-evaluation-icon-fa" aria-hidden="true"></i>
      <%= t("custom.polls.results.question_answer_details_csv_link") %>
    <% end %>
  <% end %>
<% end %>
