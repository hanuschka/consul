<% if local_assigns.fetch(:exportable, false) %>
  <hr class="kern-divider mt-3 mb-2" aria-hidden="true">
  <div class="d-flex flex-column gap-1">
    <a href="<%= polls_question_csv_answers_streets_path(question["id"], format: :csv) %>" class="adm-text-link" data-turbo="false">
      <span class="material-symbols-outlined" aria-hidden="true">download</span>
      <%= t("custom.polls.results.question_street_details_csv_link") %>
    </a>
    <a href="<%= polls_question_csv_answers_votes_path(question["id"], format: :csv) %>" class="adm-text-link" data-turbo="false">
      <span class="material-symbols-outlined" aria-hidden="true">download</span>
      <%= t("custom.polls.results.question_answer_details_csv_link") %>
    </a>
  </div>
<% end %>
