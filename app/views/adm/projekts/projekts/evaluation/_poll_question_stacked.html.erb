<%
  answers = question["answers"] || []
  positive_answer = answers.find { |a| a["title"].to_s.match?(/\b(ja|yes|gut|dafür|positiv)/i) } || answers.first
  negative_answer = answers.find { |a| a != positive_answer }
%>

<div class="card poll-question-card--full">
  <div class="card-title"><%= question["title"] %></div>
  <div class="card-subtitle">n = <%= question["total_responses"].to_i %></div>

  <div class="stacked-bar">
    <% [positive_answer, negative_answer].compact.each_with_index do |answer, idx| %>
      <% color = idx.zero? ? "#059669" : "#DC2626" %>
      <div class="stacked-seg" style="width:<%= answer["percentage"] %>%;background:<%= color %>">
        <%= answer["percentage"].to_f.round %>%
      </div>
    <% end %>
  </div>

  <div class="stacked-legend">
    <% [positive_answer, negative_answer].compact.each_with_index do |answer, idx| %>
      <% color = idx.zero? ? "#059669" : "#DC2626" %>
      <div class="stacked-legend-item">
        <span class="legend-dot" style="background:<%= color %>"></span>
        <%= answer["title"] %>: <%= answer["count"].to_i %>
      </div>
    <% end %>
  </div>

  <%= render "adm/projekts/projekts/evaluation/poll_question_disclosures",
    question: question, interactive: local_assigns.fetch(:exportable, false) %>

  <%= render "adm/projekts/projekts/evaluation/poll_question_exports", question: question, exportable: local_assigns.fetch(:exportable, false) %>
</div>
