<%
  data = evaluation.data || {}
  totals = data["totals"] || {}
  phases = evaluation.phases_data

  phase_palette = evaluation_phase_palette
  phase_type_partial = evaluation_phase_section_partial

  pdf_mode = local_assigns.fetch(:pdf_mode, false)
  selection = local_assigns.fetch(:selection, nil)

  include_report_section = selection.nil? || selection.include_report?

  renderable_phases = phases.select do |p|
    next false unless phase_type_partial.key?(p["phase_type"])
    next true if selection.nil?

    selection.include_phase?(p["phase_id"])
  end
%>

<div class="adm-projekt-evaluation-report <%= 'adm-projekt-evaluation-report--pdf' if pdf_mode %>">
  <% if pdf_mode %>
    <div class="er-header">
      <div>
        <div class="er-header-badge">
          <i class="fas fa-shield-alt" aria-hidden="true"></i>
          <%= t("adm.projekts.projekts.evaluation.header_badge") %>
        </div>
        <h1><%= projekt.name %></h1>
        <p class="er-header-sub">
          <%= t("adm.projekts.projekts.evaluation.header_sub",
            phases: totals["phases_count"].to_i,
            date: l(evaluation.generated_at.to_date, format: :long)) %>
        </p>
      </div>
      <div class="er-header-meta">
        <div class="meta-item">
          <div class="meta-value"><%= totals["total_participants"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.participants") %></div>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <div class="meta-value"><%= totals["total_contributions"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.contributions") %></div>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <div class="meta-value"><%= totals["total_supports"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.supports") %></div>
        </div>
      </div>
    </div>
  <% end %>

  <% if include_report_section %>
    <%= render "adm/projekts/projekts/evaluation/report_summary_section",
      evaluation: evaluation,
      projekt: projekt,
      phase_palette: phase_palette,
      pdf_mode: true %>
  <% end %>

  <% renderable_phases.each do |phase| %>
    <%
      color = phase_palette[phase["phase_type"]]
      partial = phase_type_partial[phase["phase_type"]]
    %>
    <%= render partial: "adm/projekts/projekts/evaluation/#{partial}",
      locals: {
        phase: phase,
        accent_color: color[:accent],
        accent_light_color: color[:accent_light],
        accent_shades: color[:shades],
        selection: selection,
        pdf_mode: true
      } %>
  <% end %>
</div>
