<%
  data = evaluation.data || {}
  totals = data["totals"] || {}
  phases = evaluation.phases_data
  ai_project_summary = data["ai_project_summary"]

  phase_palette = [
    {
      accent: "#7C3AED",
      accent_light: "#EDE9FE",
      shades: ["#7C3AED", "#8B5CF6", "#A78BFA", "#C4B5FD", "#DDD6FE", "#EDE9FE"]
    },
    {
      accent: "#059669",
      accent_light: "#D1FAE5",
      shades: ["#059669", "#10B981", "#34D399", "#6EE7B7", "#A7F3D0", "#D1FAE5"]
    },
    {
      accent: "#1E40AF",
      accent_light: "#DBEAFE",
      shades: ["#1E40AF", "#1E3A8A", "#3B82F6", "#60A5FA", "#93C5FD", "#DBEAFE"]
    },
    {
      accent: "#D97706",
      accent_light: "#FEF3C7",
      shades: ["#D97706", "#F59E0B", "#FBBF24", "#FCD34D", "#FDE68A", "#FEF3C7"]
    }
  ]

  phase_type_partial = {
    "ProjektPhase::ProposalPhase" => "proposal_phase_section",
    "ProjektPhase::VotingPhase" => "voting_phase_section",
    "ProjektPhase::BudgetPhase" => "budget_phase_section",
    "ProjektPhase::CommentPhase" => "comment_phase_section"
  }

  phase_tab_config = {
    "ProjektPhase::ProposalPhase" => {
      material_icon: "lightbulb",
      kpi_key: "proposals_count",
      kpi_label_key: "adm.projekts.projekts.evaluation.proposals"
    },
    "ProjektPhase::VotingPhase" => {
      material_icon: "how_to_vote",
      kpi_key: "participants_count",
      kpi_label_key: "adm.projekts.projekts.evaluation.participants"
    },
    "ProjektPhase::BudgetPhase" => {
      material_icon: "euro_symbol",
      kpi_key: "investments_count",
      kpi_label_key: "adm.projekts.projekts.evaluation.investments"
    },
    "ProjektPhase::CommentPhase" => {
      material_icon: "chat_bubble",
      kpi_key: "comments_count",
      kpi_label_key: "adm.projekts.projekts.evaluation.comments"
    }
  }

  pdf_mode = local_assigns.fetch(:pdf_mode, false)
  selection = local_assigns.fetch(:selection, nil)

  include_report_section = selection.nil? || selection.include_report?

  renderable_phases = phases.select do |p|
    next false unless phase_type_partial.key?(p["phase_type"])
    next true if selection.nil?

    selection.include_phase?(p["phase_id"])
  end

  report_tab_material_icon = "summarize"
%>


<div class="adm-projekt-evaluation-report <%= 'adm-projekt-evaluation-report--pdf' if pdf_mode %>">
  <%# Hidden in admin (tabs) view; rendered for the PDF/share renderer which needs a self-contained header with badge, project title, and aggregate KPIs at the top. %>
  <% if pdf_mode %>
    <div class="er-header">
      <div>
        <div class="er-header-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <%= t("adm.projekts.projekts.evaluation.header_badge") %>
        </div>
        <h1><%= projekt.name %></h1>
        <p class="er-header-sub">
          <%= t("adm.projekts.projekts.evaluation.header_sub",
            phases: totals["phases_count"].to_i,
            date: l(evaluation.generated_at.to_date, format: :long)) %>
        </p>
      </div>
      <div class="er-header-meta">
        <div class="meta-item">
          <div class="meta-value"><%= totals["total_participants"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.participants") %></div>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <div class="meta-value"><%= totals["total_contributions"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.contributions") %></div>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <div class="meta-value"><%= totals["total_supports"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.supports") %></div>
        </div>
      </div>
    </div>
  <% end %>

  <% if pdf_mode && include_report_section %>
    <%= render "adm/projekts/projekts/evaluation/report_summary_section",
      evaluation: evaluation,
      projekt: projekt,
      phase_palette: phase_palette,
      phase_tab_config: phase_tab_config,
      pdf_mode: true %>
  <% end %>

  <% if renderable_phases.any? %>
    <% if pdf_mode %>
      <% renderable_phases.each_with_index do |phase, idx| %>
        <%
          color = phase_palette[idx % phase_palette.size]
          partial = phase_type_partial[phase["phase_type"]]
        %>
        <%= render partial: "adm/projekts/projekts/evaluation/#{partial}",
          locals: {
            phase: phase,
            accent_color: color[:accent],
            accent_light_color: color[:accent_light],
            accent_shades: color[:shades],
            selection: selection,
            pdf_mode: true
          } %>
      <% end %>
    <% else %>
      <%
        radio_group_name = "evaluation-phase-group-#{evaluation.id}"
        report_input_id = "evaluation-phase-radio-#{evaluation.id}-report"
        report_accent = "#7C3AED"
        report_accent_light = "#EDE9FE"

        renderable_rows = evaluation.phase_rows.select do |row|
          data = row.data || {}
          next false unless phase_type_partial.key?(data["phase_type"])
          next true if selection.nil?

          selection.include_phase?(data["phase_id"])
        end
      %>

      <div
        class="evaluation-phase-tabs"
        data-controller="adm--evaluation-phase-tabs"
      >
        <input
          type="radio"
          name="<%= radio_group_name %>"
          id="<%= report_input_id %>"
          class="evaluation-phase-tabs__radio"
          data-adm--evaluation-phase-tabs-target="radio"
          data-phase-id="report"
          checked
        >
        <% renderable_rows.each do |row| %>
          <%
            phase = row.data || {}
            input_id = "evaluation-phase-radio-#{evaluation.id}-#{phase["phase_id"]}"
          %>
          <input
            type="radio"
            name="<%= radio_group_name %>"
            id="<%= input_id %>"
            class="evaluation-phase-tabs__radio"
            data-adm--evaluation-phase-tabs-target="radio"
            data-phase-id="<%= phase["phase_id"] %>"
          >
        <% end %>

        <div class="evaluation-phase-tabs__nav" role="tablist">
          <label
            for="<%= report_input_id %>"
            role="tab"
            class="evaluation-phase-tab"
            style="--tab-accent:<%= report_accent %>;--tab-accent-light:<%= report_accent_light %>"
          >
            <span class="evaluation-phase-tab__icon">
              <span class="material-symbols-outlined" aria-hidden="true"><%= report_tab_material_icon %></span>
            </span>
            <span class="evaluation-phase-tab__body">
              <span class="evaluation-phase-tab__name">
                <%= t("adm.projekts.projekts.evaluation.report_tab.title") %>
              </span>
              <span class="evaluation-phase-tab__meta">
                <span><%= t("adm.projekts.projekts.evaluation.report_tab.kpi_label") %></span>
              </span>
            </span>
          </label>

          <% renderable_rows.each_with_index do |row, idx| %>
            <%
              phase = row.data || {}
              color = phase_palette[idx % phase_palette.size]
              config = phase_tab_config[phase["phase_type"]]
              kpi_value = (phase["stats"] || {})[config[:kpi_key]].to_i
              kpi_label = t(config[:kpi_label_key])
              input_id = "evaluation-phase-radio-#{evaluation.id}-#{phase["phase_id"]}"
              generated_at_text =
                if row.generated_at.present?
                  t("adm.projekts.projekts.evaluation.phase_tab.generated_at",
                    date: l(row.generated_at, format: :long))
                else
                  t("adm.projekts.projekts.evaluation.phase_tab.generated_at_unknown")
                end
            %>
            <label
              for="<%= input_id %>"
              role="tab"
              class="evaluation-phase-tab"
              style="--tab-accent:<%= color[:accent] %>;--tab-accent-light:<%= color[:accent_light] %>"
            >
              <span class="evaluation-phase-tab__icon">
                <span class="material-symbols-outlined" aria-hidden="true"><%= config[:material_icon] %></span>
              </span>
              <span class="evaluation-phase-tab__body">
                <span class="evaluation-phase-tab__name"><%= phase["phase_title"] %></span>
                <span class="evaluation-phase-tab__meta">
                  <strong><%= kpi_value %></strong>
                  <span><%= kpi_label %></span>
                </span>
                <span class="evaluation-phase-tab__generated-at">
                  <%= generated_at_text %>
                </span>
              </span>
            </label>
          <% end %>
        </div>

        <div class="evaluation-phase-tabs__panels">
          <div role="tabpanel" class="evaluation-phase-panel evaluation-phase-panel--report">
            <%= render "adm/projekts/projekts/evaluation/report_summary_section",
              evaluation: evaluation,
              projekt: projekt,
              phase_palette: phase_palette,
              phase_tab_config: phase_tab_config,
              pdf_mode: false %>
          </div>

          <% renderable_rows.each_with_index do |row, idx| %>
            <%
              phase = row.data || {}
              color = phase_palette[idx % phase_palette.size]
              partial = phase_type_partial[phase["phase_type"]]
            %>
            <%= render "adm/projekts/projekts/evaluation/phase_panel",
              projekt: projekt,
              row: row,
              phase: phase,
              partial_name: partial,
              accent_color: color[:accent],
              accent_light_color: color[:accent_light],
              accent_shades: color[:shades] %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% elsif !pdf_mode %>
    <%= render "adm/projekts/projekts/evaluation/report_summary_section",
      evaluation: evaluation,
      projekt: projekt,
      phase_palette: phase_palette,
      phase_tab_config: phase_tab_config,
      pdf_mode: false %>
  <% end %>

</div>
