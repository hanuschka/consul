<%
  data = evaluation.data || {}
  phases = evaluation.phases_data
  project_content_summary = data["project_content_summary"]
  report_settings = data["report_settings"] || {}
  pdf_mode = local_assigns.fetch(:pdf_mode, false)

  page = projekt.page
  page_title = page&.title.to_s
  page_subtitle = page&.subtitle.to_s
  page_image = page&.image

  open_phases = (report_settings["open_phases"] || []).reject(&:blank?)
  tags = (report_settings["tags"] || []).reject(&:blank?)
  sdg_goals = report_settings["sdg_goals"] || []

  renderable_phases = phases.select { |p| phase_palette.present? && p["phase_type"].present? }

  qr_url =
    if pdf_mode && page&.slug.present?
      base_url = Setting["url"].to_s.chomp("/").presence || request.base_url
      "#{base_url}/#{page.slug}"
    end
  qr_svg =
    if qr_url.present?
      RQRCode::QRCode.new(qr_url).as_svg(
        module_size: 4,
        standalone: true,
        use_path: true,
        viewbox: true
      )
    end
%>

<section
  class="report-summary"
  data-pdf-chunk="report"
>
  <% if pdf_mode && qr_svg.present? %>
    <div class="report-summary--qr">
      <div class="report-summary--qr-img"><%= raw(qr_svg) %></div>
      <div class="report-summary--qr-meta">
        <div class="report-summary--qr-label">
          <%= t("adm.projekts.projekts.evaluation.report.qr_code_label") %>
        </div>
        <div class="report-summary--qr-url"><%= qr_url %></div>
      </div>
    </div>
  <% end %>

  <section class="report-summary--card report-summary--project">
    <h2 class="report-summary--project-title"><%= page_title %></h2>

    <div class="report-summary--project-grid">
      <div class="report-summary--project-media">
        <% if page_image&.attached? %>
          <%= image_tag page_image.variant(:medium),
            class: "report-summary--project-image",
            alt: page_title %>
        <% else %>
          <div class="report-summary--project-image-fallback">
            <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">image</span>
            <i class="fas fa-image projekt-evaluation-icon-fa" aria-hidden="true"></i>
            <span><%= t("adm.projekts.projekts.evaluation.report.project_summary_no_image") %></span>
          </div>
        <% end %>
      </div>

      <div class="report-summary--project-body">
        <% if page_subtitle.present? %>
          <div class="report-summary--project-subtitle">
            <%= sanitize(page_subtitle, tags: ["br"]) %>
          </div>
        <% end %>

        <div class="report-summary--ai-block">
          <div class="report-summary--ai-label">
            <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">auto_awesome</span>
            <i class="fas fa-magic projekt-evaluation-icon-fa" aria-hidden="true"></i>
            <%= t("adm.projekts.projekts.evaluation.report.project_summary_ai_label") %>
          </div>
          <% if project_content_summary.present? %>
            <div class="report-summary--ai-body">
              <%= sanitize(project_content_summary, tags: %w[h3 p]) %>
            </div>
          <% else %>
            <div class="report-summary--ai-body -muted">
              <%= t("adm.projekts.projekts.evaluation.report.project_summary_ai_empty") %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="report-summary--card report-summary--settings">
    <div class="report-summary--section-label">
      <%= t("adm.projekts.projekts.evaluation.report.settings_label") %>
    </div>

    <div class="report-summary--settings-grid">
      <div class="report-summary--stat-card -emerald <%= "-wide" if open_phases.size > 4 %>">
        <div class="report-summary--stat-card-head">
          <strong class="report-summary--stat-card-number"><%= open_phases.size %></strong>
          <div class="report-summary--stat-card-label">
            <span class="report-summary--stat-card-icon">
              <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">play_circle</span>
              <i class="fas fa-play-circle projekt-evaluation-icon-fa" aria-hidden="true"></i>
            </span>
            <%= t("adm.projekts.projekts.evaluation.report.settings_open_phases", count: [open_phases.size, 1].max) %>
          </div>
        </div>
        <% if open_phases.any? %>
          <ul class="report-summary--stat-card-list <%= open_phases.size > 4 ? "-cols-3" : "-cols-2" %>">
            <% open_phases.each do |title| %>
              <li><%= title %></li>
            <% end %>
          </ul>
        <% else %>
          <div class="report-summary--stat-card-empty">
            <%= t("adm.projekts.projekts.evaluation.report.settings_open_phases_none") %>
          </div>
        <% end %>
      </div>

      <div class="report-summary--stat-card -amber <%= "-wide" if tags.size > 4 %>">
        <div class="report-summary--stat-card-head">
          <strong class="report-summary--stat-card-number"><%= tags.size %></strong>
          <div class="report-summary--stat-card-label">
            <span class="report-summary--stat-card-icon">
              <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">sell</span>
              <i class="fas fa-tag projekt-evaluation-icon-fa" aria-hidden="true"></i>
            </span>
            <%= t("adm.projekts.projekts.evaluation.report.settings_tags") %>
          </div>
        </div>
        <% if tags.any? %>
          <ul class="report-summary--stat-card-list <%= tags.size > 4 ? "-cols-3" : "-cols-2" %>">
            <% tags.each do |name| %>
              <li><%= name %></li>
            <% end %>
          </ul>
        <% else %>
          <div class="report-summary--stat-card-empty">
            <%= t("adm.projekts.projekts.evaluation.report.settings_tags_none") %>
          </div>
        <% end %>
      </div>

      <div class="report-summary--stat-card -rose">
        <div class="report-summary--stat-card-head">
          <strong class="report-summary--stat-card-number"><%= sdg_goals.size %></strong>
          <div class="report-summary--stat-card-label">
            <span class="report-summary--stat-card-icon">
              <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">eco</span>
              <i class="fas fa-leaf projekt-evaluation-icon-fa" aria-hidden="true"></i>
            </span>
            <%= t("adm.projekts.projekts.evaluation.report.settings_sdgs") %>
          </div>
        </div>
        <% if sdg_goals.any? %>
          <% sdg_records_by_code = SDG::Goal.where(code: sdg_goals.map { |g| g["code"] }).index_by { |g| g.code.to_s } %>
          <ul class="report-summary--sdg-list">
            <% sdg_goals.each do |goal| %>
              <% sdg_record = sdg_records_by_code[goal["code"].to_s] %>
              <% if sdg_record %>
                <li class="report-summary--sdg-list-item">
                  <span class="report-summary--sdg-list-icon">
                    <%= render SDG::Goals::IconComponent.new(sdg_record) %>
                  </span>
                  <span class="report-summary--sdg-list-name"><%= sdg_record.title %></span>
                </li>
              <% end %>
            <% end %>
          </ul>
        <% else %>
          <div class="report-summary--stat-card-empty">
            <%= t("adm.projekts.projekts.evaluation.report.settings_sdgs_none") %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="report-summary--card report-summary--phases">
    <div class="report-summary--section-label">
      <%= t("adm.projekts.projekts.evaluation.report.phases_label") %>
    </div>

    <% if renderable_phases.any? %>
      <div class="report-summary--phases-list">
        <% renderable_phases.each_with_index do |phase, idx| %>
          <%
            color = phase_palette[phase["phase_type"]]
            summary_sections = phase_summary_sections(phase["short_summary"])
          %>
          <div
            class="report-summary--phase-card"
            style="--phase-accent:<%= color[:accent] %>;--phase-accent-light:<%= color[:accent_light] %>"
          >
            <div class="report-summary--phase-head">
              <span class="report-summary--phase-icon">
                <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">
                  <%= ProjektPhase.material_icon_for(phase["phase_type"]) %>
                </span>
                <i class="fas <%= ProjektPhase.fa_icon_for(phase["phase_type"]) %> projekt-evaluation-icon-fa" aria-hidden="true"></i>
              </span>
              <div class="report-summary--phase-meta">
                <div class="report-summary--phase-title"><%= phase["phase_title"] %></div>
                <div class="report-summary--phase-type">
                  <%= t(
                    "adm.projekts.projekts.evaluation.#{phase["phase_type"].to_s.split("::").last.underscore}",
                    default: phase["phase_type"].to_s.split("::").last
                  ) %>
                </div>
              </div>
            </div>

            <% if summary_sections.any? %>
              <div class="report-summary--phase-body">
                <% summary_sections.each do |section| %>
                  <% if section["heading"].present? %>
                    <h3 class="report-summary--phase-section-heading"><%= section["heading"] %></h3>
                  <% end %>
                  <%= simple_format(section["body"], class: "report-summary--phase-paragraph") %>
                <% end %>
              </div>
            <% else %>
              <div class="report-summary--phase-body-empty">
                <%= t("adm.projekts.projekts.evaluation.report.phase_short_summary_empty") %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="report-summary--phases-empty">
        <%= t("adm.projekts.projekts.evaluation.report.phases_empty") %>
      </div>
    <% end %>
  </section>
</section>
