<%
  section_label = t(
    "adm.projekts.projekts.evaluation.pdf_options.sections.#{section_key}",
    default: section_key.to_s.humanize
  )
%>
<div
  class="footer-evaluation-section-toggle js-studio-hide-on-preview"
  data-phase-id="<%= phase_id %>"
  data-section-key="<%= section_key %>"
  data-toggle-url="<%= toggle_url %>"
>
  <custom-switch
    <%= "checked" if checked %>
    label="<%= section_label %>"
    input-class="js-footer-evaluation-section-toggle-input"
    control-title="<%= t('custom.projekt_phases.footer_evaluation.section_visibility_toggle_title') %>"
  ></custom-switch>
  <span class="footer-evaluation-section-toggle--status" aria-hidden="true">
    <span class="footer-evaluation-section-toggle--spinner"></span>
    <i class="fas fa-exclamation-triangle footer-evaluation-section-toggle--icon -error"></i>
  </span>
</div>
