<%
  gender = segments["gender"] || { "labels" => [], "values" => [] }
  age = segments["age"] || { "labels" => [], "values" => [] }
  geozone = segments["geozone"] || { "labels" => [], "values" => [] }
  individual_groups = segments["individual_groups"] || []

  has_gender = (gender["values"] || []).any? { |v| v.to_i > 0 }
  has_age = (age["values"] || []).any? { |v| v.to_i > 0 }
  has_geozone = (geozone["values"] || []).any? { |v| v.to_i > 0 }
%>

<div class="phase-segments-card__grid" data-controller="adm-charts">
  <% if has_age %>
    <div class="phase-segments-card__panel -full-width">
      <div class="phase-segments-card__panel-label">
        <%= t("stats.by_age") %>
      </div>
      <div
        class="phase-segments-card__chart"
        data-bar-chart
        data-chart-labels="<%= (age["labels"] || []).to_json %>"
        data-chart-values="<%= (age["values"] || []).to_json %>"
        data-chart-colors="<%= evaluation_chart_colors(age["values"] || []).to_json %>"
      >
        <canvas></canvas>
      </div>
    </div>
  <% end %>

  <% if has_geozone %>
    <div class="phase-segments-card__panel -full-width">
      <div class="phase-segments-card__panel-label">
        <%= t("adm.projekts.projekts.evaluation.geozone_distribution") %>
      </div>
      <div
        class="phase-segments-card__chart"
        data-bar-chart
        data-chart-labels="<%= (geozone["labels"] || []).to_json %>"
        data-chart-values="<%= (geozone["values"] || []).to_json %>"
        data-chart-colors="<%= evaluation_chart_colors(geozone["values"] || []).to_json %>"
      >
        <canvas></canvas>
      </div>
    </div>
  <% end %>

  <% if has_gender %>
    <div class="phase-segments-card__panel">
      <div class="phase-segments-card__panel-label">
        <%= t("stats.by_gender") %>
      </div>
      <div
        class="phase-segments-card__chart"
        data-pie-chart
        data-chart-labels="<%= (gender["labels"] || []).to_json %>"
        data-chart-values="<%= (gender["values"] || []).to_json %>"
        data-chart-colors="<%= evaluation_chart_colors(gender["values"] || [], gender["colors"]).to_json %>"
      >
        <canvas></canvas>
      </div>
    </div>
  <% end %>

  <% individual_groups.each do |group| %>
    <% next if (group["values"] || []).none? { |v| v.to_i > 0 } %>
    <div class="phase-segments-card__panel">
      <div class="phase-segments-card__panel-label"><%= group["name"] %></div>
      <div
        class="phase-segments-card__chart"
        data-bar-chart
        data-chart-labels="<%= (group["labels"] || []).to_json %>"
        data-chart-values="<%= (group["values"] || []).to_json %>"
        data-chart-colors="<%= evaluation_chart_colors(group["values"] || []).to_json %>"
      >
        <canvas></canvas>
      </div>
    </div>
  <% end %>
</div>
