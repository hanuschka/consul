<%
  stats = phase["stats"] || {}
  polls = stats["polls"] || []
  accent = accent_color
  accent_light = accent_light_color

  section_selection = local_assigns.fetch(:selection, nil)
  show_section = ->(key) {
    section_selection.nil? || section_selection.include_section?(phase["phase_id"], key)
  }
%>

<div class="phase-block">
  <% if show_section.call("kpis") %>
  <div class="phase-header">
    <div class="phase-icon-title">
      <div class="phase-icon" style="background:<%= accent_light %>;color:<%= accent %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
      </div>
      <div>
        <div class="phase-title"><%= phase["phase_title"] %></div>
        <div class="phase-subtitle"><%= t("adm.projekts.projekts.evaluation.voting_phase") %></div>
      </div>
    </div>
    <div class="phase-meta">
      <div class="meta-item">
        <div class="meta-value" style="color:<%= accent %>"><%= stats["polls_count"].to_i %></div>
        <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.polls") %></div>
      </div>
      <div class="meta-divider"></div>
      <div class="meta-item">
        <div class="meta-value" style="color:<%= accent %>"><%= stats["participants_count"].to_i %></div>
        <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.participants") %></div>
      </div>
      <div class="meta-divider"></div>
      <div class="meta-item">
        <div class="meta-value" style="color:<%= accent %>"><%= stats["questions_count"].to_i %></div>
        <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.questions") %></div>
      </div>
      <% if stats["open_text_count"].to_i > 0 %>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <div class="meta-value" style="color:<%= accent %>"><%= stats["open_text_count"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.open_contributions") %></div>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <% if show_section.call("questions") %>
  <% polls.each do |poll| %>
    <% questions = poll["questions"] || [] %>
    <% next if questions.empty? && (poll["open_text_entries"] || []).empty? %>

    <div class="poll-block">
      <div class="poll-header">
        <div class="poll-name"><%= poll["name"] %></div>
        <div class="poll-meta">
          <%= t("adm.projekts.projekts.evaluation.poll_meta",
            voters: poll["voters_count"].to_i,
            questions: poll["questions_count"].to_i) %>
        </div>
      </div>

      <% groupings = poll["groupings"] || [] %>
      <% if groupings.any? %>
        <% groupings.each do |group| %>
          <% group_question_ids = Array(group["question_ids"]).map(&:to_i) %>
          <% group_questions = questions.select { |q| group_question_ids.include?(q["id"].to_i) } %>
          <% next if group_questions.empty? %>

          <div class="poll-question-group">
            <div class="er-section-header">
              <div class="er-section-icon" style="background:<%= accent_light %>;color:<%= accent %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M9 17H5a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-4"/><polyline points="12 22 8 18 12 14"/></svg>
              </div>
              <span class="er-section-title"><%= group["label"] %></span>
            </div>

            <%= render partial: "adm/projekts/projekts/evaluation/poll_question_group",
              locals: { questions: group_questions, accent: accent, accent_light: accent_light } %>
          </div>
        <% end %>
      <% else %>
        <%= render partial: "adm/projekts/projekts/evaluation/poll_question_group",
          locals: { questions: questions, accent: accent, accent_light: accent_light } %>
      <% end %>

      <% entries = poll["open_text_entries"] || [] %>
      <% if entries.any? && show_section.call("open_responses") %>
        <%
          pdf_mode_local = local_assigns.fetch(:pdf_mode, false)
          open_by_default = pdf_mode_local || entries.size <= 6
        %>
        <details
          class="open-responses"
          style="--or-accent:<%= accent %>;--or-accent-light:<%= accent_light %>"
          <%= ' open' if open_by_default %>
        >
          <summary class="open-responses-summary">
            <span class="open-responses-summary-icon">
              <span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span>
            </span>
            <span class="open-responses-summary-title">
              <%= t("adm.projekts.projekts.evaluation.open_responses_title", count: entries.size) %>
            </span>
            <span class="open-responses-summary-count"><%= entries.size %></span>
            <span class="open-responses-toggle">
              <span class="open-responses-toggle-label-show">
                <%= t("adm.projekts.projekts.evaluation.open_responses_show") %>
              </span>
              <span class="open-responses-toggle-label-hide">
                <%= t("adm.projekts.projekts.evaluation.open_responses_hide") %>
              </span>
              <span class="material-symbols-outlined open-responses-toggle-icon" aria-hidden="true">expand_more</span>
            </span>
          </summary>
          <div class="response-grid">
            <% entries.each do |entry| %>
              <% text = (entry.is_a?(Hash) ? entry["body"] : entry).to_s.strip %>
              <% next if text.blank? %>
              <div class="response-item"><%= text %></div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>
  <% end %>

  <% eval_summary = phase["evaluation_summary"] || {} %>
  <% if eval_summary["body"].present? %>
    <div class="ai-summary" style="background:<%= accent_light %>;border:1px solid <%= accent %>">
      <div class="ai-summary-stripe" style="background:<%= accent %>"></div>
      <div class="ai-summary-title"><%= eval_summary["title"] %></div>
      <div class="ai-summary-body"><%= sanitize(eval_summary["body"], tags: %w[strong em b i]) %></div>
    </div>
  <% end %>

  <% if show_section.call("key_findings") %>
    <%= render partial: "adm/projekts/projekts/evaluation/phase_key_findings",
      locals: {
        phase: phase,
        accent: accent,
        accent_light: accent_light,
        pdf_mode: local_assigns.fetch(:pdf_mode, false)
      } %>
  <% end %>

  <% pdf_mode_local = local_assigns.fetch(:pdf_mode, false) %>
  <% if !pdf_mode_local || show_section.call("ai_questions") %>
    <%= render partial: "adm/projekts/projekts/evaluation/phase_ai_questions",
      locals: {
        phase: phase,
        accent: accent,
        accent_light: accent_light,
        pdf_mode: pdf_mode_local
      } %>
  <% end %>
</div>
