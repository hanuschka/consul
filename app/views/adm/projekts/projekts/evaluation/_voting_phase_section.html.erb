<%
  stats = phase["stats"] || {}
  polls = (stats["polls"] || []).sort_by { |poll| -poll["id"].to_i }
  accent = accent_color
  accent_light = accent_light_color
  pdf_mode = local_assigns.fetch(:pdf_mode, false)
  tabbed = local_assigns.fetch(:tabbed, false)

  section_selection = local_assigns.fetch(:selection, nil)
  only_tab = local_assigns.fetch(:only_tab, nil)
  hidden_sections = local_assigns.fetch(:hidden_sections, [])
  show_section = ->(key) {
    next false if hidden_sections.include?(key)

    next false if only_tab.present? && !evaluation_section_tabs(key).split.include?(only_tab)

    section_selection.nil? || section_selection.include_section?(phase["phase_id"], key)
  }
%>

<div class="phase-block">
  <% if show_section.call("kpis") %>
  <% if tabbed %><custom-tab-panel for="stats ai poll_stats"><% end %>
  <section
    class="phase-evaluation-section"
    data-pdf-chunk="phase:<%= phase["phase_id"] %>:kpis"
    data-phase-id="<%= phase["phase_id"] %>"
    data-section="kpis"
  >
  <div class="phase-header">
    <div class="phase-icon-title">
      <div class="phase-icon" style="background:<%= accent_light %>;color:<%= accent %>">
        <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true"><%= ProjektPhase.material_icon_for(phase["phase_type"]) %></span>
        <i class="fas <%= ProjektPhase.fa_icon_for(phase["phase_type"]) %> projekt-evaluation-icon-fa" aria-hidden="true"></i>
      </div>
      <% first_poll = polls.first %>
      <div>
        <div class="phase-title"><%= phase["phase_title"] %></div>
        <% if !pdf_mode && first_poll %>
          <a
            href="<%= poll_path(first_poll["id"]) %>"
            class="phase-header-poll-link"
            target="_blank"
            rel="noopener"
          >
            <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">open_in_new</span>
            <i class="fas fa-external-link-alt projekt-evaluation-icon-fa" aria-hidden="true"></i>
            <span><%= first_poll["name"] %></span>
          </a>
        <% end %>
      </div>
      <% if local_assigns[:regenerate_url].present? %>
        <%= render "adm/projekts/projekts/evaluation/regenerate_phase_button",
          regenerate_url: regenerate_url %>
      <% end %>
    </div>
    <div class="phase-header-aside">
      <div class="phase-meta">
        <div class="meta-item">
          <div class="meta-value" style="color:<%= accent %>"><%= stats["polls_count"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.polls") %></div>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <div class="meta-value" style="color:<%= accent %>"><%= stats["participants_count"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.participants") %></div>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-item">
          <div class="meta-value" style="color:<%= accent %>"><%= stats["questions_count"].to_i %></div>
          <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.questions") %></div>
        </div>
        <% if stats["open_text_count"].to_i > 0 %>
          <div class="meta-divider"></div>
          <div class="meta-item">
            <div class="meta-value" style="color:<%= accent %>"><%= stats["open_text_count"].to_i %></div>
            <div class="meta-label"><%= t("adm.projekts.projekts.evaluation.open_contributions") %></div>
          </div>
        <% end %>
        <div class="meta-divider"></div>
      </div>

      <% if local_assigns.fetch(:exportable, false) %>
        <%= render layout: "adm/projekts/projekts/evaluation/export_dropdown" do %>
          <%= render "adm/projekts/projekts/evaluation/export_pdf_item", projekt: projekt, phase: phase %>

          <%= link_to poll_questions_adm_projekts_phase_path(phase["phase_id"], format: :csv),
            data: { turbo: false } do %>
            <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">download</span>
            <i class="fas fa-download projekt-evaluation-icon-fa" aria-hidden="true"></i>
            <%= t("adm.projekts.phases.poll_questions.download_individual_answers") %>
          <% end %>

          <% if first_poll %>
            <%= link_to poll_csv_answers_votes_path(first_poll["id"], format: :csv),
              data: { turbo: false } do %>
              <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">download</span>
              <i class="fas fa-download projekt-evaluation-icon-fa" aria-hidden="true"></i>
              <%= t("custom.polls.show.results.download_csv_answers_votes") %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
  </section>
  <% if tabbed %></custom-tab-panel><% end %>
  <% end %>

  <% if show_section.call("questions") %>
  <% if tabbed %><custom-tab-panel for="<%= evaluation_section_tabs("questions") %>"><% end %>
  <section
    class="phase-evaluation-section"
    data-pdf-chunk="phase:<%= phase["phase_id"] %>:questions"
    data-phase-id="<%= phase["phase_id"] %>"
    data-section="questions"
  >
  <% polls.each do |poll| %>
    <% questions = poll["questions"] || [] %>
    <% next if questions.empty? && (poll["open_text_entries"] || []).empty? %>

    <div class="poll-block">
      <% if polls.size > 1 || !tabbed %>
        <div class="poll-header">
          <% if polls.size > 1 %>
            <div class="poll-name"><%= poll["name"] %></div>
          <% end %>
          <% if !tabbed %>
            <div class="poll-meta">
              <%= t("adm.projekts.projekts.evaluation.poll_meta",
                voters: poll["voters_count"].to_i,
                questions: poll["questions_count"].to_i) %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= render partial: "adm/projekts/projekts/evaluation/poll_question_group",
        locals: { questions: questions, accent: accent, accent_light: accent_light, exportable: local_assigns.fetch(:exportable, false) } %>

      <% entries = poll["open_text_entries"] || [] %>
      <% if entries.any? && show_section.call("open_responses") %>
        <%
          pdf_mode_local = local_assigns.fetch(:pdf_mode, false)
          open_by_default = pdf_mode_local || entries.size <= 6
        %>
        <section
          class="phase-evaluation-section"
          data-pdf-chunk="phase:<%= phase["phase_id"] %>:open_responses"
          data-phase-id="<%= phase["phase_id"] %>"
          data-section="open_responses"
        >
        <details
          class="open-responses"
          style="--or-accent:<%= accent %>;--or-accent-light:<%= accent_light %>"
          <%= ' open' if open_by_default %>
        >
          <summary class="open-responses-summary">
            <span class="open-responses-summary-icon">
              <span class="material-symbols-outlined projekt-evaluation-icon-material" aria-hidden="true">chat_bubble</span>
              <i class="fas fa-comment-dots projekt-evaluation-icon-fa" aria-hidden="true"></i>
            </span>
            <span class="open-responses-summary-title">
              <%= t("adm.projekts.projekts.evaluation.open_responses_title", count: entries.size) %>
            </span>
            <span class="open-responses-summary-count"><%= entries.size %></span>
            <span class="open-responses-toggle">
              <span class="open-responses-toggle-label-show">
                <%= t("adm.projekts.projekts.evaluation.open_responses_show") %>
              </span>
              <span class="open-responses-toggle-label-hide">
                <%= t("adm.projekts.projekts.evaluation.open_responses_hide") %>
              </span>
              <span class="material-symbols-outlined open-responses-toggle-icon projekt-evaluation-icon-material" aria-hidden="true">expand_more</span>
              <i class="fas fa-chevron-down open-responses-toggle-icon projekt-evaluation-icon-fa" aria-hidden="true"></i>
            </span>
          </summary>
          <div class="response-grid">
            <% entries.each do |entry| %>
              <% text = (entry.is_a?(Hash) ? entry["body"] : entry).to_s.strip %>
              <% next if text.blank? %>
              <div class="response-item"><%= text %></div>
            <% end %>
          </div>
        </details>
        </section>
      <% end %>
    </div>
  <% end %>
  </section>
  <% if tabbed %></custom-tab-panel><% end %>
  <% end %>

  <% eval_summary = phase["evaluation_summary"] || {} %>
  <% if eval_summary["body"].present? && show_section.call("ai_summary") %>
    <% if tabbed %><custom-tab-panel for="<%= evaluation_section_tabs("ai_summary") %>"><% end %>
    <section
      class="phase-evaluation-section"
      data-pdf-chunk="phase:<%= phase["phase_id"] %>:ai_summary"
      data-phase-id="<%= phase["phase_id"] %>"
      data-section="ai_summary"
    >
    <div class="ai-summary" style="background:<%= accent_light %>;border:1px solid <%= accent %>">
      <div class="ai-summary-stripe" style="background:<%= accent %>"></div>
      <div class="ai-summary-title"><%= eval_summary["title"] %></div>
      <div class="ai-summary-body"><%= sanitize(eval_summary["body"], tags: %w[strong em b i]) %></div>
    </div>
    </section>
    <% if tabbed %></custom-tab-panel><% end %>
  <% end %>

  <% if show_section.call("key_findings") %>
    <% if tabbed %><custom-tab-panel for="<%= evaluation_section_tabs("key_findings") %>"><% end %>
    <section
      class="phase-evaluation-section"
      data-pdf-chunk="phase:<%= phase["phase_id"] %>:key_findings"
      data-phase-id="<%= phase["phase_id"] %>"
      data-section="key_findings"
    >
    <%= render partial: "adm/projekts/projekts/evaluation/phase_key_findings",
      locals: {
        phase: phase,
        accent: accent,
        accent_light: accent_light,
        pdf_mode: local_assigns.fetch(:pdf_mode, false)
      } %>
    </section>
    <% if tabbed %></custom-tab-panel><% end %>
  <% end %>

  <% pdf_mode_local = local_assigns.fetch(:pdf_mode, false) %>
  <% if (only_tab.blank? && !pdf_mode_local) || show_section.call("ai_questions") %>
    <% if tabbed %><custom-tab-panel for="<%= evaluation_section_tabs("ai_questions") %>"><% end %>
    <section
      class="phase-evaluation-section"
      data-pdf-chunk="phase:<%= phase["phase_id"] %>:ai_questions"
      data-phase-id="<%= phase["phase_id"] %>"
      data-section="ai_questions"
    >
    <%= render partial: "adm/projekts/projekts/evaluation/phase_ai_questions",
      locals: {
        phase: phase,
        accent: accent,
        accent_light: accent_light,
        pdf_mode: pdf_mode_local
      } %>
    </section>
    <% if tabbed %></custom-tab-panel><% end %>
  <% end %>
</div>
