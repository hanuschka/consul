<% content_for :title, [@projekt.page.title, t(".title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(
  title: @projekt.page.title,
  breadcrumbs: @breadcrumbs,
  frontend_url: projekt_path(@projekt)
) %>

<%= render Adm::TabsComponent.new(tabs: projekt_tabs(@projekt)) %>

<div class="kern-container mb-5">
  <h2 class="h3 mb-4"><%= t(".heading") %></h2>
  <p class="text-muted mb-4"><%= t(".description") %></p>

  <%= form_with(
    url: evaluation_pdf_adm_projekts_projekt_path(@projekt),
    method: :get,
    local: true,
    html: {
      target: "_blank",
      data: { turbolinks: false, turbo: false }
    },
    class: "pdf-options-form"
  ) do |form| %>

    <% phases = @evaluation.data["phases"] || [] %>
    <% phases.each do |phase| %>
      <%
        phase_id = phase["phase_id"].to_i
        available_sections = PdfServices::EvaluationPdfSelection.available_sections(phase["phase_type"])
      %>
      <div class="pdf-options-phase">
        <label class="pdf-options-phase__toggle">
          <%= check_box_tag(
            "pdf_options[phase_ids][]",
            phase_id,
            true,
            id: "pdf_options_phase_#{phase_id}"
          ) %>
          <strong><%= phase["phase_title"] %></strong>
          <span class="pdf-options-phase__type">
            <%= t("adm.projekts.projekts.evaluation.#{phase["phase_type"].to_s.split("::").last.underscore}",
              default: phase["phase_type"].to_s.split("::").last) %>
          </span>
        </label>

        <div class="pdf-options-sections">
          <% available_sections.each do |section_key| %>
            <label class="pdf-options-section">
              <%= check_box_tag(
                "pdf_options[sections][#{phase_id}][]",
                section_key,
                true,
                id: "pdf_options_section_#{phase_id}_#{section_key}"
              ) %>
              <%= t("adm.projekts.projekts.evaluation.pdf_options.sections.#{section_key}") %>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="d-flex gap-2 mt-4">
      <%= kern_link_button(
        evaluation_adm_projekts_projekt_path(@projekt),
        text: t(".cancel"),
        icon: "arrow_back",
        style: :secondary
      ) %>
      <%= button_tag(
        type: "submit",
        class: "kern-btn kern-btn--primary"
      ) do %>
        <span class="kern-label material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
        <span class="kern-label"><%= t(".download") %></span>
      <% end %>
    </div>
  <% end %>
</div>
