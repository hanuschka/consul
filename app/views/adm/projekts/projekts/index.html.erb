<%= content_for :title, t("adm.projekts.projekts.index.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.projekts.projekts.index.title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t("adm.projekts.projekts.index.hint_text") %></p>
  <% end %>
<% end %>

<div class="kern-container">
  <div class="d-flex justify-content-start mb-4 gap-3">
    <% if policy([:adm, :projekts, Projekt]).create? %>
      <%= new_resource_link(new_adm_projekts_projekt_path, t(".new_projekt")) %>
    <% end %>

    <% if Ai::Settings.ai_available? %>
      <%= kern_link_button(
        import_projekt_adm_projekts_projekts_path,
        text: t(".import_projekt"),
        icon: "upload_file",
        class: "mb-4",
        style: :secondary
      ) %>
    <% end %>
  </div>

  <% if @projekts.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <%= render Kern::Table::HeaderComponent.new(:name, Projekt.model_name.human, **@name_header_options) %>
            <%= render Kern::Table::HeaderComponent.new(:total_duration_start, Projekt.human_attribute_name("total_duration_start"), **@start_date_header_options) %>
            <%= render Kern::Table::HeaderComponent.new(:total_duration_end, Projekt.human_attribute_name("total_duration_end"), **@end_date_header_options) %>
            <th scope="col" class="kern-table__header"><%= t(".table.status") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% @projekts.each do |projekt| %>
            <%= render "projekt", projekt: projekt %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_projekts_title"), description: t(".no_projekts_description"), icon: "folder_open") %>
  <% end %>
</div>
