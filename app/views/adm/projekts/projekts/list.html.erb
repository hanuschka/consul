<%= content_for :title, t("adm.projekts.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.projekts.home.title")) %>

<div class="kern-container my-5">
  <%= turbo_frame_tag "projekts_table" do %>
    <% if @projekts.any? %>
      <div class="kern-table-responsive" tabindex="0">
        <table class="kern-table">
          <thead class="kern-table__head">
            <tr class="kern-table__row">
              <%= render Kern::Table::HeaderComponent.new(:name, Projekt.model_name.human, **@name_header_options) %>
              <%= render Kern::Table::HeaderComponent.new(:total_duration_start, Projekt.human_attribute_name("total_duration_start"), **@start_date_header_options) %>
              <%= render Kern::Table::HeaderComponent.new(:total_duration_end, Projekt.human_attribute_name("total_duration_end"), **@end_date_header_options) %>
              <th scope="col" class="kern-table__header"><%= t("adm.projekts.projekts.index.table.status") %></th>
              <th scope="col" class="kern-table__header"><%= t("adm.projekts.projekts.index.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="kern-table__body">
            <% @projekts.each do |projekt| %>
              <%= render "adm/projekts/projekts/projekt", projekt: projekt %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="my-5">
        <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
      </div>
    <% else %>
      <%= empty_state(title: t("adm.projekts.projekts.index.no_projekts_title"), description: t("adm.projekts.projekts.index.no_projekts_description"), icon: "folder_open") %>
    <% end %>
  <% end %>
</div>
