<%= content_for :title, [@projekt.page.title, t("adm.projekts.projekts.index.title")].join(" | ") %>

<% if @projekt.map_location.rendering_library == "virtualcity" %>
  <% provide :vc_maps do %>
    <script id="vcmap-core" type="module" src="/vcmap/vcmap-core.js"></script>
  <% end %>
<% end %>

<%= render Adm::HeaderComponent.new(title: @projekt.page.title, breadcrumbs: @breadcrumbs, frontend_url: projekt_path(@projekt)) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t("adm.projekts.projekts.map.hint_text") %></p>
  <% end %>
<% end %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container mb-5">
  <%= render Adm::MapSettingComponent.new(
    map_location: @projekt.map_location,
    path: adm_projekts_projekt_map_location_path(@projekt)
  ) %>

  <%= render Adm::MapLayersComponent.new(map_layers: @projekt.map_layers, mappable: @projekt) %>
</div>
