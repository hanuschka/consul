<%= content_for :title, [(@projekt.page&.title || @projekt.name), t("adm.projekts.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: (@projekt.page&.title || @projekt.name), breadcrumbs: @breadcrumbs, frontend_url: projekt_path(@projekt), compact: true) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t("adm.projekts.projekts.projekt_managers.hint_text") %></p>
  <% end %>
<% end %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container mb-5">
  <% if @projekt_manager_assignments.any? %>
    <% @projekt_manager_assignments.each do |assignment| %>
      <%= render 'adm/projekts/projekts/projekt_managers/assignment', projekt: @projekt, assignment: assignment %>
    <% end %>
  <% else %>
    <%= empty_state(title: t('.no_managers_title'), description: t('.no_managers_description'), icon: "supervisor_account", link_url: new_adm_projekts_manager_path, link_text: t('.no_managers_link')) %>
  <% end %>
</div>
