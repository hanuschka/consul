<%= content_for :title, [
  (@projekt.page&.title || @projekt.name),
  t("adm.projekts.projekts.evaluation.report_summary_card.title")
].join(" | ") %>

<%= render Adm::HeaderComponent.new(
  title: (@projekt.page&.title || @projekt.name),
  breadcrumbs: @breadcrumbs,
  frontend_url: projekt_path(@projekt),
  compact: true
) %>

<div class="kern-container mb-5">
  <div class="adm-projekt-evaluation-report">
    <%= render "adm/projekts/projekts/evaluation/report_summary_section",
      evaluation: @evaluation,
      projekt: @projekt,
      phase_palette: evaluation_phase_palette,
      pdf_mode: false %>
  </div>
</div>
