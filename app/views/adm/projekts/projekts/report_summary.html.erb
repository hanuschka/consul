<%= content_for :title, t("adm.projekts.projekts.evaluation.report_summary_card.page_title") %>

<%= render Adm::HeaderComponent.new(
  title: t("adm.projekts.projekts.evaluation.report_summary_card.page_title"),
  breadcrumbs: @breadcrumbs,
  back_button_url: evaluation_adm_projekts_projekt_path(@projekt),
  frontend_url: projekt_path(@projekt),
  compact: true
) %>

<div class="kern-container mb-5">
  <div class="adm-projekt-evaluation-report">
    <%= render "adm/projekts/projekts/evaluation/report_summary_section",
      evaluation: @evaluation,
      projekt: @projekt,
      phase_palette: evaluation_phase_palette,
      pdf_mode: false %>
  </div>
</div>
