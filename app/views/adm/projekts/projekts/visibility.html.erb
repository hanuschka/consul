<%= content_for :title, [(@projekt.page&.title || @projekt.name), t("adm.projekts.projekts.index.title")].join(" | ") %>

<%= render Adm::HeaderComponent.new(title: (@projekt.page&.title || @projekt.name), breadcrumbs: @breadcrumbs, frontend_url: projekt_path(@projekt), compact: true) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t("adm.projekts.projekts.visibility.hint_text") %></p>
  <% end %>
<% end %>

<%= render Adm::Projekts::ProjektTabsComponent.new(projekt: @projekt) %>

<div class="kern-container mb-5">
  <fieldset <%= "disabled" unless policy([:adm, :projekts, @projekt]).update? %> style="border:0; padding:0; margin:0;">
    <%# A promoted setting writes its projekt column directly; the rest write
        their projekt_settings row. Flipping Projekt::USE_SETTING_COLUMNS to
        false moves the promoted ones back to their rows too. %>
    <% Adm::Projekts::ProjektsController::VISIBILITY_SETTINGS.each do |attribute| %>
      <% key = "projekt_feature.general.#{attribute}" %>
      <% if Projekt.setting_read_from_column?(key) %>
        <%= render Adm::AttributeEditorComponent.new(@projekt, attribute, :boolean) %>
      <% else %>
        <%= render Adm::AttributeEditorComponent.new(@projekt.projekt_settings.find_by!(key: key), :value, :boolean) %>
      <% end %>
    <% end %>

    <% if @individual_groups.any? %>
      <%= render Kern::FormFieldComponent.new(label: t('.individual_groups_label'), hint: t('.individual_groups_description')) do %>
        <%= render 'adm/projekts/projekts/visibility/individual_groups', projekt: @projekt %>
      <% end %>
    <% end %>
  </fieldset>
</div>
