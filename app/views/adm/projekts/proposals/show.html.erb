<%= content_for :title, @proposal.title %>

<%= render Adm::HeaderComponent.new(title: @proposal.title, breadcrumbs: @breadcrumbs, back_button_url: proposals_adm_projekts_phase_path(@projekt_phase)) %>

<%= render Adm::TabsComponent.new(tabs: projekt_phase_tabs(@projekt_phase, current_action: "proposals")) %>

<% may_administer = policy([:adm, @proposal]).update? %>

<div class="kern-container mb-5">

  <%= render "adm/projekts/proposals/action_row", proposal: @proposal, projekt_phase: @projekt_phase %>

  <%# === Section 1: Interne Notizen === %>
  <section class="adm-detail-section">
    <%= render "adm/memos/memos", memoable: @proposal %>
  </section>

  <%# === Section 2: Vorschlag === %>
  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t("adm.projekts.proposals.show.section_content") %></h2>

    <div class="adm-content-card mb-4">
      <div class="adm-content-card__body">
        <h3 class="adm-detail-content-title mb-2"><%= @proposal.title %></h3>
        <div class="adm-detail-description">
          <%= auto_link_already_sanitized_html wysiwyg(@proposal.description) %>
        </div>
      </div>
    </div>

    <% has_image = @image_url.present? %>
    <% has_map = @proposal.map_location.present? %>

    <% if has_image || has_map %>
      <div class="adm-detail-media-grid <%= (has_image && has_map) ? "adm-detail-media-grid--two adm-detail-media-grid--no-stretch" : "" %> mb-4">
        <% if has_image %>
          <div class="adm-detail-media-card adm-detail-media-card--bounded-image">
            <div class="adm-detail-media-card__label">
              <span class="material-symbols-outlined" aria-hidden="true">image</span>
              <%= t("adm.projekts.proposals.show.image_label") %>
            </div>
            <%= render Shared::ImageWithLightboxComponent.new(
              image_url: url_for(@image_url),
              original_url: url_for(@proposal.image.attachment),
              alt: @proposal.title,
              gallery: "proposal-#{@proposal.id}"
            ) %>
          </div>
        <% end %>

        <% if has_map %>
          <div class="adm-detail-media-card">
            <div class="adm-detail-media-card__label">
              <span class="material-symbols-outlined" aria-hidden="true">map</span>
              <%= t("adm.projekts.proposals.show.map_label") %>
            </div>
            <% pin = @proposal.map_location.pin_coordinates %>
            <%= render Kern::MapComponent.new(
              map_location: @proposal.map_location,
              gesture_handling: false,
              height: 400,
              latitude: pin&.dig(:latitude),
              longitude: pin&.dig(:longitude),
              zoom: pin ? 18 : nil
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%
      additional_rows = []

      additional_rows << { label: t("adm.projekts.proposals.show.author"), value: @proposal.author.username }

      if @proposal.on_behalf_of.present?
        additional_rows << { label: t("adm.projekts.proposals.show.on_behalf_of_label"), value: @proposal.on_behalf_of }
      end

      additional_rows << { label: t("adm.projekts.proposals.show.created_at"), value: l(@proposal.created_at, format: :long) }

      if @proposal.video_url.present?
        additional_rows << {
          label: t("adm.projekts.proposals.show.video_url"),
          value: link_to(@proposal.video_url, @proposal.video_url, target: "_blank", rel: "noopener")
        }
      end

      additional_rows << { label: t("adm.projekts.proposals.show.votes"), value: @proposal.cached_votes_up }

      if @proposal.cached_votes_down > 0
        additional_rows << { label: t("adm.projekts.proposals.show.votes_down"), value: @proposal.cached_votes_down }
      end

      additional_rows << { label: t("adm.projekts.proposals.show.comments"), value: @proposal.comments_count }
    %>

    <div class="adm-detail-table">
      <% additional_rows.each do |row| %>
        <div class="adm-detail-table__row">
          <div class="adm-detail-table__label"><%= row[:label] %></div>
          <div class="adm-detail-table__value"><%= row[:value] %></div>
        </div>
      <% end %>
    </div>
  </section>

  <%# === Section 3: Ähnliche Beiträge === %>
  <div class="adm-detail-section">
    <%= render ::SimilarContributions::ListComponent.new(@similar_contributions, resource: @proposal) %>
  </div>

  <%# === Section 4: Verwaltung === %>
  <%# The toggle only appears where the phase actually requires acceptance — elsewhere the flag has
      no public effect, so flipping it would promise a visibility change that never happens. %>
  <section class="adm-detail-section">
    <h2 class="adm-detail-section-title mb-3"><%= t("adm.projekts.proposals.show.section_admin") %></h2>

    <%= render Kern::FormFieldComponent.new(
          label: t("adm.projekts.proposals.show.admin_accepted_status"),
          hint: t("adm.projekts.proposals.show.admin_accepted_status_hint"),
          divider: false
        ) do %>
      <div id="<%= dom_id(@proposal, :admin_accepted) %>">
        <% if @projekt_phase.feature?("general.require_admin_acceptance") && policy([:adm, @proposal]).toggle_admin_accepted? %>
          <%= render Adm::AttributeEditors::BooleanComponent.new(
            @proposal,
            :admin_accepted,
            path: toggle_admin_accepted_adm_projekts_phase_proposal_path(@projekt_phase, @proposal),
            aria_label: t("adm.projekts.proposals.show.admin_accepted_status")
          ) %>
        <% else %>
          <span class="adm-detail-pill">
            <%= @proposal.admin_accepted? ? t("adm.projekts.proposals.show.accepted") : t("adm.projekts.proposals.show.not_accepted") %>
          </span>
        <% end %>
      </div>
    <% end %>
  </section>

  <%# === Section 5: Offizielle Antwort === %>
  <section class="adm-detail-section">
    <% if may_administer %>
      <%= render Adm::AttributeEditorComponent.new(
        @proposal,
        :official_answer,
        :rich_text,
        path: update_official_answer_adm_projekts_phase_proposal_path(@projekt_phase, @proposal),
        label: t("adm.projekts.proposals.show.official_answer"),
        description: t("adm.projekts.proposals.show.official_answer_hint")
      ) %>
    <% else %>
      <h2 class="adm-detail-section-title mb-3"><%= t("adm.projekts.proposals.show.official_answer") %></h2>

      <div class="adm-detail-description">
        <%= auto_link_already_sanitized_html wysiwyg(@proposal.official_answer) %>
      </div>
    <% end %>
  </section>

</div>
