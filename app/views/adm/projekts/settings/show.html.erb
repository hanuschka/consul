<%= content_for :title, t("adm.projekts.menu.items.settings") %>

<%= render Adm::HeaderComponent.new(title: t("adm.projekts.menu.items.settings"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: [
  {
    label: t("adm.projekts.settings.tabs.dashboard"),
    url: adm_projekts_settings_path,
    current: true
  },
  {
    label: t("adm.projekts.settings.tabs.contact_persons"),
    url: contact_persons_adm_projekts_settings_path
  }
]) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.projekts.intro_text"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.projekts.notice_message"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.projekts.notice_active"), :value, :boolean) %>
</div>
