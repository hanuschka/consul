<label class="rg-filter-card__param-label">
  <%= t("adm.recipient_groups.filters.params_labels.age_range_id") %>
  <%= select_tag "recipient_group_filter[params][age_range_id]",
        options_for_select(
          AgeRange.all.map { |ar| [ar.try(:name) || "#{ar.min_age}–#{ar.max_age}", ar.id] },
          filter_params["age_range_id"]
        ),
        include_blank: true,
        data: { action: "change->adm-newsletters--filter-stack#recount" } %>
</label>

<label class="rg-filter-card__param-label">
  <%= t("adm.recipient_groups.filters.params_labels.min_age") %>
  <%= number_field_tag "recipient_group_filter[params][min_age]",
        filter_params["min_age"],
        min: 0, max: 120,
        data: { action: "change->adm-newsletters--filter-stack#recount" } %>
</label>

<label class="rg-filter-card__param-label">
  <%= t("adm.recipient_groups.filters.params_labels.max_age") %>
  <%= number_field_tag "recipient_group_filter[params][max_age]",
        filter_params["max_age"],
        min: 0, max: 120,
        data: { action: "change->adm-newsletters--filter-stack#recount" } %>
</label>
