<div class="kern-form-check">
  <%= check_box_tag "recipient_group_filter[params][include_unregistered]",
        "1",
        ActiveModel::Type::Boolean.new.cast(filter_params["include_unregistered"]),
        id: "filter_#{filter.id}_include_unregistered",
        class: "kern-form-check__checkbox",
        data: { action: "change->adm-newsletters--filter-stack#updateFilter" } %>
  <%= label_tag "filter_#{filter.id}_include_unregistered",
        t("adm.recipient_groups.filters.params_labels.include_unregistered"),
        class: "kern-form-check__label" %>
</div>
