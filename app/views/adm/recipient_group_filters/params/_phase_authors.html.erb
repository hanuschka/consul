<label class="rg-filter-card__param-label">
  <%= t("adm.recipient_groups.filters.params_labels.projekt_phase_id") %>
  <%= select_tag "recipient_group_filter[params][projekt_phase_id]",
        options_for_select(
          ProjektPhase.includes(:projekt).order("projekts.name").map { |pp|
            ["#{pp.projekt&.name} – #{pp.title || pp.type}", pp.id]
          },
          filter_params["projekt_phase_id"]
        ),
        include_blank: true,
        data: { action: "change->adm-newsletters--filter-stack#recount" } %>
</label>

<label class="rg-filter-card__param-label">
  <%= t("adm.recipient_groups.filters.params_labels.criterion") %>
  <%= text_field_tag "recipient_group_filter[params][criterion]",
        filter_params["criterion"],
        placeholder: "all / feasible / unfeasible / selected / winners / not_winners",
        data: { action: "change->adm-newsletters--filter-stack#recount" } %>
</label>
