<div data-step>
  <%= form_with url: select_options_adm_recipient_groups_path, data: { turbo_stream: true } do %>
    <%= render Kern::FormFieldComponent.new(label: t("adm.recipient_groups.new.#{label_key}"), divider: false, inline: true) do %>
      <div class="kern-form-input">
        <%= select_tag :kind, options_for_select(options_for_kind), include_blank: true,
          class: "kern-form-input__input",
          data: { action: "change->adm-newsletters--recipient-group-builder#select" } %>
      </div>
    <% end %>
  <% end %>
</div>
