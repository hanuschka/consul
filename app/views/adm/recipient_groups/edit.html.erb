<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, narrow: true) %>

<div class="kern-container my-5">
  <%= form_with model: [:adm, @recipient_group] do |f| %>

    <%= render Kern::FormFieldComponent.new(label: RecipientGroup.human_attribute_name(:name)) do %>
      <%= f.text_field :name, label: false %>
    <% end %>

    <%= form_submit_button(text: t("adm.recipient_groups.edit.submit")) %>
  <% end %>
</div>
