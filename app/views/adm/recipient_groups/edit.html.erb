<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, back_button_url: adm_recipient_groups_path, narrow: true) %>

<div class="kern-container my-5"
     data-controller="adm-newsletters--filter-stack"
     data-adm-newsletters--filter-stack-recount-url-value="<%= recount_adm_recipient_group_filters_path(@recipient_group) %>"
     data-adm-newsletters--filter-stack-reorder-url-value="<%= reorder_adm_recipient_group_filters_path(@recipient_group) %>">

  <%= form_with model: [:adm, @recipient_group] do |f| %>
    <%= render Kern::FormFieldComponent.new(label: RecipientGroup.human_attribute_name(:name), hint: t(".name_hint")) do %>
      <%= f.text_field :name, label: false %>
    <% end %>

    <%= form_submit_button(text: t("adm.recipient_groups.edit.submit")) %>
  <% end %>

  <h3 class="mt-5"><%= t("adm.recipient_groups.filters.section_title") %></h3>

  <ul id="filter-stack"
      class="list-unstyled"
      data-adm-newsletters--filter-stack-target="list">
    <% if @recipient_group.filters.any? %>
      <% @recipient_group.filters.each_with_index do |filter, idx| %>
        <li>
          <%= render Adm::RecipientGroupFilterCardComponent.new(
                filter: filter,
                display_position: idx + 1,
                count: @counts[idx][:count],
                delta: @counts[idx][:delta]) %>
        </li>
      <% end %>
    <% else %>
      <li id="filter-stack-empty" class="rg-filter-empty"><%= t("adm.recipient_groups.filters.empty") %></li>
    <% end %>
  </ul>

  <%= form_with url: adm_recipient_group_filters_path(@recipient_group),
                data: { turbo_stream: true },
                class: "mt-3" do |f| %>
    <%= hidden_field_tag "recipient_group_filter[kind]", "newsletter_subscribers" %>
    <%= hidden_field_tag "recipient_group_filter[operator]",
          @recipient_group.filters.any? ? "intersect" : "include" %>
    <%= kern_button(text: t("adm.recipient_groups.filters.add_filter"),
                    icon: "add",
                    type: :submit,
                    style: :secondary) %>
  <% end %>

  <div id="filter-stack-footer" class="mt-4">
    <%= render "footer", recipient_group: @recipient_group %>
  </div>
</div>
