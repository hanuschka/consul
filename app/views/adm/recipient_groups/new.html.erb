<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs, narrow: true) %>

<div class="kern-container my-5">
  <div id="recipient-group-builder" data-controller="adm-newsletters--recipient-group-builder">
    <%= render "options_for_kind",
      options_for_kind: RecipientGroup.base_options_for_kind.map { |k| [t("adm.recipient_groups.new.base_options_for_kind.#{k}"), k] },
      label_key: "label_for_general" %>
  </div>
</div>
