<% if @available_options_for_kind.present? %>
  <%= turbo_stream.append "recipient-group-builder" do %>
    <%= render partial: "options_for_kind", locals: { options_for_kind: @available_options_for_kind, label_key: @label_key } %>
  <% end %>
<% elsif @available_access_methods.present? %>
  <%= turbo_stream.append "recipient-group-builder" do %>
    <%= render partial: "access_methods", locals: {
      options_for_access_methods: @available_access_methods,
      origin_class_name: @origin_class_name,
      origin_class_object_id: @origin_class_object_id
    } %>
  <% end %>
<% end %>
