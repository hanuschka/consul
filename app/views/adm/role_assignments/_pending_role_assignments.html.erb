<div id="pending_role_assignments_section">
  <% if pending_role_assignments.any? %>
    <h2 class="kern-title kern-title--small mb-3 mt-5"><%= t("adm.pending_role_assignments.title") %></h2>

    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t("adm.pending_role_assignments.email") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.pending_role_assignments.created_at") %></th>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>
        <tbody class="kern-table__body">
          <% pending_role_assignments.each do |pending| %>
            <%= render partial: "adm/role_assignments/pending_role_assignment", locals: { pending: pending } %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
