<% if users.any? %>
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= User.human_attribute_name(:name) %></th>
          <th scope="col" class="kern-table__header"><%= User.human_attribute_name(:email) %></th>
          <th scope="col" class="kern-table__header"><%= t('shared.table.actions') %></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <%= render partial: 'adm/role_assignments/user', collection: users %>
      </tbody>
    </table>
  </div>
<% else %>
  <p><%= t('.no_results') %></p>
<% end %>

<% if local_assigns[:pending_role_email].present? %>
  <div class="kern-alert kern-alert--warning mt-3" role="alert">
    <div class="kern-alert__header">
      <span class="kern-icon kern-icon--info" aria-hidden="true"></span>
      <% if pending_already_exists %>
        <span class="kern-title"><%= t("adm.pending_role_assignments.already_pending", email: pending_role_email) %></span>
      <% else %>
        <span class="kern-title"><%= t("adm.pending_role_assignments.offer_preassign", email: pending_role_email) %></span>
      <% end %>
    </div>
    <% unless pending_already_exists %>
      <div class="kern-alert__body mt-3">
        <%= button_to create_pending_adm_role_assignment_path(email: pending_role_email, role: role),
              class: "kern-btn kern-btn--primary", method: :post do %>
          <span class="kern-label"><%= t("adm.pending_role_assignments.preassign_button") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
