<% if users.any? %>
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= User.human_attribute_name(:name) %></th>
          <th scope="col" class="kern-table__header"><%= User.human_attribute_name(:email) %></th>
          <th scope="col" class="kern-table__header"><%= t('shared.table.actions') %></th>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <%= render partial: 'adm/role_assignments/user', collection: users %>
      </tbody>
    </table>
  </div>
<% else %>
  <% if local_assigns[:pending_role_email].present? %>
    <% if pending_already_exists %>
      <%= empty_state(title: t("adm.pending_role_assignments.already_pending", email: pending_role_email), icon: "person_search") %>
    <% else %>
      <div class="adm-empty-state">
        <div class="adm-empty-state__icon-wrap">
          <span class="adm-empty-state__icon material-symbols-outlined" aria-hidden="true">person_search</span>
        </div>
        <p class="adm-empty-state__title"><%= t("adm.pending_role_assignments.offer_preassign", email: pending_role_email) %></p>
        <%= button_to create_pending_adm_role_assignment_path(email: pending_role_email, role: role),
              class: "kern-btn kern-btn--primary mt-3", method: :post, data: { turbo_frame: "_top" } do %>
          <span class="kern-label"><%= t("adm.pending_role_assignments.preassign_button.#{role}") %></span>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= empty_state(title: t('.no_results'), icon: "person_search") %>
  <% end %>
<% end %>
