<%= form_with model: [:adm, @section_contact_person] do |f| %>
  <%= render Kern::FormFieldComponent.new(label: SectionContactPerson.human_attribute_name(:user), hint: t(".hints.user"), stacked: true) do %>
    <div data-controller="adm-user-select" data-adm-user-select-url-value="<%= search_adm_section_contact_people_path %>">
      <%= f.hidden_field :user_id, data: { adm_user_select_target: "hiddenField" } %>

      <div data-adm-user-select-target="searchArea" class="<%= 'd-none' if @section_contact_person.user_id.present? %>">
        <div class="d-flex gap-2">
          <div class="kern-form-input" style="flex: 1;">
            <input type="text" class="kern-form-input__input"
              placeholder="<%= t('.search_user_placeholder') %>"
              data-adm-user-select-target="input"
              data-action="input->adm-user-select#search">
          </div>
        </div>
        <div id="search_results" data-adm-user-select-target="results" class="mt-2"></div>
      </div>

      <div data-adm-user-select-target="selectedDisplay" class="<%= 'd-none' unless @section_contact_person.user_id.present? %>">
        <% if @section_contact_person.user.present? %>
          <div class="kern-card kern-card--compact p-3 d-flex justify-content-between align-items-center">
            <span><%= @section_contact_person.user.name %> (<%= @section_contact_person.user.email %>)</span>
            <button type="button" class="kern-btn kern-btn--small kern-btn--secondary"
              data-action="click->adm-user-select#clearSelection">
              <span class="material-symbols-outlined kern-btn__icon" aria-hidden="true">close</span>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: SectionContactPerson.human_attribute_name(:section), hint: t(".hints.section")) do %>
    <%= f.select :section,
      SectionContactPerson::SECTIONS.map { |s| [t("adm.section_contact_people.index.sections.#{s}"), s] },
      { include_blank: t(".select_section") },
      { label: false, class: "kern-form-select__select" } %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: SectionContactPerson.human_attribute_name(:role), hint: t(".hints.role")) do %>
    <%= f.text_field :role, label: false, placeholder: SectionContactPerson.human_attribute_name(:role) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: SectionContactPerson.human_attribute_name(:email), hint: t(".hints.email")) do %>
    <%= f.email_field :email, label: false, placeholder: SectionContactPerson.human_attribute_name(:email) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: SectionContactPerson.human_attribute_name(:phone), hint: t(".hints.phone")) do %>
    <%= f.text_field :phone, label: false, placeholder: SectionContactPerson.human_attribute_name(:phone) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: SectionContactPerson.human_attribute_name(:position), hint: t(".hints.position")) do %>
    <%= f.number_field :position, label: false, placeholder: SectionContactPerson.human_attribute_name(:position) %>
  <% end %>

  <%= form_submit_button(text: f.object.new_record? ? t("shared.create") : t(".submit")) %>
<% end %>
