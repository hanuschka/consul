<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::TabsComponent.new(tabs: [
  { label: t(".filters.all"), url: adm_section_contact_people_path, current: @current_section_filter.blank? }
] + SectionContactPerson::SECTIONS.map { |section|
  { label: t(".sections.#{section}"), url: adm_section_contact_people_path(section: section), current: @current_section_filter == section }
}) %>

<div class="kern-container">
  <%= new_resource_link(new_adm_section_contact_person_path, t('.new_link')) %>

  <% if @section_contact_people.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t('.table.name') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.section') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.role') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.email') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.phone') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @section_contact_people.each do |contact_person| %>
            <tr id="<%= dom_id(contact_person) %>" class="kern-table__row">
              <td scope="row" class="kern-table__header"><%= contact_person.name %></td>
              <td class="kern-table__cell"><%= t(".sections.#{contact_person.section}") %></td>
              <td class="kern-table__cell"><%= contact_person.role %></td>
              <td class="kern-table__cell"><%= contact_person.email %></td>
              <td class="kern-table__cell"><%= contact_person.phone %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t('.table.edit'), url: edit_adm_section_contact_person_path(contact_person), icon: "edit", style: :edit) %>
                  <% actions.with_action(
                    label: t('.table.delete'),
                    url: adm_section_contact_person_path(contact_person),
                    icon: "delete", style: :delete,
                    data: { turbo_method: :delete, turbo_confirm: t('.table.delete_confirm') }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(
      title: t(".empty_title"),
      description: t(".empty_description"),
      icon: "contact_phone",
      link_url: new_adm_section_contact_person_path,
      link_text: t('.new_link')
    ) %>
  <% end %>
</div>
