<%= turbo_stream.update "search_results" do %>
  <div class="mt-2">
    <% @users.each do |user| %>
      <div class="d-flex justify-content-between align-items-center p-3 mb-1" style="background: #f8fafc; border-radius: 6px;">
        <span><strong><%= user.name %></strong> (<%= user.email %>)</span>
        <button type="button" class="kern-btn kern-btn--small kern-btn--primary"
          data-action="click->adm-user-select#selectUser"
          data-user-id="<%= user.id %>"
          data-user-name="<%= user.name %>"
          data-user-email="<%= user.email %>">
          <%= t(".select") %>
        </button>
      </div>
    <% end %>
    <% if @users.empty? && params[:search].to_s.length >= 2 %>
      <p class="kern-body mt-2"><%= t(".no_results") %></p>
    <% end %>
  </div>
<% end %>
