<%= content_for :title, t("adm.settings.gdpr.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.settings.gdpr.title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_feature.gdpr.gdpr_conformity"), :value, kind: :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_feature.gdpr.link_out_warning"), :value, kind: :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_feature.gdpr.two_click_iframe_solution"), :value, kind: :boolean) %>

  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_option.gdpr.devise_timeout_min"), :value, kind: :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extended_option.gdpr.devise_verification_token_validity_days"), :value, kind: :string) %>
</div>
