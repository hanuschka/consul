<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro_text_p1") %></p>
    <p class="adm-hint__text adm-hint__text--spaced"><%= t(".intro_text_p2") %></p>
  <% end %>
<% end %>

<div class="kern-container">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "org_name"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "url"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "mailer_from_address"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "mailer_from_name"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "meta_title"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "meta_description"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "meta_keywords"), :value, :string) %>

  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "facebook_handle"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "instagram_handle"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "twitter_handle"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "twitter_hashtag"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "telegram_handle"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "youtube_handle"), :value, :string) %>

  <div class="kern-row mt-4">
    <div class="kern-col-12 kern-col-md-10">
      <h2 class="kern-heading-small mb-2"><%= t(".uploads_title") %></h2>
      <p class="kern-body mb-4"><%= t(".uploads_intro") %></p>
    </div>
  </div>

  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "uploads.images.max_size"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "uploads.images.content_types"), :value, :content_types) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "uploads.images.title.min_length"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "uploads.images.title.max_length"), :value, :string) %>

  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "uploads.documents.max_amount"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "uploads.documents.max_size"), :value, :string) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "uploads.documents.content_types"), :value, :content_types) %>
</div>
