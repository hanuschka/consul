<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extra_fields.registration.extended"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extra_fields.registration.check_documents"), :value, :boolean) %>

  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extra_fields.verification.check_documents"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extra_fields.verification.show_data_completeness_status"), :value, :boolean) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "extra_fields.verification.show_verification_status"), :value, :boolean) %>
</div>
