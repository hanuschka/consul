<% auditable = local_assigns[:auditable] %>
<% audit_show_path = local_assigns[:audit_show_path] %>

<h3 class="fs-4 strong mb-4"><%= t("adm.shared.audits.title") %></h3>

<% if auditable.own_and_associated_audits.empty? %>
  <p><%= t("adm.shared.audits.empty") %></p>
<% else %>
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t("adm.shared.audits.table.id") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.shared.audits.table.field") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.shared.audits.table.old_value") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.shared.audits.table.new_value") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.shared.audits.table.edited_at") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.shared.audits.table.edited_by") %></th>
          <% if audit_show_path %>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="kern-table__body">
        <% auditable.own_and_associated_audits.order(:created_at).each do |audit| %>
          <% audit.audited_changes.each do |field, value| %>
            <% if value.is_a?(Array) || audit.action == "destroy" %>
              <% old_value, new_value = value %>
            <% else %>
              <% old_value, new_value = [nil, value] %>
            <% end %>

            <tr class="kern-table__row">
              <th scope="row" class="kern-table__header"><%= audit.id %></th>
              <td class="kern-table__cell"><%= sanitize(auditable.class.human_attribute_name(field)) %></td>
              <td class="kern-table__cell">
                <div class="audit-value"><%= truncate_audit_value(auditable, field, old_value) %></div>
              </td>
              <td class="kern-table__cell">
                <div class="audit-value"><%= truncate_audit_value(auditable, field, new_value) %></div>
              </td>
              <td class="kern-table__cell"><%= l audit.created_at.to_date %></td>
              <td class="kern-table__cell"><%= audit.user&.name %></td>
              <% if audit_show_path %>
                <td class="kern-table__cell">
                  <%= render Kern::Table::ActionsComponent.new do |actions| %>
                    <% actions.with_action(label: t("shared.show"), url: audit_show_path.call(audit)) %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
