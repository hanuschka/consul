<div class="d-flex justify-content-start gap-2 mb-4">
  <%= kern_link_button new_url, text: t("adm.projekts.phases.milestones.create_button"), style: :secondary %>
</div>

<% if milestones.any? %>
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.milestones.table.description") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.milestones.table.publication_date") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.milestones.table.status") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.milestones.table.image") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.milestones.table.actions") %></th>
        </tr>
      </thead>

      <tbody class="kern-table__body">
        <% milestones.each do |milestone| %>
          <tr id="<%= dom_id(milestone) %>" class="kern-table__row">
            <td class="kern-table__cell"><%= truncate(strip_tags(milestone.description), length: 80) %></td>
            <td class="kern-table__cell">
              <% if milestone.custom_date.present? %>
                <%= milestone.custom_date %>
              <% elsif milestone.publication_date.present? %>
                <%= l(milestone.publication_date) %>
              <% end %>
            </td>
            <td class="kern-table__cell"><%= milestone.status&.name %></td>
            <td class="kern-table__cell">
              <% if milestone.image&.attached? %>
                <%= link_to t("adm.projekts.phases.milestones.table.show_image"), milestone.image.variant(:large), target: :_blank %>
              <% end %>
            </td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(label: t("shared.edit"), url: edit_url.call(milestone)) %>
                <% actions.with_action(label: t("shared.delete"), url: delete_url.call(milestone), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= empty_state(title: t("adm.projekts.phases.milestones.no_milestones_title"), description: t("adm.projekts.phases.milestones.no_milestones_description"), icon: "flag") %>
<% end %>
