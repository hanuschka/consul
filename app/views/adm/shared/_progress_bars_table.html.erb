<div class="d-flex justify-content-start gap-2 mb-4">
  <%= kern_link_button new_url, text: t("adm.projekts.phases.progress_bars.create_button"), style: :secondary %>
</div>

<% if progress_bars.any? %>
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table">
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.progress_bars.table.title") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.progress_bars.table.kind") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.progress_bars.table.percentage") %></th>
          <th scope="col" class="kern-table__header"><%= t("adm.projekts.phases.progress_bars.table.actions") %></th>
        </tr>
      </thead>

      <tbody class="kern-table__body">
        <% progress_bars.each do |progress_bar| %>
          <tr id="<%= dom_id(progress_bar) %>" class="kern-table__row">
            <td class="kern-table__cell"><%= progress_bar.title %></td>
            <td class="kern-table__cell"><%= t("adm.projekts.phases.progress_bars.table.#{progress_bar.kind}") %></td>
            <td class="kern-table__cell"><%= progress_bar.percentage %>%</td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new do |actions| %>
                <% actions.with_action(label: t("shared.edit"), url: edit_url.call(progress_bar)) %>
                <% actions.with_action(label: t("shared.delete"), url: delete_url.call(progress_bar), data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= empty_state(title: t("adm.projekts.phases.progress_bars.no_progress_bars_title"), description: t("adm.projekts.phases.progress_bars.no_progress_bars_description"), icon: "trending_up") %>
<% end %>
