<%= content_for :title, t("adm.statistics.show.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.statistics.show.title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container" data-controller="adm-charts">

  <%# ── Nutzer ──────────────────────────────────────────── %>
  <div class="adm-dashboard__section">
    <div class="adm-dashboard__section-header">
      <span class="material-symbols-outlined" aria-hidden="true">group</span>
      <h3>Nutzer</h3>
    </div>
    <div class="adm-dashboard__stats">

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">group</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Registrierte, aktive Nutzerkonten. Gelöschte und deaktivierte Konten sind nicht enthalten.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_total) %>
        <div class="adm-stat-card__label">Gesamt (aktiv)</div>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">person_add</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Neu registrierte Nutzer in den letzten 7 Tagen. Der Trend zeigt den Vergleich mit der vorherigen 7-Tage-Periode.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_new_week) %>
        <div class="adm-stat-card__label">Neu diese Woche</div>
        <% if @trend_users_week %>
          <% t = @trend_users_week %>
          <div class="adm-stat-card__meta">
            <span class="adm-stat-card__trend adm-stat-card__trend--<%= t[:delta] > 0 ? 'up' : t[:delta] < 0 ? 'down' : 'neutral' %>">
              <%= t[:delta] > 0 ? "▲ +#{t[:delta]}" : t[:delta] < 0 ? "▼ #{t[:delta]}" : "= 0" %>
              <% if t[:pct] %> (<%= t[:pct] > 0 ? '+' : '' %><%= t[:pct] %> %)<% end %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">calendar_month</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Neu registrierte Nutzer in den letzten 30 Tagen. Der Trend zeigt den Vergleich mit den vorherigen 30 Tagen.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_new_month) %>
        <div class="adm-stat-card__label">Neu diesen Monat</div>
        <% if @trend_users_month %>
          <% t = @trend_users_month %>
          <div class="adm-stat-card__meta">
            <span class="adm-stat-card__trend adm-stat-card__trend--<%= t[:delta] > 0 ? 'up' : t[:delta] < 0 ? 'down' : 'neutral' %>">
              <%= t[:delta] > 0 ? "▲ +#{t[:delta]}" : t[:delta] < 0 ? "▼ #{t[:delta]}" : "= 0" %>
              <% if t[:pct] %> (<%= t[:pct] > 0 ? '+' : '' %><%= t[:pct] %> %)<% end %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">verified</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Nutzer mit bestätigter E-Mail-Adresse. Berechtigt zur Basisteilnahme.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_verified_l1) %>
        <div class="adm-stat-card__label">Registriert</div>
        <% if @users_verified_l1_pct %>
          <div class="adm-stat-card__meta">
            <span class="adm-stat-card__ratio"><%= @users_verified_l1_pct %> % aller Nutzer</span>
          </div>
        <% end %>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">shield_person</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Nutzer mit vollständiger Identitätsprüfung, z.B. über BundID oder BayernID. Berechtigt zur eingeschränkten Teilnahme.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_verified_l2) %>
        <div class="adm-stat-card__label">Verifiziert</div>
        <% if @users_verified_l2_pct %>
          <div class="adm-stat-card__meta">
            <span class="adm-stat-card__ratio"><%= @users_verified_l2_pct %> % aller Nutzer</span>
          </div>
        <% end %>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">person_off</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Temporäre Gastkonten ohne vollständige Registrierung. Diese Nutzer haben eingeschränkte Rechte.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_guest) %>
        <div class="adm-stat-card__label">Gastkonten</div>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">mail</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Aktive Nutzer, die dem Newsletter-Versand zugestimmt haben.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_newsletter) %>
        <div class="adm-stat-card__label">Newsletter-Abonnenten</div>
        <% if @users_newsletter_pct %>
          <div class="adm-stat-card__meta">
            <span class="adm-stat-card__ratio"><%= @users_newsletter_pct %> % aller Nutzer</span>
          </div>
        <% end %>
      </div>

      <div class="adm-stat-card adm-stat-card--warning">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">delete</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Nutzerkonten, die gelöscht wurden (durch den Nutzer selbst oder durch Admins). Persönliche Daten wurden anonymisiert.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@users_deleted) %>
        <div class="adm-stat-card__label">Gelöscht</div>
      </div>

    </div>
  </div>

  <%# ── Projekte ─────────────────────────────────────────── %>
  <div class="adm-dashboard__section">
    <div class="adm-dashboard__section-header">
      <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
      <h3>Projekte</h3>
    </div>
    <div class="adm-dashboard__stats">

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">folder</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Alle regulären Beteiligungsprojekte (ohne Systemprojekte und Unterprojekte).">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@projects_total) %>
        <div class="adm-stat-card__label">Gesamt</div>
      </div>

      <div class="adm-stat-card adm-stat-card--accent">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">folder_open</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Projekte mit aktuell laufendem Beteiligungszeitraum (Startdatum erreicht, Enddatum noch nicht überschritten).">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@projects_current) %>
        <div class="adm-stat-card__label">Aktiv</div>
        <% if @projects_active_pct %>
          <div class="adm-stat-card__meta">
            <span class="adm-stat-card__ratio"><%= @projects_active_pct %> % aller Projekte</span>
          </div>
        <% end %>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">folder_off</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Projekte, deren Beteiligungszeitraum abgelaufen ist. Sie sind nicht mehr aktiv.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@projects_expired) %>
        <div class="adm-stat-card__label">Abgelaufen</div>
      </div>

      <div class="adm-stat-card">
        <div class="adm-stat-card__header">
          <span class="material-symbols-outlined adm-stat-card__icon">notifications_active</span>
          <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                data-tiptext="Aktive Projektabonnements: Nutzer, die Benachrichtigungen für mindestens ein Projekt aktiviert haben.">
            <span class="material-symbols-outlined">info</span>
          </span>
        </div>
        <%= stat_value(@projects_subscriptions) %>
        <div class="adm-stat-card__label">Abonnements</div>
      </div>

    </div>
  </div>

  <%# ── Beteiligungsphasen ──────────────────────────────── %>
  <%
    phase_config = [
      { type: "ProjektPhase::CommentPhase",              icon: "comment",                  label: "Kommentarphase",     tip: "Wie oft die Kommentarphase eingesetzt wurde / eingegangene Kommentare.",         submission_count: @stat_comments,                submission_label: "Kommentare" },
      { type: "ProjektPhase::ProposalPhase",             icon: "lightbulb",                label: "Vorschlagsphase",    tip: "Wie oft die Vorschlagsphase eingesetzt wurde / eingegangene Vorschläge und Kommentare.", submission_count: @stat_proposals, submission_label: "Vorschläge", submission_count2: @stat_proposal_comments, submission_label2: "Kommentare" },
      { type: "ProjektPhase::QuestionPhase",             icon: "poll",                     label: "Kurzumfragen",       tip: "Wie oft Kurzumfragen eingesetzt wurden / eingegangene Antworten.",               submission_count: @stat_question_answers,         submission_label: "Antworten" },
      { type: "ProjektPhase::VotingPhase",               icon: "how_to_vote",              label: "Abstimmungen",       tip: "Wie oft Abstimmungsphasen eingesetzt wurden / abgegebene Stimmen.",              submission_count: @stat_poll_answers,            submission_label: "Stimmen" },
      { type: "ProjektPhase::BudgetPhase",               icon: "account_balance_wallet",   label: "Bürgerbudget",       tip: "Wie oft Bürgerbudgetphasen eingesetzt wurden / eingereichte Projektideen und Kommentare.", submission_count: @stat_budget_investments, submission_label: "Projektideen", submission_count2: @stat_budget_comments, submission_label2: "Kommentare" },
      { type: "ProjektPhase::FormularPhase",             icon: "assignment",               label: "Formulare",          tip: "Wie oft Formularphasen eingesetzt wurden / eingegangene Einreichungen.",          submission_count: @stat_formular_answers,        submission_label: "Einreichungen" },
      { type: "ProjektPhase::LegislationPhase",          icon: "gavel",                    label: "Kollaborative Texterstellung", tip: "Wie oft Gesetzgebungsphasen eingesetzt wurden / eingegangene Anmerkungen.",       submission_count: @stat_legislation_annotations, submission_label: "Anmerkungen" },
      { type: "ProjektPhase::ArgumentPhase",             icon: "forum",                    label: "Stimmen der Stadt",           tip: "Wie oft Argumentationsphasen eingesetzt wurden / enthaltene Argumente.",         submission_count: @stat_projekt_arguments,  submission_label: "Argumente" },
      { type: "ProjektPhase::PointOfInterestPhase",      icon: "location_on",              label: "Orte von Interesse",          tip: "Wie oft Kartenphasen eingesetzt wurden / eingetragene Orte.",                   submission_count: @stat_points_of_interest, submission_label: "Orte" },
      { type: "ProjektPhase::EventPhase",                icon: "event",                    label: "Veranstaltungen",             tip: "Wie oft Veranstaltungsphasen eingesetzt wurden / enthaltene Veranstaltungen.",  submission_count: @stat_projekt_events,     submission_label: "Veranstaltungen" },
      { type: "ProjektPhase::NewsfeedPhase",             icon: "newspaper",                label: "Newsfeed",                    tip: "Wie oft Newsfeed-Phasen in Projekten eingesetzt wurden." },
      { type: "ProjektPhase::MilestonePhase",            icon: "flag",                     label: "Meilensteine",                tip: "Wie oft Meilensteinphasen eingesetzt wurden / enthaltene Meilensteine.",         submission_count: @stat_milestones,         submission_label: "Meilensteine" },
      { type: "ProjektPhase::ProjektNotificationPhase",  icon: "notifications",            label: "Benachrichtigungen",          tip: "Wie oft Benachrichtigungsphasen in Projekten eingesetzt wurden." },
      { type: "ProjektPhase::LivestreamPhase",           icon: "live_tv",                  label: "Livestreams",                 tip: "Wie oft Livestream-Phasen eingesetzt wurden / enthaltene Livestreams.",          submission_count: @stat_livestreams,        submission_label: "Livestreams" },
      { type: "ProjektPhase::IframePhase",               icon: "web",                      label: "Iframe-Integration",          tip: "Wie oft Einbettungsphasen in Projekten eingesetzt wurden." },
    ]
  %>
  <div class="adm-dashboard__section">
    <div class="adm-dashboard__section-header">
      <span class="material-symbols-outlined" aria-hidden="true">how_to_vote</span>
      <h3>Beteiligungsphasen</h3>
    </div>
    <div class="adm-dashboard__stats">

      <% phase_config.each do |cfg| %>
        <% count  = @phase_counts[cfg[:type]] || 0 %>
        <% triple = cfg.key?(:submission_count2) %>
        <% split  = !triple && cfg.key?(:submission_count) %>
        <% card_class = triple ? "adm-stat-card adm-stat-card--triple" : split ? "adm-stat-card adm-stat-card--split" : "adm-stat-card" %>
        <div class="<%= card_class %>">
          <div class="adm-stat-card__header">
            <span class="material-symbols-outlined adm-stat-card__icon"><%= cfg[:icon] %></span>
            <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                  data-tiptext="<%= cfg[:tip] %>">
              <span class="material-symbols-outlined">info</span>
            </span>
          </div>
          <% if triple || split %>
            <div class="adm-stat-card__body">
              <div class="adm-stat-card__metric">
                <%= stat_value(count) %>
                <div class="adm-stat-card__label"><%= cfg[:label] %></div>
              </div>
              <div class="adm-stat-card__metric">
                <%= stat_value(cfg[:submission_count]) %>
                <div class="adm-stat-card__label"><%= cfg[:submission_label] %></div>
              </div>
              <% if triple %>
                <div class="adm-stat-card__metric">
                  <%= stat_value(cfg[:submission_count2]) %>
                  <div class="adm-stat-card__label"><%= cfg[:submission_label2] %></div>
                </div>
              <% end %>
            </div>
          <% else %>
            <%= stat_value(count) %>
            <div class="adm-stat-card__label"><%= cfg[:label] %></div>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

  <%# ── Mängelanzeigen ──────────────────────────────────── %>
  <% if feature?(:deficiency_reports) %>
    <div class="adm-dashboard__section">
      <div class="adm-dashboard__section-header">
        <span class="material-symbols-outlined" aria-hidden="true">report</span>
        <h3>Mängelanzeigen</h3>
      </div>
      <div class="adm-dashboard__stats">

        <div class="adm-stat-card">
          <div class="adm-stat-card__header">
            <span class="material-symbols-outlined adm-stat-card__icon">report</span>
            <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                  data-tiptext="Alle eingereichten Mängelanzeigen (nicht archivierte), unabhängig vom Status.">
              <span class="material-symbols-outlined">info</span>
            </span>
          </div>
          <%= stat_value(@reports_total) %>
          <div class="adm-stat-card__label">Gesamt</div>
        </div>

        <div class="adm-stat-card adm-stat-card--accent">
          <div class="adm-stat-card__header">
            <span class="material-symbols-outlined adm-stat-card__icon">pending</span>
            <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                  data-tiptext="Mängelanzeigen, die noch nicht abgeschlossen oder archiviert wurden.">
              <span class="material-symbols-outlined">info</span>
            </span>
          </div>
          <%= stat_value(@reports_open) %>
          <div class="adm-stat-card__label">Offen</div>
          <% if @reports_open_pct %>
            <div class="adm-stat-card__meta">
              <span class="adm-stat-card__ratio"><%= @reports_open_pct %> % aller Anzeigen</span>
            </div>
          <% end %>
        </div>

        <div class="adm-stat-card adm-stat-card--warning">
          <div class="adm-stat-card__header">
            <span class="material-symbols-outlined adm-stat-card__icon">person_search</span>
            <span class="adm-stat-card__info has-tip" data-tooltip aria-haspopup="true" tabindex="0"
                  data-tiptext="Offene Mängelanzeigen, denen noch kein Bearbeiter zugewiesen wurde. Handlungsbedarf!">
              <span class="material-symbols-outlined">info</span>
            </span>
          </div>
          <%= stat_value(@reports_unassigned) %>
          <div class="adm-stat-card__label">Nicht zugewiesen</div>
        </div>

      </div>
    </div>
  <% end %>

  <%# ── Demografien ─────────────────────────────────────── %>
  <% if @gender_stats.any? || @geozone_stats.any? %>
    <div class="adm-dashboard__section">
      <div class="adm-dashboard__section-header">
        <span class="material-symbols-outlined" aria-hidden="true">demographics</span>
        <h3>Demografie der Nutzer</h3>
      </div>
      <div class="adm-stats-demographics">

        <% if @gender_stats.any? %>
          <div class="adm-stats-demographics__group">
            <h4>Geschlecht</h4>
            <div data-bar-chart
                 data-chart-labels="<%= @gender_stats.keys.map { |g| t("stats.gender.#{g}", default: g.to_s.humanize) }.to_json %>"
                 data-chart-values="<%= @gender_stats.values.to_json %>"
                 data-chart-orientation="horizontal">
              <canvas></canvas>
            </div>
          </div>
        <% end %>

        <% if @geozone_stats.any? %>
          <div class="adm-stats-demographics__group">
            <h4>Gebiete (Top 10)</h4>
            <div data-bar-chart
                 data-chart-labels="<%= @geozone_stats.keys.to_json %>"
                 data-chart-values="<%= @geozone_stats.values.to_json %>"
                 data-chart-orientation="horizontal">
              <canvas></canvas>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  <% end %>

  <%# ── Zeitreihen-Charts ───────────────────────────────── %>
  <% charts_with_data = [@chart_users, @chart_comments, @chart_proposals].select { |c| c[:values].any?(&:positive?) } %>
  <% if charts_with_data.any? %>
    <div class="adm-dashboard__section">
      <div class="adm-dashboard__section-header">
        <span class="material-symbols-outlined" aria-hidden="true">trending_up</span>
        <h3>Aktivität (letzte 12 Monate)</h3>
      </div>
      <div class="adm-stats-charts">
        <% if @chart_users[:values].any?(&:positive?) %>
          <div class="adm-chart-card">
            <div class="adm-chart-card__title">Neue Registrierungen</div>
            <div class="adm-chart-card__total"><%= number_with_delimiter(@chart_users[:values].sum) %></div>
            <div class="adm-chart-card__canvas-wrapper"
                 data-area-chart
                 data-chart-labels="<%= @chart_users[:labels].to_json %>"
                 data-chart-values="<%= @chart_users[:values].to_json %>"
                 data-chart-color="#6BA3D6">
              <canvas></canvas>
            </div>
          </div>
        <% end %>
        <% if @chart_comments[:values].any?(&:positive?) %>
          <div class="adm-chart-card">
            <div class="adm-chart-card__title">Kommentare</div>
            <div class="adm-chart-card__total"><%= number_with_delimiter(@chart_comments[:values].sum) %></div>
            <div class="adm-chart-card__canvas-wrapper"
                 data-area-chart
                 data-chart-labels="<%= @chart_comments[:labels].to_json %>"
                 data-chart-values="<%= @chart_comments[:values].to_json %>"
                 data-chart-color="#5BAD82">
              <canvas></canvas>
            </div>
          </div>
        <% end %>
        <% if @chart_proposals[:values].any?(&:positive?) %>
          <div class="adm-chart-card">
            <div class="adm-chart-card__title">Neue Vorschläge</div>
            <div class="adm-chart-card__total"><%= number_with_delimiter(@chart_proposals[:values].sum) %></div>
            <div class="adm-chart-card__canvas-wrapper"
                 data-area-chart
                 data-chart-labels="<%= @chart_proposals[:labels].to_json %>"
                 data-chart-values="<%= @chart_proposals[:values].to_json %>"
                 data-chart-color="#E8953A">
              <canvas></canvas>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>


</div>
