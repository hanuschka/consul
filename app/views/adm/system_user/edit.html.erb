<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(
  title: t(".title"),
  breadcrumbs: @breadcrumbs,
  back_button_url: adm_root_path,
  narrow: true
) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <%= render Adm::SystemUserInfoComponent.new(user: @user, show_edit_link: false) %>

  <%= form_with model: @user, url: adm_system_user_path, method: :patch, multipart: true, class: "mt-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="kern-alert kern-alert--danger mb-4" role="alert">
        <div class="kern-alert__body">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t(".name_label"), hint: t(".name_hint"), inline: true, divider: false) do %>
      <%= f.text_field :username, label: false, placeholder: t(".name_label") %>
    <% end %>

    <%= render Kern::FormFieldComponent.new(label: t(".avatar_label"), hint: t(".avatar_hint"), inline: true, divider: false) do %>
      <%= render Kern::Form::ImageableImageComponent.new(form: f) %>
    <% end %>

    <%= form_submit_button(text: t("shared.submit")) %>
  <% end %>
</div>
