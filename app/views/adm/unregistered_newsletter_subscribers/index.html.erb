<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".intro_text_p1") %></p>
    <p class="adm-hint__text adm-hint__text--spaced"><%= t(".intro_text_p2") %></p>
  <% end %>
<% end %>

<%= render Adm::TabsComponent.new(tabs: [
  { label: t("adm.newsletters.index.tabs.list"), url: adm_newsletters_path },
  { label: t("adm.newsletters.index.tabs.recipient_groups"), url: adm_recipient_groups_path },
  { label: t("adm.newsletters.index.tabs.unregistered_subscribers"), url: adm_unregistered_newsletter_subscribers_path, current: true },
  { label: t("adm.newsletters.index.tabs.settings"), url: settings_adm_newsletters_path }
]) %>

<div class="kern-container my-5">

  <% if @unregistered_newsletter_subscribers.any? %>
    <div class="d-flex justify-content-end mb-4">
      <%= kern_link_button(adm_unregistered_newsletter_subscribers_path(format: :csv), text: t('.download_csv'), style: :secondary) %>
    </div>

    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t('.table.id') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.email') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.confirmed') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.created_at') %></th>
            <th scope="col" class="kern-table__header"><%= t('.table.actions') %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @unregistered_newsletter_subscribers.each do |subscriber| %>
            <tr id="<%= dom_id(subscriber, :adm) %>" class="kern-table__row">
              <td scope="row" class="kern-table__header"><%= subscriber.id %></td>
              <td class="kern-table__cell"><%= subscriber.email %></td>
              <td class="kern-table__cell"><%= subscriber.confirmed? ? t('.table.confirmed_yes') : t('.table.confirmed_no') %></td>
              <td class="kern-table__cell"><%= l(subscriber.created_at, format: :long) %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(
                    label: t('.table.delete'),
                    url: adm_unregistered_newsletter_subscriber_path(subscriber),
                    icon: "delete", style: :delete,
                    data: { turbo_method: :delete, turbo_confirm: t('.table.delete_confirm') }
                  ) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".empty_title"), description: t(".empty_description"), icon: "person_off") %>
  <% end %>
</div>
