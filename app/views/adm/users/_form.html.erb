<%= form_with model: [:adm, @user] do |f| %>
  <% if @user.errors.any? %>
    <div class="kern-alert kern-alert--danger mb-4" role="alert">
      <div class="kern-alert__body">
        <ul class="mb-0">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:email), hint: t("adm.users.form.hints.email"), inline: true, divider: false) do %>
    <%= f.email_field :email, label: false, placeholder: User.human_attribute_name(:email) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:first_name), hint: t("adm.users.form.hints.first_name"), inline: true, divider: false) do %>
    <%= f.text_field :first_name, label: false, placeholder: User.human_attribute_name(:first_name) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:last_name), hint: t("adm.users.form.hints.last_name"), inline: true, divider: false) do %>
    <%= f.text_field :last_name, label: false, placeholder: User.human_attribute_name(:last_name) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:date_of_birth), hint: t("adm.users.form.hints.date_of_birth"), inline: true, divider: false) do %>
    <%= f.date_field :date_of_birth, label: false %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:gender), hint: t("adm.users.form.hints.gender"), inline: true, divider: false) do %>
    <%= f.select :gender,
      options_for_gender_select,
      { include_blank: t("custom.helpers.select.gender_prompt") },
      { label: false } %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:city_name), hint: t("adm.users.form.hints.city_name"), inline: true, divider: false) do %>
    <%= f.text_field :city_name, label: false, placeholder: User.human_attribute_name(:city_name) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:plz), hint: t("adm.users.form.hints.plz"), inline: true, divider: false) do %>
    <%= f.text_field :plz, label: false, placeholder: User.human_attribute_name(:plz) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:street_name), hint: t("adm.users.form.hints.street_name"), inline: true, divider: false) do %>
    <%= f.text_field :street_name, label: false, placeholder: User.human_attribute_name(:street_name) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:street_number), hint: t("adm.users.form.hints.street_number"), inline: true, divider: false) do %>
    <%= f.text_field :street_number, label: false, placeholder: User.human_attribute_name(:street_number) %>
  <% end %>

  <%= render Kern::FormFieldComponent.new(label: User.human_attribute_name(:street_number_extension), hint: t("adm.users.form.hints.street_number_extension"), inline: true, divider: false) do %>
    <%= f.text_field :street_number_extension, label: false, placeholder: User.human_attribute_name(:street_number_extension) %>
  <% end %>

  <div class="d-flex gap-2">
    <%= form_submit_button(text: t("shared.submit")) %>

    <% if Setting["feature.melderegister"].present? %>
      <%= form_submit_button(text: t("adm.users.form.submit_with_reverify"), name: "reverify", value: "1", icon: "verified", data: { turbo_confirm: t("adm.users.form.reverify_confirm") }) %>
    <% end %>
  </div>
<% end %>
