<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container">
  <div class="kern-table-responsive" tabindex="0">
    <table class="kern-table" data-controller="table"
                              data-table-sort-by-value="<%= params[:sort_by] %>"
                              data-table-sort-direction-value="<%= params[:sort_direction] %>"
                              >
      <thead class="kern-table__head">
        <tr class="kern-table__row">
          <%= render Kern::Table::HeaderComponent.new(:username, User.human_attribute_name(:username), **@username_header_options) %>
          <%= render Kern::Table::HeaderComponent.new(:gender, User.human_attribute_name(:gender), **@gender_header_options) %>
          <%= render Kern::Table::HeaderComponent.new(:reverify, User.human_attribute_name(:reverify), **@reverify_header_options) %>
          <th scope="col" class="kern-table__header"><%= t('shared.table.actions') %></th>
        </tr>
      </thead>

      <tbody class="kern-table__body">
        <% @users.each do |user| %>
          <tr class="kern-table__row">
            <th scope="row" class="kern-table__header"><%= user.username %></th>
            <td class="kern-table__cell"><%= user.gender %></td>
            <td class="kern-table__cell"><%= user.reverify %></td>
            <td class="kern-table__cell">
              <%= render Kern::Table::ActionsComponent.new() do |c| %>
                <%= c.with_action  label: t(".table.actions.verify"), url: verify_adm_user_path(user), method: :patch, show: !user.verified?  %>
                <%= c.with_action  label: t(".table.actions.unverify"), url: unverify_adm_user_path(user), method: :patch, show: user.verified?  %>
                <%= c.with_action  label: t(".table.actions.edit"), url: edit_adm_user_path(user)  %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="my-5">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
