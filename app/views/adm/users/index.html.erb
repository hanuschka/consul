<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container mb-5">
  <div data-controller="adm-column-selector"
       data-adm-column-selector-storage-key-value="adm-users-columns"
       data-adm-column-selector-defaults-value="username,email"
       data-action="click@window->adm-column-selector#close">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div class="adm-column-selector">
        <button type="button" class="adm-column-selector__toggle" data-action="adm-column-selector#toggle">
          <span class="material-symbols-outlined" aria-hidden="true">view_column</span>
          <%= t(".columns") %>
        </button>
        <div class="adm-column-selector__menu" data-adm-column-selector-target="menu">
          <div data-adm-column-selector-target="list"></div>
        </div>
      </div>
      <%= kern_link_button adm_users_path(params.permit(
        :sort_by, :sort_direction,
        :username__search, :email__search, :first_name__search, :last_name__search,
        gender: [], reverify: [], document_type: []
      ).merge(format: :csv)), text: t(".csv_export_button"), icon: "download" %>
    </div>

    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table kern-table--small kern-table--striped" data-adm-column-selector-target="table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <%= render Kern::Table::HeaderComponent.new(:username, User.human_attribute_name(:username), **@username_header_options.merge(data_field: "username")) %>
            <%= render Kern::Table::HeaderComponent.new(:email, User.human_attribute_name(:email), **@email_header_options.merge(data_field: "email")) %>
            <%= render Kern::Table::HeaderComponent.new(:first_name, User.human_attribute_name(:first_name), **@first_name_header_options.merge(data_field: "first_name")) %>
            <%= render Kern::Table::HeaderComponent.new(:last_name, User.human_attribute_name(:last_name), **@last_name_header_options.merge(data_field: "last_name")) %>
            <%= render Kern::Table::HeaderComponent.new(:city_name, t(".table.city_name"), **@city_name_header_options.merge(data_field: "city_name")) %>
            <th scope="col" class="kern-table__header" data-field="street_address"><%= t(".table.street_address") %></th>
            <th scope="col" class="kern-table__header" data-field="plz"><%= t(".table.plz") %></th>
            <th scope="col" class="kern-table__header" data-field="district"><%= t(".table.district") %></th>
            <%= render Kern::Table::HeaderComponent.new(:document_type, t(".table.document_type"), **@document_type_header_options.merge(data_field: "document_type")) %>
            <th scope="col" class="kern-table__header" data-field="document_last_digits"><%= t(".table.document_last_digits") %></th>
            <%= render Kern::Table::HeaderComponent.new(:gender, User.human_attribute_name(:gender), **@gender_header_options.merge(data_field: "gender")) %>
            <th scope="col" class="kern-table__header" data-field="date_of_birth"><%= t(".table.date_of_birth") %></th>
            <th scope="col" class="kern-table__header" data-field="roles"><%= t(".table.roles") %></th>
            <th scope="col" class="kern-table__header" data-field="unique_stamp"><%= t(".table.unique_stamp") %></th>
            <%= render Kern::Table::HeaderComponent.new(:created_at, t(".table.created_at"), **@created_at_header_options.merge(data_field: "created_at")) %>
            <th scope="col" class="kern-table__header" data-field="last_sign_in"><%= t(".table.last_sign_in") %></th>
            <%= render Kern::Table::HeaderComponent.new(:verified_at, t(".table.verified_at"), **@verified_at_header_options.merge(data_field: "verified_at")) %>
            <%= render Kern::Table::HeaderComponent.new(:reverify, User.human_attribute_name(:reverify), **@reverify_header_options.merge(data_field: "reverify")) %>
            <th scope="col" class="kern-table__header"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @users.each do |user| %>
            <%= render "adm/users/user", user: user %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="my-5">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
