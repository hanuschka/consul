<%= content_for :title, t("adm.valuation.home.title") %>

<%= render Adm::HeaderComponent.new(title: t("adm.valuation.home.title"), breadcrumbs: @breadcrumbs) %>

<%= render Adm::DashboardHomeComponent.new(
  team_members: @team_members,
  team_url: new_adm_valuator_path,
  intro_text: @intro_text,
  quick_links: @quick_links,
  stats: @stats,
  contact_persons: @contact_persons,
  section: "valuation",
  notice_active: @notice_active,
  notice_message: @notice_message,
  activities: [],
  section_settings_path: policy([:adm, Setting]).update? ? adm_valuation_settings_path : nil
) %>

<div class="kern-container">
  <div class="adm-dashboard__section adm-dashboard__section--pull-up">
    <div class="adm-dashboard__section-header">
      <span class="material-symbols-outlined" aria-hidden="true">account_balance_wallet</span>
      <h3><%= t("adm.valuation.menu.items.investments") %></h3>
    </div>

    <%= render "adm/valuation/investments/table" %>
  </div>

  <%= render Adm::ActivityFeedComponent.new(activities: @activities, pagy: @pagy_activities) %>
</div>
