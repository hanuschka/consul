<%= content_for :title, t(".title") %>

<%= render Adm::HeaderComponent.new(title: t(".title")) do |header| %>
  <% header.with_hint do %>
    <p class="adm-hint__text"><%= t(".page_hint") %></p>
  <% end %>
<% end %>

<div class="kern-container my-5">
  <% if @investments.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header" style="width: 5rem;"><%= t(".table.id") %></th>
            <th scope="col" class="kern-table__header"><%= t(".table.title") %></th>
            <th scope="col" class="kern-table__header" style="width: 12rem;"><%= t(".table.budget") %></th>
            <th scope="col" class="kern-table__header" style="width: 12rem;"><%= t(".table.valuator") %></th>
            <th scope="col" class="kern-table__header" style="width: 5rem;"><%= t("shared.table.actions") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @investments.each do |investment| %>
            <tr id="<%= dom_id(investment) %>" class="kern-table__row">
              <td class="kern-table__cell"><strong><%= investment.id %></strong></td>
              <td class="kern-table__cell">
                <%= link_to investment.title, budget_investment_path(investment.budget, investment), target: "_blank", rel: "noopener", class: "kern-link" %>
              </td>
              <td class="kern-table__cell"><%= truncate(investment.budget.name, length: 25) %></td>
              <td class="kern-table__cell"><%= truncate(investment.valuators.map(&:name).join(", "), length: 30) %></td>
              <td class="kern-table__cell">
                <%= render Kern::Table::ActionsComponent.new do |actions| %>
                  <% actions.with_action(label: t(".table.edit"), url: edit_adm_valuation_investment_path(investment), icon: "edit", style: :edit) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="my-5">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <%= empty_state(title: t(".no_items_title"), description: t(".no_items_description"), icon: "savings") %>
  <% end %>
</div>
