<%= content_for :title, t("adm.valuation.menu.items.settings") %>

<%= render Adm::HeaderComponent.new(title: t("adm.valuation.menu.items.settings"), breadcrumbs: @breadcrumbs) %>

<div class="kern-container my-5">
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.valuation.intro_text"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.valuation.notice_message"), :value, :text) %>
  <%= render Adm::AttributeEditorComponent.new(Setting.find_by!(key: "adm.valuation.notice_active"), :value, :boolean) %>

  <%= render "adm/section_contact_people/section_block", section: "valuation" %>
</div>
