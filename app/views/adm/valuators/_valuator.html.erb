<tr class="kern-table__row" id="<%= dom_id(valuator) %>">
  <th scope="row" class="kern-table__header"><%= valuator.id %></th>
  <td class="kern-table__cell"><%= valuator.name %></td>
  <td class="kern-table__cell"><%= valuator.email %></td>
  <td class="kern-table__cell">
    <%= render Kern::Table::ActionsComponent.new do |actions| %>
      <% actions.with_action(label: t("shared.delete"), url: adm_valuator_path(valuator), icon: "delete", style: :delete, data: { turbo_method: :delete, turbo_confirm: t("shared.confirm_delete") }) %>
    <% end %>
  </td>
</tr>
