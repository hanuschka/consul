<% last_message = last_messages[account.id] %>
<% step = account.whatsapp_conversation&.step %>

<tr class="kern-table__row">
  <td class="kern-table__cell">
    <span class="adm-whatsapp-dialog-contact"><%= account.contact_label %></span>
    <span class="adm-whatsapp-dialog-contact--meta">
      <%= account.phone.presence || account.wa_id %>
      <% if account.user.present? %>
        · <%= link_to account.user.name, edit_adm_user_path(account.user), class: "kern-link" %>
      <% end %>
    </span>
  </td>

  <td class="kern-table__cell">
    <span class="kern-badge kern-badge--<%= account.state_badge_variant %>">
      <span class="kern-label"><%= t("adm.whatsapp.dialogs.states.#{account.state}") %></span>
    </span>
    <% if account.subscribed? %>
      <span class="kern-badge kern-badge--success">
        <span class="kern-label"><%= t("adm.whatsapp.dialogs.subscribed") %></span>
      </span>
    <% end %>
  </td>

  <td class="kern-table__cell">
    <% if step.present? && step != "idle" %>
      <span class="kern-badge kern-badge--info">
        <span class="kern-label"><%= t("adm.whatsapp.steps.#{step}") %></span>
      </span>
    <% else %>
      <span class="adm-whatsapp-dialog-contact--meta"><%= t("adm.whatsapp.dialogs.steps_idle") %></span>
    <% end %>
  </td>

  <td class="kern-table__cell"><%= message_counts[account.id].to_i %></td>

  <td class="kern-table__cell">
    <% if last_message.present? %>
      <span class="adm-whatsapp-dialog-preview">
        <span class="adm-whatsapp-dialog-preview--direction -<%= last_message.direction %>">
          <%= t("adm.whatsapp.dialogs.directions.#{last_message.direction}") %>
        </span>
        <%= last_message.body.presence&.truncate(80) ||
          t("adm.whatsapp.kinds.#{last_message.kind}") %>
      </span>
    <% end %>
  </td>

  <td class="kern-table__cell">
    <% if account.last_inbound_at.present? %>
      <%= l(account.last_inbound_at, format: :short) %>
    <% else %>
      <span class="adm-whatsapp-dialog-contact--meta"><%= t("adm.whatsapp.dialogs.never") %></span>
    <% end %>
  </td>

  <td class="kern-table__cell kern-table__cell--action">
    <%= link_to adm_whatsapp_dialog_path(account), class: "kern-btn kern-btn--tertiary" do %>
      <span class="kern-label material-symbols-outlined" aria-hidden="true">forum</span>
      <span class="kern-label"><%= t("adm.whatsapp.dialogs.open") %></span>
    <% end %>
  </td>
</tr>
