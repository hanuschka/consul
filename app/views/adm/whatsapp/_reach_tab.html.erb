<% accounts = @reach_stats[:accounts] %>
<% activity = @reach_stats[:activity] %>
<% messages = @reach_stats[:messages] %>
<% broadcasts = @reach_stats[:broadcasts] %>
<% conversations = @reach_stats[:conversations] %>

<section class="mb-5">
  <h2 class="kern-title kern-title--small mb-1"><%= t("adm.whatsapp.reach.contacts_title") %></h2>
  <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.reach.contacts_intro") %></p>

  <%= render "adm/whatsapp/stat_grid", tiles: [
    { value: accounts[:total], label: t("adm.whatsapp.reach.total") },
    { value: accounts[:linked], label: t("adm.whatsapp.reach.linked"), tone: "accent" },
    { value: accounts[:subscribed], label: t("adm.whatsapp.reach.subscribed"), tone: "success" },
    { value: accounts[:opted_out], label: t("adm.whatsapp.reach.opted_out"), tone: "danger" }
  ] %>

  <dl class="kern-description-list mt-3">
    <div class="kern-description-list-item">
      <dt class="kern-description-list-item__key"><%= t("adm.whatsapp.reach.verified") %></dt>
      <dd class="kern-description-list-item__value"><%= number_with_delimiter(accounts[:verified]) %></dd>
    </div>

    <div class="kern-description-list-item">
      <dt class="kern-description-list-item__key"><%= t("adm.whatsapp.reach.link_pending") %></dt>
      <dd class="kern-description-list-item__value"><%= number_with_delimiter(accounts[:link_pending]) %></dd>
    </div>

    <div class="kern-description-list-item">
      <dt class="kern-description-list-item__key"><%= t("adm.whatsapp.reach.unlinked") %></dt>
      <dd class="kern-description-list-item__value"><%= number_with_delimiter(accounts[:unlinked]) %></dd>
    </div>
  </dl>
</section>

<section class="mb-5">
  <h2 class="kern-title kern-title--small mb-1"><%= t("adm.whatsapp.reach.activity_title") %></h2>
  <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.reach.activity_intro") %></p>

  <%= render "adm/whatsapp/stat_grid", tiles: [
    { value: activity[:active_recent], label: t("adm.whatsapp.reach.active_recent"), tone: "accent" },
    { value: activity[:active_growth], label: t("adm.whatsapp.reach.active_growth") },
    { value: activity[:new_verified], label: t("adm.whatsapp.reach.new_verified") },
    { value: activity[:new_opt_ins], label: t("adm.whatsapp.reach.new_opt_ins") }
  ] %>
</section>

<section class="mb-5">
  <h2 class="kern-title kern-title--small mb-1"><%= t("adm.whatsapp.reach.messages_title") %></h2>
  <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.reach.messages_intro") %></p>

  <%= render "adm/whatsapp/stat_grid", tiles: [
    {
      value: messages[:inbound],
      label: t("adm.whatsapp.reach.inbound"),
      hint: t("adm.whatsapp.reach.last_30_days", count: number_with_delimiter(messages[:recent_inbound]))
    },
    {
      value: messages[:outbound],
      label: t("adm.whatsapp.reach.outbound"),
      hint: t("adm.whatsapp.reach.last_30_days", count: number_with_delimiter(messages[:recent_outbound]))
    },
    {
      value: messages[:failed_outbound],
      label: t("adm.whatsapp.reach.failed_outbound"),
      tone: messages[:failed_outbound].positive? ? "danger" : nil
    }
  ] %>

  <% if messages[:inbound].positive? || messages[:outbound].positive? %>
    <h3 class="kern-label mt-4 mb-2"><%= t("adm.whatsapp.reach.by_kind_title") %></h3>

    <dl class="kern-description-list">
      <% messages[:by_kind].each do |kind, count| %>
        <div class="kern-description-list-item">
          <dt class="kern-description-list-item__key"><%= t("adm.whatsapp.kinds.#{kind}") %></dt>
          <dd class="kern-description-list-item__value"><%= number_with_delimiter(count) %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</section>

<section class="mb-5">
  <h2 class="kern-title kern-title--small mb-1"><%= t("adm.whatsapp.reach.broadcasts_title") %></h2>
  <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.reach.broadcasts_intro") %></p>

  <% if broadcasts.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t("adm.whatsapp.reach.projekt") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.whatsapp.reach.sent") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.whatsapp.reach.failed") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.whatsapp.reach.last_sent_at") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% broadcasts.each do |row| %>
            <tr class="kern-table__row">
              <td class="kern-table__cell">
                <%= link_to row[:projekt_name],
                  whatsapp_adm_projekts_projekt_path(row[:projekt_id]),
                  class: "kern-link" %>
              </td>
              <td class="kern-table__cell"><%= number_with_delimiter(row[:sent]) %></td>
              <td class="kern-table__cell">
                <% if row[:failed].positive? %>
                  <span class="kern-badge kern-badge--danger">
                    <span class="kern-label"><%= number_with_delimiter(row[:failed]) %></span>
                  </span>
                <% else %>
                  <%= row[:failed] %>
                <% end %>
              </td>
              <td class="kern-table__cell"><%= l(row[:last_sent_at], format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t("adm.whatsapp.reach.no_broadcasts"), icon: "campaign") %>
  <% end %>
</section>

<section class="mb-5">
  <h2 class="kern-title kern-title--small mb-1"><%= t("adm.whatsapp.reach.flows_title") %></h2>
  <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.reach.flows_intro") %></p>

  <% if conversations[:in_flight].positive? %>
    <%= render "adm/whatsapp/stat_grid", tiles: conversations[:by_step].map { |step, count|
      { value: count, label: t("adm.whatsapp.steps.#{step}") }
    } %>
  <% else %>
    <%= empty_state(title: t("adm.whatsapp.reach.no_flows"), icon: "forum") %>
  <% end %>
</section>

<section>
  <h2 class="kern-title kern-title--small mb-1"><%= t("adm.whatsapp.reach.phases_title") %></h2>
  <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.reach.phases_intro") %></p>

  <% if @eligible_projekt_phases.any? %>
    <div class="kern-table-responsive" tabindex="0">
      <table class="kern-table">
        <thead class="kern-table__head">
          <tr class="kern-table__row">
            <th scope="col" class="kern-table__header"><%= t("adm.whatsapp.reach.projekt") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.whatsapp.reach.phase") %></th>
            <th scope="col" class="kern-table__header"><%= t("adm.whatsapp.reach.qr_code") %></th>
          </tr>
        </thead>

        <tbody class="kern-table__body">
          <% @eligible_projekt_phases.each do |phase| %>
            <tr class="kern-table__row">
              <td class="kern-table__cell">
                <%= link_to phase.projekt.page&.title.presence || phase.projekt.name,
                  whatsapp_adm_projekts_projekt_path(phase.projekt),
                  class: "kern-link" %>
              </td>
              <td class="kern-table__cell"><%= phase.title %></td>
              <td class="kern-table__cell">
                <%= link_to t("adm.whatsapp.reach.open_phase_qr"),
                  whatsapp_adm_projekts_phase_path(phase),
                  class: "kern-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state(title: t("adm.whatsapp.reach.no_phases"), icon: "qr_code_2") %>
  <% end %>
</section>
