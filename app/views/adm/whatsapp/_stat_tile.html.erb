<div class="adm-whatsapp-stat<%= " -#{tile[:tone]}" if tile[:tone].present? %>">
  <p class="adm-whatsapp-stat--value"><%= number_with_delimiter(tile[:value].to_i) %></p>
  <p class="adm-whatsapp-stat--label"><%= tile[:label] %></p>
  <% if tile[:hint].present? %>
    <p class="adm-whatsapp-stat--hint"><%= tile[:hint] %></p>
  <% end %>
</div>
