<section>
  <h2 class="kern-title kern-title--small mb-2"><%= t("adm.whatsapp.show.templates_title") %></h2>
  <p class="kern-body mb-3"><%= t("adm.whatsapp.show.templates_intro") %></p>

<%
  configured_template_name = ::Whatsapp.broadcast_template_name
  configured_template_language = ::Whatsapp.broadcast_template_language
  configured_template =
    @templates.find do |template|
      template[:name] == configured_template_name &&
        template[:language] == configured_template_language
    end
%>

  <% if configured_template_name.blank? %>
    <div class="mb-3">
      <%= kern_alert(title: t("adm.whatsapp.show.template_missing_title"), style: :info) do %>
        <p class="kern-body"><%= t("adm.whatsapp.show.template_missing_body") %></p>
      <% end %>
    </div>
  <% elsif configured_template.blank? %>
    <div class="mb-3">
      <%= kern_alert(title: t("adm.whatsapp.show.template_unknown_title"), style: :danger) do %>
        <p class="kern-body">
          <%= t("adm.whatsapp.show.template_unknown_body",
            name: configured_template_name,
            language: ::Whatsapp.broadcast_template_language) %>
        </p>
      <% end %>
    </div>
  <% elsif !configured_template[:approved] %>
    <div class="mb-3">
      <%= kern_alert(title: t("adm.whatsapp.show.template_pending_title"), style: :warning) do %>
        <p class="kern-body">
          <%= t("adm.whatsapp.show.template_pending_body",
            name: configured_template_name,
            status: configured_template[:status]) %>
        </p>
      <% end %>
    </div>
  <% end %>

  <% if @templates.any? %>
    <table class="kern-table mb-4">
      <thead>
        <tr>
          <th><%= t("adm.whatsapp.show.template_name") %></th>
          <th><%= t("adm.whatsapp.show.template_language") %></th>
          <th><%= t("adm.whatsapp.show.template_status") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @templates.each do |template| %>
          <tr>
            <td><%= template[:name] %></td>
            <td><%= template[:language] %></td>
            <td>
              <span class="kern-badge kern-badge--<%= template[:approved] ? "success" : "warning" %>">
                <span class="kern-label"><%= template[:status] %></span>
              </span>
            </td>
            <td>
              <% if configured_template_name == template[:name] &&
                    configured_template_language == template[:language] %>
                <%= t("adm.whatsapp.show.template_in_use") %>
              <% else %>
                <% if configured_template_name == template[:name] %>
                  <p class="kern-body kern-body--small">
                    <%= t("adm.whatsapp.show.template_language_mismatch",
                      language: configured_template_language) %>
                  </p>
                <% end %>

                <% if template[:approved] %>
                  <%# A real PATCH form, not an <a> carrying data-turbo-method:
                      only PATCH is routed, so a Turbo prefetch, a middle-click
                      or a bookmarked href would raise a routing error. %>
                  <%= form_with url: use_template_adm_whatsapp_path, method: :patch do |form| %>
                    <%= form.hidden_field :name, value: template[:name] %>
                    <%= form.hidden_field :language, value: template[:language] %>
                    <%= form.submit t("adm.whatsapp.show.template_use"),
                          class: "kern-btn kern-btn--tertiary" %>
                  <% end %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div class="adm-whatsapp-page--form">
    <% if @template_form.errors[:base].any? %>
      <div class="mb-3">
        <%= kern_alert(title: t("adm.whatsapp.show.template_failed_title"), style: :danger) do %>
          <% @template_form.errors[:base].each do |message| %>
            <p class="kern-body"><%= message %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @template_form, url: create_template_adm_whatsapp_path,
      scope: :template, method: :post, data: { turbo: false } do |f| %>
      <%= f.text_field :name,
        label: t("adm.whatsapp.show.template_name_label"),
        hint: t("adm.whatsapp.show.template_name_hint") %>

      <%= f.text_field :language,
        label: t("adm.whatsapp.show.template_language_label"),
        hint: t("adm.whatsapp.show.template_language_hint") %>

      <%= f.text_area :body,
        label: t("adm.whatsapp.show.template_body_label"),
        hint: t("adm.whatsapp.show.template_body_hint"),
        rows: 4 %>

      <%= form_submit_button(text: t("adm.whatsapp.show.template_submit")) %>
    <% end %>
  </div>
</section>
