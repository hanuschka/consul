<%= render "adm/whatsapp/page_header", key: "dialogs" %>

<div class="kern-container my-3 adm-whatsapp-page">
  <%= render "adm/whatsapp/page_description", key: "dialogs" %>

  <section>
    <h2 class="kern-title kern-title--small mb-1"><%= t("adm.whatsapp.dialogs.title") %></h2>
    <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.dialogs.intro") %></p>

    <% if !@dialogs_present %>
      <%= empty_state(
        title: t("adm.whatsapp.dialogs.none_title"),
        description: t("adm.whatsapp.dialogs.none_body"),
        icon: "forum"
      ) %>
    <% else %>
      <%= render "adm/whatsapp/dialogs_filter_bar" %>
      <%= render "adm/whatsapp/dialogs_frame" %>
    <% end %>
  </section>
</div>
