<%= render "adm/whatsapp/page_header", key: "settings" %>

<div class="kern-container my-3 adm-whatsapp-page">
  <%= render "adm/whatsapp/page_description", key: "settings" %>

  <section class="mb-5">
    <h2 class="kern-title kern-title--small mb-2"><%= t("adm.whatsapp.show.settings_title") %></h2>
    <p class="kern-body mb-3"><%= t("adm.whatsapp.show.settings_intro") %></p>

    <% @text_settings.each do |setting| %>
      <%= render Adm::AttributeEditorComponent.new(setting, :value, :string) %>
    <% end %>
  </section>

  <% if @auto_broadcast_setting.present? %>
    <section class="mb-5">
      <h2 class="kern-title kern-title--small mb-2"><%= t("adm.whatsapp.show.auto_broadcast_title") %></h2>
      <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.show.auto_broadcast_intro") %></p>

      <%= render Adm::AttributeEditorComponent.new(@auto_broadcast_setting, :value, :boolean) %>

      <% if @auto_broadcast_setting.value.present? && ::Whatsapp.broadcast_template_name.blank? %>
        <%= kern_alert(title: t("adm.whatsapp.show.auto_broadcast_missing_template_title"), style: :warning) do %>
          <p class="kern-body"><%= t("adm.whatsapp.show.auto_broadcast_missing_template_body") %></p>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <section class="mb-5">
    <h2 class="kern-title kern-title--small mb-2"><%= t("adm.whatsapp.show.draft_evaluation_title") %></h2>
    <p class="kern-body kern-prose mb-3"><%= t("adm.whatsapp.show.draft_evaluation_body") %></p>

    <%= kern_link_button(
      adm_projekts_projekts_list_path,
      icon: "checklist",
      text: t("adm.whatsapp.show.draft_evaluation_link")
    ) %>
  </section>
</div>
