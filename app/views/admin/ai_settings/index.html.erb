<h1><%= t("admin.ai_settings.index.title") %></h1>

<div class="ai-settings-container">
  <% if @ai_settings.any? %>
    <table class="ai-settings-table mixed-settings-table">
      <thead>
        <tr>
          <th><%= t("admin.ai_settings.index.setting_name") %></th>
          <th><%= t("admin.ai_settings.index.value") %></th>
        </tr>
      </thead>
      <tbody>
        <% @ai_settings.each do |setting| %>
          <% next if setting.key == "ai.llm_api_endpoint" && !show_api_endpoint? %>
          <% next if setting.key == "ai.llm_model" && !show_model_field? %>
          <% next if setting.key == "ai.llm_custom_model" && !show_custom_model_field? %>
          <tr class="setting-row" data-setting-key="<%= setting.key %>">
            <td>
              <strong id="<%= dom_id(setting, :title) %>"><%= t("custom.settings.#{setting.key}") %></strong>
              <br>
              <span class="small">
                <%= t("custom.settings.#{setting.key}_description", default: t("admin.settings.no_description")) %>
              </span>
            </td>
            <td class="setting-value">
              <%= render Admin::AiSettings::FormComponent.new(setting, setting.key) %>
            </td>
          </tr>
        <% end %>
        <tr class="setting-row">
          <td>
            <strong><%= t("custom.settings.ai.llm_api_key") %></strong>
            <br>
            <span class="small">
              <%= t("custom.settings.ai.llm_api_key_description") %>
            </span>
          </td>
          <td class="setting-value">
            <%= render Admin::AiSettings::ApiKeyComponent.new("ai.#{RubyLlmFactory.llm_provider}") %>
          </td>
        </tr>
      </tbody>
    </table>
  <% else %>
    <p><%= t("admin.ai_settings.index.no_settings") %></p>
  <% end %>
</div>
