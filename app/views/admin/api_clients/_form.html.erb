<%= form_for [:admin, @api_client] do |f| %>
  <% if @api_client.errors.any? %>
    <div id="error_explanation" class="callout alert">
      <h4><%= pluralize(@api_client.errors.count, "error") %> prohibited this API client from being saved:</h4>
      <ul>
        <% @api_client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="columns medium-6">
      <%= f.text_field :name, placeholder: ApiClient.human_attribute_name(:name) %>
    </div>
    <div class="columns medium-6">
      <%= f.text_field :domain, placeholder: ApiClient.human_attribute_name(:domain) %>
    </div>
  </div>

  <div class="row">
    <div class="columns medium-6">
      <%= f.email_field :service_user_email, placeholder: ApiClient.human_attribute_name(:service_user_email) %>
    </div>
    <div class="columns medium-6">
      <%= f.select :access_level,
        options_for_select(ApiClient.access_levels.keys.map { |level| [t("admin.api_clients.access_level.#{level}"), level] },
        @api_client.access_level),
        {},
        { class: "form-control" } %>
    </div>
  </div>

  <div class="row">
    <div class="columns">
      <%= f.submit class: "button success" %>
    </div>
  </div>
<% end %>
