<%= back_link_to admin_api_clients_path %>

<div class="medium-8">

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2 style="margin: 0;"><%= @api_client.name %></h2>
    <%= link_to t("admin.api_clients.edit_button"), edit_admin_api_client_path(@api_client), class: "button" %>
  </div>

  <div class="callout">
    <p>
      <strong><%= ApiClient.human_attribute_name(:service_user_email) %>:</strong><br>
      <%= @api_client.service_user_email %>
    </p>

    <p>
      <strong><%= ApiClient.human_attribute_name(:access_level) %>:</strong><br>
      <span class="label <%= access_level_label_class(@api_client.access_level) %>">
        <%= t("admin.api_clients.access_level.#{@api_client.access_level}") %>
      </span>
    </p>
    <div style="margin-bottom: 20px; padding: 8px 8px; background-color: #f9f9f9; border-left: 3px solid #0066cc; border-radius: 2px;">
      <% t("admin.api_clients.form.access_level_description").split("\n\n").each do |paragraph| %>
        <p style="margin: 0 0 10px 0; color: #444; font-size: 12px; line-height: 1.6;"><%= paragraph %></p>
      <% end %>
    </div>

    <p>
    <strong><%= ApiClient.human_attribute_name(:auth_token) %>:</strong><br>
    <%= render Admin::HiddenTokenWidgetComponent.new(token: @api_client.access_token) %>
    </p>

    <div style="max-width:1000px;background-color: #f5f5f5; padding: 12px 16px; border-radius: 4px; margin-top: 8px;">
      <p style="margin: 0 0 12px 0; color: #666;">
        <em><%= t("admin.api_clients.show.auth_token_explanation_text") %></em>
      </p>
      <p style="margin: 0 0 6px 0; font-weight: 500; color: #333;">
        <%= t("admin.api_clients.show.auth_token_example_title") %>
      </p>
      <code style="background-color: #fff; padding: 2px 4px; border-radius: 2px; color: #666; font-size: 0.9em;">
        <%= t("admin.api_clients.show.auth_token_example") %>
      </code>
    </div>
  </div>

  <% if @api_client.user.present? %>
    <h3 style="margin-top: 24px; margin-bottom: 12px;">
      <%= t("admin.api_clients.show.service_user_title") %>
    </h3>

    <div style="margin-bottom: 20px; padding: 12px; background-color: #f0f4f8; border-left: 4px solid #003A71; border-radius: 4px;">
      <p style="margin: 0 0 8px 0; font-size: 14px; color: #333;">
        <%= t("admin.api_clients.form.service_user_explanation") %>
      </p>
      <p style="margin: 0; font-size: 14px; color: #333;">
        <%= t("admin.api_clients.show.service_user_login_warning") %>
      </p>
    </div>

    <div class="callout">
      <div style="margin-bottom: 16px;">
        <% if @api_client.user.image&.attachment&.attached? %>
          <%= image_tag(@api_client.user.image.variant(:medium), style: "border-radius: 50%; max-width: 100px; height: auto;") %>
        <% else %>
          <div style="width: 100px; height: 100px; border-radius: 50%; background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #666; font-size: 40px;">
            <%= @api_client.user.first_letter_of_name %>
          </div>
        <% end %>
      </div>

      <% if @api_client.user.first_name.present? || @api_client.user.last_name.present? %>
        <p>
          <strong><%= t("admin.api_clients.show.service_user_name") %>:</strong><br>
          <%= "#{@api_client.user.first_name} #{@api_client.user.last_name}".strip %>
        </p>
      <% end %>

      <p>
        <strong><%= User.human_attribute_name(:username) %>:</strong><br>
        <%= @api_client.user.username %>
      </p>
    </div>
  <% end %>
</div>
