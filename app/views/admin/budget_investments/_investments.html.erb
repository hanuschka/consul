<%= link_to t("admin.budget_investments.index.download_current_selection"),
            polymorphic_path([@namespace, @budget.projekt_phase], action: :budget_investments, **request.query_parameters, format: :csv),
            class: "float-right small clear" %>

<%= link_to t("admin.budget_investments.index.download_geojson"),
            admin_budget_budget_investments_path(@budget, **request.query_parameters, format: :geojson),
            class: "float-right small clear",
            target: "_blank" %>

<%= form_tag admin_budget_budget_investments_path(@budget), method: :get, class: "geojson-export-filter float-right" do %>
  <%= label_tag :source_filter, t("admin.budget_investments.index.source_filter_label") %>
  <%= select_tag :source_filter,
                 options_for_select(
                   [
                     [t("admin.budget_investments.index.source_all"), "all"],
                     [t("admin.budget_investments.index.source_masterportal"), "masterportal"],
                     [t("admin.budget_investments.index.source_user"), "user"]
                   ],
                   params[:source_filter]
                 ) %>
  <%= submit_tag t("admin.budget_investments.index.apply_filter"), class: "button small hollow" %>
<% end %>

<% if @investments.any? %>
  <h3 class="inline-block"><%= page_entries_info @investments %></h3>
  <%= render "admin/shared/columns_selector",
        cookie: "investments-columns", default: %w[id title total_votes total_ballot_votes winner feasibility price valuation_finished preselected selected] %>
  <br>

  <%= render "admin/budget_investments/filters_description", i18n_namespace: "admin.budget_investments.index" %>

  <table class="table-for-mobile column-selectable">
    <thead>
      <tr>
        <th><%= link_to_investments_sorted_by :id %></th>
        <th><%= t("admin.budget_investments.index.list.created_at") %></th>
        <th data-field="title"><%= link_to_investments_sorted_by :title %></th>
        <th data-field="feasibility"><%= t("admin.budget_investments.index.list.feasibility") %></th>
        <th data-field="valuation_finished">
          <%= t("admin.budget_investments.index.list.valuation_finished") %>
        </th>
        <th data-field="total_votes"><%= link_to_investments_sorted_by :total_votes %></th>
        <th data-field="preselected"><%= t("admin.budget_investments.index.list.preselected", preselected_count: @budget.investments.preselected.count) %></th>
        <th data-field="selected"><%= t("admin.budget_investments.index.list.selected") %></th>
        <% if @budget.show_money? %>
          <th data-field="price"><%= t("admin.budget_investments.index.list.price") %></th>
        <% end %>
        <th data-field="balloters"><%= link_to_investments_sorted_by :balloters %></th>
        <th data-field="total_ballot_votes"><%= link_to_investments_sorted_by :total_ballot_votes %></th>
        <th data-field="district">Gebiet</th>
        <th data-field="winner"><%= t("admin.budget_investments.index.list.winner") %></th>
        <th data-field="admin"><%= t("admin.budget_investments.index.list.admin") %></th>
        <th data-field="author">
          <%= t("admin.budget_investments.index.list.author") %>
        </th>
        <th data-field="valuator">
          <%= t("admin.budget_investments.index.list.valuator") %>
        </th>
        <th data-field="pdf_link">
          <%= t("admin.budget_investments.index.list.pdf_link") %>
        </th>
      </tr>
    </thead>

    <tbody>
      <% @investments.each do |investment| %>
        <tr id="<%= dom_id(investment) %>" class="budget_investment">
          <%= render "/admin/budget_investments/select_investment", investment: investment %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @investments %>
<% else %>
  <div class="callout primary clear">
    <%= t("admin.budget_investments.index.no_budget_investments") %>
  </div>
<% end %>
