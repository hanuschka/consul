<%= form_for([:admin, setting], html: { style: "min-width: 500px;display: flex;gap: 12px;" }) do |f| %>
  <%= f.hidden_field :tab, id: dom_id(setting, :tab), value: tab if defined?(tab) %>
  <%= f.text_area :value,
    label: false,
    id: dom_id(setting, :value),
    "aria-label": strip_tags(t("settings.#{setting.key}")),
    "aria-describedby": dom_id(setting, :description) %>

  <% unless embedded? %>
    <%= f.submit(t("admin.settings.index.update_setting"), class: "button hollow expanded", style: "width:200px") %>
  <% end %>
<% end %>
