<!-- Warenkorb-Icon (nur auf Pflegeartikel-Seiten) -->
<div class="care-cart-wrapper">
  <button class="care-cart-trigger" id="care-cart-trigger" title="Warenkorb">
    🛒
    <span class="care-cart-badge" id="care-cart-badge" style="display:none;">0</span>
  </button>

  <!-- Slide-In Panel -->
  <div class="care-cart-panel" id="care-cart-panel">
    <div class="care-cart-panel-header">
      <h3>Ihr Warenkorb</h3>
      <button class="care-cart-close" id="care-cart-close">✕</button>
    </div>
    <div class="care-cart-panel-items" id="care-cart-panel-items">
      <p class="care-cart-empty">Ihr Warenkorb ist leer.</p>
    </div>
    <div class="care-cart-panel-footer">
      <!-- Gutscheincode -->
      <div class="care-coupon-wrap">
        <input type="text"
               class="care-coupon-input"
               id="care-coupon-input"
               placeholder="Gutscheincode eingeben …">
        <button class="care-coupon-btn" id="care-coupon-btn">Einlösen</button>
      </div>
      <div class="care-coupon-msg" id="care-coupon-msg"></div>

      <div class="care-cart-subtotal-row">
        <span>Zwischensumme:</span>
        <span id="care-cart-subtotal">0,00 €</span>
      </div>
      <div class="care-cart-discount-row" id="care-cart-discount-row" style="display:none;">
        <span id="care-cart-discount-label">Rabatt:</span>
        <span id="care-cart-discount-val" class="care-discount-val">−0,00 €</span>
      </div>
      <div class="care-cart-total-row">
        <span>Gesamt:</span>
        <strong id="care-cart-total">0,00 €</strong>
      </div>
      <button class="care-btn-checkout">Zur Kasse →</button>
      <div class="care-trust-badges">
        <span class="care-trust-badge" title="Sichere Zahlung">🔒 Sicher</span>
        <span class="care-trust-badge" title="Kostenlose Rückgabe">↩ Gratis Rückgabe</span>
        <span class="care-trust-badge" title="Schneller Versand">🚚 2–3 Tage</span>
      </div>
    </div>
  </div>
  <div class="care-cart-overlay" id="care-cart-overlay"></div>
</div>

<!-- Toast-Benachrichtigung -->
<div class="care-toast" id="care-toast"></div>
