<!-- Vergleichs-Leiste (floating, erscheint beim Auswählen von Produkten) -->
<div class="care-compare-bar" id="care-compare-bar">
  <span class="care-cbar-label">Vergleichen:</span>
  <div class="care-compare-bar-items" id="care-compare-bar-items"></div>
  <span class="care-cbar-count" id="care-cbar-count"></span>
  <div class="care-cbar-actions">
    <button class="care-btn-compare-now" id="care-compare-now" disabled>
      Jetzt vergleichen →
    </button>
    <button class="care-btn-compare-clear" id="care-compare-clear">
      Auswahl löschen
    </button>
  </div>
</div>

<!-- Vergleichs-Modal -->
<div class="care-compare-backdrop" id="care-compare-backdrop"></div>
<div class="care-compare-modal" id="care-compare-modal">
  <div class="care-compare-modal-header">
    <h3>Produktvergleich</h3>
    <button class="care-compare-modal-close" id="care-compare-modal-close">✕</button>
  </div>
  <div class="care-compare-modal-body">
    <table class="care-compare-table">
      <tbody id="care-compare-table-body"></tbody>
    </table>
  </div>
</div>
