<div class="care-newsletter-popup" id="care-newsletter-popup" role="dialog" aria-modal="true" aria-label="Newsletter anmelden">
  <button class="care-popup-close" id="care-popup-close" aria-label="Schließen">✕</button>
  <div class="care-popup-icon">🎁</div>
  <h2 class="care-popup-title">10 % Rabatt sichern!</h2>
