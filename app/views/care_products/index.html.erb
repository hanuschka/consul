             class="care-popup-input"
             placeholder="Ihre E-Mail-Adresse"
             autocomplete="email">
      <button class="care-popup-submit" id="care-popup-submit">Jetzt sparen</button>
    </div>
    <button class="care-popup-skip" id="care-popup-skip">Nein danke, ich verzichte auf 10 % Rabatt</button>
  </div>
  <div id="care-popup-success" style="display:none;" class="care-popup-success-area">
