<% content_for :title, "Pflegeartikel – Naturpflege für Ihr Wohlbefinden" %>
<% content_for :body_class, "care-products-page" %>
<%= render "care_products/cart" %>
<%= render "care_products/promo_bar" %>
<%= render "care_products/compare" %>

<!-- Scroll-to-Top -->
<button class="care-scroll-top" id="care-scroll-top" title="Nach oben">↑</button>

<!-- Hero-Bereich -->
<section class="care-hero">
  <div class="care-hero-overlay">
    <div class="row">
      <div class="small-12 column text-center">
        <h1 class="care-hero-title">Natürliche Pflegeartikel</h1>
        <p class="care-hero-subtitle">
          Entdecken Sie unsere sorgfältig ausgewählten Pflegeprodukte –
          für Ihr tägliches Wohlbefinden
        </p>
        <a href="#angebote" class="button care-btn-primary care-btn-hero-sale">
          🏷 Aktuelle Angebote
        </a>
        <a href="#produkte" class="button care-btn-primary care-btn-hero-ghost">
          Alle Produkte
        </a>
        <div class="care-hero-quiz-hint">
          Noch unsicher? <button class="care-quiz-trigger" id="care-quiz-trigger">✨ Hauttyp-Quiz starten</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sale / Angebote -->
<section class="care-sale" id="angebote">
  <div class="row">
    <div class="small-12 column">
      <div class="care-sale-header">
        <div class="care-sale-label">🏷 Aktuelle Angebote</div>
        <h2 class="care-section-title">Wochendeal – Bis zu 36 % sparen</h2>
        <div class="care-sale-countdown" id="care-countdown">
          Angebot endet in: <span id="care-countdown-timer">--:--:--</span>
        </div>
      </div>
    </div>
  </div>
  <div class="row small-up-1 medium-up-2 large-up-4 care-sale-grid">
    <% @sale_products.each do |item| %>
      <div class="column">
        <div class="care-sale-card">
          <div class="care-sale-discount-badge">−<%= item[:discount] %>%</div>
          <div class="care-sale-image">
            <span class="care-sale-emoji"><%= item[:icon] %></span>
          </div>
          <div class="care-sale-body">
            <h3 class="care-sale-name"><%= item[:name] %></h3>
            <div class="care-sale-prices">
              <span class="care-sale-original"><%= item[:original_price] %></span>
              <span class="care-sale-price"><%= item[:sale_price] %></span>
            </div>
            <button class="care-btn-sale-cart"
                    data-care-add-cart="true"
                    data-product-id="sale-<%= item[:id] %>"
                    data-product-name="<%= item[:name] %> (Sale)"
                    data-product-price="<%= item[:sale_price] %>"
                    data-product-emoji="<%= item[:icon] %>">
              In den Warenkorb
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<!-- Kategorien -->
<section class="care-categories">
  <div class="row">
    <div class="small-12 column">
      <h2 class="care-section-title">Unsere Kategorien</h2>
      <p class="care-section-subtitle">Finden Sie die perfekte Pflege für jeden Bedarf</p>
    </div>
  </div>
  <div class="row small-up-2 medium-up-3 large-up-6 care-categories-grid">
    <% @categories.each do |category| %>
      <div class="column">
        <%= link_to care_products_path(category: category[:id]), class: "care-category-card #{"active" if params[:category] == category[:id]}" do %>
          <span class="care-category-icon"><%= category[:icon] %></span>
          <h3 class="care-category-name"><%= category[:name] %></h3>
          <p class="care-category-desc"><%= category[:description] %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<!-- Such- und Sortierleiste -->
<section class="care-search-bar" id="produkte">
  <div class="row">
    <div class="small-12 medium-6 column">
      <div class="care-search-wrap">
        <span class="care-search-icon">🔍</span>
        <input type="text"
               id="care-search-input"
               class="care-search-input"
               placeholder="Produkt suchen …"
               autocomplete="off">
        <button class="care-search-clear" id="care-search-clear" style="display:none;">✕</button>
      </div>
    </div>
    <div class="small-12 medium-3 column">
      <select class="care-sort-select" id="care-sort-select">
        <option value="default">Sortierung</option>
        <option value="price-asc">Preis aufsteigend</option>
        <option value="price-desc">Preis absteigend</option>
        <option value="rating-desc">Beste Bewertung</option>
        <option value="reviews-desc">Meiste Bewertungen</option>
        <option value="name-asc">Name A–Z</option>
      </select>
    </div>
    <div class="small-12 medium-2 column">
      <button class="care-filter-toggle" id="care-filter-toggle">
        🎛 Filter
        <span class="care-filter-badge" id="care-filter-badge" style="display:none;">0</span>
      </button>
    </div>
    <div class="small-12 medium-1 column">
      <div class="care-results-count" id="care-results-count">
        <%= @featured_products.length %> Produkte
      </div>
    </div>
  </div>

  <!-- Erweiterte Filter -->
  <div class="row">
    <div class="small-12 column">
      <div class="care-advanced-filter-panel" id="care-advanced-filter-panel">
        <div class="care-filter-grid">
          <!-- Preis-Filter -->
          <div class="care-filter-group">
            <span class="care-filter-group-label">Preis (€)</span>
            <div class="care-price-range">
              <input type="number" id="care-filter-min-price" placeholder="Von" min="0" max="100" step="1">
              <span class="care-price-sep">–</span>
              <input type="number" id="care-filter-max-price" placeholder="Bis" min="0" max="100" step="1">
            </div>
            <div class="care-price-vals">
              Von <span id="care-filter-min-val">0 €</span> bis <span id="care-filter-max-val">∞</span>
            </div>
          </div>

          <!-- Mindest-Bewertung -->
          <div class="care-filter-group">
            <span class="care-filter-group-label">Mindestbewertung</span>
            <div class="care-rating-filter-btns">
              <% (1..5).each do |n| %>
                <button class="care-rating-filter-btn" data-rating="<%= n %>">
                  <%= "★" * n %> <%= n %>+
                </button>
              <% end %>
            </div>
          </div>

          <!-- Nur mit Badge -->
          <div class="care-filter-group">
            <span class="care-filter-group-label">Weitere Filter</span>
            <label class="care-badge-toggle-wrap">
              <input type="checkbox" id="care-filter-badge-toggle">
              Nur Produkte mit Auszeichnung
            </label>
          </div>
        </div>

        <div class="care-filter-actions">
          <button class="care-btn-filter-reset" id="care-filter-reset-btn">
            Alle Filter zurücksetzen
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Produkte -->
<section class="care-products">
  <% if @selected_category %>
    <div class="row">
      <div class="small-12 column">
        <% cat = @categories.find { |c| c[:id] == @selected_category } %>
        <p class="care-active-filter">
          Kategorie: <strong><%= cat&.dig(:name) %></strong>
          <%= link_to "× Zurücksetzen", care_products_path, class: "care-filter-reset" %>
        </p>
      </div>
    </div>
  <% end %>

  <div class="row small-up-1 medium-up-2 large-up-3 care-products-grid" id="care-products-grid">
    <% @featured_products.each do |product| %>
      <% cat_icon = @categories.find { |c| c[:id] == product[:category] }&.dig(:icon) %>
      <% cat_name = @categories.find { |c| c[:id] == product[:category] }&.dig(:name) %>
      <div class="column care-product-col"
           data-name="<%= product[:name].downcase %>"
           data-category="<%= product[:category] %>"
           data-price="<%= product[:price_cents] %>"
           data-rating="<%= product[:rating] %>"
           data-reviews="<%= product[:reviews] %>"
           data-badge="<%= product[:badge] || "" %>">
        <div class="care-product-card">
          <% if product[:badge] %>
            <span class="care-product-badge"><%= product[:badge] %></span>
          <% end %>
          <!-- Wunschliste-Herz -->
          <button class="care-wishlist-btn"
                  data-product-id="<%= product[:id] %>"
                  data-product-name="<%= product[:name] %>"
                  title="Zur Wunschliste hinzufügen">
            ♡
          </button>
          <div class="care-product-image">
            <div class="care-product-image-placeholder">
              <span class="care-product-emoji"><%= cat_icon || "🧴" %></span>
            </div>
          </div>
          <div class="care-product-body">
            <span class="care-product-category"><%= cat_name %></span>
            <h3 class="care-product-name"><%= product[:name] %></h3>
            <p class="care-product-description"><%= product[:description] %></p>
            <div class="care-product-rating">
              <% stars = product[:rating].round %>
              <% stars.times do %><span class="care-star care-star-filled">★</span><% end %>
              <% (5 - stars).times do %><span class="care-star">☆</span><% end %>
              <span class="care-rating-value"><%= product[:rating] %></span>
              <span class="care-rating-count">(<%= product[:reviews] %> Bewertungen)</span>
            </div>
            <div class="care-social-proof-badge" style="display:none;"></div>
            <div class="care-product-footer">
              <span class="care-product-price"><%= product[:price] %></span>
              <div class="care-product-actions">
                <button class="care-btn-add-cart"
                        data-care-add-cart="true"
                        data-product-id="<%= product[:id] %>"
                        data-product-name="<%= product[:name] %>"
                        data-product-price="<%= product[:price] %>"
                        data-product-emoji="<%= cat_icon %>">
                  In den Warenkorb
                </button>
                <%= link_to "Details", care_product_path(product[:id]), class: "care-btn-outline care-btn-detail-link" %>
              </div>
              <div style="margin-top:8px;">
                <button class="care-compare-btn"
                        data-product-id="<%= product[:id] %>"
                        data-product-name="<%= product[:name] %>"
                        data-product-price="<%= product[:price] %>"
                        data-product-emoji="<%= cat_icon || "🧴" %>"
                        data-product-rating="<%= product[:rating] %>"
                        data-product-reviews="<%= product[:reviews] %>"
                        data-product-category="<%= cat_name %>"
                        data-product-badge="<%= product[:badge] || "" %>"
                        data-product-desc="<%= product[:description] %>">
                  <span class="care-compare-label">⇌ Vergleichen</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Keine Ergebnisse -->
  <div class="row" id="care-no-results" style="display:none;">
    <div class="small-12 column text-center care-no-results">
      <span class="care-no-results-icon">🔍</span>
      <h3>Keine Produkte gefunden</h3>
      <p>Versuchen Sie einen anderen Suchbegriff oder setzen Sie die Filter zurück.</p>
      <button class="care-btn-reset-search" id="care-btn-reset-search">Suche zurücksetzen</button>
    </div>
  </div>
</section>

<!-- Wunschliste-Panel -->
<div class="care-wishlist-panel" id="care-wishlist-panel">
  <div class="care-wishlist-header">
    <h3>Meine Wunschliste</h3>
    <button class="care-cart-close" id="care-wishlist-close">✕</button>
  </div>
  <div class="care-wishlist-items" id="care-wishlist-items">
    <p class="care-cart-empty">Ihre Wunschliste ist leer.</p>
  </div>
</div>

<!-- Vorteile / USPs -->
<section class="care-benefits">
  <div class="row">
    <div class="small-12 column text-center">
      <h2 class="care-section-title care-section-title-light">Warum uns wählen?</h2>
    </div>
  </div>
  <div class="row small-up-1 medium-up-2 large-up-4">
    <div class="column">
      <div class="care-benefit-card">
        <div class="care-benefit-icon">🌿</div>
        <h3>Natürliche Inhaltsstoffe</h3>
        <p>Alle Produkte bestehen aus sorgfältig ausgewählten, natürlichen Rohstoffen ohne schädliche Zusätze.</p>
      </div>
    </div>
    <div class="column">
      <div class="care-benefit-card">
        <div class="care-benefit-icon">🔬</div>
        <h3>Dermatologisch getestet</h3>
        <p>Jedes Produkt wurde durch unabhängige Dermatologinnen und Dermatologen geprüft und zertifiziert.</p>
      </div>
    </div>
    <div class="column">
      <div class="care-benefit-card">
        <div class="care-benefit-icon">♻️</div>
        <h3>Nachhaltig verpackt</h3>
        <p>Wir verwenden recycelbare und umweltfreundliche Verpackungen für eine bessere Zukunft.</p>
      </div>
    </div>
    <div class="column">
      <div class="care-benefit-card">
        <div class="care-benefit-icon">🚚</div>
        <h3>Schnelle Lieferung</h3>
        <p>Kostenloser Versand ab 25 € – Ihre Bestellung kommt innerhalb von 2–3 Werktagen an.</p>
      </div>
    </div>
  </div>
</section>

<!-- Pflegetipps -->
<section class="care-tips">
  <div class="row">
    <div class="small-12 column">
      <h2 class="care-section-title">Pflegetipps &amp; Wissen</h2>
      <p class="care-section-subtitle">Expertenwissen für Ihre tägliche Pflegeroutine</p>
    </div>
  </div>
  <div class="row small-up-1 medium-up-3 care-tips-grid">
    <div class="column">
      <article class="care-tip-card">
        <div class="care-tip-image">
          <span class="care-tip-emoji">💧</span>
        </div>
        <div class="care-tip-body">
          <span class="care-tip-tag">Hautpflege</span>
          <h3 class="care-tip-title">Die richtige Feuchtigkeitspflege für jeden Hauttyp</h3>
          <p class="care-tip-excerpt">
            Ob trockene, fettige oder Mischhaut – die richtige Creme macht den Unterschied.
            Wir erklären, worauf Sie bei der Auswahl achten sollten und welche Inhaltsstoffe wirklich helfen.
          </p>
          <div class="care-tip-meta">
            <span class="care-tip-date">15. Februar 2026</span>
            <span class="care-tip-read">5 Min Lesezeit</span>
          </div>
          <a href="#" class="care-tip-link">Weiterlesen →</a>
        </div>
      </article>
    </div>
    <div class="column">
      <article class="care-tip-card">
        <div class="care-tip-image care-tip-image-green">
          <span class="care-tip-emoji">🌿</span>
        </div>
        <div class="care-tip-body">
          <span class="care-tip-tag">Inhaltsstoffe</span>
          <h3 class="care-tip-title">Natürliche Inhaltsstoffe: Was steckt in Ihren Pflegeprodukten?</h3>
          <p class="care-tip-excerpt">
            Hyaluronsäure, Retinol, Ceramide – viele Begriffe kursieren in der Beautybranche.
            Wir erklären, welche Wirkstoffe wirklich funktionieren und welche Sie meiden sollten.
          </p>
          <div class="care-tip-meta">
            <span class="care-tip-date">8. Februar 2026</span>
            <span class="care-tip-read">7 Min Lesezeit</span>
          </div>
          <a href="#" class="care-tip-link">Weiterlesen →</a>
        </div>
      </article>
    </div>
    <div class="column">
      <article class="care-tip-card">
        <div class="care-tip-image care-tip-image-sun">
          <span class="care-tip-emoji">☀️</span>
        </div>
        <div class="care-tip-body">
          <span class="care-tip-tag">Sonnenpflege</span>
          <h3 class="care-tip-title">Sonnenschutz: Das müssen Sie das ganze Jahr über beachten</h3>
          <p class="care-tip-excerpt">
            UV-Strahlung schadet auch im Winter. Erfahren Sie, warum täglicher Sonnenschutz
            der wichtigste Anti-Aging-Schritt ist und wie Sie den richtigen LSF wählen.
          </p>
          <div class="care-tip-meta">
            <span class="care-tip-date">1. Februar 2026</span>
            <span class="care-tip-read">4 Min Lesezeit</span>
          </div>
          <a href="#" class="care-tip-link">Weiterlesen →</a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Pflegepakete / Bundles -->
<section class="care-bundles">
  <div class="row">
    <div class="small-12 column text-center">
      <div class="care-bundles-label">📦 Vorteilspakete</div>
      <h2 class="care-section-title">Spare mehr mit unseren Bundles</h2>
      <p class="care-section-subtitle">Aufeinander abgestimmte Produkte – zu einem unschlagbaren Paketpreis</p>
    </div>
  </div>
  <div class="row small-up-1 medium-up-3 care-bundles-grid">
    <% @bundles.each do |bundle| %>
      <% bp = bundle[:product_ids].map { |pid| @all_products.find { |p| p[:id] == pid } }.compact %>
      <% cat_icons = bp.map { |p| @categories.find { |c| c[:id] == p[:category] }&.dig(:icon) || "🧴" } %>
      <div class="column">
        <div class="care-bundle-card">
          <span class="care-bundle-badge"><%= bundle[:badge] %></span>
          <div class="care-bundle-icon"><%= bundle[:icon] %></div>
          <h3 class="care-bundle-name"><%= bundle[:name] %></h3>
          <p class="care-bundle-desc"><%= bundle[:description] %></p>
          <ul class="care-bundle-items">
            <% bp.each_with_index do |p, i| %>
              <li><span class="care-bundle-item-icon"><%= cat_icons[i] %></span> <%= p[:name] %></li>
            <% end %>
          </ul>
          <div class="care-bundle-pricing">
            <span class="care-bundle-original"><%= bundle[:original_price] %></span>
            <span class="care-bundle-price"><%= bundle[:bundle_price] %></span>
            <span class="care-bundle-savings">Sie sparen <%= bundle[:savings] %></span>
          </div>
          <button class="care-bundle-add-btn"
                  data-bundle-id="<%= bundle[:id] %>"
                  data-product-ids="<%= bp.map { |p| p[:id] }.join("|") %>"
                  data-product-names="<%= bp.map { |p| p[:name] }.join("|") %>"
                  data-product-prices="<%= bp.map { |p| p[:price] }.join("|") %>"
                  data-product-emojis="<%= cat_icons.join("|") %>">
            Paket in den Warenkorb
          </button>
        </div>
      </div>
    <% end %>
  </div>
</section>

<!-- FAQ-Bereich -->
<section class="care-faq">
  <div class="row">
    <div class="small-12 column text-center">
      <h2 class="care-section-title">Häufige Fragen</h2>
      <p class="care-section-subtitle">Alles, was Sie über unsere Pflegeprodukte wissen möchten</p>
    </div>
  </div>
  <div class="row">
    <div class="small-12 column">
      <div class="care-faq-list">

        <div class="care-faq-item">
          <button class="care-faq-question">
            Sind alle Produkte dermatologisch getestet?
            <span class="care-faq-icon">+</span>
          </button>
          <div class="care-faq-answer">
            Ja, alle unsere Pflegeprodukte wurden von unabhängigen Dermatologen geprüft
            und zertifiziert. Wir legen größten Wert auf Sicherheit und Verträglichkeit –
            besonders für empfindliche Haut.
          </div>
        </div>

        <div class="care-faq-item">
          <button class="care-faq-question">
            Ab welchem Bestellwert ist der Versand kostenlos?
            <span class="care-faq-icon">+</span>
          </button>
          <div class="care-faq-answer">
            Ab einem Bestellwert von 25 € liefern wir kostenlos innerhalb Deutschlands.
            Für kleinere Bestellungen berechnen wir eine pauschale Versandgebühr von 3,99 €.
            Die Lieferzeit beträgt 2–3 Werktage.
          </div>
        </div>

        <div class="care-faq-item">
          <button class="care-faq-question">
            Kann ich Produkte zurücksenden?
            <span class="care-faq-icon">+</span>
          </button>
          <div class="care-faq-answer">
            Selbstverständlich! Sie haben 30 Tage Zeit, unbenutzte Produkte in der
            Originalverpackung zurückzusenden. Der Rückversand ist für Sie völlig
            kostenlos. Nach Eingang der Rücksendung erstatten wir den Kaufpreis
            innerhalb von 5 Werktagen.
          </div>
        </div>

        <div class="care-faq-item">
          <button class="care-faq-question">
            Sind die Produkte vegan und tierversuchsfrei?
            <span class="care-faq-icon">+</span>
          </button>
          <div class="care-faq-answer">
            Alle unsere Produkte sind 100 % vegan und werden nicht an Tieren getestet.
            Wir verzichten konsequent auf tierische Inhaltsstoffe wie Lanolin, Bienenwachs
            oder Kollagen und setzen ausschließlich auf pflanzliche Alternativen.
          </div>
        </div>

        <div class="care-faq-item">
          <button class="care-faq-question">
            Wie funktionieren die Gutscheincodes?
            <span class="care-faq-icon">+</span>
          </button>
          <div class="care-faq-answer">
            Gutscheincodes können Sie direkt im Warenkorb einlösen. Klicken Sie auf das
            Warenkorb-Symbol, geben Sie Ihren Code im Feld „Gutscheincode eingeben" ein
            und klicken Sie auf „Einlösen". Der Rabatt wird sofort vom Gesamtbetrag
            abgezogen. Aktuell gültige Codes finden Sie in unserem Newsletter.
          </div>
        </div>

        <div class="care-faq-item">
          <button class="care-faq-question">
            Welche Inhaltsstoffe werden in Ihren Produkten verwendet?
            <span class="care-faq-icon">+</span>
          </button>
          <div class="care-faq-answer">
            Wir verwenden ausschließlich hochwertige, natürliche Wirkstoffe wie
            Hyaluronsäure, Aloe Vera, Arganöl, Sheabutter, Vitamin E und Panthenol.
            Auf synthetische Duftstoffe, Parabene, Silikone und Mineralöle verzichten
            wir vollständig. Die vollständige Inhaltsstoffliste finden Sie auf jeder
            Produktdetailseite.
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="care-newsletter">
  <div class="row">
    <div class="small-12 medium-8 medium-centered column text-center">
      <h2 class="care-newsletter-title">Bleiben Sie informiert</h2>
      <p class="care-newsletter-text">
        Melden Sie sich für unseren Newsletter an und erhalten Sie exklusive Angebote,
        Pflegetipps und als Willkommensgeschenk 10 % Rabatt auf Ihre erste Bestellung.
      </p>
      <div class="care-newsletter-form">
        <input type="email" class="care-newsletter-input" placeholder="Ihre E-Mail-Adresse">
        <button class="care-btn-newsletter">Jetzt anmelden</button>
      </div>
    </div>
  </div>
</section>

<!-- Zuletzt angesehen -->
<section class="care-recently-viewed" id="care-recently-viewed" style="display:none;">
  <div class="row">
    <div class="small-12 column">
      <h2 class="care-section-title">Zuletzt angesehen</h2>
    </div>
  </div>
  <div class="row" id="care-recently-viewed-grid"></div>
</section>

<!-- Stats Strip -->
<section class="care-stats-strip" id="care-stats-strip">
  <div class="row">
    <div class="small-6 medium-3 column">
      <div class="care-stat-item">
        <div class="care-stat-num" data-target="12400" data-suffix="+">0</div>
        <div class="care-stat-label">Zufriedene Kunden</div>
      </div>
    </div>
    <div class="small-6 medium-3 column">
      <div class="care-stat-item">
        <div class="care-stat-num" data-target="98" data-suffix="%">0</div>
        <div class="care-stat-label">Würden uns empfehlen</div>
      </div>
    </div>
    <div class="small-6 medium-3 column">
      <div class="care-stat-item">
        <div class="care-stat-num" data-target="48" data-suffix="">0</div>
        <div class="care-stat-label">Produkte im Sortiment</div>
      </div>
    </div>
    <div class="small-6 medium-3 column">
      <div class="care-stat-item">
        <div class="care-stat-num" data-target="5" data-suffix=" Jahre">0</div>
