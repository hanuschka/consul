<% assets = local_assigns[:assets] || @assets %>
<% if assets.respond_to?(:current_page) && assets.total_pages > 1 %>
  <div class="file-upload-manager-dialog--pagination">
    <%= paginate assets,
        params: { type: params[:type], search: params[:search] },
        remote: false,
        class: 'js-cb-img-pagination' %>
  </div>
<% end %>
