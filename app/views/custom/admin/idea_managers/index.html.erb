<h2 class="inline-block"><%= t("custom.admin.idea_managers.index.title") %></h2>

<%= render "admin/shared/user_search", url: search_admin_idea_managers_path %>

<div id="idea_managers">
  <% if @idea_managers.any? %>
    <h3><%= page_entries_info @idea_managers %></h3>

    <table>
      <thead>
        <th scope="col"><%= Moderator.human_attribute_name(:name) %></th>
        <th scope="col" class="small-6"><%= Moderator.human_attribute_name(:email) %></th>
        <th scope="col" class="small-3"><%= t("admin.shared.actions") %></th>
      </thead>
      <tbody>
        <% @idea_managers.each do |idea_manager| %>
          <tr>
            <td>
              <%= idea_manager.name %>
            </td>
            <td>
              <%= idea_manager.email %>
            </td>
            <td>
              <%= render Admin::Roles::TableActionsComponent.new(idea_manager) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= paginate @idea_managers %>
  <% else %>
    <div class="callout primary">
      <%= t("custom.admin.idea_managers.index.no_idea_managers") %>
    </div>
  <% end %>
</div>
