<%= render "custom/admin/projekt_phases/heading" %>

<% unless embedded? %>
  <%= render "custom/admin/projekt_phases/nav_bar" %>
<% end %>

<div class="row">
  <div class="column">
    <h2>
      <%= t("custom.admin.projekt_phases.ai_settings.page_title") %>
      <%= render Shared::ExplainButtonComponent.new(
        explain: "AI Settings for projekt phase"
      ) %>
    </h2>
  </div>
</div>

<%= form_with url: namespace_projekt_phase_path(action: "update_ai_settings"), method: :patch, scope: :projekt_phase, id: "phase-edit-form" do |f| %>
  <%= hidden_field_tag :action_name, action_name %>

  <div class="row margin-bottom">
    <div class="column large-8 small-12">
      <%= f.text_area(
        :questions,
        label: t("custom.admin.projekt_phases.ai_settings.questions"),
        value: @ai_assistant_config["questions"],
        rows: 5,
        style: "field-sizing: content"
      ) %>
    </div>
  </div>

  <div class="row margin-bottom">
    <div class="column large-8 small-12">
      <%= f.text_area(
        :restrictions,
        label: t("custom.admin.projekt_phases.ai_settings.restrictions"),
        value: @ai_assistant_config["restrictions"],
        style: "",
        rows: 5,
        style: "field-sizing: content"
      ) %>
    </div>
  </div>

  <div class="row margin-bottom">
    <div class="column large-8 small-12">
      <%= f.text_area(
        :parting_words,
        label: t("custom.admin.projekt_phases.ai_settings.parting_words"),
        value: @ai_assistant_config["parting_words"],
        style: "",
        rows: 5,
        style: "field-sizing: content"
      ) %>
    </div>
  </div>

  <div class="row">
    <div class="column">
      <%= f.submit(t("custom.admin.projekt_phases.shared.update_button"), class: "button success") %>
    </div>
  </div>
<% end %>

<% if embedded? %>
  <% content_for :admin_frame_top_navigation do %>
    <%= render Admin::ProjektPhases::FrameNavigationComponent.new(projekt_phase: @projekt_phase, show_title: true) %>
  <% end %>
  <%= content_for :admin_frame_bottom_navigation do %>
    <%= render Admin::ProjektPhases::FrameNavigationComponent.new(projekt_phase: @projekt_phase) %>
  <% end %>
<% end %>
