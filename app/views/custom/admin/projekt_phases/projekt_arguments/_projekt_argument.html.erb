<div class='small-12 medium-7 projekt-argument' id="<%= dom_id(projekt_argument) %>">
  <div class='projekt-argument-content'>
    <div class="projekt-argument-image-column">
      <% if projekt_argument.image.present? %>
        <%= image_tag(projekt_argument.image.variant(:medium)) %>
      <% end %>
    </div>

    <div class="projekt-argument-text-column">
      <p class="projekt-argument-row">
        <b><%= ProjektArgument.human_attribute_name(:name) %>:</b>
        <%= projekt_argument.name %>
      </p>
      <p class="projekt-argument-row">
        <b><%= ProjektArgument.human_attribute_name(:party) %>:</b>
        <%= projekt_argument.party %>
      </p>
      <p class="projekt-argument-row">
        <b><%= ProjektArgument.human_attribute_name(:position) %>:</b>
        <%= projekt_argument.position %>
      </p>
      <p class="projekt-argument-row">
        <b><%= ProjektArgument.human_attribute_name(:note) %>:</b>
        <%= projekt_argument.note %>
      </p>
    </div>
  </div>

  <%= link_to "", polymorphic_path([@namespace, @projekt_phase, projekt_argument], action: :edit), remote: true, class: "edit-projekt-argument", style: "margin-right:20px;" %>
  <%= link_to "", polymorphic_path([@namespace, @projekt_phase, projekt_argument]), method: :delete, class: "delete-projekt-argument" %>
  <hr>
</div>
