<%= form_for([:admin, @projekt_phase, @category], remote: true) do |f| %>
  <% if @category.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@category.errors.count, "error") %> prohibited this category from being saved:</h2>
      <ul>
        <% @category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <div class="small-12 medium-6">
    <div class="form-group">
      <%= f.label :name %>
      <%= f.text_field :name, label: false %>
    </div>
  </div>

  <div class="small-12 medium-6">
    <div class="form-group">
      <%= f.label :color %>
      <%= f.color_field :color, label: false %>
    </div>
  </div>

  <div class="small-12 medium-6">
    <div class="form-group">
      <%= f.select(
        :icon,
        options_for_select([
          ["Map Marker", "fa-map-marker"],
          ["Info Circle", "fa-info-circle"],
          ["Exclamation Circle", "fa-exclamation-circle"],
          ["Question Circle", "fa-question-circle"],
          ["Star", "fa-star"],
          ["Heart", "fa-heart"],
          ["Flag", "fa-flag"],
          ["Building", "fa-building"],
          ["Tree", "fa-tree"],
          ["Car", "fa-car"]
        ], @category.icon),
        { include_blank: true },
        { label: false }
      ) %>
    </div>
  </div>

  <div class="small-12">
    <%= f.submit class: "button" %>
  </div>
<% end %>
