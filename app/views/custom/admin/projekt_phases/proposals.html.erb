<%= render "custom/admin/projekt_phases/heading" %>

<%= render "custom/admin/projekt_phases/nav_bar" %>

<div class="row">
  <div class="column">
    <h2>
      <%= t("custom.admin.projekt_phases.proposals.page_title") %>

    </h2>
  </div>
</div>

<div class="row">
  <div class="column">

    <div id="proposals-tab-content">
      <% if @proposals.any? %>
        <h3><%= page_entries_info @proposals %></h3>

        <div class="download-links">
          <%#= link_to "Vorschläge herunterladen", admin_proposals_path(format: :csv), target: "_blank", class: "small" %>
          <%#= link_to "Kommentare herunterladen", comments_admin_proposals_path(format: :csv), class: "small" %>
        </div>

        <table>
          <thead>
            <tr>
              <th class="text-center"><%= t("admin.proposals.index.id") %></th>
              <% if @projekt_phase.feature?("general.require_admin_acceptance") %>
                <th><%= t("custom.admin.proposals.index.admin_accepted") %></th>
              <% end %>
              <th><%= t("admin.proposals.index.title") %></th>
              <th><%= t("admin.proposals.index.author") %></th>
            </tr>
          </thead>

          <tbody>
            <% @proposals.each do |proposal| %>
              <tr id="<%= dom_id(proposal) %>" class="proposal">
                <td class="text-center"><%= proposal.id %></td>
                <% if @projekt_phase.feature?("general.require_admin_acceptance") %>
                  <td>
                    <%= render Admin::LivesubmitCheckbox::Component.new(
                      url: polymorphic_path([@namespace, @projekt_phase, proposal], action: :toggle_admin_accepted),
                      resource_name: "proposal",
                      attribute_name: "admin_accepted",
                      record_id: proposal.id,
                      current_value: proposal.admin_accepted
                    ) %>
                  </td>
                <% end %>
                <td><%= link_to proposal.title, polymorphic_path([@namespace, @projekt_phase, proposal]) %></td>
                <td><%= proposal.author.username %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <%= paginate @proposals %>
      <% else %>
        <div class="callout primary">
          <%= t("admin.proposals.index.no_proposals") %>
        </div>
      <% end %>
    </div>

  </div>
</div>
