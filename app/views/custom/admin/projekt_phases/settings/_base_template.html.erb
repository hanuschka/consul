<% projekt_phase_features = local_assigns[:projekt_phase_features] || [] %>
<% projekt_phase_options = local_assigns[:projekt_phase_options] || [] %>
<% projekt_phase_selectable_settings = local_assigns[:projekt_phase_selectable_settings] || [] %>

<%= render "custom/admin/projekt_phases/heading" %>

<%= render "custom/admin/projekt_phases/nav_bar" %>

<div class="row">
  <div class="column">
    <h2>
      <% if local_assigns[:title].present? %>
        <%= title %>
      <% end %>

    </h2>
  </div>
</div>

<% projekt_phase_features.each do |key, value| %>
  <%# <div class="row"> %>
  <%#   <div class="column"> %>
  <%#     <h2><%= t("custom.admin.projekt_phases.settings.block_title.#{key}") %1></h2> %>
  <%#   </div> %>
  <%# </div> %>
  <%= render "custom/admin/projekt_phases/settings/features_table", features: value %>
<% end %>

<% projekt_phase_options.each do |key, value| %>
  <%= render "custom/admin/projekt_phases/settings/options_table", options: value %>
<% end %>

<div class="row">
  <div class="column">
    <% projekt_phase_selectable_settings.each do |selectable_setting_set| %>
      <%= render Shared::ProjektSelectableSettingComponent.new(
        setting: selectable_setting_set.setting,
        options: selectable_setting_set.options,
        tab: "#tab-extended-features",
        i18n_key: selectable_setting_set.setting.i18n_key
      ) %>
    <% end %>
  </div>
</div>
