<div class="row">
  <div class="column">
    <table class="admin-settings-table">
      <thead>
        <tr>
          <th class="small-6"><%= t("admin.settings.setting") %></th>
          <th class="small-6"><%= t("admin.settings.index.features.enabled") %></th>
        </tr>
      </thead>
      <tbody>
        <% features.each do |feature| %>
          <% pro_setting = ProjektPhaseSetting::PRO_SETTINGS.find { |s| s == feature.key } %>

          <% if pro_setting.present? %>
            <% app = App.app_for_projekt_phase_setting(@projekt_phase, feature.key) %>
          <% end %>

          <tr>
            <td class='small-9'>
              <strong id="<%= dom_id(feature, :title) %>"><%= t("custom.projekt_phase_settings.#{@projekt_phase.resources_name}.#{feature.key}") %></strong>
              <% if embedded? %>
                <%= render Shared::ExplainButtonComponent.new(
                  explain: "projekt setting " + t("custom.projekt_phase_settings.#{@projekt_phase.resources_name}.#{feature.key}")
                ) %>
              <% end %>
              <br>
              <div class="small admin-setting-description">
                <%= t("custom.projekt_phase_settings.#{@projekt_phase.resources_name}.#{feature.key}_description", default: t("admin.settings.no_description")) %>

                <% if app.present? %>
                  <div>
                    <%= link_to "App in Store anzeigen", Dt.navigate_to_app_url(app.codename), target: "_blank" %>
                  </div>
                <% end %>
              </div>
            </td>

            <td>
              <div class="admin-projekt-phase-switch">
                <% if embedded_and_frame_access_code_valid?(@projekt) %>
                  <%= link_to "konfigurieren", '#' %>
                <% end %>
                <% if app.present? && app.inactive? %>
                  <div class="admin-setting-app-activate-link">
                    <%= link_to "Aktivieren", Dt.navigate_to_app_url(app.codename), target: "_blank" %>
                  </div>
                <% elsif app.present? && app.waiting_for_activation? %>
                  <div class="admin-setting-app-waiting-for-activation">
                    Aktivierung in Arbeit
                    <i class="fas fa-hourglass-half"></i>
                  </div>
                <% else %>
                  <%= render Admin::Settings::FeaturedSettingsFormComponent.new(feature) %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
