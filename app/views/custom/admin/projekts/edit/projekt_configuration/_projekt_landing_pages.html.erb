<div class="compact-config-block">
  <div class="margin-bottom">
    <%= form_for [@namespace, projekt] do |f| %>
      <%= f.collection_select(
        :landing_page_id,
        SiteCustomization::Page.landing,
        :id,
        :title,
        { include_blank: t("custom.admin.projekts.edit.no_landing_page") },
        { class: "margin-bottom" }
      ) %>
      <%= f.submit %>
    <% end %>
  </div>
</div>
