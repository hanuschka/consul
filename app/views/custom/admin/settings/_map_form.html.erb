<div class="margin-bottom">
  <%= render Shared::MapComponent.new(
    features: MapLocation.default.features,
    editable: true
  ) %>
</div>

<%= form_with model: MapLocation.default, url: admin_update_map_path, method: :put, id: "map-form" do |f| %>

  <%= f.collection_radio_buttons :rendering_library, MapLocation.rendering_libraries.keys.map { |key| [key, key] }, :first, :last do |b| %>
    <div style="display: inline-block; margin-right: 1rem;">
      <%= b.radio_button %>
      <%= b.label(class: "inline") %>
    </div>
  <% end %>

  <%= f.hidden_field :longitude, data: { longitude_input_for: "default_map" } %>
  <%= f.hidden_field :latitude, data: { latitude_input_for: "default_map" } %>
  <%= f.hidden_field :zoom, data: { zoom_input_for: "default_map" } %>
  <%= f.hidden_field :altitude, data: { altitude_input_for: "default_map" } %>
  <%= f.hidden_field :features,
                     value: MapLocation.default.features.is_a?(String) ? MapLocation.default.features : MapLocation.default.features.to_json,
                     data: { features_input_for: "default_map" } %>
  <%= hidden_field_tag :tab, '#tab-map-configuration' %>

  <div class="small-12 medium-6 large-4 margin-top">
    <%= f.submit t("admin.settings.index.map.form.submit"),
      class: "button hollow expanded",
      onclick: "document.getElementById('tab').value = window.location.hash;"
    %>
  </div>
<% end %>

