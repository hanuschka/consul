<%= form_with url: namespace_mappable_path(action: :update_map), model: mappable, as: :map_location do |f| %>
  <% i18n_scope = "shared.map_component" %>
  <div class="new-card" id='map-container'>
    <%= render "map_locations/form_fields",
      form:           f,
      mappable:       mappable,
      nesting_prefix: mappable.class.table_name %>
  </div>

  <%= f.submit(t("custom.user_resources.form.submit_button"), class: "button") %>
<% end %>
