<% has_criteria = @draft_resource.projekt_phase.user_resource_criteria.exists? %>
<% loader_message_key = has_criteria ? "ai_proposal_flow.loader.evaluating_message" : "ai_proposal_flow.loader.creating_message" %>
<% loader_submessage_key = has_criteria ? "ai_proposal_flow.loader.evaluating_submessage" : "ai_proposal_flow.loader.creating_submessage" %>

<main class="ai-proposal-flow--page">
  <%= render AiProposalFlow::HeaderComponent.new(projekt_phase: @draft_resource.projekt_phase, current_step: 2) %>

  <div
    class="new-card ai-proposal-flow--body ai-proposal-flow--edit-draft-body js-ai-flow-body js-ai-flow-step2-body"
    data-generate-image-url="<%= @generate_image_url %>"
    data-remove-image-url="<%= ai_remove_image_from_resource_path %>"
    data-aspect-ratio="16:9"
    data-image-prompt="<%= @draft_resource.ai_image_prompt %>"
    data-has-image="<%= @draft_resource.image.present? || @draft_resource.generated_image? %>"
    data-codename="<%= Ai::Settings.ai_available? ? @draft_resource.projekt_phase.try(:voice_assistant_codename) : nil %>"
    data-projekt-phase-id="<%= @draft_resource.projekt_phase&.id %>"
    data-resource-type="<%= @draft_resource.class.name %>"
    data-resource-id="<%= @draft_resource.id %>"
  >
    <div class="ai-proposal-flow--body-content js-ai-flow-body-content">
      <% if @draft_resource.is_a?(Proposal) %>
        <%= render UserResources::FormComponent.new(
          @draft_resource,
          url: @update_draft_url,
          title: t("proposals.new.start_new"),
          embbeded_in_ai_flow: true
        ) %>
      <% else %>
        <%= render Budgets::Investments::FormComponent.new(
          @draft_resource,
          url: @update_draft_url,
          embbeded_in_ai_flow: true
        ) %>
      <% end %>

      <%# Outside the form: the panel carries the matches with their own support
          buttons, and button_to inside a form is dropped by the HTML parser. %>
      <%= render SimilarContributions::DecisionComponent.new(@draft_resource) %>

      <div class="ai-proposal-flow--navigation">
        <button
          type="submit"
          form="<%= dom_id(@draft_resource, :form) %>"
          class="button ai-proposal-flow--navigation--submit js-ai-flow-step2-submit js-user-resource-submit"
        >
          <% if has_criteria %>
            <%= t("ai_proposal_flow.nav.next_evaluation") %> <i class="fas fa-arrow-right"></i>
          <% else %>
            <i class="fas fa-check"></i> <%= t("ai_proposal_flow.nav.create") %>
          <% end %>
        </button>
        <%= link_to @back_to_new_url, class: "button -outline" do %>
          <i class="fas fa-arrow-left"></i> <%= t("ai_proposal_flow.nav.back") %>
        <% end %>
      </div>
    </div>

    <%= render AiProposalFlow::AiLoaderComponent.new(
      message_key: loader_message_key,
      submessage_key: loader_submessage_key
    ) %>
  </div>

  <%# Outside the step body so the flow's own loader overlay never sits between
      the citizen and the check's modal. %>
  <%= render SimilarContributions::CheckSectionComponent.new(
    @draft_resource,
    embbeded_in_ai_flow: true
  ) %>
</main>
