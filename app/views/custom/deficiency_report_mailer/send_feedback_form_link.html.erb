<td style="padding-bottom: 20px; padding-left: 10px;">

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= t("custom.deficiency_reports.mailers.send_feedback_form_link.hi", username: @deficiency_report.author.username) %>
  </p>

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= sanitize(
      t("custom.deficiency_reports.mailers.send_feedback_form_link.p1",
        deficiency_report_link: link_to(@deficiency_report.title, deficiency_report_url(@deficiency_report)),
        status: @deficiency_report.status.name)
    ) %>
  </p>

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= t("custom.deficiency_reports.mailers.send_feedback_form_link.p2") %>
  </p>

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= sanitize(
      t("custom.deficiency_reports.mailers.send_feedback_form_link.p3",
        feedback_form_link:
          link_to(
            t("custom.deficiency_reports.mailers.send_feedback_form_link.feedback_form_link_text"),
            new_deficiency_report_feedback_form_url(@deficiency_report),
            target: "_blank"
          )
       )
    ) %>
  </p>

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= t("custom.deficiency_reports.mailers.send_feedback_form_link.p4") %>
  </p>

  <% unless custom_email_footer_present? %>
    <% if Setting["mailer_from_deficiency_report_address"].present? %>
      <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
        <em><%= sanitize t("custom.deficiency_reports.mailers.contact_info", email: Setting["mailer_from_deficiency_report_address"]) %></em>
      </p>
    <% end %>
  <% end %>

</td>
