<%= content_for :body_class, "deficiency-reports-show" %>
<% provide :title do %><%= @deficiency_report.title %><% end %>
<% content_for :meta_description do %><%= @deficiency_report.description %><% end %>
<% content_for :canonical do %>
  <%= render "shared/canonical", href: deficiency_report_url(@deficiency_report) %>
<% end %>

<main>
  <div class="resource-page">
    <div class="flex-layout margin-bottom">
      <div class='main-column'>
        <%= back_link_to(deficiency_report_path(@deficiency_report)) %>
      </div>
      <div class="sidebar-placeholder"></div>
    </div>

    <div class="flex-layout">
      <div class="main-column">
        <div class="resource-page--description new-card main-content-card" style="margin-bottom:40px;">
          <h3><%= t('custom.deficiency_reports.feedback_form.new.title') %></h3>
          <p style="margin:0">
            <%= sanitize t('custom.deficiency_reports.feedback_form.new.subtitle', title: @deficiency_report.title) %>
          </p>
        </div>

        <%= form_with model: @deficiency_report_feedback_form, url: deficiency_report_feedback_form_path(@deficiency_report) do |f| %>
          <div class="" style="margin-bottom: 2rem;">
            <h5><%= t('custom.deficiency_reports.feedback_form.new.overall_satisfaction') %></h5>
            <%= render Forms::StarRatingComponent.new(f: f, attribute: :overall_satisfaction) %>
            <% if @deficiency_report_feedback_form.errors.attribute_names.include? :overall_satisfaction %>
							<small class="form-error is-visible" style="margin-top:0.5rem;"><%= t('custom.deficiency_reports.feedback_form.new.errors.overall_satisfaction') %></small>
            <% end %>
          </div>

          <div class="" style="margin-bottom: 2rem;">
            <h5><%= t('custom.deficiency_reports.feedback_form.new.response_time_satisfaction') %></h5>
            <%= render Forms::StarRatingComponent.new(f: f, attribute: :response_time_satisfaction) %>
          </div>

          <div class="" style="margin-bottom: 2rem;">
            <h5><%= t('custom.deficiency_reports.feedback_form.new.communication_satisfaction') %></h5>
            <%= render Forms::StarRatingComponent.new(f: f, attribute: :communication_satisfaction) %>
          </div>

          <div class="" style="margin-bottom: 2rem;">
            <h5><%= t('custom.deficiency_reports.feedback_form.new.resolved') %></h5>
            <%= f.collection_radio_buttons :resolved, [[true, t("shared.yes")], [false, t("shared.no")]], :first, :last do |b| %>
              <div class="" style="display:inline-block;margin-right:20px;">
                <%= b.label(style: "display:flex;align-items:center;gap:5px;font-weight:normal;cursor:pointer;") do %>
                  <%= b.radio_button(style: "margin:0") %>
                  <%= b.text %>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="" style="margin-bottom: 2rem;">
            <h5><%= t('custom.deficiency_reports.feedback_form.new.what_liked_note') %></h5>
            <%= f.text_area :what_liked_note, label: false, rows: 7 %>
          </div>

          <div class="" style="margin-bottom: 2rem;">
            <h5><%= t('custom.deficiency_reports.feedback_form.new.what_improve_note') %></h5>
            <%= f.text_area :what_improve_note, label: false, rows: 7 %>
          </div>

          <div class="margin-bottom">
            <%= f.submit t('custom.deficiency_reports.feedback_form.new.submit'), class: "button button--primary" %>
          </div>
        <% end %>
      </div>

      <aside class="sidebar">
      </aside>
    </div>
  </div>
</main>
