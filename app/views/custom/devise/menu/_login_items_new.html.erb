<% icon_set = local_assigns.fetch(:icon_set, :font_awesome) %>

<% if user_signed_in? %>
  <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
    <%= link_to account_path, rel: "nofollow", class: "flyout-item--link" do %>
      <%= flyout_item_icon(icon_set: icon_set, material: "person", font_awesome: "fa-user") %>
      <%= t("layouts.header.my_account_link") %>
    <% end %>
  </li>

  <% admin_links = !local_assigns[:compact] && (
       current_user.administrator? ||
       current_user.projekt_manager? ||
       current_user.landing_page_manager? ||
       current_user.moderator? ||
       (feature?(:budgets) && current_user.valuator?) ||
       current_user.poll_officer? ||
       current_user.officing_manager? ||
       Adm::DeficiencyReports::DeficiencyReportPolicy.new(current_user, nil).index? ||
       Adm::Ideas::IdeaPolicy.new(current_user, nil).index?
     ) %>

  <% if admin_links %>
  <li class="flyout-item flyout-item--divider" aria-hidden="true"></li>
  <% end %>

  <% unless local_assigns[:compact] %>
  <% if current_user.administrator? %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["administration"]) %>
        <%= t("layouts.header.administration") %>
      <% end %>
    </li>
  <% end %>

  <% if current_user.administrator? || current_user.projekt_manager? %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_projekts_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["projekts"]) %>
        <%= t("custom.layouts.header.projekt_management") %>
      <% end %>
    </li>
  <% end %>

  <% if current_user.administrator? || current_user.landing_page_manager? %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_landing_pages_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["landing_pages"], font_awesome: "fa-newspaper") %>
        <%= t("adm.landing_pages.title") %>
      <% end %>
    </li>
  <% end %>

  <% if current_user.administrator? || current_user.moderator? %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_moderation_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["moderation"]) %>
        <%= t("layouts.header.moderation") %>
      <% end %>
    </li>
  <% end %>

  <% if Adm::DeficiencyReports::DeficiencyReportPolicy.new(current_user, nil).index? %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_deficiency_reports_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["deficiency_reports"]) %>
        <%= setting_text("deficiency_reports.feature_name").presence || t("custom.layouts.header.deficiency_report_management") %>
      <% end %>
    </li>
  <% end %>

  <% if Adm::Ideas::IdeaPolicy.new(current_user, nil).index? %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_ideas_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["ideas"]) %>
        <%= Setting["ideas.feature_name"].presence || t("custom.layouts.header.idea_management") %>
      <% end %>
    </li>
  <% end %>

  <% if feature?(:budgets) && (current_user.administrator? || current_user.valuator?) %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_valuation_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["valuation"]) %>
        <%= t("layouts.header.valuation") %>
      <% end %>
    </li>
  <% end %>

  <% if current_user.administrator? || current_user.poll_officer? || current_user.officing_manager? %>
    <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
      <%= link_to adm_officing_root_path, class: "flyout-item--link" do %>
        <%= flyout_item_icon(icon_set: icon_set, **Adm::Section::ICONS["officing"]) %>
        <%= t("layouts.header.officing") %>
      <% end %>
    </li>
  <% end %>

  <% end %>

  <% if admin_links %>
  <li class="flyout-item flyout-item--divider" aria-hidden="true"></li>
  <% end %>

  <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
    <%= link_to destroy_user_session_path, rel: "nofollow", method: :delete, data: { turbo_method: :delete }, class: "flyout-item--link" do %>
      <%= flyout_item_icon(icon_set: icon_set, material: "logout", font_awesome: "fa-sign-out-alt") %>
      <%= t("devise_views.menu.login_items.logout") %>
    <% end %>
  </li>
<% else %>
  <li class='nav-element flyout-item js-access-flyout-menu-item focusable'
      tabindex="0"
      aria-label='<%= t("devise_views.menu.login_items.login") %>'
      >
    <%= link_to t("devise_views.menu.login_items.login"),
                new_user_session_path, rel: "nofollow" %>
  </li>
  <li class='nav-element flyout-item js-access-flyout-menu-item focusable'
      tabindex="0"
      aria-label='<%= t("devise_views.menu.login_items.signup") %>'
      >
    <%= link_to t("devise_views.menu.login_items.signup"),
                new_user_registration_path, rel: "nofollow" %>
  </li>
<% end %>
