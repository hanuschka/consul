<% if user_signed_in? %>
  <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
    <%= link_to t("layouts.header.my_account_link"), account_path, rel: "nofollow" %>
  </li>

  <% if show_admin_menu?(current_user) %>
    <% if current_user.administrator? %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("layouts.header.administration"), adm_root_path %>
      </li>
    <% end %>

    <% if current_user.administrator? || current_user.projekt_manager? %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("custom.layouts.header.projekt_management"), adm_projekts_root_path %>
      </li>
    <% end %>

    <% if current_user.administrator? || current_user.landing_page_manager? %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("adm.landing_pages.title"), adm_landing_pages_root_path %>
      </li>
    <% end %>

    <% if current_user.administrator? || current_user.moderator? %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("layouts.header.moderation"), adm_moderation_root_path %>
      </li>
    <% end %>

    <% if current_user.administrator? || current_user.deficiency_report_manager? || current_user.deficiency_report_officer? %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("custom.layouts.header.deficiency_report_management"), adm_deficiency_reports_root_path %>
      </li>
    <% end %>

    <% if current_user.administrator? || current_user.idea_manager? %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("custom.layouts.header.idea_management"), adm_ideas_root_path %>
      </li>
    <% end %>

    <% if feature?(:budgets) && (current_user.administrator? || current_user.valuator?) %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("layouts.header.valuation"), adm_valuation_root_path %>
      </li>
    <% end %>

    <% if current_user.officing_manager? %>
      <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
        <%= link_to t("layouts.header.officing"), adm_officing_root_path %>
      </li>
    <% end %>
  <% end %>

  <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
    <%= link_to t("devise_views.menu.login_items.logout"), destroy_user_session_path, rel: "nofollow", method: :delete %>
  </li>
<% else %>
  <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
    <%= link_to t("devise_views.menu.login_items.login"), new_user_session_path, rel: "nofollow" %>
  </li>
  <li class="nav-element flyout-item js-access-flyout-menu-item focusable">
    <%= link_to t("devise_views.menu.login_items.signup"), new_user_registration_path, rel: "nofollow" %>
  </li>
<% end %>
