<% provide(:title) do %>
  <%= t("admin.header.title") %> - <%= t("custom.admin.ideas.districts.index.title") %>
<% end %>

<h2 class="inline-block"><%= t("custom.admin.ideas.districts.index.title") %></h2>

<table>
  <thead>
    <tr>
      <th><%= t("custom.admin.ideas.areas.area.name") %></th>
      <th><%= RegisteredAddress::District.human_attribute_name(:default_idea_officer) %></th>
      <th><%= t("admin.actions.actions") %></th>
    </tr>
  </thead>

  <tbody>
    <% @districts.each do |district| %>
      <tr>
        <td><%= district.name %></td>
        <td><%= district.default_idea_officer&.name %></td>
        <td>
          <%= render Admin::TableActionsComponent.new(district,
                                                      actions: [:edit],
                                                      edit_path: edit_idea_management_district_path(district)
                                                     ) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
