<%= translatable_form_for idea, url: idea_management_idea_path(idea), html: { class: "deficiency-report-form" } do |f| %>

  <%= render "shared/globalize_locales", resource: idea %>
  <%= render "shared/errors", resource: idea %>

  <%= f.select :idea_category_id, Idea::Category.all.map { |df| [df.name, df.id] } %>

  <div style="column-count:3;margin-top:5px;">
    <%= f.collection_radio_buttons :idea_officer_id, Idea::Officer.all, :id, :name %>
  </div>

  <%= f.translatable_fields do |translations_form| %>
    <%= translations_form.label :official_answer, t("custom.ideas.show.official_answer.title") %>
    <%= translations_form.text_area :official_answer,
      value: AdminWYSIWYGSanitizer.new.sanitize(@idea.official_answer),
      label: false,
      class: "html-area #{ck_editor_class(current_user)}" %>
  <% end %>

  <div class="actions">
    <%= f.submit(class: "button", value: t("custom.ideas.form.edit.submit_button")) %>
  </div>
<% end %>
