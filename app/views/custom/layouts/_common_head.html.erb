<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<% if content_for?(:title) %>
  <title><%= "#{yield(:title)} | #{default_title}" %></title>
<% else %>
  <title><%= default_title %></title>
<% end %>

<%= csrf_meta_tags %>
<%= favicon_link_tag "favicon.ico" %>
<script>window.CESIUM_BASE_URL = "<%= request.base_url %>/vcmap/assets/cesium/";</script>

<%= content_for :additional_plugin_styles %>
<%= stylesheet_link_tag "elements" %>
<%= stylesheet_link_tag "application" %>

<% if Setting.new_design_enabled? %>
  <%= stylesheet_link_tag "custom_new_design" %>
<% end %>
<%= content_for :additional_styles %>

<%= stylesheet_link_tag "print", media: 'print' %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>

<%= content_for :additional_plugin_scripts %>
<%= javascript_include_tag "application", "data-turbolinks-track" => "reload" %>
<%= javascript_include_tag "elements", "data-turbolinks-track" => "reload" %>
<%= content_for :additional_scripts %>


<% if @projekt.present? && !projekt_feature?(@projekt, "general.allow_indexing") %>
  <meta name="robots" content="noindex">
<% end %>

<meta name="external-links" content="<%= Setting["extended_feature.gdpr.link_out_warning"].present? %>" />
<meta name="two-click-iframes" content="<%= Setting["extended_feature.gdpr.two_click_iframe_solution"].present? %>" />
<meta name="turbolinks-cache-control" content="no-cache">

<link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/43.3.0/ckeditor5.css" />

<% if current_user&.administrator? || current_user&.projekt_manager? %>
  <%= stylesheet_link_tag "studio", "data-turbolinks-track" => "reload" %>
<% end %>

<% unless Rails.env.development? %>
  <% if Rails.application.secrets.matomo_site_id.present? %>
    <%= render "layouts/matomo" %>
  <% end %>
<% end %>

<% if current_user&.administrator? || current_user&.projekt_manager? %>
  <%= javascript_include_tag "packs/studio", "data-turbolinks-track" => "reload" %>
<% end %>

<%= javascript_include_tag "klaro/config.js" %>

<%= render "layouts/klaro_services" %>

<%= javascript_include_tag "klaro/klaro.js", defer: true %>

<% if extended_feature?("general.enable_google_translate") && google_translate_accepted? %>
  <script>
    function loadGoogleTranslateScript() {
      var script = document.createElement('script');
      script.type = 'text/javascript';
      script.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
      document.head.appendChild(script);
    }

    function googleTranslateElementInit() {
      if ( $(".hamburger-menu:visible").length ) {
        new google.translate.TranslateElement({pageLanguage: 'en'}, 'google_translate_element_mobile');
      } else {
        new google.translate.TranslateElement({pageLanguage: 'en'}, 'google_translate_element_desktop');
      }
    }

    $(document).on('turbolinks:load', function() {
      if (typeof google === 'undefined' || typeof google.translate === 'undefined') {
        loadGoogleTranslateScript();
      } else {
        googleTranslateElementInit();
      }
    });
  </script>
<% end %>
