<script>
  if (typeof klaroConfig !== "undefined") {
    <% if extended_feature?("general.enable_google_translate") %>
      klaroConfig.services.unshift({
        name: 'google_translate_accepted',
        default: false,
        purposes: ['translation'],
        translations: {
          en: { title: 'Google Translate' },
          de: { title: 'Google Übersetzer' }
        },
        cookies: ['googtrans'],
        callback: function(consent, service) {
          if ( !document.querySelector(".translate-widget") ) { return; }
          if ( consent == false && document.getElementById("google_translate_element_desktop") ) {
            location.reload();
          } else if ( consent == true && !document.getElementById("google_translate_element_desktop") ) {
            location.reload();
          }
        }
      });
    <% end %>
    <%# Future setting-driven Klaro services: add more feature-gated unshift blocks here. %>

    if (!klaroConfig.services.some(function(service) { return !service.required; })) {
      klaroConfig.acceptAll = false;
      klaroConfig.hideDeclineAll = true;
      klaroConfig.hideLearnMore = true;
      klaroConfig.translations.de.ok = 'OK';
      klaroConfig.translations.de.consentNotice.description = 'Diese Plattform verwendet nur Cookies, die für ihren Betrieb notwendig sind. Mehr dazu in unserer {privacyPolicy}.';
      klaroConfig.translations.en.ok = 'OK';
      klaroConfig.translations.en.consentNotice.description = 'This platform only uses cookies that are necessary for it to run. Learn more in our {privacyPolicy}.';
    }
  }
</script>
