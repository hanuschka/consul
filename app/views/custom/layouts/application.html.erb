<!DOCTYPE html>
<html <%= "dir=rtl" if rtl? %> lang="<%= I18n.locale %>" data-current-user-id="<%= current_user&.id %>">
  <head>
    <%= render "custom/layouts/common_head", default_title: setting_text("meta_title") %>
    <%= render "layouts/meta_tags" %>
    <%= content_for :canonical %>
    <%= favicon_link_tag image_path_for("apple-touch-icon-200.png"),
                     rel: "icon apple-touch-icon",
                     sizes: "200x200",
                     type: "image/png" %>
    <%= content_for :social_media_meta_tags %>

    <%= raw setting["html.per_page_code_head"] %>
  </head>
  <body
    class="<%= yield(:body_class) %> <%= custom_new_design_body_class %>"
    data-ai-available="<%= Ai::Settings.ai_available? %>"
  >
    <%= render "layouts/brand_color_root_style" %>
    <%= yield :styles %>

    <a href="#main-content" class="show-for-sr"><%= t("custom.accessibility.skip_links.skip_to_content") %></a>
    <a href="#main-navigation" class="show-for-sr"><%= t("custom.accessibility.skip_links.skip_to_navigation") %></a>

    <% wrapper_content = capture do %>
      <% if request.headers["User-Agent"] =~ /MSIE/ && cookies["ie_alert_closed"] != "true" %>
      <!--[if lt IE 9]>
        <div data-alert class="callout primary ie-callout" data-closable>
          <button class="close-button ie-callout-close-js"
                  aria-label="<%= t("application.close") %>" type="button" data-close>
            <span aria-hidden="true">&times;</span>
          </button>
          <h2><%= t("layouts.application.ie_title") %></h2>
          <p>
            <%= sanitize(t("layouts.application.ie",
            chrome: link_to(
                    t("layouts.application.chrome"), "https://www.google.com/chrome/browser/desktop/", title: t("shared.target_blank"), target: "_blank"),
            firefox: link_to(
                     t("layouts.application.firefox"), "https://www.mozilla.org/firefox", title: t("shared.target_blank"), target: "_blank")
            )) %>
          </p>
        </div>
      <![endif]-->
      <% end %>

      <%= render "layouts/flash" %>
      <%= yield %>
    <% end %>

    <%= raw setting["html.per_page_code_body"] %>

    <% if Setting.new_design_enabled? %>
      <%= render "layouts/header", with_subnavigation: true %>
    <% end %>
    <div id="main-content" class="wrapper <%= yield(:wrapper_class) %>" tabindex="-1">
      <% if Setting.old_design_enabled? %>
        <%= render "layouts/header", with_subnavigation: true %>
      <% end %>
      <%= wrapper_content %>
    </div>
    <div class="footer">
      <%= render "layouts/footer" %>
    </div>

    <% if @namespace.present? %>
      <script>
        $(document).ready(() => {
          App.routeNamespace = "<%= @namespace %>"
        })
      </script>
    <% end %>

    <% if current_user&.administrator? || current_user&.projekt_manager? %>
      <%= render Projekts::ContentBlockTemplatesSelectorComponent.new %>
      <%= render Projekts::ContentBlockAiCreateModalComponent.new %>
      <%= render Projekts::ContentBlockEditPopupsComponent.new %>
      <%= render ProjektStudio::FileUploadDialogComponent.new(type: "picture") %>
      <%= render ProjektStudio::FileUploadDialogComponent.new(type: "document") %>
    <% end %>
    <% if user_signed_in? %>
      <%
        timeout_minutes = (User.timeout_in / 60).to_i
        warning_minutes = [5, timeout_minutes - 1].min
      %>
      <div
        class="js-session-timeout-warning"
        data-timeout-minutes="<%= timeout_minutes %>"
        data-warning-minutes="<%= warning_minutes %>"
        data-keepalive-url="<%= session_keepalive_ping_path %>"
      >
        <dialog
          class="js-session-timeout-dialog session-timeout-warning--dialog"
          role="alertdialog"
          aria-labelledby="session-timeout-title"
          aria-describedby="session-timeout-description"
          aria-modal="true"
        >
          <h2
            id="session-timeout-title"
            class="session-timeout-warning--title"
          ><%= t("custom.accessibility.session_timeout.title") %></h2>

          <p
            id="session-timeout-description"
            class="session-timeout-warning--description"
          ><%= t("custom.accessibility.session_timeout.description") %></p>

          <p
            class="session-timeout-warning--countdown-wrapper"
            aria-live="polite"
            aria-atomic="true"
          >
            <%= t("custom.accessibility.session_timeout.remaining_time") %>
            <span class="js-session-timeout-countdown session-timeout-warning--countdown"></span>
          </p>

          <div class="session-timeout-warning--actions">
            <button
              type="button"
              class="js-session-timeout-extend session-timeout-warning--extend-button"
            ><%= t("custom.accessibility.session_timeout.extend") %></button>

            <button
              type="button"
              class="js-session-timeout-logout session-timeout-warning--logout-button"
            ><%= t("custom.accessibility.session_timeout.logout") %></button>
          </div>
        </dialog>
      </div>
    <% end %>
  </body>
</html>
