<% email_brand_color = Setting.newsletter_brand_color %>

<%# Top header with logo %>
<% logo_newsletter = SiteCustomization::Image.find_or_create_by(name: "logo_newsletter_email") %>
<% if logo_newsletter.image.attached? %>
  <table style="background-color:<%= email_brand_color %>" width="100%" border="0" cellpadding="0" cellspacing="0">
    <tbody>
      <tr>
        <td style="padding-top:20px;padding-bottom:20px;" align="left">
          <table align="center" style="max-width: 670px" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>
              <tr>
                <td align="left">
                  <%= image_tag(
                    image_path_for("logo_newsletter_email.png"),
                    height: 45,
                    style: "border: 0;display: block;height: 45px",
                    alt: setting["org_name"]
                  ) %>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>

<%# Main header %>
<% if newsletter.image&.attachment&.attached? && newsletter.title.blank? && newsletter.subtitle.blank? %>
  <table width="100%" border="0" cellpadding="0" cellspacing="0">
    <tbody>
      <tr>
        <td style="text-align:center" colspan="100%" width="100%">
          <%= image_tag(blob_variant_url(newsletter.image.attachment.blob.key, host: Setting["url"], w: 1500, h: 2000), style: "width:100%;height:auto;") %>
        </td>
      </tr>
    </tbody>
  </table>
  <table align="center" style="max-width: 670px" width="100%" border="0" cellpadding="0" cellspacing="0">
    <tbody>
      <tr>
        <td style="background:#ffffff; padding:25px 40px 0 40px" align="left">
          <span style="font-size:22px; color:#000000; margin-top:0">
            <%= newsletter.greeting %>
          </span>
        </td>
      </tr>
    </tbody>
  </table>
<% else %>
  <% header_background_style = newsletter.image&.attachment&.attached? ? "background-image:url(#{blob_variant_url(newsletter.image.attachment.blob.key, host: Setting["url"], w: 1500, h: 2000)});background-position:top center;background-repeat:no-repeat;background-size:cover;height:420px;" : "background: #{email_brand_color};height:420px;" %>
  <table style="<%= header_background_style %>" width="100%" border="0" cellpadding="0" cellspacing="0">
    <tbody>
      <tr>
        <td style="vertical-align:top; padding:120px 40px 0 40px" valign="top" align="left">
          <table align="center" style="max-width:580px" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>
              <tr>
                <td align="left">
                  <% if newsletter.title.present? %>
                    <h1 style="font-size:32px; color:<%= newsletter.title_color %>; margin:0 0 0 0; line-height:1.2">
                      <div><%= newsletter.title %></div>
                    </h1>
                    <div style="display:block;max-width:204px; height:0; margin-top:4px; margin-bottom:18px; padding-top:0.5em; border-style:solid; border-width:6px 6px 6px 0; border-color:transparent transparent <%= email_brand_color %> transparent"></div>
                  <% end %>
                  <% if newsletter.subtitle.present? %>
                    <div style="font-size:19px; color:<%= newsletter.subtitle_color %>; margin-top:0; margin-bottom:8px">
                        <%= newsletter.subtitle %>
                    </div>
                  <% end %>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
      <tr>
        <td style="vertical-align:bottom;padding-bottom:0" valign="bottom" align="left">
          <table align="center" style="max-width: 670px" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>
              <tr>
                <td style="background:#ffffff; padding:25px 40px 0 40px" align="left">
                  <span style="font-size:22px; color:#000000; margin-top:0">
                    <%= newsletter.greeting %>
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>
