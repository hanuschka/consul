<% if @newsletter_projekt.present? && @subscriptions_token.present? %>
  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif; margin: 0;padding: 0;line-height: 1.5em;color: #222; font-size: 10px; margin-top: 12px;">
    <%= link_to(
      t("mailers.config.unsubscribe_projekt_link", projekt: @newsletter_projekt.name),
      unsubscribe_projekt_subscriptions_url(
        token: @subscriptions_token,
        projekt_id: @newsletter_projekt.id
      )
    ) %>
  </p>
<% end %>
