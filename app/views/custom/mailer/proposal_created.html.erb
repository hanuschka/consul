<td style="padding-bottom: 20px; padding-left: 10px;">
  <% p_style = "font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;" %>
  <% h_style = "font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 16px;font-weight: bold;line-height: 28px;margin-top: 24px;margin-bottom: 8px;" %>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.hi", username: @author.username) %>
  </p>

  <p style="<%= p_style %>">
    <%= sanitize(
      t("mailers.proposal_created.intro_html",
        proposal_link: link_to(content_tag(:strong, @proposal.title), proposal_url(@proposal))
      ),
      tags: %w[a strong],
      attributes: %w[href]
    ) %>
  </p>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.thanks") %>
  </p>

  <h2 style="<%= h_style %>">
    <%= t("mailers.proposal_created.next_steps_title") %>
  </h2>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.next_steps_intro") %>
  </p>

  <h3 style="<%= h_style %>">
    <%= t("mailers.proposal_created.stage1_title") %>
  </h3>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.stage1_p1") %>
  </p>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.stage1_tip") %>
  </p>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.stage1_template_intro") %>
  </p>

  <h3 style="<%= h_style %>">
    <%= t("mailers.proposal_created.stage2_title") %>
  </h3>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.stage2_p1") %>
  </p>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.stage2_p2") %>
  </p>

  <p style="<%= p_style %>">
    <%= sanitize(
      t("mailers.proposal_created.stage2_p3_html",
        faq_link: link_to("FAQ", faq_url)
      ),
      tags: %w[a],
      attributes: %w[href]
    ) %>
  </p>

  <h3 style="<%= h_style %>">
    <%= t("mailers.proposal_created.stage3_title") %>
  </h3>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.stage3_p1") %>
  </p>

  <p style="<%= p_style %>">
    <%= sanitize(
      t("mailers.proposal_created.contact_html",
        email_link: mail_to("themenwahl@abstimmung21.de")
      ),
      tags: %w[a],
      attributes: %w[href]
    ) %>
  </p>

  <p style="<%= p_style %>">
    <%= t("mailers.proposal_created.closing") %>
    <br>
    <%= t("mailers.proposal_created.signature") %>
  </p>

  <hr style="border: none; border-top: 1px solid #dddddd; margin: 24px 0;">

  <h3 style="<%= h_style %>">
    <%= t("mailers.proposal_created.share_title") %>
  </h3>

  <div style="background: #f5f5f5; padding: 16px; border: 1px solid #dddddd;">
    <p style="<%= p_style %>">
      <%= t("mailers.proposal_created.share_greeting") %>
    </p>

    <p style="<%= p_style %>">
      <%= t("mailers.proposal_created.share_text", proposal_title: @proposal.title) %>
    </p>

    <p style="<%= p_style %>">
      <%= t("mailers.proposal_created.share_link_text") %> <%= proposal_url(@proposal) %>
    </p>

    <p style="<%= p_style %>">
      <%= t("mailers.proposal_created.share_closing") %>
      <br>
      <%= t("mailers.proposal_created.share_signature") %>
    </p>
  </div>
</td>
