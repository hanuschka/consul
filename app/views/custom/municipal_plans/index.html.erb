<% archive_view = action_name == "archive" %>
<% list_path = archive_view ? archive_municipal_plans_path : municipal_plans_path %>
<% page_title = archive_view ? t("custom.municipal_plans.index.archive_title") : t("custom.municipal_plans.index.title") %>
<% intro_text = archive_view ? t("custom.municipal_plans.index.archive_intro_text") : t("custom.municipal_plans.index.intro_text") %>
<% empty_list_text = archive_view ? t("custom.municipal_plans.index.archive_empty_list_text") : t("custom.municipal_plans.index.empty_list_text") %>

<% provide :title do %><%= page_title %><% end %>

<main>
  <h1><%= page_title %></h1>

  <div class="flex-layout">
    <div class="main-column">
      <div class="resource-page--intro-text">
        <p><%= intro_text %></p>

        <p class="municipal-plans--archive-link">
          <% if archive_view %>
            <%= link_to t("custom.municipal_plans.index.overview_link"), municipal_plans_path %>
          <% else %>
            <%= link_to t("custom.municipal_plans.index.archive_link"), archive_municipal_plans_path %>
          <% end %>
        </p>
      </div>

      <% if @overview_map.show? %>
        <%= tag.div class: "js-municipal-plans-map margin-bottom",
                    data: { areas: @overview_map.areas, markers: @overview_map.markers } do %>
          <%= render Shared::MapComponent.new(process: "municipal_plans", features: {}) %>
        <% end %>
      <% end %>

      <p class="municipal-plans--result-count" role="status">
        <%= t("custom.municipal_plans.index.result_count", count: @municipal_plans.total_count) %>
      </p>

      <%= render Resources::List::BaseComponent.new do |c| %>
        <% c.with_toolbar(
          i18n_namespace: "custom.municipal_plans.index",
          filters: @valid_orders,
          current_filter: @current_order,
          param: "order",
          hide_view_mode_button: true
        ) %>

        <%= render Resources::ViewSwitchComponent.new(
          options: {
            "tiles" => t("custom.municipal_plans.index.view_switch.tiles"),
            "table" => t("custom.municipal_plans.index.view_switch.table")
          },
          current: @view_mode,
          label: t("custom.municipal_plans.index.view_switch.label")
        ) %>

        <% if @municipal_plans.present? && @view_mode == "table" %>
          <%= render Resources::TableComponent.new(
            columns: MunicipalPlans::TableRowComponent.columns,
            caption: archive_view ? t("custom.municipal_plans.index.table.archive_caption") : t("custom.municipal_plans.index.table.caption"),
            region_label: t("custom.municipal_plans.index.table.region_label")
          ) do %>
            <% @municipal_plans.each do |municipal_plan| %>
              <%= render MunicipalPlans::TableRowComponent.new(municipal_plan: municipal_plan) %>
            <% end %>
          <% end %>
        <% elsif @municipal_plans.present? %>
          <% c.with_items do %>
            <% @municipal_plans.each do |municipal_plan| %>
              <%= render MunicipalPlans::ListItemComponent.new(municipal_plan: municipal_plan) %>
            <% end %>
          <% end %>
        <% else %>
          <p class="resources-list--not-items-message text-center">
            <%= empty_list_text %>
          </p>
        <% end %>
      <% end %>

      <%= paginate @municipal_plans %>
    </div>

    <div id="municipal-plans-sidebar" class="sidebar">
      <%= render "municipal_plans/filters", form_url: list_path %>
    </div>
  </div>
</main>
