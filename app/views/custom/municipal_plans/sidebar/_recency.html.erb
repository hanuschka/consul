<% selected = Array(params[:recency]).map(&:to_s) %>

<fieldset class="municipal-plans-filter--fieldset">
  <legend class="show-for-sr"><%= t("custom.municipal_plans.index.sidebar.recency.title") %></legend>

  <ul class="no-bullet municipal-plans-filter--options">
    <% MunicipalPlansQuery::RECENCY_VALUES.each do |value| %>
      <li>
        <%= check_box_tag "recency[]", value, value.in?(selected), id: "filter_recency_#{value}" %>
        <%= label_tag "filter_recency_#{value}", t("custom.municipal_plans.badges.#{value}") %>
      </li>
    <% end %>
  </ul>
</fieldset>
