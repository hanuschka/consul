<td style="padding-bottom: 20px; padding-left: 10px;">
  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <% if @officer.present? %>
      <%= @officer.user.recipient_greeting %>,
    <% else %>
      <%= t("mailers.shared.greeting_without_name") %>
    <% end %>
  </p>

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <% if @initial %>
      <%= t("custom.notification_service_mailers.new_comments_for_deficiency_report.p1_initial") %>
    <% else %>
      <%= t("custom.notification_service_mailers.new_comments_for_deficiency_report.p1_reminder") %>
    <% end %>
  </p>

  <ul>
    <% @new_comments.each do |comment| %>
      <li>
        <%= comment.body.truncate(30) %>
        <%= link_to t("custom.notification_service_mailers.new_comments_for_deficiency_report.link_to_report"), deficiency_report_url(@deficiency_report) %>
      </li>
    <% end %>
  </ul>

  <% unless custom_email_footer_present? %>
    <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
      <%= t("mailers.shared.sincerely") %>
      <br>
      <%= t("mailers.shared.signature") %>
    </p>
  <% end %>
</td>
