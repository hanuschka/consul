<td style="padding-bottom: 20px; padding-left: 10px;">
  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= t("custom.notification_service_mailers.new_projekt.hi", username: @user.username) %>
  </p>

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= sanitize(
      t("custom.notification_service_mailers.new_projekt.p1",
        link: link_to(@projekt.title, page_url(@projekt.page.slug))),
        attributes: %w[href style]
    ) %>
  </p>

  <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif;font-size: 14px;font-weight: normal;line-height: 24px;">
    <%= t("mailers.shared.sincerely") %>
    <br>
    <%= t("mailers.shared.signature") %>
  </p>
</td>
