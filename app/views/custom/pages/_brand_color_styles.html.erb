<%
  # Projekt-Color hat Vorrang vor Landing-Page-Brand-Color.
  # Locals: `projekt` (optional) und `page` (optional).
  effective_color = local_assigns[:projekt]&.color.presence ||
                    local_assigns[:page]&.brand_color.presence
%>
<% if effective_color.present? %>
  <style id="js-brand-color-styles">
    :root {
      --brand-color: <%= effective_color %>;
      --page-brand-color: <%= effective_color %>;
      --page-brand-color-lighter: rgb(from var(--page-brand-color) r g b / 0.1);
    }

    *::selection {
      background-color: var(--page-brand-color);
    }
  </style>
<% end %>
