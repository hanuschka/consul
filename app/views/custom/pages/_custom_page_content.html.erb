<div class="custom-page-content" id='page-content'>
  <% if @custom_page&.projekt&.new_content_block_mode? %>
    <% content_blocks = @custom_page.projekt.content_blocks.order(:position) %>
    <% show_admin_controls = show_admin_controls_for_projekt?(@custom_page&.projekt) %>

    <% if show_admin_controls && content_blocks.empty? %>
      <%= render Projekts::ContentStartSectionComponent.new(@custom_page.projekt) %>
    <% end %>
    <div class="js-custom-page-content--inner">
      <div class="content-blocks-container">
        <% if content_blocks.any? %>
          <% content_blocks.each do |content_block| %>
            <% next if !show_admin_controls && content_block_body_blank?(content_block.body) %>
            <div
              class="custom-content-block js-content-block"
              data-id="<%= content_block.id %>"
              data-turbolinks="false"
              <% effective_margin = content_block.margin_bottom || SiteCustomization::ContentBlock::DEFAULT_MARGIN_BOTTOM %>
              <% if effective_margin > 0 %>
                style="margin-bottom: <%= effective_margin %>px;"
              <% end %>
            >
              <%= process_custom_content_if_needed(safe_content_block_body(content_block&.body), projekt: @custom_page.projekt)&.html_safe %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if show_admin_controls %>
      <% namespace = current_user.present? && current_user.administrator? ? :admin : :projekt_management %>
      <div class="js-delete-all-content-blocks custom-content-blocks-delete-section js-studio-hide-on-preview">
        <%= studio_rich_tooltip(
          title: "Alle Inhaltsblöcke löschen",
          text: "Entfernt sämtliche Inhaltsblöcke dieser Seite auf einmal. Diese Aktion kann nicht rückgängig gemacht werden — die Inhalte müssen anschließend neu erstellt werden.",
          delay: 1200
        ) do %>
          <%= button_to(
            [:destroy_all, namespace, @custom_page.projekt, :projekt_content_blocks],
            method: :delete,
            class: "button -red",
            tabindex: "-1",
            form: { data: { turbolinks: false } },
            data: { confirm: "Sind Sie sicher, dass Sie alle Inhaltsblöcke löschen möchten? Diese Aktion kann nicht rückgängig gemacht werden." }
          ) do %>
            <i class="fas fa-trash"></i>
            Alle Inhaltsblöcke löschen
          <% end %>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <%= auto_link_already_sanitized_html AdminWYSIWYGSanitizer.new.sanitize(@custom_page.content) %>
  <% end %>
</div>


<% if @custom_page.print_content_flag %>
  <%= render "/shared/print" %>
<% end %>

<% if @cards.any? %>
  <%= render "shared/cards", cards: @cards %>
<% end %>
