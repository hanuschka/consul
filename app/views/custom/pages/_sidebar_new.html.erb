<aside class="sidebar">
  <%# <% if show_admin_controls_for_projekt?(@projekt) %1> %>
  <%#   <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.admin_controls.title"), icon_name: "cog", class_name: "js-sidebar-admin-controlls") do |c| %1> %>
  <%#     <%= render partial: 'pages/sidebar/admin_controls' %1> %>
  <%#   <% end %1> %>
  <%# <% end %1> %>

  <% content_block_sidebar_name = "projekt_sidebar_#{projekt.id}" %>
  <% if render_custom_projekt_content_block?(content_block_sidebar_name, projekt) || show_admin_controls_for_projekt?(@projekt) %>
    <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.projekt_information.title"), icon_name: "info-circle", class_name: "js-sidebar-projekt-info", opened_on_mobile: true) do |c| %>
      <% return_path = page_path(@projekt.page.slug) %>
      <% if show_admin_controls_for_projekt?(@projekt) %>
        <% sidebar_locale = current_user&.locale || I18n.default_locale %>
        <% sidebar_block = SiteCustomization::ContentBlock.find_by(name: "custom", locale: sidebar_locale, key: content_block_sidebar_name) %>
        <% if content_block_body_blank?(sidebar_block&.body) %>
          <div class="sidebar-card--admin-empty-hint js-studio-hide-on-preview" role="note">
            <i class="fas fa-eye-slash sidebar-card--admin-empty-hint-icon" aria-hidden="true"></i>
            <span><%= t("custom.projekts.page.sidebar.projekt_information.admin_empty_hint") %></span>
          </div>
        <% end %>
      <% end %>
      <%= render_custom_block(content_block_sidebar_name, projekt: @projekt, return_path: return_path) %>
    <% end %>
  <% end %>

  <%= render(Mobile::FixedBottomActionComponent.new) do %>
    <% show_sidebar_cta = (projekt_feature?(projekt, "sidebar.new_resource_button_in_sidebar") || show_admin_controls_for_projekt?(@projekt)) %>
    <div id="sidebar-cta" class="<%= show_sidebar_cta ? '' : 'hide show-on-small-tablet' %>">
      <%= render Projekts::ToggleSectionWithSettingComponent.new(
        enable: show_admin_controls_for_projekt?(@projekt),
        projekt: @projekt,
        setting_key: "projekt_feature.sidebar.new_resource_button_in_sidebar",
        setting_active: projekt_feature?(@projekt, 'sidebar.new_resource_button_in_sidebar')
      ) do %>
        <%= render Pages::Projekts::SidebarCtaComponent.new(@default_projekt_phase) %>
      <% end %>
    </div>
  <% end %>

    <% other_conditions_for_phases_section_are_met = (
      projekt.total_duration_start.present? || projekt.total_duration_end.present?) &&
      projekt.projekt_phases.active.any?
    %>
    <% if ((projekt_feature?(projekt, "sidebar.show_phases_in_projekt_page_sidebar") &&
        other_conditions_for_phases_section_are_met)) || (other_conditions_for_phases_section_are_met && show_admin_controls_for_projekt?(@projekt))
      %>
    <div class="hide-on-small-tablet u-width-100">
      <%= render Projekts::ToggleSectionWithSettingComponent.new(
        enable: show_admin_controls_for_projekt?(@projekt),
        projekt: @projekt,
        setting_key: "projekt_feature.sidebar.show_phases_in_projekt_page_sidebar",
        setting_active: projekt_feature?(projekt, "sidebar.show_phases_in_projekt_page_sidebar"),
        other_conditions_are_met: other_conditions_for_phases_section_are_met
      ) do %>
        <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.phases.title"), icon_name: "pager") do |c| %>
          <%= render Pages::Projekts::SidebarPhasesComponent.new(projekt) %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if feature?("sdg") && (projekt.sdg_goals.any? || show_admin_controls_for_projekt?(@projekt)) %>
    <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.sdgs.title"), icon_name: "tag") do |c| %>
      <% if show_admin_controls_for_projekt?(@projekt) %>
        <%= form_for(@projekt, html: { data: {resource: "projekt", id: @projekt.id}, class: "js-update-projekt-form"}) do |f| %>
          <%= render SDG::SimpleEditSelectorComponent.new(f) %>
        <% end %>
      <% else %>
        <div class="big-sdgs-list">
          <%= render SDG::TagListComponent.new(projekt) %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if Tag.any? && (projekt.tags.category.any? || show_admin_controls_for_projekt?(@projekt)) %>
    <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.tags.title"), icon_name: "tag") do |c| %>
      <% if show_admin_controls_for_projekt?(@projekt) %>
        <%= form_for(@projekt, html: { data: {resource: "projekt", id: @projekt.id}, class: "js-update-projekt-form"}) do |f| %>
          <%= render Categories::SimpleEditSelectorComponent.new(f) %>
        <% end %>
      <% else %>
        <%= render partial: 'pages/sidebar/tags', locals: { projekt: projekt } %>
      <% end %>
    <% end %>
  <% end %>

  <% if projekt_feature?(projekt, 'sidebar.show_map') || show_admin_controls_for_projekt?(@projekt) %>
    <%= render Projekts::ToggleSectionWithSettingComponent.new(enable: show_admin_controls_for_projekt?(@projekt), projekt: @projekt, setting_key: "projekt_feature.sidebar.show_map", setting_active: projekt_feature?(projekt, 'sidebar.show_map')) do %>
      <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.map.title"), icon_name: "map") do |c| %>
        <%= render Pages::Projekts::SidebarMapComponent.new(projekt, @default_phase_name) %>

        <% if show_admin_controls_for_projekt?(@projekt) %>
          <% c.with_edit_link do %>
            <% if embedded? %>
              <button type="button" data-path="/projekts/<%= @projekt.id %>/edit#tab-projekt-map" class="sidebar-card--edit-icon-button js-frame-open-admin-page js-studio-hide-on-preview" title="<%= t("custom.projekts.page.sidebar.admin_controls.edit_map") %>" aria-label="<%= t("custom.projekts.page.sidebar.admin_controls.edit_map") %>">
                <i class="fas fa-pen"></i>
              </button>
            <% else %>
              <%= link_to(map_adm_projekts_projekt_path(@projekt), target: "_blank", class: "sidebar-card--edit-icon-button js-studio-hide-on-preview", title: t("custom.projekts.page.sidebar.admin_controls.edit_map"), aria: { label: t("custom.projekts.page.sidebar.admin_controls.edit_map") }) do %>
                <i class="fas fa-pen"></i>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if projekt_feature?(projekt, "sidebar.show_navigator_in_projekts_page_sidebar") || show_admin_controls_for_projekt?(@projekt) %>
    <%= render Projekts::ToggleSectionWithSettingComponent.new(enable: show_admin_controls_for_projekt?(@projekt), projekt: @projekt, setting_key: "projekt_feature.sidebar.show_navigator_in_projekts_page_sidebar", setting_active: projekt_feature?(projekt, "sidebar.show_navigator_in_projekts_page_sidebar")) do %>
      <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.navigator.title"), icon_name: "list-alt") do |c| %>
        <%= render partial: 'pages/sidebar/projekt_list', locals: { projekts: Projekt.where(id: projekt.top_parent.id).includes([page: :translations], :projekt_settings), current_projekt: projekt } %>
      <% end %>
    <% end %>
  <% end %>

  <% if @projekt_subscription.present? && projekt_feature?(@custom_page.projekt, "sidebar.show_notification_subscription_toggler") || show_admin_controls_for_projekt?(@projekt) %>
    <%= render Projekts::ToggleSectionWithSettingComponent.new(enable: show_admin_controls_for_projekt?(@projekt), projekt: @projekt, setting_key: "projekt_feature.sidebar.show_notification_subscription_toggler", setting_active: projekt_feature?(@custom_page.projekt, "sidebar.show_notification_subscription_toggler")) do %>
      <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.phases_subscription.title"), icon_name: "bell") do |c| %>
        <%= render partial: "pages/sidebar/projekt_phase_subscriptions", locals: { projekt_subscription: @projekt_subscription } %>
      <% end %>
    <% end %>
  <% end %>

  <% if projekt_feature?(projekt, "sidebar.projekt_page_sharing") || show_admin_controls_for_projekt?(@projekt) %>
    <%= render Projekts::ToggleSectionWithSettingComponent.new(enable: show_admin_controls_for_projekt?(@projekt), projekt: @projekt, setting_key: "projekt_feature.sidebar.projekt_page_sharing", setting_active: projekt_feature?(projekt, "sidebar.projekt_page_sharing")) do %>
      <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.share.title"), icon_name: "share-alt") do |c| %>
        <%= render "shared/social_share",
          title: projekt.page.title,
          url: url_for(only_path: false),
          description: strip_tags(projekt.page.content || '')[0..200] + '...',
          mobile: projekt.page.title
        %>
      <% end %>
    <% end %>
  <% end %>
</aside>
