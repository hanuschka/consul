<% if current_user&.administrator? || current_user&.projekt_manager? %>
  <% if @custom_page.projekt.present? && show_admin_controls_for_projekt?(@projekt) && native_projekt_studio?(@projekt) %>
    <% content_for :admin_topbar_display_settings do %>
      <button
        type="button"
        class="projekt-page--admin-topbar-toggle js-toggle-content-background"
        role="switch"
        aria-checked="<%= @custom_page.projekt.show_content_background %>"
        data-projekt-id="<%= @custom_page.projekt.id %>"
        data-show-background="<%= @custom_page.projekt.show_content_background %>"
        data-url="<%= toggle_hide_content_background_adm_projekts_projekt_path(@custom_page.projekt) %>"
        title="<%= t('custom.projekts.page.toggle_background_tooltip') %>"
        data-tooltip
        data-hover-delay="500"
      >
        <span class="projekt-page--admin-topbar-toggle--track" aria-hidden="true">
          <span class="projekt-page--admin-topbar-toggle--thumb"></span>
        </span>
        <span class="projekt-page--admin-topbar-toggle--label">
          <%= t('custom.projekts.page.toggle_background_label') %>
        </span>
      </button>

      <%= render "pages/topbar/admin_topbar_color_picker", projekt: @custom_page.projekt %>

      <% unless @custom_page.projekt.new_content_block_mode? %>
        <%= button_to convert_to_new_content_block_mode_adm_projekts_projekt_path(@custom_page.projekt),
              method: :patch,
              form: { class: "projekt-studio--convert-to-blocks-form" },
              class: "projekt-page--admin-topbar-button projekt-studio--convert-to-blocks-button",
              title: t("custom.projekts.page.convert_to_content_blocks.tooltip"),
              data: {
                tooltip: true,
                "hover-delay": 300,
                confirm: t("custom.projekts.page.convert_to_content_blocks.confirm")
              } do %>
          <i class="fas fa-cubes projekt-studio--convert-to-blocks-button--icon" aria-hidden="true"></i>
          <span class="projekt-studio--convert-to-blocks-button--label">
            <%= t("custom.projekts.page.convert_to_content_blocks.button") %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% content_for :admin_topbar_actions do %>
    <% if @custom_page.landing? %>
      <% if current_user&.administrator? %>
        <%= link_to edit_adm_landing_pages_landing_page_path(@custom_page),
              class: "button hollow projekt-page--admin-topbar-button",
              target: "_blank" do %>
          <i class="fas fa-edit"></i>
          <span><%= t("custom.projekts.page.topbar.edit_landing") %></span>
        <% end %>
      <% end %>
    <% elsif @custom_page.projekt.present? && show_admin_controls_for_projekt?(@projekt) %>
      <%= render "pages/topbar/admin_topbar_projekt_actions" %>
    <% else %>
      <% if current_user&.administrator? %>
        <%= link_to adm_site_customization_edit_page_by_slug_path(@custom_page.slug),
              class: "button hollow projekt-page--admin-topbar-button",
              target: "_blank" do %>
          <i class="fas fa-edit"></i>
          <span><%= t("custom.projekts.page.topbar.edit_page") %></span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @custom_page.landing? %>
  <%= render "pages/landing_page_content" %>
<% else %>
  <% landing_page = @custom_page&.projekt&.landing_page %>
  <%= render "pages/brand_color_styles", projekt: @custom_page&.projekt, page: landing_page %>

  <%= content_for :body_class, "custom-page" %>
  <% provide :title do %><%= @custom_page.title %><% end %>

  <% provide :social_media_meta_tags do %>
    <%= render "shared/social_media_meta_tags",
      social_title: @custom_page.title,
      social_description: strip_tags(@custom_page.content).to_s[0..200],
      og_image_url: (@custom_page.image.present? ? polymorphic_path(@custom_page.image.attachment) : nil),
      social_url: page_url(@custom_page.slug),
      twitter_image_url: (@custom_page.image.present? ? polymorphic_path(@custom_page.image) : nil) %>
  <% end %>

  <% if @custom_page.projekt.present? && projekt_feature?(@custom_page.projekt, "general.vc_map_enabled") %>
    <% provide :vc_maps do %>
      <script id="vcmap-core" type="module" src="/vcmap/vcmap-core.js"></script>
    <% end %>
  <% end %>

  <style>
    <% if @custom_page.image&.attached? %>
      .custom-page-banner {
        background-image: url("<%= url_for(@custom_page.image.attachment) %>");
        background-size: cover;
        background-position: center center;
      }
    <% end %>
  </style>

  <% additional_main_class = show_admin_controls_for_projekt?(@projekt) ? "projekt-studio" : "" %>

  <main
    class="projekt-page <%= additional_main_class %> js-projekt-page"
    data-projekt-id="<%= @custom_page.projekt&.id %>"
    data-default-margin-bottom="<%= SiteCustomization::ContentBlock::DEFAULT_MARGIN_BOTTOM %>"
  >
    <%= render Projekts::BannerComponent.new(custom_page: @custom_page) %>

    <% if @custom_page.projekt.present? %>
      <div class="flex-layout">
        <div class="main-column">
          <div class="js-anchor-navigation-content" id="projekt-body">
            <% if @custom_page.content.present? || @custom_page&.projekt.new_content_block_mode? %>
              <div class="main-content-card <%= '-hide-background' unless @custom_page.projekt.show_content_background %>">
                <% if @custom_page.content&.include?('template_projekt_library') %>
                  <%= render "projekt_library", projekt: @custom_page.projekt %>
                <% else %>
                  <%= render "custom_page_content" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <div id="projekt-info">
          <%= render partial: 'pages/sidebar_new', locals: { projekt: @custom_page.projekt, id_prefix: "desktop" } %>
        </div>
      </div>

    <% else %>
      <div class="main-column">
        <%= render 'custom_page_content' %>
      </div>
    <% end %>

    <% if @custom_page.projekt.present? && (@custom_page.projekt.projekt_phases.active.any? || show_admin_controls_for_projekt?(@custom_page.projekt)) %>
      <div class="js-anchor-navigation-content" id="projekt-particapation">
        <div class="projekt-footer flex-layout" id="projekt-footer">
          <div class="full-width-column">
            <%= render Pages::Projekts::FooterPhasesComponent.new(@custom_page.projekt, @default_projekt_phase, namespace: @namespace) %>
            <% if @default_projekt_phase.present? %>
              <div id="footer-content" class="js-projekt-footer-content">
                <%= render Shared::LoaderSpinnerWrapperComponent.new do %>
                  <%= render "pages/projekt_footer_new/#{@default_projekt_phase.name}" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </main>
<% end %>
