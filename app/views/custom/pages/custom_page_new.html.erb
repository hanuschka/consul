<% content_for :wrapper_class, "has-custom-fixed-tabs" %>

<% if show_admin_controls_for_projekt?(@projekt) %>
  <%= content_for :additional_styles do %>
    <%= stylesheet_link_tag "projekt_studio", "data-turbolinks-track" => "reload" %>
  <% end %>
  <%= content_for :additional_scripts do %>
    <%= javascript_include_tag "projekt_studio", "data-turbolinks-track" => "reload" %>
  <% end %>
<% end %>

<% if show_admin_controls_for_projekt?(@projekt) %>
  <%= render Projekts::ContentBlockTemplatesSelectorComponent.new %>
  <div class="js-content-block-link-popup content-block-link-popup">
    <div>
      <label class="content-block-link-popup-label" style="display: none">
        Link text: <textarea type="text" class="js-content-block-text-input"></textarea>
      </label>
    </div>
    <div>
      <label class="content-block-link-popup-label">
        Link URL: <textarea type="text" class="js-content-block-url-input"></textarea>
      </label>
    </div>
    <div>
      <label class="content-block-link-popup-checkbox-label">
        <input type="checkbox" checked class="js-content-block-url-black-checkbox">
        In neuem Tab öffnen
      </label>
    </div>

    <div class="d-flex justify-between">
        <div class="d-flex u-gap-10">
          <button class="projekt-content-block-edit--button -green -with-background js-content-block-accept-link-edit" >
            <i class="fas fa-save"></i>
            Speichern
          </button>

          <button class="projekt-content-block-edit--button -with-background js-content-block-cancel-link-edit" >
            <i class="fas fa-xmark"></i>
            Abbrechen
          </button>
        </div>
        <button class="projekt-content-block-edit--button -red -with-background js-content-block-delete-link" style="display: none;">
          <i class="fas fa-trash"></i>
          Link entfernen
        </button>
    </div>
  </div>

  <template class="js-ai-edit-popup-template">
    <div class="content-block-ai-edit-popup js-content-block-ai-edit-popup">
      <div class="content-block-ai-edit-popup-content">

        <form class="width-100" action="">
          <div class="content-block-ai-edit-popup-header">
            <h3>Mit KI bearbeiten</h3>
            <div class="ai-edit-mode--loader bars-scale-loader" style="display: none;"></div>
          </div>
          <div class="ai-edit-form">
            <div class="ai-default-context-hint">
              <%= t("ai.default_context_hint") %>
            </div>
            <textarea
              name="instructions"
              rows="4"
              required
              placeholder="Geben Sie Ihre Anweisungen zur Bearbeitung dieses Inhaltsblocks ein..."
              class="ai-instructions-textarea js-ai-instructions-textarea"
              ></textarea>
            <div style="color: #999; font-size: 12px; margin-top: 5px;">
              Enter zum Absenden, Umschalt+Enter für neue Zeile
            </div>
          </div>
          <div class="ai-edit-actions d-flex justify-between">
            <div>
              <label class="content-block-ai-edit-popup-checkbox-label">
                <input type="checkbox" class="js-ai-use-full-projekt-context">
                <span><%= t("ai.use_full_projekt_context") %></span>
              </label>
              <div class="ai-context-checkbox-hint">
                <%= t("ai.use_full_projekt_context_hint") %>
              </div>
            </div>
            <button type="button" class="projekt-content-block-edit--button -green -with-background js-content-block-ai-edit--submit-prompt">
              <span class="js-submit-state">
                <i class="fas fa-magic"></i>
                Absenden
              </span>
              <span class="js-cancel-state">
                <i class="fas fa-times"></i>
                Abbrechen
              </span>
            </button>
          </div>

        </form>
      </div>
    </div>
  </template>

<% end %>

<% if @custom_page.landing? %>
  <%= render "pages/landing_page_content" %>
<% else %>
  <% landing_page = @custom_page&.projekt&.landing_pages&.first %>
  <% if landing_page.present? %>
    <%= render "pages/brand_color_styles", page: landing_page %>
  <% end %>

  <%= content_for :body_class, "custom-page" %>
  <% provide :title do %><%= @custom_page.title %><% end %>

  <% provide :social_media_meta_tags do %>
    <%= render "shared/social_media_meta_tags",
      social_title: @custom_page.title,
      social_description: strip_tags(@custom_page.content).to_s[0..200],
      og_image_url: (@custom_page.image.present? ? polymorphic_path(@custom_page.image.attachment) : nil),
      social_url: page_url(@custom_page.slug),
      twitter_image_url: (@custom_page.image.present? ? polymorphic_path(@custom_page.image) : nil) %>
  <% end %>

  <% if @custom_page.projekt.present? && projekt_feature?(@custom_page.projekt, "general.vc_map_enabled") %>
    <% provide :vc_maps do %>
      <script id="vcmap-core" type="module" src="/vcmap/vcmap-core.js"></script>
    <% end %>
  <% end %>

  <style>
    <% if @custom_page.image&.attached? %>
      .custom-page-banner {
        background-image: url("<%= url_for(@custom_page.image.attachment) %>");
        background-size: cover;
        background-position: center center;
      }
    <% end %>
  </style>

  <% additional_main_class = show_admin_controls_for_projekt?(@projekt) ? "projekt-studio" : "" %>

  <main
    class="projekt-page <%= additional_main_class %> js-projekt-page"
    data-projekt-id="<%= @custom_page.projekt&.id %>"
    data-default-margin-bottom="<%= SiteCustomization::ContentBlock::DEFAULT_MARGIN_BOTTOM %>"
  >
    <% if @custom_page.projekt.present? %>
      <div class="custom-fixed-tabs margin-bottom">
        <div class="custom-fixed-tabs--content">
          <div class="js-scroll-link custom-tab" data-anchor-id="projekt-body">
            Inhalt
          </div>
          <div class="js-scroll-link custom-tab" data-anchor-id="projekt-info">
            Info
          </div>
          <% if @custom_page.projekt.present? && @custom_page.projekt.projekt_phases.active.any? %>
            <div class="js-scroll-link custom-tab" data-anchor-id="projekt-particapation">
              Beteiligung
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render Projekts::BannerComponent.new(custom_page: @custom_page) %>

    <% if native_projekt_studio?(@projekt) %>
      <button
        class="projekt-studio--peview-button js-turn-on-preview-mode-button"
        title="Vorschaumodus umschalten"
        type="button"
      >
        <i class="fas fa-laptop"></i>
        <span class="js-projekt-studio-preview-button-text">
          Vorschaumodus
        </span>
      </button>
    <% end %>

    <% if @custom_page.projekt.present? %>
      <div class="flex-layout">
        <div class="main-column">
          <div class="js-anchor-navigation-content" id="projekt-body">
            <% if @custom_page.content.present? || @custom_page&.projekt.new_content_block_mode? %>
              <div class="main-content-card">
                <% if @custom_page.content&.include?('template_projekt_library') %>
                  <%= render "projekt_library", projekt: @custom_page.projekt %>
                <% else %>
                  <%= render "custom_page_content" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <div id="projekt-info">
          <%= render partial: 'pages/sidebar_new', locals: { projekt: @custom_page.projekt, id_prefix: "desktop" } %>
        </div>
      </div>

    <% else %>
      <div class="main-column">
        <%= render 'custom_page_content' %>
      </div>
    <% end %>

    <% if @custom_page.projekt.present? && (@custom_page.projekt.projekt_phases.active.any? || show_admin_controls_for_projekt?(@custom_page.projekt)) %>
      <div class="js-anchor-navigation-content" id="projekt-particapation">
        <div class="projekt-footer-anchor" id="projekt-footer"> </div>
        <div class="projekt-footer flex-layout">
          <div class="full-width-column">
            <%= render Pages::Projekts::FooterPhasesComponent.new(@custom_page.projekt, @default_projekt_phase, namespace: @namespace) %>
            <% if @default_projekt_phase.present? %>
              <div id="footer-content" class="js-projekt-footer-content">
                <%= render "pages/projekt_footer_new/#{@default_projekt_phase.name}" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </main>
<% end %>
