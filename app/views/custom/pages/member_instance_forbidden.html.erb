<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <title>Error 403 | <%= t("custom.member_instance.access.title") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
  body {
    background: #065687 url('/errors_bg.jpg');
    color: #2E2F30;
    font-family: arial, sans-serif;
    margin: 0;
    text-align: center;
  }

  h1 {
    font-size: 160px;
    line-height: 160px;
  }

  h1, h2, h3, h4 {
    color: white;
    margin: 0;
  }

  div.error {
    box-sizing: border-box;
    margin: 0 auto;
    max-width: 680px;
    padding: 10vh 20px;
  }

  div.error h4 {
    font-weight: normal;
    margin-top: 20px;
  }

  a {
    color: #fff;
  }

  .sign-out {
    -webkit-appearance: none;
    appearance: none;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 96px;
      line-height: 96px;
    }
  }
  </style>
</head>

<body>
  <div class="error">
    <h1>403</h1>
    <h2 style="margin-top:20px;"><%= t("custom.member_instance.access.title") %></h2>
    <h4><%= t("custom.member_instance.access.body") %></h4>
    <h4><%= t("custom.member_instance.access.contact_hint") %></h4>
    <h3 style="margin-top:30px">
      <%= button_to t("custom.member_instance.access.sign_out"), destroy_user_session_path,
                    method: :delete, class: "sign-out", form: { style: "display:inline" } %>
    </h3>
  </div>
</body>
</html>
