<div class="row">
  <p id="proposal_notifications" class="small-12 column notification-body">
    <% if @projekt_notifications.blank? %>
      <div class="callout primary text-center">
        <%= t("proposals.show.no_notifications") %>
      </div>
    <% end %>

    <% @projekt_notifications.each do |notification| %>
      <div id="<%= dom_id(notification) %>">
        <h2><%= notification.title %></h2>
        <p class="more-info"><%= l notification.created_at.to_date %></p>
        <%= simple_format sanitize_and_auto_link(notification.body), {}, sanitize: false %>
      </div>
    <% end %>
  </p>
</div>
