$("#filter-subnav li").removeClass("is-active")
$("#filter-subnav li").attr("aria-selected", "false")
$("li#filter-subnav-<%= @projekt_phase.id %>").addClass("is-active")
$("li#filter-subnav-<%= @projekt_phase.id %>").attr("aria-selected", "true")
$("#footer-content").removeClass("show-loader");
<% footer_version = Setting.new_design_enabled? ? 'projekt_footer_new' : 'projekt_footer'  %>
$("#footer-content > .loader-spinner-wrapper > .loader-spinner-wrapper--content").html("<%= j safe_join([render("pages/#{footer_version}/#{@projekt_phase.name}"), render("pages/projekt_footer/partials/phase_outro", projekt_phase: @projekt_phase)]) %>");
App.Projekts.toggleDefaultProjekts()
App.Projekts.toggleProjektsInSidebarFilter();
App.Studio.SiteContentBlockEditor.initialize();
App.CollapseTextComponent.enableHoverButtons();
App.LivesteamLivequestion.initialize();
App.IframeFilter.initialize();
App.BarChartComponent.initialize();
App.AreaChartComponent.initialize();
App.HeatmapComponent.initialize();
App.PieChartComponent.initialize();
App.ProjektFooterPhaseRegenerate.startPollingForProcessing();


<% if @projekt_phase.is_a?(ProjektPhase::LegislationPhase) %>
  App.Legislation.initialize();
  App.LegislationAnnotatable.initialize();
<% end %>

if ($(".legislation-annotatable").length) {
  App.LegislationAnnotatable.destroy();
  App.LegislationAnnotatable.initialize();
}

$("#sidebar-cta").html("<%= j render Pages::Projekts::SidebarCtaComponent.new(@projekt_phase) %>");

$('#footer-content').foundation();

$("html, body").animate({ scrollTop: $("#<%= params["scroll_to"] || "footer-content" %>").offset().top - 100 }, 500);

App.Map.refreshMapsIn('#footer-content');
