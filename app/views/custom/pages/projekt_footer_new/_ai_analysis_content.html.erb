<div class='participation-stats js-participation-stats js-participation-stats-analysis'>
  <% if can?(:refresh_stats, @projekt_phase) %>
    <div class="u-flex margin-bottom u-full-width u-justify-between u-align-start js-studio-hide-on-preview">
      <div class="u-flex u-gap-15">
        <%= link_to evaluation_visibility_adm_projekts_projekt_path(@projekt_phase.projekt), data: { turbolinks: false }, class: "button with-icon" do %>
          <i class="fas fa-eye"></i>
          <%= t("adm.projekts.projekts.evaluation.overview.action_visibility") %>
        <% end %>

        <%= render Shared::StatsRefreshButtonComponent.new(
          refresh_path: refresh_ai_stats_projekt_phase_path(@projekt_phase),
          status_path: ai_stats_status_projekt_phase_path(@projekt_phase),
          section: "analysis",
          last_updated_at: @projekt_phase.ai_stats_refreshed_at,
          processing: @projekt_phase.ai_stats_refresh_processing? || @projekt_phase.ai_stats_refresh_pending?,
          disabled: !Ai::Settings.ai_available?
        ) %>
      </div>

      <div class="u-flex u-gap-15 u-align-center">
        <%= render "pages/projekt_footer_new/tab_visibility_toggle", tab: "ai" %>

        <% unless local_assigns[:hide_stats_link] %>
          <%= link_to stats_projekt_phase_path(@projekt_phase), data: { turbolinks: false }, class: "button with-icon", tabindex: "-1" do %>
            <i class="fas fa-chart-bar"></i>
            <%= t("custom.projekt_phases.subnav.full_stats") %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @projekt_phase.is_a?(ProjektPhase::ProposalPhase) || @projekt_phase.is_a?(ProjektPhase::BudgetPhase) || @projekt_phase.is_a?(ProjektPhase::CommentPhase) %>
    <%= render ParticapationStats::SummaryComponent.new(projekt_phase: @projekt_phase) %>
  <% end %>

  <% if @projekt_phase.is_a?(ProjektPhase::ProposalPhase) || @projekt_phase.is_a?(ProjektPhase::BudgetPhase) %>
    <%= render ParticapationStats::AiQuestionSectionComponent.new(projekt_phase: @projekt_phase) %>
  <% end %>

  <% if @projekt_phase.is_a?(ProjektPhase::ProposalPhase) || @projekt_phase.is_a?(ProjektPhase::BudgetPhase)  %>
    <%= render ParticapationStats::TopicClusteringComponent.new(projekt_phase: @projekt_phase) %>
    <%= render ParticapationStats::SemanticClusteringComponent.new(projekt_phase: @projekt_phase) %>
  <% end %>
</div>
