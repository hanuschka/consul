<% if can?(:refresh_stats, @projekt_phase) %>
  <div class="u-flex margin-bottom u-full-width u-justify-between u-align-start">
    <div class="u-flex u-gap-15">
      <%= render Shared::StatsRefreshComponent.new(
        refresh_path: refresh_ai_stats_projekt_phase_path(@projekt_phase),
        status_path: ai_stats_status_projekt_phase_path(@projekt_phase),
        section: "analysis",
        last_updated_at: @projekt_phase.ai_stats_refreshed_at,
        processing: @projekt_phase.ai_stats_refresh_processing? || @projekt_phase.ai_stats_refresh_pending?
      ) %>
    </div>

    <% unless local_assigns[:hide_stats_link] %>
      <%= link_to stats_projekt_phase_path(@projekt_phase), data: { turbolinks: false }, class: "button with-icon" do %>
        <i class="fas fa-chart-bar"></i>
        <%= t("custom.projekt_phases.subnav.full_stats") %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class='participation-stats js-participation-stats js-participation-stats-analysis'>
  <%= render "custom/pages/projekt_footer_new/ai_analysis_sections", projekt_phase: @projekt_phase, stats: @stats %>
</div>
