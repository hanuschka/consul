<div class="projekt-footer--inner">
<% if @budget.present? %>
  <%= render Pages::Projekts::BudgetsTabComponent.new(@budget, @ballot, current_user) %>
<% end %>

<%= render "custom/pages/projekt_footer/partials/phase_intro", projekt_phase: @projekt_phase %>

<% if can?(:read_results, @budget) || can?(:read_stats, @budget) %>
  <%= render Pages::Projekts::BudgetsSubnavComponent.new(@budget, @projekt_phase) %>
<% end %>

<div class="flex justify-between items-center">
  <div class="hide-on-small-tablet">
    <% if (@budget.current_phase.kind == "accepting" || (@budget.current_phase.kind == "reviewing" && current_user&.has_pm_permission_to?("manage", @projekt_phase.projekt))) && !params[:section].in?(%w[results stats evaluation ai_evaluation key_metrics analysis]) %>
      <div class="new-resource-cta <%= 'hide-on-small-tablet' if projekt_feature?(@projekt_phase.projekt, 'sidebar.new_resource_button_in_sidebar') %> <%= 'js-studio-hide-on-preview' if @budget.current_phase.kind == 'reviewing' %>">
        <%= render Shared::NewButtonComponent.new(projekt_phase: @projekt_phase) %>
      </div>
    <% end %>
  </div>
</div>

<% if @budget.present? %>
  <% if params[:section] == "results" && can?(:read_results, @budget) %>
    <div class="<%= 'js-studio-hide-on-preview' if !@budget.results_enabled? %>">
      <%= render "pages/projekt_footer_new/budget/results" %>
    </div>
  <% elsif params[:section].in?(%w[evaluation ai_evaluation]) %>
    <%= render "custom/pages/projekt_footer_new/footer_evaluation_dispatch" %>
  <% else %>
  <% if @budget.current_phase.kind == 'informing' %>
    <div class="flex-layout">
      <div class="new-card">
        <h2>
          Noch keine Vorschläge vorhanden
        </h2>
          <% if @budget.phases.accepting.starts_at.present? %>
            <div>
              Vorschläge können erst in der nächsten Phase
              eingereicht werden. Diese beginnt am
              <%= I18n.l(@budget.phases.accepting.starts_at, format: :new_date_with_year) %>.
            </div>
          <% end %>
      </div>
    </div>
  <% else %>
      <% if browse_mode_in_projekt_footer_tab?(@projekt_phase) %>
        <div class="navigable-proposal-list">
          <% if @investments.any? %>
            <div class="margin-bottom">
            </div>
            <%= render Navigation::ProposalBrowseNavigationComponent.new(
              resources: @investments,
              projekt_phase: @projekt_phase
            ) %>
          <div class="current-proposal">
            <%= render "budgets/investments/show_content", investment: @investment, in_projekt_footer: true, comment_tree: @comment_tree %>
          </div>
        <% end %>
      <% else %>
        <% if projekt_phase_feature?(@projekt_phase, "form.show_map") %>
          <%= render Shared::MapComponent.new(
            mappable: @projekt_phase,
            features: @investment_coordinates,
            process: 'investments',
            map_data_url: map_data_path(
              source: "budget_phase",
              projekt_phase_id: @projekt_phase.id,
              filter: params[:filter],
              search: params[:search],
              projekt_label_ids: params[:projekt_label_ids],
              sentiment_id: params[:sentiment_id]
            )
          ) %>
        <% end %>

        <div class="flex-layout">
          <% budget_investments_footer_url = projekt_phase_footer_tab_page_path(@projekt_phase.projekt.page, @projekt_phase.id) %>
          <div class="main-column">
            <% investment_ids = @investments.pluck(:id) %>
            <%= render Resources::List::BaseComponent.new(
              empty_text: t("custom.budgets.investments.index.empty_list_text")
            ) do |c| %>
              <% c.with_toolbar(
                i18n_namespace: "custom.budgets.investments.index",
                filters: @valid_orders,
                current_filter: @current_order,
                param: "order",
                text_search_enabled: true,
                remote_url: budget_investments_footer_url,
                in_projekt_footer_tab: true
              ) %>

              <% if @investments.present? %>
                <% c.with_items do %>
                  <% @investments.each do |investment| %>
                    <%= render Budgets::Investments::ListItemComponent.new(
                      budget_investment: investment,
                      budget_investment_ids: investment_ids,
                      ballot: @ballot
                    ) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
            <%= paginate @investments, remote: true, params: { controller: "pages", action: "projekt_phase_footer_tab" } %>
          </div>

          <div class="sidebar" id="sidebar">
            <%= render "budgets/investments/sidebar_new" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% end %>
<% else %>
  <h2>Dieses Projekt Phase hat kein zugehöriges Budget</h2>
<% end %>
</div>
