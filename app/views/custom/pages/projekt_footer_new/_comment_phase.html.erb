<%= render "custom/pages/projekt_footer/partials/phase_intro", projekt_phase: @projekt_phase %>

<% unless embedded? %>
  <%= render ProjektPhaseSubnavComponent.new(@projekt_phase) %>

  <% if params[:section] == "evaluation" && show_phase_evaluation_in_footer?(@projekt_phase) %>
    <%= render "custom/pages/projekt_footer_new/evaluation_content" %>

  <% elsif params[:section] == "key_metrics" && can?(:read_stats, @projekt_phase) && (current_user&.administrator? || current_user&.projekt_manager? || projekt_phase_feature?(@projekt_phase, "general.public_kpi_stats")) %>
    <div class="<%= 'js-studio-hide-on-preview' if !projekt_phase_feature?(@projekt_phase, 'general.public_kpi_stats') %>">
      <%= render "custom/pages/projekt_footer_new/kpi_stats_content" %>
    </div>

  <% elsif params[:section] == "analysis" && can?(:read_stats, @projekt_phase) && Ai::Settings.ai_available? && (current_user&.administrator? || current_user&.projekt_manager? || projekt_phase_feature?(@projekt_phase, "general.public_ai_stats")) %>
    <div class="<%= 'js-studio-hide-on-preview' if !projekt_phase_feature?(@projekt_phase, 'general.public_ai_stats') %>">
      <%= render "custom/pages/projekt_footer_new/ai_analysis_content" %>
    </div>

  <% else %>
    <%= render Shared::NewCommentsComponent.new(@commentable, @comment_tree, show_title: false, remote_url: projekt_footer_phase_filter_url(@projekt_phase), anchor: 'footer-content') %>
  <% end %>
<% end %>
