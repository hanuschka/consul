<%= render "custom/pages/projekt_footer/partials/phase_intro", projekt_phase: @projekt_phase %>

<% unless embedded? %>
  <%= render ProjektPhaseSubnavComponent.new(@projekt_phase) %>

  <% if params[:section] == "key_metrics" && can?(:read_stats, @projekt_phase) %>
    <%= render "custom/pages/projekt_footer_new/kpi_stats_content" %>

  <% elsif params[:section] == "analysis" && can?(:read_stats, @projekt_phase) && Ai::Settings.ai_available? %>
    <%= render "custom/pages/projekt_footer_new/ai_analysis_content" %>

  <% else %>
    <%= render Shared::NewCommentsComponent.new(@commentable, @comment_tree, show_title: false, remote_url: projekt_footer_phase_filter_url(@projekt_phase), anchor: 'footer-content') %>
  <% end %>
<% end %>
