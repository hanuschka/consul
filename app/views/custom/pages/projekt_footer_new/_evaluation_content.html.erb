<%
  only_tab = local_assigns.fetch(:only_tab, "stats")
  projekt_phase = @projekt_phase
  evaluation_row = projekt_phase.projekt_phase_evaluation
  partial_name = evaluation_phase_section_partial[projekt_phase.type]
%>

<% if evaluation_row.present? && partial_name.present? %>
  <%
    phase_data = evaluation_row.data || {}

    if @live_phase_stats.present?
      phase_data = phase_data.merge("stats" => @live_phase_stats)
    end

    palette = evaluation_phase_palette[projekt_phase.type]
    selection = PhaseEvaluationVisibility::Selector.for_phase(projekt_phase)
    is_admin_or_pm = footer_admin_or_projekt_manager?
    can_manage_visibility = can?(:edit, projekt_phase.projekt)
    section_visibility = projekt_phase.projekt_phase_evaluation_visibility
    visibility_toggle_url = toggle_evaluation_section_visibility_adm_projekts_projekt_path(projekt_phase.projekt, format: :json)
    processing = evaluation_row.processing?
    failed = evaluation_row.failed?

    if only_tab == "ai"
      regenerate_url = regenerate_phase_ai_stats_adm_projekts_projekt_path(projekt_phase.projekt, phase_id: projekt_phase.id)
      regenerate_label = t("adm.projekts.projekts.evaluation.regenerate_ai_stats_button")
      regenerate_tooltip = t("adm.projekts.projekts.evaluation.regenerate_ai_stats_tooltip")
      generated_at_iso = phase_data["ai_generated_at"]
    else
      regenerate_url = regenerate_phase_regular_stats_adm_projekts_projekt_path(projekt_phase.projekt, phase_id: projekt_phase.id)
      regenerate_label = t("adm.projekts.projekts.evaluation.regenerate_regular_stats_button")
      regenerate_tooltip = t("adm.projekts.projekts.evaluation.regenerate_regular_stats_tooltip")
      generated_at_iso = phase_data["regular_generated_at"]
    end

    generated_at_time = generated_at_iso.present? ? Time.zone.parse(generated_at_iso.to_s) : evaluation_row.generated_at

    status_url = phase_evaluation_status_adm_projekts_projekt_path(projekt_phase.projekt, phase_id: projekt_phase.id)
  %>

  <div
    class="adm-projekt-evaluation-report projekt-footer-evaluation js-projekt-footer-phase-regenerate"
    data-status-url="<%= status_url %>"
    data-phase-id="<%= projekt_phase.id %>"
  >
    <div
      class="projekt-footer-evaluation__loading js-projekt-footer-phase-regenerate-loading"
      <%= "hidden" if !processing %>
    >
      <div class="adm-empty-state">
        <h3><%= t("adm.projekts.projekts.evaluation.phase_processing_title") %></h3>
        <p><%= t("adm.projekts.projekts.evaluation.phase_processing_description") %></p>
        <i
          class="fas fa-circle-notch adm-spinner adm-spinner--lg"
          aria-hidden="true"
        ></i>
      </div>
    </div>

    <div
      class="projekt-footer-evaluation__content js-projekt-footer-phase-regenerate-content"
      <%= "hidden" if processing %>
    >
      <% if failed %>
        <div class="adm-empty-state">
          <h3><%= t("adm.projekts.projekts.evaluation.phase_failed_title") %></h3>
          <p><%= t("adm.projekts.projekts.evaluation.phase_failed_description") %></p>

          <% if is_admin_or_pm %>
            <a
              href="<%= regenerate_url %>"
              class="button button-primary js-studio-hide-on-preview js-projekt-footer-phase-regenerate-trigger"
              tabindex="-1"
            >
              <i class="fas fa-sync-alt" aria-hidden="true"></i>
              <span><%= t("adm.projekts.projekts.evaluation.phase_retry_button") %></span>
            </a>
          <% end %>
        </div>
      <% else %>
        <% if is_admin_or_pm %>
          <div class="projekt-footer-evaluation__toolbar js-studio-hide-on-preview">
            <% if generated_at_time.present? %>
              <span class="projekt-footer-evaluation__generated-at">
                <i class="fas fa-clock" aria-hidden="true"></i>
                <%= t("adm.projekts.projekts.evaluation.phase_tab.generated_at", date: l(generated_at_time, format: :long)) %>
              </span>
            <% end %>

            <rich-tooltip delay="300" trigger-only shadow="heavy" size="big">
              <a
                href="<%= regenerate_url %>"
                class="button hollow projekt-footer-evaluation__regen-button js-projekt-footer-phase-regenerate-trigger"
                tabindex="-1"
              >
                <i class="fas fa-sync-alt" aria-hidden="true"></i>
                <span><%= regenerate_label %></span>
              </a>
              <template><%= regenerate_tooltip %></template>
            </rich-tooltip>

            <%= render "pages/projekt_footer_new/tab_visibility_toggle", tab: only_tab %>
          </div>
        <% end %>

        <% visibility_token = projekt_phase.projekt_phase_evaluation_visibility&.cache_key_with_version || "none" %>
        <% live_stats_bucket = @live_phase_stats.present? ? footer_live_stats_cache_bucket : "none" %>
        <% cache_key = [evaluation_row, only_tab, visibility_token, live_stats_bucket, @frontend_answer_poll&.id] %>
        <% cache_if(!is_admin_or_pm, cache_key) do %>
          <%= render partial: "adm/projekts/projekts/evaluation/#{partial_name}",
            locals: {
              projekt: projekt_phase.projekt,
              phase: phase_data,
              accent_color: palette[:accent],
              accent_light_color: palette[:accent_light],
              accent_shades: palette[:shades],
              selection: can_manage_visibility ? nil : selection,
              only_tab: only_tab,
              tabbed: false,
              hidden_sections: ["kpis"],
              visibility_toggle: can_manage_visibility,
              visibility: section_visibility,
              visibility_toggle_url: visibility_toggle_url
            } %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
