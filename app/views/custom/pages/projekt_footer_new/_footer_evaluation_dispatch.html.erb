<% eval_tab = params[:section] == "ai_evaluation" ? "ai" : "stats" %>

<% if params[:section] == "poll_stats" %>
  <% if footer_evaluation_tab_available?(@projekt_phase, "poll_stats") && @poll_stats_entries.present? %>
    <div
      class="js-footer-tab-content <%= 'js-studio-hide-on-preview' if !footer_evaluation_tab_public_visible?(@projekt_phase, 'poll_stats') %>"
      data-visibility-group="poll_stats"
    >
      <%= render "custom/pages/projekt_footer_new/poll_stats_content" %>
    </div>
  <% end %>

<% else %>
  <% if footer_evaluation_tab_available?(@projekt_phase, eval_tab) %>
    <div
      class="js-footer-tab-content <%= 'js-studio-hide-on-preview' if !footer_evaluation_tab_public_visible?(@projekt_phase, eval_tab) %>"
      data-visibility-group="<%= eval_tab %>"
    >
      <%= render "custom/pages/projekt_footer_new/evaluation_content", only_tab: eval_tab %>
    </div>
  <% end %>
<% end %>
