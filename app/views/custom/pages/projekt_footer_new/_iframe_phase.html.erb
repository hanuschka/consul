<div class="projekt-footer--inner">
<%= render "custom/pages/projekt_footer/partials/phase_intro", projekt_phase: @projekt_phase %>

<% permission_problem = @projekt_phase.permission_problem(current_user) %>

<% if permission_problem.present? && permission_problem != :guest_not_logged_in %>
  <div class="projekt-phase-permission-problem-message">
    <%= projekt_phase_view_permission_problem_message(permission_problem, @projekt_phase) %>
  </div>
<% else %>
  <% content = capture do %>
    <iframe
      src="<%= @iframe_url %>"
      title="<%= @projekt_phase.title %>"
      class="projekt-phase-iframe"
      onload="App.IframeResizer.resize(this)"
      width="<%= @iframe_width %>"
      height="<%= @iframe_height %>"
      frameborder="0"
      allow="fullscreen"
      allowfullscreen
    ></iframe>
  <% end %>

  <% if extended_feature?("gdpr.two_click_iframe_solution") %>
    <%= sanitize process_iframe_embeds(content), tags: %w[iframe], attributes: %w[class width height frameborder src data-src title allow allowfullscreen] %>
  <% else %>
    <%= content %>
  <% end %>
<% end %>
</div>
