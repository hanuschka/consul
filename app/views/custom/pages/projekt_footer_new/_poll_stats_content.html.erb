<% if footer_admin_or_projekt_manager? %>
  <div class="projekt-footer-evaluation__toolbar js-studio-hide-on-preview">
    <%= render "pages/projekt_footer_new/tab_visibility_toggle", tab: "poll_stats" %>
  </div>
<% end %>

<% cache_if(
  !footer_admin_or_projekt_manager?,
  [@projekt_phase, "footer_poll_stats"],
  expires_in: ProjektPhaseSettingsHelper::FOOTER_LIVE_STATS_TTL
) do %>
  <div class="adm-projekt-evaluation-report projekt-footer-evaluation">
    <%= render "adm/projekts/projekts/evaluation/poll_stats_tab", entries: @poll_stats_entries %>
  </div>
<% end %>
