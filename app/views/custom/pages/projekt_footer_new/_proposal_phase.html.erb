<div class="projekt-footer--inner">
<%= render "custom/pages/projekt_footer/partials/phase_intro", projekt_phase: @projekt_phase %>

<%= render ProjektPhaseSubnavComponent.new(@projekt_phase) %>

<% if params[:section].in?(%w[evaluation ai_evaluation]) %>
  <%= render "custom/pages/projekt_footer_new/footer_evaluation_dispatch" %>

<% else %>
  <div class="flex justify-between items-center">
    <div class="hide-on-small-tablet">
      <div class="new-resource-cta">
        <%= render Shared::NewButtonComponent.new(projekt_phase: @projekt_phase) %>
      </div>
    </div>
  </div>

  <% proposal_footer_url = projekt_phase_footer_tab_page_path(@projekt_phase.projekt.page, @projekt_phase.id) %>

  <% if browse_mode_in_projekt_footer_tab?(@projekt_phase) %>
    <div class="navigable-proposal-list">
      <% if @proposals.any? %>
        <div class="margin-bottom">
        </div>
        <%= render Navigation::ProposalBrowseNavigationComponent.new(
          resources: @proposals,
          projekt_phase: @projekt_phase,
          current_order: @current_order
        ) %>
        <% current_proposal = @proposals.first %>
        <div class="current-proposal">
          <%= render "proposals/show_content", proposal: current_proposal, in_projekt_footer: true, comment_tree: @comment_tree %>
        </div>
      <% else %>
        <div class="callout primary">
          <%= t("custom.proposals.index.empty_list_text") %>
        </div>
      <% end %>
    </div>
  <% else %>
    <% if projekt_phase_feature?(@projekt_phase, "form.show_map") %>
      <%= render Shared::MapComponent.new(
        mappable: @projekt_phase,
        features: @proposals_coordinates,
        features_count: @proposals_map_pin_count,
        process: 'proposals',
        map_data_url: map_data_path(
          source: "proposal_phase",
          projekt_phase_id: @projekt_phase.id,
          search: params[:search],
          projekt_label_ids: params[:projekt_label_ids],
          sentiment_id: params[:sentiment_id],
          my_posts_filter: params[:my_posts_filter]
        )
      ) %>
    <% end %>
    <div class="flex-layout flex-layout-reverse-on-mobile">
      <div class="main-column">
        <%= render Resources::List::BaseComponent.new(
          empty_text: t("custom.proposals.index.empty_list_text")
        ) do |c| %>
          <% c.with_toolbar(
            i18n_namespace: "custom.proposals.index",
            filters: @valid_orders,
            current_filter: @current_order,
            param: "order",
            text_search_enabled: true,
            remote_url: projekt_footer_phase_filter_url(@projekt_phase),
            in_projekt_footer_tab: true
          ) %>

          <% if @proposals.present? %>
            <% proposal_ids = @proposals.map(&:id) %>
            <% c.with_items do %>
              <% @proposals.each do |proposal| %>
                <%= render Proposals::ListItemComponent.new(proposal: proposal,
                      proposal_ids: proposal_ids) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <%= paginate @proposals, remote: true, params: { controller: "pages", action: "projekt_phase_footer_tab" } %>
      </div>

      <aside id="proposals-sidebar" class="sidebar">
        <% content_block_sidebar_name = "projekt_phase_footer_sidebar_#{@projekt_phase.id}" %>
        <% if render_custom_projekt_content_block?(content_block_sidebar_name, @projekt_phase.projekt) ||
            projekt_phase_feature?(@projekt_phase, "general.browse_mode_in_phase_footer")
        %>
          <%= render Shared::SidebarCardComponent.new(title: t("custom.proposals.index.participation_information"), icon_name: "info-circle", opened_on_mobile: true) do |c| %>
            <%= render_custom_block content_block_sidebar_name %>

            <% if projekt_phase_feature?(@projekt_phase, "general.browse_mode_in_phase_footer") && !browse_mode_in_projekt_footer_tab?(@projekt_phase) %>
              <%= link_to projekt_phase_footer_tab_page_path(@projekt_phase.projekt.page, @projekt_phase.id, proposal_view_mode: "browse", order: @current_order),
                remote: true,
                class: "button with-icon" do %>
                <i class="fa-window-maximize fas"></i>
                <%= t("custom.projekt_phases.proposal_navigation.back_to_detail_view") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if @projekt_phase.projekt_labels.any? %>
          <%= render Shared::SidebarCardComponent.new(title: @projekt_phase.projekt_labels_label_text, icon_name: "tags") do |c| %>
            <%= render Shared::ProjektLabelsComponent.new(projekt_phase_id: @projekt_phase.id) %>
          <% end %>
        <% end %>

        <% if @projekt_phase.sentiments.any? %>
          <%= render Shared::SidebarCardComponent.new(title: @projekt_phase.sentiment_label_text, icon_name: "heart") do |c| %>
            <%= render Shared::SentimentsComponent.new(projekt_phase_id: @projekt_phase.id) %>
          <% end %>
        <% end %>

        <% if current_user.present? && extended_feature?('proposals.enable_my_posts_filter') %>
          <%= render Sidebar::Filters::MyPostsCardComponent.new %>
        <% end %>

        <%= render Sidebar::ExportListComponent.new(
          path: projekt_phase_footer_tab_page_path(@projekt_phase.projekt.page, @projekt_phase, **request.query_parameters, format: :csv)
        ) %>

        <div class="new-resource-cta <%= projekt_feature?(@projekt_phase.projekt, 'sidebar.new_resource_button_in_sidebar') ? 'hide' : 'hide-on-desktop' %>" style="width:100%;margin:2rem 0;">
          <%= render Shared::NewButtonComponent.new(projekt_phase: @projekt_phase) %>
        </div>
      </aside>
    </div>
  <% end %>
<% end %>
</div>
