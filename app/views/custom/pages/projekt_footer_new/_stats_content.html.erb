<% if can?(:refresh_stats, @projekt_phase) %>
  <div class="u-flex margin-bottom u-full-width u-justify-between u-align-start">
    <div class="u-flex u-gap-15">
      <div class="u-flex u-flex-column u-align-center">
        <div class="stats-button-container">
          <%= button_to(t("custom.projekt_phases.stats.refresh_stats_button"), refresh_stats_projekt_phase_path(@projekt_phase), class: "button") %>
        </div>
        <% if @projekt_phase.stats_refreshed_at.present? %>
          <div class="stats-last-updated-container">
            <p class="stats-last-updated-item">
              <%= t("custom.projekt_phases.stats.refresh_stats_last_updated", time: l(@projekt_phase.stats_refreshed_at, format: :short)) %>
            </p>
          </div>
        <% end %>
      </div>

      <%= render Shared::AiStatsRefreshComponent.new(
        resource: @projekt_phase,
        refresh_path: refresh_ai_stats_projekt_phase_path(@projekt_phase),
        status_path: ai_stats_status_projekt_phase_path(@projekt_phase)
      ) %>
    </div>

    <% unless local_assigns[:hide_stats_link] %>
      <%= link_to stats_projekt_phase_path(@projekt_phase), data: { turbolinks: false }, class: "button with-icon" do %>
        <i class="fas fa-chart-bar"></i>
        <%= t("custom.projekt_phases.subnav.full_stats") %>
      <% end %>
    <% end %>
  </div>

<% end %>

<div class='participation-stats js-poll-participation-stats'>
  <%= render "custom/pages/projekt_footer_new/participation_stats_sections", projekt_phase: @projekt_phase, stats: @stats %>
</div>
