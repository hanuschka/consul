<% if can?(:refresh_stats, @projekt_phase) %>
  <div class="margin-bottom">
    <%= button_to(t("custom.projekt_phases.stats.refresh_stats_button"), refresh_stats_projekt_phase_path(@projekt_phase), class: "button") %>
    <%= button_to(t("custom.projekt_phases.stats.refresh_ai_stats_button"), refresh_ai_stats_projekt_phase_path(@projekt_phase), class: "button secondary") %>
  </div>
<% end %>

<div class='participation-stats'>
  <%= render ParticapationStats::SummaryComponent.new(projekt_phase: @projekt_phase) %>

  <% if @projekt_phase.is_a?(ProjektPhase::ProposalPhase) %>
    <%= render "shared/stats/participation", stats: @stats %>
    <%= render ParticapationStats::LabelSentimentComponent.new(projekt_phase: @projekt_phase) %>
    <%= render ParticapationStats::TopicClusteringComponent.new(projekt_phase: @projekt_phase) %>
    <%= render ParticapationStats::SemanticClusteringComponent.new(projekt_phase: @projekt_phase) %>
    <%= render ParticapationStats::UserSegmentsComponent.new(stats: @stats) %>
    <%= render ParticapationStats::TimelineComponent.new(projekt_phase: @projekt_phase) %>
    <%= render ParticapationStats::HeatmapComponent.new(projekt_phase: @stats.projekt_phase) %>
  <% elsif @projekt_phase.is_a?(ProjektPhase::CommentPhase) %>
    <%= render ParticapationStats::TopicClusteringComponent.new(projekt_phase: @projekt_phase) %>
    <%= render ParticapationStats::SemanticClusteringComponent.new(projekt_phase: @projekt_phase) %>
  <% end %>
</div>
