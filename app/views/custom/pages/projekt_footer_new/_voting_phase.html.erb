<div class="projekt-footer--inner">
<%= render "custom/pages/projekt_footer/partials/phase_intro", projekt_phase: @projekt_phase %>

<%= render ProjektPhaseSubnavComponent.new(@projekt_phase) %>

<% if params[:section] == "evaluation" && show_phase_evaluation_in_footer?(@projekt_phase) %>
  <%= render "custom/pages/projekt_footer_new/evaluation_content" %>
<% else %>
  <div class="flex-layout flex-layout-reverse-on-mobile">
    <div class="main-column">
      <% if extended_feature?("polls.intro_text_for_polls") %>
        <%= render_custom_block "polls_welcome" %>
      <% end %>

      <%= render Resources::List::BaseComponent.new(
        empty_text: t("custom.polls.index.empty_list_text")
      ) do |c| %>
        <% c.with_toolbar(
          i18n_namespace: "custom.polls.index",
          filters: @valid_orders,
          current_filter: @current_filter,
          param: "order",
          remote_url: projekt_footer_phase_filter_url(@projekt_phase),
          in_projekt_footer_tab: true
        ) %>

        <% if @polls.present? %>
          <% c.with_items do %>
            <% @polls.each do |poll| %>
              <%= render Polls::ListItemComponent.new(poll: poll) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <%= paginate @polls, remote: true, params: { controller: "pages", action: "projekt_phase_footer_tab" } %>

    <div id="section_help" class="margin" data-magellan-target="section_help">
      <% if extended_feature?('modulewide.custom_help_text_in_modules')  %>
        <%= render_custom_block 'polls_help' %>
        <%= render_custom_partial "footer" %>
      <% end %>
    </div>
    </div>

    <div class="sidebar">
    </div>
  </div>
<% end %>
</div>
