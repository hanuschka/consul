<div class="extended-sidebar-map-wrapper">
  <div class="extended-sidebar-map">
    <% if @current_projekt.vc_map_enabled? %>
      <%= link_to extended_sidebar_map_page_path(projekt.page.slug), remote: true do %>
        <%= render Shared::VCMapComponent.new(
          map_location: @current_projekt.map_location,
          parent_class: "proposals_sidebar_extended",
          projekt: @current_projekt,
        ) %>
        <% reinitialize_map = "App.VCMap.initializeMap(document.querySelector('#footer-content *[data-vcmap]'));" %>
        ) %>
      <% end %>
    <% else %>
      <%= render Shared::MapComponent.new(
        map_location: @current_projekt.map_location,
        parent_class: "proposals_sidebar_extended",
        projekt: @current_projekt,
        saturated_admin_shape: true
      ) %>

      <% if use_mapbox?(@current_projekt) %>
        <% reinitialize_map = "App.Mapbox.initialize();" %>
      <% else %>
        <% reinitialize_map = "" %>
      <% end %>
    <% end %>

    <button class="close-button" aria-label="Close modal" type="button" onclick="$('#extended-sidebar-map').html('');$('#extended-sidebar-map').css('position', 'relative');<%= reinitialize_map %>">
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
</div>
