<div class="ai-question-item ai-question-item--completed">
  <%= render Shared::AccordionComponent.new(opened_by_default: false) do |c| %>
    <% c.with_head do %>
      <h3 class="ai-question-item--question"><%= question.question %></h3>
    <% end %>
    <% c.with_body do %>
      <div class="ai-question-item--answer">
        <%= sanitize(question.answer, tags: %w[h4 p ul li]) %>
      </div>
    <% end %>
  <% end %>

  <div class="ai-question-item--actions">
    <div class="ai-question-item--downloads">
      <%= link_to download_stat_answer_projekt_phase_path(projekt_phase, question_id: question.id, format: "txt"),
        class: "ai-question-download-btn" do %>
        <i class="fa fa-file-alt" aria-hidden="true"></i>
        <%= t("custom.participation_stats.ai_question.download_txt") %>
      <% end %>
      <%= link_to download_stat_answer_projekt_phase_path(projekt_phase, question_id: question.id, format: "pdf"),
        class: "ai-question-download-btn" do %>
        <i class="fa fa-file-pdf" aria-hidden="true"></i>
        <%= t("custom.participation_stats.ai_question.download_pdf") %>
      <% end %>
    </div>

    <div class="ai-question-item--meta">
      <span class="ai-question-item--date">
        <%= l(question.created_at, format: :short) %>
      </span>
      <button type="button"
              class="ai-question-item--delete-btn js-delete-stat-question"
              data-url="<%= delete_stat_question_projekt_phase_path(projekt_phase, question_id: question.id) %>"
              data-confirm-message="<%= t('custom.shared.destroy_confirmation') %>">
        <i class="fa fa-trash" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>
