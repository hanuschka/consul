<% content.each_with_index do |section, index| %>
  <section class="ai-stats-card margin-bottom">
    <h3 class="ai-stats-card--title"><%= section["title"] %></h3>
    <div class="ai-stats-card--content">
      <%= sanitize(section["content"], tags: %w[h4 p ul li strong em]) %>
    </div>
    <div class="ai-stats-card--actions u-flex u-gap-10">
      <%= render Polls::DownloadButtonsComponent.new(
        poll: poll,
        path_helper: :download_evaluation_section_poll_path,
        path_params: { section_index: index }
      ) %>
    </div>
  </section>
<% end %>
