<div id="projekt-event-registration-<%= projekt_event.id %>" style="width: 100%;">
  <% if projekt_event.registration_enabled? %>
    <div class="projekt-event-item-new-body--details-row">
      <i class="fa fa-users"></i>
      <span>
        <% if projekt_event.fully_booked? %>
          <%= t("custom.projekt_events.registration.fully_booked") %>
        <% else %>
          <%= t("custom.projekt_events.registration.spots_available",
                available: projekt_event.spots_available,
                total: projekt_event.max_attendees) %>
        <% end %>
      </span>
    </div>

    <div class="projekt-event-item-new-body--registration">
      <% if user_signed_in? %>
        <% registration = projekt_event.registration_for(current_user) %>
        <% if registration %>
          <span class="label <%= registration.status == 'confirmed' ? 'success' : 'warning' %>">
            <%= t("custom.projekt_events.registration.status_#{registration.status}") %>
          </span>
          <%= button_to t("custom.projekt_events.registration.cancel"),
                projekt_event_projekt_event_registration_path(projekt_event),
                method: :delete,
                remote: true,
                class: "button small hollow alert" %>
        <% elsif projekt_event.fully_booked? %>
          <span class="label warning">
            <%= t("custom.projekt_events.registration.fully_booked") %>
          </span>
        <% else %>
          <%= button_to t("custom.projekt_events.registration.register"),
                projekt_event_projekt_event_registration_path(projekt_event),
                method: :post,
                remote: true,
                class: "button small" %>
        <% end %>
      <% else %>
        <% if local_assigns[:guest_registered_event_id] == projekt_event.id ||
              Array(session[:guest_registered_event_ids]).include?(projekt_event.id) %>
          <span class="label success">
            <%= t("custom.projekt_events.registration.guest_registered") %>
          </span>
        <% elsif projekt_event.fully_booked? %>
          <span class="label warning">
            <%= t("custom.projekt_events.registration.fully_booked") %>
          </span>
        <% else %>
          <% form_id = "guest-registration-form-#{projekt_event.id}" %>
          <button class="button small"
                  onclick="document.getElementById('<%= form_id %>').style.display='block'; this.style.display='none';">
            <%= t("custom.projekt_events.registration.register") %>
          </button>
          <div id="<%= form_id %>" style="display: none;">
            <div class="row">
              <div class="columns medium-6">
                <%= form_with model: ProjektEventRegistration.new,
                              url: projekt_event_projekt_event_registration_path(projekt_event),
                              method: :post,
                              local: false,
                              class: "guest-registration-form" do |f| %>
                  <%= f.text_field :first_name,
                        placeholder: t("custom.projekt_events.registration.first_name"),
                        required: true %>
                  <%= f.text_field :last_name,
                        placeholder: t("custom.projekt_events.registration.last_name"),
                        required: true %>
                  <%= f.text_field :email,
                        placeholder: t("custom.projekt_events.registration.email"),
                        required: true %>
                  <%= f.submit t("custom.projekt_events.registration.register"),
                        class: "button small" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
