<% provide :title, t("custom.projekt_phases.stats.title") %>

<main>
  <%
    phase_date_range =
      if @projekt_phase.start_date.present? && @projekt_phase.end_date.present?
        format_date_range(@projekt_phase.start_date, @projekt_phase.end_date)
      end
  %>
  <%= render Projekts::SubpageBannerComponent.new(
      title: t("custom.projekt_phases.stats.banner_title", phase_title: @projekt_phase.title),
      projekt: @projekt_phase.projekt,
      date_range: phase_date_range
    )
  %>

  <div class="row">
    <div class="small-12 column">
      <%= render "custom/pages/projekt_footer_new/stats_content", hide_stats_link: true %>
    </div>
  </div>

  <div class="projekt-phase-stats--fixed-back-link">
    <%= link_to page_path(@projekt.page.slug, projekt_phase_id: @projekt_phase.id, anchor: "projekt-footer"), class: "button with-icon" do %>
      <i class="fas fa-arrow-left"></i>
      <%= t("custom.projekt_phases.stats.back_to_phase") %>
    <% end %>
  </div>
</main>
