<div class="collapse projekt-listing">
  <div class="projekt-listing--inner-container">
    <div class='image'>
      <% if projekt.image.present? %>
        <% if projekt.page.present? && projekt.visible_for?(current_user) %>
          <%= link_to projekt.page.url do %>
            <%= image_tag projekt.image.variant(:medium) %>
          <% end %>
        <% else %>
          <%= image_tag projekt.image.variant(:medium) %>
        <% end %>
      <% end %>
    </div>

    <div class='content'>
      <h4 class="projekt-title"><%= projekt.page.title %></h4>
      <p><%= sanitize projekt.page.subtitle %></p>
      <%= render "shared/tags", taggable: projekt, limit: 5 %>
    </div>
  </div>

  <% if projekt.page.present? && projekt.visible_for?(current_user) %>
    <div class='projekt-link'>
      <%= link_to t('custom.projekts.index.to_projekt'), projekt.page.url, class: 'button' %>
    </div>
  <% end %>
</div>
