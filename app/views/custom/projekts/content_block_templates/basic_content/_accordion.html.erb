<ul
  class="accordion"
  data-accordion=""
  data-allow-all-closed="true"
  role="tablist"
>

  <% 2.times do %>
    <li class="accordion-item" data-accordion-item="" role="presentation">
      <a
        class="accordion-title"
        href="#"
        style="color: black; font-size: 18px"
        role="tab"
        aria-expanded="false"
        aria-selected="false"
      >
        Akkordeon Menüpunkt
      </a>
      <div
        class="accordion-content"
        data-tab-content
        role="tabpanel"
        aria-hidden="true"
      >
        <p>Bitte hier Ihren Text einfügen.</p>
      </div>
    </li>
  <% end %>
</ul>
