<li class="column small-12 medium-4" style="margin-bottom: 10px;list-style: none;">
  <div style="display:flex;flex-direction:column;max-width:320px;border-radius:12px;background:#fff;overflow:hidden;color:#000;font-size:14px;border:1px solid #ccc;">
    <div style="height:45px;padding:0 25px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:var(--brand-color);display:flex;align-items:center;justify-content:space-between;color:#fff;font-size:15px;margin-bottom:0;padding-right:10px;">
                Projektstatus
    </div>

    <div style="height:180px;width:100%;margin-bottom:10px;display:flex;justify-content:center;position:relative;overflow:hidden;">
      <a href="#" style="width:100%;height:100%;color:#000;text-decoration:none;transition:color 100ms ease;">
        <div style="width:100%;height:100%;">
          <img
          src="https://placehold.co/600x400"
              alt="Platzhalterbild"
                    style="width:100%;height:auto;display:block;"
                          />
          <img
          src="https://placehold.co/600x400"
              alt="Platzhalterbild Blur"
                    style="width:100%;height:auto;display:block;"
                          />
        </div>
      </a>
    </div>

    <div>
      <div>
        <div>
          <div style="padding:0 25px 15px;display:flex;flex-direction:column;min-height:201px;">
            <a href="#" style="display:block;font-size:20px;margin-bottom:10px;width:200px;line-height:1.2;margin-top:-2px;text-decoration:none;color:inherit;margin-top:12px;">
                    Überschrift
            </a>
            <div style="font-size:15px;margin-bottom:0;line-height:1.3;overflow:hidden;text-overflow:ellipsis;">
              <%= text %>
            </div>
          </div>
        </div>

        <div style="display:flex;flex-direction:column;flex-grow:1;">
          <div style="align-items:center;display:flex;justify-content:center;position:relative;text-align:center;border-top:1px solid #ccc;min-height:60px;padding:10px 25px;flex-direction:column;">
            <a href="#" style="display:flex;align-items:center;justify-content:center;color:#000;text-decoration:none;transition:color 100ms ease;margin-top:0;margin-bottom:0;padding-top:7px;padding-bottom:7px;" class="button -grey">
              Zum Projekt
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</li>
