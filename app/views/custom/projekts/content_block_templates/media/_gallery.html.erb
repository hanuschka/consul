<ul class="image-gallery-with-ligthbox" style="list-style: none;display:grid;grid-template-columns: repeat(2, 1fr);gap:5px">
  <% 2.times do |i| %>
    <li>
      <%= link_to("https://placehold.co/1200x700", class: "glightbox", target: "_blank") do %>
        <%= image_tag("https://placehold.co/426x212", referrerpolicy: "no-referer", style: "aspect-ratio: 1 / 0.5") %>
      <% end %>
    </li>
  <% end %>
</ul>
