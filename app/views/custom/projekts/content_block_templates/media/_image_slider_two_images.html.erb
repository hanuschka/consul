<div class="orbit" role="region" aria-label="Bilderslider" data-orbit>
  <ul class="orbit-container" style="height: 530px">
    <button class="orbit-previous">
      <span class="show-for-sr">Vorheriges Bild</span>&#9664;
    </button>
    <button class="orbit-next">
      <span class="show-for-sr">Nächstes Bild</span>&#9654;
    </button>

    <% 2.times do %>
      <li class="is-active orbit-slide">
        <figure class="orbit-figure">
          <img
              class="orbit-image"
              src="https://placehold.co/893x600"
              alt="Platzhalterbild 1"
              />
          <figcaption class="orbit-caption">
            Um ein Bild auszutauschen, setzen Sie den Slider genau an die
            Stelle des gewünschten Bildes. Wenn Sie mehrere Bilder ändern
            möchten, öffnen und speichern Sie den Editor bitte jeweils einzeln
            für jedes Bild.
          </figcaption>
        </figure>
      </li>
    <% end %>
  </ul>

  <nav class="orbit-bullets">
    <button class="is-active" data-slide="0">
      <span class="show-for-sr">Bild 1</span>
    </button>
    <button data-slide="1"><span class="show-for-sr">Bild 2</span></button>
  </nav>
</div>
