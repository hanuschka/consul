
<!-- Callout Warning - Variante 3 (groß, sehr großes Icon + größerer Text) -->
<div
  class="callout warning"
  style="border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem"
>
  <h4
    style="
      margin-top: 0;
      font-size: 1.4rem;
      font-weight: bold;
      display: flex;
      align-items: center;
    "
  >
    <i
      class="fa fa-exclamation-circle"
      style="font-size: 2rem; margin-right: 10px"
      >&#8203;</i
    >
     Wichtiger Hinweis
  </h4>
  <p style="margin: 0; font-size: 1.1rem; line-height: 1.5">
    Hier bitte den Text einfügen. Dieser Hinweis ist besonders prominent und für
    sehr wichtige Informationen gedacht.
  </p>
</div>
