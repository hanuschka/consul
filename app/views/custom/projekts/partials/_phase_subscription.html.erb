<% subscribed = phase.subscribed?(current_user) %>
<% label = subscribed ? t("custom.accessibility.phase_subscription.unsubscribe") : t("custom.accessibility.phase_subscription.subscribe") %>
<div id="<%= dom_id(phase, :subscription) %>" class="subscription">
  <%= link_to toggle_subscription_projekt_phase_path(phase),
      remote: true,
      method: :post,
      title: label,
      aria: { label: label } do %>
    <% if subscribed %>
      <i class="fas fa-bell" aria-hidden="true"></i>
    <% else %>
      <i class="far fa-bell-slash" aria-hidden="true"></i>
    <% end %>
    <span class="show-for-sr"><%= label %></span>
  <% end %>
</div>
