<% if Setting.new_design_enabled? %>
  <%= render Proposals::NewVotesComponent.new(proposal, vote_url: local_assigns[:vote_url], show_share_popup: local_assigns.fetch(:show_share_popup, false)) %>
<% else %>
  <%= render Proposals::VotesComponent.new(proposal, vote_url: local_assigns[:vote_url]) %>
<% end %>
