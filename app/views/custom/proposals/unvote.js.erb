<% if Setting.new_design_enabled? %>
  $("#<%= dom_id(@proposal) %>_votes").html(
    '<%= j render Proposals::NewVotesComponent.new(@proposal, voted: @voted, show_share_popup: @show_share_popup, proposal_ids: @proposal_ids) %>'
  );
<% else %>
  $("#<%= dom_id(@proposal) %>_votes").html(
    '<%= j render("proposals/votes", proposal: @proposal) %>'
  );
App.Followable.update("<%= dom_id(@follow.followable) %>",
                      "<%= j render("follows/follow_button", follow: @follow) %>",
                      "<%= j render("layouts/flash") %>")
<% end %>

$("#<%= dom_id(@proposal) %>_votes .js-copy-data-url").on("click", function(event) {
  event.preventDefault();
  navigator.clipboard.writeText($(this).data("url"));
});

$("div[data-voted-badge=<%= @proposal.id %>]").addClass('hide');

<%= render "custom/proposals/refresh_votes" %>
