<div class="evaluation-public">
  <h1><%= @projekt.name %></h1>
  <p class="text-muted">
    <%= t("public.evaluations.generated_at", time: l(@evaluation.generated_at, format: :long)) %>
  </p>

  <%= render "adm/projekts/projekts/evaluation/report",
    evaluation: @evaluation,
    projekt: @projekt %>
</div>
