<%if @categories.any? && extended_feature?("modulewide.enable_categories") %>
  <div class="sidebar-divider"></div>
  <h2 class="sidebar-title projekt-tag-chip-category projekt-tag-chip-icon"><%= t("shared.tags_cloud.categories") %></h2>

  <ul
    id="categories"
    class="no-bullet categories js-tag-filter"
    data-tag-filter-base-path="<%= taggables_filter_base_path(taggable) %>"
    data-selected-tags="<%= params[:tags] %>"
  >
    <% selected_categories = params[:tags] ? params[:tags].split(',') : []%>

    <% @categories.each do |category| %>
      <li class="inline-block">
        <% category_selected = selected_categories.include?(category.name) %>
        <%= tag.button(
          type: "button",
          class: class_names("js-tag-filter-toggle", selected: category_selected),
          data: { tag_name: category.name },
          aria: { pressed: category_selected }
        ) do %>
          <span class="tag"><%= category.name %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<%end%>
