<ul class="nav-flyout-block <%= 'nested-dropdown' if depth > 1 %>">
  <% children.each do |child| %>
    <% has_children = depth < 3 && child.children.any? %>
    <li class="nav-element flyout-item"
        <%= "aria-haspopup=true aria-expanded=false" if has_children %>>
      <a href="<%= navbar_item_url(child) %>"<%= navbar_item_link_attrs(child).html_safe %>><%= child.title %></a>
      <% if has_children %>
        <button aria-expanded="false"
                aria-label="<%= t('shared.toggle_submenu', title: child.title) %>"
                class="nav-toggle-arrow"
                data-navbar-toggle>&#9654;</button>
        <%= render partial: "shared/navbar_item_children", locals: { children: child.children.order(:position), depth: depth + 1 } %>
      <% end %>
    </li>
  <% end %>
</ul>
