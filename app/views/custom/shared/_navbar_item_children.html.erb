<% submenu_id = local_assigns.fetch(:submenu_id, nil) %>
<ul<%= " id=\"#{submenu_id}\"".html_safe if submenu_id.present? %> class="nav-flyout-block <%= 'nested-dropdown' if depth > 1 %>">
  <% children.each do |child| %>
    <% visible_grand_children = child.children.order(:position).reject(&:resource_missing?) %>
    <% has_children = depth < 3 && visible_grand_children.any? %>
    <% child_submenu_id = "navbar-submenu-#{child.id}" if has_children %>
    <li class="nav-element flyout-item"<%= ' aria-expanded="false"'.html_safe if has_children %>>
      <a href="<%= navbar_item_url(child) %>"<%= navbar_item_link_attrs(child).html_safe %>><%= child.title %></a>
      <% if has_children %>
        <button type="button"
                class="nav-toggle-arrow"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="<%= child_submenu_id %>"
                aria-label="<%= t('shared.toggle_submenu', title: child.title) %>"
                data-navbar-toggle><span aria-hidden="true">&#9654;</span></button>
        <%= render partial: "shared/navbar_item_children", locals: { children: visible_grand_children, depth: depth + 1, submenu_id: child_submenu_id } %>
      <% end %>
    </li>
  <% end %>
</ul>
