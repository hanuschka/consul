<% description = local_assigns.fetch(:description, "") %>
<% description = truncate(ActionView::Base.full_sanitizer.sanitize(description), length: 140) %>
<% mobile = local_assigns[:mobile] %>
<% mobile_url = mobile.present? ? "#{mobile.gsub(/\s+/, "%20")}%20" : "" %>

<% if local_assigns[:share_title].present? %>
  <div id="social-share" class="sidebar-divider"></div>
  <p class="sidebar-title"><%= share_title %></p>
<% end %>

<% share_title_text = "#{title} #{setting["twitter_hashtag"]} #{setting["twitter_handle"]}" %>
<% twitter_title = local_assigns[:mobile].presence || share_title_text %>
<% telegram_title = local_assigns[:mobile].presence || share_title_text %>

<div class="social-share-full">
  <div class='social-share-button'
    data-title="<%= share_title_text %>"
    data-url="<%= local_assigns[:url] %>"
    data-desc="<%= description %>"
  >
    <%= link_to "whatsapp://send?text=#{ title } #{ url }",
      class: 'ssb-icon ssb-whatsapp_app',
      data: { site: "whatsapp" },
      role: "button",
      title: t('custom.accessibility.share-links.whatsapp'),
      aria: { label: t('custom.accessibility.share-links.whatsapp') } do %>
      <span class="show-for-sr"><%= t('custom.accessibility.share-links.whatsapp') %></span>
    <% end %>

    <%= link_to "#",
      class: 'ssb-icon ssb-facebook',
      data: { site: "facebook" },
      onclick: "return SocialShareButton.share(this);",
      role: "button",
      title: t('custom.accessibility.share-links.facebook'),
      aria: { label: t('custom.accessibility.share-links.facebook') } do %>
      <span class="show-for-sr"><%= t('custom.accessibility.share-links.facebook') %></span>
    <% end %>

    <%= link_to "#",
      class: 'ssb-icon ssb-twitter',
      data: { site: "twitter", "twitter-title": twitter_title },
      onclick: "return SocialShareButton.share(this);",
      role: "button",
      title: t('custom.accessibility.share-links.twitter'),
      aria: { label: t('custom.accessibility.share-links.twitter') } do %>
      <span class="show-for-sr"><%= t('custom.accessibility.share-links.twitter') %></span>
    <% end %>

    <%= link_to "#",
      class: 'ssb-icon ssb-telegram',
      data: { site: "telegram", "telegram-title": telegram_title },
      onclick: "return SocialShareButton.share(this);",
      role: "button",
      title: t('custom.accessibility.share-links.telegram'),
      aria: { label: t('custom.accessibility.share-links.telegram') } do %>
      <span class="show-for-sr"><%= t('custom.accessibility.share-links.telegram') %></span>
    <% end %>

    <%= link_to "#",
      class: 'ssb-icon ssb-linkedin',
      data: { site: "linkedin" },
      onclick: "return SocialShareButton.share(this);",
      role: "button",
      title: t('custom.accessibility.share-links.linkedin'),
      aria: { label: t('custom.accessibility.share-links.linkedin') } do %>
      <span class="show-for-sr"><%= t('custom.accessibility.share-links.linkedin') %></span>
    <% end %>

    <%= link_to "#",
      class: 'ssb-icon ssb-email',
      data: { site: "email" },
      onclick: "return SocialShareButton.share(this);",
      role: "button",
      title: t('custom.accessibility.share-links.email'),
      aria: { label: t('custom.accessibility.share-links.email') } do %>
      <span class="show-for-sr"><%= t('custom.accessibility.share-links.email') %></span>
    <% end %>

    <%= link_to "#",
      class: 'ssb-icon ssb-copy-link js-copy-data-url',
      data: { url: local_assigns[:url], site: "kopieren" },
      role: "button",
      title: t('custom.accessibility.share-links.copy-link'),
      aria: { label: t('custom.accessibility.share-links.copy-link') } do %>
      <span class="show-for-sr"><%= t('custom.accessibility.share-links.copy-link') %></span>
    <% end %>
  </div>
</div>
