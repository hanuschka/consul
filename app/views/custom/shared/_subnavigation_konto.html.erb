<li class="nav-element top-level-item js-access-top-level-menu js-prevent-key-scroll"
    aria-expanded="false"
  >

  <%= link_to account_path, class: 'account-items-icon', aria: { label: t("custom.layouts.header.account_link") } do %>
    <span class="icon-account" aria-hidden="true"
          title="<%= t("custom.layouts.header.account_link") %>"
          aria-label="<%= t("custom.layouts.header.account_link") %>">
    </span>
  <% end %>

  <% if placement == 'mobile' %>
    <%= link_to account_path, class: 'account-items-link' do %>
      <%= t('custom.menu.account') %>
    <% end %>

    <button class='nav-toggle-arrow js-toggle-mobile-flyout-item'
         aria-label='<%= t('custom.links.menu.mobile.arrow_account') %>'
         aria-expanded="false"
    >
    </button>
  <% end %>

  <ul class="nav-flyout-block">
    <%= render "devise/menu/login_items" %>
  </ul>
</li>
