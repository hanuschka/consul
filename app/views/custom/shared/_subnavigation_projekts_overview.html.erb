<%
  use_landing_projekts_for_overview_link =
    (@custom_page.present? && @custom_page.landing?) ||
    @ui_landing_page.present?
%>
<%
  has_submenu = !use_landing_projekts_for_overview_link && @projekts_for_overview_page_navigation&.any?
%>
<%
  projekt_link_path =
    if use_landing_projekts_for_overview_link
      landing_page_projekts_path(@ui_landing_page&.slug || @custom_page&.slug)
    else
      projekts_path
    end
%>

<li class="nav-element top-level-item js-access-top-level-menu js-prevent-key-scroll"
  <%= 'aria-haspopup="true" aria-expanded="false"' if has_submenu %>
>
  <div class="flyout-item-name projekt-name">
    <%= link_to t('custom.links.menu.projekts_overview'), projekt_link_path, data: { turbolinks: false } %>
  </div>

  <% if has_submenu %>
    <% if placement == 'mobile' %>
      <button class='nav-toggle-arrow js-toggle-mobile-flyout-item'
        aria-label='<%= t('custom.links.menu.mobile.arrow_projekts') %>'
        aria-expanded="false"
        >
      </button>
    <% end %>
    <%= render partial: 'shared/subnavigation_flyout_projekts',
      locals: { projekts: @projekts_for_overview_page_navigation, placement: placement, skip_subprojekts: true, called_from: "subnavigation_projekts_overview" } %>
  <% end %>
</li>
