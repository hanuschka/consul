<div id="idea_category_selector" class="">
  <h2 class="rich-form-label">
    <i class="fas fa-heart"></i>
    <%= t("ideas.form.category_label") %>
    <span class="small" style="margin-left:0.25rem;margin-right:0.25rem">|</span>
    <span class="small"><%= t("ideas.form.category_hint") %></span>
  </h2>

  <%= f.select :idea_category_id,
    Idea::Category.all.map { |category|
      [
        category.name, category.id,
        {
          "data-feature-color": category.color,
          "data-feature-icon-name": category.icon,
          "data-feature-icon-unicode": AwesomeIcon.find_by(name: category.icon)&.unicode
        }
      ]
    },
    { include_blank: true, label: false },
    class: "select js-map-change-feature-style-on-select" %>
</div>
