<% has_projekt_labels_error = model.errors.where(:projekt_labels).any? %>
<% single_select_labels = projekt_phase.use_masterportal_collections_as_labels? %>
<% selectable_labels = (projekt_phase.active_projekt_labels.includes(:masterportal_collection).to_a | model.projekt_labels.includes(:masterportal_collection).to_a) %>
<div
  id="projekt_labels_selector"
  class="projekt-labels"
  role="group"
  aria-labelledby="projekt_labels_heading"
  <%= "aria-describedby=\"projekt_labels_error\" aria-invalid=\"true\"".html_safe if has_projekt_labels_error %>
>
  <h2 class="rich-form-label" id="projekt_labels_heading">
    <i class="fas fa-tag"></i>
    <%= projekt_phase.labels_name.presence || t("custom.shared.form.projekt_labels_label") %>
    <span class="small" style="margin-left:0.25rem;margin-right:0.25rem">|</span>
    <span class="small"><%= t("custom.shared.form.projekt_labels_hint") %></span>
  </h2>

  <div class="projekt-labels-selector--checkboxes">
    <%= f.collection_check_boxes :projekt_label_ids, selectable_labels, :id, :name do |cb| %>
      <% label_icon_url = cb.object.image_icon_url %>
      <%= cb.check_box %>
      <%= cb.label(id: dom_id(cb.object),
                   class: "projekt-label js-projekt-label js-map-change-feature-style #{'marked' if model.projekt_label_ids.include?(cb.object.id)}",
                   data: {
                     "label-id" => cb.object.id,
                     "feature-icon-name" => cb.object.icon,
                     "feature-icon-unicode" => AwesomeIcon.find_by(name: cb.object.icon)&.unicode,
                     "feature-icon-url" => label_icon_url,
                     "feature-multiple-allowed" => !single_select_labels
                   }) do
            icon =
              if label_icon_url.present?
                image_tag(label_icon_url, class: "projekt-label--image-icon", alt: "", referrerpolicy: "no-referrer")
              else
                content_tag(:i, nil, class: "fas fa-#{cb.object.icon}")
              end

            icon + cb.text
          end %>
    <% end %>
  </div>
</div>

<% if has_projekt_labels_error %>
  <small id="projekt_labels_error" class="form-error is-visible" role="alert">
    <%= model.errors.where(:projekt_labels).map(&:message).join(", ") %>
  </small>
<% end %>
