<div id="projekt_labels_selector" class="projekt-labels">
  <p class="small" style="margin-bottom:0.25rem;"><%= t("custom.shared.form.projekt_labels_hint") %></p>
  <div class="projekt-labels-selector--checkboxes">
    <%= f.collection_check_boxes :projekt_label_ids, projekt_phase.projekt_labels, :id, :name do |cb| %>
      <%= cb.check_box %>
      <% iconn = content_tag(:i, nil, class: "fas fa-#{cb.object.icon}") %>
      <%= cb.label(id: dom_id(cb.object),
                   class: "projekt-label js-projekt-label js-map-change-feature-style #{'marked' if model.projekt_label_ids.include?(cb.object.id)}",
                   data: {
                     "label-id" => cb.object.id,
                     "feature-icon-name" => cb.object.icon,
                     "feature-icon-unicode" => AwesomeIcon.find_by(name: cb.object.icon)&.unicode,
                     "feature-multiple-allowed" => true
                   }) { iconn + cb.text } %>
    <% end %>
  </div>
</div>

<% model.errors.where(:projekt_labels).each do |error| %>
  <small class='form-error is-visible'>
    <%= error.message %>
  </small>
<% end %>
