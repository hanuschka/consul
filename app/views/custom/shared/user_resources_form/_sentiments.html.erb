<div id="sentiment_selector" class="sentiments">
  <p class="small" style="margin-bottom:0.25rem;"><%= t("custom.shared.form.sentiment_hint") %></p>

  <div class="projekt-sentiments-selector--checkboxes">
    <%= f.collection_radio_buttons :sentiment_id, projekt_phase.sentiments, :id, :name, { include_hidden: false } do |rb| %>
      <%= rb.radio_button %>
      <% button_styles = "border-color:#{rb.object.color};background-color:#{rb.object.color};color:#{pick_text_color(rb.object.color)}" %>
      <%= rb.label(id: dom_id(rb.object),
                   class: "sentiment js-projekt-phase-sentiment js-map-change-feature-style #{'marked' if rb.object.id == model.sentiment_id}",
                   data: {
                     "sentiment-id" => rb.object.id, "sentiment-color" =>  rb.object.color,
                     "feature-color" => rb.object.color
                   }, style: button_styles) { rb.text } %>
    <% end %>
  </div>
</div>

<% model.errors.where(:sentiment_id).each do |error| %>
  <small class='form-error is-visible'>
    <%= error.message %>
  </small>
<% end %>
