<% provide :title do %><%= t("devise_views.users.registrations.new.title") %><% end %>

<% form_html = capture do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "shared/errors", resource: resource %>

    <% if Setting.old_design_enabled? %>
      <p>
      <%= sanitize(t("devise_views.users.registrations.new.organization_signup",
                     signup_link: link_to(t("devise_views.users.registrations.new.organization_signup_link"), new_organization_registration_path))) %>
      </p>
      <% username_hint = t("devise_views.users.registrations.new.username_note") %>
    <% end %>

    <% if SiteCustomization::ContentBlock.custom_block_for("registration_form_hint")&.body&.present? %>
      <%= render_custom_block "registration_form_hint" %>
      <div class="auth-page-template--divider"></div>
    <% end %>

    <div class="row">
      <div class="small-12">

        <%= f.hidden_field :use_redeemable_code %>
        <%= f.hidden_field :locale, value: I18n.locale %>
        <% if params[:invitation_token].present? %>
          <%= hidden_field_tag :invitation_token, params[:invitation_token] %>
        <% end %>

        <% invitation_pending = PendingRoleAssignment.find_by_invitation_token(params[:invitation_token]) if params[:invitation_token].present? %>

        <%= f.text_field :username,  autofocus: true, maxlength: User.username_max_length,
                                     autocomplete: "username",
                                     label: t("devise_views.users.registrations.new.username_label"),
                                     label_options: { class: "auth-page-template--field-label" },
                                     hint: username_hint %>
        <%= f.email_field :email,
                          autocomplete: "email",
                          label: t("devise_views.users.registrations.new.email_label"),
                          label_options: { class: "auth-page-template--field-label" },
                          value: invitation_pending&.email || resource.email,
                          readonly: invitation_pending&.email.present? %>

        <%= f.invisible_captcha :address %>

        <% if resource.extended_registration? %>
          <%= f.select :gender, options_for_gender_select,
            { prompt: t("custom.helpers.select.gender_prompt"),
              label_options: { class: "auth-page-template--field-label" } },
            { class: "show-arrow" } %>
          <%= f.text_field :first_name, autocomplete: "given-name",
                           label: t("custom.devise_views.users.registrations.new.first_name_label"),
                           label_options: { class: "auth-page-template--field-label" } %>
          <%= f.text_field :last_name, autocomplete: "family-name",
                           label: t("custom.devise_views.users.registrations.new.last_name_label"),
                           label_options: { class: "auth-page-template--field-label" } %>

          <%= render Users::RegisteredAddressFieldsComponent.new(
            resource: resource,
            selected_city_id: params[:form_registered_address_city_id].presence,
            selected_street_id: params[:form_registered_address_street_id].presence,
            selected_address_id: params[:form_registered_address_id].presence
          ) %>
          <%= render Users::RegularAddressFieldsComponent.new(f: f, user: resource) %>

          <fieldset class="user-date-of-birth sign-up">
            <legend><%= User.human_attribute_name(:date_of_birth) %></legend>
            <%= f.date_select :date_of_birth,
              { label: false,
                prompt: { year: t("custom.helpers.select.birth_year"), month: t("custom.helpers.select.birth_month"), day: t("custom.helpers.select.birth_day") },
                start_year: 1900, end_year: minimum_required_age.years.ago.year },
              { autocomplete: "bday" } %>
          </fieldset>
        <% end %>

        <% if resource.document_required? %>
          <%= f.select :document_type, user_document_types,
            prompt: t("custom.helpers.select.document_prompt"),
            label_options: { class: "auth-page-template--field-label" } %>
          <%= f.text_field :document_last_digits,
                           label: t("custom.devise_views.users.registrations.new.document_last_digits_label"),
                           label_options: { class: "auth-page-template--field-label" } %>

          <div>
            <label><%= t('custom.users.document_help') %></label>

            <div class='row margin-bottom'>
              <div class='column small-12 medium-6'>
                <label><%= t('custom.users.card_label') %></label>
                <p><%= t('custom.users.card_help') %></p>
                <%= image_tag 'card.jpg' %>
              </div>

              <div class='column small-12 medium-6'>
                <label><%= t('custom.users.pass_label') %></label>
                <p><%= t('custom.users.pass_help') %></p>
                <%= image_tag 'pass_new.png' %>
              </div>
            </div>
          </div>
        <% end %>

        <% if IndividualGroup.soft.visible.any? %>
          <% IndividualGroup.soft.visible.each do |individual_group| %>
            <div class="options-group">
              <label><%= individual_group.name %></label>
              <%= f.collection_check_boxes :individual_group_value_ids, individual_group.individual_group_values, :id, :name do |b| %>
                <div>
                  <%= b.label(class: "checkbox-label checkbox-label--inline") { b.check_box + b.text } %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>

        <div class="sign-up--password-field">
          <%= f.password_field :password, autocomplete: "new-password",
                               hint: t("devise_views.users.registrations.new.password_hint"),
                               label: t("devise_views.users.registrations.new.password_label"),
                               label_options: { class: "auth-page-template--field-label" } %>
        </div>

        <%= f.password_field :password_confirmation, autocomplete: "new-password",
                             label: t("devise_views.users.registrations.new.password_confirmation_label"),
                             label_options: { class: "auth-page-template--field-label" } %>

        <div class="newsletter-choice margin-top">
          <label class="checkbox-label checkbox-label--aligned" for="user_newsletter_true">
            <%= radio_button_tag "user[newsletter]", "1", params.dig(:user, :newsletter) == "1", id: "user_newsletter_true", style: "height: auto !important;" %>
            <span class="checkbox"><%= t("custom.devise_views.users.registrations.new.newsletter_yes") %></span>
          </label>

          <label class="checkbox-label checkbox-label--aligned" for="user_newsletter_false">
            <%= radio_button_tag "user[newsletter]", "0", params.dig(:user, :newsletter) == "0", id: "user_newsletter_false", style: "height: auto !important;" %>
            <span class="checkbox"><%= t("custom.devise_views.users.registrations.new.newsletter_no") %></span>
          </label>

          <% if resource.errors[:newsletter_chosen].any? %>
            <small class="form-error is-visible"><%= resource.errors[:newsletter_chosen].first %></small>
          <% end %>
        </div>

        <% if resource.use_redeemable_code %>
          <%= f.text_field :redeemable_code,
                           label: t("devise_views.users.registrations.new.redeemable_code"),
                           label_options: { class: "auth-page-template--field-label" } %>
        <% end %>

        <%= f.check_box :terms_data_storage,
          label: false,
          checked: true, style: "display: none;", onclick: "event.preventDefault();",
          class: "checkbox-label--aligned" %>

        <%= f.check_box :terms_data_protection,
          label: false,
          checked: true, style: "display: none;", onclick: "event.preventDefault();",
          class: "checkbox-label--aligned" %>

        <%= f.check_box :terms_general,
          label: false,
          checked: true, style: "display: none;", onclick: "event.preventDefault();",
          class: "checkbox-label--aligned" %>


        <%#= f.check_box :terms_data_storage,
          title: t("custom.terms.data_storage.title"),
          label: t("custom.terms.data_storage.label"),
          class: "checkbox-label--aligned" %>

        <%#= f.check_box :terms_data_protection,
          title: t("custom.terms.data_protection.title"),
          label: t("custom.terms.data_protection.label",
                   privacy_link: link_to(t("custom.terms.privacy_link.text"), "/privacy",
                                         title: t("shared.target_blank"), target: "_blank")),
          checked: true, style: "visibility: hidden;", onclick: "event.preventDefault();",
          class: "checkbox-label--aligned" %>

        <%#= f.check_box :terms_general,
          title: t("custom.terms.general.title"),
          label: t("custom.terms.general.label",
                   terms_link: link_to(t("custom.terms.terms_link.text"), "/conditions",
                                       title: t("shared.target_blank"), target: "_blank")),
          checked: true, style: "visibility: hidden;", onclick: "event.preventDefault();",
          class: "checkbox-label--aligned" %>

        <% if Setting.old_design_enabled? %>
          <p><%= t("custom.terms.revoke_consent.text") %></p>
        <% end %>

        <div class="small-12 small-centered margin-top">
          <%= f.submit t("custom.devise_views.users.registrations.new.submit"), class: "button expanded -green" %>
        </div>

        <p class="terms-notice" style="text-align: left; font-size: 0.85rem; color: #666;">
          Mit der Registrierung akzeptieren Sie die <a href="/conditions">Allgemeinen Nutzungsbedingungen</a>. Informationen zur Verarbeitung Ihrer Daten finden Sie in den <a href="/privacy">Datenschutzhinweisen</a>.
        </p>
      </div>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>

  <div class="auth-page-template--oauth">
    <%= render "devise/omniauth_form", action: "sign_up" %>
  </div>
<% end %>

<% if Setting.new_design_enabled? %>
  <%= render Auth::AuthPageTemplateComponent.new do |c| %>
    <% c.with_form do %>
      <h2><%= t("devise_views.users.registrations.new.title") %></h2>
      <p>
        <%= t("custom.devise_views.users.registrations.new.message") %>
      </p>
      <%= form_html %>
    <% end %>
  <% end %>
<% else %>
  <h2><%= t("devise_views.users.registrations.new.title") %></h2>

  <%= form_html %>
<% end %>
