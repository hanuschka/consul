<% header_image_attachment = local_assigns[:header_image_attachment] %>
<% mobile_header_image_attachment = local_assigns[:mobile_header_image_attachment] %>
<% header_video_attachment = local_assigns[:header_video_attachment] %>
<% mobile_header_video_attachment = local_assigns[:mobile_header_video_attachment] %>

<% if header_image_attachment&.attached? %>
  <style>
      <% image_variant = header_image_attachment.variant(resize_to_limit: [1920, nil], saver: { quality: 85 }, strip: true, format: 'jpeg') %>

      .home-page .homepage-image-header {
        background-image: url("<%= polymorphic_path(image_variant) %>");
        background-size: cover;
        background-position: top;
      }

      .top-bar-wrapper {
        background: transparent;
      }
  </style>
<% end %>


<%
  mobile_header_attachment_to_use =
    if mobile_header_image_attachment&.attached?
      mobile_header_image_attachment
    elsif header_image_attachment&.attached?
      header_image_attachment
    end
%>

<% if mobile_header_attachment_to_use&.attached? %>
  <% mobile_image_variant = mobile_header_attachment_to_use.variant(resize_to_limit: [nil, 550], saver: { quality: 90 }, strip: true, format: 'jpeg') %>

  <style>
    @media(max-width: 750px) {
      .home-page .homepage-image-header{
        background-image: url("<%= polymorphic_path(mobile_image_variant) %>");
        background-size: cover;
        background-position: top;
      }
    }
  </style>
<% end %>

<% any_header_video = header_video_attachment&.attached? || mobile_header_video_attachment&.attached? %>
<div class="homepage-image-header not-print">
  <% if header_video_attachment&.attached? %>
    <video class="homepage-image-header--video homepage-image-header--video--desktop js-homepage-header-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="<%= polymorphic_path(header_video_attachment) %>" type="<%= header_video_attachment.content_type %>">
    </video>
  <% end %>

  <% if mobile_header_video_attachment&.attached? %>
    <video class="homepage-image-header--video homepage-image-header--video--mobile js-homepage-header-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="<%= polymorphic_path(mobile_header_video_attachment) %>" type="<%= mobile_header_video_attachment.content_type %>">
    </video>
  <% end %>

  <% if any_header_video %>
    <button type="button"
            id="js-homepage-header-video-toggle"
            class="homepage-image-header--video-toggle"
            data-pause-label="<%= t('custom.welcome.header.pause_video') %>"
            data-play-label="<%= t('custom.welcome.header.play_video') %>"
            aria-label="<%= t('custom.welcome.header.pause_video') %>"
            title="<%= t('custom.welcome.header.pause_video') %>">
      <i class="fas fa-pause" aria-hidden="true"></i>
    </button>

    <script>
      (function () {
        var btn = document.getElementById("js-homepage-header-video-toggle");
        if (!btn) return;
        var icon = btn.querySelector("i");
        var videos = document.querySelectorAll(".js-homepage-header-video");

        function setState(playing) {
          icon.classList.toggle("fa-pause", playing);
          icon.classList.toggle("fa-play", !playing);
          var label = playing ? btn.dataset.pauseLabel : btn.dataset.playLabel;
          btn.setAttribute("aria-label", label);
          btn.setAttribute("title", label);
        }

        btn.addEventListener("click", function () {
          var anyPaused = Array.prototype.some.call(videos, function (v) { return v.paused; });
          if (anyPaused) {
            Array.prototype.forEach.call(videos, function (v) {
              var p = v.play();
              if (p && typeof p.catch === "function") p.catch(function () {});
            });
            setState(true);
          } else {
            Array.prototype.forEach.call(videos, function (v) { v.pause(); });
            setState(false);
          }
        });

        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          Array.prototype.forEach.call(videos, function (v) { v.pause(); });
          setState(false);
        }
      })();
    </script>
  <% end %>
  <div class="homepage-image-header--title-wrapper">
    <% show_title_and_subtitle =
      if @custom_page&.landing?
        !@custom_page.landing_hide_title_and_subtitle
      else
        Setting["extended_option.general.title"].present?
      end
    %>

    <% if show_title_and_subtitle %>
      <h1 class="homepage-image-header--title">
          <% if @custom_page&.landing? %>
           <%= @custom_page.header_title %>
          <% else %>
            <%= setting_text("extended_option.general.title") %>
          <% end %>
          <br>
          <% if @custom_page&.landing? %>
           <b><%= @custom_page.subtitle %></b>
          <% else %>
            <b><%= setting_text("extended_option.general.subtitle") %></b>
          <% end %>
      </h1>
    <% end %>

    <% if Setting["welcomepage.projekt_search"].present? && !@custom_page&.landing? %>
      <div class="homepage-search-form">
        <%= render(
          Shared::TextSearchFormComponent.new(
            url: projekts_path,
            disable_reset_button_submit: true,
            i18n_namespace: "custom.projekts.homepage_search_form",
          )
        ) %>
      </div>
    <% end %>

    <% unless @custom_page&.landing? %>
      <%= header_button_html %>
      <%= homepage_deficiency_report_cta_html %>
    <% end %>
  </div>
</div>

<% if Setting["process.deficiency_reports"].present? && Setting["deficiency_reports.show_homepage_cta"].present? %>
  <%= render "deficiency_reports/create_cta_modal" %>
<% end %>
