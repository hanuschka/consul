<aside class="sidebar" aria-label="<%= t('custom.accessibility.complementary.homepage') %>">
  <div class="hide-on-small-tablet">
    <% if render_custom_content_block?('home_page_sidebar') %>
      <% rendered_home_page_sidebar_block = capture { render_custom_block "home_page_sidebar", empty_hint: false } %>
      <% home_page_sidebar_block_body = Nokogiri::HTML::DocumentFragment.parse(rendered_home_page_sidebar_block).at_css(".custom-content-block-body")&.inner_html %>
      <% admin_view = current_user&.administrator? %>
      <% initial_empty = admin_view && content_block_body_blank?(home_page_sidebar_block_body) %>
      <% sidebar_card_class = [] %>
      <% sidebar_card_class << "js-toggle-empty-hint-on-content" if admin_view %>
      <% sidebar_card_class << "is-content-empty" if initial_empty %>
      <% sidebar_card_class = sidebar_card_class.join(" ").presence %>
      <%= render Shared::SidebarCardComponent.new(title: t("custom.welcome.sidebar.information.title"), icon_name: "info-circle", class_name: sidebar_card_class) do |c| %>
        <% if admin_view %>
          <div class="sidebar-card--admin-empty-hint js-studio-hide-on-preview" role="note">
            <i class="fas fa-eye-slash sidebar-card--admin-empty-hint-icon" aria-hidden="true"></i>
            <span><%= t("custom.welcome.sidebar.information.admin_empty_hint") %></span>
          </div>
        <% end %>
        <%= rendered_home_page_sidebar_block %>
      <% end %>
    <% end %>
  </div>

  <% if setting["welcomepage.usage_stats"].present? %>
    <%= render Shared::SidebarCardComponent.new(title: t("custom.welcome.sidebar.users.title"), icon_name: "users") do |c| %>
      <div class="homepage-users-list">
        <%= render(Sidebar::UsersListComponent.new(users: User.actual)) %>

        <% if setting["extended_feature.general.users_overview_page"].present? %>
          <%= link_to users_path, class: "sidebar-users-list--count" do %>
            +<%= number_with_delimiter(User.actual.size, delimiter: ".") %>
          <% end %>
        <% end %>
      </div>
      <% if current_user.nil? %>
        <div class="margin-top-20">
          <%= link_to(t("custom.welcome.sidebar.users.sign_in"), new_user_session_path, class: "button sign-in-button flex-centered-content", data: { turbolinks: false }) %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if setting["welcomepage.platform_activity"].present? %>
    <%= render Shared::SidebarCardComponent.new(title: t("custom.welcome.sidebar.activity.title"), icon_name: "tachometer-alt") do |c| %>

      <% projekts_count = Projekt.regular.index_order_all.count %>
      <% if projekts_count > 0 %>
        <%= link_to projekts_path, class: "resources--info-count -no-default-style" do %>
          <span>
            <%= t("custom.general.resource_names.projekts") %>
          </span>
          <span>
            <%= projekts_count %>
          </span>
        <% end %>
      <% end %>

      <% proposals_count = Proposal.for_public_render.meets_minimum_supports.count %>
      <% if proposals_count > 0 %>
        <%= link_to proposals_path, class: "resources--info-count -no-default-style" do %>
          <span>
            <%= t("custom.general.resource_names.proposals") %>
          </span>
          <span>
            <%= proposals_count %>
          </span>
        <% end %>
      <% end %>

      <% debates_count = Debate.for_public_render.count %>
      <% if debates_count > 0 %>
        <%= link_to debates_path, class: "resources--info-count -no-default-style" do %>
          <span>
            <%= t("custom.general.resource_names.debates") %>
          </span>
          <span>
            <%= debates_count %>
          </span>
        <% end %>
      <% end %>

      <% scoped_projekt_ids = Projekt.visible_for(current_user).show_in_sidebar_filter.select(:id) %>
      <% polls_count = Poll.for_public_render.by_projekt_id(scoped_projekt_ids).count %>
      <% if polls_count > 0 %>
        <%= link_to polls_path, class: "resources--info-count -no-default-style" do %>
          <span>
            <%= t("custom.general.resource_names.polls") %>
          </span>
          <span>
            <%= polls_count %>
          </span>
        <% end %>
      <% end %>

      <% comments_count = Comment.count %>
      <% if comments_count > 0 %>
        <div class="resources--info-count">
          <span>
            <%= t("custom.general.resource_names.comments") %>
          </span>
          <span>
            <%= comments_count %>
          </span>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if setting["welcomepage.newsletter_subscription"].present? %>
    <%= render Shared::SidebarCardComponent.new(title: t("custom.welcome.sidebar.newsletter.title"), icon_name: "envelope") do |c| %>
      <% if user_signed_in? %>
        <div class="admin">
        <%= render Admin::LivesubmitCheckbox::Component.new(
          url: account_path,
          resource_name: "account",
          attribute_name: "newsletter",
          current_value: current_user.newsletter
        ) %>
        </div>
      <% else %>
        <%= render "custom/unregistered_newsletter_subscribers/form", unregistered_email_subscriber: UnregisteredNewsletterSubscriber.new %>
      <% end %>
    <% end %>
  <% end %>

  <% if setting["welcomepage.share_buttons"].present? %>
    <%= render Shared::SidebarCardComponent.new(title: t("custom.projekts.page.sidebar.share.title"), icon_name: "share-alt") do |c| %>
      <%= render "shared/social_share",
        title: Setting["meta_title"],
        url: root_url,
        description: Setting["meta_description"].to_s.truncate(200),
        mobile: Setting["meta_title"]
      %>
    <% end %>
  <% end %>
</aside>
