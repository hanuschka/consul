<% provide :title do %><%= "#{t('cli.general.seo_title_prefix')}" %><% end %>
<% content_for :body_class, "home-page" %>

<% if current_user&.administrator? %>
  <% content_for :admin_topbar_actions do %>
    <%= link_to adm_homepage_path,
          class: "button hollow projekt-page--admin-topbar-button",
          title: t("custom.projekts.page.topbar.edit_homepage"),
          target: "_blank" do %>
      <i class="fas fa-edit" aria-hidden="true"></i>
      <span><%= t("custom.projekts.page.topbar.edit_homepage") %></span>
    <% end %>
  <% end %>
<% end %>

<% content_for :canonical do %>
  <%= render "shared/canonical", href: root_url %>
<% end %>

<%= render Shared::BannerComponent.new("homepage") %>

<% provide :social_media_meta_tags do %>
  <%= render "shared/social_media_meta_tags",
              social_url: root_url %>
<% end %>

<main>
  <div class='hero-wrapper'>
    <%= video_tag 'munich.mp4',
      autoplay: true,
      loop: true,
      muted: true,
      controls: true,
      controlsList: "nodownload nofullscreen noremoteplayback",
      disablepictureinpicture: true  %>

    <div class='hero-content'>
      <div class='row'>
        <div class='column position-relative'>
          <div class='hero-text'>
            <span><%= t('cli.welcome.hero.url') %></span>
            <%= t('cli.welcome.hero.text') %>
          </div>
          <%= link_to t('cli.welcome.hero.cta'), "#welcome_block", class: "hero-cta", role: "button" %>
        </div>
      </div>
    </div>
  </div>

  <div class='row clear'>
    <div class='small-12 medium-9 column'>
      <%=render_custom_block 'home_page_welcome' %>
    </div>
  </div>

  <div class="row">
    <div class="column medium-9 small-centered">
      <%= render_custom_block 'home_page_1' %>
    </div>
  </div>

  <% if @cards.any? %>
    <div class="row">
      <div class="column medium-9 small-centered margin-bottom">
        <div class="row">
          <div class="small-12 column">
            <%= render partial: "cards", locals: { cards: @cards, section_title: t("welcome.cards.title") } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="column medium-9 small-centered">
      <%= render_custom_block 'home_page_2' %>
    </div>
  </div>

  <% if @active_projekts.any? %>
    <div class="row">
      <div class="column medium-9 small-centered margin-bottom">
        <%= render partial: "projekt_cards", locals: { projekts: @active_projekts, section_title: t("custom.welcome.active_projekt_cards.title")  } %>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="column medium-9 small-centered">
      <%= render_custom_block 'home_page_3' %>
    </div>
  </div>

  <% if @latest_polls.any? %>
    <div class="row">
      <div class="column medium-9 small-centered margin-bottom">
        <h2 class='title card-title'><%= t('custom.welcome.current_polls') %></h2>
        <%= render partial: "polls/poll_group", locals: { poll_group: @latest_polls } %>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="column medium-9 small-centered">
      <%=render_custom_block 'home_page_4' %>
    </div>
  </div>

  <% if @latest_items.any? %>
    <div class="row">
      <div class="column medium-9 small-centered margin-bottom">
        <h2 class='title card-title'><%= t('custom.welcome.user_entries') %></h2>
        <%= render "latest_items" %>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="column medium-9 small-centered">
      <%=render_custom_block 'home_page_5' %>
    </div>
  </div>

  <% if @expired_projekts.any? %>
    <div class="row">
      <div class="column medium-9 small-centered margin-bottom">
        <%= render partial: "projekt_cards", locals: { projekts: @expired_projekts, section_title: t("custom.welcome.expired_projekt_cards.title")  } %>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="column medium-9 small-centered">
      <%=render_custom_block 'home_page_6' %>
    </div>
  </div>
</main>
