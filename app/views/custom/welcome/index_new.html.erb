<% content_for :body_class, "home-page" %>

<% content_for :styles do %>
  <style>
    :root {
      --homepage-nav-link-color: <%= Setting["extended_option.general.homepage_navigation_link_color"].presence || "#000000" %>;
    }

    .custom-new-design.home-page .top-bar .main-menu a,
    .custom-new-design.home-page .top-bar .main-menu .projekt-name,
    .custom-new-design.home-page .top-bar .main-menu .translate-widget-toggler,
    .custom-new-design.home-page .top-bar .main-menu .translate-widget-toggler i {
      color: var(--homepage-nav-link-color) !important;
    }

    .custom-new-design.home-page .top-bar .header--mobile-hamburger-menu .menu-icon::after {
      background: var(--homepage-nav-link-color) !important;
      box-shadow: 0 7px 0 var(--homepage-nav-link-color),
        0 14px 0 var(--homepage-nav-link-color) !important;
    }

    .custom-new-design.home-page .sticky-header .header--mobile-hamburger-menu .menu-icon::after {
      background: black !important;
      box-shadow: 0 7px 0 black, 0 14px 0 black !important;
    }

    .custom-new-design.home-page .sticky-header .top-bar .translate-widget .translate-widget-toggler,
    .custom-new-design.home-page .sticky-header .top-bar .translate-widget .translate-widget-toggler i {
      color: unset !important;
    }
  </style>
<% end %>

<% if current_user&.administrator? %>
  <% content_for :admin_topbar_actions do %>
    <%= render "welcome/topbar/admin_topbar_navigation_link_color_picker" %>

    <%= link_to adm_homepage_path,
          class: "button hollow studio-admin-topbar-button",
          title: t("custom.projekts.page.topbar.edit_homepage"),
          target: "_blank",
          tabindex: "-1" do %>
      <i class="fas fa-edit" aria-hidden="true"></i>
      <span><%= t("custom.projekts.page.topbar.edit_homepage") %></span>
    <% end %>
  <% end %>
<% end %>

<% content_for :canonical do %>
  <%= render "shared/canonical", href: root_url %>
<% end %>

<%= render Shared::BannerComponent.new("homepage") %>

<% provide :social_media_meta_tags do %>
  <%= render "shared/social_media_meta_tags",
              social_url: root_url %>
<% end %>

<%= render "header",
  header_image_attachment: @header_image,
  mobile_header_image_attachment: @mobile_header_image,
  header_video_attachment: @header_video,
  mobile_header_video_attachment: @mobile_header_video
%>

<main class="welcome-page">
  <div class="d-flex flex-layout">
    <div class="main-column">

      <% if render_custom_content_block?('home_page_sidebar') %>
        <% rendered_home_page_sidebar_block_mobile = capture { render_custom_block 'home_page_sidebar', empty_hint: false } %>
        <% home_page_sidebar_block_body_mobile = Nokogiri::HTML::DocumentFragment.parse(rendered_home_page_sidebar_block_mobile).at_css(".custom-content-block-body")&.inner_html %>
        <% admin_view_mobile = current_user&.administrator? %>
        <% initial_empty_mobile = admin_view_mobile && content_block_body_blank?(home_page_sidebar_block_body_mobile) %>
        <% sidebar_card_class_mobile = [] %>
        <% sidebar_card_class_mobile << "js-toggle-empty-hint-on-content" if admin_view_mobile %>
        <% sidebar_card_class_mobile << "is-content-empty" if initial_empty_mobile %>
        <% sidebar_card_class_mobile = sidebar_card_class_mobile.join(" ").presence %>
        <aside
          class="show-on-small-tablet standalone-sidebar-section margin-bottom"
          aria-label="<%= t('custom.accessibility.complementary.homepage_mobile') %>"
        >
          <%= render Shared::SidebarCardComponent.new(title: t("custom.welcome.sidebar.information.title"), icon_name: "info-circle", class_name: sidebar_card_class_mobile) do |c| %>
            <% if admin_view_mobile %>
              <div class="sidebar-card--admin-empty-hint js-studio-hide-on-preview" role="note">
                <i class="fas fa-eye-slash sidebar-card--admin-empty-hint-icon" aria-hidden="true"></i>
                <span><%= t("custom.welcome.sidebar.information.admin_empty_hint") %></span>
              </div>
            <% end %>
            <%= rendered_home_page_sidebar_block_mobile %>
          <% end %>
        </aside>
      <% end %>

      <%= render_custom_block 'home_page_1' %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block 'home_page_1a' %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_2" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_4" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_5" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_6" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_7" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

    </div>

    <%= render "sidebar" %>

  </div>
</main>
