<% content_for :body_class, "home-page" %>

<% if current_user&.administrator? %>
  <% content_for :admin_topbar_actions do %>
    <%= link_to adm_homepage_path,
          class: "button hollow projekt-page--admin-topbar-button",
          title: t("custom.projekts.page.topbar.edit_homepage"),
          target: "_blank" do %>
      <i class="fas fa-edit" aria-hidden="true"></i>
      <span><%= t("custom.projekts.page.topbar.edit_homepage") %></span>
    <% end %>
  <% end %>
<% end %>

<% content_for :canonical do %>
  <%= render "shared/canonical", href: root_url %>
<% end %>

<%= render Shared::BannerComponent.new("homepage") %>

<% provide :social_media_meta_tags do %>
  <%= render "shared/social_media_meta_tags",
              social_url: root_url %>
<% end %>

<%= render "header",
  header_image_attachment: @header_image,
  mobile_header_image_attachment: @mobile_header_image,
  header_video_attachment: @header_video,
  mobile_header_video_attachment: @mobile_header_video
%>

<main class="welcome-page">
  <div class="d-flex flex-layout">
    <div class="main-column">

      <% if render_custom_content_block?('home_page_sidebar') %>
        <div class="show-on-small-tablet standalone-sidebar-section margin-bottom">
          <%= render Shared::SidebarCardComponent.new(title: 'Information', icon_name: "info-circle") do |c| %>
            <%= render_custom_block 'home_page_sidebar' %>
          <% end %>
        </div>
      <% end %>

      <%= render_custom_block 'home_page_1' %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block 'home_page_1a' %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_2" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_4" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_5" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_6" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

      <%= render_custom_block "home_page_7" %>

      <%= render Shared::ContentCardComponent.new(@content_cards.shift) %>

    </div>

    <%= render "sidebar" %>

  </div>
</main>
