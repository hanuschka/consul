<%#
  Generic admin-topbar navigation-link color picker.

  Locals (all optional — defaults preserve the original homepage behavior):
  - current_color:  current hex value (default: homepage Setting)
  - update_url:     PATCH endpoint (default: homepage route)
  - css_variable:   CSS custom property the live preview drives
                    (default: "--homepage-nav-link-color")
  - input_id:       id for the <input>/<label for> pair
                    (default: "admin-topbar-nav-link-color-picker")
  - fallback_color: hex used when the color is reset (default: "#000000")
%>
<%
  fallback_color ||= "#000000"
  current_color  = (defined?(current_color) && current_color) ||
                   Setting["extended_option.general.homepage_navigation_link_color"].to_s
  update_url     ||= update_navigation_link_color_adm_homepage_path
  css_variable   ||= "--homepage-nav-link-color"
  input_id       ||= "admin-topbar-nav-link-color-picker"
  default_color  = current_color.presence || fallback_color
%>
<div
  class="studio-admin-topbar-color-picker js-admin-topbar-color-picker"
  data-css-variable="<%= css_variable %>"
  data-style-element-id=""
  data-url="<%= update_url %>"
  data-current-color="<%= current_color %>"
  data-fallback-color="<%= fallback_color %>"
  data-i18n-saving="<%= t('custom.welcome.topbar.nav_link_color_picker.status.saving') %>"
  data-i18n-saved="<%= t('custom.welcome.topbar.nav_link_color_picker.status.saved') %>"
  data-i18n-error="<%= t('custom.welcome.topbar.nav_link_color_picker.status.error') %>"
>
  <rich-tooltip delay="500" trigger-only shadow="heavy">
    <label
      class="studio-admin-topbar-color-picker--label"
      for="<%= input_id %>"
    >
      <i class="fas fa-palette studio-admin-topbar-color-picker--label-icon" aria-hidden="true"></i>
      <span class="studio-admin-topbar-color-picker--label-text">
        <%= t('custom.welcome.topbar.nav_link_color_picker.label') %>
      </span>
    </label>
    <template><%= t('custom.welcome.topbar.nav_link_color_picker.tooltip') %></template>
  </rich-tooltip>

  <input
    type="color"
    id="<%= input_id %>"
    class="studio-admin-topbar-color-picker--input js-admin-topbar-color-picker-input"
    value="<%= default_color %>"
    tabindex="-1"
    aria-label="<%= t('custom.welcome.topbar.nav_link_color_picker.label') %>"
  >

  <button
    type="button"
    tabindex="-1"
    class="studio-admin-topbar-color-picker--reset js-admin-topbar-color-picker-reset"
    title="<%= t('custom.welcome.topbar.nav_link_color_picker.reset') %>"
    aria-label="<%= t('custom.welcome.topbar.nav_link_color_picker.reset') %>"
    data-tooltip
    data-hover-delay="500"
  >
    <i class="fas fa-undo" aria-hidden="true"></i>
  </button>

  <span
    class="studio-admin-topbar-color-picker--status js-admin-topbar-color-picker-status"
    aria-live="polite"
  ></span>
</div>
