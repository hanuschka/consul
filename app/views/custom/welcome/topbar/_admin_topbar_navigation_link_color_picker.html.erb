<%
  setting_key = "extended_option.general.homepage_navigation_link_color"
  current_color = Setting[setting_key].to_s
  fallback_color = "#000000"
  default_color = current_color.presence || fallback_color
%>
<div
  class="projekt-page--admin-topbar-color-picker js-admin-topbar-color-picker"
  data-css-variable="--homepage-nav-link-color"
  data-style-element-id=""
  data-url="<%= update_navigation_link_color_adm_homepage_path %>"
  data-current-color="<%= current_color %>"
  data-fallback-color="<%= fallback_color %>"
  data-i18n-saving="<%= t('custom.welcome.topbar.nav_link_color_picker.status.saving') %>"
  data-i18n-saved="<%= t('custom.welcome.topbar.nav_link_color_picker.status.saved') %>"
  data-i18n-error="<%= t('custom.welcome.topbar.nav_link_color_picker.status.error') %>"
>
  <label
    class="projekt-page--admin-topbar-color-picker--label"
    for="admin-topbar-nav-link-color-picker"
    title="<%= t('custom.welcome.topbar.nav_link_color_picker.tooltip') %>"
    data-tooltip
    data-hover-delay="500"
  >
    <i class="fas fa-palette projekt-page--admin-topbar-color-picker--label-icon" aria-hidden="true"></i>
    <span class="projekt-page--admin-topbar-color-picker--label-text">
      <%= t('custom.welcome.topbar.nav_link_color_picker.label') %>
    </span>
  </label>

  <input
    type="color"
    id="admin-topbar-nav-link-color-picker"
    class="projekt-page--admin-topbar-color-picker--input js-admin-topbar-color-picker-input"
    value="<%= default_color %>"
    aria-label="<%= t('custom.welcome.topbar.nav_link_color_picker.label') %>"
  >

  <button
    type="button"
    class="projekt-page--admin-topbar-color-picker--reset js-admin-topbar-color-picker-reset"
    title="<%= t('custom.welcome.topbar.nav_link_color_picker.reset') %>"
    aria-label="<%= t('custom.welcome.topbar.nav_link_color_picker.reset') %>"
    data-tooltip
    data-hover-delay="500"
  >
    <i class="fas fa-undo" aria-hidden="true"></i>
  </button>

  <span
    class="projekt-page--admin-topbar-color-picker--status js-admin-topbar-color-picker-status"
    aria-live="polite"
  ></span>
</div>
