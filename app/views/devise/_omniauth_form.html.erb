<div class="hr-with-text" style="padding-bottom: 22px;">
  <span><%= t("devise_views.omniauth.oder") %></div>
</div>

<% if oauth_logins.any? || feature?("bund_id_login") %>
  <div class="row">
    <div class="small-12 column">
      <div class="margin-bottom">
        <strong><%= t("omniauth.info.#{action}") %></strong>
      </div>
    </div>

    <% if feature?("bund_id_login") %>
      <div class="small-12 medium-4 large-4 columns">
        <%= link_to users_bund_id_send_request_path, class: "button-bund-id button expanded", title: "Login with BundId" do %>
          <%= image_tag "bund_id_logo.svg", alt: "BundId Logo", class: "bund-id-logo" %>
        <% end %>
      </div>
    <% end %>

    <% oauth_logins.each do |login| %>
      <div class="small-12 medium-6 large-4 column end">
        <% if login.in? %i[bayern_id m_login keycloak_google] %>
          <% link_text = "" %>
        <% else %>
          <% link_text = t("omniauth.#{login}.name") %>
        <% end %>
        <%= link_to link_text, send("user_#{login}_omniauth_authorize_path"),
                    title: t("omniauth.#{login}.#{action}"),
                    class: "button-#{login.to_s.delete_suffix("_oauth2")} button expanded",
                    role: 'button',
                    method: :post %>
      </div>
    <% end %>

    <div class="small-12 column">
      <% if params[:reason] == 'uh' %>
        <div class="callout alert" style="clear:both;">
          <%= t('cli.devise_views.users.registrations.errors.user_hidden')  %>
        </div>
      <% elsif params[:reason] == 'ee' %>
        <div class="callout alert" style="clear:both;">
          <%= t('cli.devise_views.users.registrations.errors.email_exists')  %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
