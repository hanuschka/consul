<% if oauth_logins.any? || feature?("bund_id_login") %>
  <div class="oauth-logins">
    <div class="hr-with-text oauth-logins--divider">
      <span><%= t("devise_views.omniauth.oder") %></span>
    </div>

    <strong class="oauth-logins--title"><%= t("omniauth.info.#{action}") %></strong>

    <div class="oauth-logins--grid">
      <% if feature?("bund_id_login") %>
        <%= link_to users_bund_id_send_request_path,
                    class: "button button-bund-id",
                    title: t("omniauth.bund_id.#{action}"),
                    data: { turbolinks: false } do %>
          <%= image_tag "bund_id_logo.svg", alt: t("omniauth.bund_id.name"), class: "bund-id-logo" %>
        <% end %>
      <% end %>

      <% oauth_logins.each do |login| %>
        <% if login == :kobil %>
          <%= link_to send("user_#{login}_omniauth_authorize_path"),
                      class: "button button-kobil",
                      title: t("omniauth.kobil.#{action}"),
                      method: :post do %>
            <%= image_tag "services/kobil_logo_white.svg", alt: t("omniauth.kobil.name"), class: "kobil-logo" %>
          <% end %>
        <% else %>
          <%= link_to t("omniauth.#{login}.name"),
                      send("user_#{login}_omniauth_authorize_path"),
                      class: "button button-#{login.to_s.delete_suffix("_oauth2")}",
                      title: t("omniauth.#{login}.#{action}"),
                      method: :post %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
