<div
  class="file-upload-manager-dialog--item"
  data-id="<%= image.id %>"
  data-content-type="<%= image.attachment_content_type %>"
  data-description=""
  data-url="<%= url_for(image.attachment.variant(resize_to_limit: [1500, 2000])) %>"
  data-custom-thumb-url="<%= url_for(image.attachment.variant(resize_to_limit: [925, 925])) %>"
>
  <div class="file-upload-manager-dialog--item-thumb">
    <img
      src="<%= url_for(image.attachment.variant(resize_to_limit: [600, 600])) %>"
      alt="<%= image.title.presence || image.attachment_file_name %>"
    >
    <% width = image.attachment.metadata[:width]; height = image.attachment.metadata[:height] %>
    <% if width.present? && height.present? %>
      <span class="file-upload-manager-dialog--item-badge -dimensions js-file-manager-badge-dimensions">
        <%= width %> × <%= height %>
      </span>
    <% end %>
    <span class="file-upload-manager-dialog--item-badge -size js-file-manager-badge-size">
      <%= number_to_human_size(image.attachment_file_size, precision: 1) %>
    </span>
  </div>
  <div class="file-upload-manager-dialog--item-meta">
    <p
      class="file-upload-manager-dialog--item-title"
      title="<%= image.title.presence || image.attachment_file_name %>"
    >
      <%= image.title.presence || image.attachment_file_name %>
    </p>
    <div class="file-upload-manager-dialog--item-alt"></div>
  </div>
</div>
