<div
  class="file-upload-manager-dialog--item"
  data-id="<%= image.id %>"
  data-content-type="<%= image.data_content_type %>"
  data-description="<%= image.description %>"
  data-url="<%= image.url_content %>"
  data-custom-thumb-url="<%= image.custom_thumb_url(width: 925) %>"
>
  <div class="file-upload-manager-dialog--item-thumb">
    <img
      src="<%= image.custom_thumb_url(width: 600, height: 600) %>"
      alt="<%= image.title.presence || image.data_file_name %>"
    >
    <% metadata = image.storage_data.blob&.metadata || {} %>
    <% width = image.width.presence || metadata[:width] %>
    <% height = image.height.presence || metadata[:height] %>
    <% if width.present? && height.present? %>
      <span class="file-upload-manager-dialog--item-badge -dimensions js-file-manager-badge-dimensions">
        <%= width %> × <%= height %>
      </span>
    <% end %>
    <span class="file-upload-manager-dialog--item-badge -size js-file-manager-badge-size">
      <%= number_to_human_size(image.data_file_size, precision: 1) %>
    </span>
    <% if image.projekt.present? %>
      <span
        class="file-upload-manager-dialog--item-badge -projekt"
        title="<%= image.projekt.title %>"
      >
        <%= image.projekt.title %>
      </span>
    <% end %>
  </div>
  <div class="file-upload-manager-dialog--item-meta">
    <p
      class="file-upload-manager-dialog--item-title"
      title="<%= image.title.presence || image.data_file_name %>"
    >
      <%= image.title.presence || image.data_file_name %>
    </p>
    <div class="file-upload-manager-dialog--item-alt"><%= image.alt_text %></div>
  </div>
</div>
