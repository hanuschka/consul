<main>
  <h1>
    <%= t("ideas.index.title") %>
  </h1>

  <% if ideas_feature?("intro_text") %>
    <div class="flex-layout">
      <div class="main-column">
        <div class="resource-page--intro-text hide-on-mobile">
          <%= render_custom_block("ideas_index_welcome", default_content: t("ideas.index.welcome_default_text_html")) %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render Shared::MapComponent.new(
    features: @ideas_coordinates,
    process: 'ideas'
  ) %>

  <div class="flex-layout">
    <div class="main-column">
      <%= render Resources::List::BaseComponent.new(
        empty_text: t("custom.ideas.index.empty_list_text")
      ) do |c| %>
        <% c.with_toolbar(
          i18n_namespace: "custom.ideas.index",
          filters: @valid_orders,
          current_filter: @current_order,
          param: "order",
          text_search_enabled: true
        ) %>

        <% if @ideas.present? %>
          <% c.with_items do %>
            <% @ideas.each do |idea| %>
              <%= render Ideas::ListItemComponent.new(idea: idea) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= paginate @ideas %>
    </div>

    <div id="ideas-sidebar" class="sidebar">
      <%= render Shared::SidebarCardComponent.new(title: t("custom.common.information"), icon_name: "info-circle") do |c| %>
        <div class="margin-bottom-half">
          <%= render_custom_block "ideas_index_sidebar", default_content: t("ideas.index.sidebar.information_default_text") %>
        </div>

        <div class="resources--info-count margin-bottom-half">
          <span>
            <%= t("ideas.index.sidebar.count") %>
          </span>
          <span>
            <%= @ideas.total_count %>
          </span>
        </div>

        <div class="hide-on-mobile">
          <%= link_to t("ideas.index.sidebar.button_new"), new_idea_path,
            class: "button -orange", style: "display:inline-flex;" %>
        </div>
      <% end %>

      <%= render Sidebar::RadioFilterComponent.new(
        identifier: :idea_category,
        options: Idea::Category.all.map { |c| [c.name, c.id] },
        title: t("ideas.index.sidebar.category_filter.title")
      ) %>

      <%= render Sidebar::RadioFilterComponent.new(
        identifier: :status,
        options: [
          [t("ideas.index.sidebar.status_filter.active"), :active],
          [t("ideas.index.sidebar.status_filter.archived"), :archived]
        ],
        title: t("ideas.index.sidebar.status_filter.title")
      ) %>

      <%= render Sidebar::RadioFilterComponent.new(
        identifier: :quorum,
        options: [
          [t("ideas.index.sidebar.quorum_filter.reached"), :reached],
          [t("ideas.index.sidebar.quorum_filter.not_reached"), :not_reached]
        ],
        title: t("ideas.index.sidebar.quorum_filter.title")
      ) %>

      <div class="show-on-small-tablet">
        <%= render(Mobile::FixedBottomActionComponent.new) do %>
          <%= link_to t("ideas.index.sidebar.button_new"), new_idea_path,
            class: "button -orange", style: "display:inline-flex;" %>
        <% end %>
      </div>
    </div>
  </div>
</main>
