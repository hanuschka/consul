<!DOCTYPE html>
<html lang="<%= I18n.locale %>">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= safe_join([yield(:title), adm_header_title].compact, " | ") %></title>

    <%= csrf_meta_tags %>
    <%= favicon_link_tag "favicon.ico" %>
    <script>window.CESIUM_BASE_URL = "<%= request.base_url %>/vcmap/assets/cesium/";</script>
    <%= yield :vc_maps %>

    <%= yield :head %>

    <%= stylesheet_link_tag "elements" %>
    <%= stylesheet_link_tag "application.adm" %>
    <!-- Font Awesome for icon selection (temporary until frontend migrates to Material) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <%= javascript_include_tag "elements", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application-kern", "data-turbo-track": "reload", type: "module", crossorigin: "anonymous" %>
  </head>

  <body class="kern-light" data-controller="adm-sidebar shared--anchor-highlight">
    <%= render "layouts/brand_color_root_style" %>
    <div class="d-flex">
      <%# Icon Rail: durchgehend von oben bis unten %>
      <div class="d-none d-lg-flex">
        <%= render Adm::IconRailComponent.new(current_user: current_user) %>
      </div>

      <%# Rechts daneben: Header + Sidebar + Content %>
      <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
        <header class="header d-flex align-items-center justify-content-between">
          <div class="header__decorations">
            <div style=" position:absolute; right:-60px; top:-40px; width:160px; height:160px; background-color:rgba(255,255,255,0.14); border-radius:999px; "></div>
            <div style=" position:absolute; left:10%; bottom:-60px; width:140px; height:140px; background-color:rgba(27,95,214,0.28); border-radius:999px; "></div>
            <div style=" position:absolute; left:35%; top:18px; width:80px; height:80px; background-color:rgba(255,255,255,0.08); border-radius:24px; "></div>
          </div>

          <div class="d-flex align-items-center">
            <div class="adm-sidebar-toggle d-lg-none" data-adm-sidebar-target="toggler" role="button" tabindex="0" aria-label="<%= t('adm.sidebar.toggle') %>" aria-expanded="false" aria-controls="adm-sidebar">
              <span class="material-symbols-outlined" aria-hidden="true">menu</span>
            </div>
            <div class="fs-5 mx-4 position-relative"><%= adm_header_title %></div>
          </div>

          <div class="d-flex align-items-center gap-4 mr-4 position-relative">
            <%= render Adm::LanguageSelectorComponent.new %>
            <%= render Kern::SubnavigationKontoComponent.new(current_user: current_user) %>
          </div>
        </header>

        <div class="d-flex adm-layout">
          <aside id="adm-sidebar" class="d-none d-lg-flex position-lg-static" data-adm-sidebar-target="sidebar">
            <%= render adm_menu_component %>

            <div class="adm-sidebar-footer">
              <hr class="adm-sidebar-divider">
              <% if defined?(RELEASE_DATE) && RELEASE_DATE %>
                <div class="adm-sidebar-footer__release">
                  <span class="material-symbols-outlined" aria-hidden="true">deployed_code_update</span>
                  <%= I18n.l(RELEASE_DATE, format: :short) %>
                </div>
              <% end %>
            </div>
          </aside>

          <main class="flex-grow-1">
            <div id="flash-messages">
              <%= render Kern::FlashComponent.new(flash: flash) %>
            </div>
            <%= yield %>
          </main>
        </div>
      </div>
    </div>
  </body>
</html>
