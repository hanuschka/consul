<!DOCTYPE html>
<html lang="<%= I18n.locale %>">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= safe_join([yield(:title), t("adm.title")].compact, " | ") %></title>

    <%= csrf_meta_tags %>
    <%= favicon_link_tag "favicon.ico" %>
    <script>window.CESIUM_BASE_URL = "<%= request.base_url %>/vcmap/assets/cesium/";</script>
    <%= yield :vc_maps %>

    <%= stylesheet_link_tag "application.adm" %>
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/43.3.0/ckeditor5.css" />
    <!-- Font Awesome for icon selection (temporary until frontend migrates to Material) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <%= javascript_include_tag "application-kern", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="" data-controller="adm-sidebar">
    <div class="adm-sidebar-toggle d-lg-none" data-adm-sidebar-target="toggler" role="button" tabindex="0" aria-label="<%= t('adm.sidebar.toggle') %>" aria-expanded="false" aria-controls="adm-sidebar">
      <span class="material-symbols-outlined" aria-hidden="true">menu</span>
    </div>

    <header class="header d-flex align-items-center justify-content-between">
      <div class="header__decorations">
        <div style=" position:absolute; right:-60px; top:-40px; width:160px; height:160px; background-color:rgba(255,255,255,0.14); border-radius:999px; "></div>
        <div style=" position:absolute; left:-50px; bottom:-60px; width:140px; height:140px; background-color:rgba(27,95,214,0.28); border-radius:999px; "></div>
        <div style=" position:absolute; left:35%; top:18px; width:80px; height:80px; background-color:rgba(255,255,255,0.08); border-radius:24px; "></div>
      </div>

      <div class="d-flex align-items-center">
        <%= image_tag(image_path_for("adm_logo.png"), alt: Setting["org_name"], class: "mx-4 position-relative", size: "50x50") %>
        <div class="fs-5"><%= t("adm.title") %></div>
      </div>

      <div class="d-flex align-items-center mr-4 position-relative">
        <%= render Kern::SubnavigationKontoComponent.new(current_user: current_user) %>
      </div>
    </header>

    <div class="d-flex">
      <aside id="adm-sidebar" class="d-none d-lg-block position-absolute top-0 position-lg-static" data-adm-sidebar-target="sidebar">
        <%= render adm_menu_component %>

        <div class="kern-form-check" data-controller="mode-switcher" style="margin-top: 5rem;">
          <%= check_box_tag 'mode_switcher', '1', cookies[:mode_switcher] == '1', class: 'kern-form-check__checkbox', id: 'mode_switcher', data: { action: 'change->mode-switcher#toggle' } %>
          <%= label_tag 'mode_switcher', 'Dunkelmodus', class: 'kern-label kern-form-check__label' %>
        </div>
      </aside>

      <main class="flex-grow-1">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
