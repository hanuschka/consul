<!DOCTYPE html>
<html lang="<%= I18n.locale %>">

  <head>
    <%= stylesheet_link_tag "application.adm" %>
    <%= javascript_include_tag "application-kern" %>
  </head>

  <body class="">
    <aside>
      <nav>
        <ul>
          <li class="nav-item <%= 'active' if current_page?(adm_root_path) %>">
            <%= link_to adm_root_path do %>
              <span class="kern-icon kern-icon--home kern-icon--small" aria-hidden="true"></span>
              <span>Home</span>
            <% end %>
          </li>
          <li class="nav-item <%= 'active' if current_page?(adm_projekts_path) %>">
            <%= link_to adm_projekts_path do %>
              <span class="kern-icon kern-icon--checklist kern-icon--small" aria-hidden="true"></span>
              <span>Projekte</span>
            <% end %>
          </li>
        </ul>
      </nav>

      <div class="kern-form-check" data-controller="mode-switcher" style="margin-top: 5rem;">
        <%= check_box_tag 'mode_switcher', '1', cookies[:mode_switcher] == '1', class: 'kern-form-check__checkbox', id: 'mode_switcher', data: { action: 'change->mode-switcher#toggle' } %>
        <%= label_tag 'mode_switcher', 'Dunkelmodus', class: 'kern-label kern-form-check__label' %>
      </div>
    </aside>

    <main>
      <div class="kern-container-fluid main-container">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
