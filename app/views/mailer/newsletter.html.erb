<% email_brand_color = Setting["newsletter_brand_color"] %>

<style>
    .newsletter-template-content table {
      margin-left: 0 !important;
      margin-right: 0 !important;
      width: 100% !important;
    }
    .newsletter-template-content img {
      width: 100% !important;
      height: auto !important;
    }
    .newsletter-template-content p {
      padding:34px 40px 26px 40px !i;
    }
    table {
      margin-bottom: 0;
      width: 100%;
    }
    a, a:hover, a:focus {
      color: inherit;
    }
    h1, h2, h3, h4, h5 {
      color: black;
    }
    tr, td, tbody, table {
      background-color: transparent;
    }

    tr:hover {
      background-color: transparent !important;
    }
    table tr:nth-child(odd), table tr:nth-child(even) {
      background-color: transparent;
    }
    p {
      font-size: 15px;
    }
    table.header tr:hover {
      background-color: initial;
    }
    table {
      border-radius: 0;
    }
    table tr td {
      padding: 0;
    }
</style>
<table style="max-width:1280px;" align="center" width="100%" border="0" cellpadding="0" cellspacing="0">
  <tbody>
    <tr>
      <td style="font-family:Arial,sans-serif; font-size:16px; line-height:1.4" align="left">

        <%# Top header with logo %>
        <% logo_newsletter = SiteCustomization::Image.find_or_create_by(name: "logo_newsletter_email") %>
        <% if logo_newsletter.image.attached? %>
          <table style="background-color:<%= email_brand_color %>" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>
              <tr>
                <td style="padding-top:20px;padding-bottom:20px;" align="left">
                  <table align="center" style="max-width: 670px" width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tbody>
                      <tr>
                        <td align="left">
                          <%= image_tag(
                            image_path_for("logo_newsletter_email.png"),
                            height: 45,
                            style: "border: 0;display: block;height: 45px",
                            alt: setting["org_name"]
                          ) %>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
            </tbody>
          </table>
        <% end %>

        <%# Main header %>
        <% if @newsletter.image&.attachment&.attached? && @newsletter.title.blank? && @newsletter.subtitle.blank? %>
          <table width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>
              <tr>
                <td style="text-align:center" colspan="100%" width="100%">
                  <%= image_tag(@newsletter.image.attachment) %>
                </td>
              </tr>
            </tbody>
          </table>
          <table align="center" style="max-width: 670px" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>
              <tr>
                <td style="background:#ffffff; padding:25px 40px 0 40px" align="left">
                  <span style="font-size:22px; color:#000000; margin-top:0">
                    <%= @newsletter.greeting %>
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        <% else %>
          <% header_background_style = @newsletter.image&.attachment&.attached? ? "background-image:url(#{url_for(@newsletter.image.attachment)});background-position:top center;background-repeat:no-repeat;background-size:cover;height:420px;" : "background: #{email_brand_color};height:420px;" %>
          <table style="<%= header_background_style %>" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>
              <tr>
                <td style="vertical-align:top; padding:120px 40px 0 40px" valign="top" align="left">
                  <table align="center" style="max-width:580px" width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tbody>
                      <tr>
                        <td align="left">
                          <% if @newsletter.title.present? %>
                            <h1 style="font-size:32px; color:<%= @newsletter.title_color %>; margin:0 0 0 0; line-height:1.2">
                              <div><%= @newsletter.title %></div>
                            </h1>
                            <div style="display:block;max-width:204px; height:0; margin-top:4px; margin-bottom:18px; padding-top:0.5em; border-style:solid; border-width:6px 6px 6px 0; border-color:transparent transparent <%= email_brand_color %> transparent"></div>
                          <% end %>
                          <% if @newsletter.subtitle.present? %>
                            <div style="font-size:19px; color:<%= @newsletter.subtitle_color %>; margin-top:0; margin-bottom:8px">
                                <%= @newsletter.subtitle %>
                            </div>
                          <% end %>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
              <tr>
                <td style="vertical-align:bottom;padding-bottom:0" valign="bottom" align="left">
                  <table align="center" style="max-width: 670px" width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tbody>
                      <tr>
                        <td style="background:#ffffff; padding:25px 40px 0 40px" align="left">
                          <span style="font-size:22px; color:#000000; margin-top:0">
                            <%= @newsletter.greeting %>
                          </span>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
            </tbody>
          </table>
        <% end %>

        <%# Content %>
        <table
          class="newsletter-template-content"
          style="max-width:670px;font-family:Arial,sans-serif; font-size: 15px; margin: 0; background: #fff; margin: 0 auto; background:#ffffff; margin-bottom:40px;"
          width="100%" border="0" cellpadding="0" cellspacing="0"
        >
          <tbody>
            <tr>
              <td style="padding:25px 40px 0 40px;">
                <div style="<%= css_for_mailer_text %>;font-size: 15px;">
                    <%= auto_link_already_sanitized_html wysiwyg(@newsletter.body) %>
                </div>
              </td>
            </tr>
          </tbody>
        </table>

        <%# Footer %>
        <table style="background-color:<%= email_brand_color %>" width="100%" border="0" cellpadding="0" cellspacing="0">
          <tbody>
            <tr>
              <td style="">
                <table style="max-width: 580px;" align="center" style="" width="100%"  border="0" cellpadding="0" cellspacing="0">
                  <tbody>
                    <tr>
                      <td style="padding-top:40px;padding-bottom:40px;color:white;">
                        <% if defined?(render_custom_block) %>
                          <%= render_custom_block 'newsletter_email_footer_block_1' %>
                        <% else %>
                          <%= render_custom_content_block_content 'newsletter_email_footer_block_1' %>
                        <% end %>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
    <tr>
      <td style='text-align:center;'>
        <% if @subscriptions_token.present? %>
          <% unsubscribe_path = edit_subscriptions_url(token: @subscriptions_token) %>
        <% elsif @unregistered_newletter_unsubscribe_token.present? %>
          <% unsubscribe_path = unregistered_newsletter_subscribers_unsubscribe_url(unsubscribe_token: @unregistered_newletter_unsubscribe_token) %>
        <% elsif controller.class.name == "NotificationServiceMailer" %>
          <%= notification_service_mailer_unsubscribe_block(action_name, projekt_phase: @projekt_phase) %>
        <% end %>
        <% if unsubscribe_path.present? %>
          <p style="font-family: 'Open Sans','Helvetica Neue',arial,sans-serif; margin: 0;padding: 0;line-height: 1.5em;color: #222; font-size: 10px; margin-top: 12px; margin-bottom: 30px;">
            <%= link_to(t("mailers.config.unsubscribe_notifications_link_short"), unsubscribe_path, style: "text-decoration: undescore;") %>
          </p>
        <% end %>
      </td>
    </tr>
  </tbody>
</table>
