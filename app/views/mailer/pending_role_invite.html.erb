<td style="<%= css_for_mailer_content %>">
  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.pending_role_invite.title",
        role_name: @role_name) %>
  </h1>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.shared.greeting_without_name") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.pending_role_invite.text",
        org: Setting["org_name"],
        role_name: @role_name) %>
  </p>

  <p style="text-align: center;">
    <%= link_to t("mailers.pending_role_invite.button"), new_user_registration_url(invitation_token: @pending_role_assignment.invitation_token), style: css_for_mailer_button %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.pending_role_invite.ignore") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.pending_role_invite.thanks") %>
  </p>

  <% unless custom_email_footer_present? %>
    <p style="<%= css_for_mailer_text %>">
      <%= t("mailers.shared.sincerely") %>
      <br>
      <%= t("mailers.shared.signature") %>
    </p>
  <% end %>
</td>
