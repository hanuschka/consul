<td style="<%= css_for_mailer_content %>">
  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.shared.greeting_without_name") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= I18n.t("custom.moderation_mailer.flag_report.body_prefix") %>
    <%= link_to_if @resource_url.present?, @resource_title, @resource_url, style: "color: #004a83;" %>
    <%= I18n.t("custom.moderation_mailer.flag_report.body_suffix") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to I18n.t("custom.moderation_mailer.flag_report.review_link"),
                adm_moderation_proposals_url,
                style: "color: #004a83;" %>
  </p>

  <% unless custom_email_footer_present? %>
    <p style="<%= css_for_mailer_text %>">
      <%= t("mailers.shared.sincerely") %>
      <br>
      <%= t("mailers.shared.signature") %>
    </p>
  <% end %>
</td>
