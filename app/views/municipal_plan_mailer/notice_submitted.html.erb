<td style="<%= css_for_mailer_content %>">
  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.shared.greeting_without_name") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= I18n.t("custom.municipal_plan_mailer.notice_submitted.body", title: @municipal_plan.title) %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to @municipal_plan.title, @municipal_plan_url, style: "color: #004a83;" %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <strong><%= I18n.t("custom.municipal_plan_mailer.notice_submitted.sender") %>:</strong>
    <%= @notice.name.presence || I18n.t("custom.municipal_plan_mailer.notice_submitted.no_name") %>
    (<%= @notice.email %>)
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= simple_format(@notice.body) %>
  </p>

  <% unless custom_email_footer_present? %>
    <p style="<%= css_for_mailer_text %>">
      <%= t("mailers.shared.sincerely") %>
      <br>
      <%= t("mailers.shared.signature") %>
    </p>
  <% end %>
</td>
