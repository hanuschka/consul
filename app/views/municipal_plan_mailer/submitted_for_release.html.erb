<td style="<%= css_for_mailer_content %>">
  <p style="<%= css_for_mailer_text %>">
    <%= @administrator.user.recipient_greeting %>,
  </p>

  <p style="<%= css_for_mailer_text %>">
    <% if @responsible_name.present? %>
      <%= I18n.t("custom.municipal_plan_mailer.submitted_for_release.body_with_responsible",
                 title: @municipal_plan.title, responsible: @responsible_name) %>
    <% else %>
      <%= I18n.t("custom.municipal_plan_mailer.submitted_for_release.body",
                 title: @municipal_plan.title) %>
    <% end %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to I18n.t("custom.municipal_plan_mailer.submitted_for_release.review_link"),
                @review_url, style: "color: #004a83;" %>
  </p>

  <% unless custom_email_footer_present? %>
    <p style="<%= css_for_mailer_text %>">
      <%= t("mailers.shared.sincerely") %>
      <br>
      <%= t("mailers.shared.signature") %>
    </p>
  <% end %>
</td>
