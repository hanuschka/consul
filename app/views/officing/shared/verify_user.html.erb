<h2><%= t("custom.officing.shared.verify_users.title") %></h2>

<div class="verification account">
  <div class="small-12">
    <%= form_with model: @offline_user, url: url_for(action: "find_or_create_user") do |f| %>
      <div class="small-12 medium-6">
        <div class="margin-bottom">
          <%= f.submit t("custom.officing.shared.verify_users.skip_verification"), name: "skip_verification", class: "button expanded" %>
        </div>
      </div>

      <hr>

      <div class="small-12 medium-6">
        <%= f.text_field :first_name,
                         autocomplete: "off" %>
      </div>

      <div class="small-12 medium-6">
        <%= f.text_field :last_name,
                         autocomplete: "off" %>
      </div>

      <div class="small-12 medium-6">
        <%= f.select :gender, options_for_gender_select,
          { prompt: t("custom.helpers.select.gender_prompt") },
          { class: "show-arrow", "aria-label": t("custom.helpers.select.gender_prompt") } %>
      </div>

      <div class='row'>
        <div class="small-12 medium-6">
          <%= render Users::RegisteredAddressFieldsComponent.new(
            resource: @offline_user,
            selected_city_id: params[:form_registered_address_city_id].presence,
            selected_street_id: params[:form_registered_address_street_id].presence,
            selected_address_id: params[:form_registered_address_id].presence
          ) %>
        </div>
      </div>

      <div class='row'>
        <div class="small-12 medium-6">
          <%= render Users::RegularAddressFieldsComponent.new(f: f, user: @offline_user) %>
        </div>
      </div>

      <div class="small-12 medium-6 user-date-of-birth sign-up">
        <%= f.date_select :date_of_birth,
          prompt: { year: t("custom.helpers.select.birth_year"), month: t("custom.helpers.select.birth_month"), day: t("custom.helpers.select.birth_day") },
          start_year: 1900, end_year: minimum_required_age.years.ago.year %>
      </div>

      <div class="small-12 medium-6">
        <%= check_box_tag :mark_as_verified, params[:mark_as_verified].presence == "1" ? "1" : "0", params[:mark_as_verified].presence == "1", id: "mark_as_verified" %>
        <%= label_tag :mark_as_verified, t("custom.officing.shared.verify_users.mark_as_verified") %>
        <span class='help-text' style="display:block;"><%= t("custom.officing.shared.verify_users.mark_as_verified_hint") %></span>
      </div>

      <div class="small-12 medium-6" style="margin-top: 30px;">
        <input type="submit" value="Offline Stimme hinzufügen" class="button expanded">
      </div>
    <% end %>
  </div>
</div>
