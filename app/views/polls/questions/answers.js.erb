$("#poll-participation-confirmed-callout").remove();
$("#<%= dom_id(@question) %>_answers").html("<%= j render Polls::Questions::AnswersComponent.new(@question, answer_updated: @answer_updated, open_answer_updated: @open_answer_updated) %>");
App.PollsCustom.showOpenAnswers();
App.PollsCustom.formatVisibleRatingScalesAfterRepaint();


<% if @question_answer.present? && @question_answer.terminates_poll? %>
  App.QuestionWizard.showClosingNote();
  $(".js-question-wizard-next").hide();
<% else %>
  <% if @question.poll.in_wizard_mode? %>
      App.QuestionWizard.mandatoryQuestionActions();
      <%# Whether a question follows this one can change with the answer just given —
          a branch past the rest, or a question contextualised by the option chosen —
          and the server is what knows. Absent for a nested sub-question, which is not
          a step of its own. %>
      <% if !@wizard_has_next.nil? %>
        App.QuestionWizard.setHasNext(<%= @question.id %>, <%= @wizard_has_next %>);
      <% end %>
  <% end %>
<% end %>
