<main>
  <div class="row proposal-retire-page">
    <div class="small-12 column">
      <div class="new-card main-content-card">
        <h1><%= t("proposals.retire_form.title") %></h1>

        <p class="proposal-retire-page--proposal-link">
          <%= link_to @proposal.title, proposal_path(@proposal) %>
        </p>

        <div class="callout warning proposal-retire-page--warning">
          <%= t("proposals.retire_form.warning") %>
        </div>

        <%= translatable_form_for(@proposal, url: retire_proposal_path(@proposal)) do |f| %>
          <%= render "shared/errors", resource: @proposal %>

          <div class="proposal-retire-page--field">
            <%= f.select :retired_reason, retire_proposals_options,
              include_blank: t("proposals.retire_form.retired_reason_blank") %>
          </div>

          <div class="proposal-retire-page--field">
            <%= f.translatable_fields do |translations_form| %>
              <%= translations_form.text_area :retired_explanation,
                    rows: 4, maxlength: 500,
                    hint: t("proposals.retire_form.retired_explanation_hint"),
                    placeholder: t("proposals.retire_form.retired_explanation_placeholder") %>
            <% end %>
          </div>

          <div class="u-flex u-flex-align-center u-gap-10 proposal-retire-page--actions">
            <%= f.submit(class: "button -red -no-margin",
                         value: t("proposals.retire_form.submit_button")) %>
            <%= link_to t("proposals.retire_form.back_to_proposal"),
                        proposal_path(@proposal),
                        class: "button hollow -no-margin" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</main>
