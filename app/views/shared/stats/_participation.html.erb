<div id="participation_statistics">

  <% if stats.is_a?(Budget::Stats) %>
    <div id="total_investments" class="stats-group">
      <h4><%= t("stats.budgets.total_investments_title") %></h4>

      <%= number_with_info_tags(
        stats.total_budget_investments,
        t("stats.budgets.total_investments"),
        html_class: "total-resources"
      ) %>

      <% unless params[:stats_section] == "accepting" %>
        <%= number_with_info_tags(stats.total_unfeasible_investments,
                                  t("stats.budgets.total_unfeasible_investments")) %>

        <%= number_with_info_tags(stats.total_feasible_investments,
                                  t("stats.budgets.total_feasible_investments")) %>
      <% end %>

      <% if @budget.valuating_or_later? %>
        <%= number_with_info_tags(stats.total_selected_investments,
                                  t("stats.budgets.total_selected_investments")) %>
      <% end %>
    </div>
  <% elsif stats.is_a?(ProjektPhase::ProposalPhase::Stats) %>
    <h3><%= t("custom.participation_stats.key_performance_indicators") %></h3>
    <div class="participation-stat-number-cards">
      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.proposals") %></h4>
        <div class="number"><%= stats.total_proposals %></div>
      </div>

      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.authors") %></h4>
        <div class="number"><%= stats.total_authors %></div>
      </div>

      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.participants") %></h4>
        <div class="number"><%= stats.total_participants %></div>
      </div>

      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.supports") %></h4>
        <div class="number"><%= stats.total_supports %></div>
      </div>

      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.weighted_score") %></h4>
        <div class="number"><%= stats.total_supports_weight %></div>
      </div>

      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.comments") %></h4>
        <div class="number"><%= stats.total_comments %></div>
      </div>

      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.hidden") %></h4>
        <div class="number"><%= stats.total_hidden %></div>
      </div>

      <div class="participation-stat-number-card">
        <h4><%= t("custom.projekt_phases.stats.proposal_phase.reported") %></h4>
        <div class="number"><%= stats.total_reported %></div>
      </div>
    </div>
  <% end %>

