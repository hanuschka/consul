<div id="participation_statistics">

  <% if stats.is_a?(ProjektPhase::BudgetPhase) %>
    <% if stats.has_accepting_stats? %>
      <div class="budget-phase-stats-section-card">
        <h2 class="participation-stats--section-title"><%= t("custom.projekt_phases.stats.budget_phase.accepting.title") %></h2>
        <div class="number-stats-cards margin-bottom">
          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.accepting.visible_proposals_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.accepting.visible_proposals_count.tooltip")
          )) do %>
            <div class="number"><%= stats.accepting_visible_proposals_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.accepting.proposal_authors_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.accepting.proposal_authors_count.tooltip")
          )) do %>
            <div class="number"><%= stats.accepting_proposal_authors_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.accepting.comments_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.accepting.comments_count.tooltip")
          )) do %>
            <div class="number"><%= stats.accepting_comments_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.accepting.reported_proposals_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.accepting.reported_proposals_count.tooltip")
          )) do %>
            <div class="number"><%= stats.accepting_reported_proposals_count %></div>
          <% end %>
        </div>

        <% accepting_segment = stats.segment_stats("accepting") %>
        <%= render Shared::CollapseComponent.new(head_background: true) do |c| %>
          <% c.with_head do %>
            <h3 class="budget-phase-stats-segments--title"><%= t("custom.participation_stats.sections.distributions") %></h3>
          <% end %>
          <% c.with_body do %>
            <%= render "shared/stats/demographic_charts", stats: accepting_segment %>
            <%= render ParticapationStats::TimelineComponent.new(projekt_phase: stats) %>
            <%= render ParticapationStats::UserSegmentsComponent.new(stats: accepting_segment) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if stats.has_reviewing_stats? %>
      <div class="budget-phase-stats-section-card">
        <h2 class="participation-stats--section-title"><%= t("custom.projekt_phases.stats.budget_phase.reviewing.title") %></h2>
        <div class="number-stats-cards margin-bottom">
          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.reviewing.pending_proposals_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.reviewing.pending_proposals_count.tooltip")
          )) do %>
            <div class="number"><%= stats.reviewing_pending_proposals_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.reviewing.approved_proposals_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.reviewing.approved_proposals_count.tooltip")
          )) do %>
            <div class="number"><%= stats.reviewing_approved_proposals_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.reviewing.rejected_proposals_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.reviewing.rejected_proposals_count.tooltip")
          )) do %>
            <div class="number"><%= stats.reviewing_rejected_proposals_count %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if stats.has_selecting_stats? %>
      <div class="budget-phase-stats-section-card">
        <h2 class="participation-stats--section-title"><%= t("custom.projekt_phases.stats.budget_phase.selecting.title") %></h2>
        <div class="number-stats-cards margin-bottom">
          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.selecting.unique_supporters_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.selecting.unique_supporters_count.tooltip")
          )) do %>
            <div class="number"><%= stats.selecting_unique_supporters_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.selecting.total_votes_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.selecting.total_votes_count.tooltip")
          )) do %>
            <div class="number"><%= stats.selecting_total_votes_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.selecting.online_votes_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.selecting.online_votes_count.tooltip")
          )) do %>
            <div class="number"><%= stats.selecting_online_votes_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.selecting.offline_votes_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.selecting.offline_votes_count.tooltip")
          )) do %>
            <div class="number"><%= stats.selecting_offline_votes_count %></div>
          <% end %>
        </div>

        <% selecting_segment = stats.segment_stats("selecting") %>
        <%= render Shared::CollapseComponent.new(head_background: true) do |c| %>
          <% c.with_head do %>
            <h3 class="budget-phase-stats-segments--title"><%= t("custom.participation_stats.sections.distributions") %></h3>
          <% end %>
          <% c.with_body do %>
            <%= render "shared/stats/demographic_charts", stats: selecting_segment %>
            <%= render ParticapationStats::UserSegmentsComponent.new(stats: selecting_segment) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if stats.has_publishing_prices_stats? %>
      <div class="budget-phase-stats-section-card">
        <h2 class="participation-stats--section-title"><%= t("custom.projekt_phases.stats.budget_phase.publishing_prices.title") %></h2>
        <div class="number-stats-cards margin-bottom">
          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.publishing_prices.selected_proposals_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.publishing_prices.selected_proposals_count.tooltip")
          )) do %>
            <div class="number"><%= stats.publishing_prices_selected_proposals_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.publishing_prices.not_selected_proposals_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.publishing_prices.not_selected_proposals_count.tooltip")
          )) do %>
            <div class="number"><%= stats.publishing_prices_not_selected_proposals_count %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if stats.has_balloting_stats? %>
      <div class="budget-phase-stats-section-card">
        <h2 class="participation-stats--section-title"><%= t("custom.projekt_phases.stats.budget_phase.balloting.title") %></h2>
        <div class="number-stats-cards margin-bottom">
          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.balloting.unique_voters_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.balloting.unique_voters_count.tooltip")
          )) do %>
            <div class="number"><%= stats.balloting_unique_voters_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.balloting.total_votes_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.balloting.total_votes_count.tooltip")
          )) do %>
            <div class="number"><%= stats.balloting_total_votes_count %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.balloting.weighted_votes_total.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.balloting.weighted_votes_total.tooltip")
          )) do %>
            <div class="number"><%= stats.balloting_weighted_votes_total %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.balloting.weighted_votes_online.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.balloting.weighted_votes_online.tooltip")
          )) do %>
            <div class="number"><%= stats.balloting_weighted_votes_online %></div>
          <% end %>

          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.balloting.weighted_votes_offline.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.balloting.weighted_votes_offline.tooltip")
          )) do %>
            <div class="number"><%= stats.balloting_weighted_votes_offline %></div>
          <% end %>
        </div>

        <% balloting_segment = stats.segment_stats("balloting") %>
        <%= render Shared::CollapseComponent.new(head_background: true) do |c| %>
          <% c.with_head do %>
            <h3 class="budget-phase-stats-segments--title"><%= t("custom.participation_stats.sections.distributions") %></h3>
          <% end %>
          <% c.with_body do %>
            <%= render "shared/stats/demographic_charts", stats: balloting_segment %>
            <%= render ParticapationStats::UserSegmentsComponent.new(stats: balloting_segment) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if stats.has_finished_stats? %>
      <div class="budget-phase-stats-section-card">
        <h2 class="participation-stats--section-title"><%= t("custom.projekt_phases.stats.budget_phase.finished.title") %></h2>
        <div class="number-stats-cards margin-bottom">
          <%= render(AiStats::StatCardComponent.new(
            title: t("custom.projekt_phases.stats.budget_phase.finished.winners_count.title"),
            tooltip: t("custom.projekt_phases.stats.budget_phase.finished.winners_count.tooltip")
          )) do %>
            <div class="number"><%= stats.finished_winners_count %></div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% elsif stats.is_a?(ProjektPhase::ProposalPhase) %>
    <div class="number-stats-cards margin-bottom">
      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.total_unique_participants_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.total_unique_participants_count.tooltip")
      )) do %>
        <div class="number"><%= stats.total_unique_participants_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.visible_proposals_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.visible_proposals_count.tooltip")
      )) do %>
        <div class="number"><%= stats.visible_proposals_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.proposal_authors_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.proposal_authors_count.tooltip")
      )) do %>
        <div class="number"><%= stats.proposal_authors_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.unique_supporters_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.unique_supporters_count.tooltip")
      )) do %>
        <div class="number"><%= stats.unique_supporters_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.total_votes_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.total_votes_count.tooltip")
      )) do %>
        <div class="number"><%= stats.total_votes_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.online_votes_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.online_votes_count.tooltip")
      )) do %>
        <div class="number"><%= stats.online_votes_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.offline_votes_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.offline_votes_count.tooltip")
      )) do %>
        <div class="number"><%= stats.offline_votes_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.visible_comments_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.visible_comments_count.tooltip")
      )) do %>
        <div class="number"><%= stats.visible_comments_count %></div>
      <% end %>
    </div>

    <%= render "shared/stats/demographic_charts", stats: stats %>
  <% elsif stats.is_a?(Poll::Stats) %>
    <%= render "shared/stats/demographic_charts", stats: stats %>
  <% end %>

</div>
