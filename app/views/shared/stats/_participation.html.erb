<div id="participation_statistics">

  <small><%= t("stats.hint") %></small>

  <% if stats.is_a?(Budget::Stats) && !stats.is_a?(Budget::Investment::Stats) %>
    <div id="total_investments" class="stats-group">
      <h4><%= t("stats.budgets.total_investments_title") %></h4>

      <%= number_with_info_tags(
        stats.total_budget_investments,
        t("stats.budgets.total_investments"),
        html_class: "total-resources"
      ) %>

      <% unless params[:stats_section] == "accepting" %>
        <%= number_with_info_tags(stats.total_unfeasible_investments,
                                  t("stats.budgets.total_unfeasible_investments")) %>

        <%= number_with_info_tags(stats.total_feasible_investments,
                                  t("stats.budgets.total_feasible_investments")) %>
      <% end %>

      <% if @budget.valuating_or_later? %>
        <%= number_with_info_tags(stats.total_selected_investments,
                                  t("stats.budgets.total_selected_investments")) %>
      <% end %>
    </div>
  <% elsif stats.is_a?(ProjektPhase::ProposalPhase::Stats) %>
    <div id="" class="stats-group">
      <h4><%= t("custom.projekt_phases.stats.proposal_phase.total_proposals_title") %></h4>
      <%= number_with_info_tags(
        stats.total_proposals,
        t("custom.projekt_phases.stats.proposal_phase.total_proposals"),
        html_class: "total-resources"
      ) %>

      <h4><%= t("custom.projekt_phases.stats.proposal_phase.total_supports_title") %></h4>
      <%= number_with_info_tags(
        stats.total_supports,
        t("custom.projekt_phases.stats.proposal_phase.total_supports"),
        html_class: "total-resources"
      ) %>

      <h4><%= t("custom.projekt_phases.stats.proposal_phase.total_supports_weight_title") %></h4>
      <%= number_with_info_tags(
        stats.total_supports_weight,
        t("custom.projekt_phases.stats.proposal_phase.total_supports_weight"),
        html_class: "total-resources"
      ) %>

      <h4><%= t("custom.projekt_phases.stats.proposal_phase.total_authors_title") %></h4>
      <%= number_with_info_tags(
        stats.total_authors,
        "",
        html_class: "total-participants"
      ) %>
    </div>
  <% end %>

  <% unless stats.show_percentage_values_only? %>
    <div id="total_participants" class="stats-group">
      <h4><%= t("stats.total_participants") %></h4>

      <%= number_with_info_tags(
        stats.total_participants,
        "",
        html_class: "participants total-participants"
      ) %>
    </div>
  <% end %>

  <% stats.participations.each do |participation| %>
    <%= render "shared/stats/#{participation}", stats: stats %>
  <% end %>
</div>
