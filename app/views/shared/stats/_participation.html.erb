<div id="participation_statistics">

  <% if stats.is_a?(Budget::Stats) && !stats.is_a?(Budget::Investment::Stats) %>
    <div class="ai-stats-cards margin-bottom">
      <div class="ai-stats-card">
        <h4><%= t("stats.budgets.total_investments") %></h4>
        <div class="number"><%= stats.total_budget_investments %></div>
      </div>

      <div class="ai-stats-card">
        <h4><%= t("stats.total_participants") %></h4>
        <div class="number"><%= stats.total_participants %></div>
      </div>

      <div class="ai-stats-card">
        <h4><%= t("stats.supports") %></h4>
        <div class="number"><%= stats.total_supports %></div>
      </div>

      <div class="ai-stats-card">
        <h4><%= t("stats.budgets.total_votes") %></h4>
        <div class="number"><%= stats.total_votes %></div>
      </div>

      <% unless params[:stats_section] == "accepting" %>
        <div class="ai-stats-card">
          <h4><%= t("stats.budgets.total_feasible_investments") %></h4>
          <div class="number"><%= stats.total_feasible_investments %></div>
        </div>

        <div class="ai-stats-card">
          <h4><%= t("stats.budgets.total_unfeasible_investments") %></h4>
          <div class="number"><%= stats.total_unfeasible_investments %></div>
        </div>
      <% end %>

      <% if @budget.valuating_or_later? %>
        <div class="ai-stats-card">
          <h4><%= t("stats.budgets.total_selected_investments") %></h4>
          <div class="number"><%= stats.total_selected_investments %></div>
        </div>
      <% end %>
    </div>
  <% elsif stats.is_a?(ProjektPhase::ProposalPhase::Stats) %>
    <div class="number-stats-cards margin-bottom">
      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.visible_proposals_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.visible_proposals_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.visible_proposals_count %></div>
      </div>

      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.proposal_authors_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.proposal_authors_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.proposal_authors_count %></div>
      </div>

      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.unique_supporters_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.unique_supporters_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.unique_supporters_count %></div>
      </div>

      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.total_votes_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.total_votes_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.total_votes_count %></div>
      </div>

      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.online_votes_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.online_votes_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.online_votes_count %></div>
      </div>

      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.offline_votes_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.offline_votes_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.offline_votes_count %></div>
      </div>

      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.visible_comments_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.visible_comments_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.visible_comments_count %></div>
      </div>

      <div class="ai-stats-card">
        <h4
          title="<%= t("custom.projekt_phases.stats.proposal_phase.reported_proposals_count.tooltip") %>"
          data-tooltip
        >
          <%= t("custom.projekt_phases.stats.proposal_phase.reported_proposals_count.title") %>
          <i class="fas fa-info-circle"></i>
        </h4>
        <div class="number"><%= stats.reported_proposals_count %></div>
      </div>
    </div>
  <% end %>

</div>
