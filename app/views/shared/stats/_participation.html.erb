<div id="participation_statistics">

  <% if stats.is_a?(Budget::Stats) && !stats.is_a?(Budget::Investment::Stats) %>
    <div class="number-stats-cards margin-bottom">
      <%= render(AiStats::StatCardComponent.new(
        title: t("stats.budgets.total_investments"),
        tooltip: t("custom.projekt_phases.stats.budget_phase.total_investments.tooltip")
      )) do %>
        <div class="number"><%= stats.total_budget_investments %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("stats.total_participants"),
        tooltip: t("custom.projekt_phases.stats.budget_phase.total_participants.tooltip")
      )) do %>
        <div class="number"><%= stats.total_participants %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("stats.supports"),
        tooltip: t("custom.projekt_phases.stats.budget_phase.total_supports.tooltip")
      )) do %>
        <div class="number"><%= stats.total_supports %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("stats.budgets.total_votes"),
        tooltip: t("custom.projekt_phases.stats.budget_phase.total_votes.tooltip")
      )) do %>
        <div class="number"><%= stats.total_votes %></div>
      <% end %>

      <% unless params[:stats_section] == "accepting" %>
        <%= render(AiStats::StatCardComponent.new(
          title: t("stats.budgets.total_feasible_investments"),
          tooltip: t("custom.projekt_phases.stats.budget_phase.total_feasible_investments.tooltip")
        )) do %>
          <div class="number"><%= stats.total_feasible_investments %></div>
        <% end %>

        <%= render(AiStats::StatCardComponent.new(
          title: t("stats.budgets.total_unfeasible_investments"),
          tooltip: t("custom.projekt_phases.stats.budget_phase.total_unfeasible_investments.tooltip")
        )) do %>
          <div class="number"><%= stats.total_unfeasible_investments %></div>
        <% end %>
      <% end %>

      <% if @budget.valuating_or_later? %>
        <%= render(AiStats::StatCardComponent.new(
          title: t("stats.budgets.total_selected_investments"),
          tooltip: t("custom.projekt_phases.stats.budget_phase.total_selected_investments.tooltip")
        )) do %>
          <div class="number"><%= stats.total_selected_investments %></div>
        <% end %>
      <% end %>
    </div>
  <% elsif stats.is_a?(ProjektPhase::ProposalPhase) %>
    <div class="number-stats-cards margin-bottom">
      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.total_unique_participants_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.total_unique_participants_count.tooltip")
      )) do %>
        <div class="number"><%= stats.total_unique_participants_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.visible_proposals_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.visible_proposals_count.tooltip")
      )) do %>
        <div class="number"><%= stats.visible_proposals_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.proposal_authors_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.proposal_authors_count.tooltip")
      )) do %>
        <div class="number"><%= stats.proposal_authors_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.unique_supporters_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.unique_supporters_count.tooltip")
      )) do %>
        <div class="number"><%= stats.unique_supporters_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.total_votes_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.total_votes_count.tooltip")
      )) do %>
        <div class="number"><%= stats.total_votes_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.online_votes_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.online_votes_count.tooltip")
      )) do %>
        <div class="number"><%= stats.online_votes_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.offline_votes_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.offline_votes_count.tooltip")
      )) do %>
        <div class="number"><%= stats.offline_votes_count %></div>
      <% end %>

      <%= render(AiStats::StatCardComponent.new(
        title: t("custom.projekt_phases.stats.proposal_phase.visible_comments_count.title"),
        tooltip: t("custom.projekt_phases.stats.proposal_phase.visible_comments_count.tooltip")
      )) do %>
        <div class="number"><%= stats.visible_comments_count %></div>
      <% end %>
    </div>

    <div class="kpi-stats-pie-grid margin-bottom">
      <% stats.participations.each do |participation| %>
        <% if participation == "gender" %>
          <%= render Stats::GenderStatsComponent.new(stats: stats) %>
        <% elsif participation == "age" %>
          <%= render Stats::AgeStatsComponent.new(stats: stats) %>
        <% elsif participation == "geozone" %>
          <%= render Stats::GeozoneStatsComponent.new(stats: stats) %>
        <% else %>
          <%= render "shared/stats/#{participation}", stats: stats %>
        <% end %>
      <% end %>
    </div>
  <% end %>

</div>
