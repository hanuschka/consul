maps: &maps
  map_tiles_provider: "//{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
  map_tiles_provider_attribution: "&copy; <a href=\"http://osm.org/copyright\">OpenStreetMap</a> contributors"

apis: &apis
  microsoft_api_key: ""
  census_api_end_point: ""
  census_api_institution_code: ""
  census_api_portal_name: ""
  census_api_user_code: ""
  sms_end_point:  ""
  sms_username: ""
  sms_password: ""

kobil: &kobil
  kobil:
    issuer: ""
    client_id: ""
    client_secret: ""
    redirect_uri: ""
    post_logout_redirect_uri: ""

dt: &dt
  dt:
    domain: "localhost"
    enabled: true
    port: 3001

proxy: &proxy
  web_server_proxy:
    address: "127.0.0.1"
    port: 80
    username: ""
    password: ""

ai: &ai
  ai:
    enabled: true
    openai_api_key: "secret_api_key"

mitmachbox: &mitmachbox
  mitmachbox:
    base_url: ""
    org_id: ""
    client_id: ""
    client_secret: ""
    report_errors_to_sentry: false

# Member-only instance whose member list is owned by a Brevo segment.
# member_instance closes the whole site to recognized members; api_key + member_list_id switch on
# the account lifecycle sync; webhook_token is the shared secret for
# POST /webhooks/brevo/member_events.
brevo: &brevo
  brevo:
    member_instance: false
    api_key: ""
    member_list_id: ""
    webhook_token: ""

# production setup setup
# dt: &dt %>
#  enabled: true
#  domain: "app.demokratie.today"

http_basic_auth: &http_basic_auth
  http_basic_auth: true

mapbox: &mapbox
  mapbox:
    public_token: "xxx"
    style_id: "xxx"

masterportal: &masterportal
  masterportal:
    wms_url: ""
    wms_layers: ""
    oaf_endpoint: ""

staging:
  # secret_key_base: ""
  # sentry_key: ""
  # youtube_api_key: ""
  server_name: ""
  # time_zone: ""
  # mailer_delivery_method: :smtp
  # smtp_settings:
  #   :address: "smtp.example.com"
  #   :port: 25
  #   :domain: "your_domain.com"
  #   :user_name: "<username>"
  #   :password: "<password>"
  #   :authentication: "plain"
  #   :enable_starttls_auto: true
  force_ssl: true
  delay_jobs: true
  email_interceptor_recipients: ""
  http_basic_username: ""
  http_basic_password: ""
  authentication_logs: false
  devise_lockable: false
  managers_url: ""
  managers_application_key: ""
  multitenancy: false
  security:
    last_sign_in: false
    password_complexity: false
    devise_confirm_within_days: 3
    devise_timeout_in_minutes: 30
    # lockable:
      # maximum_attempts: 20
      # unlock_in: 1 # In hours
  <<: *maps
  <<: *mapbox
  <<: *masterportal
  <<: *apis
  <<: *dt
  <<: *ai
  <<: *mitmachbox
  <<: *brevo
  <<: *kobil

production:
  # secret_key_base: ""
  # sentry_key: ""
  # youtube_api_key: ""
  server_name: ""
  # time_zone: ""
  # mailer_delivery_method: :smtp
  # smtp_settings:
  #   :address: "smtp.example.com"
  #   :port: 25
  #   :domain: "your_domain.com"
  #   :user_name: "<username>"
  #   :password: "<password>"
  #   :authentication: "plain"
  #   :enable_starttls_auto: true
  force_ssl: true
  delay_jobs: true
  http_basic_username: ""
  http_basic_password: ""
  authentication_logs: false
  devise_lockable: false
  managers_url: ""
  managers_application_key: ""
  multitenancy: false
  security:
    last_sign_in: false
    password_complexity: false
    devise_confirm_within_days: 3
    devise_timeout_in_minutes: 30
    # lockable:
      # maximum_attempts: 20
      # unlock_in: 1 # In hours
  twitter_key: ""
  twitter_secret: ""
  facebook_key: ""
  facebook_secret: ""
  google_oauth2_key: ""
  google_oauth2_secret: ""
  wordpress_oauth2_key: ""
  wordpress_oauth2_secret: ""
  wordpress_oauth2_site: ""
  <<: *maps
  <<: *mapbox
  <<: *masterportal
  <<: *apis
  <<: *dt
  <<: *ai
  <<: *mitmachbox
  <<: *brevo
  <<: *kobil
